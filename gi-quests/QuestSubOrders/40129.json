    {
      "subId": "4012909",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401290901"
        ],
        "dialogs": {
          "401290901": {
            "id": "401290901",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So these are the underwater ruins that Freminet found... They're pretty amazing, but still not exactly the kind that Paimon was imagining...",
            "nextDialogs": [
              "401290902"
            ]
          },
          "401290902": {
            "id": "401290902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is the Kingdom of Water Imps, Paimon, not ruins...",
            "nextDialogs": [
              "401290903"
            ]
          },
          "401290903": {
            "id": "401290903",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh yeah, Paimon knows, it's just... Paimon thought we'd actually see a fairytale world, like with the Water Imps' colorful houses, and the rainbow bridge...",
            "nextDialogs": [
              "401290904"
            ]
          },
          "401290904": {
            "id": "401290904",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "I'm sorry... I was hoping to put up some decorations but ran out of time to do it by myself.",
            "nextDialogs": [
              "401290905"
            ]
          },
          "401290905": {
            "id": "401290905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's okay, it's fantasy time now!",
            "nextDialogs": [
              "401290906"
            ]
          },
          "401290906": {
            "id": "401290906",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa! Someone's already switched into fantasy mode!",
            "nextDialogs": [
              "401290907"
            ]
          },
          "401290907": {
            "id": "401290907",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "#Seems like {NICKNAME}'s already got the gist of things. You should do your best too, Paimon.",
            "nextDialogs": [
              "401290908"
            ]
          },
          "401290908": {
            "id": "401290908",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ah, don't underestimate Paimon! Paimon can flip the switch, too. Now entering... Paimon Fantasy Mode!",
            "nextDialogs": [
              "401290909"
            ]
          },
          "401290909": {
            "id": "401290909",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ahem... Young adventurers! 'Tis Paimon, Guardian Goddess of this land. State your goals and intentions for visiting this nation!",
            "nextDialogs": [
              "401290910"
            ]
          },
          "401290910": {
            "id": "401290910",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Uh...",
            "nextDialogs": [
              "401290911"
            ]
          },
          "401290911": {
            "id": "401290911",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "We are the companions of Prince Thelxie, Your Divine Highness. We have come to help him reclaim the glory that he has lost.",
            "nextDialogs": [
              "401290912"
            ]
          },
          "401290912": {
            "id": "401290912",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ooh! Reclaiming your glory! Thy goddess here has golden glory, silver glory, and bronze glory. Which is it that the prince has lost?",
            "nextDialogs": [
              "401290913"
            ]
          },
          "401290913": {
            "id": "401290913",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Huh?",
            "nextDialogs": [
              "401290914"
            ]
          },
          "401290914": {
            "id": "401290914",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Uhh...",
            "nextDialogs": [
              "401290915"
            ]
          },
          "401290915": {
            "id": "401290915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did you break character, Paimon?",
            "nextDialogs": [
              "401290916"
            ]
          },
          "401290916": {
            "id": "401290916",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Not at all! This is the goddess's test! From your responses, the goddess has concluded that you're all brave adventurers without the taint of greed in your hearts! As such, you are worthy of everyone's respect!",
            "nextDialogs": [
              "401290917"
            ]
          },
          "401290917": {
            "id": "401290917",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So, please accept the goddess's reward. The goddess will now bestow all three types of glory upon you!",
            "nextDialogs": [
              "401290918"
            ]
          },
          "401290918": {
            "id": "401290918",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And as for this prince... the goddess will also bestow upon you the rainbow glory, so your future will always be filled with light!",
            "nextDialogs": [
              "401290919"
            ]
          },
          "401290919": {
            "id": "401290919",
            "speakerId": 1003,
            "speakerName": "Thelxie",
            "text": "-.. -... .-- -...?",
            "nextDialogs": [
              "401290920"
            ]
          },
          "401290920": {
            "id": "401290920",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "My gratitude to Your Divine Highness for such generous blessings. Power is now surging through every part of my body.",
            "nextDialogs": [
              "401290921"
            ]
          },
          "401290921": {
            "id": "401290921",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Me... Me too... Is this the divine inspiration of legend?",
            "nextDialogs": [
              "401290922"
            ]
          },
          "401290922": {
            "id": "401290922",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All thanks to the power of Goddess Paimon!",
            "nextDialogs": [
              "401290923"
            ]
          },
          "401290923": {
            "id": "401290923",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hehe! Ahem... now adventurers, forge bravely ahead and defeat the monsters that have taken over the kingdom! You will be sure to find that which you seek!"
          }
        }
      }
    },
    {
      "subId": "4012905",
      "subQuestName": "Defeat opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4012906",
      "subQuestName": "Talk to Freminet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401290601"
        ],
        "dialogs": {
          "401290601": {
            "id": "401290601",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Phew, it's finally over! So, have we defeated the evil monsters and reclaimed the Kingdom of Water Imps?",
            "nextDialogs": [
              "401290602"
            ]
          },
          "401290602": {
            "id": "401290602",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Yes, it should now be time for us to attend Thelxie's coronation ceremony... The only thing is, I didn't expect this to go so smoothly. I thought it would have taken longer for us to reach the heart of the ruins...",
            "nextDialogs": [
              "401290603"
            ]
          },
          "401290603": {
            "id": "401290603",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "It was my mistake. I should have told Freminet earlier that we would also need a crown...",
            "nextDialogs": [
              "401290604"
            ]
          },
          "401290604": {
            "id": "401290604",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#It's all because {NICKNAME} and Goddess Paimon were too strong! We just eradicated all the monsters in one go.",
            "nextDialogs": [
              "401290605"
            ]
          },
          "401290605": {
            "id": "401290605",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "It's okay, Zuria. We can come back again once I've made the crown.",
            "nextDialogs": [
              "401290606"
            ]
          },
          "401290606": {
            "id": "401290606",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Then I must thank all of you again for taking the time. And you too, Thelxie, my child.",
            "nextDialogs": [
              "401290607"
            ]
          },
          "401290607": {
            "id": "401290607",
            "speakerId": 1003,
            "speakerName": "Thelxie",
            "text": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
            "nextDialogs": [
              "401290608"
            ]
          },
          "401290608": {
            "id": "401290608",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Thelxie's turning out to be a real expert at fighting!",
            "nextDialogs": [
              "401290609"
            ]
          },
          "401290609": {
            "id": "401290609",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "I don't think there's anything that will be able to stop him... He's like a true prince now.",
            "nextDialogs": [
              "401290610"
            ]
          },
          "401290610": {
            "id": "401290610",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Yes, I agree as well!",
            "nextDialogs": [
              "401290611"
            ]
          },
          "401290611": {
            "id": "401290611",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "#Let's head back to camp for now. I asked {NICKNAME} to search for some materials on the way because I want to make the crown as soon as possible.",
            "nextDialogs": [
              "401290612"
            ]
          },
          "401290612": {
            "id": "401290612",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We can add an update to Thelxie's Fantastic Adventures as well! Now that we've reclaimed the Kingdom of Water Imps, it's time for us to draw some new scenes in the picture book."
          }
        }
      }
    },
    {
      "subId": "4012913",
      "subQuestName": "Leave the Kingdom of Water Imps",

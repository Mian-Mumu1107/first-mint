      }
    },
    {
      "subId": "4012908",
      "subQuestName": "Return to the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401290801"
        ],
        "dialogs": {
          "401290801": {
            "id": "401290801",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Zuria and Freminet, why don't we draw the new pages first? Paimon really wants to update the picture book!",
            "nextDialogs": [
              "401290802"
            ]
          },
          "401290802": {
            "id": "401290802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You just want to see someone draw Godddess Paimon...",
            "nextDialogs": [
              "401290803"
            ]
          },
          "401290803": {
            "id": "401290803",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey! You didn't have to say it out loud!",
            "nextDialogs": [
              "401290804"
            ]
          },
          "401290804": {
            "id": "401290804",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Haha, no problem, I'm happy to oblige. Then in that case, the story today should go something like this...",
            "nextDialogs": [
              "401290805"
            ]
          },
          "401290805": {
            "id": "401290805",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "After overcoming many obstacles, Prince Thelxie and his brave companions finally arrived at the entrance to the Kingdom of Water Imps.",
            "nextDialogs": [
              "401290806"
            ]
          },
          "401290806": {
            "id": "401290806",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "At this time, the little fairy in the group, Paimon, revealed her true goddess form to her companions.",
            "nextDialogs": [
              "401290807"
            ]
          },
          "401290807": {
            "id": "401290807",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Woohoo! The Goddess has arrived! She praised the companions for their purity, and to reward them, she bestowed upon them many blessings, and even prayed that the Prince would be able to fulfill his goal!",
            "nextDialogs": [
              "401290808"
            ]
          },
          "401290808": {
            "id": "401290808",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Bathed under the Goddess' glory, the Prince and his companions charged into the bastion of evil, chased away the monsters, and rescued the pretty Water Imps from their imprisonment. The Prince finally managed to reclaim his kingdom, but as for the crown...",
            "nextDialogs": [
              "401290809"
            ]
          },
          "401290809": {
            "id": "401290809",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh no, the crown isn't ready yet!",
            "nextDialogs": [
              "401290810"
            ]
          },
          "401290810": {
            "id": "401290810",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "No... The crown was within the Prince's reach, but the monsters took it with them as they fled. They haven't given up and are sure to return, but the prince is certain to reclaim the crown the next time they fight. The brilliant rainbow shall descend onto the kingdom once more...",
            "nextDialogs": [
              "401290811"
            ]
          },
          "401290811": {
            "id": "401290811",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, and Paimon can almost see it all happening now!",
            "nextDialogs": [
              "401290812"
            ]
          },
          "401290812": {
            "id": "401290812",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa, the pages are beautiful... Zuria is really talented at drawing...",
            "nextDialogs": [
              "401290813"
            ]
          },
          "401290813": {
            "id": "401290813",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Thank you, everyone. We've also completed the second page of the picture book now. Thelxie's journey is one step closer to its end and the promised coronation...",
            "nextDialogs": [
              "401290814"
            ]
          },
          "401290814": {
            "id": "401290814",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "My child... You'll also be able to brighten up when that time comes, right?",
            "nextDialogs": [
              "401290815"
            ]
          },
          "401290815": {
            "id": "401290815",
            "speakerId": 1003,
            "speakerName": "Thelxie",
            "text": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
            "nextDialogs": [
              "401290816"
            ]
          },
          "401290816": {
            "id": "401290816",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's sure he will, Zuria! Who knows, perhaps the doctor will already have some good news for you when you get back home today!",
            "nextDialogs": [
              "401290817"
            ]
          },
          "401290817": {
            "id": "401290817",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "I sure hope so, Your Divine Highness. Oh, Freminet, about the time you'll need for the crown...",
            "nextDialogs": [
              "401290818"
            ]
          },
          "401290818": {
            "id": "401290818",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Please don't worry. One day should be more than enough.",
            "nextDialogs": [
              "401290819"
            ]
          },
          "401290819": {
            "id": "401290819",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Ah, then I must thank you for your hard work. Alright, let's rendezvous here in another two days' time for our final adventure, okay?",
            "nextDialogs": [
              "401290820"
            ]
          },
          "401290820": {
            "id": "401290820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sounds good to me.",
            "nextDialogs": [
              "401290821"
            ]
          },
          "401290821": {
            "id": "401290821",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Then see you in two days, my lovely friends. ♪♫♪~",
            "nextDialogs": [
              "401290822"
            ]
          },
          "401290822": {
            "id": "401290822",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Alright, it's about time we start heading off, too. You've still got some work to do, right Freminet?",
            "nextDialogs": [
              "401290823"
            ]
          },
          "401290823": {
            "id": "401290823",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Yeah, I'll need to go to the city shortly to get some parts for the base of the crown. I want to try out a few different designs and choose the one that looks the best.",
            "nextDialogs": [
              "401290826"
            ]
          },
          "401290826": {
            "id": "401290826",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah, Paimon knew that you didn't often take commissions from others... But Paimon had no idea you'd be so dedicated once you're on the job.",
            "nextDialogs": [
              "401290827"
            ]
          },
          "401290827": {
            "id": "401290827",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Ah, well about that... It might be because...",
            "nextDialogs": [
              "401290828"
            ]
          },
          "401290828": {
            "id": "401290828",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh... Because what...?",
            "nextDialogs": [
              "401290829"
            ]
          },
          "401290829": {
            "id": "401290829",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "It's because... I hope...",
            "nextDialogs": [
              "401290830"
            ]
          },
          "401290830": {
            "id": "401290830",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ah, what's the matter? And what's with that look on your face? You're turning red... and it looks like you're about to run away and put your helmet on again!",
            "nextDialogs": [
              "401290831"
            ]
          },
          "401290831": {
            "id": "401290831",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Ahh! Am I turning red?",
            "nextDialogs": [
              "401290832"
            ]
          },
          "401290832": {
            "id": "401290832",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't tease Freminet, Paimon.",
            "nextDialogs": [
              "401290833"
            ]
          },
          "401290833": {
            "id": "401290833",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hehe, alright, alright... We won't bother you anymore for today, Freminet. Let's see each other in two days' time!",
            "nextDialogs": [
              "401290834"
            ]
          },
          "401290834": {
            "id": "401290834",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "...Okay, thank you... See you in two days.",
            "nextDialogs": [
              "401290835"
            ]
          },
          "401290835": {
            "id": "401290835",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "See ya.",
            "nextDialogs": [
              "401290836"
            ]
          },
          "401290836": {
            "id": "401290836",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "...I hope that everyone who's found themselves in a dark place would be able to see something beautiful, and experience a miracle for themselves..."
          }
        }
      }
    },

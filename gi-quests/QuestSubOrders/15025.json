    {
      "subId": "1502515",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150251501"
        ],
        "dialogs": {
          "150251501": {
            "id": "150251501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So the dye is somewhere in this cave, huh?",
            "nextDialogs": [
              "150251502"
            ]
          },
          "150251502": {
            "id": "150251502",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "This is as far as I can take you. Only the appointed ones may proceed from here.",
            "nextDialogs": [
              "150251503"
            ]
          },
          "150251503": {
            "id": "150251503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why's that?",
            "nextDialogs": [
              "150251504"
            ]
          },
          "150251504": {
            "id": "150251504",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "Kind of a long story. Apparently, there's a certain fruit that grows in this cave, the juice of which can be processed to make an excellent dye.",
            "nextDialogs": [
              "150251505"
            ]
          },
          "150251505": {
            "id": "150251505",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "Many years ago, our ancestors set out to make a series of ambitious works of graffiti art. They selected this cave to make them in, presumably due to the availability of the dye.",
            "nextDialogs": [
              "150251506"
            ]
          },
          "150251506": {
            "id": "150251506",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "However, they didn't want anyone to see their work before it was completed. And so, they sealed off the entrance to control access.",
            "nextDialogs": [
              "150251507"
            ]
          },
          "150251507": {
            "id": "150251507",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "To bypass the seal, you have to have mastered the art of color perception, or something like that.",
            "nextDialogs": [
              "150251508"
            ]
          },
          "150251508": {
            "id": "150251508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh..."
          }
        }
      }
    },
    {
      "subId": "1502599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150259901"
        ],
        "dialogs": {
          "150259901": {
            "id": "150259901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like there's no way past... Maybe try the same thing as before?",
            "nextDialogs": [
              "150259902"
            ]
          },
          "150259902": {
            "id": "150259902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You saw something, right? Whatever it was, grab it!"
          }
        }
      }
    }

  "subQuests": [
    {
      "subId": "1502510",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150251001"
        ],
        "dialogs": {
          "150251001": {
            "id": "150251001",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Look at this view. What do you think?",
            "nextDialogs": [
              "150251002"
            ]
          },
          "150251002": {
            "id": "150251002",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's gorgeous!",
            "nextDialogs": [
              "150251003"
            ]
          },
          "150251003": {
            "id": "150251003",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Now, try looking a little further.",
            "nextDialogs": [
              "150251004"
            ]
          },
          "150251004": {
            "id": "150251004",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa... That graffiti...",
            "nextDialogs": [
              "150251005"
            ]
          },
          "150251005": {
            "id": "150251005",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "In all the years since the founding of our tribe, those colors have been with us every step of the way.",
            "nextDialogs": [
              "150251006"
            ]
          },
          "150251006": {
            "id": "150251006",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "It is true that I seek to bring new life to this ancient tribe through change and reform. But I also understand there are certain foundational things that we cannot afford to throw away.",
            "nextDialogs": [
              "150251007"
            ]
          },
          "150251007": {
            "id": "150251007",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "The foremost of these is the way we record our history.",
            "nextDialogs": [
              "150251008"
            ]
          },
          "150251008": {
            "id": "150251008",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That makes sense.",
            "nextDialogs": [
              "150251009"
            ]
          },
          "150251009": {
            "id": "150251009",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Since the very beginnings, our tribe has always sought to bring color to history, and I have a deep sense that this is one part of our heritage that we should not give up.",
            "nextDialogs": [
              "150251010"
            ]
          },
          "150251010": {
            "id": "150251010",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "So whatever it takes, I must find a way for us to continue producing our traditional woven scrolls.",
            "nextDialogs": [
              "150251011"
            ]
          },
          "150251011": {
            "id": "150251011",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You're completely right. Paimon's sorry for what she said earlier. It was out of line...",
            "nextDialogs": [
              "150251012"
            ]
          },
          "150251012": {
            "id": "150251012",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "It's quite alright. I'm just grateful you're able to understand where I'm coming from.",
            "nextDialogs": [
              "150251013"
            ]
          },
          "150251013": {
            "id": "150251013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're committed to helping you solve this.",
            "nextDialogs": [
              "150251014"
            ]
          },
          "150251014": {
            "id": "150251014",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Then let us hope that when we next meet, we succeed in reviving this tradition."
          }
        }
      }
    },
    {
      "subId": "1502501",
      "subQuestName": "Rendezvous with the guide",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250101"
        ],
        "dialogs": {
          "150250101": {
            "id": "150250101",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "I take it you're the ones appointed by Elder Tlapo?",
            "nextDialogs": [
              "150250102"
            ]
          },
          "150250102": {
            "id": "150250102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup! And you are?",
            "nextDialogs": [
              "150250103"
            ]
          },
          "150250103": {
            "id": "150250103",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "Call me Toltec. The chief asked me to be your guide for the day. His messengers already filled me in on the situation. So just follow me!"
          }
        }
      }
    },
    {
      "subId": "1502502",
      "subQuestName": "Go into the fog's depths",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250201"
        ],
        "dialogs": {
          "150250201": {
            "id": "150250201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Haven't we been in here before, though?",
            "nextDialogs": [
              "150250202"
            ]
          },
          "150250202": {
            "id": "150250202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, but don't forget we're the chosen ones.",
            "nextDialogs": [
              "150250203"
            ]
          },
          "150250203": {
            "id": "150250203",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "The strange thing is, our ancestors never removed the seal even after they finished the graffiti art.",
            "nextDialogs": [
              "150250204"
            ]
          },
          "150250204": {
            "id": "150250204",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "Since it was sealed off, the only person who's been inside is the great shaman, Huitzilin. And that was two hundred years ago.",
            "nextDialogs": [
              "150250205"
            ]
          },
          "150250205": {
            "id": "150250205",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "According to her, the artwork tells the story of a hero by the name of Kuntur...",
            "nextDialogs": [
              "150250206"
            ]
          },
          "150250206": {
            "id": "150250206",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "...But I digress. Sorry, I'm a big fan of graffiti artwork, once I get talking I can go on for hours.",
            "nextDialogs": [
              "150250207"
            ]
          },
          "150250207": {
            "id": "150250207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So you're sure you don't wanna come with us?",
            "nextDialogs": [
              "150250208"
            ]
          },
          "150250208": {
            "id": "150250208",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "I'll pass. I tried to get in once, but the seal blocked my way. I tried getting my Iktomisaurus to clear it with its powers, but even that didn't work.",
            "nextDialogs": [
              "150250209"
            ]
          },
          "150250209": {
            "id": "150250209",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "I guess it's supposed to be a test left there by our ancestors. If you don't pass the test, you're not worthy of viewing their works of art.",
            "nextDialogs": [
              "150250210"
            ]
          },
          "150250210": {
            "id": "150250210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Aw...",
            "nextDialogs": [
              "150250211"
            ]
          },
          "150250211": {
            "id": "150250211",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "Don't worry about me though. I wouldn't be joining you this time, even if I was able to get in.",
            "nextDialogs": [
              "150250212"
            ]
          },
          "150250212": {
            "id": "150250212",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "Unlike our chief, I don't have the guts to challenge our traditions. This task is specifically appointed to someone by the Iktomisaur Elder. Who knows what bad things might happen if I got involved?",
            "nextDialogs": [
              "150250213"
            ]
          },
          "150250213": {
            "id": "150250213",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Fair enough. Alright, we'll try not to take too long!"
          }
        }
      }
    },

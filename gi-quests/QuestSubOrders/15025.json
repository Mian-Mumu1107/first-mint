        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502518",
      "subQuestName": "Obtain dye",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150251801"
        ],
        "dialogs": {
          "150251801": {
            "id": "150251801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "These guys' ancestors made some real works of art here. But based on what we've seen so far, it seems like there should be more to the story.",
            "nextDialogs": [
              "150251802"
            ]
          },
          "150251802": {
            "id": "150251802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Do you think maybe there's more artwork further inside? Seems kinda strange...",
            "nextDialogs": [
              "150251804",
              "150251806"
            ]
          },
          "150251804": {
            "id": "150251804",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, no need — Paimon was just thinking aloud. Toltec's waiting for us, and we have a job to do, so maybe it's best if we head out now?",
            "nextDialogs": [
              "150251807"
            ]
          },
          "150251807": {
            "id": "150251807",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's head back and meet up with Toltec!"
          },
          "150251806": {
            "id": "150251806",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, you're right. There's always next time."
          }
        }
      }
    },
    {
      "subId": "1502519",
      "subQuestName": "Obtain dye",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502520",
      "subQuestName": "Obtain dye",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502507",
      "subQuestName": "Obtain dye$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250701"
        ],
        "dialogs": {
          "150250701": {
            "id": "150250701",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Take a look at this — it's a woven scroll made by one of our ancestors. This is the kind of thing we're trying to make.",
            "nextDialogs": [
              "150250702"
            ]
          },
          "150250702": {
            "id": "150250702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "150250703"
            ]
          },
          "150250703": {
            "id": "150250703",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "The person depicted is the legendary shaman, Huitzilin. She lived two hundred years ago, and was once appointed by the Iktomisaur Elder like yourselves.",
            "nextDialogs": [
              "150250704"
            ]
          },
          "150250704": {
            "id": "150250704",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "She was especially skilled in the art of color manipulation, and of course completed her task with flying colors.",
            "nextDialogs": [
              "150250705"
            ]
          },
          "150250705": {
            "id": "150250705",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "This scroll is a record of her deeds, and was most likely the work of her own hand. The quality is simply breathtaking, even compared to other scrolls of this variety.",
            "nextDialogs": [
              "150250706"
            ]
          },
          "150250706": {
            "id": "150250706",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Sadly, since she passed away, all of our Iktomisaur Elder's subsequent appointees have had to rely on the \"gift from the spirits\" to complete their work.",
            "nextDialogs": [
              "150250707"
            ]
          },
          "150250707": {
            "id": "150250707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But now, you're about to revive an older tradition.",
            "nextDialogs": [
              "150250708"
            ]
          },
          "150250708": {
            "id": "150250708",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "That's a good way of putting it. My only quibble with your phrasing would be, it's not just me, but \"us.\"",
            "nextDialogs": [
              "150250709"
            ]
          },
          "150250709": {
            "id": "150250709",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh! Now Paimon's getting excited.",
            "nextDialogs": [
              "150250710"
            ]
          },
          "150250710": {
            "id": "150250710",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Bring out the samples.",
            "nextDialogs": [
              "150250711"
            ]
          },
          "150250711": {
            "id": "150250711",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "An assistant presents the samples for test-dyeing.",
            "nextDialogs": [
              "150250712"
            ]
          },
          "150250712": {
            "id": "150250712",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Now, as I mentioned, the dyeing process is a little complicated, but I am confident you will manage. Just make sure to follow my instructions carefully.",
            "nextDialogs": [
              "150250713"
            ]
          },
          "150250713": {
            "id": "150250713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will do. Let's get started.",
            "nextDialogs": [
              "150250714"
            ]
          },
          "150250714": {
            "id": "150250714",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "The pattern has already been sketched out on the sample, so you just need to dye each block with the correct color. But you'll need to wait for the dye to fully soak in between each step to make sure the colors don't run.",
            "nextDialogs": [
              "150250715"
            ]
          },
          "150250715": {
            "id": "150250715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Dye the fabric as instructed.)",
            "nextDialogs": [
              "150250716"
            ]
          },
          "150250716": {
            "id": "150250716",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Good. The dye has taken to the fabric, and the pattern is crisp and clear. Next, apply all the remaining dye and we should see that elusive signature color emerge.",
            "nextDialogs": [
              "150250717"
            ]
          },
          "150250717": {
            "id": "150250717",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, final step!",
            "nextDialogs": [
              "150250718"
            ]
          },
          "150250718": {
            "id": "150250718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Apply the remaining dye.)",
            "nextDialogs": [
              "150250719"
            ]
          },
          "150250719": {
            "id": "150250719",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um... Did it work? Paimon doesn't see it...",
            "nextDialogs": [
              "150250720"
            ]
          },
          "150250720": {
            "id": "150250720",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "That color isn't showing up... The dyeing has failed.",
            "nextDialogs": [
              "150250721"
            ]
          },
          "150250721": {
            "id": "150250721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did I mess up somehow?",
            "nextDialogs": [
              "150250722"
            ]
          },
          "150250722": {
            "id": "150250722",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "No, your technique was flawless. You did everything exactly as instructed. It would have made no difference if I'd done it myself.",
            "nextDialogs": [
              "150250723"
            ]
          },
          "150250723": {
            "id": "150250723",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then what went wrong?",
            "nextDialogs": [
              "150250724"
            ]
          },
          "150250724": {
            "id": "150250724",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "It could be the weaving technique, or maybe the dye has to be applied in a different way... Whatever the case, it looks like I have failed to get to the bottom of this mystery.",
            "nextDialogs": [
              "150250725"
            ]
          },
          "150250725": {
            "id": "150250725",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sorry... Paimon wishes we could do more to help.",
            "nextDialogs": [
              "150250726"
            ]
          },
          "150250726": {
            "id": "150250726",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "I am the one who should be apologizing. I made you do so much work, and it was for nothing.",
            "nextDialogs": [
              "150250727"
            ]
          },
          "150250727": {
            "id": "150250727",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "I will of course honor my commitment to compensate you for your trouble, but I do hope you won't give up on this task. I plan to keep investigating, and will be sure to keep you updated with any progress.",
            "nextDialogs": [
              "150250728"
            ]
          },
          "150250728": {
            "id": "150250728",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't worry, we're not quitters!",
            "nextDialogs": [
              "150250729"
            ]
          },
          "150250729": {
            "id": "150250729",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon does have a question though... Um, this whole process of recording history on woven scrolls seems so complicated. Why don't you just write it down instead?",
            "nextDialogs": [
              "150250730"
            ]
          },
          "150250730": {
            "id": "150250730",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You said yourself, you're all about change and reform. Well, this seems like a pretty good place to start, don't you think? Writing things down would be easier for everyone, and your records would be more detailed.",
            "nextDialogs": [
              "150250731"
            ]
          },
          "150250731": {
            "id": "150250731",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "...I think you've perhaps misunderstood my philosophy, but that's okay. I can answer your question, but there's somewhere I need to show you first.",
            "nextDialogs": [
              "150250732"
            ]
          },
          "150250732": {
            "id": "150250732",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh... sure."
          }
        }
      }
    },
    {
      "subId": "1502516",
      "subQuestName": "Prepare to leave",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150251201"
        ],
        "dialogs": {
          "150251201": {
            "id": "150251201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Remember the last time we came here? We found all of the artwork throughout the cave. These guys' ancestors created a real masterpiece!",
            "nextDialogs": [
              "150251202"
            ]
          },
          "150251202": {
            "id": "150251202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "They probably used the same stuff for their paint as we're using for the dye, right? Maybe we'll create a masterpiece of our own!",
            "nextDialogs": [
              "150251203"
            ]
          },
          "150251203": {
            "id": "150251203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then we'd better get started.",
            "nextDialogs": [
              "150251204"
            ]
          },
          "150251204": {
            "id": "150251204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup, let's head back and meet up with Toltec!"
          }
        }
      }
    },
    {
      "subId": "1502508",
      "subQuestName": "Meet up with Toltec",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250801"
        ],
        "dialogs": {
          "150250801": {
            "id": "150250801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're back! And we found the ingredients for the dye.",
            "nextDialogs": [
              "150250802"
            ]
          },
          "150250802": {
            "id": "150250802",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "Sounds like you made it through the seal then! Our Iktomisaur Elder was right about you.",
            "nextDialogs": [
              "150250803"
            ]
          },
          "150250803": {
            "id": "150250803",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "It's getting late. Follow me, I'll take us back."
          }
        }
      }
    },
    {
      "subId": "1502509",
      "subQuestName": "Return to the Masters of the Night-Wind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250901"
        ],
        "dialogs": {
          "150250901": {
            "id": "150250901",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Toltec has updated me on your progress. Well done, I appreciate your efforts.",
            "nextDialogs": [
              "150250902"
            ]
          },
          "150250902": {
            "id": "150250902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sure thing! Here's the stuff for the dye."
          }
        }
      }
    },
    {
      "subId": "1502515",
      "subQuestName": "Give the dye to Biram",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150251301"
        ],
        "dialogs": {
          "150251301": {
            "id": "150251301",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "I see... yes, this is certainly a very different substance from typical dyes... Okay, now let's try our hand at making some samples. The fabric is ready for testing.",
            "nextDialogs": [
              "150251302"
            ]
          },
          "150251302": {
            "id": "150251302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Got it!",
            "nextDialogs": [
              "150251303"
            ]
          },
          "150251303": {
            "id": "150251303",
            "speakerId": 1000,
            "speakerName": "Biram",
            "text": "Please, follow me."
          }
        }
      }
    },

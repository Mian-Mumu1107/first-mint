    {
      "subId": "1502505",
      "subQuestName": "Go into the cave's depths",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250501"
        ],
        "dialogs": {
          "150250501": {
            "id": "150250501",
            "speakerId": 1002,
            "speakerName": "Toltec",
            "text": "You two head on in. I'll wait right here."
          }
        }
      }
    },
    {
      "subId": "1502504",
      "subQuestName": "Try to break the barrier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150250401"
        ],
        "dialogs": {
          "150250401": {
            "id": "150250401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This should be the place! That fruit Toltec mentioned should be the one on the wall, right?",
            "nextDialogs": [
              "150250402"
            ]
          },
          "150250402": {
            "id": "150250402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon didn't notice it last time we were here.",
            "nextDialogs": [
              "150250403"
            ]
          },
          "150250403": {
            "id": "150250403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Now the only question is, which ones do we pick?",
            "nextDialogs": [
              "150250404"
            ]
          },
          "150250404": {
            "id": "150250404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is probably where my special ability the chief mentioned comes in.",
            "nextDialogs": [
              "150250405"
            ]
          },
          "150250405": {
            "id": "150250405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, go ahead, try it out!"
          }
        }
      }
    },

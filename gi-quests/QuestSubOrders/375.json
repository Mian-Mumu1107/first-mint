        "dialogs": {
          "3750202": {
            "id": "3750202",
            "speakerId": 1162,
            "speakerName": "Otto",
            "text": "Man, this stinks. Having to stand around here all <color=#00E1FFFF>day</color> long, having to guard this entrance.\\nHey! Don't move! You can't go down there!",
            "nextDialogs": [
              "3750203"
            ]
          },
          "3750203": {
            "id": "3750203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems we're gonna have to wait until <color=#00E1FFFF>nightfall</color> to sneak in..."
          }

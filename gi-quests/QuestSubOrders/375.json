  "subQuests": [
    {
      "subId": "37501",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3750101"
        ],
        "dialogs": {
          "3750101": {
            "id": "3750101",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "It didn't work... I knew it.",
            "nextDialogs": [
              "3750102"
            ]
          },
          "3750102": {
            "id": "3750102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You \"knew it\"?",
            "nextDialogs": [
              "3750103"
            ]
          },
          "3750103": {
            "id": "3750103",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#I just wanted to know how influential {NICKNAME} — the hotshot of the Knights of the Favonius — is.",
            "nextDialogs": [
              "3750104"
            ]
          },
          "3750104": {
            "id": "3750104",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "You see, the best warrior should always be presented with the best sword, and yet here we are...",
            "nextDialogs": [
              "3750105"
            ]
          },
          "3750105": {
            "id": "3750105",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Does the story not make for a fitting ballad?",
            "nextDialogs": [
              "3750106"
            ]
          },
          "3750106": {
            "id": "3750106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So what are you trying to say? That we're not good enough?",
            "nextDialogs": [
              "3750107"
            ]
          },
          "3750107": {
            "id": "3750107",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "No, that's not it. More of a commentary regarding Mondstadt's inability to see the warrior standing right before its very eyes.",
            "nextDialogs": [
              "3750108"
            ]
          },
          "3750108": {
            "id": "3750108",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Very well. Looks like borrowing it is not going to be possible. We're simply going to have to steal it.",
            "nextDialogs": [
              "3750109"
            ]
          },
          "3750109": {
            "id": "3750109",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Today we stand for free will! Any suggestions on just how we steal it?",
            "nextDialogs": [
              "3750110"
            ]
          },
          "3750110": {
            "id": "3750110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "3750111"
            ]
          },
          "3750111": {
            "id": "3750111",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Come now, speak up. That's what free will is for.",
            "nextDialogs": [
              "3750112"
            ]
          },
          "3750112": {
            "id": "3750112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't want to steal anything!",
            "nextDialogs": [
              "3750113"
            ]
          },
          "3750113": {
            "id": "3750113",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Hahaha, look at you. Sidetracked from the start.",
            "nextDialogs": [
              "3750114"
            ]
          },
          "3750114": {
            "id": "3750114",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "But seriously, you're more suitable for the job than I.",
            "nextDialogs": [
              "3750115"
            ]
          },
          "3750115": {
            "id": "3750115",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Aside from singing, I don't really have any other talents.",
            "nextDialogs": [
              "3750116"
            ]
          },
          "3750116": {
            "id": "3750116",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Besides, if I was caught, I'd have no one to right the grave injustice of my arrest.",
            "nextDialogs": [
              "3750117"
            ]
          },
          "3750117": {
            "id": "3750117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How can it be a \"grave injustice\" if you got caught stealing red-handed?",
            "nextDialogs": [
              "3750118"
            ]
          },
          "3750118": {
            "id": "3750118",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#But things are different for {NICKNAME}. You are the superstar of the Knights of Favonius. You have made contributions to Mondstadt.",
            "nextDialogs": [
              "3750119"
            ]
          },
          "3750119": {
            "id": "3750119",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Should you get caught, you would easily be able to talk your way out of it.",
            "nextDialogs": [
              "3750120"
            ]
          },
          "3750120": {
            "id": "3750120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Stop mentioning us getting caught!",
            "nextDialogs": [
              "3750121"
            ]
          },
          "3750121": {
            "id": "3750121",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#{NICKNAME}... What do you say?",
            "nextDialogs": [
              "3750122"
            ]
          },
          "3750122": {
            "id": "3750122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sorry— Wait... Did you just say... you're Barbatos?",
            "nextDialogs": [
              "3750123"
            ]
          },
          "3750123": {
            "id": "3750123",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Ah, yes. Seems I did mention that...",
            "nextDialogs": [
              "3750124"
            ]
          },
          "3750124": {
            "id": "3750124",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Your point being?",
            "nextDialogs": [
              "3750125"
            ]
          },
          "3750125": {
            "id": "3750125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If you really are a god, then we can't simply abandon you.",
            "nextDialogs": [
              "3750126"
            ]
          },
          "3750126": {
            "id": "3750126",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Why does your decision hinge upon whether or not I am a god?",
            "nextDialogs": [
              "3750127"
            ]
          },
          "3750127": {
            "id": "3750127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Paimon'll fill you in on {NICKNAME}'s background story when we get the time...",
            "nextDialogs": [
              "3750128"
            ]
          },
          "3750128": {
            "id": "3750128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And if you're not a god, then I'll help Dvalin anyway.",
            "nextDialogs": [
              "3750129"
            ]
          },
          "3750129": {
            "id": "3750129",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Huh?"
          }
        }
      }
    },

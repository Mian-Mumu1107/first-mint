  },
  "subQuests": [
    {
      "subId": "1303201",
      "subQuestName": "Go to the Mawtiyima Forest with Arapurva",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130320101"
        ],
        "dialogs": {
          "130320101": {
            "id": "130320101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, Paimon's been meaning to ask what you meant by \"prepared.\"",
            "nextDialogs": [
              "130320102"
            ]
          },
          "130320102": {
            "id": "130320102",
            "speakerId": 13303,
            "speakerName": "Arapurva",
            "text": "Nara Avin has not completely remembered. Memories and dreams are both necessary.",
            "nextDialogs": [
              "130320103"
            ]
          },
          "130320103": {
            "id": "130320103",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Dreams...",
            "nextDialogs": [
              "130320104"
            ]
          },
          "130320104": {
            "id": "130320104",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "But I'll never be able to stand again. Even if I can recover, I don't know how long that'll take.",
            "nextDialogs": [
              "130320105"
            ]
          },
          "130320105": {
            "id": "130320105",
            "speakerId": 13303,
            "speakerName": "Arapurva",
            "text": "Such worries are not needed here. Nara Avin, you must remember. Dreams are connected to your heart, not your body.",
            "nextDialogs": [
              "130320106"
            ]
          },
          "130320106": {
            "id": "130320106",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "My heart...?",
            "nextDialogs": [
              "130320107"
            ]
          },
          "130320107": {
            "id": "130320107",
            "speakerId": 13303,
            "speakerName": "Arapurva",
            "text": "I led you this far, but now Nara Avin must find her precious things by herself.",
            "nextDialogs": [
              "130320108"
            ]
          },
          "130320108": {
            "id": "130320108",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Huh? He's gone, just like that?",
            "nextDialogs": [
              "130320109"
            ]
          },
          "130320109": {
            "id": "130320109",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "It looks like the sky here has changed somewhat.",
            "nextDialogs": [
              "130320110"
            ]
          },
          "130320110": {
            "id": "130320110",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "My heart...",
            "nextDialogs": [
              "130320111"
            ]
          },
          "130320111": {
            "id": "130320111",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "...!",
            "nextDialogs": [
              "130320112"
            ]
          },
          "130320112": {
            "id": "130320112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh!?",
            "nextDialogs": [
              "130320113"
            ]
          },
          "130320113": {
            "id": "130320113",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I... stood up.",
            "nextDialogs": [
              "130320114"
            ]
          },
          "130320114": {
            "id": "130320114",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "It wasn't hard at all, and it didn't feel weird. It was like... how things were before I got sick.",
            "nextDialogs": [
              "130320115"
            ]
          },
          "130320115": {
            "id": "130320115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, so that means we're...",
            "nextDialogs": [
              "130320116"
            ]
          },
          "130320116": {
            "id": "130320116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're inside a dream.",
            "nextDialogs": [
              "130320117"
            ]
          },
          "130320117": {
            "id": "130320117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Not our first time in one. Ah, no wonder Arapurva said not to worry... Avin can move freely in this dream.",
            "nextDialogs": [
              "130320118"
            ]
          },
          "130320118": {
            "id": "130320118",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Wow, that's amazing, is this... the power of my heart?",
            "nextDialogs": [
              "130320119"
            ]
          },
          "130320119": {
            "id": "130320119",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "How amazing! Now we can all look for Arashani together.",
            "nextDialogs": [
              "130320120"
            ]
          },
          "130320120": {
            "id": "130320120",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "C'mon, let's race! Lemme see how good you really are!",
            "nextDialogs": [
              "130320121"
            ]
          },
          "130320121": {
            "id": "130320121",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I might not have recovered yet...",
            "nextDialogs": [
              "130320122"
            ]
          },
          "130320122": {
            "id": "130320122",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Whatever, let's go! I won't lose, not even to an adult!",
            "nextDialogs": [
              "130320123"
            ]
          },
          "130320123": {
            "id": "130320123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, and off she goes!",
            "nextDialogs": [
              "130320124"
            ]
          },
          "130320124": {
            "id": "130320124",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, this was easy. Paimon thought she'd need more time.",
            "nextDialogs": [
              "130320127"
            ]
          },
          "130320127": {
            "id": "130320127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, that's true. Let's catch up with them."
          }
        }
      }
    },
    {
      "subId": "1303202",
      "subQuestName": "Catch up to Avin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130320201"
        ],
        "dialogs": {
          "130320201": {
            "id": "130320201",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "*pants* You're... good...",
            "nextDialogs": [
              "130320202"
            ]
          },
          "130320202": {
            "id": "130320202",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hehe, if we had run any further, you would've caught up!",
            "nextDialogs": [
              "130320203"
            ]
          },
          "130320203": {
            "id": "130320203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Avin was neck and neck with Yoimiya!",
            "nextDialogs": [
              "130320204"
            ]
          },
          "130320204": {
            "id": "130320204",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I've outrun lots of adults before. Long legs don't necessarily mean you run faster. Training's important, too.",
            "nextDialogs": [
              "130320205"
            ]
          },
          "130320205": {
            "id": "130320205",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Haha, I won't even be able to compete with you in a few years.",
            "nextDialogs": [
              "130320206"
            ]
          },
          "130320206": {
            "id": "130320206",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hm, let's see... Where should we go next?",
            "nextDialogs": [
              "130320207"
            ]
          },
          "130320207": {
            "id": "130320207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, look! Something's floating up ahead!",
            "nextDialogs": [
              "130320208"
            ]
          },
          "130320208": {
            "id": "130320208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It looks like a... star?",
            "nextDialogs": [
              "130320209"
            ]
          },
          "130320209": {
            "id": "130320209",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Does it want us to follow it?",
            "nextDialogs": [
              "130320210"
            ]
          },
          "130320210": {
            "id": "130320210",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hmm, maybe. Let's follow it."
          }
        }
      }
    },
    {
      "subId": "1303203",
      "subQuestName": "Catch up to the drifting star",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

      }
    },
    {
      "subId": "1303204",
      "subQuestName": "Continue chasing after the star",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1303205",
      "subQuestName": "Talk to Avin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130320501"
        ],
        "dialogs": {
          "130320501": {
            "id": "130320501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is our destination? But Paimon doesn't see an Aranara. Just this big stone.",
            "nextDialogs": [
              "130320502"
            ]
          },
          "130320502": {
            "id": "130320502",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I'm so happy... I almost forgot how it feels to be this happy...",
            "nextDialogs": [
              "130320503"
            ]
          },
          "130320503": {
            "id": "130320503",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "You know, at first, it felt like my world had shrunk down to a tiny space.",
            "nextDialogs": [
              "130320504"
            ]
          },
          "130320504": {
            "id": "130320504",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "But as long as I continue moving forward, new sights will always appear in front of me, and my world will keep expanding before my eyes.",
            "nextDialogs": [
              "130320505"
            ]
          },
          "130320505": {
            "id": "130320505",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Even though I don't know how I did it, I know I have you all to thank.",
            "nextDialogs": [
              "130320506"
            ]
          },
          "130320506": {
            "id": "130320506",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Oh, that's not important. What's important is that you've remembered the joy of going through the world.",
            "nextDialogs": [
              "130320507"
            ]
          },
          "130320507": {
            "id": "130320507",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Our memories don't just symbolize our past. They can also shine a light on our future.",
            "nextDialogs": [
              "130320508"
            ]
          },
          "130320508": {
            "id": "130320508",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Once you find the hope in your heart again, that happiness will come back to you.",
            "nextDialogs": [
              "130320509"
            ]
          },
          "130320509": {
            "id": "130320509",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Yes! Thank you, Yoimiya! Thank you all!",
            "nextDialogs": [
              "130320510"
            ]
          },
          "130320510": {
            "id": "130320510",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Let's keep looking for Arashani. It doesn't look like he's here.",
            "nextDialogs": [
              "130320511"
            ]
          },
          "130320511": {
            "id": "130320511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah... Uh, then why would the star lead us here?",
            "nextDialogs": [
              "130320512"
            ]
          },
          "130320512": {
            "id": "130320512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This stone really stands out.",
            "nextDialogs": [
              "130320513"
            ]
          },
          "130320513": {
            "id": "130320513",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I dunno how to explain this... I don't know what it is, but it feels very familiar...",
            "nextDialogs": [
              "130320514"
            ]
          },
          "130320514": {
            "id": "130320514",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Almost like it's a part of me.",
            "nextDialogs": [
              "130320515"
            ]
          },
          "130320515": {
            "id": "130320515",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I know!",
            "nextDialogs": [
              "130320516"
            ]
          },
          "130320516": {
            "id": "130320516",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Could this stone be your Urstone?",
            "nextDialogs": [
              "130320517"
            ]
          },
          "130320517": {
            "id": "130320517",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Ur—Urstone?",
            "nextDialogs": [
              "130320520"
            ]
          },
          "130320520": {
            "id": "130320520",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "It's a very rare ore that symbolizes a person's aspirations and dreams.",
            "nextDialogs": [
              "130320521"
            ]
          },
          "130320521": {
            "id": "130320521",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Since you can see it, that means you've found what you've lost.",
            "nextDialogs": [
              "130320522"
            ]
          },
          "130320522": {
            "id": "130320522",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Is that how it works...?",
            "nextDialogs": [
              "130320523"
            ]
          },
          "130320523": {
            "id": "130320523",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "It's just like in fairy tales... I thought I'd stopped believing in those.",
            "nextDialogs": [
              "130320524"
            ]
          },
          "130320524": {
            "id": "130320524",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "But I'm glad that I found that belief again.",
            "nextDialogs": [
              "130320525"
            ]
          },
          "130320525": {
            "id": "130320525",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Th—They passed right through!",
            "nextDialogs": [
              "130320526"
            ]
          },
          "130320526": {
            "id": "130320526",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Let's go after them!",
            "nextDialogs": [
              "130320527"
            ]
          },
          "130320527": {
            "id": "130320527",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Yoimiya! HEY! ...Well, we have no choice.",
            "nextDialogs": [
              "130320528"
            ]
          },
          "130320528": {
            "id": "130320528",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We passed through, but nothing seems to have changed.",
            "nextDialogs": [
              "130320529"
            ]
          },
          "130320529": {
            "id": "130320529",
            "speakerId": 13262,
            "speakerName": "Arashani",
            "text": "It has been a while, Nara Avin. It really has been a while, yes?",
            "nextDialogs": [
              "130320530"
            ]
          },
          "130320530": {
            "id": "130320530",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Arashani...",
            "nextDialogs": [
              "130320531"
            ]
          },
          "130320531": {
            "id": "130320531",
            "speakerId": 13262,
            "speakerName": "Arashani",
            "text": "Why do you look sad? Oh. Arashani knows. You are happy.",
            "nextDialogs": [
              "130320532"
            ]
          },
          "130320532": {
            "id": "130320532",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Arashani! *sobs*",
            "nextDialogs": [
              "130320533"
            ]
          },
          "130320533": {
            "id": "130320533",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Aw, the Aranara sure have a flair for magical journeys.",
            "nextDialogs": [
              "130320534"
            ]
          },
          "130320534": {
            "id": "130320534",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "They not only helped Avin find her best friend, but they also showed us what an Urstone is.",
            "nextDialogs": [
              "130320535"
            ]
          },
          "130320535": {
            "id": "130320535",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Oh, um, we have to look for one of our own later — to make the purest lens.",
            "nextDialogs": [
              "130320536"
            ]
          },
          "130320536": {
            "id": "130320536",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yep! It's kinda funny, but Paimon thinks we can actually do it."
          }
        }
      }
    },
    {
      "subId": "1303206",
      "subQuestName": "Talk to Yoimiya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130320601"
        ],
        "dialogs": {
          "130320601": {
            "id": "130320601",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "It... The dream ended.",
            "nextDialogs": [
              "130320602"
            ]
          },
          "130320602": {
            "id": "130320602",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "We dreamed a most lovely dream.",
            "nextDialogs": [
              "130320603"
            ]
          },
          "130320603": {
            "id": "130320603",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Don't look so lonely! He's right next to you.",
            "nextDialogs": [
              "130320604"
            ]
          },
          "130320604": {
            "id": "130320604",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Arashani! Y—You're... still here...",
            "nextDialogs": [
              "130320605"
            ]
          },
          "130320605": {
            "id": "130320605",
            "speakerId": 13262,
            "speakerName": "Arashani",
            "text": "Arashani wants to say sorry. It is not that Arashani did not want to find Nara. Arashani could not remember the time.",
            "nextDialogs": [
              "130320606"
            ]
          },
          "130320606": {
            "id": "130320606",
            "speakerId": 13262,
            "speakerName": "Arashani",
            "text": "Arashani does not dare enter the city. Arashani did not see Nara Avin, so Arashani thought you had made new friends.",
            "nextDialogs": [
              "130320607"
            ]
          },
          "130320607": {
            "id": "130320607",
            "speakerId": 13303,
            "speakerName": "Arapurva",
            "text": "That is normal and unavoidable. It is not something to be grieved.",
            "nextDialogs": [
              "130320608"
            ]
          },
          "130320608": {
            "id": "130320608",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "It's okay, I understand. This happened because I lost sight of myself.",
            "nextDialogs": [
              "130320609"
            ]
          },
          "130320609": {
            "id": "130320609",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "But I think I understand now. Yoimiya's right. Everyone gets bad luck, but we have to support each other through unlucky times.",
            "nextDialogs": [
              "130320610"
            ]
          },
          "130320610": {
            "id": "130320610",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Thanks for helping me rediscover my memories and dreams. I won't let your work go to waste.",
            "nextDialogs": [
              "130320611"
            ]
          },
          "130320611": {
            "id": "130320611",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hehe. You've also helped us a lot, so don't be so humble! To be honest, we didn't know where to start with the Urstone.",
            "nextDialogs": [
              "130320612"
            ]
          },
          "130320612": {
            "id": "130320612",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "But now that we're on this track, I think we'll find it easy!",
            "nextDialogs": [
              "130320613"
            ]
          },
          "130320613": {
            "id": "130320613",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Yoimiya, you need this Urstone because you want to see a meteor shower?",
            "nextDialogs": [
              "130320614"
            ]
          },
          "130320614": {
            "id": "130320614",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Yep. Oh! Once we find it, you should come with us!",
            "nextDialogs": [
              "130320615"
            ]
          },
          "130320615": {
            "id": "130320615",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "If that's how things are...",
            "nextDialogs": [
              "130320616"
            ]
          },
          "130320616": {
            "id": "130320616",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I'm happy to lend you my Urstone.",
            "nextDialogs": [
              "130320617"
            ]
          },
          "130320617": {
            "id": "130320617",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wha!?",
            "nextDialogs": [
              "130320618"
            ]
          },
          "130320618": {
            "id": "130320618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wh—What just happened? Did you just take... glasses out of your chest?",
            "nextDialogs": [
              "130320619"
            ]
          },
          "130320619": {
            "id": "130320619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have no idea what's going on, either.",
            "nextDialogs": [
              "130320620"
            ]
          },
          "130320620": {
            "id": "130320620",
            "speakerId": 13303,
            "speakerName": "Arapurva",
            "text": "...",
            "nextDialogs": [
              "130320621"
            ]
          },
          "130320621": {
            "id": "130320621",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hahaha, how'd you know we'd need this?",
            "nextDialogs": [
              "130320622"
            ]
          },
          "130320622": {
            "id": "130320622",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I didn't. I just thought that since you helped me find my precious friend, I should help you using something precious to me...",
            "nextDialogs": [
              "130320623"
            ]
          },
          "130320623": {
            "id": "130320623",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "And then the light turned into this. Is this what you needed?",
            "nextDialogs": [
              "130320624"
            ]
          },
          "130320624": {
            "id": "130320624",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Thank you. I didn't expect us to solve our problem like this. Alright, time to give it a go!",
            "nextDialogs": [
              "130320625"
            ]
          },
          "130320625": {
            "id": "130320625",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Not that I know how to use it, but let's see what my intuition says.",
            "nextDialogs": [
              "130320626"
            ]
          },
          "130320626": {
            "id": "130320626",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Where are you... Where are you...",
            "nextDialogs": [
              "130320627"
            ]
          },
          "130320627": {
            "id": "130320627",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Ooh! I think I see it! Oh, uh... It was pretty obvious.",
            "nextDialogs": [
              "130320628"
            ]
          },
          "130320628": {
            "id": "130320628",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "C'mon, I'll lead the way. Once we're done watching the meteor shower, I'll accompany you home.",
            "nextDialogs": [
              "130320629"
            ]
          },
          "130320629": {
            "id": "130320629",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Also, thank you for helping us. Actually, let me scrap the pleasantries and give you a heartfelt compliment instead!",
            "nextDialogs": [
              "130320630"
            ]
          },
          "130320630": {
            "id": "130320630",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "You all are great storytellers!",
            "nextDialogs": [
              "130320631"
            ]
          },
          "130320631": {
            "id": "130320631",
            "speakerId": 13303,
            "speakerName": "Arapurva",
            "text": "Oh, what a coincidence. I would say the same for you, Red Nara."
          }
        }
      }
    },
    {
      "subId": "1303208",
      "subQuestName": "Observe the meteor shower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1303209",
      "subQuestName": "Talk to Yoimiya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130320901"
        ],
        "dialogs": {
          "130320901": {
            "id": "130320901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mmm... Ugh...",
            "nextDialogs": [
              "130320902"
            ]
          },
          "130320902": {
            "id": "130320902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're waking up already? But Paimon wants to watch more...",
            "nextDialogs": [
              "130320903"
            ]
          },
          "130320903": {
            "id": "130320903",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "The meteors we summoned flew up from the ground...",
            "nextDialogs": [
              "130320904"
            ]
          },
          "130320904": {
            "id": "130320904",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "They were exactly like fireworks!",
            "nextDialogs": [
              "130320905"
            ]
          },
          "130320905": {
            "id": "130320905",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Ah, I could've kept watching that forever. That was the realest, grandest, most magical dream I've ever had!",
            "nextDialogs": [
              "130320906"
            ]
          },
          "130320906": {
            "id": "130320906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon too! Paimon didn't expect you to just pull us onto that shooting star, though.",
            "nextDialogs": [
              "130320907"
            ]
          },
          "130320907": {
            "id": "130320907",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hehe~ Honestly, I didn't think about it at all. I just thought it'd be a shame if we didn't try something crazy.",
            "nextDialogs": [
              "130320910"
            ]
          },
          "130320910": {
            "id": "130320910",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "You know me. It really doesn't matter to me if our experience was real or a dream.",
            "nextDialogs": [
              "130320911"
            ]
          },
          "130320911": {
            "id": "130320911",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I really should thank you two, though. You set all this up as a backup plan because you knew that meteor showers are hard to catch, right?",
            "nextDialogs": [
              "130320912"
            ]
          },
          "130320912": {
            "id": "130320912",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Don't worry, I loved it so so so much! I think this ranks as the absolute best gift I've ever been given.",
            "nextDialogs": [
              "130320913"
            ]
          },
          "130320913": {
            "id": "130320913",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh phew, that's good. Paimon was afraid that you might be angry after hearing the truth.",
            "nextDialogs": [
              "130320914"
            ]
          },
          "130320914": {
            "id": "130320914",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Why would I be? I dreamed about helpful, friendly, cute Aranara...",
            "nextDialogs": [
              "130320915"
            ]
          },
          "130320915": {
            "id": "130320915",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I dreamed that we ran and jumped atop large mushrooms, and we discovered Urstone in a very unexpected way...",
            "nextDialogs": [
              "130320916"
            ]
          },
          "130320916": {
            "id": "130320916",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "And when I thought we had woken up, the next part was even more amazing!",
            "nextDialogs": [
              "130320917"
            ]
          },
          "130320917": {
            "id": "130320917",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "From her heart, Avin brought forth Urstone glasses. We found meteors that flew up from the earth, and we even became one with the shooting stars themselves..."
          }
        }
      }
    },
    {
      "subId": "1303211",
      "subQuestName": "Go to Port Ormos for Yoimiya's send-off",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130321105"
        ],
        "dialogs": {
          "130321105": {
            "id": "130321105",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Sumeru's such a nice place. I'll be back for sure!",
            "nextDialogs": [
              "130321106"
            ]
          },
          "130321106": {
            "id": "130321106",
            "speakerId": 13263,
            "speakerName": "Niousha",
            "text": "You will always be welcome here. Avin would be happy to see you again.",
            "nextDialogs": [
              "130321107"
            ]
          },
          "130321107": {
            "id": "130321107",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "It's a deal! I'll be waiting for you.",
            "nextDialogs": [
              "130321108"
            ]
          },
          "130321108": {
            "id": "130321108",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hahaha, you got it!",
            "nextDialogs": [
              "130321109"
            ]
          },
          "130321109": {
            "id": "130321109",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "Yoimiya, before you go back, I want to tell you about my new dream.",
            "nextDialogs": [
              "130321110"
            ]
          },
          "130321110": {
            "id": "130321110",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "I want to travel to Inazuma on my own and watch a fireworks show there.",
            "nextDialogs": [
              "130321111"
            ]
          },
          "130321111": {
            "id": "130321111",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Wow, that's impressive! Hehe, I didn't expect to be introduced to new customers while on vacation.",
            "nextDialogs": [
              "130321112"
            ]
          },
          "130321112": {
            "id": "130321112",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Don't worry, I'll make you some fireworks that you'll never forget!",
            "nextDialogs": [
              "130321113"
            ]
          },
          "130321113": {
            "id": "130321113",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "You two as well. No matter how busy your adventures get, remember to come back to Inazuma. We'll always welcome you, no matter when you drop by!",
            "nextDialogs": [
              "130321114"
            ]
          },
          "130321114": {
            "id": "130321114",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "You've got to come and watch the fireworks this meteor shower inspired as they soar high in the sky!",
            "nextDialogs": [
              "130321115"
            ]
          },
          "130321115": {
            "id": "130321115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sounds like a plan!",
            "nextDialogs": [
              "130321117",
              "130321119",
              "130321121"
            ]
          },
          "130321117": {
            "id": "130321117",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I will, I will! Haha, you're as earnest as ever.",
            "nextDialogs": [
              "130321122"
            ]
          },
          "130321122": {
            "id": "130321122",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Oh yeah, by the way, have a look at this.",
            "nextDialogs": [
              "130321123"
            ]
          },
          "130321123": {
            "id": "130321123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "An Aranara Carving...",
            "nextDialogs": [
              "130321124"
            ]
          },
          "130321124": {
            "id": "130321124",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "That's right. This is the one you helped me pick, and you said it looked kinda like me. I went to buy another one — this one's for you.",
            "nextDialogs": [
              "130321125"
            ]
          },
          "130321125": {
            "id": "130321125",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Look at it whenever you're feeling down. Who knows, maybe it'll raise your spirits. If nothing else, you'll know that I'm supporting you all the way.",
            "nextDialogs": [
              "130321126"
            ]
          },
          "130321126": {
            "id": "130321126",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Of course, meeting in person is still better, hehe."
          },
          "130321119": {
            "id": "130321119",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Every day, and forever!"
          },
          "130321121": {
            "id": "130321121",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Wh—Why'd you just shout that out? It's embarrassing..."
          }
        }
      }
    },
    {
      "subId": "1303299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130329901"
        ],
        "dialogs": {
          "130329901": {
            "id": "130329901",
            "speakerId": 13261,
            "speakerName": "Avin",
            "text": "(Yoimiya's fast... I was so close to winning.)",
            "nextDialogs": [
              "130329902"
            ]
          },
          "130329902": {
            "id": "130329902",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "(Avin almost caught up to me. She sure is something.)",
            "nextDialogs": [
              "130329908"
            ]
          },
          "130329908": {
            "id": "130329908",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "Losing your way in the dream, you somehow find yourself back at the beginning..."
          }
        }
      }
    }
  ]
}
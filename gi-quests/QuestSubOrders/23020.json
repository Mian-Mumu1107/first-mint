    {
      "subId": "2302004",
      "subQuestName": "Return and report the situation to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200401"
        ],
        "dialogs": {
          "230200401": {
            "id": "230200401",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "So? Have you finished moving the materials over?"
          }
        }
      }
    },
    {
      "subId": "2302005",
      "subQuestName": "Return and report the situation to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200501"
        ],
        "dialogs": {
          "230200501": {
            "id": "230200501",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Oh! Thanks, Traveler. Here's your payment.",
            "nextDialogs": [
              "230200502"
            ]
          },
          "230200502": {
            "id": "230200502",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "But this material is really unexpectedly heavy...",
            "nextDialogs": [
              "230200503"
            ]
          },
          "230200503": {
            "id": "230200503",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "I'll start working as soon as possible. This won't take long, so this ship should be ready for a seaworthiness test soon.",
            "nextDialogs": [
              "230200504"
            ]
          },
          "230200504": {
            "id": "230200504",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "...You'll have to have your life jackets on ready when you test the ship.",
            "nextDialogs": [
              "230200505"
            ]
          },
          "230200505": {
            "id": "230200505",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Oh, it will be fine, for sure! Have some faith in me."
          }
        }
      }
    },
    {
      "subId": "2302006",
      "subQuestName": "Additional",
      "sceneId": null,

  "subQuests": [
    {
      "subId": "2302001",
      "subQuestName": "Talk to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200101"
        ],
        "dialogs": {
          "230200101": {
            "id": "230200101",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "...That's why I'd submit that we can't scrimp too much on material in this area.",
            "nextDialogs": [
              "230200102"
            ]
          },
          "230200102": {
            "id": "230200102",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Don't worry, its strength is good enough. I've done the necessary calculations many times.",
            "nextDialogs": [
              "230200103"
            ]
          },
          "230200103": {
            "id": "230200103",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "Argh, I've told you this before. Many problems cannot simply be solved by calculation...",
            "nextDialogs": [
              "230200104"
            ]
          },
          "230200104": {
            "id": "230200104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you guys arguing about?",
            "nextDialogs": [
              "230200105"
            ]
          },
          "230200105": {
            "id": "230200105",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Oh, it's you. We're discussing the design problems of that ship of mine.",
            "nextDialogs": [
              "230200106"
            ]
          },
          "230200106": {
            "id": "230200106",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "I've done plenty of calculations, and I can guarantee that every area has enough strength.",
            "nextDialogs": [
              "230200107"
            ]
          },
          "230200107": {
            "id": "230200107",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "But Qishan stubbornly claims that the calculated strength is not necessarily reliable...",
            "nextDialogs": [
              "230200108"
            ]
          },
          "230200108": {
            "id": "230200108",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "The \"strength\" that you're talking about only exists in theory.",
            "nextDialogs": [
              "230200109"
            ]
          },
          "230200109": {
            "id": "230200109",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "The ship will have to withstand pressure while in the water, and that will be way more than the numbers you have here.",
            "nextDialogs": [
              "230200110"
            ]
          },
          "230200110": {
            "id": "230200110",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "I understand the logic, but my finances are limited, and...",
            "nextDialogs": [
              "230200111"
            ]
          },
          "230200111": {
            "id": "230200111",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "If I buy more expensive materials, I will only be able to finish the keel of this ship at most... *cough*!",
            "nextDialogs": [
              "230200112"
            ]
          },
          "230200112": {
            "id": "230200112",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Anyway! Let's just follow my plan for this ship for now. I've already purchased all the materials.",
            "nextDialogs": [
              "230200113"
            ]
          },
          "230200113": {
            "id": "230200113",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Traveler, if you're willing, could you help me carry some materials? I can't carry them all by myself...",
            "nextDialogs": [
              "230200118",
              "230200116"
            ]
          },
          "230200118": {
            "id": "230200118",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "I'm leaving it to you then, as I have calculations to work with. I'll fetch the rest after I'm done..."
          },
          "230200116": {
            "id": "230200116",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Oh, she does. She's even faster than me when it comes to certain calculations, actually.",
            "nextDialogs": [
              "230200117"
            ]
          },
          "230200117": {
            "id": "230200117",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "I have no idea why she wants to be a helper here, really..."
          }
        }
      }
    },
    {
      "subId": "2302002",
      "subQuestName": "Fetch the materials for building the ship",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230200201"
        ],
        "dialogs": {
          "230200201": {
            "id": "230200201",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "The material strengths required for the hull, as per Rafiq's calculations, are indeed correct based on the theoretical data alone.",
            "nextDialogs": [
              "230200202"
            ]
          },
          "230200202": {
            "id": "230200202",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "But if you really want to go into the water...",
            "nextDialogs": [
              "230200203"
            ]
          },
          "230200203": {
            "id": "230200203",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "Forget it, he's surely not going to listen to me..."
          }
        }
      }
    },
    {
      "subId": "2302003",
      "subQuestName": "Fetch the materials for building the ship",
      "sceneId": null,
      "locations": [],

            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "All that talking has tired me out.",
            "nextDialogs": [
              "721721302"
            ]
          },
          "721721302": {
            "id": "721721302",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "Best of luck to you."
          }
        }
      }
    },

    {
      "subId": "7217202",
      "subQuestName": "Go to Tsurumi Island and look for Ruu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721720201"
        ],
        "dialogs": {
          "721720201": {
            "id": "721720201",
            "speakerId": 20461,
            "speakerName": "Makiri",
            "text": "Isn't Ruu lucky~",
            "nextDialogs": [
              "721720202"
            ]
          },
          "721720202": {
            "id": "721720202",
            "speakerId": 20430,
            "speakerName": "Ipe",
            "text": "...",
            "nextDialogs": [
              "721720203"
            ]
          },
          "721720203": {
            "id": "721720203",
            "speakerId": 20430,
            "speakerName": "Ipe",
            "text": "Don't be silly.",
            "nextDialogs": [
              "721720204"
            ]
          },
          "721720204": {
            "id": "721720204",
            "speakerId": 20461,
            "speakerName": "Makiri",
            "text": "Oh. Sorry.",
            "nextDialogs": [
              "721720205"
            ]
          },
          "721720205": {
            "id": "721720205",
            "speakerId": 20430,
            "speakerName": "Ipe",
            "text": "And the fact that I'm the only one doing work over here makes it worse!",
            "nextDialogs": [
              "721720206"
            ]
          },
          "721720206": {
            "id": "721720206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's Ipe and Makiri. Looks like they're making offerings to the Perch.",
            "nextDialogs": [
              "721720207"
            ]
          },
          "721720207": {
            "id": "721720207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh... Paimon has an idea.",
            "nextDialogs": [
              "721720210"
            ]
          },
          "721720210": {
            "id": "721720210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They said that the Perches are key to the ceremony, and so people need to make offerings there and protect them.",
            "nextDialogs": [
              "721720211"
            ]
          },
          "721720211": {
            "id": "721720211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, the ceremony won't be able to continue if we destroy the Perches, right?",
            "nextDialogs": [
              "721720212"
            ]
          },
          "721720212": {
            "id": "721720212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But they're illusions of the past...",
            "nextDialogs": [
              "721720213"
            ]
          },
          "721720213": {
            "id": "721720213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, even if that's so, don't you think it's worth a shot?",
            "nextDialogs": [
              "721720214"
            ]
          },
          "721720214": {
            "id": "721720214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Since these islanders love their Thunderbird and perches and stuff so much, let's just give wrecking 'em a go!",
            "nextDialogs": [
              "721720215"
            ]
          },
          "721720215": {
            "id": "721720215",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They said that these perches contain the Thunderbird's power, right? Maybe they'll react if we blow them away..."
          }
        }
      }
    },
    {
      "subId": "7217225",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721721401"
        ],
        "dialogs": {
          "721721401": {
            "id": "721721401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ruu's not here...",
            "nextDialogs": [
              "721721402"
            ]
          },
          "721721402": {
            "id": "721721402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe he's deeper inside.",
            "nextDialogs": [
              "721721403"
            ]
          },
          "721721403": {
            "id": "721721403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We need to find him, and quick! If not, the islanders are gonna sacrifice him to the Thunderbird!",
            "nextDialogs": [
              "721721404"
            ]
          },
          "721721404": {
            "id": "721721404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "According to what Kama said...",
            "nextDialogs": [
              "721721405"
            ]
          },
          "721721405": {
            "id": "721721405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, Paimon knows that all the things happening here are illusions that constantly repeat themselves.",
            "nextDialogs": [
              "721721406"
            ]
          },
          "721721406": {
            "id": "721721406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But if that's the case... doesn't that mean that Ruu's been sacrificed to the Thunderbird Archon-only-knows how many times?",
            "nextDialogs": [
              "721721407"
            ]
          },
          "721721407": {
            "id": "721721407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's... That's just too sad! We've got to help him, no matter what!",
            "nextDialogs": [
              "721721408"
            ]
          },
          "721721408": {
            "id": "721721408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're right. Let's do this.",
            "nextDialogs": [
              "721721409"
            ]
          },
          "721721409": {
            "id": "721721409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah!"
          }
        }
      }
    },

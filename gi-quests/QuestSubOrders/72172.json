    {
      "subId": "7217212",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721721201"
        ],
        "dialogs": {
          "721721201": {
            "id": "721721201",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "Indulge my curiosity for a moment... Since you're a descendant of Tsurumi Island's people and your family seems quite interested in handing down their history...",
            "nextDialogs": [
              "721721202"
            ]
          },
          "721721202": {
            "id": "721721202",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "Would you know how to make Maushiro, by any chance, Kama?",
            "nextDialogs": [
              "721721203"
            ]
          },
          "721721203": {
            "id": "721721203",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "It's totally okay if you don't, by the way! It was a long time ago and all...",
            "nextDialogs": [
              "721721204"
            ]
          },
          "721721204": {
            "id": "721721204",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "I do. My grandfather taught me how to make them — and how to use them, too.",
            "nextDialogs": [
              "721721205"
            ]
          },
          "721721205": {
            "id": "721721205",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "What... Uh... Then why did I spend all that Mora to hire people...",
            "nextDialogs": [
              "721721206"
            ]
          },
          "721721206": {
            "id": "721721206",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "*cough* So then, is there anything else you can tell me about the Maushiro?",
            "nextDialogs": [
              "721721207"
            ]
          },
          "721721207": {
            "id": "721721207",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "They make \"bwoooom\" sounds.",
            "nextDialogs": [
              "721721208"
            ]
          },
          "721721208": {
            "id": "721721208",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "I—I think I already knew that. Is there anything else?",
            "nextDialogs": [
              "721721209"
            ]
          },
          "721721209": {
            "id": "721721209",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "They are made of wood, and have no special requirements in that regard. Yumemiru Wood, Otogi Wood, they will all do.",
            "nextDialogs": [
              "721721210"
            ]
          },
          "721721210": {
            "id": "721721210",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "Let me think, was there anything else... Ah. If you give a Maushiro you made personally to someone, that is considered a marriage proposal.",
            "nextDialogs": [
              "721721211"
            ]
          },
          "721721211": {
            "id": "721721211",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "What!?",
            "nextDialogs": [
              "721721212"
            ]
          },
          "721721212": {
            "id": "721721212",
            "speakerId": 20321,
            "speakerName": "Sumida",
            "text": "That's not bad, actually. I'll include that into the story!"
          }
        }
      }
    },
    {
      "subId": "7217213",
      "subQuestName": "Go to the ceremonial site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721721301"
        ],
        "dialogs": {
          "721721301": {

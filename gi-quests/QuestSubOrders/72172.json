  "subQuests": [
    {
      "subId": "7217201",
      "subQuestName": "Talk to Kama",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721720101"
        ],
        "dialogs": {
          "721720101": {
            "id": "721720101",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "What's the matter?",
            "nextDialogs": [
              "721720102"
            ]
          },
          "721720102": {
            "id": "721720102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We ran into some very concerning things on Tsurumi Island...",
            "nextDialogs": [
              "721720103"
            ]
          },
          "721720103": {
            "id": "721720103",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "Your point being?",
            "nextDialogs": [
              "721720105",
              "721720111"
            ]
          },
          "721720105": {
            "id": "721720105",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "That's none of your business.",
            "nextDialogs": [
              "721720106"
            ]
          },
          "721720106": {
            "id": "721720106",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "You've already helped Lady Sumida find the Maushiro, so there is no need for any further association between us.",
            "nextDialogs": [
              "721720107"
            ]
          },
          "721720107": {
            "id": "721720107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yikes, how cold. Actually, Miss Sumida's commission isn't over yet. She wanted us to continue investigating Tsurumi Island.",
            "nextDialogs": [
              "721720108"
            ]
          },
          "721720108": {
            "id": "721720108",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "Alright. I understand.",
            "nextDialogs": [
              "721720109"
            ]
          },
          "721720109": {
            "id": "721720109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? And now he's so willing all of a sudden...",
            "nextDialogs": [
              "721720112"
            ]
          },
          "721720112": {
            "id": "721720112",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "\"Kama\" is my family's... Just consider it my clan's name. Our ancestor was from Tsurumi Island.",
            "nextDialogs": [
              "721720113"
            ]
          },
          "721720113": {
            "id": "721720113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!? Why didn't Miss Sumida tell us any of that?"
          },
          "721720111": {
            "id": "721720111",
            "speakerId": 20322,
            "speakerName": "Kama",
            "text": "Alright. I understand."
          }
        }
      }
    },

{
  "lineCounts": {
    "Alice": 15,
    "Baizhu": 1,
    "Barbeloth": 9,
    "Blathine": 11,
    "Changsheng": 1,
    "Paimon": 9,
    "Player": 7,
    "Qiqi": 17
  },
  "subQuests": [
    {
      "subId": "7469601",
      "subQuestName": "Talk to Qiqi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746960101"
        ],
        "dialogs": {
          "746960101": {
            "id": "746960101",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Is it coming back to you yet, Qiqi?",
            "nextDialogs": [
              "746960102"
            ]
          },
          "746960102": {
            "id": "746960102",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Oh... Uhm... I'm sorry...",
            "nextDialogs": [
              "746960103"
            ]
          },
          "746960103": {
            "id": "746960103",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "There's no need to apologize. We still have a long way before we get to the Palais Mermonia. Let's keep walking for now — I'm sure you'll remember where your home is soon.",
            "nextDialogs": [
              "746960104"
            ]
          },
          "746960104": {
            "id": "746960104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look, it's Qiqi! And she's with a Melusine. That's a combo Paimon wasn't expecting to see!",
            "nextDialogs": [
              "746960105"
            ]
          },
          "746960105": {
            "id": "746960105",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "#Ah! {NICKNAME}, and... Pai... Paimon...",
            "nextDialogs": [
              "746960106"
            ]
          },
          "746960106": {
            "id": "746960106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello.",
            "nextDialogs": [
              "746960107"
            ]
          },
          "746960107": {
            "id": "746960107",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "You know Qiqi? Fantastic news! I ran into her while investigating near Lumidouce Harbor... Judging by her size, I figured she was a human child... She is a child, right?",
            "nextDialogs": [
              "746960108"
            ]
          },
          "746960108": {
            "id": "746960108",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "I am... am...",
            "nextDialogs": [
              "746960109"
            ]
          },
          "746960109": {
            "id": "746960109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Our good friend!",
            "nextDialogs": [
              "746960110"
            ]
          },
          "746960110": {
            "id": "746960110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right, right! We go way back. We're the best of friends!",
            "nextDialogs": [
              "746960111"
            ]
          },
          "746960111": {
            "id": "746960111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe! Quick thinking! If Qiqi had said she was a zombie, it might've scared her half to death!",
            "nextDialogs": [
              "746960112"
            ]
          },
          "746960112": {
            "id": "746960112",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Yes... Best of... friends... That's right.",
            "nextDialogs": [
              "746960113"
            ]
          },
          "746960113": {
            "id": "746960113",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Well, this is a happy coincidence for sure. To be honest, this is the first time I've ever found myself completely at a loss...",
            "nextDialogs": [
              "746960114"
            ]
          },
          "746960114": {
            "id": "746960114",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "I take it you know about her memory issues? She can hardly seem to remember anything besides her own name.",
            "nextDialogs": [
              "746960115"
            ]
          },
          "746960115": {
            "id": "746960115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Qiqi gets like that sometimes.",
            "nextDialogs": [
              "746960116"
            ]
          },
          "746960116": {
            "id": "746960116",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Poor child. I was going to take her back to the Marechaussee Phantom and let her stay there for a while, but I hoped she might get some of her memories back on the road.",
            "nextDialogs": [
              "746960117"
            ]
          },
          "746960117": {
            "id": "746960117",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Since you're such good friends, I take it you know where she lives? It would save a lot of trouble if I could take her straight home.",
            "nextDialogs": [
              "746960118"
            ]
          },
          "746960118": {
            "id": "746960118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We know... But it's, uhm, a very long way from here...",
            "nextDialogs": [
              "746960119"
            ]
          },
          "746960119": {
            "id": "746960119",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Very... long way...? Hmm... I followed a Seelie all the way to Lumidouce Harbor...",
            "nextDialogs": [
              "746960120"
            ]
          },
          "746960120": {
            "id": "746960120",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Huh? You remembered something? What happened before that?",
            "nextDialogs": [
              "746960121"
            ]
          },
          "746960121": {
            "id": "746960121",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Before... that... Dr. Baizhu took me on his rounds at Yi... Uhm, Yi-something-something... I went to gather herbs, and then...",
            "nextDialogs": [
              "746960122"
            ]
          },
          "746960122": {
            "id": "746960122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh! Baizhu took you to Yilong Wharf, right? Detective Paimon thinks she knows what happened!",
            "nextDialogs": [
              "746960123"
            ]
          },
          "746960123": {
            "id": "746960123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Baizhu took Qiqi to visit patients at Yilong Wharf. She got lost while gathering herbs, saw a Seelie, and followed it all the way to Lumidouce Harbor!",
            "nextDialogs": [
              "746960124"
            ]
          },
          "746960124": {
            "id": "746960124",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe, good thing Paimon and {NICKNAME} read Robben versus Chesterton! Simple deductions like these are a piece of cake for Paimon now.",
            "nextDialogs": [
              "746960125"
            ]
          },
          "746960125": {
            "id": "746960125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You do know that book's a work of fiction, right?",
            "nextDialogs": [
              "746960126"
            ]
          },
          "746960126": {
            "id": "746960126",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Aha! Well, that checks out! I'll take Qiqi back to Yilong Wharf right away. Dr. Baizhu is Qiqi's guardian, is he? He must be worried sick!",
            "nextDialogs": [
              "746960129"
            ]
          },
          "746960129": {
            "id": "746960129",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, you're right! Paimon almost forgot about that. Barbeloth — are you there? Can you hear us?",
            "nextDialogs": [
              "746960130"
            ]
          },
          "746960130": {
            "id": "746960130",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "No need to shout. I've been here all along. I simply didn't want to interrupt your conversation. Listening is the default state of any good fortune teller.",
            "nextDialogs": [
              "746960131"
            ]
          },
          "746960131": {
            "id": "746960131",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "This Seelie's so-called guidance could also be considered the guidance of fate. Hehe... Since you're here, Qiqi, why not let me read your fortune?",
            "nextDialogs": [
              "746960132"
            ]
          },
          "746960132": {
            "id": "746960132",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "For... tune...?",
            "nextDialogs": [
              "746960133"
            ]
          },
          "746960133": {
            "id": "746960133",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Oh dear, Barbie, allow me to interject. You're really not suited to talking to children, you know — you're scaring the poor girl.",
            "nextDialogs": [
              "746960134"
            ]
          },
          "746960134": {
            "id": "746960134",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Let me take this one. Now listen closely — this is how you deliver a little surprise gift.",
            "nextDialogs": [
              "746960135"
            ]
          },
          "746960135": {
            "id": "746960135",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Ahem... Little Qiqi, member of the Little Hexenzirkel, I'm the mother of your ally Klee — Auntie Alice, the greatest witch in the world.",
            "nextDialogs": [
              "746960136"
            ]
          },
          "746960136": {
            "id": "746960136",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Nice to meet you, Auntie Alice...",
            "nextDialogs": [
              "746960137"
            ]
          },
          "746960137": {
            "id": "746960137",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Ah, what a sweet, polite little child. Come now, let Auntie's friend, another great witch, throw you a wonderful surprise fortune-telling party!",
            "nextDialogs": [
              "746960138"
            ]
          },
          "746960138": {
            "id": "746960138",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Fortune-telling... party?",
            "nextDialogs": [
              "746960139"
            ]
          },
          "746960139": {
            "id": "746960139",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "That's right! Look at the cards in front of you. Aren't they pretty? Do you like them?",
            "nextDialogs": [
              "746960140"
            ]
          },
          "746960140": {
            "id": "746960140",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "I... like them...",
            "nextDialogs": [
              "746960141"
            ]
          },
          "746960141": {
            "id": "746960141",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "That's wonderful! Now, can you pick one for me?",
            "nextDialogs": [
              "746960142"
            ]
          },
          "746960142": {
            "id": "746960142",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Uhm... Is this one alright?",
            "nextDialogs": [
              "746960143"
            ]
          },
          "746960143": {
            "id": "746960143",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Of course. And because you were so wonderfully well-behaved, that card is yours to keep!",
            "nextDialogs": [
              "746960144"
            ]
          },
          "746960144": {
            "id": "746960144",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Uh... Thank you?",
            "nextDialogs": [
              "746960145"
            ]
          },
          "746960145": {
            "id": "746960145",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Alright, Barbie, break time's over. Come help little Qiqi with her reading.",
            "nextDialogs": [
              "746960146"
            ]
          },
          "746960146": {
            "id": "746960146",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "You don't need to shake me awake... I've been listening the whole time. Ah, upright Hanged Man.",
            "nextDialogs": [
              "746960147"
            ]
          },
          "746960147": {
            "id": "746960147",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "Very few people draw this card.",
            "nextDialogs": [
              "746960148"
            ]
          },
          "746960148": {
            "id": "746960148",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "That means you're very special, Qiqi.",
            "nextDialogs": [
              "746960149"
            ]
          },
          "746960149": {
            "id": "746960149",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "It symbolizes transcendence and waiting, and also detachment from the everyday world.",
            "nextDialogs": [
              "746960150"
            ]
          },
          "746960150": {
            "id": "746960150",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "There are shackles that bind you, but you yourself have no desire to break free from them.",
            "nextDialogs": [
              "746960151"
            ]
          },
          "746960151": {
            "id": "746960151",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Shackles... Do you mean... my orders?",
            "nextDialogs": [
              "746960152"
            ]
          },
          "746960152": {
            "id": "746960152",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "At least on the surface, you wouldn't be wrong to understand things in such a way.",
            "nextDialogs": [
              "746960153"
            ]
          },
          "746960153": {
            "id": "746960153",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "As for your future, all you need to do is wait. Of course, it's not like you lack for time... But... Oh my, how strange, how very strange...",
            "nextDialogs": [
              "746960154"
            ]
          },
          "746960154": {
            "id": "746960154",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Hold up a second! You're saying too much at once. Give the poor child a moment to breathe.",
            "nextDialogs": [
              "746960155"
            ]
          },
          "746960155": {
            "id": "746960155",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Let Qiqi savor her little gift first. You really do need to show a little more patience with children...",
            "nextDialogs": [
              "746960156"
            ]
          },
          "746960156": {
            "id": "746960156",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "What do you think, Qiqi? Do you like your surprise?",
            "nextDialogs": [
              "746960157"
            ]
          },
          "746960157": {
            "id": "746960157",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "This card is pretty... Thank you, Auntie Alice.",
            "nextDialogs": [
              "746960158"
            ]
          },
          "746960158": {
            "id": "746960158",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Aww, good girl — you did such a good job remembering Auntie's name. Auntie would love to chat with you some more, but it's time for you to go home.",
            "nextDialogs": [
              "746960159"
            ]
          },
          "746960159": {
            "id": "746960159",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "If Auntie Barbie has more to say, then next time the Hexenzirkel meets, she can make a prophecy for every little witch who attends! Wouldn't that be lovely?",
            "nextDialogs": [
              "746960160"
            ]
          },
          "746960160": {
            "id": "746960160",
            "speakerId": 16101,
            "speakerName": "Barbeloth",
            "text": "...Could you not add to my workload without asking me first?",
            "nextDialogs": [
              "746960161"
            ]
          },
          "746960161": {
            "id": "746960161",
            "speakerId": 10923,
            "speakerName": "Alice",
            "text": "Then it's settled! See you next time, Qiqi, and all of you witnesses, hehe.",
            "nextDialogs": [
              "746960162"
            ]
          },
          "746960162": {
            "id": "746960162",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "Bye-bye... Auntie Alice... and Auntie Alice's... best of friends.",
            "nextDialogs": [
              "746960163"
            ]
          },
          "746960163": {
            "id": "746960163",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Phew... Is that all over now? Did those two voices just come from this doll? What kind of toy is this? It's so cute, where can I...",
            "nextDialogs": [
              "746960164"
            ]
          },
          "746960164": {
            "id": "746960164",
            "speakerId": 31028,
            "speakerName": "Blathine",
            "text": "Ugh! No, that's not important right now. Qiqi, let's go find that Dr. Baizhu of yours.",
            "nextDialogs": [
              "746960165"
            ]
          },
          "746960165": {
            "id": "746960165",
            "speakerId": 10233,
            "speakerName": "Qiqi",
            "text": "#...Mmhmm, it's time... Qiqi should go home. See you... next time, {NICKNAME}... and Paimon."
          }
        }
      }
    },

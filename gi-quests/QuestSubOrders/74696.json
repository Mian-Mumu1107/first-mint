    {
      "subId": "7469603",
      "subQuestName": "Finish Qiqi's story",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746960301"
        ],
        "dialogs": {
          "746960301": {
            "id": "746960301",
            "speakerId": 10234,
            "speakerName": "Baizhu",
            "text": "I think that's everyone I needed to see, but where's Qiqi? She can't still be gathering herbs, can she?",
            "nextDialogs": [
              "746960302"
            ]
          },
          "746960302": {
            "id": "746960302",
            "speakerId": 1006,
            "speakerName": "Changsheng",
            "text": "Perhaps you should prescribe yourself some medicine to stop you overthinking... There's still plenty of time left until her orders say to be back."
          }
        }
      }
    },
    {
      "subId": "7469604",
      "subQuestName": "Leave the story",

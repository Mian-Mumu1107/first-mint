  },
  "subQuests": [
    {
      "subId": "7308102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730810301"
        ],
        "dialogs": {
          "730810301": {
            "id": "730810301",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "It's Arama and the Golden Nara. You are so tall. But the silver one by your side...",
            "nextDialogs": [
              "730810302"
            ]
          },
          "730810302": {
            "id": "730810302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? What about the silver one?",
            "nextDialogs": [
              "730810303"
            ]
          },
          "730810303": {
            "id": "730810303",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "How should I put it... You must be able to squeeze into the narrowest tree hollows. How convenient!",
            "nextDialogs": [
              "730810304"
            ]
          },
          "730810304": {
            "id": "730810304",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Well, based on Nara customs, we should do introductions first. This is Nara {NICKNAME} and Paimon. This is Arakavi. You guys shake hands.",
            "nextDialogs": [
              "730810305"
            ]
          },
          "730810305": {
            "id": "730810305",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You are a little lost, but you shake hands with Arakavi anyway...\\nYou try not to use too much strength.\\nArakavu's hand feels... interesting to the touch.",
            "nextDialogs": [
              "730810306"
            ]
          },
          "730810306": {
            "id": "730810306",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "How fascinating. I've heard a lot about Nara before, but this is the first time I've ever touched one. It's a very special feeling!",
            "nextDialogs": [
              "730810307"
            ]
          },
          "730810307": {
            "id": "730810307",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "It's been a long time since we last hosted a Nara here. Many seeds have grown into trees, and many stories have become legends. That Nara was a good Nara — or so we've heard.",
            "nextDialogs": [
              "730810308"
            ]
          },
          "730810308": {
            "id": "730810308",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Nara {NICKNAME} is good, too. Strong and brave, like a sapling sprouting out of a rock wall. And they are here to help Arana.",
            "nextDialogs": [
              "730810309"
            ]
          },
          "730810309": {
            "id": "730810309",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "Ah, Arana... It's been a while since we last met. I hope all is well, and that the little Nara at Vimara Village are well, too.",
            "nextDialogs": [
              "730810310"
            ]
          },
          "730810310": {
            "id": "730810310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know the kids of Vimara Village?",
            "nextDialogs": [
              "730810311"
            ]
          },
          "730810311": {
            "id": "730810311",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "Of course I do!",
            "nextDialogs": [
              "730810312"
            ]
          },
          "730810312": {
            "id": "730810312",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "We all do! Arana came back and told us stories about the little Nara. Nara Iotham, Nara Bahram, and Narana are our friends.",
            "nextDialogs": [
              "730810313"
            ]
          },
          "730810313": {
            "id": "730810313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's not sure that counts as \"knowing someone\"...",
            "nextDialogs": [
              "730810314"
            ]
          },
          "730810314": {
            "id": "730810314",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "What counts, then? Do we need to \"shake hands\" after the \"introduction\" like Nara do?",
            "nextDialogs": [
              "730810315"
            ]
          },
          "730810315": {
            "id": "730810315",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "I know what Paimon means. Nara eat and look for \"treasures\" together. Then they know each other, right?",
            "nextDialogs": [
              "730810321",
              "730810319"
            ]
          },
          "730810321": {
            "id": "730810321",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "As long as we know each other's stories, we know each other. This is because the Aranara's world is a place for songs and dreams.",
            "nextDialogs": [
              "730810322"
            ]
          },
          "730810322": {
            "id": "730810322",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Arakavi is right. As long as we hear about Nara {NICKNAME} through songs and see what Nara {NICKNAME} looks like through dreams, it'll count as knowing you.",
            "nextDialogs": [
              "730810323"
            ]
          },
          "730810323": {
            "id": "730810323",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks that we can leave this aside for now... After all, we're already friends!",
            "nextDialogs": [
              "730810324"
            ]
          },
          "730810324": {
            "id": "730810324",
            "speakerId": 20825,
            "speakerName": "Arama and Arakavi",
            "text": "Good friends!"
          },
          "730810319": {
            "id": "730810319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes! And we're not just \"people who know each other,\" but the best of companions!",
            "nextDialogs": [
              "730810320"
            ]
          },
          "730810320": {
            "id": "730810320",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Good for you, Nara {NICKNAME}, Paimon!"
          }
        }
      }
    },
    {

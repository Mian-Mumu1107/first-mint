    {
      "subId": "1504506",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150450601"
        ],
        "dialogs": {
          "150450601": {
            "id": "150450601",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Wow, that looks amazing!",
            "nextDialogs": [
              "150450602"
            ]
          },
          "150450602": {
            "id": "150450602",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Guys, over here! We're gonna take a picture together!",
            "nextDialogs": [
              "150450603"
            ]
          },
          "150450603": {
            "id": "150450603",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Not bad, not bad! You're all looking full of energy this morning — not a trace of bed head or dark circles in sight!",
            "nextDialogs": [
              "150450604"
            ]
          },
          "150450604": {
            "id": "150450604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, you even look out for stuff like that?",
            "nextDialogs": [
              "150450605"
            ]
          },
          "150450605": {
            "id": "150450605",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Well, what kind of guide would I be if I didn't pay attention to the details?",
            "nextDialogs": [
              "150450606"
            ]
          },
          "150450606": {
            "id": "150450606",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Yeah, and what kind of bard would I be if I didn't appreciate a good drink?",
            "nextDialogs": [
              "150450607"
            ]
          },
          "150450607": {
            "id": "150450607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...What's that got to do with anything!?",
            "nextDialogs": [
              "150450608"
            ]
          },
          "150450608": {
            "id": "150450608",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Hahaha! Somehow, though, I know exactly what he means!",
            "nextDialogs": [
              "150450609"
            ]
          },
          "150450609": {
            "id": "150450609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Friends that talk nonsense together, stay together.",
            "nextDialogs": [
              "150450610"
            ]
          },
          "150450610": {
            "id": "150450610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you really think that? Or are you just playing along to keep Tone-Deaf Bard happy too?",
            "nextDialogs": [
              "150450611"
            ]
          },
          "150450611": {
            "id": "150450611",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "I see no harm in a bit of nonsense.",
            "nextDialogs": [
              "150450612"
            ]
          },
          "150450612": {
            "id": "150450612",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Here, put on this Asha headband. It's a souvenir from the rest of us!",
            "nextDialogs": [
              "150450613"
            ]
          },
          "150450613": {
            "id": "150450613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, thanks!",
            "nextDialogs": [
              "150450614"
            ]
          },
          "150450614": {
            "id": "150450614",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "It really suits you!",
            "nextDialogs": [
              "150450615"
            ]
          },
          "150450615": {
            "id": "150450615",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Alrighty then...",
            "nextDialogs": [
              "150450616"
            ]
          },
          "150450616": {
            "id": "150450616",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Three, two, one...",
            "nextDialogs": [
              "150450617"
            ]
          },
          "150450617": {
            "id": "150450617",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "150450618"
            ]
          },
          "150450618": {
            "id": "150450618",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Paimon?",
            "nextDialogs": [
              "150450619"
            ]
          },
          "150450619": {
            "id": "150450619",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Sorry, all that nonsense has got Paimon's head muddled. Her mind's gone completely blank...",
            "nextDialogs": [
              "150450620"
            ]
          },
          "150450620": {
            "id": "150450620",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "Don't want it all to end, huh?",
            "nextDialogs": [
              "150450621"
            ]
          },
          "150450621": {
            "id": "150450621",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "Are you worried, once you say those words, the vacation will officially be over?",
            "nextDialogs": [
              "150450622"
            ]
          },
          "150450622": {
            "id": "150450622",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How the... Paimon thought Peacemakers couldn't read people's minds!",
            "nextDialogs": [
              "150450623"
            ]
          },
          "150450623": {
            "id": "150450623",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Haha, Paimon...",
            "nextDialogs": [
              "150450624"
            ]
          },
          "150450624": {
            "id": "150450624",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Don't worry, Paimon.",
            "nextDialogs": [
              "150450625"
            ]
          },
          "150450625": {
            "id": "150450625",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Summer's sure to come again, just like you said when you made that wish to the Pyro Archon.",
            "nextDialogs": [
              "150450626"
            ]
          },
          "150450626": {
            "id": "150450626",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Even though we'll all be going our separate ways, as long as we cherish each other's friendship, I just know that our paths will cross again.",
            "nextDialogs": [
              "150450627"
            ]
          },
          "150450627": {
            "id": "150450627",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Bennett's becoming quite the talker, huh, Professor Venti?",
            "nextDialogs": [
              "150450628"
            ]
          },
          "150450628": {
            "id": "150450628",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Ah, well, I wouldn't dare take credit for something like that...",
            "nextDialogs": [
              "150450629"
            ]
          },
          "150450629": {
            "id": "150450629",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Your tone would suggest otherwise... C'mon, Paimon was just starting to feel inspired...",
            "nextDialogs": [
              "150450630"
            ]
          },
          "150450630": {
            "id": "150450630",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Why don't we just give it another try?",
            "nextDialogs": [
              "150450631"
            ]
          },
          "150450631": {
            "id": "150450631",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Yeah, let's do it all together this time!",
            "nextDialogs": [
              "150450632"
            ]
          },
          "150450632": {
            "id": "150450632",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "Huh. What should we shout?",
            "nextDialogs": [
              "150450633"
            ]
          },
          "150450633": {
            "id": "150450633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lucky star?",
            "nextDialogs": [
              "150450634"
            ]
          },
          "150450634": {
            "id": "150450634",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sounds good!",
            "nextDialogs": [
              "150450635"
            ]
          },
          "150450635": {
            "id": "150450635",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Three, two, one...",
            "nextDialogs": [
              "150450636"
            ]
          },
          "150450636": {
            "id": "150450636",
            "speakerId": 1005,
            "speakerName": "Everyone",
            "text": "Lucky star!",
            "nextDialogs": [
              "150450641"
            ]
          },
          "150450641": {
            "id": "150450641",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "You have a wonderful time with your friends...",
            "nextDialogs": [
              "150450642"
            ]
          },
          "150450642": {
            "id": "150450642",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "...So, what are your plans for the future, Bennett?",
            "nextDialogs": [
              "150450643"
            ]
          },
          "150450643": {
            "id": "150450643",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "If you're having trouble deciding, you can always park it in the People of the Springs for a bit, or however long you want, really.",
            "nextDialogs": [
              "150450644"
            ]
          },
          "150450644": {
            "id": "150450644",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Thanks for the kind offer, Mualani.",
            "nextDialogs": [
              "150450645"
            ]
          },
          "150450645": {
            "id": "150450645",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "I actually went to see the Pyro Archon to tell her how grateful I am for everything she's done for me.",
            "nextDialogs": [
              "150450646"
            ]
          },
          "150450646": {
            "id": "150450646",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "She told me that the Domain we entered was an Abyssal simulation of the Mare Jivari. It was extremely unstable, and now it's completely gone.",
            "nextDialogs": [
              "150450647"
            ]
          },
          "150450647": {
            "id": "150450647",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Later, when we got onto talking about my future, she said I was more than welcome to stay here in Natlan... but also that she would respect my decision, whatever it turned out to be.",
            "nextDialogs": [
              "150450648"
            ]
          },
          "150450648": {
            "id": "150450648",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "And after thinking it over, long and hard... I've decided to return to Mondstadt.",
            "nextDialogs": [
              "150450649"
            ]
          },
          "150450649": {
            "id": "150450649",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "You miss your dads, don't you?",
            "nextDialogs": [
              "150450650"
            ]
          },
          "150450650": {
            "id": "150450650",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "That's definitely part of it. I promised to tell them everything that happened on this adventure, and I can't go back on my word.",
            "nextDialogs": [
              "150450651"
            ]
          },
          "150450651": {
            "id": "150450651",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "But also...",
            "nextDialogs": [
              "150450652"
            ]
          },
          "150450652": {
            "id": "150450652",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "When I said goodbye to my mom and dad, I promised them I'd become the most legendary adventurer in all of Teyvat someday.",
            "nextDialogs": [
              "150450653"
            ]
          },
          "150450653": {
            "id": "150450653",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "And no adventurer should stay in one place for too long.",
            "nextDialogs": [
              "150450654"
            ]
          },
          "150450654": {
            "id": "150450654",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Bennett...",
            "nextDialogs": [
              "150450655"
            ]
          },
          "150450655": {
            "id": "150450655",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What if your luck starts going downhill again the moment you leave Natlan?",
            "nextDialogs": [
              "150450656"
            ]
          },
          "150450656": {
            "id": "150450656",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Haha, it's fine.",
            "nextDialogs": [
              "150450657"
            ]
          },
          "150450657": {
            "id": "150450657",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "The warmth and kindness I've experienced on this adventure is enough to get me through all the challenges that lie ahead.",
            "nextDialogs": [
              "150450658"
            ]
          },
          "150450658": {
            "id": "150450658",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "As I attempt to shape my own fate, I want to take that same kindness and pass it forward. That's something I've always believed in.",
            "nextDialogs": [
              "150450659"
            ]
          },
          "150450659": {
            "id": "150450659",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "Hear, hear! To our leader!",
            "nextDialogs": [
              "150450660"
            ]
          },
          "150450660": {
            "id": "150450660",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "To our leader, Bennett!",
            "nextDialogs": [
              "150450661"
            ]
          },
          "150450661": {
            "id": "150450661",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Cheers!",
            "nextDialogs": [
              "150450662"
            ]
          },
          "150450662": {
            "id": "150450662",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... This is gonna be another all-nighter, isn't it...",
            "nextDialogs": [
              "150450663"
            ]
          },
          "150450663": {
            "id": "150450663",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Hehe, the fun never stops! Who's up to perform next?",
            "nextDialogs": [
              "150450664"
            ]
          },
          "150450664": {
            "id": "150450664",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "Bennett's almost fallen asleep several times now...",
            "nextDialogs": [
              "150450665"
            ]
          },
          "150450665": {
            "id": "150450665",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "No, no... I can still... keep going...",
            "nextDialogs": [
              "150450666"
            ]
          },
          "150450666": {
            "id": "150450666",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "Go get some rest now, guys. And seeing as you've still got the energy, I'll leave the clean-up to you, Mualani...",
            "nextDialogs": [
              "150450667"
            ]
          },
          "150450667": {
            "id": "150450667",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Huh? Why me...?",
            "nextDialogs": [
              "150450668"
            ]
          },
          "150450668": {
            "id": "150450668",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#{NICKNAME}, perhaps you could join me for a walk?",
            "nextDialogs": [
              "150450669"
            ]
          },
          "150450669": {
            "id": "150450669",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I know a great spot."
          }
        }
      }
    },
    {
      "subId": "1504507",
      "subQuestName": "Go to the place Venti mentioned",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150450701"
        ],
        "dialogs": {
          "150450701": {
            "id": "150450701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You might be tone-deaf, but you sure know how to sniff out a good view...",
            "nextDialogs": [
              "150450702"
            ]
          },
          "150450702": {
            "id": "150450702",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Haha, glad you like it. Some stories aren't meant for the birds — only for the stars high in the sky.",
            "nextDialogs": [
              "150450703"
            ]
          },
          "150450703": {
            "id": "150450703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Time for a bedtime story?",
            "nextDialogs": [
              "150450704"
            ]
          },
          "150450704": {
            "id": "150450704",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Haha... More like a story that begins with \"Time\" itself.",
            "nextDialogs": [
              "150450705"
            ]
          },
          "150450705": {
            "id": "150450705",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Long, long ago, \"Ti{RUBY#[D]Istaroth}me\" began to write the story of this world.",
            "nextDialogs": [
              "150450706"
            ]
          },
          "150450706": {
            "id": "150450706",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "To her, all living beings were equal, both in their value and insignificance.",
            "nextDialogs": [
              "150450707"
            ]
          },
          "150450707": {
            "id": "150450707",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Like an ancient scroll, she engraved upon her memory all people, all events, all encounters, and all farewells.",
            "nextDialogs": [
              "150450708"
            ]
          },
          "150450708": {
            "id": "150450708",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Back then, as an Anemo spirit, I had a chance encounter with \"Time\" at the Thousand Winds Temple.",
            "nextDialogs": [
              "150450709"
            ]
          },
          "150450709": {
            "id": "150450709",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Hearing my wishes, she entrusted me with fragments of her power and authority...",
            "nextDialogs": [
              "150450712"
            ]
          },
          "150450712": {
            "id": "150450712",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Sounds like you've heard the story of \"Time and the Wind\" before.",
            "nextDialogs": [
              "150450713"
            ]
          },
          "150450713": {
            "id": "150450713",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Charming, isn't it?",
            "nextDialogs": [
              "150450714"
            ]
          },
          "150450714": {
            "id": "150450714",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Through the memories engraved in rituals, poems, ruins, and ancient texts, the same beings she considered so insignificant have met her... time and time again.",
            "nextDialogs": [
              "150450715"
            ]
          },
          "150450715": {
            "id": "150450715",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is the story you wanted to share?",
            "nextDialogs": [
              "150450716"
            ]
          },
          "150450716": {
            "id": "150450716",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Mmm... More like the prologue.",
            "nextDialogs": [
              "150450717"
            ]
          },
          "150450717": {
            "id": "150450717",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "The corruption of the Mare Jivari is tied to time itself. To put it another way, it is a calamity present in every moment that will ever be.",
            "nextDialogs": [
              "150450718"
            ]
          },
          "150450718": {
            "id": "150450718",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Unlike \"Time\" herself, I have always cherished many wishes in my heart.",
            "nextDialogs": [
              "150450719"
            ]
          },
          "150450719": {
            "id": "150450719",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Five hundred years ago, to prevent the corruption of the Mare Jivari from spreading beyond Tenochtzitoc...",
            "nextDialogs": [
              "150450720"
            ]
          },
          "150450720": {
            "id": "150450720",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "...I blew it off the timeline, turning it into the \"Windless Land.\"",
            "nextDialogs": [
              "150450721"
            ]
          },
          "150450721": {
            "id": "150450721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that's the truth behind the Mare Jivari's disappearance?",
            "nextDialogs": [
              "150450722"
            ]
          },
          "150450722": {
            "id": "150450722",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Oops, seems like I may have confused you...",
            "nextDialogs": [
              "150450723"
            ]
          },
          "150450723": {
            "id": "150450723",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "If you're asking about how the Mare Jivari disappeared from Tenochtzitoc two or three decades ago, there may be someone else better suited to tell that story.",
            "nextDialogs": [
              "150450724"
            ]
          },
          "150450724": {
            "id": "150450724",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "The Mare Jivari has been the bearer of too many stories that weren't meant to be its own... I merely played a part in one of its chapters.",
            "nextDialogs": [
              "150450725"
            ]
          },
          "150450725": {
            "id": "150450725",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "And the choice I made five hundred years ago came with a price.",
            "nextDialogs": [
              "150450726"
            ]
          },
          "150450726": {
            "id": "150450726",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Some souls were unable to return to Mondstadt as a result... while others stayed to settle in this land, merging with the Monetoo to become the Asha we see today.",
            "nextDialogs": [
              "150450727"
            ]
          },
          "150450727": {
            "id": "150450727",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So the reason you're here in Tenochtzitoc is because...",
            "nextDialogs": [
              "150450728"
            ]
          },
          "150450728": {
            "id": "150450728",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Correct. I'm here to collaborate with the current Pyro Archon, Mavuika.",
            "nextDialogs": [
              "150450729"
            ]
          },
          "150450729": {
            "id": "150450729",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You mean when we lit up that candle...?",
            "nextDialogs": [
              "150450730"
            ]
          },
          "150450730": {
            "id": "150450730",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Correct again. The flame was our signal.",
            "nextDialogs": [
              "150450731"
            ]
          },
          "150450731": {
            "id": "150450731",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Only by having Mavuika open a rift between that space and the true Mare Jivari could I sneak in and bring back all the souls who wished to return.",
            "nextDialogs": [
              "150450732"
            ]
          },
          "150450732": {
            "id": "150450732",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "As for my little trick of bringing back memories as well... Heh, it's not the first time I've pulled that off.",
            "nextDialogs": [
              "150450733"
            ]
          },
          "150450733": {
            "id": "150450733",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Mavuika also mentioned that you were planning to introduce us... Looks like I beat you to it, huh?",
            "nextDialogs": [
              "150450734"
            ]
          },
          "150450734": {
            "id": "150450734",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I was glad to discover that she shares my love for fine wine and freedom. We got along great."
          }
        }
      }
    },
    {
      "subId": "1504503",

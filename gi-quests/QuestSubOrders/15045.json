    {
      "subId": "1504580",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150458001"
        ],
        "dialogs": {
          "150458001": {
            "id": "150458001",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "If we spray the top layer with orange, I bet it'd look great!",
            "nextDialogs": [
              "150458002"
            ]
          },
          "150458002": {
            "id": "150458002",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "The colors of the Flower-Feather Clan should make a good fit...",
            "nextDialogs": [
              "150458003"
            ]
          },
          "150458003": {
            "id": "150458003",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "A blue hue would be a lucky color for this little cabin!",
            "nextDialogs": [
              "150458004"
            ]
          },
          "150458004": {
            "id": "150458004",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "What do you think about using light green over here?",
            "nextDialogs": [
              "150458005"
            ]
          },
          "150458005": {
            "id": "150458005",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon wants it to be bright yellow!",
            "nextDialogs": [
              "150458006"
            ]
          },
          "150458006": {
            "id": "150458006",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Sweet!",
            "nextDialogs": [
              "150458007"
            ]
          },
          "150458007": {
            "id": "150458007",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "Fits as well as I thought it would.",
            "nextDialogs": [
              "150458008"
            ]
          },
          "150458008": {
            "id": "150458008",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Our lucky little cabin!",
            "nextDialogs": [
              "150458009"
            ]
          },
          "150458009": {
            "id": "150458009",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "What a nice, breezy color.",
            "nextDialogs": [
              "150458010"
            ]
          },
          "150458010": {
            "id": "150458010",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon expected nothing less from you!"
          }
        }
      }
    },

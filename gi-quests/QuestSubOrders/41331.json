    {
      "subId": "4133110",
      "subQuestName": "Talk to Granny Ruoxin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413311001"
        ],
        "dialogs": {
          "413311001": {
            "id": "413311001",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "Ah, you're back. Sorry for making you do so much work on a festive day like this.",
            "nextDialogs": [
              "413311002"
            ]
          },
          "413311002": {
            "id": "413311002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm glad I could help.",
            "nextDialogs": [
              "413311003"
            ]
          },
          "413311003": {
            "id": "413311003",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "Thank you, you're too kind. I've also been doing my part and managed to make quite a few Xiao Lanterns for the people of Qingce Village.",
            "nextDialogs": [
              "413311004"
            ]
          },
          "413311004": {
            "id": "413311004",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "If you'd like, you can find me near the gate later this evening. We'll release the Xiao Lanterns and celebrate the festival together.",
            "nextDialogs": [
              "413311005"
            ]
          },
          "413311005": {
            "id": "413311005",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "But who knows where the children have run off to... There's no way I could go and find them with these old legs...",
            "nextDialogs": [
              "413311006"
            ]
          },
          "413311006": {
            "id": "413311006",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "Could I trouble you to round them up for me? They've always loved releasing the Xiao Lanterns.",
            "nextDialogs": [
              "413311007"
            ]
          },
          "413311007": {
            "id": "413311007",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "And be sure to tell anyone else you find along the way to head back to the village... The more the merrier, you know."
          }
        }
      }
    },
    {
      "subId": "4133111",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413312001"
        ],
        "dialogs": {
          "413312001": {
            "id": "413312001",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "Ugh, I still can't catch my shadow.",
            "nextDialogs": [
              "413312002"
            ]
          },
          "413312002": {
            "id": "413312002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be releasing Xiao Lanterns in the village soon...",
            "nextDialogs": [
              "413312003"
            ]
          },
          "413312003": {
            "id": "413312003",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "We get to release the Xiao Lanterns tonight? Awesome! Lemme go tell my big brother!",
            "nextDialogs": [
              "413312004"
            ]
          },
          "413312004": {
            "id": "413312004",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "I heard grandpa say that we get to make a wish when we release the lanterns. Is that true?",
            "nextDialogs": [
              "413312005"
            ]
          },
          "413312005": {
            "id": "413312005",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "I have a big wish that I've been thinking about for a long time now...",
            "nextDialogs": [
              "413312006"
            ]
          },
          "413312006": {
            "id": "413312006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh really? What's your wish?",
            "nextDialogs": [
              "413312007"
            ]
          },
          "413312007": {
            "id": "413312007",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "It's that I... Ah wait, I shouldn't tell you... Grandpa says that if we tell others our wishes, they'll never come true.",
            "nextDialogs": [
              "413312008"
            ]
          },
          "413312008": {
            "id": "413312008",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "Just wait till I tell my big brother, I'm sure he'll have a wish too!",
            "nextDialogs": [
              "413312009"
            ]
          },
          "413312009": {
            "id": "413312009",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "Oh wait, it seems we have to write our wish on a lantern... So I guess just thinking about it won't be enough."
          }
        }
      }
    },
    {
      "subId": "4133112",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413312101"
        ],
        "dialogs": {
          "413312101": {
            "id": "413312101",
            "speakerId": 1007,
            "speakerName": "Little Luo",
            "text": "I wonder if Mr. Adeptus will come to Lantern Rite...",
            "nextDialogs": [
              "413312102"
            ]
          },
          "413312102": {
            "id": "413312102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be releasing Xiao Lanterns in the village soon...",
            "nextDialogs": [
              "413312103"
            ]
          },
          "413312103": {
            "id": "413312103",
            "speakerId": 1007,
            "speakerName": "Little Luo",
            "text": "Oh, we'll be releasing the lanterns back at the village? Thanks for letting me know.",
            "nextDialogs": [
              "413312104"
            ]
          },
          "413312104": {
            "id": "413312104",
            "speakerId": 1007,
            "speakerName": "Little Luo",
            "text": "If we release enough Xiao Lanterns, maybe Mr. Adeptus will come..."
          }
        }
      }
    },
    {
      "subId": "4133113",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413312201"
        ],
        "dialogs": {
          "413312201": {
            "id": "413312201",
            "speakerId": 1008,
            "speakerName": "Chang the Ninth",
            "text": "Ah, hello. Do you need anything?",
            "nextDialogs": [
              "413312202"
            ]
          },
          "413312202": {
            "id": "413312202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be releasing Xiao Lanterns in the village soon...",
            "nextDialogs": [
              "413312203"
            ]
          },
          "413312203": {
            "id": "413312203",
            "speakerId": 1008,
            "speakerName": "Chang the Ninth",
            "text": "Granny Ruoxin will be releasing the lanterns? *sigh* She'll probably start to worry if I don't show up...",
            "nextDialogs": [
              "413312204"
            ]
          },
          "413312204": {
            "id": "413312204",
            "speakerId": 1008,
            "speakerName": "Chang the Ninth",
            "text": "Alright, thanks for letting me know. I'll make my way over there shortly. At a festival like this one... the more, the merrier."
          }
        }
      }
    },
    {
      "subId": "4133114",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413312301"
        ],
        "dialogs": {
          "413312301": {
            "id": "413312301",
            "speakerId": 1009,
            "speakerName": "Jiangcheng",
            "text": "Wife... Wife?",
            "nextDialogs": [
              "413312302"
            ]
          },
          "413312302": {
            "id": "413312302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be releasing Xiao Lanterns in the village soon...",
            "nextDialogs": [
              "413312303"
            ]
          },
          "413312303": {

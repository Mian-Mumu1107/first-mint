    {
      "subId": "7515004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751500401"
        ],
        "dialogs": {
          "751500401": {
            "id": "751500401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How do we enter the Heart of the Sacred Mountain?",
            "nextDialogs": [
              "751500402"
            ]
          },
          "751500402": {
            "id": "751500402",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "The entrance to the Heart is close by. When recreating Tollan's city center, Lord Xiuhcoatl excavated downward in order to create a stable experimental environment...",
            "nextDialogs": [
              "751500403"
            ]
          },
          "751500403": {
            "id": "751500403",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "And there, he built the ultimate weapon for use against the Abyss.",
            "nextDialogs": [
              "751500404"
            ]
          },
          "751500404": {
            "id": "751500404",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "However, the seal has caused this device to suffer from the deepest Abyss corrosion. Thus was the city taken over...",
            "nextDialogs": [
              "751500405"
            ]
          },
          "751500405": {
            "id": "751500405",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "The entrance to the Sacred Mountain's heart lies beneath the fissures in the Sacred City... That is also where our shadowy foe's corruption runs the deepest."
          }
        }
      }
    },
    {
      "subId": "7515005",

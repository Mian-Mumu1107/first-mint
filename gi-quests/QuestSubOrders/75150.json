        "dialogs": {
          "751501101": {
            "id": "751501101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where can we get this permit...",
            "nextDialogs": [
              "751501102"
            ]
          },
          "751501102": {
            "id": "751501102",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "According to the agreement and the edict issued by Lord Xiuhcoatl, entry to... The Heart of the Sacred Mountain, also known as \"Huitzilopochtli\"... the descendants of...",
            "nextDialogs": [
              "751501103"
            ]
          },
          "751501103": {
            "id": "751501103",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Proceed unto the Chamber of Deliberation to submit an application, and then wait for the permit to be issued.",
            "nextDialogs": [
              "751501104"
            ]
          },
          "751501104": {
            "id": "751501104",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "If you wish to go there, I shall mark its location for you."
          }
        }
      }
    },
    {
      "subId": "7515014",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751501401"
        ],
        "dialogs": {
          "751501401": {
            "id": "751501401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's fine. There isn't anything I'd like to read right now.",
            "nextDialogs": [
              "751501402"
            ]

  "subQuests": [
    {
      "subId": "7515002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751500201"
        ],
        "dialogs": {
          "751500201": {
            "id": "751500201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please mark the next site Abyssal corrosion site...",
            "nextDialogs": [
              "751500202"
            ]
          },
          "751500202": {
            "id": "751500202",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Affirmative. It has been marked... Please clear the Abyss-corrupted zone as soon as possible to retrieve the data stored there.",
            "nextDialogs": [
              "751500203"
            ]
          },
          "751500203": {
            "id": "751500203",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "From there, the database may be restored, preserved, and maintained, such that the required content may be accessed."
          }
        }
      }
    },
    {
      "subId": "7515010",
      "subQuestName": "Explore up ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751501501"
        ],
        "dialogs": {
          "751501501": {
            "id": "751501501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah! A Secret Source Servant... Huh. Is it just Paimon, or is this one bigger than the others?",
            "nextDialogs": [
              "751501502"
            ]
          },
          "751501502": {
            "id": "751501502",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751501503"
            ]
          },
          "751501503": {
            "id": "751501503",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "?",
            "nextDialogs": [
              "751501504"
            ]
          },
          "751501504": {
            "id": "751501504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, fancy meeting you again so soon!",
            "nextDialogs": [
              "751501505"
            ]
          },
          "751501505": {
            "id": "751501505",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "...Apologies, but there are no entries regarding you logged in my database.",
            "nextDialogs": [
              "751501506"
            ]
          },
          "751501506": {
            "id": "751501506",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Humans this far down... This has not happened in at least 500 years.",
            "nextDialogs": [
              "751501507"
            ]
          },
          "751501507": {
            "id": "751501507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, you're not Amaru... or Ehecatl, are you?",
            "nextDialogs": [
              "751501508"
            ]
          },
          "751501508": {
            "id": "751501508",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "...There were indeed individuals referred to as such, but I am neither of them.",
            "nextDialogs": [
              "751501509"
            ]
          },
          "751501509": {
            "id": "751501509",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "I believe there must be some misunderstanding.",
            "nextDialogs": [
              "751501510"
            ]
          },
          "751501510": {
            "id": "751501510",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "I am a prototype created to assist Lord Xiuhcoatl with information recording, so I have no name.",
            "nextDialogs": [
              "751501511"
            ]
          },
          "751501511": {
            "id": "751501511",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Roar...",
            "nextDialogs": [
              "751501512"
            ]
          },
          "751501512": {
            "id": "751501512",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Wait... No... Not that I have no name, I...",
            "nextDialogs": [
              "751501513"
            ]
          },
          "751501513": {
            "id": "751501513",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "I am the only intelligent Secret Source Servant without a master. Even after Lord Xiuhcoatl fell, I was still in charge of the most basic...",
            "nextDialogs": [
              "751501514"
            ]
          },
          "751501514": {
            "id": "751501514",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "The most basic city maintenance and information recording functions.",
            "nextDialogs": [
              "751501515"
            ]
          },
          "751501515": {
            "id": "751501515",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "However, some records have been lost due to the invasion of our shadowy foe, so I do not have data regarding my name.",
            "nextDialogs": [
              "751501516"
            ]
          },
          "751501516": {
            "id": "751501516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, seems like we've got the wrong guy... Err, dragon-robot?",
            "nextDialogs": [
              "751501517"
            ]
          },
          "751501517": {
            "id": "751501517",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "It is fine.",
            "nextDialogs": [
              "751501518"
            ]
          },
          "751501518": {
            "id": "751501518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm. This robot is huge, but it doesn't seem too bright.",
            "nextDialogs": [
              "751501519"
            ]
          },
          "751501519": {
            "id": "751501519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#This probably isn't that guy who uses machines to talk to us, {NICKNAME}...",
            "nextDialogs": [
              "751501520"
            ]
          },
          "751501520": {
            "id": "751501520",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But it did say that it is in charge of record-keeping and stuff, right?",
            "nextDialogs": [
              "751501521"
            ]
          },
          "751501521": {
            "id": "751501521",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why don't we ask it what it knows, then? Or... You know, about how we can reach the Heart of the Sacred Mountain!",
            "nextDialogs": [
              "751501524"
            ]
          },
          "751501524": {
            "id": "751501524",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          }
        }
      }
    },
    {
      "subId": "7515003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751501301"
        ],
        "dialogs": {
          "751501301": {
            "id": "751501301",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Do you have any queries?",
            "nextDialogs": [
              "751501302"
            ]
          },
          "751501302": {
            "id": "751501302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How do we enter the Heart of the Sacred Mountain?",
            "nextDialogs": [
              "751501303"
            ]
          },
          "751501303": {
            "id": "751501303",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "The entrance to the Heart of the Sacred Mountain is at the newly-excavated entrance... descend into the deepest fissure of the volcano, where it is defended by a Secret Source Dragon Idol.",
            "nextDialogs": [
              "751501304"
            ]
          },
          "751501304": {
            "id": "751501304",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Moreover, any who wish to gain access to the Heart must also obtain a \"permit\"...",
            "nextDialogs": [
              "751501305"
            ]
          },
          "751501305": {
            "id": "751501305",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Only then can you gain the acknowledgement of the Secret Source Dragon Idol that stands guard... Heart of the Sacred Mountain, also known as Huitzilopochtli...",
            "nextDialogs": [
              "751501306"
            ]
          },
          "751501306": {
            "id": "751501306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where can we get this permit...",
            "nextDialogs": [
              "751501307"
            ]
          },
          "751501307": {
            "id": "751501307",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "According to the agreement and the edict issued by Lord Xiuhcoatl, entry to... The Heart of the Sacred Mountain, also known as \"Huitzilopochtli\"... the descendants of...",
            "nextDialogs": [
              "751501308"
            ]
          },
          "751501308": {
            "id": "751501308",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Proceed unto the Chamber of Deliberation to submit an application, and then wait for the permit to be issued.",
            "nextDialogs": [
              "751501309"
            ]
          },
          "751501309": {
            "id": "751501309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What about the energy source required by Secret Source Dragon Idols?",
            "nextDialogs": [
              "751501310"
            ]
          },
          "751501310": {
            "id": "751501310",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Now, searching... No corresponding data entry categories... Or perhaps the relevant data, like so much else, has become lost due to the Abyssal corruption of the city...",
            "nextDialogs": [
              "751501311"
            ]
          },
          "751501311": {
            "id": "751501311",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "If you can eliminate the Abyss's influence and retrieve the data, perhaps you might find the entries you seek.",
            "nextDialogs": [
              "751501312"
            ]
          },
          "751501312": {
            "id": "751501312",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "I have marked out a potential data storage location for you. Please eliminate the Abyssal corruption present there to restore the area.",
            "nextDialogs": [
              "751501313"
            ]
          },
          "751501313": {
            "id": "751501313",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Do you have any queries?",
            "nextDialogs": [
              "751501314"
            ]
          },
          "751501314": {
            "id": "751501314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have no more questions...",
            "nextDialogs": [
              "751501315"
            ]
          },
          "751501315": {
            "id": "751501315",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Understood."
          }
        }
      }
    },
    {
      "subId": "7515004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751500901"
        ],
        "dialogs": {
          "751500901": {
            "id": "751500901",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Greetings. New data recovery category detected.",
            "nextDialogs": [
              "751500902"
            ]
          },
          "751500902": {
            "id": "751500902",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "...Entries concerning Source Mechanism energy cores have been updated.",
            "nextDialogs": [
              "751500903"
            ]
          },
          "751500903": {
            "id": "751500903",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Phlogiston is the main form of energy that powers Source Mechanisms, albeit in a condensed form that closely resembles light.",
            "nextDialogs": [
              "751500904"
            ]
          },
          "751500904": {
            "id": "751500904",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Stable amounts of Phlogiston Units may be generated via the controlled reaction known as [DATA LOST] allowing for more precise control over energy release.",
            "nextDialogs": [
              "751500905"
            ]
          },
          "751500905": {
            "id": "751500905",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "The energy that a Source Mechanism requires is dependent on both size and the complexity of its operating logic. The quantity of Phlogiston Units a Secret Source Servant requires is [DATA LOST]...",
            "nextDialogs": [
              "751500906"
            ]
          },
          "751500906": {
            "id": "751500906",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "While the larger Secret Source Dragon Idols, in fact, require less — specifically, three in number.",
            "nextDialogs": [
              "751500907"
            ]
          },
          "751500907": {
            "id": "751500907",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"Information is energy, and energy is information.\" The data carrier you retrieved counts as a single Phlogiston Unit...",
            "nextDialogs": [
              "751500908"
            ]
          },
          "751500908": {
            "id": "751500908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So one \"Phlogiston Unit\" is one fireball...",
            "nextDialogs": [
              "751500909"
            ]
          },
          "751500909": {
            "id": "751500909",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Yes, that is one way to look at it. You restored a Phlogiston Unit that had been corrupted by the Abyss. Only then could I extract anything from it...",
            "nextDialogs": [
              "751500910"
            ]
          },
          "751500910": {
            "id": "751500910",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "They can also be used as substitute energy sources for Abyss-corroded Source Mechanisms."
          }
        }
      }
    },

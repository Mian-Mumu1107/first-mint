    {
      "subId": "7273102",
      "subQuestName": "Talk to Arataki Itto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727310201"
        ],
        "dialogs": {
          "727310201": {
            "id": "727310201",
            "speakerId": 1000,
            "speakerName": "Grandmaster Hanakado",
            "text": "Hahahahaha...",
            "nextDialogs": [
              "727310202"
            ]
          },
          "727310202": {
            "id": "727310202",
            "speakerId": 1000,
            "speakerName": "Grandmaster Hanakado",
            "text": "Astounding!",
            "nextDialogs": [
              "727310203"
            ]
          },
          "727310203": {
            "id": "727310203",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Hahahahaha...",
            "nextDialogs": [
              "727310204"
            ]
          },
          "727310204": {
            "id": "727310204",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Amazing!",
            "nextDialogs": [
              "727310205"
            ]
          },
          "727310205": {
            "id": "727310205",
            "speakerId": 1000,
            "speakerName": "Grandmaster Hanakado",
            "text": "Even though your fighting style differs greatly from mine, I resonate strongly with the passion you imbue into your Onikabuto.",
            "nextDialogs": [
              "727310206"
            ]
          },
          "727310206": {
            "id": "727310206",
            "speakerId": 1000,
            "speakerName": "Grandmaster Hanakado",
            "text": "In time, you shall surely become a true champion of the beetle-fighting world.",
            "nextDialogs": [
              "727310207"
            ]
          },
          "727310207": {
            "id": "727310207",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "You're pretty good yourself! You managed to win an impressive 570 out of our 1,141 matches!",
            "nextDialogs": [
              "727310208"
            ]
          },
          "727310208": {
            "id": "727310208",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Of all the beetle-battle marathons I've fought in my time, you've lasted the longest by far! Not gonna lie, I'm impressed!",
            "nextDialogs": [
              "727310209"
            ]
          },
          "727310209": {
            "id": "727310209",
            "speakerId": 1000,
            "speakerName": "Grandmaster Hanakado",
            "text": "No, I won 571 rounds, so I'm ahead. Also, you have the home advantage. Taking that into account, it is in fact I who am the superior warrior.",
            "nextDialogs": [
              "727310210"
            ]
          },
          "727310210": {
            "id": "727310210",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Huh? Why you gotta be so stubborn? I remember our score clear as day, and Mamoru is our witness!",
            "nextDialogs": [
              "727310211"
            ]
          },
          "727310211": {
            "id": "727310211",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Ain't that right, Mamoru?",
            "nextDialogs": [
              "727310212"
            ]
          },
          "727310212": {
            "id": "727310212",
            "speakerId": 1003,
            "speakerName": "Mamoru",
            "text": "Boss, I... I really can't take it anymore... Please let me sleep for a while...",
            "nextDialogs": [
              "727310213"
            ]
          },
          "727310213": {
            "id": "727310213",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uhh... Have they been going at it this whole time without a break!?",
            "nextDialogs": [
              "727310214"
            ]
          },
          "727310214": {
            "id": "727310214",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Have they been going at it without a break!?",
            "nextDialogs": [
              "727310217"
            ]
          },
          "727310217": {
            "id": "727310217",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Fine! Since I'm a generous guy, I can give you one round, no problemo. I'll just defeat you next time!",
            "nextDialogs": [
              "727310218"
            ]
          },
          "727310218": {
            "id": "727310218",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "And if you're still not convinced, we'll do the next battle on your home turf. I'll prove that it's about the beetle fighter, not the location!",
            "nextDialogs": [
              "727310219"
            ]
          },
          "727310219": {
            "id": "727310219",
            "speakerId": 1000,
            "speakerName": "Grandmaster Hanakado",
            "text": "That suits me just fine. Follow me.",
            "nextDialogs": [
              "727310220"
            ]
          },
          "727310220": {
            "id": "727310220",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Oh? Hey, compadre, Flying Lavender Melon, you're finally here!",
            "nextDialogs": [
              "727310221"
            ]
          },
          "727310221": {
            "id": "727310221",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait a minute, why's Paimon back to Flying Lavender Melon again? Does Paimon only get a good nickname when she's fighting for you?",
            "nextDialogs": [
              "727310222"
            ]
          },
          "727310222": {
            "id": "727310222",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Uh, never mind that for now! Here's your 2-month free ramen voucher, as agreed. Take it!",
            "nextDialogs": [
              "727310223"
            ]
          },
          "727310223": {
            "id": "727310223",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ramen voucher? Oh yeah, right! The ramen!",
            "nextDialogs": [
              "727310224"
            ]
          },
          "727310224": {
            "id": "727310224",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Now that's more like it!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2103701",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210370101"
        ],
        "dialogs": {
          "210370101": {
            "id": "210370101",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Liyue... I wonder when I'll come back...",
            "nextDialogs": [
              "210370102"
            ]
          },
          "210370102": {
            "id": "210370102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "210370103"
            ]
          },
          "210370103": {
            "id": "210370103",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Ah, Traveler! It's you!",
            "nextDialogs": [
              "210370104"
            ]
          },
          "210370104": {
            "id": "210370104",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Well, my itinerary to Fontaine has finally been decided, and in a few days, I'll set off with that merchant.",
            "nextDialogs": [
              "210370105"
            ]
          },
          "210370105": {
            "id": "210370105",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "He's still got some business stuff to deal with. And I'm taking advantage of this time to make sure I've packed everything.",
            "nextDialogs": [
              "210370108"
            ]
          },
          "210370108": {
            "id": "210370108",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Haha, I might regret my decision if I were to do that.",
            "nextDialogs": [
              "210370109"
            ]
          },
          "210370109": {
            "id": "210370109",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "I'll just take a look around the city from here. I've lived here for so long, and this time, I don't even know when I'll be able to come back.",
            "nextDialogs": [
              "210370110"
            ]
          },
          "210370110": {
            "id": "210370110",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Oh, by the way, Que'er... *sigh* She hasn't agreed to go with me in the end, but I already asked Zhiruo to take care of her.",
            "nextDialogs": [
              "210370111"
            ]
          },
          "210370111": {
            "id": "210370111",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "I've also left some of my savings to her. She's much brighter than I am. She can take care of herself.",
            "nextDialogs": [
              "210370112"
            ]
          },
          "210370112": {
            "id": "210370112",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "And perhaps one day, she'll understand my decision.",
            "nextDialogs": [
              "210370113"
            ]
          },
          "210370113": {
            "id": "210370113",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Right, Traveler, can I ask you one more favor?",
            "nextDialogs": [
              "210370114"
            ]
          },
          "210370114": {
            "id": "210370114",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Could you please fetch me some soil?"
          }
        }
      }
    },
    {
      "subId": "2103703",
      "subQuestName": "Collect some soil for Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210370301"
        ],
        "dialogs": {
          "210370301": {
            "id": "210370301",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Thank you, it should be enough.",
            "nextDialogs": [
              "210370303",
              "210370306"
            ]
          },
          "210370303": {
            "id": "210370303",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Ahahaha... Sorry, I don't want to put you out or anything...",
            "nextDialogs": [
              "210370304"
            ]
          },
          "210370304": {
            "id": "210370304",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "It's just that I still feel a little reluctant to suddenly leave Liyue, where I've lived for so long."
          },
          "210370306": {
            "id": "210370306",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Once the supplies are ready, we will set off.",
            "nextDialogs": [
              "210370307"
            ]
          },
          "210370307": {
            "id": "210370307",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Oh yes, the adventurer who took me to The Chasm will also travel with us.",
            "nextDialogs": [
              "210370308"
            ]
          },
          "210370308": {
            "id": "210370308",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Hearing that I'm heading over to Fontaine, she said she was also intrigued and decided to come with us.",
            "nextDialogs": [
              "210370309"
            ]
          },
          "210370309": {
            "id": "210370309",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "The merchant is happy to have another adventurer to protect him. But to be honest, I'm really not good at communicating with people who are that enthusiastic... *sigh*",
            "nextDialogs": [
              "210370310"
            ]
          },
          "210370310": {
            "id": "210370310",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Never thought that I'd travel this far one day..."
          }
        }
      }
    },
    {
      "subId": "2103704",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210370401"
        ],
        "dialogs": {
          "210370401": {
            "id": "210370401",
            "speakerId": 1001,
            "speakerName": "Little Que'er",
            "text": "He must've been on purpose, Zhiruo! He just... He just doesn't want to be with me! *whimper*",
            "nextDialogs": [
              "210370402"
            ]
          },
          "210370402": {
            "id": "210370402",
            "speakerId": 1002,
            "speakerName": "Zhiruo",
            "text": "Que'er, you and he have spent so much time together, he must know what you're thinking.",
            "nextDialogs": [
              "210370403"
            ]
          },
          "210370403": {
            "id": "210370403",
            "speakerId": 1002,
            "speakerName": "Zhiruo",
            "text": "This time, he's determined to leave Liyue and travel abroad, he must have his reasons. So what's the harm if you travel with him?",
            "nextDialogs": [
              "210370404"
            ]
          },
          "210370404": {
            "id": "210370404",
            "speakerId": 1001,
            "speakerName": "Little Que'er",
            "text": "I just don't want to leave here! What's wrong with us staying here forever? The Guhua Clan... I couldn't care less about the Guhua Clan!",
            "nextDialogs": [
              "210370405"
            ]
          },
          "210370405": {
            "id": "210370405",
            "speakerId": 1002,
            "speakerName": "Zhiruo",
            "text": "Then why don't you tell him that?",
            "nextDialogs": [
              "210370406"
            ]
          },
          "210370406": {
            "id": "210370406",
            "speakerId": 1001,
            "speakerName": "Little Que'er",
            "text": "I... *sigh* He's been drawn to the whole idea of reviving the Clan. If he knew I'd said that, he must hate me...",
            "nextDialogs": [
              "210370407"
            ]
          },
          "210370407": {
            "id": "210370407",
            "speakerId": 1002,
            "speakerName": "Zhiruo",
            "text": "*sigh* Que'er..."
          }
        }
      }
    },
    {
      "subId": "2103705",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],

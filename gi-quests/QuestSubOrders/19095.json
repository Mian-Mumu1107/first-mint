        ],
        "dialogs": {
          "190950201": {
            "id": "190950201",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "...",
            "nextDialogs": [
              "190950202"
            ]
          },
          "190950202": {
            "id": "190950202",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "...",
            "nextDialogs": [
              "190950203"
            ]
          },
          "190950203": {
            "id": "190950203",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Welcome back, you two... Klee always thinks that Kaeya is also being kept in confinement. Now I can explain the matter to her.",
            "nextDialogs": [
              "190950204"
            ]
          },
          "190950204": {
            "id": "190950204",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "So what's the matter, exactly?",
            "nextDialogs": [
              "190950205"
            ]
          },
          "190950205": {
            "id": "190950205",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "...Cauldron explosion.",
            "nextDialogs": [
              "190950206"
            ]
          },
          "190950206": {
            "id": "190950206",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Just the one?",
            "nextDialogs": [
              "190950207"
            ]
          },
          "190950207": {
            "id": "190950207",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "No, all of them, in fact, and they took the Crafting Bench with them, too. There was... a lot of smoke?",
            "nextDialogs": [
              "190950208"
            ]
          },
          "190950208": {
            "id": "190950208",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Ah. No wonder Jean was looking for you.",
            "nextDialogs": [
              "190950209",
              "190950211"
            ]
          },
          "190950209": {
            "id": "190950209",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Well, I hope you'll have a more practiced response to it next time.",
            "nextDialogs": [
              "190950210"
            ]
          },
          "190950210": {
            "id": "190950210",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "If something like this happens again, call me and Albedo. It'll be easier if we go and apologize to Jean and the affected people together, alright?",
            "nextDialogs": [
              "190950212"
            ]
          },
          "190950212": {
            "id": "190950212",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "I suppose you can guess the rest. Sorry for dragging you into this as soon as you got back.",
            "nextDialogs": [
              "190950213"
            ]
          },
          "190950213": {
            "id": "190950213",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Don't mention it.",
            "nextDialogs": [
              "190950297"
            ]
          },
          "190950297": {
            "id": "190950297",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't mind us, Albedo.",
            "nextDialogs": [
              "190950214"
            ]
          },
          "190950214": {
            "id": "190950214",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "I'm afraid that time's a little tight, so the gifts will have to wait for later. I'll ask Klee to look for you once she gets out.",
            "nextDialogs": [
              "190950215"
            ]
          },
          "190950215": {
            "id": "190950215",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Alright, sure. Just focus on clearing the workshop. We can talk later.",
            "nextDialogs": [
              "190950216"
            ]
          },
          "190950216": {
            "id": "190950216",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Well, Albedo's gone. I suppose it's time for us to leave, too."
          },
          "190950211": {
            "id": "190950211",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Everyone in Mondstadt saw the smoke floating over the workshop that day."
          }
        }
      }
    },

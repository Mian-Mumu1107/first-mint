  "subQuests": [
    {
      "subId": "2007112",
      "subQuestName": "Talk to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710401"
        ],
        "dialogs": {
          "200710401": {
            "id": "200710401",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Here, over here!",
            "nextDialogs": [
              "200710402"
            ]
          },
          "200710402": {
            "id": "200710402",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Do you still remember the flowers that I asked you to store on Dragonspine?",
            "nextDialogs": [
              "200710403"
            ]
          },
          "200710403": {
            "id": "200710403",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "It's been a day since then, and I'd like to see the results of our cold storage experiment.",
            "nextDialogs": [
              "200710404"
            ]
          },
          "200710404": {
            "id": "200710404",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Could you help me go up the mountain and bring those flowers back?",
            "nextDialogs": [
              "200710406",
              "200710408"
            ]
          },
          "200710406": {
            "id": "200710406",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I'm counting on you, then. I'll be waiting here, so do come back soon."
          },
          "200710408": {
            "id": "200710408",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "You forgot? You put them <color=#00E1FFFF>beside a Statue of The Seven</color>, <color=#00E1FFFF>by a body of water in the mountains</color>, and <color=#00E1FFFF>near a cavern</color>.",
            "nextDialogs": [
              "200710409"
            ]
          },
          "200710409": {
            "id": "200710409",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Let me help you mark them on your map again."
          }
        }
      }
    },
    {
      "subId": "2007101",
      "subQuestName": "Head to Dragonspine to retrieve the packages",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710101"
        ],
        "dialogs": {
          "200710101": {
            "id": "200710101",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers that we stored away on Dragonspine earlier?",
            "nextDialogs": [
              "200710102"
            ]
          },
          "200710102": {
            "id": "200710102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I only managed to retrieve one of them...",
            "nextDialogs": [
              "200710103"
            ]
          },
          "200710103": {
            "id": "200710103",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "The others couldn't be retrieved? Um... Well, alright then. It is quite hard to predict conditions on that mountain, after all.",
            "nextDialogs": [
              "200710104"
            ]
          },
          "200710104": {
            "id": "200710104",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "But if we only have one, then we can't make any comparisons. I suppose we'll just have to wait for another opportunity...",
            "nextDialogs": [
              "200710105"
            ]
          },
          "200710105": {
            "id": "200710105",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you for taking the trouble, though. Here, I prepared these as compensation — I might need to call upon your help in the future as well."
          }
        }
      }
    },
    {
      "subId": "2007102",
      "subQuestName": "Retrieve the package near the Dragonspine Statue of The Seven",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710201"
        ],
        "dialogs": {
          "200710201": {
            "id": "200710201",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers?",
            "nextDialogs": [
              "200710202"
            ]
          },
          "200710202": {
            "id": "200710202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sorry...",
            "nextDialogs": [
              "200710203"
            ]
          },
          "200710203": {
            "id": "200710203",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Huh? What happened?",
            "nextDialogs": [
              "200710204"
            ]
          },
          "200710204": {
            "id": "200710204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I broke the containers and flowers by accident...",
            "nextDialogs": [
              "200710205"
            ]
          },
          "200710205": {
            "id": "200710205",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "B—By accident!?",
            "nextDialogs": [
              "200710206"
            ]
          },
          "200710206": {
            "id": "200710206",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ugh... I specifically picked those flowers out. You can't find such good flowers just anywhere...",
            "nextDialogs": [
              "200710207"
            ]
          },
          "200710207": {
            "id": "200710207",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Is Dragonspine so dangerous that even an adventurer like you couldn't keep one container from...",
            "nextDialogs": [
              "200710208"
            ]
          },
          "200710208": {
            "id": "200710208",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Still, thanks for making that trip for me. Please take these as thanks. Now, if you'll excuse me, I have to go tend to my flowers.",
            "nextDialogs": [
              "200710209"
            ]
          },
          "200710209": {
            "id": "200710209",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "*sigh* Maybe I should try the method that Sara suggested after all..."
          }
        }
      }
    },
    {
      "subId": "2007103",
      "subQuestName": "Retrieve the package near the Dragonspine Statue of The Seven",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200710301"
        ],
        "dialogs": {
          "200710301": {
            "id": "200710301",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers that we stored away on Dragonspine earlier?",
            "nextDialogs": [
              "200710302"
            ]
          },
          "200710302": {
            "id": "200710302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have them all here.",
            "nextDialogs": [
              "200710303"
            ]
          },
          "200710303": {
            "id": "200710303",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "All of them? That's great! Here, let me see.",
            "nextDialogs": [
              "200710304"
            ]
          },
          "200710304": {
            "id": "200710304",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Hehe, not bad at all. Hmm... Looks like this method really does work.",
            "nextDialogs": [
              "200710305"
            ]
          },
          "200710305": {
            "id": "200710305",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "The only problem is that Dragonspine is really far from Mondstadt. I can't be troubling you every time, either. I have to find some other way in future...",
            "nextDialogs": [
              "200710306"
            ]
          },
          "200710306": {
            "id": "200710306",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you very much, all the same. Here's your compensation, please take it!"
          }
        }
      }
    },

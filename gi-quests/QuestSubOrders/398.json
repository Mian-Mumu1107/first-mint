  "subQuests": [
    {
      "subId": "39810",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3981001"
        ],
        "dialogs": {
          "3981001": {
            "id": "3981001",
            "speakerId": 1162,
            "speakerName": "Otto",
            "text": "Now I have to submit a full damage report on the disaster to Lisa...",
            "nextDialogs": [
              "3981002"
            ]
          },
          "3981002": {
            "id": "3981002",
            "speakerId": 1162,
            "speakerName": "Otto",
            "text": "There were no casualties, but they still want a record of every scraped knee and every broken roof tile for some reason..."
          }
        }
      }
    },
    {
      "subId": "39812",
      "subQuestName": "Destroy the hilichurls' barricades",

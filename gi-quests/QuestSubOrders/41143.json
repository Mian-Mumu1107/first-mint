            "id": "411430301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411430302"
            ]
          },
          "411430302": {
            "id": "411430302",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Yup, you've come at just the right moment — I'd just finished preparing this Sweet Madame.",
            "nextDialogs": [
              "411430303"
            ]
          },
          "411430303": {
            "id": "411430303",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Wallit ordered it earlier, and requested that we deliver it to a location west of the Dawn Winery later in the day...",
            "nextDialogs": [
              "411430304"
            ]
          },
          "411430304": {
            "id": "411430304",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "If you don't mind helping us out, could you take his order to him real quick?"
          }
        }
      }

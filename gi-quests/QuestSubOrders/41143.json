    {
      "subId": "4114301",
      "subQuestName": "Talk to Sara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411430101"
        ],
        "dialogs": {
          "411430101": {
            "id": "411430101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll deliver it right now.",
            "nextDialogs": [
              "411430102"
            ]
          },
          "411430102": {
            "id": "411430102",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "That would be great, thank you!",
            "nextDialogs": [
              "411430103"
            ]
          },
          "411430103": {
            "id": "411430103",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Please be careful while you make the delivery. <color=#00E1FFFF>Don't let any strange elements touch the food</color>.",
            "nextDialogs": [
              "411430104"
            ]
          },
          "411430104": {
            "id": "411430104",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Also, <color=#00E1FFFF>do your best to avoid monsters, or they might knock the dish over</color>.",
            "nextDialogs": [
              "411430105"
            ]
          },
          "411430105": {
            "id": "411430105",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Please hurry, this dish won't taste good if it gets cold."
          }
        }
      }
    },
    {
      "subId": "4114302",
      "subQuestName": "Deliver the food to Short-Tempered Wallit",

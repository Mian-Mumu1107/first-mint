  "subQuests": [
    {
      "subId": "1480101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698450101"
        ],
        "dialogs": {
          "698450101": {
            "id": "698450101",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "...",
            "nextDialogs": [
              "698450102"
            ]
          },
          "698450102": {
            "id": "698450102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Is that Neuvillette? And he's standing alone in the rain... Has something upset him?)",
            "nextDialogs": [
              "698450103"
            ]
          },
          "698450103": {
            "id": "698450103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I should say hi. Don't get an opportunity like this every day.)",
            "nextDialogs": [
              "698450104"
            ]
          },
          "698450104": {
            "id": "698450104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello.",
            "nextDialogs": [
              "698450105"
            ]
          },
          "698450105": {
            "id": "698450105",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "#Ah, {NICKNAME}. Hello to you as well.",
            "nextDialogs": [
              "698450106"
            ]
          },
          "698450106": {
            "id": "698450106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How've you been?",
            "nextDialogs": [
              "698450107"
            ]
          },
          "698450107": {
            "id": "698450107",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "I am the same as always. Thank you for your concern.",
            "nextDialogs": [
              "698450108"
            ]
          },
          "698450108": {
            "id": "698450108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In a good mood, I see?",
            "nextDialogs": [
              "698450109"
            ]
          },
          "698450109": {
            "id": "698450109",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Yes. You noticed?",
            "nextDialogs": [
              "698450110"
            ]
          },
          "698450110": {
            "id": "698450110",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "The morning paper forecasted rain here at precisely this hour.",
            "nextDialogs": [
              "698450111"
            ]
          },
          "698450111": {
            "id": "698450111",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "In my experience, predictions of this nature are not entirely reliable...",
            "nextDialogs": [
              "698450112"
            ]
          },
          "698450112": {
            "id": "698450112",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Yet today, the downpour arrived on schedule. A stroke of luck.",
            "nextDialogs": [
              "698450113"
            ]
          },
          "698450113": {
            "id": "698450113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's wonderful! I'm glad it worked out.",
            "nextDialogs": [
              "698450114"
            ]
          },
          "698450114": {
            "id": "698450114",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Thank you.",
            "nextDialogs": [
              "698450115"
            ]
          },
          "698450115": {
            "id": "698450115",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Though I do realize that standing in the rain is only my personal predilection, and that most would find it odd.",
            "nextDialogs": [
              "698450116"
            ]
          },
          "698450116": {
            "id": "698450116",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Are you certain you wish to stand here with me while it pours unceasingly?",
            "nextDialogs": [
              "698450119"
            ]
          },
          "698450119": {
            "id": "698450119",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Hmm, I see...",
            "nextDialogs": [
              "698450120"
            ]
          },
          "698450120": {
            "id": "698450120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something on your mind?",
            "nextDialogs": [
              "698450121"
            ]
          },
          "698450121": {
            "id": "698450121",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Yes... I recently overheard a few Melusines complaining that the weather seemed to be conspiring against them.",
            "nextDialogs": [
              "698450122"
            ]
          },
          "698450122": {
            "id": "698450122",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "For instance, whenever they carry an umbrella with them, hardly a single cloud shows itself. Yet when they gamble on sunshine, a downpour awaits.",
            "nextDialogs": [
              "698450123"
            ]
          },
          "698450123": {
            "id": "698450123",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Naturally, I know that there is no causal relationship at work, having personally tested the theory...",
            "nextDialogs": [
              "698450124"
            ]
          },
          "698450124": {
            "id": "698450124",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "And... Well, put simply, it didn't hold water.",
            "nextDialogs": [
              "698450125"
            ]
          },
          "698450125": {
            "id": "698450125",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Yet the fact you brought this up now makes me wonder. Perhaps today's rain arrived thanks to you."
          }
        }
      }
    }
  ]
}
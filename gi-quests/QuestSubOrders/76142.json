        ],
        "dialogs": {
          "761420401": {
            "id": "761420401",
            "speakerId": 22363,
            "speakerName": "???",
            "text": "Don't be afraid. Patoli and I will get you out of here. Stand tall — hold that blade like a proper Lightkeeper!",
            "nextDialogs": [
              "761420402"
            ]
          },
          "761420402": {
            "id": "761420402",
            "speakerId": 22364,
            "speakerName": "Filaev",
            "text": "I... I...",
            "nextDialogs": [
              "761420403"
            ]
          },
          "761420403": {
            "id": "761420403",
            "speakerId": 22363,
            "speakerName": "???",
            "text": "What plan? What plan could there possibly be, Patoli? If this is the end, then I'll fight to the last right here.",
            "nextDialogs": [
              "761420404"
            ]
          },
          "761420404": {
            "id": "761420404",
            "speakerId": 22363,
            "speakerName": "???",
            "text": "You're the finest squad I've ever had. Whatever happens next... it has been my honor to fight alongside you.",
            "nextDialogs": [
              "761420405"
            ]
          },
          "761420405": {
            "id": "761420405",
            "speakerId": 22364,
            "speakerName": "Filaev",
            "text": "...",
            "nextDialogs": [
              "761420406"
            ]
          },
          "761420406": {
            "id": "761420406",
            "speakerId": 22364,
            "speakerName": "Filaev",
            "text": "The honor's all ours, Captain.",
            "nextDialogs": [
              "761420407"
            ]
          },
          "761420407": {
            "id": "761420407",
            "speakerId": 22363,
            "speakerName": "???",
            "text": "Come on, prepare the defense! Let these damned creatures witness the wrath of the Frostgale Steeds!"
          }
        }

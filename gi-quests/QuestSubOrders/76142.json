            "speakerId": 10205,
            "speakerName": "???",
            "text": "Hey, Chernov, you okay?",
            "nextDialogs": [
              "761420302"
            ]
          },
          "761420302": {
            "id": "761420302",
            "speakerId": 22365,
            "speakerName": "Chernov",
            "text": "Still lifting that blade... Captain.",
            "nextDialogs": [
              "761420303"
            ]
          },
          "761420303": {
            "id": "761420303",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Shonokovych, Filaev... are you alright?",
            "nextDialogs": [
              "761420304"
            ]
          },
          "761420304": {
            "id": "761420304",
            "speakerId": 22362,
            "speakerName": "Shonokovych",
            "text": "Ugh... pretty sure my leg's busted, but hey, I'm still breathing. You keeping count? How many did I take down?",
            "nextDialogs": [
              "761420305"
            ]
          },
          "761420305": {
            "id": "761420305",
            "speakerId": 22364,
            "speakerName": "Filaev",
            "text": "H—How many monsters are there? Are we... are we gonna die out here, Captain?",
            "nextDialogs": [
              "761420306"
            ]
          },
          "761420306": {
            "id": "761420306",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "What nonsense are you talking about, kid? We'll definitely make it out safely! Don't worry, the scout must have already returned to the city to inform the old man, our reinforcements are on their way!",
            "nextDialogs": [
              "761420307"
            ]
          },
          "761420307": {
            "id": "761420307",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...Here they come again, these Wild Hunt just won't give us a break!",
            "nextDialogs": [
              "761420308"
            ]
          },
          "761420308": {
            "id": "761420308",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Alright! Weapons up, lanterns steady. We've got another wave coming!"
          }
        }
      }
    },

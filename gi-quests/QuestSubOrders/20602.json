        "dialogs": {
          "206020501": {
            "id": "206020501",
            "speakerId": 1000,
            "speakerName": "Cyrus",
            "text": "You're back. What's the situation?",
            "nextDialogs": [
              "206020502"
            ]
          },
          "206020502": {
            "id": "206020502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There are still monsters out and about...",
            "nextDialogs": [
              "206020503"
            ]
          },
          "206020503": {
            "id": "206020503",
            "speakerId": 1000,
            "speakerName": "Cyrus",
            "text": "Monsters are still in the area, eh? So it seems that the effects of the Storm have yet to disperse...",
            "nextDialogs": [
              "206020504"
            ]
          },
          "206020504": {
            "id": "206020504",
            "speakerId": 1000,
            "speakerName": "Cyrus",
            "text": "Hahaha! So there's still time, then — time for the Adventurers' Guild to show its quality.",
            "nextDialogs": [
              "206020505"
            ]
          },
          "206020505": {
            "id": "206020505",
            "speakerId": 1000,
            "speakerName": "Cyrus",
            "text": "It is up to us to take those monsters out in the wild on, while the Knights of Favonius are still focused on defending the city and the area around Mondstadt.",
            "nextDialogs": [
              "206020506"
            ]
          },
          "206020506": {
            "id": "206020506",
            "speakerId": 1000,
            "speakerName": "Cyrus",
            "text": "I understand. Thanks for your help in investigating. I will reconsider the commissions that we will be sending out. Take these as your reward."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7109801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980101"
        ],
        "dialogs": {
          "710980101": {
            "id": "710980101",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Sir, I believe it might be worth mentioning that if we take today into account, we have now eaten Radish Veggie Soup for six full days.",
            "nextDialogs": [
              "710980102"
            ]
          },
          "710980102": {
            "id": "710980102",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Our dire financial straits notwithstanding, I believe that our gastrointestinal circumstances are not to be ignored...",
            "nextDialogs": [
              "710980103"
            ]
          },
          "710980103": {
            "id": "710980103",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "And right you are, my dear Lutong. Sharp as ever, if I do say so myself!",
            "nextDialogs": [
              "710980104"
            ]
          },
          "710980104": {
            "id": "710980104",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "It may be due to these gastrointestinal issues that we have been unable to ascertain the flavor of this dish.",
            "nextDialogs": [
              "710980105"
            ]
          },
          "710980105": {
            "id": "710980105",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "We require a witness, Lutong! We must find ourselves a third party.",
            "nextDialogs": [
              "710980106"
            ]
          },
          "710980106": {
            "id": "710980106",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "You flatter me, sir, but I believe that my point was...",
            "nextDialogs": [
              "710980109"
            ]
          },
          "710980109": {
            "id": "710980109",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Aha! And here come our witnesses now — and there's more than one, to be sure! Wonderful!",
            "nextDialogs": [
              "710980110"
            ]
          },
          "710980110": {
            "id": "710980110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "E—Eh? What witnesses?",
            "nextDialogs": [
              "710980111"
            ]
          },
          "710980111": {
            "id": "710980111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You mean us?",
            "nextDialogs": [
              "710980112"
            ]
          },
          "710980112": {
            "id": "710980112",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Indeed! Pray tell, have you ever had Radish Veggie Soup? Are you familiar with its flavor and how it's made?",
            "nextDialogs": [
              "710980113"
            ]
          },
          "710980113": {
            "id": "710980113",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Sir, I believe that we must at least apprise them of the whys and wherefores of this situation...",
            "nextDialogs": [
              "710980114"
            ]
          },
          "710980114": {
            "id": "710980114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Ooh, of course we know it well! {NICKNAME} knows how to make it, too!",
            "nextDialogs": [
              "710980115"
            ]
          },
          "710980115": {
            "id": "710980115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, we should really hear what this is all about first...",
            "nextDialogs": [
              "710980116"
            ]
          },
          "710980116": {
            "id": "710980116",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Right, yes, allow me to explain this commission. I hope you shall be amenable to it...",
            "nextDialogs": [
              "710980117"
            ]
          },
          "710980117": {
            "id": "710980117",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "I am Lutong, and this is Garcia, my boss, who hails from Fontaine.",
            "nextDialogs": [
              "710980118"
            ]
          },
          "710980118": {
            "id": "710980118",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Mr. Garcia is currently developing a... I believe he calls it the Numbering Machine.",
            "nextDialogs": [
              "710980119"
            ]
          },
          "710980119": {
            "id": "710980119",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "More specifically, it is a tool that will allow people to perform various calculations. Is that about right, sir?",
            "nextDialogs": [
              "710980120"
            ]
          },
          "710980120": {
            "id": "710980120",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "As precise as precise can be, my dear Lutong. The Number Machine's functions are just so. A concise answer indeed.",
            "nextDialogs": [
              "710980121"
            ]
          },
          "710980121": {
            "id": "710980121",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Yes, conciseness... We must be concise. That transformer is far too complex...",
            "nextDialogs": [
              "710980122"
            ]
          },
          "710980122": {
            "id": "710980122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait. But what does this have to do with Radish Veggie Soup?",
            "nextDialogs": [
              "710980123"
            ]
          },
          "710980123": {
            "id": "710980123",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Ah. I think this question would be best answered by you, Mr. Garcia.",
            "nextDialogs": [
              "710980124"
            ]
          },
          "710980124": {
            "id": "710980124",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "But how should we simplify it... Oh! Right, yes. Allow me to explain.",
            "nextDialogs": [
              "710980125"
            ]
          },
          "710980125": {
            "id": "710980125",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Hmmm... Let us begin with the most elementary matters. Are you familiar with \"formulae\"?",
            "nextDialogs": [
              "710980126"
            ]
          },
          "710980126": {
            "id": "710980126",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mm... Not exactly...",
            "nextDialogs": [
              "710980127"
            ]
          },
          "710980127": {
            "id": "710980127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not entirely familiar with what you mean either.",
            "nextDialogs": [
              "710980128"
            ]
          },
          "710980128": {
            "id": "710980128",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Alright, that's alright. You may consider formulae to be... Um...",
            "nextDialogs": [
              "710980129"
            ]
          },
          "710980129": {
            "id": "710980129",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "An equation that is used to express the relationship between various quantities, and which possesses a certain general applicability...",
            "nextDialogs": [
              "710980130"
            ]
          },
          "710980130": {
            "id": "710980130",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? What?",
            "nextDialogs": [
              "710980131"
            ]
          },
          "710980131": {
            "id": "710980131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sounds impressive.",
            "nextDialogs": [
              "710980132"
            ]
          },
          "710980132": {
            "id": "710980132",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Simply put, we intend to use the Numbering Machine to attempt to write a recipe formula for Radish Veggie Soup.",
            "nextDialogs": [
              "710980133"
            ]
          },
          "710980133": {
            "id": "710980133",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Mr. Garcia believes that as long as we obtain the right formula, we can convert the method of making Radish Veggie Soup into...",
            "nextDialogs": [
              "710980134"
            ]
          },
          "710980134": {
            "id": "710980134",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "...A sort of general procedure.",
            "nextDialogs": [
              "710980135"
            ]
          },
          "710980135": {
            "id": "710980135",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "An idiot-proof procedure, if you will.",
            "nextDialogs": [
              "710980136"
            ]
          },
          "710980136": {
            "id": "710980136",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "As long as this procedure is followed, anyone can produce delicious Radish Veggie Soup.",
            "nextDialogs": [
              "710980137"
            ]
          },
          "710980137": {
            "id": "710980137",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That sounds pretty good... But couldn't you just have asked someone to teach you how to make the dish directly?",
            "nextDialogs": [
              "710980138"
            ]
          },
          "710980138": {
            "id": "710980138",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Unfortunately, such a method is too greatly predicated upon natural talent.",
            "nextDialogs": [
              "710980139"
            ]
          },
          "710980139": {
            "id": "710980139",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "For people like Mr. Garcia and I, who lack any culinary predisposition at all, it is unlikely that we would be able to grasp the essence of any lessons that any chef, no matter how patient, might teach us.",
            "nextDialogs": [
              "710980140"
            ]
          },
          "710980140": {
            "id": "710980140",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "In fact, I believe that Mr. Yanxiao of this very inn has experienced this first-hand..."
          }
        }
      }
    },
    {
      "subId": "7109802",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980701"
        ],
        "dialogs": {
          "710980701": {
            "id": "710980701",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "...This parameter, and this one...",
            "nextDialogs": [
              "710980702"
            ]
          },
          "710980702": {
            "id": "710980702",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Mr. Garcia?",
            "nextDialogs": [
              "710980703"
            ]
          },
          "710980703": {
            "id": "710980703",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "No, no, almost, almost... Wait, no. Ah, fascinating. How fascinating...",
            "nextDialogs": [
              "710980704"
            ]
          },
          "710980704": {
            "id": "710980704",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Mr. Garcia.",
            "nextDialogs": [
              "710980705"
            ]
          },
          "710980705": {
            "id": "710980705",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Ah, Lutong. My good Lutong, have you helped me order that dish?",
            "nextDialogs": [
              "710980706"
            ]
          },
          "710980706": {
            "id": "710980706",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Yes, the Radish Veggie Soup has been ordered, sir.",
            "nextDialogs": [
              "710980707"
            ]
          },
          "710980707": {
            "id": "710980707",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Wonderful. How considerate of you, dear Lutong. I'm sure that we shall have our processing formula this time.",
            "nextDialogs": [
              "710980708"
            ]
          },
          "710980708": {
            "id": "710980708",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "I'm looking forward to it, sir.",
            "nextDialogs": [
              "710980709"
            ]
          },
          "710980709": {
            "id": "710980709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? What are they talking about... And what's a processing formula, anyway?",
            "nextDialogs": [
              "710980711",
              "710980713"
            ]
          },
          "710980711": {
            "id": "710980711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, then let's go ask them. Maybe they're researching some kind of new dish... Y'know, one that we can try!"
          },
          "710980713": {
            "id": "710980713",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's true! Maybe they're researching some kind of new dish... Y'know, one that we can try!"
          }
        }
      }
    },
    {
      "subId": "7109803",

    {
      "subId": "7109804",
      "subQuestName": "Go to the kitchen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980401"
        ],
        "dialogs": {
          "710980401": {
            "id": "710980401",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "You've finished making the dish already? You must be skilled indeed."
          }
        }
      }
    },
    {
      "subId": "7109809",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710980901"
        ],
        "dialogs": {
          "710980901": {
            "id": "710980901",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Let us begin, Lutong, with ten percent less of each ingredient this time... Alright then. Step 1: begin cooking.",
            "nextDialogs": [
              "710980902"
            ]
          },
          "710980902": {
            "id": "710980902",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Yes, sir.",
            "nextDialogs": [
              "710980903"
            ]
          },
          "710980903": {
            "id": "710980903",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "First, the water... Ah! Careful there with the speed at which the water is poured. It is most important.",
            "nextDialogs": [
              "710980904"
            ]
          },
          "710980904": {
            "id": "710980904",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Next, we add the ingredients. First, in go the radishes...",
            "nextDialogs": [
              "710980905"
            ]
          },
          "710980905": {
            "id": "710980905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Y'know, this looks more like an alchemy experiment than cooking...",
            "nextDialogs": [
              "710980906"
            ]
          },
          "710980906": {
            "id": "710980906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Will dishes made this way really turn out alright?",
            "nextDialogs": [
              "710980907"
            ]
          },
          "710980907": {
            "id": "710980907",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "And it is done — Radish Veggie Soup!",
            "nextDialogs": [
              "710980908"
            ]
          },
          "710980908": {
            "id": "710980908",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Our process went quite smoothly, sir.",
            "nextDialogs": [
              "710980909"
            ]
          },
          "710980909": {
            "id": "710980909",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Indeed, let us give it a try, Traveler. You're welcome to have seconds, if you two so wish!",
            "nextDialogs": [
              "710980910"
            ]
          },
          "710980910": {
            "id": "710980910",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Woohoo! Let's dig in!",
            "nextDialogs": [
              "710980911"
            ]
          },
          "710980911": {
            "id": "710980911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks...",
            "nextDialogs": [
              "710980912"
            ]
          },
          "710980912": {
            "id": "710980912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... This tastes like...",
            "nextDialogs": [
              "710980913"
            ]
          },
          "710980913": {
            "id": "710980913",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "...Sir, I suspect that these radishes must be cooked for a while longer...",
            "nextDialogs": [
              "710980914"
            ]
          },
          "710980914": {
            "id": "710980914",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "*cough* Agh... How did the Mints turn out like this? I'm sure that I had calculated its optimal cooking time...",
            "nextDialogs": [
              "710980917"
            ]
          },
          "710980917": {
            "id": "710980917",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "*cough* The flavor of this soup is... actually worse than what was made in our previous attempt!",
            "nextDialogs": [
              "710980918"
            ]
          },
          "710980918": {
            "id": "710980918",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "I... *cough* fully concur with your position, sir.",
            "nextDialogs": [
              "710980919"
            ]
          },
          "710980919": {
            "id": "710980919",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "*cough* Alright... Step Two: feedback.",
            "nextDialogs": [
              "710980920"
            ]
          },
          "710980920": {
            "id": "710980920",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "I say! The formula must be missing one parameter or another, or our calculations are still imprecise... I must adjust the machine's algorithm.",
            "nextDialogs": [
              "710980921"
            ]
          },
          "710980921": {
            "id": "710980921",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Lutong, have you recorded all the data from this cooking session?",
            "nextDialogs": [
              "710980922"
            ]
          },
          "710980922": {
            "id": "710980922",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "They have all been recorded, sir.",
            "nextDialogs": [
              "710980923"
            ]
          },
          "710980923": {
            "id": "710980923",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Excellent — we are one step closer to success, then. In that case, on to Step Three: requesting that a chef demonstrate the cooking process once more."
          }
        }
      }
    },
    {
      "subId": "7109805",
      "subQuestName": "Light a fire",
      "sceneId": null,
      "locations": [],

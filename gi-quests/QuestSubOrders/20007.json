  "subQuests": [
    {
      "subId": "2000709",
      "subQuestName": "Go and investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070901"
        ],
        "dialogs": {
          "200070901": {
            "id": "200070901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In for a penny...",
            "nextDialogs": [
              "200070902"
            ]
          },
          "200070902": {
            "id": "200070902",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Wonderful! There should be some in the woods."
          }
        }
      }
    },
    {
      "subId": "2000701",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070101"
        ],
        "dialogs": {
          "200070101": {
            "id": "200070101",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "#Th—Thank you, {NICKNAME}, I can't believe my luck... I was sure I was done for...",
            "nextDialogs": [
              "200070102"
            ]
          },
          "200070102": {
            "id": "200070102",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "This cart is loaded up with everything the hunters managed to catch. Draff had me deliver it to the city.",
            "nextDialogs": [
              "200070103"
            ]
          },
          "200070103": {
            "id": "200070103",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "I'm... not the best hunter in the world, but a simple delivery is something I should be able to handle. Or so I thought...",
            "nextDialogs": [
              "200070104"
            ]
          },
          "200070104": {
            "id": "200070104",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "I very nearly messed the whole thing up. This attack was completely out of the blue. I guess they must have been after the goods. It's a good thing you showed up when you did.",
            "nextDialogs": [
              "200070105"
            ]
          },
          "200070105": {
            "id": "200070105",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Erm, it's not easy for me to ask, but... My cart was damaged in the attack, and it's my only way out of here.",
            "nextDialogs": [
              "200070106"
            ]
          },
          "200070106": {
            "id": "200070106",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "I'm sure the woods around here would have the materials I need for any repairs, but I just can't bring myself to leave my goods unattended.",
            "nextDialogs": [
              "200070107"
            ]
          },
          "200070107": {
            "id": "200070107",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "If it's not too much hassle, would you be able to take a look around and help me find a <color=#00E1FFFF>Sturdy Plank</color>?"
          }
        }
      }
    },
    {
      "subId": "2000702",
      "subQuestName": "Talk to Allan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070701"
        ],
        "dialogs": {
          "200070701": {
            "id": "200070701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, I've got this.",
            "nextDialogs": [
              "200070702"
            ]
          },
          "200070702": {
            "id": "200070702",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Fantastic! I'll be waiting right here. Please don't be too long though, I feel like they might come back..."
          }
        }
      }
    },
    {
      "subId": "2000703",
      "subQuestName": "Collect wood",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070301"
        ],
        "dialogs": {
          "200070301": {
            "id": "200070301",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "That's plenty, in just two seconds I'll have this...",
            "nextDialogs": [
              "200070302"
            ]
          },
          "200070302": {
            "id": "200070302",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Ahhh! They're back, Traveler, they're back!"
          }
        }
      }
    },
    {
      "subId": "2000704",
      "subQuestName": "Give the Sturdy Plank to Allan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2000705",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070501"
        ],
        "dialogs": {
          "200070501": {
            "id": "200070501",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "There should be some rope in the woods."
          }
        }
      }
    },
    {
      "subId": "2000706",
      "subQuestName": "Talk to Allan",
      "sceneId": null,
      "locations": [],
      "dialogue": {

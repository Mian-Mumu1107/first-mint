      }
    },
    {
      "subId": "2000707",
      "subQuestName": "Collect rope",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2000708",
      "subQuestName": "Give the rope to Allan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070601"
        ],
        "dialogs": {
          "200070601": {
            "id": "200070601",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "That should do it. It feels like it could fall apart at any moment, but as long it gets me back to Mondstadt I'll be fine.",
            "nextDialogs": [
              "200070602"
            ]
          },
          "200070602": {
            "id": "200070602",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Thanks for everything! I'm good to go now. Get in touch next time you're in Springvale and let's get a drink!",
            "nextDialogs": [
              "200070603"
            ]
          },
          "200070603": {
            "id": "200070603",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "...As long as you don't drink like Draff, that is."
          }
        }
      }
    },
    {
      "subId": "2000702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070201"
        ],
        "dialogs": {
          "200070201": {
            "id": "200070201",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "It just needs patching up here and there, just enough so it can make it to Mondstadt.",
            "nextDialogs": [
              "200070202"
            ]
          },
          "200070202": {
            "id": "200070202",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "There's bound to be some useful timber in the woods around here."
          }
        }
      }
    },
    {
      "subId": "2000704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070401"
        ],
        "dialogs": {
          "200070401": {
            "id": "200070401",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "You're a life-saver! They are awfully persistent, aren't they? I wonder what those hunters caught that is so irresistible ...",
            "nextDialogs": [
              "200070402"
            ]
          },
          "200070402": {
            "id": "200070402",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "I have nothing but admiration for Draff, managing to hunt such fine specimens. *sigh* If only I could learn to hunt like him...",
            "nextDialogs": [
              "200070403"
            ]
          },
          "200070403": {
            "id": "200070403",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Well, first things first. Better get this old thing into the city.",
            "nextDialogs": [
              "200070404"
            ]
          },
          "200070404": {
            "id": "200070404",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Argh, you're not going to believe this... I was almost done repairing the cart, but they did a little bit more damage when they attacked again...",
            "nextDialogs": [
              "200070405"
            ]
          },
          "200070405": {
            "id": "200070405",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Things can only get worse the longer I stay here. I need to fix this as soon as possible. There was some rope in the back, but the hilichurls must have nabbed it.",
            "nextDialogs": [
              "200070406"
            ]
          },
          "200070406": {
            "id": "200070406",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Traveler — may I trouble you to look around the area and see if you can find some <color=#00E1FFFF>rope</color>?"
          }
        }
      }
    },
    {
      "subId": "2000708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200070801"
        ],
        "dialogs": {
          "200070801": {
            "id": "200070801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Come on, you've got this!",
            "nextDialogs": [
              "200070802"
            ]
          },
          "200070802": {
            "id": "200070802",
            "speakerId": 1539,
            "speakerName": "Allan",
            "text": "Please, I'm begging you! They might still be nearby... I need to disappear as soon as possible, and you're the only one who can help make that happen!"
          }
        }
      }
    },
    {
      "subId": "2000710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200071001"
        ],
        "dialogs": {
          "200071001": {
            "id": "200071001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have other things to do.",
            "nextDialogs": [
              "200071002"
            ]
          },
          "200071002": {
            "id": "200071002",
            "speakerId": 10034,
            "speakerName": "Allan",
            "text": "But... This is the final step, I just need the rope and then I can take things from there! Sorry to trouble you..."
          }
        }
      }
    }
  ]
}
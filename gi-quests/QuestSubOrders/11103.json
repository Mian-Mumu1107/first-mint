    {
      "subId": "1110307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030701"
        ],
        "dialogs": {
          "111030701": {
            "id": "111030701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We finished the ritual, and we followed all the instructions to the letter!",
            "nextDialogs": [
              "111030702"
            ]
          },
          "111030702": {
            "id": "111030702",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...Close enough.",
            "nextDialogs": [
              "111030703"
            ]
          },
          "111030703": {
            "id": "111030703",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Leave the rest to me. You two get ready to greet him.",
            "nextDialogs": [
              "111030704"
            ]
          },
          "111030704": {
            "id": "111030704",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "Where is one... Huh? You two look familiar.",
            "nextDialogs": [
              "111030705"
            ]
          },
          "111030705": {
            "id": "111030705",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "What's with one's body? One feels... light. Weightless!",
            "nextDialogs": [
              "111030707",
              "111030710"
            ]
          },
          "111030707": {
            "id": "111030707",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "An adepti art? Hahaha! You dare don the guise of an adeptus in one's presence?",
            "nextDialogs": [
              "111030708"
            ]
          },
          "111030708": {
            "id": "111030708",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "But as for the matter of one's present location... One could have sworn that one was dozing off to sleep at Wangshu Inn not a moment ago...",
            "nextDialogs": [
              "111030712"
            ]
          },
          "111030712": {
            "id": "111030712",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "Wait... that must be it... of course it must! Haha, as expected of an adeptus such as oneself...",
            "nextDialogs": [
              "111030713"
            ]
          },
          "111030713": {
            "id": "111030713",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "One must indeed be in a dream!",
            "nextDialogs": [
              "111030714"
            ]
          },
          "111030714": {
            "id": "111030714",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, there's no helping this guy, is there?"
          },
          "111030710": {
            "id": "111030710",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "Dead!?",
            "nextDialogs": [
              "111030711"
            ]
          },
          "111030711": {
            "id": "111030711",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "Impossible! One was just lying in peaceful repose at Wangshu Inn..."
          }
        }
      }
    },
    {
      "subId": "1110308",
      "subQuestName": "Punish the false adeptus' spirit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1110309",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030901"
        ],
        "dialogs": {
          "111030901": {
            "id": "111030901",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "P—Please, stop! I surrender, I surrender! Argh...",
            "nextDialogs": [
              "111030903",
              "111030905"
            ]
          },
          "111030903": {
            "id": "111030903",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "Yes! Yes, I do! I thought I was going to die...",
            "nextDialogs": [
              "111030906"
            ]
          },
          "111030906": {
            "id": "111030906",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "How did I ever have the misfortune to meet you two...",
            "nextDialogs": [
              "111030907"
            ]
          },
          "111030907": {
            "id": "111030907",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "Please, great adepti, spare my life. I won't do this ever again, I swear it...",
            "nextDialogs": [
              "111030908"
            ]
          },
          "111030908": {
            "id": "111030908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We did call your spirit here, but we're not adepti. He, however, is.",
            "nextDialogs": [
              "111030909"
            ]
          },
          "111030909": {
            "id": "111030909",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "You deceive the masses with quackery, masquerade as an adeptus, exorcise demons without exterminating them, and display a callous lack of regard for life.",
            "nextDialogs": [
              "111030910"
            ]
          },
          "111030910": {
            "id": "111030910",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "One day, you will reap that which you have sown... For those who invite the infernal into their lives, there is no redemption!",
            "nextDialogs": [
              "111030911"
            ]
          },
          "111030911": {
            "id": "111030911",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "Ah... I... You're...",
            "nextDialogs": [
              "111030912"
            ]
          },
          "111030912": {
            "id": "111030912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like Xiao's got him scared stiff.",
            "nextDialogs": [
              "111030913"
            ]
          },
          "111030913": {
            "id": "111030913",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "O great adeptus... might I ask your name?"
          },
          "111030905": {
            "id": "111030905",
            "speakerId": 10203,
            "speakerName": "Starsnatcher",
            "text": "N—No, no, never again! Y—You almost killed me..."
          }
        }
      }
    },
    {
      "subId": "1110310",
      "subQuestName": "Go to Wangshu Inn and ask Verr Goldet about the false adeptus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111031001"
        ],
        "dialogs": {
          "111031001": {
            "id": "111031001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey there, Boss. Starsnatcher's staying here, right?",
            "nextDialogs": [
              "111031002"
            ]
          },
          "111031002": {
            "id": "111031002",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Starsnatcher... Hm... You mean the false adeptus who wore a mask?",
            "nextDialogs": [
              "111031003"
            ]
          },
          "111031003": {
            "id": "111031003",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "He signed in here under the name Wang Ping'an.",
            "nextDialogs": [
              "111031006"
            ]
          },
          "111031006": {
            "id": "111031006",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "He's already checked out. He said he wished to go on a solo pilgrimage...",
            "nextDialogs": [
              "111031007"
            ]
          },
          "111031007": {
            "id": "111031007",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Ah, yes. He also requested that I give this letter to a traveler who journeys together with a \"talking fairy\"... should they come asking for him.",
            "nextDialogs": [
              "111031008"
            ]
          },
          "111031008": {
            "id": "111031008",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Talking fairy... Who's that?",
            "nextDialogs": [
              "111031009"
            ]
          },
          "111031009": {
            "id": "111031009",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "...Well anyway, you must be the traveler. Here's the letter.",
            "nextDialogs": [
              "111031010"
            ]
          },
          "111031010": {
            "id": "111031010",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How strange that he would leave a letter for us. Is this the final attempt to fool us, maybe?",
            "nextDialogs": [
              "111031011"
            ]
          },
          "111031011": {
            "id": "111031011",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come on, open it! Paimon's curious!",
            "nextDialogs": [
              "111031019"
            ]
          },
          "111031019": {
            "id": "111031019",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "111031012"
            ]
          },
          "111031012": {
            "id": "111031012",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, seems like he actually left us a few nice trinkets...",
            "nextDialogs": [
              "111031013"
            ]
          },
          "111031013": {
            "id": "111031013",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Along with... Woohoo! The Sigil of Permission!",
            "nextDialogs": [
              "111031014"
            ]
          },
          "111031014": {
            "id": "111031014",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon hasn't met a bad guy like him in a long time..."
          }
        }
      }
    },
    {
      "subId": "1110311",
      "subQuestName": "Talk to Xiao and give him the Sigil of Permission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111031101"
        ],
        "dialogs": {
          "111031101": {
            "id": "111031101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah! There you are.",
            "nextDialogs": [
              "111031102"
            ]
          },
          "111031102": {
            "id": "111031102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We got the Sigil of Permission back. Do you wanna take it?",
            "nextDialogs": [
              "111031103"
            ]
          },
          "111031103": {
            "id": "111031103",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "You have my thanks.",
            "nextDialogs": [
              "111031104"
            ]
          },
          "111031104": {
            "id": "111031104",
            "speakerId": 2091,
            "speakerName": "Xiuhua",
            "text": "May I take your order, sir?",
            "nextDialogs": [
              "111031105"
            ]
          },
          "111031105": {
            "id": "111031105",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "One Grilled Ticker Fish.",
            "nextDialogs": [
              "111031106"
            ]
          },
          "111031106": {
            "id": "111031106",
            "speakerId": 2091,
            "speakerName": "Xiuhua",
            "text": "Certainly, we'll prepare it for you immediately!",
            "nextDialogs": [
              "111031107"
            ]
          },
          "111031107": {
            "id": "111031107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? No Almond Tofu this time? Well that's not like Xiao.",
            "nextDialogs": [
              "111031108"
            ]
          },
          "111031108": {
            "id": "111031108",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Ticker Fish was Pervases' favorite dish...",
            "nextDialogs": [
              "111031109"
            ]
          },
          "111031109": {
            "id": "111031109",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I just wanted to... see how it tastes.",
            "nextDialogs": [
              "111031110"
            ]
          },
          "111031110": {
            "id": "111031110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh...",
            "nextDialogs": [
              "111031111"
            ]
          },
          "111031111": {
            "id": "111031111",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "By wave and storm I hunt for fish, by wind and snow I slay evil...",
            "nextDialogs": [
              "111031112"
            ]
          },
          "111031112": {
            "id": "111031112",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...",
            "nextDialogs": [
              "111031113"
            ]
          },
          "111031113": {
            "id": "111031113",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Was there anything else? I... am accustomed to eating alone.",
            "nextDialogs": [
              "111031116"
            ]
          },
          "111031116": {
            "id": "111031116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh huh! And so, Detective Paimon and the trusty Traveler solved the case, and quietly slipped away..."
          }
        }
      }
    },
    {
      "subId": "1110320",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111032001"
        ],
        "dialogs": {
          "111032001": {
            "id": "111032001",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "Heh, nothing that you need concern yourself with. Please, take what you wish."
          }
        }
      }
    }
  ]
}
    {
      "subId": "1110303",
      "subQuestName": "Return to Pervases",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030301"
        ],
        "dialogs": {
          "111030301": {
            "id": "111030301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Where'd he go!? He was right here...",
            "nextDialogs": [
              "111030302"
            ]
          },
          "111030302": {
            "id": "111030302",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "I had presumed that once you had acquired what you came for, you would forget about me and simply be on your way...",
            "nextDialogs": [
              "111030330"
            ]
          },
          "111030330": {
            "id": "111030330",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah! It's that guy's voice! ...Hello? Wh—Where are you?",
            "nextDialogs": [
              "111030303"
            ]
          },
          "111030303": {
            "id": "111030303",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "My physical form ceased to exist over a thousand years ago. What you witnessed earlier was an illusion, created by the adepti art known as Mortal Lingering.",
            "nextDialogs": [
              "111030304"
            ]
          },
          "111030304": {
            "id": "111030304",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "Now that you have taken the Seven-Star Lamps and censer used in the Mortal Lingering ritual, my form is no longer visible to you.",
            "nextDialogs": [
              "111030308",
              "111030307"
            ]
          },
          "111030308": {
            "id": "111030308",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "I was once a junior in the order of the yakshas, bestowed with the name Pervases by Rex Lapis himself. Yet my strength failed, and I was slain in battle.",
            "nextDialogs": [
              "111030309"
            ]
          },
          "111030309": {
            "id": "111030309",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "Today is the anniversary of my death. My last wish was to see a modern Liyue, and so I took the liberty of performing this ritual here.",
            "nextDialogs": [
              "111030310"
            ]
          },
          "111030310": {
            "id": "111030310",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "That aside... You were sent here by the Conqueror of Demons, were you not?",
            "nextDialogs": [
              "111030311"
            ]
          },
          "111030311": {
            "id": "111030311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, you two know each other then?",
            "nextDialogs": [
              "111030312"
            ]
          },
          "111030312": {
            "id": "111030312",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "I sense his aura upon you... that, and the heavy burden of his karma.",
            "nextDialogs": [
              "111030313"
            ]
          },
          "111030313": {
            "id": "111030313",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "*sigh* Even after all these millennia, he still must endure such tremendous suffering?",
            "nextDialogs": [
              "111030314"
            ]
          },
          "111030314": {
            "id": "111030314",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "...I am truly ashamed.",
            "nextDialogs": [
              "111030315"
            ]
          },
          "111030315": {
            "id": "111030315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't say that, Pervases — you sacrificed your life for Liyue, didn't you?",
            "nextDialogs": [
              "111030316"
            ]
          },
          "111030316": {
            "id": "111030316",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "Life is a precious thing, yes... But when I think of the burden that the Conqueror of Demons must bear... *sigh* death seems to me to have been the easy way out. A selfish indulgence, even.",
            "nextDialogs": [
              "111030317"
            ]
          },
          "111030317": {
            "id": "111030317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Pervases...",
            "nextDialogs": [
              "111030318"
            ]
          },
          "111030318": {
            "id": "111030318",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "Haha, I apologize. Birthdays are joyful occasions, but by the same token, it is hard to not be melancholy on the anniversary of one's death.",
            "nextDialogs": [
              "111030319"
            ]
          },
          "111030319": {
            "id": "111030319",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "The Mortal Lingering will not last much longer. Take care, you two, and please pass on my regards to the Conqueror of Demons..."
          },
          "111030307": {
            "id": "111030307",
            "speakerId": 10221,
            "speakerName": "Statue",
            "text": "Haha... It is not untrue to say this. The line between adepti and ghosts is a fine one indeed."
          }
        }
      }
    },

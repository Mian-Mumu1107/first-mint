      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030201"
        ],
        "dialogs": {
          "111030201": {
            "id": "111030201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This censer... should be fine... right?",
            "nextDialogs": [
              "111030202"
            ]
          },
          "111030202": {
            "id": "111030202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "At least it isn't as run-down as this shrine.",
            "nextDialogs": [
              "111030203"
            ]
          },
          "111030203": {
            "id": "111030203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So next... we just need to grab the Seven-Star Lamps, right? The sooner we start, the sooner we'll be done."
          }
        }
      }

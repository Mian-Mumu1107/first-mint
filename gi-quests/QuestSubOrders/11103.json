    {
      "subId": "1110314",
      "subQuestName": "Talk to the protector of the shrine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030101"
        ],
        "dialogs": {
          "111030101": {
            "id": "111030101",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "The spirit soars the mountains high, while the body rests as the world goes by...",
            "nextDialogs": [
              "111030102"
            ]
          },
          "111030102": {
            "id": "111030102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... Sorry to interrupt you, but...",
            "nextDialogs": [
              "111030103"
            ]
          },
          "111030103": {
            "id": "111030103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'd like to borrow a censer and some lamps.",
            "nextDialogs": [
              "111030104"
            ]
          },
          "111030104": {
            "id": "111030104",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "Well I'll be... Isn't that something?",
            "nextDialogs": [
              "111030105"
            ]
          },
          "111030105": {
            "id": "111030105",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "A pair walk into a shrine, neither to seek nor worship gods or adepti, but to pilfer the tools of worship for their own ends. Hahaha...",
            "nextDialogs": [
              "111030106"
            ]
          },
          "111030106": {
            "id": "111030106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We know it's rude to ask, but we just need them for a short while — honest!",
            "nextDialogs": [
              "111030107"
            ]
          },
          "111030107": {
            "id": "111030107",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "For the Dream Trawler ritual, I trust?",
            "nextDialogs": [
              "111030108"
            ]
          },
          "111030108": {
            "id": "111030108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wha— How'd you know that?",
            "nextDialogs": [
              "111030109"
            ]
          },
          "111030109": {
            "id": "111030109",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "I have been in this shrine for far longer than you would expect.",
            "nextDialogs": [
              "111030110"
            ]
          },
          "111030110": {
            "id": "111030110",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "Perhaps as a reward for my faithfulness, I have been endowed with some understanding of the adepti arts.",
            "nextDialogs": [
              "111030111"
            ]
          },
          "111030111": {
            "id": "111030111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow. Paimon's never heard of that happening before.",
            "nextDialogs": [
              "111030112"
            ]
          },
          "111030112": {
            "id": "111030112",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "Ah, it matters not. Take what you need. It is a fortuitous thing that these items may be of service to you.",
            "nextDialogs": [
              "111030113"
            ]
          },
          "111030113": {
            "id": "111030113",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "...They served little purpose here, in any case.",
            "nextDialogs": [
              "111030115",
              "111030117"
            ]
          },
          "111030115": {
            "id": "111030115",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "Heh, nothing that you need concern yourself with. Please, take what you wish."
          },
          "111030117": {
            "id": "111030117",
            "speakerId": 10201,
            "speakerName": "Pervases",
            "text": "You are quite welcome. Please, take what you wish."
          }
        }
      }
    },

        "dialogs": {
          "411540301": {
            "id": "411540301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411540302"
            ]
          },
          "411540302": {
            "id": "411540302",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "A guest named Ling'guan ordered some Come And Get It from us, mentioning that it should be delivered to Jueyun Karst at a later time.",
            "nextDialogs": [
              "411540303"
            ]
          },
          "411540303": {
            "id": "411540303",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "As if Jueyun Karst was a border that ordinary mortals could trespass!",
            "nextDialogs": [
              "411540304"
            ]
          },
          "411540304": {
            "id": "411540304",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Ahem. Well, whatever the case, could you help us deliver this order to Jueyun Karst? Let's see if we can get it there in time."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7001701",
      "subQuestName": "Talk to the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700170101"
        ],
        "dialogs": {
          "700170101": {
            "id": "700170101",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "...Yaya dala?",
            "nextDialogs": [
              "700170102"
            ]
          },
          "700170102": {
            "id": "700170102",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Mimi tomo, mimi mosi mita, Muhe mita?",
            "nextDialogs": [
              "700170103"
            ]
          },
          "700170103": {
            "id": "700170103",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Mita...? Gusha... Dada odomu Plata mimi, mimi mosi gusha...",
            "nextDialogs": [
              "700170104"
            ]
          },
          "700170104": {
            "id": "700170104",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Mimi tomo, mimi plata odomu! Mimi mani ye!",
            "nextDialogs": [
              "700170105"
            ]
          },
          "700170105": {
            "id": "700170105",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Mani...? Dada! Kundala zido mi, mi dada, mimi tomo!",
            "nextDialogs": [
              "700170106"
            ]
          },
          "700170106": {
            "id": "700170106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ella is comforting that hilichurl...",
            "nextDialogs": [
              "700170109"
            ]
          },
          "700170109": {
            "id": "700170109",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "It was... bullied... by someone very nasty. We need to help it vent its anger. That's all it wants.",
            "nextDialogs": [
              "700170110"
            ]
          },
          "700170110": {
            "id": "700170110",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Dada!",
            "nextDialogs": [
              "700170111"
            ]
          },
          "700170111": {
            "id": "700170111",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Yeah!",
            "nextDialogs": [
              "700170112"
            ]
          },
          "700170112": {
            "id": "700170112",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah!",
            "nextDialogs": [
              "700170113"
            ]
          },
          "700170113": {
            "id": "700170113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Assuming no translation is needed for that...",
            "nextDialogs": [
              "700170114"
            ]
          },
          "700170114": {
            "id": "700170114",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Okay then, the location is marked on your Map — I'll leave the next part to you!",
            "nextDialogs": [
              "700170115"
            ]
          },
          "700170115": {
            "id": "700170115",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Dada, Valo!"
          }
        }
      }
    },
    {
      "subId": "7001702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700170201"
        ],
        "dialogs": {
          "700170201": {
            "id": "700170201",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Yeye dada! Mosi mita!",
            "nextDialogs": [
              "700170202"
            ]
          },
          "700170202": {
            "id": "700170202",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Du Wei zido dala? Mi mito nye.",
            "nextDialogs": [
              "700170203"
            ]
          },
          "700170203": {
            "id": "700170203",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Huh, that's strange — this one claims to know nothing about it!",
            "nextDialogs": [
              "700170204"
            ]
          },
          "700170204": {
            "id": "700170204",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Mi mito du, du ya mito Wei.",
            "nextDialogs": [
              "700170205"
            ]
          },
          "700170205": {
            "id": "700170205",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "And now it's pointing to the Map, saying that someone it knows over here may have seen the Unusual Hilichurl before.",
            "nextDialogs": [
              "700170206"
            ]
          },
          "700170206": {
            "id": "700170206",
            "speakerId": 1000,
            "speakerName": "Vacant Hilichurl",
            "text": "Valo, mimi tomo!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "4006201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400471301"
        ],
        "dialogs": {
          "400471301": {
            "id": "400471301",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "So, how's it going? Have you made a decision?",
            "nextDialogs": [
              "400471302"
            ]
          },
          "400471302": {
            "id": "400471302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yep. Let's team up to tackle the darkness.",
            "nextDialogs": [
              "400471303"
            ]
          },
          "400471303": {
            "id": "400471303",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "Okay. Then, take this.",
            "nextDialogs": [
              "400471304"
            ]
          },
          "400471304": {
            "id": "400471304",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "It's called the Bokuso Box. I found it in the Dainichi Mikoshi when I was looking for a solution.",
            "nextDialogs": [
              "400471305"
            ]
          },
          "400471305": {
            "id": "400471305",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "Actually, the Dainichi Mikoshi was where I found the method and tools for the Sentou Ceremony. Lucky I can read human writing.",
            "nextDialogs": [
              "400471306"
            ]
          },
          "400471306": {
            "id": "400471306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Uhh, why wouldn't you be able to? Or did you mean it's lucky that you can read the ancient Enkanomiyan script?",
            "nextDialogs": [
              "400471307"
            ]
          },
          "400471307": {
            "id": "400471307",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "Oh, uh, nothing. I just meant the script in the Deep-Sea Healing Arts Compendium. I don't actually know if it's ancient or modern.",
            "nextDialogs": [
              "400471308"
            ]
          },
          "400471308": {
            "id": "400471308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm getting more confused the more you try to explain.",
            "nextDialogs": [
              "400471309"
            ]
          },
          "400471309": {
            "id": "400471309",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "Never mind all that. Let's get back to business.",
            "nextDialogs": [
              "400471310"
            ]
          },
          "400471310": {
            "id": "400471310",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "The Bokuso Box collects light. It can dispel the darkness from the Void within a small radius.",
            "nextDialogs": [
              "400471311"
            ]
          },
          "400471311": {
            "id": "400471311",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "So for example, with the power of the Bokuso Box, you can turn monsters affected by the darkness back into their original forms.",
            "nextDialogs": [
              "400471312"
            ]
          },
          "400471312": {
            "id": "400471312",
            "speakerId": 1000,
            "speakerName": "Tsumi",
            "text": "As it happens, there are some monsters causing trouble around the camp. Go and try out the Bokuso Box on them. I will join you shortly."
          }
        }
      }
    }
  ]
}
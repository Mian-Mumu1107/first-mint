    {
      "subId": "2502203",
      "subQuestName": "Talk to Cazcal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250221201"
        ],
        "dialogs": {
          "250221201": {
            "id": "250221201",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Ah, yes! Please, take these for your trouble.",
            "nextDialogs": [
              "250221202"
            ]
          },
          "250221202": {
            "id": "250221202",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Thanks to your help, I'm positive I'll be able to come up with the best recipe for Hora.",
            "nextDialogs": [
              "250221203"
            ]
          },
          "250221203": {
            "id": "250221203",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Hora, start eating properly again, alright? That's how you'll grow into a big, strong Tepetlisaurus!",
            "nextDialogs": [
              "250221204"
            ]
          },
          "250221204": {
            "id": "250221204",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "Rrooh, oroooo! Rrroooh!"
          }
        }
      }
    },

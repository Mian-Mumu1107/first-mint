  "subQuests": [
    {
      "subId": "2502201",
      "subQuestName": "Talk to Cazcal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220101"
        ],
        "dialogs": {
          "250220101": {
            "id": "250220101",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Hmm... Looks like we'll need to try a different recipe...",
            "nextDialogs": [
              "250220102"
            ]
          },
          "250220102": {
            "id": "250220102",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "Oroooo! Rrroooo!",
            "nextDialogs": [
              "250220106",
              "250220105"
            ]
          },
          "250220106": {
            "id": "250220106",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "R—Roar!",
            "nextDialogs": [
              "250220107"
            ]
          },
          "250220107": {
            "id": "250220107",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Normally Hora can finish a whole bowl of fruit, and once he's done, he'll go on playing all day long.",
            "nextDialogs": [
              "250220108"
            ]
          },
          "250220108": {
            "id": "250220108",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "But now, he only eats half a bowl, then he just sits there not moving a muscle...",
            "nextDialogs": [
              "250220109"
            ]
          },
          "250220109": {
            "id": "250220109",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "I was so worried he might be ill that I went to find a vet in the middle of the night to ask his advice.",
            "nextDialogs": [
              "250220110"
            ]
          },
          "250220110": {
            "id": "250220110",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "The two of us spent the entire night trying to figure out what was wrong with him, only to realize he wasn't ill at all, just... a very picky eater.",
            "nextDialogs": [
              "250220111"
            ]
          },
          "250220111": {
            "id": "250220111",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "The vet said that the best solution would be to find a new recipe.",
            "nextDialogs": [
              "250220112"
            ]
          },
          "250220112": {
            "id": "250220112",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "He also said that I could try playing some music for Hora during mealtimes, that it might stimulate his appetite..."
          },
          "250220105": {
            "id": "250220105",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "R—Roar!"
          }
        }
      }
    },
    {
      "subId": "2502202",

    {
      "subId": "2502203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220301"
        ],
        "dialogs": {
          "250220301": {
            "id": "250220301",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Now that's a pretty flower. Nice-sounding name, too... Hora, fancy a bite?",
            "nextDialogs": [
              "250220304"
            ]
          },
          "250220304": {
            "id": "250220304",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "Wroo, rrooh!",
            "nextDialogs": [
              "250220305"
            ]
          },
          "250220305": {
            "id": "250220305",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "(Hora chews it carefully, as if savoring the flavor of the petals.)",
            "nextDialogs": [
              "250220306"
            ]
          },
          "250220306": {
            "id": "250220306",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "R—Roar...",
            "nextDialogs": [
              "250220307"
            ]
          },
          "250220307": {
            "id": "250220307",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Oh! From the way he looks, I'd say he likes it a lot. But flowers on their own won't be enough to fill him up...",
            "nextDialogs": [
              "250220308"
            ]
          },
          "250220308": {
            "id": "250220308",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Plus, this type of flower sure doesn't look cheap... Anyway, I'll just go ahead and write it down for now.",
            "nextDialogs": [
              "250220309"
            ]
          },
          "250220309": {
            "id": "250220309",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "How do you make flowers into food? Oh, maybe we can... mix them into some kind of cake?"
          }
        }
      }
    },
    {
      "subId": "2502204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220401"
        ],
        "dialogs": {
          "250220401": {
            "id": "250220401",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Whoa, that's one big fruit! It should be enough to fill him up, from the look of it. Fancy a go at it, Hora?",
            "nextDialogs": [
              "250220404"
            ]
          },
          "250220404": {
            "id": "250220404",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "Wroo, rrooh!",
            "nextDialogs": [
              "250220405"
            ]
          },
          "250220405": {
            "id": "250220405",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "(Hora starts chomping away, and before long it's all gone.)",
            "nextDialogs": [
              "250220406"
            ]
          },
          "250220406": {
            "id": "250220406",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "Oroooo! Rrroooo!",
            "nextDialogs": [
              "250220407"
            ]
          },
          "250220407": {
            "id": "250220407",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Hahaha, gone in a flash. You must have liked that a lot, huh, kiddo?",
            "nextDialogs": [
              "250220408"
            ]
          },
          "250220408": {
            "id": "250220408",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "Wroo, rrooh! Hroooo—",
            "nextDialogs": [
              "250220409"
            ]
          },
          "250220409": {
            "id": "250220409",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Great! I'll go find someone to ask in a bit, see if anyone knows where to find Inazuman merchants. I need to get my hands on more Lavender Melons..."
          }
        }
      }
    },
    {
      "subId": "2502205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220501"
        ],
        "dialogs": {
          "250220501": {
            "id": "250220501",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "This one smells pretty good. Real refreshing aroma...",
            "nextDialogs": [
              "250220504"
            ]
          },
          "250220504": {
            "id": "250220504",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Hora? You... Well, would you look at that! He's only gone and eaten it whole!",
            "nextDialogs": [
              "250220505"
            ]
          },
          "250220505": {
            "id": "250220505",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "(Hora swallows the Qingxin in a single gulp, then blinks at you...)",
            "nextDialogs": [
              "250220506"
            ]
          },
          "250220506": {
            "id": "250220506",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Hora suddenly turns around and eats up the half bowl of fruit next to him, all in one go...",
            "nextDialogs": [
              "250220507"
            ]
          },
          "250220507": {
            "id": "250220507",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Hora's appetite seems to have returned all of a sudden... How did that happen? Was it really all thanks to this Qingxin thingamajig?",
            "nextDialogs": [
              "250220508"
            ]
          },
          "250220508": {
            "id": "250220508",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "I—I have to talk to the vet about this..."
          }
        }
      }
    },
    {
      "subId": "2502206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

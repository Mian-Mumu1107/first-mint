    {
      "subId": "2004302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430201"
        ],
        "dialogs": {
          "200430201": {
            "id": "200430201",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "My back hurts so much... I hope I'll recover after a short rest..."
          }
        }
      }
    },
    {
      "subId": "2004304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430401"
        ],
        "dialogs": {
          "200430401": {
            "id": "200430401",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Did you find me some <color=#00E1FFFF>sunsettias</color>?",
            "nextDialogs": [
              "200430402"
            ]
          },
          "200430402": {
            "id": "200430402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "200430403"
            ]
          },
          "200430403": {
            "id": "200430403",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "There should be plenty of <color=#00E1FFFF>sunsettias</color> just outside the city. Please, I need to stay here — can you run and grab some quickly?"
          }
        }
      }
    },
    {
      "subId": "2004307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430701"
        ],
        "dialogs": {
          "200430701": {
            "id": "200430701",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Oh no..."
          }
        }
      }
    },
    {
      "subId": "2004309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430901"
        ],
        "dialogs": {
          "200430901": {
            "id": "200430901",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Thank you for your help. *sigh* Next time I need to get more people on board. Maybe Beatrice? Nah..."
          }
        }
      }
    },
    {
      "subId": "2004310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200431001"
        ],
        "dialogs": {
          "200431001": {
            "id": "200431001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hahaha... Well, on the bright side, at least we got some exercise..."
          }
        }
      }
    }
  ]
}
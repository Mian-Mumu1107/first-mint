  "subQuests": [
    {
      "subId": "2004301",
      "subQuestName": "Talk to Michelle",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430101"
        ],
        "dialogs": {
          "200430101": {
            "id": "200430101",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "Ow, my back...",
            "nextDialogs": [
              "200430102"
            ]
          },
          "200430102": {
            "id": "200430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you okay?",
            "nextDialogs": [
              "200430103"
            ]
          },
          "200430103": {
            "id": "200430103",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "I was just getting ready for work, but then all of a sudden my back started hurting.",
            "nextDialogs": [
              "200430104"
            ]
          },
          "200430104": {
            "id": "200430104",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "I promised Quinn I would go and help out at his fruit stand today, but I think it's best if I rest here for a while first...",
            "nextDialogs": [
              "200430105"
            ]
          },
          "200430105": {
            "id": "200430105",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "But I can't just stay here and hold everything up.",
            "nextDialogs": [
              "200430106"
            ]
          },
          "200430106": {
            "id": "200430106",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "Could you go and ask Quinn what he needs me to do? That will help me get prepared.",
            "nextDialogs": [
              "200430108",
              "200430110"
            ]
          },
          "200430108": {
            "id": "200430108",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "Thank you. I should be fine after a short rest."
          },
          "200430110": {
            "id": "200430110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come on, is this really so much to ask? Help me out here."
          }
        }
      }
    },
    {
      "subId": "2004306",
      "subQuestName": "Trigger conversation with Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430601"
        ],
        "dialogs": {
          "200430601": {
            "id": "200430601",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "Have you spoken to Quinn?",
            "nextDialogs": [
              "200430602"
            ]
          },
          "200430602": {
            "id": "200430602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes. He says you should get some rest.",
            "nextDialogs": [
              "200430603"
            ]
          },
          "200430603": {
            "id": "200430603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing to do at Quinn's today anyway, go home and rest up.",
            "nextDialogs": [
              "200430604"
            ]
          },
          "200430604": {
            "id": "200430604",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "Really... *sigh* Looks like I should find something else to do...",
            "nextDialogs": [
              "200430605"
            ]
          },
          "200430605": {
            "id": "200430605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? You're not going to take a sick day!? Take the chance while it's there!",
            "nextDialogs": [
              "200430606"
            ]
          },
          "200430606": {
            "id": "200430606",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "Stop and feel what is happening all around you. That's Lord Barbatos' winds, still hard at work.",
            "nextDialogs": [
              "200430607"
            ]
          },
          "200430607": {
            "id": "200430607",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "We are blessed by Barbatos. It is not a privilege we should take lightly — we all need to do our part.",
            "nextDialogs": [
              "200430608"
            ]
          },
          "200430608": {
            "id": "200430608",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "As for your part... What have you been doing? Why are you sweating so much?",
            "nextDialogs": [
              "200430609"
            ]
          },
          "200430609": {
            "id": "200430609",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "It seems that you are very busy yourself. But this is not a bad thing, for the more we toil, the more we sweat, and the more keenly we feel the winds of Barbatos.",
            "nextDialogs": [
              "200430610"
            ]
          },
          "200430610": {
            "id": "200430610",
            "speakerId": 1421,
            "speakerName": "Michelle",
            "text": "Here, have this bottle of milk. Drink up and get back to it, for there is no shortage of work to be done in this world."
          }
        }
      }
    },
    {
      "subId": "2004307",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430801"
        ],
        "dialogs": {
          "200430801": {
            "id": "200430801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa... This looks like really tough work.",
            "nextDialogs": [
              "200430802"
            ]
          },
          "200430802": {
            "id": "200430802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Michelle has enough on her plate already. Let's help Quinn finish the job off ourselves.",
            "nextDialogs": [
              "200430803"
            ]
          },
          "200430803": {
            "id": "200430803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And then let's beg him to give Michelle something that's a bit more manageable...",
            "nextDialogs": [
              "200430804"
            ]
          },
          "200430804": {
            "id": "200430804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hopefully Michelle won't mind us stepping in on her behalf like this."
          }
        }
      }
    },
    {
      "subId": "2004302",
      "subQuestName": "Talk to Quinn",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430301"
        ],
        "dialogs": {
          "200430301": {
            "id": "200430301",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Where is my delivery? This is ridiculous...",
            "nextDialogs": [
              "200430302"
            ]
          },
          "200430302": {
            "id": "200430302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's happened?",
            "nextDialogs": [
              "200430303"
            ]
          },
          "200430303": {
            "id": "200430303",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "*sigh* My fruit stall is all out of sunsettias. I ordered several batches a while ago...",
            "nextDialogs": [
              "200430304"
            ]
          },
          "200430304": {
            "id": "200430304",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "But they still haven't arrived. And my customers won't wait forever.",
            "nextDialogs": [
              "200430305"
            ]
          },
          "200430305": {
            "id": "200430305",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Eury alone has come by three times already, and all she wants is <color=#00E1FFFF>three sunsettias</color>. She's been a regular customer for a long time, and now I'm afraid I might lose her!",
            "nextDialogs": [
              "200430306"
            ]
          },
          "200430306": {
            "id": "200430306",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "I need to stay at the stall... If only someone could go and pick a few wild sunsettias for me.",
            "nextDialogs": [
              "200430308",
              "200430310"
            ]
          },
          "200430308": {
            "id": "200430308",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Really? That's amazing! Thank you so much."
          },
          "200430310": {
            "id": "200430310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hang on! What is Michelle doing picking fruit in her condition!?",
            "nextDialogs": [
              "200430311"
            ]
          },
          "200430311": {
            "id": "200430311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We can help!"
          }
        }
      }
    },
    {
      "subId": "2004303",
      "subQuestName": "Collect Sunsettia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2004304",
      "subQuestName": "Give the Sunsettia to Quinn",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200430501"
        ],
        "dialogs": {
          "200430501": {
            "id": "200430501",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Have you found me some sunsettias yet?",
            "nextDialogs": [
              "200430502"
            ]
          },
          "200430502": {
            "id": "200430502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got them right here.",
            "nextDialogs": [
              "200430503"
            ]
          },
          "200430503": {
            "id": "200430503",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Great. That should be enough for Miss Eury.",
            "nextDialogs": [
              "200430504"
            ]
          },
          "200430504": {
            "id": "200430504",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "*sigh* But it looks like most of my customers have gone now. This isn't a one-person job, it seems.",
            "nextDialogs": [
              "200430505"
            ]
          },
          "200430505": {
            "id": "200430505",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Oh— I should give you something for your trouble. Hang on...",
            "nextDialogs": [
              "200430506"
            ]
          },
          "200430506": {
            "id": "200430506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There is no need for gifts. But we do have a request for you.",
            "nextDialogs": [
              "200430507"
            ]
          },
          "200430507": {
            "id": "200430507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's about Michelle.",
            "nextDialogs": [
              "200430508"
            ]
          },
          "200430508": {
            "id": "200430508",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Michelle? You've seen her?",
            "nextDialogs": [
              "200430509"
            ]
          },
          "200430509": {
            "id": "200430509",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "I should give her a less taxing job?",
            "nextDialogs": [
              "200430510"
            ]
          },
          "200430510": {
            "id": "200430510",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "All I ever asked is that she watch the fruit stand for me.",
            "nextDialogs": [
              "200430511"
            ]
          },
          "200430511": {
            "id": "200430511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh. Is that true?",
            "nextDialogs": [
              "200430512"
            ]
          },
          "200430512": {
            "id": "200430512",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "But with no more customers, it looks like I won't even need her to do that...",
            "nextDialogs": [
              "200430513"
            ]
          },
          "200430513": {
            "id": "200430513",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Please tell her to go home and rest for me.",
            "nextDialogs": [
              "200430514"
            ]
          },
          "200430514": {
            "id": "200430514",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "I'll go and chase up that delivery in a moment."
          }
        }
      }
    },
    {
      "subId": "2004305",

  "subQuests": [
    {
      "subId": "4005201",
      "subQuestName": "Talk to Tsuyuko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721430101"
        ],
        "dialogs": {
          "721430101": {
            "id": "721430101",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "Hello, guests from afar. My name is Tsuyuko, and I am a shrine maiden at the Sangonomiya Shrine. Are you here to help?",
            "nextDialogs": [
              "721430102"
            ]
          },
          "721430102": {
            "id": "721430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Help...?",
            "nextDialogs": [
              "721430103"
            ]
          },
          "721430103": {
            "id": "721430103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We've only just met! What does she mean, \"help\"?",
            "nextDialogs": [
              "721430104"
            ]
          },
          "721430104": {
            "id": "721430104",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "Haha, sorry for being rude...",
            "nextDialogs": [
              "721430105"
            ]
          },
          "721430105": {
            "id": "721430105",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "It's just that I made a wish previously, and according to the divination result, there will always be help on the way whenever I am troubled or having a hard time.",
            "nextDialogs": [
              "721430106"
            ]
          },
          "721430106": {
            "id": "721430106",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "So you, O helpful guests, must be here to assist me, right?",
            "nextDialogs": [
              "721430108",
              "721430110"
            ]
          },
          "721430108": {
            "id": "721430108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, whatever, let's just hear what she has to say first...",
            "nextDialogs": [
              "721430111"
            ]
          },
          "721430111": {
            "id": "721430111",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "Thank you so much, then. Let me give you the backstory.",
            "nextDialogs": [
              "721430112"
            ]
          },
          "721430112": {
            "id": "721430112",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "The deep pool directly across from the Sangonomiya Shrine is the entrance to Enkanomiya. Legend has it that this place was the origin of the Watatsumi people.",
            "nextDialogs": [
              "721430113"
            ]
          },
          "721430113": {
            "id": "721430113",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "In days of old, the beauties of Watatsumi were renowned for their soft skin, which would conceal seven types of skin blemish...",
            "nextDialogs": [
              "721430114"
            ]
          },
          "721430114": {
            "id": "721430114",
            "speakerId": 3193,
            "speakerName": "Tsuyuko",
            "text": "...This, of course, being mostly a consequence of our ancestors' lack of sunlight in the depths of Enkanomiya..."
          },
          "721430110": {
            "id": "721430110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How is this any way to ask for help..."
          }
        }
      }
    }
  ]
}
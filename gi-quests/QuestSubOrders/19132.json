    {
      "subId": "1913203",
      "subQuestName": "Look for Lanyang to get the tailored clothes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191320401"
        ],
        "dialogs": {
          "191320401": {
            "id": "191320401",
            "speakerId": 12310,
            "speakerName": "Lanyang",
            "text": "Hello, how may I help?",
            "nextDialogs": [
              "191320402"
            ]
          },
          "191320402": {
            "id": "191320402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm here to fetch a change of clothes for Ningguang.",
            "nextDialogs": [
              "191320403"
            ]
          },
          "191320403": {
            "id": "191320403",
            "speakerId": 12310,
            "speakerName": "Lanyang",
            "text": "Ah yes, of course. Please wait a moment, I'll go and get them.",
            "nextDialogs": [
              "191320404"
            ]
          },
          "191320404": {
            "id": "191320404",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "After a long wait, Lanyang finally returns.",
            "nextDialogs": [
              "191320405"
            ]
          },
          "191320405": {
            "id": "191320405",
            "speakerId": 12310,
            "speakerName": "Lanyang",
            "text": "Here you are. Please give this to Lady Ningguang.",
            "nextDialogs": [
              "191320406"
            ]
          },
          "191320406": {
            "id": "191320406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That seemed to take you a while.",
            "nextDialogs": [
              "191320407"
            ]
          },
          "191320407": {
            "id": "191320407",
            "speakerId": 12310,
            "speakerName": "Lanyang",
            "text": "Yes, this whole room is full of Lady Ningguang's personal items. Not just clothes, either — there are all kinds of jewelry and ornaments...",
            "nextDialogs": [
              "191320408"
            ]
          },
          "191320408": {
            "id": "191320408",
            "speakerId": 12310,
            "speakerName": "Lanyang",
            "text": "Lady Ningguang asked us to rearrange this room recently. We're currently right in the middle of that, so everything's in a bit of a mess. That's why it took me a little time to find this for you.",
            "nextDialogs": [
              "191320411"
            ]
          },
          "191320411": {
            "id": "191320411",
            "speakerId": 12310,
            "speakerName": "Lanyang",
            "text": "Anyway, you can take it now. Thanks for coming to pick it up."
          }
        }
      }
    },

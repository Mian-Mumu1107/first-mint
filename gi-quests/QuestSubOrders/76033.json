    {
      "subId": "7603308",
      "subQuestName": "Talk to the food-obsessed phantom",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330401"
        ],
        "dialogs": {
          "760330401": {
            "id": "760330401",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "The chicken's flavorful, and there are sufficient side dishes. You tryin' to make it tough for me to nitpick, huh?",
            "nextDialogs": [
              "760330402"
            ]
          },
          "760330402": {
            "id": "760330402",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "...Heh. Whatever. Not that I was ever looking to find fault with you newbies specifically.",
            "nextDialogs": [
              "760330403"
            ]
          },
          "760330403": {
            "id": "760330403",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "I'm just a chef. I just do my job, and I want to do it well.",
            "nextDialogs": [
              "760330404"
            ]
          },
          "760330404": {
            "id": "760330404",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "And to that end, I made all kinds of preparations for the Wild Hunt's arrival.",
            "nextDialogs": [
              "760330405"
            ]
          },
          "760330405": {
            "id": "760330405",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "But it's a pity... I couldn't send them the finished dishes in time... The food wound up spilled... spilled..."
          }
        }
      }
    },
    {
      "subId": "7603399",

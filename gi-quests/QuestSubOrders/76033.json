  "subQuests": [
    {
      "subId": "7603301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330101"
        ],
        "dialogs": {
          "760330101": {
            "id": "760330101",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Hey, newbie. You can't be making food like that.",
            "nextDialogs": [
              "760330102"
            ]
          },
          "760330102": {
            "id": "760330102",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "We're making rations for the Ratniki on the island, so we've gotta cook it to their tastes.",
            "nextDialogs": [
              "760330103"
            ]
          },
          "760330103": {
            "id": "760330103",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "These dishes won't do at all. First, your heat control's terrible, and second, this stuff doesn't suit our diet. That's gotta change.",
            "nextDialogs": [
              "760330104"
            ]
          },
          "760330104": {
            "id": "760330104",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "You've still got a lot to learn — I suggest starting from our most basic dishes, like Nod-Krai Hot Dogs. Come back and show me once you're done."
          }
        }
      }
    },
    {
      "subId": "7603303",
      "subQuestName": "Use the peculiar cooking pot near the lighthouse to make a Nod-Krai Hot Dog",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330301"
        ],
        "dialogs": {
          "760330301": {
            "id": "760330301",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Mm. The meat's been sliced into sizable chunks, then fried perfectly after that. Not bad.",
            "nextDialogs": [
              "760330302"
            ]
          },
          "760330302": {
            "id": "760330302",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "But let me remind you. When making fried meat, you must consider your side dishes.",
            "nextDialogs": [
              "760330303"
            ]
          },
          "760330303": {
            "id": "760330303",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "It's easy to get stuffed from eating too much meat. That's why the berries are there.",
            "nextDialogs": [
              "760330304"
            ]
          },
          "760330304": {
            "id": "760330304",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Here on this island, we're in charge of everyone's dietary health, so a balance must be struck between vegetables and meat.",
            "nextDialogs": [
              "760330305"
            ]
          },
          "760330305": {
            "id": "760330305",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "This dish doesn't have enough such veggies on the side. We can't have that here.",
            "nextDialogs": [
              "760330306"
            ]
          },
          "760330306": {
            "id": "760330306",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "You need to practice more. Come back next time and whip up some Lakkaberry Madame."
          }
        }
      }
    },
    {
      "subId": "7603304",
      "subQuestName": "Talk to the food-obsessed phantom",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760330201"
        ],
        "dialogs": {
          "760330201": {
            "id": "760330201",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Mmm, the sausage is nicely grilled.",
            "nextDialogs": [
              "760330202"
            ]
          },
          "760330202": {
            "id": "760330202",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "You'd make a half-decent sous chef if you were working in a restaurant outside, I'd say.",
            "nextDialogs": [
              "760330203"
            ]
          },
          "760330203": {
            "id": "760330203",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "But we're making meals for every Ratnik on this island. So it's not about how fancy the food is, but whether it's plentiful enough.",
            "nextDialogs": [
              "760330204"
            ]
          },
          "760330204": {
            "id": "760330204",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Make the bread thicker. There's not a ton of vegetables right now, and you could also add some meats apart from sausages.",
            "nextDialogs": [
              "760330205"
            ]
          },
          "760330205": {
            "id": "760330205",
            "speakerId": 1000,
            "speakerName": "Food-Obsessed Phantom",
            "text": "You still need more practice! Come back next time and make some Berries and Fried Meat."
          }
        }
      }
    },

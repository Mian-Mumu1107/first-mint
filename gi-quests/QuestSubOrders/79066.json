  "subQuests": [
    {
      "subId": "7906601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790660101"
        ],
        "dialogs": {
          "790660101": {
            "id": "790660101",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Your Highness! What brings you here?",
            "nextDialogs": [
              "790660102"
            ]
          },
          "790660102": {
            "id": "790660102",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...Given how things stand, I shall retrieve the <color=#00E1FFFF>relic</color> myself, and then decide what to do next.",
            "nextDialogs": [
              "790660103"
            ]
          },
          "790660103": {
            "id": "790660103",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Your Highness! That will not do!",
            "nextDialogs": [
              "790660104"
            ]
          },
          "790660104": {
            "id": "790660104",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Your Highness! You cannot go!",
            "nextDialogs": [
              "790660105"
            ]
          },
          "790660105": {
            "id": "790660105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh? It seems you have a better solution. Let's hear it then, Minister Saborn.",
            "nextDialogs": [
              "790660106"
            ]
          },
          "790660106": {
            "id": "790660106",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "I... Uh... Would like to inform Your Highness that, following a long discussion with Souffache last night, we have come to the conclusion that... It would be better to set up a trial ground elsewhere...",
            "nextDialogs": [
              "790660107"
            ]
          },
          "790660107": {
            "id": "790660107",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "Hear, hear! And then the Guardian who passes our selection process can retrieve the relic for us — two birds, one stone!",
            "nextDialogs": [
              "790660108"
            ]
          },
          "790660108": {
            "id": "790660108",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "But without the relic, how can we be sure that the chosen Guardian is really the one we are looking for?",
            "nextDialogs": [
              "790660109"
            ]
          },
          "790660109": {
            "id": "790660109",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "I... Uh...",
            "nextDialogs": [
              "790660110"
            ]
          },
          "790660110": {
            "id": "790660110",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Worry not, ministers. Though we are indeed facing a great crisis, this is precisely as the legends predicted.",
            "nextDialogs": [
              "790660111"
            ]
          },
          "790660111": {
            "id": "790660111",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "When the crisis befalls us, a Guardian shall thereupon emerge. At this moment, what I must do is ensure that they are shown the right path.",
            "nextDialogs": [
              "790660112"
            ]
          },
          "790660112": {
            "id": "790660112",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Besides, I am the best flyer in the kingdom, so there is none more suitable than I to judge the Guardian's abilities.",
            "nextDialogs": [
              "790660113"
            ]
          },
          "790660113": {
            "id": "790660113",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "But...",
            "nextDialogs": [
              "790660114"
            ]
          },
          "790660114": {
            "id": "790660114",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Then will you go instead?",
            "nextDialogs": [
              "790660115"
            ]
          },
          "790660115": {
            "id": "790660115",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "I—I'm afraid... My legs are rather useless when it comes to flight of any kind...",
            "nextDialogs": [
              "790660116"
            ]
          },
          "790660116": {
            "id": "790660116",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "How about you, Saborn? Will you go?",
            "nextDialogs": [
              "790660117"
            ]
          },
          "790660117": {
            "id": "790660117",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "Uhh, m—my eyesight... Alas, I fear I would be unable to see their movements clearly enough to judge...",
            "nextDialogs": [
              "790660118"
            ]
          },
          "790660118": {
            "id": "790660118",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Good, that's settled then. The two of you will stay to handle affairs within the kingdom, while I shall assist in managing the selection process at the original location myself.",
            "nextDialogs": [
              "790660122",
              "790660121"
            ]
          },
          "790660122": {
            "id": "790660122",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Oh, greetings to both of you, and welcome to the Kingdom of Breezes and Bells. You're very welcome to sign up for the \"Guardian of the Kingdom\" selection trials.",
            "nextDialogs": [
              "790660123"
            ]
          },
          "790660123": {
            "id": "790660123",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "You have not previously participated in the selection trials of our Kingdom of Breezes and Bells, if I am not mistaken?",
            "nextDialogs": [
              "790660124"
            ]
          },
          "790660124": {
            "id": "790660124",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How does Your Highness know this?",
            "nextDialogs": [
              "790660125"
            ]
          },
          "790660125": {
            "id": "790660125",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Your appearance differs greatly from our kingdom's subjects. Had you taken part before, I would not forget it.",
            "nextDialogs": [
              "790660126"
            ]
          },
          "790660126": {
            "id": "790660126",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Oh! That's enough chit-chat, I suppose. As it so happens, I was just about to head over to host the selection ceremony near the Relic Shrine. Let us go there together.",
            "nextDialogs": [
              "790660127"
            ]
          },
          "790660127": {
            "id": "790660127",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Ministers, the kingdom's affairs are in your hands. Do try not to let anyone cut this tree down while I'm away finding our true Guardian, if you could?",
            "nextDialogs": [
              "790660128"
            ]
          },
          "790660128": {
            "id": "790660128",
            "speakerId": 1005,
            "speakerName": "Saborn & Souffache",
            "text": "*sigh* As you wish, Your Highness.",
            "nextDialogs": [
              "790660129"
            ]
          },
          "790660129": {
            "id": "790660129",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "The two of you, please come with me. Before the selection officially begins, there are a few things I still need to tell you."
          },
          "790660121": {
            "id": "790660121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, ooh! We're good at flying, and adventuring too! Can we participate?"
          }
        }
      }
    },
    {
      "subId": "7906605",
      "subQuestName": "Talk to Princess Cimest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790660501"
        ],
        "dialogs": {
          "790660501": {
            "id": "790660501",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Please wait here a moment. I will introduce the trial for you, as well as a few things that you'll need to watch out for.",
            "nextDialogs": [
              "790660502"
            ]
          },
          "790660502": {
            "id": "790660502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow... Her Highness sure is a decisive decision-maker, huh? Guess that's a true princess for you...",
            "nextDialogs": [
              "790660505"
            ]
          },
          "790660505": {
            "id": "790660505",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Hmm? Oh... Perhaps my introduction seemed a little too forthcoming. My apologies.",
            "nextDialogs": [
              "790660506"
            ]
          },
          "790660506": {
            "id": "790660506",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "In truth, there have been many squirrels who — like you — have suddenly turned up and declared their intention to undergo the trial, so I am already accustomed to receiving such \"candidates.\"",
            "nextDialogs": [
              "790660507"
            ]
          },
          "790660507": {
            "id": "790660507",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "At least... There were many, before that dragon attacked the kingdom."
          }
        }
      }
    },
    {
      "subId": "7906606",
      "subQuestName": "Accept Princess Cimest's trial",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790660601"
        ],
        "dialogs": {
          "790660601": {
            "id": "790660601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Your Highness, you're amazing! You flew past so easily!",
            "nextDialogs": [
              "790660602"
            ]
          },
          "790660602": {
            "id": "790660602",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Your ability to judge the wind's currents was also remarkable. It seems you are worthy to undergo the trial after all.",
            "nextDialogs": [
              "790660603"
            ]
          },
          "790660603": {
            "id": "790660603",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Let us make haste to the site where the relic is being kept... Hopefully we won't have another run-in with that dragon.",
            "nextDialogs": [
              "790660604"
            ]
          },
          "790660604": {
            "id": "790660604",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"...I am a voice, but not life...\"",
            "nextDialogs": [
              "790660605"
            ]
          },
          "790660605": {
            "id": "790660605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Huh, what was that? It sounded like... someone's voice? {NICKNAME}, did you hear that?",
            "nextDialogs": [
              "790660608"
            ]
          },
          "790660608": {
            "id": "790660608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, The Princess is way ahead... Let's forget about that for now and catch up with her first."
          }
        }
      }
    },
    {
      "subId": "7906610",
      "subQuestName": "Accept Princess Cimest's trial",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790661001"
        ],
        "dialogs": {
          "790661001": {
            "id": "790661001",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "*sigh* When will I be able to find a Guardian...",
            "nextDialogs": [
              "790661002"
            ]
          },
          "790661002": {
            "id": "790661002",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "If we cannot find one, then at the very least we must allow Her Highness to...",
            "nextDialogs": [
              "790661003"
            ]
          },
          "790661003": {
            "id": "790661003",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "...I've heard that in Brickstacks, they have a way to go outside the world, otherwise...",
            "nextDialogs": [
              "790661004"
            ]
          },
          "790661004": {
            "id": "790661004",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "Saborn, that's quite enough. As for the exact method, we can discuss the details later..."
          }
        }
      }
    },
    {
      "subId": "7906611",
      "subQuestName": "Accept Princess Cimest's trial",
      "sceneId": null,
      "locations": [],

    {
      "subId": "7906604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790660401"
        ],
        "dialogs": {
          "790660401": {
            "id": "790660401",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "Saborn, we must think of something!",
            "nextDialogs": [
              "790660402"
            ]
          },
          "790660402": {
            "id": "790660402",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "*sigh* ...You are no doubt right. But when have we ever managed to hold back the princess?"
          }
        }
      }
    },
    {
      "subId": "7906608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790660801"
        ],
        "dialogs": {
          "790660801": {
            "id": "790660801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#We passed! {NICKNAME}, we're Guardians now! So is this the relic that's used to acknowledge new Guardians?",
            "nextDialogs": [
              "790660802"
            ]
          },
          "790660802": {
            "id": "790660802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? There's something carved onto it, like a line of text maybe? Let Paimon take a closer look...",
            "nextDialogs": [
              "790660803"
            ]
          },
          "790660803": {
            "id": "790660803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Stories follow rules, unfolding in cyclical patterns, but each should follow its own course.\"",
            "nextDialogs": [
              "790660804"
            ]
          },
          "790660804": {
            "id": "790660804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Uhh, Paimon doesn't get it. Do you get it, {NICKNAME}?",
            "nextDialogs": [
              "790660807"
            ]
          },
          "790660807": {
            "id": "790660807",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Those words have always been there. Even I do not know their origin...",
            "nextDialogs": [
              "790660808"
            ]
          },
          "790660808": {
            "id": "790660808",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "I sense that they may hold some great significance for the kingdom... But I have yet to grasp their meaning.",
            "nextDialogs": [
              "790660809"
            ]
          },
          "790660809": {
            "id": "790660809",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Whatever the case, given your performance in the trial, you are undoubtedly the most suitable candidate for the title of \"Guardian\" that I've ever met.",
            "nextDialogs": [
              "790660810"
            ]
          },
          "790660810": {
            "id": "790660810",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Your abilities and judgment are beyond question. Meeting you at a time like this is truly a blessing for our kingdom.",
            "nextDialogs": [
              "790660811"
            ]
          },
          "790660811": {
            "id": "790660811",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Now that we have retrieved the relic, we may hold the ceremony right away.",
            "nextDialogs": [
              "790660812"
            ]
          },
          "790660812": {
            "id": "790660812",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "I am fully confident that your courage and abilities will have won you the relic's respect."
          }
        }
      }
    }
  ]

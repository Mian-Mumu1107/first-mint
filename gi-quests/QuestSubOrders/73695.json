    {
      "subId": "7369502",
      "subQuestName": "Talk to Daneh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736950201"
        ],
        "dialogs": {
          "736950201": {
            "id": "736950201",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "Oh? Have you found all the replicas?",
            "nextDialogs": [
              "736950202"
            ]
          },
          "736950202": {
            "id": "736950202",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "Marvelous! You really do have a knack for this, don't you?",
            "nextDialogs": [
              "736950203"
            ]
          },
          "736950203": {
            "id": "736950203",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "Well then. This gift is for you. Thanks for taking part in the event organized by our Darshan.",
            "nextDialogs": [
              "736950204"
            ]
          },
          "736950204": {
            "id": "736950204",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "I hope that you've been able to enjoy your taste of archaeology, Traveler.",
            "nextDialogs": [
              "736950205"
            ]
          },
          "736950205": {
            "id": "736950205",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "That said, real-life archaeology tends to be rather dry and labor-intensive work...",
            "nextDialogs": [
              "736950206"
            ]
          },
          "736950206": {
            "id": "736950206",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "But the instant you find that key relic, you will feel as if the struggle was all worth it.",
            "nextDialogs": [
              "736950209"
            ]
          },
          "736950209": {
            "id": "736950209",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "Well, if we don't find anything, then this is, as they say, \"a waste of effort.\"",
            "nextDialogs": [
              "736950210"
            ]
          },
          "736950210": {
            "id": "736950210",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "And to be honest, this is actually what happens more often than not. The instances where we do find something important are quite rare indeed.",
            "nextDialogs": [
              "736950211"
            ]
          },
          "736950211": {
            "id": "736950211",
            "speakerId": 30351,
            "speakerName": "Daneh",
            "text": "But to work in archaeology is to be used to such circumstances and stay optimistic even so. It would only be a matter of time before we collapsed otherwise."
          }
        }
      }
    }
  ]
}
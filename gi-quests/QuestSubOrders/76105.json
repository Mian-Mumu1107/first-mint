    {
      "subId": "7610501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761050101"
        ],
        "dialogs": {
          "761050101": {
            "id": "761050101",
            "speakerId": 1000,
            "speakerName": "Malta",
            "text": "#{M#Mister}{F#Miss}, did you see those Rock Crabs? I think they're performing some kind of ritual.",
            "nextDialogs": [
              "761050102"
            ]
          },
          "761050102": {
            "id": "761050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's probably just how they live their lives.",
            "nextDialogs": [
              "761050103"
            ]
          },
          "761050103": {
            "id": "761050103",
            "speakerId": 1000,
            "speakerName": "Malta",
            "text": "Really? Oh... I think I get it now.",
            "nextDialogs": [
              "761050104"
            ]
          },
          "761050104": {
            "id": "761050104",
            "speakerId": 1000,
            "speakerName": "Malta",
            "text": "There are a lot of people in Nasha Town just like those Rock Crabs. Some walk arm in arm, while others greet each other with fists and kicks before going their separate ways.",
            "nextDialogs": [
              "761050105"
            ]
          },
          "761050105": {
            "id": "761050105",
            "speakerId": 1000,
            "speakerName": "Malta",
            "text": "I guess that's just how people in Nasha Town live their lives, too!",
            "nextDialogs": [
              "761050108"
            ]
          },
          "761050108": {
            "id": "761050108",
            "speakerId": 1000,
            "speakerName": "Malta",
            "text": "#{M#Mister}{F#Miss}, can you persuade all these Rock Crabs to go inside the small pond?",
            "nextDialogs": [
              "761050109"
            ]
          },
          "761050109": {
            "id": "761050109",
            "speakerId": 1000,
            "speakerName": "Malta",
            "text": "Just like calling all the treasure hunters into The Flagship at once? The results would be so interesting to see!",
            "nextDialogs": [
              "761051501"
            ]
          },
          "761051501": {
            "id": "761051501",
            "speakerId": 1000,
            "speakerName": "Malta",
            "text": "#I really wanna see what happens when all the Rock Crabs get together in one place... Uhm, {M#Mister}{F#Miss}, are you free now?"
          }
        }
      }
    },

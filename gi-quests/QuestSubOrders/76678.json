    {
      "subId": "7667802",
      "subQuestName": "Let's play some music",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840601"
        ],
        "dialogs": {
          "760840601": {
            "id": "760840601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try something from another nation...",
            "nextDialogs": [
              "760490801"
            ]
          },
          "760490801": {
            "id": "760490801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try something from another nation...",
            "nextDialogs": [
              "760490802"
            ]
          },
          "760490802": {
            "id": "760490802",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "How curious... I have heard melodies like this before, but your playing lends a whole new dimension...",
            "nextDialogs": [
              "760490803"
            ]
          },
          "760490803": {
            "id": "760490803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Ah, maybe because {NICKNAME} was channeling {M#his}{F#her} emotional connection to that place...",
            "nextDialogs": [
              "760490804"
            ]
          },
          "760490804": {
            "id": "760490804",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "What's curious is that... I feel as if I can picture the landscape just by listening to the melody. I wonder how the real thing compares to my imagination...",
            "nextDialogs": [
              "760490805"
            ]
          },
          "760490805": {
            "id": "760490805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You should just go see it someday! We can be your tour guides!",
            "nextDialogs": [
              "760490806"
            ]
          },
          "760490806": {
            "id": "760490806",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm... Perhaps. If that day ever comes."
          }
        }
      }
    },
    {
      "subId": "7604907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490709"
        ],
        "dialogs": {
          "760490709": {
            "id": "760490709",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "We have pierced through cloud and fog, and together, witnessed the answer on the moon... Its beauty is like the music your strings now sing."
          }
        }
      }
    },
    {
      "subId": "7608304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760830401"
        ],
        "dialogs": {
          "760830401": {
            "id": "760830401",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Go on now, little ones.",
            "nextDialogs": [
              "760830402"
            ]
          },
          "760830402": {
            "id": "760830402",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "See if you can guess what this picture is.",
            "nextDialogs": [
              "760830404",
              "760830408",
              "760830413"
            ]
          },
          "760830404": {
            "id": "760830404",
            "speakerId": 15703,
            "speakerName": "Kuuhenki",
            "text": "!!!",
            "nextDialogs": [
              "760830405"
            ]
          },
          "760830405": {
            "id": "760830405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, that was way too obvious!",
            "nextDialogs": [
              "760830406"
            ]
          },
          "760830406": {
            "id": "760830406",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I'm afraid this riddle was a little too simple for us."
          },
          "760830408": {
            "id": "760830408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, what's wrong with this eel's waist?",
            "nextDialogs": [
              "760830409"
            ]
          },
          "760830409": {
            "id": "760830409",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "You two possess an impressive wealth of knowledge...",
            "nextDialogs": [
              "760830410"
            ]
          },
          "760830410": {
            "id": "760830410",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the moon.\"",
            "nextDialogs": [
              "760830411"
            ]
          },
          "760830411": {
            "id": "760830411",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. You did a wonderful job."
          },
          "760830413": {
            "id": "760830413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyone with eyes can see it's an arc! How could the answer be something so simple!?",
            "nextDialogs": [
              "760830414"
            ]
          },
          "760830414": {
            "id": "760830414",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "While you aren't technically wrong, I'm afraid that's not exactly what the kuuhenki were going for.",
            "nextDialogs": [
              "760830415"
            ]
          },
          "760830415": {
            "id": "760830415",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the moon.\"",
            "nextDialogs": [
              "760830416"
            ]
          },
          "760830416": {
            "id": "760830416",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. You did a wonderful job."
          }
        }
      }
    },
    {
      "subId": "7608305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760830501"
        ],
        "dialogs": {
          "760830501": {
            "id": "760830501",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Go on now, friends.",
            "nextDialogs": [
              "760830502"
            ]
          },
          "760830502": {
            "id": "760830502",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "All you need to do is guess what the picture is.",
            "nextDialogs": [
              "760830504",
              "760830509",
              "760830514"
            ]
          },
          "760830504": {
            "id": "760830504",
            "speakerId": 15703,
            "speakerName": "Kuuhenki",
            "text": "!!!",
            "nextDialogs": [
              "760830505"
            ]
          },
          "760830505": {
            "id": "760830505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How did you manage to guess that!?",
            "nextDialogs": [
              "760830506"
            ]
          },
          "760830506": {
            "id": "760830506",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "So that's what it's called. Does it pick its creator up and carry her around in its hand?",
            "nextDialogs": [
              "760830507"
            ]
          },
          "760830507": {
            "id": "760830507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks you might be confusing Aino with a former colleague of yours..."
          },
          "760830509": {
            "id": "760830509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Could a Weasel Thief this stuffed still steal stuff?",
            "nextDialogs": [
              "760830510"
            ]
          },
          "760830510": {
            "id": "760830510",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Or perhaps it no longer needs to steal?",
            "nextDialogs": [
              "760830511"
            ]
          },
          "760830511": {
            "id": "760830511",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the big mechanical duck next to Aino's workshop.\"",
            "nextDialogs": [
              "760830512"
            ]
          },
          "760830512": {
            "id": "760830512",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. Thank you, I know that wasn't easy."
          },
          "760830514": {
            "id": "760830514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, the kuuhenki learned what specialized lab equipment looks like just for this game? They're really going all out!",
            "nextDialogs": [
              "760830515"
            ]
          },
          "760830515": {
            "id": "760830515",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That's... very close.",
            "nextDialogs": [
              "760830516"
            ]
          },
          "760830516": {
            "id": "760830516",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the big mechanical duck next to Aino's workshop.\"",
            "nextDialogs": [
              "760830517"
            ]
          },
          "760830517": {
            "id": "760830517",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How is that close!?",
            "nextDialogs": [
              "760830518"
            ]
          },
          "760830518": {
            "id": "760830518",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. Thank you, I know that wasn't easy."
          }
        }
      }
    },

              "760830605"
            ]
          },
          "760830605": {
            "id": "760830605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you play this with the kuuhenki before and forget to tell us?",
            "nextDialogs": [
              "760830606"
            ]
          },
          "760830606": {
            "id": "760830606",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The structures the Fatui have raised in Nod-Krai are far too... bold. Even the kuuhenki can remember them..."
          },
          "760830608": {
            "id": "760830608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... The body's got some resemblance, but is their cap really that round?",
            "nextDialogs": [
              "760830609"
            ]
          },
          "760830609": {
            "id": "760830609",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "You got the \"floating\" part right, at least...",
            "nextDialogs": [
              "760830610"
            ]
          },
          "760830610": {
            "id": "760830610",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is the \"Kuuvahki Experimental Design Bureau.\"",
            "nextDialogs": [
              "760830611"
            ]
          },
          "760830611": {
            "id": "760830611",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The structures the Fatui have raised in Nod-Krai are far too... bold. Even the kuuhenki can remember them...",
            "nextDialogs": [
              "760830612"
            ]
          },
          "760830612": {
            "id": "760830612",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. You really outdid yourselves."
          },
          "760830614": {
            "id": "760830614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The handle seems a little short for an umbrella. How's anyone supposed to hold it?",
            "nextDialogs": [
              "760830615"
            ]
          },
          "760830615": {
            "id": "760830615",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "An umbrella... isn't something I often use. Why not just make a kuuvahki shield when it rains?",
            "nextDialogs": [
              "760830616"
            ]
          },
          "760830616": {
            "id": "760830616",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a sec! We can use that to keep the rain off, too!?",
            "nextDialogs": [
              "760830617"
            ]
          },
          "760830617": {
            "id": "760830617",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is the \"Kuuvahki Experimental Design Bureau.\"",
            "nextDialogs": [
              "760830618"
            ]
          },
          "760830618": {
            "id": "760830618",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The structures the Fatui have raised in Nod-Krai are far too... bold. Even the kuuhenki can remember them...",
            "nextDialogs": [
              "760830619"
            ]
          },
          "760830619": {
            "id": "760830619",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. You really outdid yourselves."
          }
        }
      }
    },
    {
      "subId": "7608401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840101"
        ],
        "dialogs": {
          "760840101": {
            "id": "760840101",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah, you're here? The kuuhenki are playing the lyre again. Could you play a song for them like last time?",
            "nextDialogs": [
              "760840102"
            ]
          },
          "760840102": {
            "id": "760840102",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "And I happen to be in the mood to hear something different myself.",
            "nextDialogs": [
              "760840103"
            ]
          },
          "760840103": {
            "id": "760840103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hmm, what should I play...)"
          }
        }
      }
    },
    {
      "subId": "7608402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840201"
        ],
        "dialogs": {
          "760840201": {
            "id": "760840201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try the one Columbina always sings...",
            "nextDialogs": [
              "760490202"
            ]
          },
          "760490202": {
            "id": "760490202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try the one Columbina always sings...",
            "nextDialogs": [
              "760490201"
            ]
          },
          "760490201": {
            "id": "760490201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(But what tone should I go for...)",
            "nextDialogs": [
              "760490604",
              "760490702"
            ]
          },
          "760490604": {
            "id": "760490604",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That was lovely. So you really did memorize my tune.",
            "nextDialogs": [
              "760490605"
            ]
          },
          "760490605": {
            "id": "760490605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, only 'cause you're such a great singer! Whenever we hear your voice, sometimes we stop for a bit just to listen...",
            "nextDialogs": [
              "760490606"
            ]
          },
          "760490606": {
            "id": "760490606",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hm, the kuuhenki seemed quite enraptured with your performance as well. Perhaps they picked up a few things...",
            "nextDialogs": [
              "760490607"
            ]
          },
          "760490607": {
            "id": "760490607",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I might require your educational assistance again in the future.",
            "nextDialogs": [
              "760490608"
            ]
          },
          "760490608": {
            "id": "760490608",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come, give me your hand.",
            "nextDialogs": [
              "760490609"
            ]
          },
          "760490609": {
            "id": "760490609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? No, no, this was a free performance. No tuition fee required!",
            "nextDialogs": [
              "760490610"
            ]
          },
          "760490610": {
            "id": "760490610",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hmm? Tuition fee?",
            "nextDialogs": [
              "760490611"
            ]
          },
          "760490611": {
            "id": "760490611",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I only thought... the gentle glow of moonlight would make a fitting accompaniment for such a beautiful melody."
          },
          "760490702": {
            "id": "760490702",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Oh, it's over already? I could listen to that forever...",
            "nextDialogs": [
              "760490703"
            ]
          },
          "760490703": {
            "id": "760490703",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "As I once told you, this is the only lullaby I can remember.",
            "nextDialogs": [
              "760490704"
            ]
          },
          "760490704": {
            "id": "760490704",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Although I have yet to discern the meaning behind it, after hearing you play, I feel like whatever answer is waiting for me, up there on the moon... at the very least, it must be a beautiful one.",
            "nextDialogs": [
              "760490705"
            ]
          },
          "760490705": {
            "id": "760490705",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Here, give me your hand.",
            "nextDialogs": [
              "760490706"
            ]
          },
          "760490706": {
            "id": "760490706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's okay. Seriously, you don't need to give us anything in return.",
            "nextDialogs": [
              "760490707"
            ]
          },
          "760490707": {
            "id": "760490707",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah, that wasn't my intention... I only wished to adorn your melody with a ray of gentle moonlight."
          }
        }
      }
    },

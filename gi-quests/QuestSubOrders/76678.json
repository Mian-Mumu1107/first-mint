    {
      "subId": "7667803",
      "subQuestName": "Let's play a picture-guessing game",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760830701"
        ],
        "dialogs": {
          "760830701": {
            "id": "760830701",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Once the game is over, the kuuhenki rush toward you. They appear to be extremely happy.",
            "nextDialogs": [
              "760830702"
            ]
          },
          "760830702": {
            "id": "760830702",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Thank you for taking the time to play with the kuuhenki.",
            "nextDialogs": [
              "760830703"
            ]
          },
          "760830703": {
            "id": "760830703",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I hope we can have just as much fun playing together next time."
          }
        }
      }
    },

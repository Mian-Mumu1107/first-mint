    {
      "subId": "7667805",
      "subQuestName": "Let's play Moon Chess",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760540301"
        ],
        "dialogs": {
          "760540301": {
            "id": "760540301",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Perhaps... Like this?",
            "nextDialogs": [
              "760540302"
            ]
          },
          "760540302": {
            "id": "760540302",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hmm, let me think...",
            "nextDialogs": [
              "760540303"
            ]
          },
          "760540303": {
            "id": "760540303",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Oh...",
            "nextDialogs": [
              "760540304"
            ]
          },
          "760540304": {
            "id": "760540304",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Moons... Moons...",
            "nextDialogs": [
              "760540305"
            ]
          },
          "760540305": {
            "id": "760540305",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "How about here?",
            "nextDialogs": [
              "760540306"
            ]
          },
          "760540306": {
            "id": "760540306",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Looks like I won this round.",
            "nextDialogs": [
              "760540307"
            ]
          },
          "760540307": {
            "id": "760540307",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "My three moons are connected.",
            "nextDialogs": [
              "760540308"
            ]
          },
          "760540308": {
            "id": "760540308",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm, this should win it.",
            "nextDialogs": [
              "760540309"
            ]
          },
          "760540309": {
            "id": "760540309",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm... The moons wax and wane in an endless cycle...",
            "nextDialogs": [
              "760540310"
            ]
          },
          "760540310": {
            "id": "760540310",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "It seems both sets of moons refuse to be eclipsed.",
            "nextDialogs": [
              "760540311"
            ]
          },
          "760540311": {
            "id": "760540311",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Are we... heading for a tie?",
            "nextDialogs": [
              "760540312"
            ]
          },
          "760540312": {
            "id": "760540312",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah, you weigh your decisions carefully before making them, I see. Take your time — we have plenty of that, after all.",
            "nextDialogs": [
              "760540313"
            ]
          },
          "760540313": {
            "id": "760540313",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Did you forget how to place your moons in the night sky? Shall I help you?",
            "nextDialogs": [
              "760540314"
            ]
          },
          "760540314": {
            "id": "760540314",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "You don't like this game? Hm... I find it quite amusing myself.",
            "nextDialogs": [
              "760540315"
            ]
          },
          "760540315": {
            "id": "760540315",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm? Are you staring at me? Your gaze is not subtle.",
            "nextDialogs": [
              "760540316"
            ]
          },
          "760540316": {
            "id": "760540316",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "You're staring... Is the truth of the moons written on my face?",
            "nextDialogs": [
              "760540317"
            ]
          },
          "760540317": {
            "id": "760540317",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The board's over there, by the way...",
            "nextDialogs": [
              "760540318"
            ]
          },
          "760540318": {
            "id": "760540318",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hm, your moons are aligned.",
            "nextDialogs": [
              "760540319"
            ]
          },
          "760540319": {
            "id": "760540319",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The night sky is yours.",
            "nextDialogs": [
              "760540320"
            ]
          },
          "760540320": {
            "id": "760540320",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah... I must have... slipped up somewhere.",
            "nextDialogs": [
              "760540321"
            ]
          },
          "760540321": {
            "id": "760540321",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You have a wonderful time playing the game with Columbina...",
            "nextDialogs": [
              "760540322"
            ]
          },
          "760540322": {
            "id": "760540322",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Thank you, I enjoyed that a lot.",
            "nextDialogs": [
              "760540323"
            ]
          },
          "760540323": {
            "id": "760540323",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "If you'd like... feel free to come keep me company again, sometime.",
            "nextDialogs": [
              "760540324"
            ]
          },
          "760540324": {
            "id": "760540324",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Here, take this as a token of our promise."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7604901",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490603"
        ],
        "dialogs": {
          "760490603": {
            "id": "760490603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try calm and gentle...",
            "nextDialogs": [
              "760490604"
            ]
          },
          "760490604": {
            "id": "760490604",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That was lovely. So you really did memorize my tune.",
            "nextDialogs": [
              "760490605"
            ]
          },
          "760490605": {
            "id": "760490605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, only 'cause you're such a great singer! Whenever we hear your voice, sometimes we stop for a bit just to listen...",
            "nextDialogs": [
              "760490606"
            ]
          },
          "760490606": {
            "id": "760490606",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hm, the kuuhenki seemed quite enraptured with your performance as well. Perhaps they picked up a few things...",
            "nextDialogs": [
              "760490607"
            ]
          },
          "760490607": {
            "id": "760490607",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I might require your educational assistance again in the future.",
            "nextDialogs": [
              "760490608"
            ]
          },
          "760490608": {
            "id": "760490608",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come, give me your hand.",
            "nextDialogs": [
              "760490609"
            ]
          },
          "760490609": {
            "id": "760490609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? No, no, this was a free performance. No tuition fee required!",
            "nextDialogs": [
              "760490610"
            ]
          },
          "760490610": {
            "id": "760490610",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hmm? Tuition fee?",
            "nextDialogs": [
              "760490611"
            ]
          },
          "760490611": {
            "id": "760490611",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I only thought... the gentle glow of moonlight would make a fitting accompaniment for such a beautiful melody."
          }
        }
      }
    },
    {
      "subId": "7604901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490101"
        ],
        "dialogs": {
          "760490101": {
            "id": "760490101",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "...Hmm, a half-step too high, perhaps. Let's try that again, shall we?",
            "nextDialogs": [
              "760490102"
            ]
          },
          "760490102": {
            "id": "760490102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey there, Columbina!",
            "nextDialogs": [
              "760490103"
            ]
          },
          "760490103": {
            "id": "760490103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, are you... teaching the kuuhenki how to play the lyre?",
            "nextDialogs": [
              "760490104"
            ]
          },
          "760490104": {
            "id": "760490104",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Yes. They were so happy to have it fixed, they practically haven't left my side.",
            "nextDialogs": [
              "760490105"
            ]
          },
          "760490105": {
            "id": "760490105",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Playing the lyre has never been my forte, though. I'm more accustomed to hearing others play.",
            "nextDialogs": [
              "760490106"
            ]
          },
          "760490106": {
            "id": "760490106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohhh, right! If you had a band, you'd totally be in charge of vocals, huh...",
            "nextDialogs": [
              "760490107"
            ]
          },
          "760490107": {
            "id": "760490107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#When it comes to instruments, though... {NICKNAME}'s pretty much a prodigy! From the lyre to the Djem Djem Drum, this one can do it all!",
            "nextDialogs": [
              "760490110"
            ]
          },
          "760490110": {
            "id": "760490110",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Oh, is that so? In that case... Perhaps you could teach them instead?"
          }
        }
      }
    },
    {
      "subId": "7604903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490301"
        ],
        "dialogs": {
          "760490301": {
            "id": "760490301",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The kuuhenki seem quite content for the day. Even so... I may have to trouble you to drop by again when they wish to learn more."
          }
        }
      }
    },
    {
      "subId": "7604907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490709"
        ],
        "dialogs": {
          "760490709": {
            "id": "760490709",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "We have pierced through cloud and fog, and together, witnessed the answer on the moon... Its beauty is like the music your strings now sing."
          }
        }
      }
    }
  ]
}
    {
      "subId": "48503",
      "subQuestName": "Hunt down Raptor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4850301"
        ],
        "dialogs": {
          "4850301": {
            "id": "4850301",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "It looks like there's no way across... Ugh, he must be around here somewhere.",
            "nextDialogs": [
              "4850302"
            ]
          },
          "4850302": {
            "id": "4850302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Amber, over there!",
            "nextDialogs": [
              "4850303"
            ]
          },
          "4850303": {
            "id": "4850303",
            "speakerId": 1485,
            "speakerName": "Raptor",
            "text": "If you insist on chasing me, so be it... Huh? Who brought the little girl?",
            "nextDialogs": [
              "4850304"
            ]
          },
          "4850304": {
            "id": "4850304",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "You must be Raptor! You can't escape!",
            "nextDialogs": [
              "4850305"
            ]
          },
          "4850305": {
            "id": "4850305",
            "speakerId": 1485,
            "speakerName": "Raptor",
            "text": "Haha, I don't need to escape! There's no way you can make it over here.",
            "nextDialogs": [
              "4850306"
            ]
          },
          "4850306": {
            "id": "4850306",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Oh... It is pretty high... and quite far...",
            "nextDialogs": [
              "4850307"
            ]
          },
          "4850307": {
            "id": "4850307",
            "speakerId": 1485,
            "speakerName": "Raptor",
            "text": "Oh, little girl, why don't you run along home now and let your leader deal with this? Don't worry, I promise that once the Grand Master gets here, I'll surrender immediately! Haha!",
            "nextDialogs": [
              "4850308"
            ]
          },
          "4850308": {
            "id": "4850308",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hey, watch it! You're talking to a Knights of Favonius Outrider! You'll be sorry when I arrest you!",
            "nextDialogs": [
              "4850311"
            ]
          },
          "4850311": {
            "id": "4850311",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "...You're right.",
            "nextDialogs": [
              "4850312"
            ]
          },
          "4850312": {
            "id": "4850312",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Ugh... He's right there in front of us... If only we could glide across.",
            "nextDialogs": [
              "4850313"
            ]
          },
          "4850313": {
            "id": "4850313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So how did HE get across?"
          }
        }
      }
    },
    {
      "subId": "48504",
      "subQuestName": "Glide over the chasm",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4850401"
        ],
        "dialogs": {
          "4850401": {
            "id": "4850401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Amber, no! You're gonna fall! You're gonna fall—!"
          }
        }
      }
    },
    {
      "subId": "48505",
      "subQuestName": "Track down Raptor and arrest him!",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "48506",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4850601"
        ],
        "dialogs": {
          "4850601": {
            "id": "4850601",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Alright! I got him!",
            "nextDialogs": [
              "4850602"
            ]
          },
          "4850602": {
            "id": "4850602",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I only noticed the wind current from in the air — and it's the only one.",
            "nextDialogs": [
              "4850603"
            ]
          },
          "4850603": {
            "id": "4850603",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "It would be suicide to try and escape in the direction Raptor was going.",
            "nextDialogs": [
              "4850604"
            ]
          },
          "4850604": {
            "id": "4850604",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "In other words, the only way Raptor could have gotten out would be this way — past us.",
            "nextDialogs": [
              "4850605"
            ]
          },
          "4850605": {
            "id": "4850605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aha! So he was just trying to fool us by acting smug, in the hope that we would just give up and leave.",
            "nextDialogs": [
              "4850606"
            ]
          },
          "4850606": {
            "id": "4850606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Little did he know, we're not so easily fooled.",
            "nextDialogs": [
              "4850607"
            ]
          },
          "4850607": {
            "id": "4850607",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "#It was all thanks to {NICKNAME}'s sharp thinking! Just like a wise man once said, \"Once you eliminate the impossible, whatever remains, no matter how improbable, must be the truth.\"",
            "nextDialogs": [
              "4850608"
            ]
          },
          "4850608": {
            "id": "4850608",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "At the end of the day, gliding is seven parts technique, three parts instinct — and then 90 parts courage.",
            "nextDialogs": [
              "4850609"
            ]
          },
          "4850609": {
            "id": "4850609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What you did now looked more like 99 parts courage...",
            "nextDialogs": [
              "4850610"
            ]
          },
          "4850610": {
            "id": "4850610",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Ah, it was just like in my first gliding exam... I was super nervous, but in the end, there was nothing to be afraid of and I passed no problem.",
            "nextDialogs": [
              "4850611"
            ]
          },
          "4850611": {
            "id": "4850611",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I kinda missed that nervous rush in the exams I've done since then... It just wasn't the same.",
            "nextDialogs": [
              "4850612"
            ]
          },
          "4850612": {
            "id": "4850612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Erm, sorry — Paimon thought you said you passed no problem? What do you mean, exams since then?",
            "nextDialogs": [
              "4850613"
            ]
          },
          "4850613": {
            "id": "4850613",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Ah... Well you see, the thing is, Mondstadt is all \"no glide zone\" this, \"no landing zone\" that...",
            "nextDialogs": [
              "4850614"
            ]
          },
          "4850614": {
            "id": "4850614",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "*sigh* Every time I get my license it keeps getting revoked. I must have taken the exam about 15 times altogether...",
            "nextDialogs": [
              "4850615"
            ]
          },
          "4850615": {
            "id": "4850615",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "But I always pass the first time. I guess my little gliding manual ain't so bad after all!",
            "nextDialogs": [
              "4850616"
            ]
          },
          "4850616": {
            "id": "4850616",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#...{NICKNAME}, let's go and get a copy of the real gliding manual from Acting Grand Master Jean some time.",
            "nextDialogs": [
              "4850619"
            ]
          },
          "4850619": {
            "id": "4850619",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I'll head off first because I need to escort Raptor back to the city.",
            "nextDialogs": [
              "4850620"
            ]
          },
          "4850620": {
            "id": "4850620",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Once you're back in the city don't forget to come find me at the Cathedral. I'll issue your gliding license there."
          }
        }
      }
    },
    {
      "subId": "48507",
      "subQuestName": "Go to the Cathedral to get your gliding license",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "48508",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4850801"
        ],
        "dialogs": {
          "4850801": {
            "id": "4850801",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Congratulations, here is your gliding license! You're officially legal now, yay!",
            "nextDialogs": [
              "4850802"
            ]
          },
          "4850802": {
            "id": "4850802",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I'm not surprised though, you are a natural after all.",
            "nextDialogs": [
              "4850805"
            ]
          },
          "4850805": {
            "id": "4850805",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Oh — and I'll sign you up for the next Wind Gliding Championship!",
            "nextDialogs": [
              "4850806"
            ]
          },
          "4850806": {
            "id": "4850806",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I glide so fast that no one can keep up — it's just me up there, on my own, gliding around... It's kinda boring."
          }
        }
      }
    }
  ]
}
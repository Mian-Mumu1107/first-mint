          "750040601": {
            "id": "750040601",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "#Hah... What do you think, {NICKNAME}. Shall we unseal the Iridescent Inscription now?",
            "nextDialogs": [
              "750040603",
              "750040605"
            ]
          },
          "750040603": {
            "id": "750040603",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Then I'll get to it... But please, be very careful."
          },
          "750040605": {
            "id": "750040605",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "No worries. Just tell me once you're done..."
          }
        }
      }
    },

    {
      "subId": "7500404",
      "subQuestName": "Touch the inscription",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750040401"
        ],
        "dialogs": {
          "750040401": {
            "id": "750040401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, this is weird. There was all that scattered light earlier... and then we suddenly found ourselves here...?",
            "nextDialogs": [
              "750040402"
            ]
          },
          "750040402": {
            "id": "750040402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. That's...",
            "nextDialogs": [
              "750040403"
            ]
          },
          "750040403": {
            "id": "750040403",
            "speakerId": 21556,
            "speakerName": "\"Beast With Fur Like That of Night\"",
            "text": "Come... over here...",
            "nextDialogs": [
              "750040404"
            ]
          },
          "750040404": {
            "id": "750040404",
            "speakerId": 21556,
            "speakerName": "\"Beast With Fur Like That of Night\"",
            "text": "You have brought so many slumberers, they who should have rested in peace...",
            "nextDialogs": [
              "750040405"
            ]
          },
          "750040405": {
            "id": "750040405",
            "speakerId": 21556,
            "speakerName": "\"Beast With Fur Like That of Night\"",
            "text": "Perhaps they prayed to spirits they should not have beseeched...",
            "nextDialogs": [
              "750040406"
            ]
          },
          "750040406": {
            "id": "750040406",
            "speakerId": 21556,
            "speakerName": "\"Beast With Fur Like That of Night\"",
            "text": "But that was a moonless night, where naught could be seen. The Night has long forgiven them. Yet hate and filth shall never rest, and they too shall never truly sleep again.",
            "nextDialogs": [
              "750040407"
            ]
          },
          "750040407": {
            "id": "750040407",
            "speakerId": 21556,
            "speakerName": "\"Beast With Fur Like That of Night\"",
            "text": "Thank you, O you who are beloved... You have soothed their fury, which raged in the darkness. It was you who brought them into the Night's reflection. The outland souls, too, may now return where they were headed...",
            "nextDialogs": [
              "750040408"
            ]
          },
          "750040408": {
            "id": "750040408",
            "speakerId": 21556,
            "speakerName": "\"Beast With Fur Like That of Night\"",
            "text": "...",
            "nextDialogs": [
              "750040409"
            ]
          },
          "750040409": {
            "id": "750040409",
            "speakerId": 21556,
            "speakerName": "\"Beast With Fur Like That of Night\"",
            "text": "Go now. But beware the fearful instigators, and the ends plotted by those bearing ill-intent."
          }
        }
      }
    },

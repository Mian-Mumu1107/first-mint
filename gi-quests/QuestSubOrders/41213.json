  "subQuests": [
    {
      "subId": "4121301",
      "subQuestName": "Look for Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130101"
        ],
        "dialogs": {
          "412130101": {
            "id": "412130101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Albedo! We're baaaack!",
            "nextDialogs": [
              "412130102"
            ]
          },
          "412130102": {
            "id": "412130102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? It seems that he's not here.",
            "nextDialogs": [
              "412130103"
            ]
          },
          "412130103": {
            "id": "412130103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is he out investigating something? Or maybe he went to make some mysterious drawings?",
            "nextDialogs": [
              "412130104"
            ]
          },
          "412130104": {
            "id": "412130104",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Ah! It's you!",
            "nextDialogs": [
              "412130105"
            ]
          },
          "412130105": {
            "id": "412130105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, if it isn't Sucrose! What are you doing here?",
            "nextDialogs": [
              "412130106"
            ]
          },
          "412130106": {
            "id": "412130106",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "I'm in the final stage of my research. I have five hours and twenty-six minutes of leisure time today.",
            "nextDialogs": [
              "412130107"
            ]
          },
          "412130107": {
            "id": "412130107",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "So I came here looking for you to inquire about previously discussed matters.",
            "nextDialogs": [
              "412130108"
            ]
          },
          "412130108": {
            "id": "412130108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You tell time very accurately! Are you a human clock?",
            "nextDialogs": [
              "412130109"
            ]
          },
          "412130109": {
            "id": "412130109",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "No, no, it's nothing worth your praise. You're too kind...",
            "nextDialogs": [
              "412130110"
            ]
          },
          "412130110": {
            "id": "412130110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That wasn't a compliment...",
            "nextDialogs": [
              "412130111"
            ]
          },
          "412130111": {
            "id": "412130111",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "C—Can I ask you a question, Traveler? I made a request regarding investigating Mr. Albedo's secret. Have you made any progress?",
            "nextDialogs": [
              "412130112"
            ]
          },
          "412130112": {
            "id": "412130112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Correct me if I'm wrong, but it's been over a week since we talked about it.",
            "nextDialogs": [
              "412130113"
            ]
          },
          "412130113": {
            "id": "412130113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I thought you'd forgotten about it.",
            "nextDialogs": [
              "412130114"
            ]
          },
          "412130114": {
            "id": "412130114",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "What...!?",
            "nextDialogs": [
              "412130115"
            ]
          },
          "412130115": {
            "id": "412130115",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "O—Over a week? I clearly... Ah!",
            "nextDialogs": [
              "412130116"
            ]
          },
          "412130116": {
            "id": "412130116",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "I've been so absorbed in my research. That matter of ours had completely slipped my mind...",
            "nextDialogs": [
              "412130117"
            ]
          },
          "412130117": {
            "id": "412130117",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How can your sense of time be so strong and so weak at the same time...?",
            "nextDialogs": [
              "412130118"
            ]
          },
          "412130118": {
            "id": "412130118",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "S—So! Do you know what it is?",
            "nextDialogs": [
              "412130121"
            ]
          },
          "412130121": {
            "id": "412130121",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "That's great. Could you tell me?",
            "nextDialogs": [
              "412130122"
            ]
          },
          "412130122": {
            "id": "412130122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you think, Paimon?",
            "nextDialogs": [
              "412130123"
            ]
          },
          "412130123": {
            "id": "412130123",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Umm... Telling her shouldn't really matter.",
            "nextDialogs": [
              "412130124"
            ]
          },
          "412130124": {
            "id": "412130124",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "She can take a look, too. Just no touching...",
            "nextDialogs": [
              "412130125"
            ]
          },
          "412130125": {
            "id": "412130125",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Wait. What are you talking about?",
            "nextDialogs": [
              "412130126"
            ]
          },
          "412130126": {
            "id": "412130126",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "What's this?"
          }
        }
      }
    },
    {
      "subId": "4121303",
      "subQuestName": "Head to the monster habitat to test the sword",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130301"
        ],
        "dialogs": {
          "412130301": {
            "id": "412130301",
            "speakerId": 1002,
            "speakerName": "Reckless Pallad",
            "text": "U—Ugh... Argh...",
            "nextDialogs": [
              "412130302"
            ]
          },
          "412130302": {
            "id": "412130302",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "M—Mr. Pallad!?",
            "nextDialogs": [
              "412130303"
            ]
          },
          "412130303": {
            "id": "412130303",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "You still haven't gone back?",
            "nextDialogs": [
              "412130304"
            ]
          },
          "412130304": {
            "id": "412130304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Isn't that the hotheaded adventurer from Mondstadt? Did he come here with Cyrus to explore the Snowy Mountain, too?",
            "nextDialogs": [
              "412130305"
            ]
          },
          "412130305": {
            "id": "412130305",
            "speakerId": 1002,
            "speakerName": "Reckless Pallad",
            "text": "I'm f—f—f—freezing, ACHOO!",
            "nextDialogs": [
              "412130306"
            ]
          },
          "412130306": {
            "id": "412130306",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Have you been here since I rescued you from the snow pit!?",
            "nextDialogs": [
              "412130307"
            ]
          },
          "412130307": {
            "id": "412130307",
            "speakerId": 1002,
            "speakerName": "Reckless Pallad",
            "text": "I wanted to leave, b—but I got lost. I'm sorry...",
            "nextDialogs": [
              "412130308"
            ]
          },
          "412130308": {
            "id": "412130308",
            "speakerId": 1002,
            "speakerName": "Reckless Pallad",
            "text": "U—Ugh... It's so c—cold that I c—can't move...",
            "nextDialogs": [
              "412130309"
            ]
          },
          "412130309": {
            "id": "412130309",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Mr. Pallad, a trip to this mountain requires solid preparation. You shouldn't have treated it so lightly.",
            "nextDialogs": [
              "412130310"
            ]
          },
          "412130310": {
            "id": "412130310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll take him back down.",
            "nextDialogs": [
              "412130311"
            ]
          },
          "412130311": {
            "id": "412130311",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "I'd appreciate the assistance. I'm afraid that, in his current state, he won't be able to walk on his own...",
            "nextDialogs": [
              "412130312"
            ]
          },
          "412130312": {
            "id": "412130312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Even if we can't, we won't just leave him here, right?",
            "nextDialogs": [
              "412130313"
            ]
          },
          "412130313": {
            "id": "412130313",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "You're right... My apologies, Traveler. I'm sure he feels bad about the situation.",
            "nextDialogs": [
              "412130314"
            ]
          },
          "412130314": {
            "id": "412130314",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "He's the least of your concerns right now. You should be worried about yourself!",
            "nextDialogs": [
              "412130315"
            ]
          },
          "412130315": {
            "id": "412130315",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah! The Fatui strike again!",
            "nextDialogs": [
              "412130316"
            ]
          },
          "412130316": {
            "id": "412130316",
            "speakerId": 1004,
            "speakerName": "Vadim",
            "text": "You must've already figured out why we're here.",
            "nextDialogs": [
              "412130317"
            ]
          },
          "412130317": {
            "id": "412130317",
            "speakerId": 1004,
            "speakerName": "Vadim",
            "text": "We won't let you go unless you give us that sword.",
            "nextDialogs": [
              "412130318"
            ]
          },
          "412130318": {
            "id": "412130318",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "No! Please, don't give them the sword.",
            "nextDialogs": [
              "412130321"
            ]
          },
          "412130321": {
            "id": "412130321",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's the spirit! Let's knock 'em down!",
            "nextDialogs": [
              "412130322"
            ]
          },
          "412130322": {
            "id": "412130322",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Mr. Pallad, I'll take you to a safe place! Quickly!",
            "nextDialogs": [
              "412130323"
            ]
          },
          "412130323": {
            "id": "412130323",
            "speakerId": 1004,
            "speakerName": "Vadim",
            "text": "So naive! We won't let any witness escape!",
            "nextDialogs": [
              "412130324"
            ]
          },
          "412130324": {
            "id": "412130324",
            "speakerId": 1004,
            "speakerName": "Vadim",
            "text": "This sword will make a fine gift for Her Excellency, Harbinger Signora!"
          }
        }
      }
    },

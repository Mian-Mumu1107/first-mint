    {
      "subId": "4121305",
      "subQuestName": "Speak to Sucrose",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130201"
        ],
        "dialogs": {
          "412130201": {
            "id": "412130201",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Remarkable! This weapon is like no other...",
            "nextDialogs": [
              "412130202"
            ]
          },
          "412130202": {
            "id": "412130202",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "You're also extraordinary. No matter if it's your fighting stance or the momentum of your swing, it's perfect.",
            "nextDialogs": [
              "412130203"
            ]
          },
          "412130203": {
            "id": "412130203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You flatter me.",
            "nextDialogs": [
              "412130204"
            ]
          },
          "412130204": {
            "id": "412130204",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "This sword is special. I didn't want to go too deep into the research, and yet I couldn't take my eyes off of it.",
            "nextDialogs": [
              "412130205"
            ]
          },
          "412130205": {
            "id": "412130205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, Paimon thinks that's one of your own special qualities, not the sword's...",
            "nextDialogs": [
              "412130206"
            ]
          },
          "412130206": {
            "id": "412130206",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Clearly this is a mysterious yet dangerous and enticing sword.",
            "nextDialogs": [
              "412130207"
            ]
          },
          "412130207": {
            "id": "412130207",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Mr. Albedo must have great confidence in you to have entrusted you with such an important item.",
            "nextDialogs": [
              "412130210"
            ]
          },
          "412130210": {
            "id": "412130210",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, you've earned his trust with your abilities.",
            "nextDialogs": [
              "412130211"
            ]
          },
          "412130211": {
            "id": "412130211",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "I agree with Paimon.",
            "nextDialogs": [
              "412130212"
            ]
          },
          "412130212": {
            "id": "412130212",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "However, the sword hadn't absorbed much energy before it was handed to you... Huh, how did Mr. Albedo recognize its uniqueness among a pile of other items in storage?",
            "nextDialogs": [
              "412130213"
            ]
          },
          "412130213": {
            "id": "412130213",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "A flash of brilliance often doesn't make sense. For example, Paimon's appetite for Sticky Honey Roast!",
            "nextDialogs": [
              "412130214"
            ]
          },
          "412130214": {
            "id": "412130214",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Ah... Which reminds me, I didn't eat much today.",
            "nextDialogs": [
              "412130215"
            ]
          },
          "412130215": {
            "id": "412130215",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "I went looking for you right after completing my experiment. Then, on the way, I ran into an adventurer trapped in the snow. I spent quite some time saving him...",
            "nextDialogs": [
              "412130216"
            ]
          },
          "412130216": {
            "id": "412130216",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "*rumbling*",
            "nextDialogs": [
              "412130217"
            ]
          },
          "412130217": {
            "id": "412130217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did your stomach just rumble?",
            "nextDialogs": [
              "412130218"
            ]
          },
          "412130218": {
            "id": "412130218",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Ah... Ahhhh! N—No, it's not like that...",
            "nextDialogs": [
              "412130219"
            ]
          },
          "412130219": {
            "id": "412130219",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Don't be so shy! Just say what's on your mind!",
            "nextDialogs": [
              "412130220"
            ]
          },
          "412130220": {
            "id": "412130220",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Um, um...",
            "nextDialogs": [
              "412130221"
            ]
          },
          "412130221": {
            "id": "412130221",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let Paimon help you out: Paimon's hungry! We should grab something to eat!"
          }
        }
      }
    },
    {
      "subId": "4121306",
      "subQuestName": "Follow Sucrose to the adventurer camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412130601"
        ],
        "dialogs": {
          "412130601": {
            "id": "412130601",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "The dragon's power... the dragon's life force can revive withered plants and empower them to such a degree...",
            "nextDialogs": [
              "412130602"
            ]
          },
          "412130602": {
            "id": "412130602",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Inconceivable!",
            "nextDialogs": [
              "412130603"
            ]
          },
          "412130603": {
            "id": "412130603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How could a dead tree stump turn out to be such a monster!?",
            "nextDialogs": [
              "412130604"
            ]
          },
          "412130604": {
            "id": "412130604",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon almost got swallowed!",
            "nextDialogs": [
              "412130605"
            ]
          },
          "412130605": {
            "id": "412130605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyway, why hasn't anything like that happened before?",
            "nextDialogs": [
              "412130606"
            ]
          },
          "412130606": {
            "id": "412130606",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Most probably it's because the sword fell to the ground. The impact must've caused its power to leak out.",
            "nextDialogs": [
              "412130607"
            ]
          },
          "412130607": {
            "id": "412130607",
            "speakerId": 1002,
            "speakerName": "Reckless Pallad",
            "text": "It's my fault! Don't make me leave! I beg you!",
            "nextDialogs": [
              "412130608"
            ]
          },
          "412130608": {
            "id": "412130608",
            "speakerId": 1002,
            "speakerName": "Reckless Pallad",
            "text": "I promise I'll stay put!",
            "nextDialogs": [
              "412130609"
            ]
          },
          "412130609": {
            "id": "412130609",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Ah, Mr. Pallad... There's no need to go into a fetal position...",
            "nextDialogs": [
              "412130610"
            ]
          },
          "412130610": {
            "id": "412130610",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "*sigh*",
            "nextDialogs": [
              "412130611"
            ]
          },
          "412130611": {
            "id": "412130611",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "This Cryo Regisvine having originally withered up and died here... Is it because it hadn't been able to absorb the ambient corruption?",
            "nextDialogs": [
              "412130612"
            ]
          },
          "412130612": {
            "id": "412130612",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "After you purified the corruption, the resulting pure elemental energy not only revived it, but also enhanced it.",
            "nextDialogs": [
              "412130613"
            ]
          },
          "412130613": {
            "id": "412130613",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Pure life force will cause it to constantly regenerate itself... together with its fighting spirit.",
            "nextDialogs": [
              "412130616"
            ]
          },
          "412130616": {
            "id": "412130616",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "I also haven't encountered any similar incidents.",
            "nextDialogs": [
              "412130617"
            ]
          },
          "412130617": {
            "id": "412130617",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Yet I must admit that a phenomenon of this rarity, although unexpected, is a valuable discovery.",
            "nextDialogs": [
              "412130618"
            ]
          },
          "412130618": {
            "id": "412130618",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Sucrose.",
            "nextDialogs": [
              "412130619"
            ]
          },
          "412130619": {
            "id": "412130619",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Ah, yes!",
            "nextDialogs": [
              "412130620"
            ]
          },
          "412130620": {
            "id": "412130620",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Keep an eye on that adventurer. Take him back to the camp.",
            "nextDialogs": [
              "412130621"
            ]
          },
          "412130621": {
            "id": "412130621",
            "speakerId": 1001,
            "speakerName": "Sucrose",
            "text": "Yes sir!",
            "nextDialogs": [
              "412130622"
            ]
          },
          "412130622": {
            "id": "412130622",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "As for the matters at hand, I beg your pardon, Traveler... but I must ask for your further assistance.",
            "nextDialogs": [
              "412130623"
            ]
          },
          "412130623": {
            "id": "412130623",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll do what I can to help.",
            "nextDialogs": [
              "412130624"
            ]
          },
          "412130624": {
            "id": "412130624",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Such an unexpected mess, and we're the only ones who can clean it up. *sigh* It must be because we keep outdoing ourselves!"
          }
        }
      }
    },
    {
      "subId": "4121307",

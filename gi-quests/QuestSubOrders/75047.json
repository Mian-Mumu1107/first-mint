        "dialogs": {
          "750470301": {
            "id": "750470301",
            "speakerId": 1001,
            "speakerName": "Huruk",
            "text": "So sleepy. I want to sleep... But we have to stand here together...",
            "nextDialogs": [
              "750470302"
            ]
          },
          "750470302": {
            "id": "750470302",
            "speakerId": 1001,
            "speakerName": "Huruk",

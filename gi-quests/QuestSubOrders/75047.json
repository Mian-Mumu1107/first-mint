    {
      "subId": "7504704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750470401"
        ],
        "dialogs": {
          "750470401": {
            "id": "750470401",
            "speakerId": 1002,
            "speakerName": "Kusi",
            "text": "Well, that's my weight under control, but... Hmm? What's up?",
            "nextDialogs": [
              "750470403",
              "750470406",
              "750470410"
            ]
          },
          "750470403": {
            "id": "750470403",
            "speakerId": 1002,
            "speakerName": "Kusi",
            "text": "Ah, right. I'm one of the sentries stationed here, although I'm in vacation mode right now...",
            "nextDialogs": [
              "750470404"
            ]
          },
          "750470404": {
            "id": "750470404",
            "speakerId": 1002,
            "speakerName": "Kusi",
            "text": "So if something's come up, go look for the fella beside me, Yukom!"
          },
          "750470406": {
            "id": "750470406",
            "speakerId": 1002,
            "speakerName": "Kusi",
            "text": "Well, y'see, I've been getting a little heavier lately, so I've added lots of healthy veggies to my usual Grainfruit diet.",
            "nextDialogs": [
              "750470407"
            ]
          },
          "750470407": {
            "id": "750470407",
            "speakerId": 1002,
            "speakerName": "Kusi",
            "text": "But for some reason, my buddy Ur's been copying me by eating a whole bunch of grass... Not a disaster, since Saurians are omnivores, but I worry he can keep up with all his nutritional needs, eating all that grass...",
            "nextDialogs": [
              "750470408"
            ]
          },
          "750470408": {
            "id": "750470408",
            "speakerId": 1002,
            "speakerName": "Kusi",
            "text": "Guess I need to give him a bit of a talking-to later."
          },
          "750470410": {
            "id": "750470410",
            "speakerId": 1002,
            "speakerName": "Kusi",
            "text": "Sure. Safe travels, then, outlander."
          }
        }
      }
    }
  ]

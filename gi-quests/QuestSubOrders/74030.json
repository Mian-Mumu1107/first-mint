  "subQuests": [
    {
      "subId": "7403001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300101"
        ],
        "dialogs": {
          "740300101": {
            "id": "740300101",
            "speakerId": 5214,
            "speakerName": "Galvaryet",
            "text": "Hello, what is it?",
            "nextDialogs": [
              "740300103",
              "740300106"
            ]
          },
          "740300103": {
            "id": "740300103",
            "speakerId": 5214,
            "speakerName": "Galvaryet",
            "text": "Why are you talking like Lanoire? Just get to the point.",
            "nextDialogs": [
              "740300104"
            ]
          },
          "740300104": {
            "id": "740300104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We need lots of Coupons. Are there any jobs we can take?",
            "nextDialogs": [
              "740300107"
            ]
          },
          "740300107": {
            "id": "740300107",
            "speakerId": 5214,
            "speakerName": "Galvaryet",
            "text": "You didn't join Estienne's game, did you? You should know when to stop.",
            "nextDialogs": [
              "740300108"
            ]
          },
          "740300108": {
            "id": "740300108",
            "speakerId": 5214,
            "speakerName": "Galvaryet",
            "text": "...Nonetheless, there is something that I need your help with.",
            "nextDialogs": [
              "740300109"
            ]
          },
          "740300109": {
            "id": "740300109",
            "speakerId": 5214,
            "speakerName": "Galvaryet",
            "text": "Clynes should be repairing his device or whatever it is by the Rift of Erosion. Go help him out, would you?",
            "nextDialogs": [
              "740300110"
            ]
          },
          "740300110": {
            "id": "740300110",
            "speakerId": 5214,
            "speakerName": "Galvaryet",
            "text": "Just ask him for compensation. He won't object.",
            "nextDialogs": [
              "740300111"
            ]
          },
          "740300111": {
            "id": "740300111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We'll take care of it!"
          },
          "740300106": {
            "id": "740300106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It would be better if there's compensation!"
          }
        }
      }
    },
    {
      "subId": "7403002",
      "subQuestName": "Find Clynes near the Rift of Erosion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300201"
        ],
        "dialogs": {
          "740300201": {
            "id": "740300201",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Just in time. Come help me out!",
            "nextDialogs": [
              "740300203",
              "740300207"
            ]
          },
          "740300203": {
            "id": "740300203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Galvaryet sent us to help you... But how did you know that?",
            "nextDialogs": [
              "740300204"
            ]
          },
          "740300204": {
            "id": "740300204",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "...Because you're the only ones here to help.",
            "nextDialogs": [
              "740300205"
            ]
          },
          "740300205": {
            "id": "740300205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Well, that makes sense!",
            "nextDialogs": [
              "740300210"
            ]
          },
          "740300210": {
            "id": "740300210",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Anyway, the task is nothing difficult. The Research Terminal here requires two people to operate it simultaneously, and I've already entered the commands. Just walk over and pull the lever.",
            "nextDialogs": [
              "740300211"
            ]
          },
          "740300211": {
            "id": "740300211",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "I almost forgot... The charging device should be nearby. Please install the charging device first before starting.",
            "nextDialogs": [
              "740300212"
            ]
          },
          "740300212": {
            "id": "740300212",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "And... Just to double-check, you're not machine killers, are you?"
          },
          "740300207": {
            "id": "740300207",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "I'll ask Galvaryet to apply for your payment later.",
            "nextDialogs": [
              "740300208"
            ]
          },
          "740300208": {
            "id": "740300208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? She said we can get compensation from you directly.",
            "nextDialogs": [
              "740300209"
            ]
          },
          "740300209": {
            "id": "740300209",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Did she? Alright, then. Applying for funds here is even harder than from the Fontaine Research Institute..."
          }
        }
      }
    },
    {
      "subId": "7403003",
      "subQuestName": "Help Clynes operate the terminal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300301"
        ],
        "dialogs": {
          "740300301": {
            "id": "740300301",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Is there something you don't understand? Just pull the lever along with me — very simple."
          }
        }
      }
    },
    {
      "subId": "7403004",
      "subQuestName": "Talk to Clynes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740300401"
        ],
        "dialogs": {
          "740300401": {
            "id": "740300401",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Looking good. If we weren't in a place like this, I would have hired you as my assistants.",
            "nextDialogs": [
              "740300402"
            ]
          },
          "740300402": {
            "id": "740300402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is too easy. By the way, what does this device do?",
            "nextDialogs": [
              "740300403"
            ]
          },
          "740300403": {
            "id": "740300403",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "There was a rift that connected to the outside, and it had to be watched. Now we can just seal the passage with this device and save manpower.",
            "nextDialogs": [
              "740300404"
            ]
          },
          "740300404": {
            "id": "740300404",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "This is nothing new to the Fontaine Research Institute, anyway. But since I have plenty of time, I modified it a little.",
            "nextDialogs": [
              "740300405"
            ]
          },
          "740300405": {
            "id": "740300405",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "What you're seeing now isn't even its final form, which was actually deployed at the Geode Mine Shaft... Ahem, I think I spoke too much. Just pretend you didn't hear anything.",
            "nextDialogs": [
              "740300407",
              "740300409"
            ]
          },
          "740300407": {
            "id": "740300407",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Right, you're a smart one. But if you were smarter, you would have kept that to yourself and not blurted it out.",
            "nextDialogs": [
              "740300411"
            ]
          },
          "740300411": {
            "id": "740300411",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Anyway, problem solved. Galvana no longer needs to come down too often, and I can take a break.",
            "nextDialogs": [
              "740300412"
            ]
          },
          "740300412": {
            "id": "740300412",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "...Ah, yes. I almost forgot about your compensation. Thanks for the help!"
          },
          "740300409": {
            "id": "740300409",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "Of course! There are other components... Wait, why do you want to know?",
            "nextDialogs": [
              "740300410"
            ]
          },
          "740300410": {
            "id": "740300410",
            "speakerId": 5252,
            "speakerName": "Clynes",
            "text": "If you want to know the full extent of it, you can give it a try yourself. But if you're caught, don't say I put you up to it."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7050401",
      "subQuestName": "Talk to Luka and enter the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705040101"
        ],
        "dialogs": {
          "705040101": {
            "id": "705040101",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Well, well. This is a surprise. I didn't expect to see you two behind the counter today.",
            "nextDialogs": [
              "705040102"
            ]
          },
          "705040102": {
            "id": "705040102",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "In that case, I'd like a Death After Noon...",
            "nextDialogs": [
              "705040103"
            ]
          },
          "705040103": {
            "id": "705040103",
            "speakerId": 1001,
            "speakerName": "Rosaria",
            "text": "Leave it to Kaeya to make things difficult right from the start...",
            "nextDialogs": [
              "705040104"
            ]
          },
          "705040104": {
            "id": "705040104",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "#Come now, I just wanted to see how {F#she'd}{M#he'd} react. I admit I didn't expect to see you here today, Sister Rosaria.",
            "nextDialogs": [
              "705040105"
            ]
          },
          "705040105": {
            "id": "705040105",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "With so many demanding customers that frequent the tavern, I only thought I'd help the Traveler gain some experience.",
            "nextDialogs": [
              "705040106"
            ]
          },
          "705040106": {
            "id": "705040106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "There he goes with that smooth talk again!",
            "nextDialogs": [
              "705040107"
            ]
          },
          "705040107": {
            "id": "705040107",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Don't get me wrong, I was only trying to be helpful! If anything, you should be thanking me. Now, how about we start with something simple like a Moonlit Alley, for instance.",
            "nextDialogs": [
              "705040108"
            ]
          },
          "705040108": {
            "id": "705040108",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Oh, and make it a large, please.",
            "nextDialogs": [
              "705040109"
            ]
          },
          "705040109": {
            "id": "705040109",
            "speakerId": 1001,
            "speakerName": "Rosaria",
            "text": "I'll leave my drink up to you. Just make it a tea of some kind, and not too big.",
            "nextDialogs": [
              "705040110"
            ]
          },
          "705040110": {
            "id": "705040110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it. Coming right up.",
            "nextDialogs": [
              "705040111"
            ]
          },
          "705040111": {
            "id": "705040111",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Please, take your time. Waiting in anticipation is half the fun."
          }
        }
      }
    },

        ],
        "dialogs": {
          "752440501": {
            "id": "752440501",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "Alright, I'll help you look."
          }
        }
      }
    },
    {
      "subId": "7524402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440201"
        ],
        "dialogs": {
          "752440201": {
            "id": "752440201",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "Hey there! Have you found my hat?",
            "nextDialogs": [
              "752440202"
            ]
          },
          "752440202": {
            "id": "752440202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This one?"
          }
        }
      }
    },
    {
      "subId": "7524403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440302"
        ],
        "dialogs": {
          "752440302": {
            "id": "752440302",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "That's it! Oh, thank you so much! Now that I've got my sturdy hat again, I feel so much more at ease.",
            "nextDialogs": [
              "752440303"
            ]
          },
          "752440303": {
            "id": "752440303",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "It's a special helmet I had someone make for me — it can even block shots from a musket.",
            "nextDialogs": [
              "752440307"
            ]
          },
          "752440307": {
            "id": "752440307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're overthinking things. It's just fishing...",
            "nextDialogs": [
              "752440304"
            ]
          },
          "752440304": {
            "id": "752440304",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "It might sound crazy, but some time ago, there was a guy fishing right around here when someone shot out his eye. Might've been a musket, might've been a bow. Fishing's a dangerous sport, y'see?",
            "nextDialogs": [
              "752440305"
            ]
          },
          "752440305": {
            "id": "752440305",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "I heard tell the whole affair was some sort of power struggle in the Nod-Krai underworld... Who knows the truth? The fact that it happened at all means we should be careful!"
          }
        }
      }
    },
    {
      "subId": "7524401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440101"
        ],
        "dialogs": {
          "752440101": {
            "id": "752440101",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "Oh, hey, are you here to fish too? Well, if you know fishing, you'll understand the need for a sturdy hat.",
            "nextDialogs": [
              "752440106"
            ]
          },
          "752440106": {
            "id": "752440106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Why do you need a hat?",
            "nextDialogs": [
              "752440102"
            ]
          },
          "752440102": {
            "id": "752440102",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "Why? Because a sturdy hat'll keep you safe.",
            "nextDialogs": [
              "752440107"
            ]
          },
          "752440107": {
            "id": "752440107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But you're not wearing a hat...",
            "nextDialogs": [
              "752440103"
            ]
          },
          "752440103": {
            "id": "752440103",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "That's why I'm talking to you... You see, the wind blew my hat away.",
            "nextDialogs": [
              "752440104"
            ]
          },
          "752440104": {
            "id": "752440104",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "If you don't mind, could you help me find it?",
            "nextDialogs": [
              "752440108"
            ]
          },
          "752440108": {
            "id": "752440108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why don't you look for it yourself?",
            "nextDialogs": [
              "752440105"
            ]
          },
          "752440105": {
            "id": "752440105",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "If I go looking for my sturdy hat, I'll have to put down my fishing rod. But if I keep holding my rod, I can't go looking for my hat...",
            "nextDialogs": [
              "752440109"
            ]
          },
          "752440109": {
            "id": "752440109",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "Please, I'm begging you to help."
          }
        }
      }
    },
    {
      "subId": "7524404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440402"
        ],
        "dialogs": {
          "752440402": {
            "id": "752440402",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "Still worried about those ruffians? Don't be. If you do run into them, just tell them my name and they'll leave you alone.",
            "nextDialogs": [
              "752440403"
            ]
          },
          "752440403": {
            "id": "752440403",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "But don't go asking me why now. The two of us were destined to meet — you even helped me get my hat back. Just think of it as a token of my gratitude."
          }
        }
      }
    },
    {
      "subId": "7524406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440601"
        ],
        "dialogs": {
          "752440601": {
            "id": "752440601",
            "speakerId": 1000,
            "speakerName": "Rantiy",
            "text": "Sorry, I have to go."
          }
        }
      }
    }
  ]
}
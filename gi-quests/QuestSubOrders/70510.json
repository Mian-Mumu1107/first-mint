        "dialogs": {
          "705100401": {
            "id": "705100401",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "Wow... Business certainly has been picking up in the tavern recently.",
            "nextDialogs": [
              "705100402"
            ]
          },
          "705100402": {
            "id": "705100402",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "Some customers came for the drinks, but most came for you.",
            "nextDialogs": [
              "705100403"
            ]
          },
          "705100403": {
            "id": "705100403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Why is that still hard to believe...",
            "nextDialogs": [
              "705100404"
            ]
          },
          "705100404": {
            "id": "705100404",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "I've never seen a more successful Bartender Academy Week. We earned both money and reputation this time.",
            "nextDialogs": [
              "705100405"
            ]
          },
          "705100405": {
            "id": "705100405",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "Anyway, well done my friends.",
            "nextDialogs": [
              "705100406"
            ]
          },
          "705100406": {
            "id": "705100406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, it's only been a few days and now we're buddies?",
            "nextDialogs": [
              "705100409"
            ]
          },
          "705100409": {
            "id": "705100409",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "I've been meaning to ask, would you consider staying and working here?",
            "nextDialogs": [
              "705100410"
            ]
          },
          "705100410": {
            "id": "705100410",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#No can do. Though unlimited refills is enticing, Paimon made a promise to keep traveling with {F#her}{M#him}.",
            "nextDialogs": [
              "705100411"
            ]
          },
          "705100411": {
            "id": "705100411",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "Okay then, I won't twist your arm. In fact, Charles had mentioned that to me, as well.",
            "nextDialogs": [
              "705100412"
            ]
          },
          "705100412": {
            "id": "705100412",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "Well, feel free to come back and visit the Angel's Share whenever you like. And, remember to bring your friends!",
            "nextDialogs": [
              "705100413"
            ]
          },
          "705100413": {
            "id": "705100413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure thing.",
            "nextDialogs": [
              "705100414"
            ]
          },
          "705100414": {
            "id": "705100414",
            "speakerId": 1000,
            "speakerName": "Luka",
            "text": "Good luck on your journey, Traveler!"
          }
        }
      }
    }
  ]
}
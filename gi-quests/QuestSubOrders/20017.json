      }
    },
    {
      "subId": "2001707",
      "subQuestName": "Collect rope",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2001708",
      "subQuestName": "Give the rope to Farrah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170601"
        ],
        "dialogs": {
          "200170601": {
            "id": "200170601",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Perfect. That'll see me as far the city, at least.",
            "nextDialogs": [
              "200170602"
            ]
          },
          "200170602": {
            "id": "200170602",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Thanks for your help, Traveler. May we meet again.",
            "nextDialogs": [
              "200170603"
            ]
          },
          "200170603": {
            "id": "200170603",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Ugh, how am I going to get rid of this awful smell..."
          }
        }
      }
    },
    {
      "subId": "2001702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170201"
        ],
        "dialogs": {
          "200170201": {
            "id": "200170201",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "There should be plenty of <color=#00E1FFFF>Sturdy Planks</color> in the forest. Please hurry, if we wait too much longer all the fruit will be lost."
          }
        }
      }
    },
    {
      "subId": "2001704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170401"
        ],
        "dialogs": {
          "200170401": {
            "id": "200170401",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Thank you so much, Traveler.",
            "nextDialogs": [
              "200170402"
            ]
          },
          "200170402": {
            "id": "200170402",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Although, they seem pretty persistent. I can't stay here any longer, it's just too dangerous.",
            "nextDialogs": [
              "200170403"
            ]
          },
          "200170403": {
            "id": "200170403",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "They've bashed up the cart yet again. There's no point me trying to fix it up perfectly... I guess I'll just have to make do by wrapping a rope— Oh for heaven's sake, where is my rope!?",
            "nextDialogs": [
              "200170404"
            ]
          },
          "200170404": {
            "id": "200170404",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "I cannot believe this! Those monsters must've run off with it. Traveler... how's about you see if you can't find me a nice bit of <color=#00E1FFFF>rope</color> around here...?"
          }
        }
      }
    },
    {
      "subId": "2001708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170801"
        ],
        "dialogs": {
          "200170801": {
            "id": "200170801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm leaving this one to you.",
            "nextDialogs": [
              "200170802"
            ]
          },
          "200170802": {
            "id": "200170802",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Wait! Please... Smell that? Now imagine that, but a thousand times worse — that'll be my cart if I don't shift all this fruit before long! Please help me."
          }
        }
      }
    },
    {
      "subId": "2001710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200171001"
        ],
        "dialogs": {
          "200171001": {
            "id": "200171001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Certainly not!",
            "nextDialogs": [
              "200171002"
            ]
          },
          "200171002": {
            "id": "200171002",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Hey, wait! Wh—What if they come back, then what am I supposed to do!? An artillery of apples won't do much good!",
            "nextDialogs": [
              "200171003"
            ]
          },
          "200171003": {
            "id": "200171003",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Come on, without your help I'll be done for!"
          }
        }
      }
    }
  ]
}
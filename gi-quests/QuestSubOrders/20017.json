  "subQuests": [
    {
      "subId": "2001709",
      "subQuestName": "Go and investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170901"
        ],
        "dialogs": {
          "200170901": {
            "id": "200170901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Certainly!",
            "nextDialogs": [
              "200170902"
            ]
          },
          "200170902": {
            "id": "200170902",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "I appreciate it! Those monsters seem to want anything and everything they can get their hands on."
          }
        }
      }
    },
    {
      "subId": "2001701",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170101"
        ],
        "dialogs": {
          "200170101": {
            "id": "200170101",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "No, please! Don't hurt me! No— ah? Traveler, where did all the hilichurls go?",
            "nextDialogs": [
              "200170102"
            ]
          },
          "200170102": {
            "id": "200170102",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Great! Thank you so much! Are they really all gone?",
            "nextDialogs": [
              "200170103"
            ]
          },
          "200170103": {
            "id": "200170103",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Phew... I owe you. That said, after all that fuss I won't be able to catch up to the caravan now.",
            "nextDialogs": [
              "200170104"
            ]
          },
          "200170104": {
            "id": "200170104",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "What's more my cart is broken. I need to get it fixed and head to the city before the fruit goes bad.",
            "nextDialogs": [
              "200170105"
            ]
          },
          "200170105": {
            "id": "200170105",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Once this much fruit goes bad— You can't even imagine the smell. I'll never manage to wash it out.",
            "nextDialogs": [
              "200170106"
            ]
          },
          "200170106": {
            "id": "200170106",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "I'm going to have to take stock again... I can already smell some of the fruit going bad.",
            "nextDialogs": [
              "200170107"
            ]
          },
          "200170107": {
            "id": "200170107",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Can you please help me by taking a look around for some materials to fix my cart with? A <color=#00E1FFFF>Sturdy Plank</color> should be enough to do it."
          }
        }
      }
    },
    {
      "subId": "2001702",
      "subQuestName": "Talk to Farrah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170701"
        ],
        "dialogs": {
          "200170701": {
            "id": "200170701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "200170702"
            ]
          },
          "200170702": {
            "id": "200170702",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Great! I'll wait for you here. Ugh, I wish I could find the fruits that have gone bad already..."
          }
        }
      }
    },
    {
      "subId": "2001703",
      "subQuestName": "Collect wood",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170301"
        ],
        "dialogs": {
          "200170301": {
            "id": "200170301",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "This is plenty. I'll get this cart fixed up as soon as I've washed my hands...",
            "nextDialogs": [
              "200170302"
            ]
          },
          "200170302": {
            "id": "200170302",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "Huh? They're— they're back...! Traveler! They're baaaack!!!"
          }
        }
      }
    },
    {
      "subId": "2001704",
      "subQuestName": "Give the Sturdy Plank to Farrah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2001705",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170501"
        ],
        "dialogs": {
          "200170501": {
            "id": "200170501",
            "speakerId": 1000,
            "speakerName": "Farrah",
            "text": "There has to be some rope nearby. Please, if you could just take a look for me."
          }
        }
      }
    },
    {
      "subId": "2001706",
      "subQuestName": "Talk to Farrah",
      "sceneId": null,
      "locations": [],

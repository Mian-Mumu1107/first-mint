  "subQuests": [
    {
      "subId": "7167101",
      "subQuestName": "Talk to Keqing and Yelan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716710101"
        ],
        "dialogs": {
          "716710101": {
            "id": "716710101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whew, this domain is messed up — no wonder even Yelan found it dicey...",
            "nextDialogs": [
              "716710102"
            ]
          },
          "716710102": {
            "id": "716710102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Which major historical battle do you think is being re-enacted here? Feels like one where most soldiers would be way out of their depth...",
            "nextDialogs": [
              "716710105"
            ]
          },
          "716710105": {
            "id": "716710105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yikes, hopefully not! ...Surely not, right? Please tell Paimon you're exaggerating!",
            "nextDialogs": [
              "716710106"
            ]
          },
          "716710106": {
            "id": "716710106",
            "speakerId": 1001,
            "speakerName": "Keqing",
            "text": "Ah, you're back.",
            "nextDialogs": [
              "716710107"
            ]
          },
          "716710107": {
            "id": "716710107",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "And... by the look on your face, I'm guessing this is a triumphant return after all?",
            "nextDialogs": [
              "716710108"
            ]
          },
          "716710108": {
            "id": "716710108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sure is! But it was really, really scary in there!",
            "nextDialogs": [
              "716710109"
            ]
          },
          "716710109": {
            "id": "716710109",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You describe the battles you fought to Keqing and Yelan...",
            "nextDialogs": [
              "716710110"
            ]
          },
          "716710110": {
            "id": "716710110",
            "speakerId": 1001,
            "speakerName": "Keqing",
            "text": "Incredible... You did very well to brave all of that and still emerge victorious. Good work!",
            "nextDialogs": [
              "716710111"
            ]
          },
          "716710111": {
            "id": "716710111",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "After you entered the domain, there was a sharp drop in stray monsters out here.",
            "nextDialogs": [
              "716710112"
            ]
          },
          "716710112": {
            "id": "716710112",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "And although you didn't eliminate the root of the problem, it's plain to see you've weakened the Ley Line disturbance considerably.",
            "nextDialogs": [
              "716710113"
            ]
          },
          "716710113": {
            "id": "716710113",
            "speakerId": 1001,
            "speakerName": "Keqing",
            "text": "Which means you've weakened the monsters as well. Now, any rank-and-file soldiers can comfortably fend them off."
          }
        }
      }
    }
  ]
}
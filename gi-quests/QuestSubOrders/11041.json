    {
      "subId": "1104106",
      "subQuestName": "Speak with Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110410601"
        ],
        "dialogs": {
          "110410601": {
            "id": "110410601",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Who are you? Why did you alarm them?",
            "nextDialogs": [
              "110410602"
            ]
          },
          "110410602": {
            "id": "110410602",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Thank the gods I'd already completed my painting. Would've been a shame to leave these particular hilichurls unfinished.",
            "nextDialogs": [
              "110410605"
            ]
          },
          "110410605": {
            "id": "110410605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's up with painting hilichurls? What makes them so interesting?",
            "nextDialogs": [
              "110410606"
            ]
          },
          "110410606": {
            "id": "110410606",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Hmm, I'm afraid the answer isn't easy to explain. If you'd like to have a look at my painting, it may give you a clue."
          }
        }
      }
    }
  ]

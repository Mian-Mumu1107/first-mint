            ]
          },
          "715340303": {
            "id": "715340303",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "#You have my thanks, {NICKNAME}. The next time you visit Inazuma, I will treat you to a round of tea."
          }

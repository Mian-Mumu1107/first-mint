  "subQuests": [
    {
      "subId": "7153401",
      "subQuestName": "Wait till 08:00 – 18:00 the next day",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715340101"
        ],
        "dialogs": {
          "715340101": {
            "id": "715340101",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "Hmm, I should probably take a look at the other envelopes first...",
            "nextDialogs": [
              "715340102"
            ]
          },
          "715340102": {
            "id": "715340102",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "#Oh, {NICKNAME}! It's been a while... Why do you look so surprised?",
            "nextDialogs": [
              "715340103"
            ]
          },
          "715340103": {
            "id": "715340103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I just didn't expect...",
            "nextDialogs": [
              "715340104"
            ]
          },
          "715340104": {
            "id": "715340104",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "To see a warrior like me enjoying Lantern Rite?",
            "nextDialogs": [
              "715340105"
            ]
          },
          "715340105": {
            "id": "715340105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't think I've ever seen you relax...",
            "nextDialogs": [
              "715340106"
            ]
          },
          "715340106": {
            "id": "715340106",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "The Tenryou Commission bears a great responsibility to the people. As a member, I cannot afford to relax most of the time.",
            "nextDialogs": [
              "715340107"
            ]
          },
          "715340107": {
            "id": "715340107",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "Perhaps people think of me as a single-minded warrior, completely out of place in a festive and refined neighborhood like Hanamizaka.",
            "nextDialogs": [
              "715340108"
            ]
          },
          "715340108": {
            "id": "715340108",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "But, letting down my guard means allowing crime to slip through... That is not only a detriment to my duty but to the atmosphere of Hanamizaka as a whole.",
            "nextDialogs": [
              "715340109"
            ]
          },
          "715340109": {
            "id": "715340109",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "The most I can do is take advantage of any spare moment that comes my way.",
            "nextDialogs": [
              "715340110"
            ]
          },
          "715340110": {
            "id": "715340110",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "Ah, apologies. I shouldn't talk about such serious matters during the holidays.",
            "nextDialogs": [
              "715340111"
            ]
          },
          "715340111": {
            "id": "715340111",
            "speakerId": 1000,
            "speakerName": "Kujou Sara",
            "text": "I'm trying to make a gift envelope, but it's not quite coming together. Perhaps you could give me some advice?",
            "nextDialogs": [
              "715340112"
            ]
          },
          "715340112": {
            "id": "715340112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure, let me think about it for a second..."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1111201",
      "subQuestName": "Return to Wangsheng Funeral Parlor and find out what happened",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111120101"
        ],
        "dialogs": {
          "111120101": {
            "id": "111120101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "After all that's happened, Paimon's not even sure what's going on anymore.",
            "nextDialogs": [
              "111120104"
            ]
          },
          "111120104": {
            "id": "111120104",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "Actually, I'm not surprised in the slightest. Remember what I said? There's only so many evil spirits in this world.",
            "nextDialogs": [
              "111120105"
            ]
          },
          "111120105": {
            "id": "111120105",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "It was a twist of fate that made him leave Wuwang Hill in the first place. Now, for some reason, he can't go back.",
            "nextDialogs": [
              "111120106"
            ]
          },
          "111120106": {
            "id": "111120106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This explanation sounds a bit far-fetched to Paimon.",
            "nextDialogs": [
              "111120107"
            ]
          },
          "111120107": {
            "id": "111120107",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "Actually... she pretty much summed it up.",
            "nextDialogs": [
              "111120108"
            ]
          },
          "111120108": {
            "id": "111120108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ehh!?",
            "nextDialogs": [
              "111120109"
            ]
          },
          "111120109": {
            "id": "111120109",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "Hehe, don't ever question my professional instincts!",
            "nextDialogs": [
              "111120110"
            ]
          },
          "111120110": {
            "id": "111120110",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "I just wanted to check up on my friends. That's why I came to Liyue Harbor.",
            "nextDialogs": [
              "111120111"
            ]
          },
          "111120111": {
            "id": "111120111",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "I promise I wasn't up to any mischief! I never wanted to scare anyone!",
            "nextDialogs": [
              "111120112"
            ]
          },
          "111120112": {
            "id": "111120112",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "A few days ago, some people came to Wuwang Hill on a dare. I heard them saying they'd come from Liyue Harbor, so I followed one of them back and ended up here.",
            "nextDialogs": [
              "111120113"
            ]
          },
          "111120113": {
            "id": "111120113",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "Ah, it must've been poor Luocheng that you followed. Maybe he didn't notice you, but he could still feel your presence. Now we know what caused his nightmares.",
            "nextDialogs": [
              "111120114"
            ]
          },
          "111120114": {
            "id": "111120114",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "I—I was discovered?",
            "nextDialogs": [
              "111120115"
            ]
          },
          "111120115": {
            "id": "111120115",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "Well, I assume so, otherwise he wouldn't have been scared half to death.",
            "nextDialogs": [
              "111120116"
            ]
          },
          "111120116": {
            "id": "111120116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why didn't you come looking for Meng sooner?",
            "nextDialogs": [
              "111120117"
            ]
          },
          "111120117": {
            "id": "111120117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, Hu Tao and Meng were searching for you all over the place.",
            "nextDialogs": [
              "111120118"
            ]
          },
          "111120118": {
            "id": "111120118",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "Oh, that's because I couldn't find them. It's my first time in Liyue Harbor and I got lost in the city.",
            "nextDialogs": [
              "111120119"
            ]
          },
          "111120119": {
            "id": "111120119",
            "speakerId": 10343,
            "speakerName": "Meng",
            "text": "Now that you mention it, Big G always had a poor sense of direction. When we were kids, he'd never go down the hill by himself. We always had to lead him.",
            "nextDialogs": [
              "111120120"
            ]
          },
          "111120120": {
            "id": "111120120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So all of this was just because you got lost!?",
            "nextDialogs": [
              "111120121"
            ]
          },
          "111120121": {
            "id": "111120121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why didn't you just fly? Like any other ghost or spirit? Don't you think it's much easier to find your way from up above?",
            "nextDialogs": [
              "111120122"
            ]
          },
          "111120122": {
            "id": "111120122",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "I... can't.",
            "nextDialogs": [
              "111120123"
            ]
          },
          "111120123": {
            "id": "111120123",
            "speakerId": 10344,
            "speakerName": "Big G",
            "text": "It's too high for me, I'd get scared.",
            "nextDialogs": [
              "111120124"
            ]
          },
          "111120124": {
            "id": "111120124",
            "speakerId": 10343,
            "speakerName": "Meng",
            "text": "That's right, yes! He used to be so afraid of heights that he wouldn't even so much as look down the hill.",
            "nextDialogs": [
              "111120125"
            ]
          },
          "111120125": {
            "id": "111120125",
            "speakerId": 10343,
            "speakerName": "Meng",
            "text": "Hahaha, you haven't changed a bit!"
          }
        }
      }
    },
    {
      "subId": "1111202",
      "subQuestName": "Ask Little Wu for a keepsake",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111120201"
        ],
        "dialogs": {
          "111120201": {
            "id": "111120201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Hi... Eh-he... Do you remember us?",
            "nextDialogs": [
              "111120202"
            ]
          },
          "111120202": {
            "id": "111120202",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "Ugh, you... Sorry, I won't be needing the funeral parlor's services anytime soon.",
            "nextDialogs": [
              "111120205"
            ]
          },
          "111120205": {
            "id": "111120205",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "Yes, we grew up together. We still keep in touch even now.",
            "nextDialogs": [
              "111120206"
            ]
          },
          "111120206": {
            "id": "111120206",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "I don't know why he started working for Wangsheng Funeral Parlor. To be honest, I find their director to be quite peculiar.",
            "nextDialogs": [
              "111120207"
            ]
          },
          "111120207": {
            "id": "111120207",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "But he must've had his reasons. He's on his own now after all, and he still can't get over what happened to Big G.",
            "nextDialogs": [
              "111120208"
            ]
          },
          "111120208": {
            "id": "111120208",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "Did he tell you about it?",
            "nextDialogs": [
              "111120209"
            ]
          },
          "111120209": {
            "id": "111120209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, he did. Um, if you could pick one thing to give to Big G as a keepsake, what would you choose?",
            "nextDialogs": [
              "111120210"
            ]
          },
          "111120210": {
            "id": "111120210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Just, y'know, theoretically speaking. We're just being hypothetical here, definitely not gonna actually go commemorate him or anything..."
          }
        }
      }
    },
    {
      "subId": "1111222",
      "subQuestName": "Find Jueyun Chili and give it to Little Wu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111122201"
        ],
        "dialogs": {
          "111122201": {
            "id": "111122201",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "Jueyun Chilis are a common sight in Liyue. I can rustle that dish up in no time if you help me find some."
          }
        }
      }
    },
    {
      "subId": "1111203",
      "subQuestName": "Talk to Little Wu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111120301"
        ],
        "dialogs": {
          "111120301": {
            "id": "111120301",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "Great, this should be enough.",
            "nextDialogs": [
              "111120302"
            ]
          },
          "111120302": {
            "id": "111120302",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "I'll get started on the Jueyun Chili Chicken. I guess you've got other folks to track down?",
            "nextDialogs": [
              "111120303"
            ]
          },
          "111120303": {
            "id": "111120303",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "When everyone's ready, I'll get the dish over to ya.",
            "nextDialogs": [
              "111120304"
            ]
          },
          "111120304": {
            "id": "111120304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Great! See ya later!",
            "nextDialogs": [
              "111120305"
            ]
          },
          "111120305": {
            "id": "111120305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Uh... How did he know about the others...?)"
          }
        }
      }
    },
    {
      "subId": "1111204",
      "subQuestName": "Ask Mumu for a keepsake",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111120401"
        ],
        "dialogs": {
          "111120401": {
            "id": "111120401",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Ugh... not you again. I told you, I'm not interested in the inner workings of Wangsheng Funeral Parlor.",
            "nextDialogs": [
              "111120402"
            ]
          },
          "111120402": {
            "id": "111120402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Meng told us about you. You're good friends, right?",
            "nextDialogs": [
              "111120403"
            ]
          },
          "111120403": {
            "id": "111120403",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "That's true, yes. Come to think of it, I remember he did join Wangsheng Funeral Parlor recently.",
            "nextDialogs": [
              "111120404"
            ]
          },
          "111120404": {
            "id": "111120404",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "It didn't take long for his good friends to figure out why... The Big G incident.",
            "nextDialogs": [
              "111120405"
            ]
          },
          "111120405": {
            "id": "111120405",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "But I know there's nothing we can say to help him get over it. Letting go of the past is a painful process. I would know...",
            "nextDialogs": [
              "111120406"
            ]
          },
          "111120406": {
            "id": "111120406",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "So, is Big G the reason you're here to see me?",
            "nextDialogs": [
              "111120407"
            ]
          },
          "111120407": {
            "id": "111120407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How did you know!? We didn't even say anything.",
            "nextDialogs": [
              "111120408"
            ]
          },
          "111120408": {
            "id": "111120408",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Haha, I'm a businessman. I've got a sixth sense for this kind of thing!",
            "nextDialogs": [
              "111120409"
            ]
          },
          "111120409": {
            "id": "111120409",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Everyone hears the name \"Mumu\" and thinks I must be dim-witted. I never heard the end of it when I set up shop. But... I'd say I've proved a few people wrong.",
            "nextDialogs": [
              "111120410"
            ]
          },
          "111120410": {
            "id": "111120410",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Here, take this. It's a top-of-the-line toy box we all dreamed of owning as kids. Back then, none of us could afford it... We were penniless.",
            "nextDialogs": [
              "111120411"
            ]
          },
          "111120411": {
            "id": "111120411",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Today, business is booming. I ended up buying loads of these. It was a dream come true.",
            "nextDialogs": [
              "111120412"
            ]
          },
          "111120412": {
            "id": "111120412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, you must be like, super rich...",
            "nextDialogs": [
              "111120413"
            ]
          },
          "111120413": {
            "id": "111120413",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Haha... For me, it's a memento of a childhood long gone. Without it, we wouldn't be where we are today.",
            "nextDialogs": [
              "111120414"
            ]
          },
          "111120414": {
            "id": "111120414",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "So, having found me, I guess you'll be looking for Little Wu and Congzi next?",
            "nextDialogs": [
              "111120415"
            ]
          },
          "111120415": {
            "id": "111120415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mm-hmm! We already saw Little Wu, now we gotta find Congzi.",
            "nextDialogs": [
              "111120416"
            ]
          },
          "111120416": {
            "id": "111120416",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "I see. If it's Congzi you're after, let's meet at the overpass at Feiyun Slope. It's just above the staircase leading down to the dock.",
            "nextDialogs": [
              "111120417"
            ]
          },
          "111120417": {
            "id": "111120417",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "I've got an errand to run. I'll come find you as soon as I'm done."
          }
        }
      }
    },
    {
      "subId": "1111205",
      "subQuestName": "Ask Congzi for a keepsake",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111120501"
        ],
        "dialogs": {
          "111120501": {
            "id": "111120501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? You're all here?",
            "nextDialogs": [
              "111120502"
            ]
          },
          "111120502": {
            "id": "111120502",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "Reminiscing about old times, thinking back to past events... We've been at it for years.",
            "nextDialogs": [
              "111120503"
            ]
          },
          "111120503": {
            "id": "111120503",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Our hometown was completely destroyed in a disaster, so we've got nowhere to go back to. Now, home is wherever friends are.",
            "nextDialogs": [
              "111120504"
            ]
          },
          "111120504": {
            "id": "111120504",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "They've just been telling me you're looking for keepsakes?",
            "nextDialogs": [
              "111120505"
            ]
          },
          "111120505": {
            "id": "111120505",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "I make artisan Xiao Lanterns down by Liyue Harbor. I guess they represent me better than anything.",
            "nextDialogs": [
              "111120506"
            ]
          },
          "111120506": {
            "id": "111120506",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "A few days ago, I bought some quality Plaustrite Shards. They're currently all in the warehouse at the dock.",
            "nextDialogs": [
              "111120507"
            ]
          },
          "111120507": {
            "id": "111120507",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "I've already spoken to the manager. Could I ask you to retrieve them for me?",
            "nextDialogs": [
              "111120508"
            ]
          },
          "111120508": {
            "id": "111120508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like you already know what's going on! Be back in a jiffy."
          }
        }
      }
    },
    {
      "subId": "1111225",
      "subQuestName": "Talk to the Warehouse Manager",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111122501"
        ],
        "dialogs": {
          "111122501": {
            "id": "111122501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hi, we're here to pick up the Plaustrite Shards for Congzi!",
            "nextDialogs": [
              "111122502"
            ]
          },
          "111122502": {
            "id": "111122502",
            "speakerId": 2006,
            "speakerName": "Gou San'er",
            "text": "...I think she mentioned it... Yes, here you are in the register. No problem.",
            "nextDialogs": [
              "111122503"
            ]
          },
          "111122503": {
            "id": "111122503",
            "speakerId": 2006,
            "speakerName": "Gou San'er",
            "text": "The Plaustrite Shards are over in that crate there. Please, help yourselves."
          }
        }
      }
    },
    {
      "subId": "1111206",
      "subQuestName": "Look for a Plaustrite Shard in the pile of goods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1111223",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111122301"
        ],
        "dialogs": {
          "111122301": {
            "id": "111122301",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "Y'know, I just realized... mine's the only item that's been outright purchased. Yours are both handmade.",
            "nextDialogs": [
              "111122302"
            ]
          },
          "111122302": {
            "id": "111122302",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "But yours is worth a lot more.",
            "nextDialogs": [
              "111122303"
            ]
          },
          "111122303": {
            "id": "111122303",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "Worth in Mora is not what's important here. These things all played a big part in our childhood.",
            "nextDialogs": [
              "111122304"
            ]
          },
          "111122304": {
            "id": "111122304",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "They show that we will never forget our promise."
          }
        }
      }
    },
    {
      "subId": "1111208",
      "subQuestName": "Give the Plaustrite Shard to Congzi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111120801"
        ],
        "dialogs": {
          "111120801": {
            "id": "111120801",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "My thanks to both of you, this looks like great stuff. Please wait a moment, this is the final step.",
            "nextDialogs": [
              "111120802"
            ]
          },
          "111120802": {
            "id": "111120802",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "Okay, there we go.",
            "nextDialogs": [
              "111120803"
            ]
          },
          "111120803": {
            "id": "111120803",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "I wrote all five of our names inside the lantern. You know, during the annual Lantern Rite, we all release a lantern like this.",
            "nextDialogs": [
              "111120804"
            ]
          },
          "111120804": {
            "id": "111120804",
            "speakerId": 10348,
            "speakerName": "Congzi",
            "text": "No matter what the days may bring, whichever roads we choose to take... While this rite remains observed, each of us remains the same.",
            "nextDialogs": [
              "111120805"
            ]
          },
          "111120805": {
            "id": "111120805",
            "speakerId": 10346,
            "speakerName": "Little Wu",
            "text": "As for the matter of Big G... The three of us have discussed amongst ourselves and agreed we won't press you on it.",
            "nextDialogs": [
              "111120806"
            ]
          },
          "111120806": {
            "id": "111120806",
            "speakerId": 10347,
            "speakerName": "Mumu",
            "text": "But if you get the chance, please let him know... we're doing well.",
            "nextDialogs": [
              "111120807"

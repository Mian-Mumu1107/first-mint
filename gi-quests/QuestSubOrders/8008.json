        "dialogs": {
          "80080101": {
            "id": "80080101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mr. Miner, we're back and ready to report!",
            "nextDialogs": [
              "80080102"
            ]
          },
          "80080102": {
            "id": "80080102",
            "speakerId": 12423,
            "speakerName": "Yuehui",
            "text": "Ah! Am I glad to see you again! I was getting nervous... At first, I figured I'm paying a fair price, and these are professionals. But then I thought... Goodness, I'd hate to send someone off on a strange commission and then for something bad to happen to them...",
            "nextDialogs": [
              "80080103"
            ]
          },
          "80080103": {
            "id": "80080103",
            "speakerId": 12423,
            "speakerName": "Yuehui",
            "text": "I'd never be able to forgive myself if you came to any harm!",
            "nextDialogs": [
              "80080104"
            ]
          },
          "80080104": {
            "id": "80080104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't you worry, mister, it was nothing we couldn't handle! Anyway, we're back, aren't we? And the good news is, we got to the bottom of what's been going on!",
            "nextDialogs": [
              "80080105"
            ]
          },
          "80080105": {
            "id": "80080105",
            "speakerId": 12423,
            "speakerName": "Yuehui",
            "text": "Excellent, excellent! So then, what's the situation down there?",
            "nextDialogs": [
              "80080106"
            ]
          },
          "80080106": {
            "id": "80080106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... Heh, well... Ummm...",
            "nextDialogs": [
              "80080108",
              "80080110"
            ]
          },
          "80080108": {
            "id": "80080108",
            "speakerId": 12423,
            "speakerName": "Yuehui",
            "text": "Huh? ...Hospice?",
            "nextDialogs": [
              "80080111"
            ]
          },
          "80080111": {
            "id": "80080111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Uh, basically, the hilichurls down there don't wanna fight anymore. Leave them in peace, and they won't cause you any trouble."
          },
          "80080110": {
            "id": "80080110",
            "speakerId": 12423,
            "speakerName": "Yuehui",
            "text": "Sorry, hili-topia...?"
          }
        }
      }
    }
  ]

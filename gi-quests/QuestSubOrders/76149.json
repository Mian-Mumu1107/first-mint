  "subQuests": [
    {
      "subId": "7614901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761490101"
        ],
        "dialogs": {
          "761490101": {
            "id": "761490101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Who is it!? Who's there?",
            "nextDialogs": [
              "761490102"
            ]
          },
          "761490102": {
            "id": "761490102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{NICKNAME}. One who belongs to this era.",
            "nextDialogs": [
              "761490103"
            ]
          },
          "761490103": {
            "id": "761490103",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "Ah. Well, though I know nothing of your time, my name is Alara. I was once an Ascetic of the Age of Silence.",
            "nextDialogs": [
              "761490104"
            ]
          },
          "761490104": {
            "id": "761490104",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "I no longer remember how much time has passed since I came here. Even this place has broken my silent cultivation.",
            "nextDialogs": [
              "761490105"
            ]
          },
          "761490105": {
            "id": "761490105",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "So it is true... cultivating a mind without thought or desire leads one to reincarnate in the Unthinking Heaven of Evil...",
            "nextDialogs": [
              "761490106"
            ]
          },
          "761490106": {
            "id": "761490106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was nothing.",
            "nextDialogs": [
              "761490107"
            ]
          },
          "761490107": {
            "id": "761490107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No need to thank me.",
            "nextDialogs": [
              "761490108"
            ]
          },
          "761490108": {
            "id": "761490108",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "Well, thanks all the same!",
            "nextDialogs": [
              "761490109"
            ]
          },
          "761490109": {
            "id": "761490109",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Saving you was more of a spur-of-the-moment thing. That said, we're planning to look for a way out that isn't meditation.",
            "nextDialogs": [
              "761490110"
            ]
          },
          "761490110": {
            "id": "761490110",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "Are you not practiced in that art? Or is it simply not taught in your era?",
            "nextDialogs": [
              "761490111"
            ]
          },
          "761490111": {
            "id": "761490111",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "The first time I left this place, it took me hundreds of years. I gave up my pursuit of truth... and my longing to see my loved ones again.",
            "nextDialogs": [
              "761490112"
            ]
          },
          "761490112": {
            "id": "761490112",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "This time, I'm not willing to give any of those up.",
            "nextDialogs": [
              "761490113"
            ]
          },
          "761490113": {
            "id": "761490113",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "That makes two of us.",
            "nextDialogs": [
              "761490114"
            ]
          },
          "761490114": {
            "id": "761490114",
            "speakerId": 1003,
            "speakerName": "Dex",
            "text": "!",
            "nextDialogs": [
              "761490115"
            ]
          },
          "761490115": {
            "id": "761490115",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Dex has picked up another Deathmuse Shard.",
            "nextDialogs": [
              "761490116"
            ]
          },
          "761490116": {
            "id": "761490116",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "Deathmuse? Ah, you mean the Maranasati meditation technique. I know of it, and its use in cultivating one's mental state when facing death.",
            "nextDialogs": [
              "761490117"
            ]
          },
          "761490117": {
            "id": "761490117",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Now that Zeitlind's been found, let's try to find a way out.",
            "nextDialogs": [
              "761490118"
            ]
          },
          "761490118": {
            "id": "761490118",
            "speakerId": 1001,
            "speakerName": "Alara",
            "text": "Are you sure we can get out of here by ourselves?",
            "nextDialogs": [
              "761490119"
            ]
          },
          "761490119": {
            "id": "761490119",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Melanta and Nihilita can move within this place freely, and they usually bring people with them. In which case, Dex should be able to do the same.",
            "nextDialogs": [
              "761490120"
            ]
          },
          "761490120": {
            "id": "761490120",
            "speakerId": 1003,
            "speakerName": "Dex",
            "text": "♪~",
            "nextDialogs": [
              "761490121"
            ]
          },
          "761490121": {
            "id": "761490121",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "That's three Deathmuse Shards collected.",
            "nextDialogs": [
              "761490122"
            ]
          },
          "761490122": {
            "id": "761490122",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Though I should say this is a temporary name, since I have no clue what Dex will be using them for either.",
            "nextDialogs": [
              "761490123"
            ]
          },
          "761490123": {
            "id": "761490123",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "What next, Dex?",
            "nextDialogs": [
              "761490124"
            ]
          },
          "761490124": {
            "id": "761490124",
            "speakerId": 1003,
            "speakerName": "Dex",
            "text": "!",
            "nextDialogs": [
              "761490125"
            ]
          },
          "761490125": {
            "id": "761490125",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Let's follow its directions."
          }
        }
      }
    },

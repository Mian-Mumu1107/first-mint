  "subQuests": [
    {
      "subId": "7105301",
      "subQuestName": "Talk to Khedive",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710501401"
        ],
        "dialogs": {
          "710501401": {
            "id": "710501401",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "Let's get to the serious topic.",
            "nextDialogs": [
              "710501402"
            ]
          },
          "710501402": {
            "id": "710501402",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "You've done me a big favor the past few days. I really don't know how I can repay you.",
            "nextDialogs": [
              "710501403"
            ]
          },
          "710501403": {
            "id": "710501403",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "Considering our amiable collaboration so far, it wouldn't be enough to pay you with Mora.",
            "nextDialogs": [
              "710501404"
            ]
          },
          "710501404": {
            "id": "710501404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, if you insist...",
            "nextDialogs": [
              "710501405"
            ]
          },
          "710501405": {
            "id": "710501405",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "Be serious! Am I so vulgar as to humiliate you with mere gold?",
            "nextDialogs": [
              "710501406"
            ]
          },
          "710501406": {
            "id": "710501406",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "Wouldn't that be a sheer insult to you?",
            "nextDialogs": [
              "710501407"
            ]
          },
          "710501407": {
            "id": "710501407",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "Here, take this letter. If you ever run into any trouble or need some help in your future journey in Sumeru, bring it to the House of Purbiruni.",
            "nextDialogs": [
              "710501408"
            ]
          },
          "710501408": {
            "id": "710501408",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "We'll spare no effort in helping you.",
            "nextDialogs": [
              "710501409"
            ]
          },
          "710501409": {
            "id": "710501409",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "\"Connections are far more precious than gold.\"",
            "nextDialogs": [
              "710501410"
            ]
          },
          "710501410": {
            "id": "710501410",
            "speakerId": 1000,
            "speakerName": "Khedive",
            "text": "This Sumeru saying rings quite true."
          }
        }
      }
    }
  ]
}
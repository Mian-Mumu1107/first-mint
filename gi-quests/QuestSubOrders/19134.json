    {
      "subId": "1913409",
      "subQuestName": "Figure out what the attendees are thinking",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191340901"
        ],
        "dialogs": {
          "191340901": {
            "id": "191340901",
            "speakerId": 12303,
            "speakerName": "Xiaofei",
            "text": "Huh? You want to know why I paid so much?",
            "nextDialogs": [
              "191340902"
            ]
          },
          "191340902": {
            "id": "191340902",
            "speakerId": 12303,
            "speakerName": "Xiaofei",
            "text": "Well, it's pretty obvious, isn't it? Because the previous owner was Lady Ningguang.",
            "nextDialogs": [
              "191340903"
            ]
          },
          "191340903": {
            "id": "191340903",
            "speakerId": 12303,
            "speakerName": "Xiaofei",
            "text": "Sure, the item might look pretty ordinary, but that's probably just because I'm not a connoisseur, so I don't know how to appreciate it...",
            "nextDialogs": [
              "191340904"
            ]
          },
          "191340904": {
            "id": "191340904",
            "speakerId": 12303,
            "speakerName": "Xiaofei",
            "text": "But I figured I'd buy it first, then go get it appraised by an expert. Then I'll be rich! Hehe..."
          }
        }
      }
    },
    {
      "subId": "1913410",
      "subQuestName": "Figure out what the attendees are thinking",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191341001"
        ],
        "dialogs": {
          "191341001": {
            "id": "191341001",
            "speakerId": 12304,
            "speakerName": "Yingfeng",
            "text": "I may have paid an arm and a leg for this, but in the end I got the result I wanted. Hahaha.",
            "nextDialogs": [
              "191341002"
            ]
          },
          "191341002": {
            "id": "191341002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aren't you worried about the price being over-inflated?",
            "nextDialogs": [
              "191341003"
            ]
          },
          "191341003": {
            "id": "191341003",
            "speakerId": 12304,
            "speakerName": "Yingfeng",
            "text": "Nothing of Ningguang's could ever be over-inflated.",
            "nextDialogs": [
              "191341004"
            ]
          },
          "191341004": {
            "id": "191341004",
            "speakerId": 12304,
            "speakerName": "Yingfeng",
            "text": "I'm far from the only buyer who believes that \"owned by Ningguang\" is worth paying a premium for. So how much I make just depends on how many people are even bigger fans of Ningguang than I am!"
          }
        }
      }
    },
    {
      "subId": "1913411",
      "subQuestName": "Figure out what the attendees are thinking",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

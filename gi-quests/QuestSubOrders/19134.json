    {
      "subId": "1913406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191340601"
        ],
        "dialogs": {
          "191340601": {
            "id": "191340601",
            "speakerId": 12304,
            "speakerName": "Yingfeng",
            "text": "Did you bring plenty of Mora with you?",
            "nextDialogs": [
              "191340602"
            ]
          },
          "191340602": {
            "id": "191340602",
            "speakerId": 12304,
            "speakerName": "Yingfeng",
            "text": "Let's put it this way — anything you can snag in one of Lady Ningguang's auctions is practically Mora in the bank. The more you take home, the bigger your fortune."
          }
        }
      }
    },
    {
      "subId": "1913407",
      "subQuestName": "Wait for the auction to start (16:00 – 18:00)",

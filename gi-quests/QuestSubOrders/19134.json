        ],
        "dialogs": {
          "191341101": {
            "id": "191341101",
            "speakerId": 12305,
            "speakerName": "Little Bin",
            "text": "*sigh* Today wasn't my day. Didn't manage to snag much.",
            "nextDialogs": [
              "191341102"
            ]
          },
          "191341102": {
            "id": "191341102",
            "speakerId": 12305,
            "speakerName": "Little Bin",
            "text": "There were too many bidders, and they all seemed like experts to me.",
            "nextDialogs": [
              "191341103"
            ]
          },
          "191341103": {
            "id": "191341103",
            "speakerId": 12305,
            "speakerName": "Little Bin",
            "text": "I guess I'll just have to wait for the next auction. Someday, I'll be the lucky one."
          }
        }
      }
    },

        "dialogs": {
          "726680101": {
            "id": "726680101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's great. In a way, everyone who has pursued the \"Lunar Leviathan\" can be regarded as having their wishes fulfilled.",
            "nextDialogs": [
              "726680102"
            ]
          },
          "726680102": {
            "id": "726680102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you all done?",
            "nextDialogs": [
              "726680103"
            ]
          },
          "726680103": {
            "id": "726680103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You see you see, hasn't Jiawei found a healthy wife?",
            "nextDialogs": [
              "726680104"
            ]
          },
          "726680104": {
            "id": "726680104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nantuck also became a reputable author because of the book on the \"Lunar Leviathan,\" although its contents are wrong.",
            "nextDialogs": [
              "726680105"
            ]
          },
          "726680105": {
            "id": "726680105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kujirai Momiji became the most well-known fisherwoman in Inazuma and did what her father could not — catching the \"Lunar Leviathan.\"",
            "nextDialogs": [
              "726680106"
            ]
          },
          "726680106": {
            "id": "726680106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#So Paimon feels, {NICKNAME}'s will come true too! Tee-hee!",
            "nextDialogs": [
              "726680107"
            ]
          },
          "726680107": {
            "id": "726680107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What did Paimon wish for just now?",
            "nextDialogs": [
              "726680108"
            ]
          },
          "726680108": {
            "id": "726680108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Can't say! Can't say! If Paimon says it out loud, it won't come true!",
            "nextDialogs": [
              "726680109"
            ]
          },
          "726680109": {
            "id": "726680109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The \"Lunar Leviathan\" won't be that stingy.",
            "nextDialogs": [
              "726680110"
            ]
          },
          "726680110": {
            "id": "726680110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmmm— Ok, listen carefully! Paimon will only say it once!",
            "nextDialogs": [
              "726680111"
            ]
          },
          "726680111": {
            "id": "726680111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's wish is for your wish to come true.",
            "nextDialogs": [
              "726680112"
            ]
          },
          "726680112": {
            "id": "726680112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I didn't hear you, what did you say?",
            "nextDialogs": [
              "726680113"
            ]
          },
          "726680113": {
            "id": "726680113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, Paimon isn't going to repeat herself! Paimon wants to get some candy~ Lalala~"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7470001",
      "subQuestName": "Head to the aquarium on the lower level",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747000101"
        ],
        "dialogs": {
          "747000101": {
            "id": "747000101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon's having a bunch of fun filling up this aquarium!",
            "nextDialogs": [
              "747000102"
            ]
          },
          "747000102": {
            "id": "747000102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Since Sandrone doesn't mind, we should definitely catch some more fishies and make this place extra beautiful!",
            "nextDialogs": [
              "747000103"
            ]
          },
          "747000103": {
            "id": "747000103",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Hey, you two. Come over here.",
            "nextDialogs": [
              "747000104"
            ]
          },
          "747000104": {
            "id": "747000104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Is everything alright...?",
            "nextDialogs": [
              "747000105"
            ]
          },
          "747000105": {
            "id": "747000105",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Here, this is for you.",
            "nextDialogs": [
              "747000106"
            ]
          },
          "747000106": {
            "id": "747000106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...What is it?",
            "nextDialogs": [
              "747000107"
            ]
          },
          "747000107": {
            "id": "747000107",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "It's an underwater mobility device I've been working on.",
            "nextDialogs": [
              "747000108"
            ]
          },
          "747000108": {
            "id": "747000108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh!? Wow, that's so kind of you, Sandrone!",
            "nextDialogs": [
              "747000109"
            ]
          },
          "747000109": {
            "id": "747000109",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "It's just a simple mechanical device. I saw the way you were catching fish and, how should I put this... It seemed somewhat... unsophisticated. To be perfectly frank, I found it quite difficult to watch.",
            "nextDialogs": [
              "747000110"
            ]
          },
          "747000110": {
            "id": "747000110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "W—Was it really that bad?",
            "nextDialogs": [
              "747000111"
            ]
          },
          "747000111": {
            "id": "747000111",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "It was inefficient, unskilled, and completely and utterly inelegant.",
            "nextDialogs": [
              "747000112"
            ]
          },
          "747000112": {
            "id": "747000112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm... sorry we subjected you to that...",
            "nextDialogs": [
              "747000113"
            ]
          },
          "747000113": {
            "id": "747000113",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "No need to apologize. Everyone has their own ways of doing things. But seeing as you plan to keep adding to the aquarium, it might be best if you use this device.",
            "nextDialogs": [
              "747000114"
            ]
          },
          "747000114": {
            "id": "747000114",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "The waters of Fontaine are home to more than just harmless, ornamental fish. There are plenty of predators who could do you some real harm. This device will not only help you fish, it'll also help you flee.",
            "nextDialogs": [
              "747000117"
            ]
          },
          "747000117": {
            "id": "747000117",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Alright. Oh, and if you're going for a swim, go now. And don't forget to tell me what you think of the device. I can always make more adjustments if you have any feedback."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7903301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330101"
        ],
        "dialogs": {
          "790330101": {
            "id": "790330101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, the projection is actually at the center of the stage.",
            "nextDialogs": [
              "790330102"
            ]
          },
          "790330102": {
            "id": "790330102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What are those two doing? One seems to be talking and the other is sitting on the ground.",
            "nextDialogs": [
              "790330103"
            ]
          },
          "790330103": {
            "id": "790330103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, Paimon knows! She must have been telling the person sitting on the ground a story before they went to bed. That's the kind of picture this is!",
            "nextDialogs": [
              "790330104"
            ]
          },
          "790330104": {
            "id": "790330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do Fatui listen to bedtime stories too?",
            "nextDialogs": [
              "790330105"
            ]
          },
          "790330105": {
            "id": "790330105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You never know.",
            "nextDialogs": [
              "790330106"
            ]
          },
          "790330106": {
            "id": "790330106",
            "speakerId": 1001,
            "speakerName": "Projection of Geochanter Bracer",
            "text": "Agafya, Persikov has ordered us to perform some signal reception tests. Looks like all four of us have to go... Chevka will probably get mad at me.",
            "nextDialogs": [
              "790330107"
            ]
          },
          "790330107": {
            "id": "790330107",
            "speakerId": 1002,
            "speakerName": "Projection of Mirror Maiden",
            "text": "Come on, Yakov, orders are orders, Chevka isn't going to blame you for them!",
            "nextDialogs": [
              "790330108"
            ]
          },
          "790330108": {
            "id": "790330108",
            "speakerId": 1002,
            "speakerName": "Projection of Mirror Maiden",
            "text": "...You know what, if you're that scared, I'll go with you to talk to Chevka, alright?",
            "nextDialogs": [
              "790330109"
            ]
          },
          "790330109": {
            "id": "790330109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, so she wasn't telling a story after all...",
            "nextDialogs": [
              "790330110"
            ]
          },
          "790330110": {
            "id": "790330110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But this snippet just kinda comes outta nowhere. We can't tell what's going on at all..."
          }
        }
      }
    },
    {
      "subId": "7903302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330201"
        ],
        "dialogs": {
          "790330201": {
            "id": "790330201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seriously? That conch just floated up from inside the well...",
            "nextDialogs": [
              "790330204"
            ]
          },
          "790330204": {
            "id": "790330204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#That's pretty amazing. Ooh, look, {NICKNAME}! Someone's bending over... Ah!",
            "nextDialogs": [
              "790330205"
            ]
          },
          "790330205": {
            "id": "790330205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Don't move, {NICKNAME}, behind you...!"
          }
        }
      }
    },
    {
      "subId": "7903303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330301"
        ],
        "dialogs": {
          "790330301": {
            "id": "790330301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, looks like those two people are lying on the ground... Are they stargazing?",
            "nextDialogs": [
              "790330302"
            ]
          },
          "790330302": {
            "id": "790330302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "To be honest, this image seems a bit weird...",
            "nextDialogs": [
              "790330303"
            ]
          },
          "790330303": {
            "id": "790330303",
            "speakerId": 1003,
            "speakerName": "Projection of Hydrogunner Legionnaire",
            "text": "Yakov, what did the commander say to you that's got you so down?",
            "nextDialogs": [
              "790330304"
            ]
          },
          "790330304": {
            "id": "790330304",
            "speakerId": 1001,
            "speakerName": "Projection of Geochanter Bracer",
            "text": "Well, the waves were really choppy, so I slipped and fell while carrying the device. Fortunately, I was quick enough to save it...",
            "nextDialogs": [
              "790330305"
            ]
          },
          "790330305": {
            "id": "790330305",
            "speakerId": 1001,
            "speakerName": "Projection of Geochanter Bracer",
            "text": "But the commander still gave me an earful and ordered our squad to do signal reception tests. I mean, ugh, that's the toughest job around...",
            "nextDialogs": [
              "790330306"
            ]
          },
          "790330306": {
            "id": "790330306",
            "speakerId": 1003,
            "speakerName": "Projection of Hydrogunner Legionnaire",
            "text": "Oh come on, don't feel so down. We've done this stuff a hundred times before. Hey, chin up! Go get yourself something to eat!",
            "nextDialogs": [
              "790330307"
            ]
          },
          "790330307": {
            "id": "790330307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They're pointing towards something high up. Are they looking for something to eat?",
            "nextDialogs": [
              "790330308"
            ]
          },
          "790330308": {
            "id": "790330308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, is this conch crooked somehow?"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1301018",
      "subQuestName": "Investigate the auction site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130101301"
        ],
        "dialogs": {
          "130101301": {
            "id": "130101301",
            "speakerId": 1002,
            "speakerName": "Investigate",
            "text": "(The scattered footprints have not been completely buried by the wind and sand, but it is impossible to speculate on the direction of the merchants' escape from the footprints.)"
          }
        }
      }
    },
    {
      "subId": "1301017",
      "subQuestName": "Investigate the auction site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130101401"
        ],
        "dialogs": {
          "130101401": {
            "id": "130101401",
            "speakerId": 1002,
            "speakerName": "Investigate",
            "text": "(The Sumpter Beast is drinking water leisurely and seems to be completely unaffected.)"
          }
        }
      }
    },
    {
      "subId": "1301016",
      "subQuestName": "Investigate the auction site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130101501"
        ],
        "dialogs": {
          "130101501": {
            "id": "130101501",
            "speakerId": 1002,
            "speakerName": "Investigate",
            "text": "(Ordinary Canned Knowledge, seems to have nothing to do with the Court of Desolation.)"
          }
        }
      }
    },
    {
      "subId": "1301015",
      "subQuestName": "Investigate the auction site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130101601"
        ],
        "dialogs": {
          "130101601": {
            "id": "130101601",
            "speakerId": 1002,
            "speakerName": "Investigate",
            "text": "(A large amount of Canned Knowledge has been piled here, enough to fetch an extremely large amount of Mora at market price.)"
          }
        }
      }
    },
    {
      "subId": "1301013",
      "subQuestName": "Talk to Cyno",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130100610"
        ],
        "dialogs": {
          "130100610": {
            "id": "130100610",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Did you find anything?",
            "nextDialogs": [
              "130100611"
            ]
          },
          "130100611": {
            "id": "130100611",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No, nothing in particular...",
            "nextDialogs": [
              "130100612"
            ]
          },
          "130100612": {
            "id": "130100612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Only some average-looking Knowledge Capsules.",
            "nextDialogs": [
              "130100613"
            ]
          },
          "130100613": {
            "id": "130100613",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "It's possible there weren't many Knowledge Capsules containing info about the Court of Desolation, so they carried those off.",
            "nextDialogs": [
              "130100614"
            ]
          },
          "130100614": {
            "id": "130100614",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "#But don't worry, I have another idea. {NICKNAME}, you two start heading back the way we came. I will remain hidden here.",
            "nextDialogs": [
              "130100615"
            ]
          },
          "130100615": {
            "id": "130100615",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Come back and meet me here after some time has passed. I'm sure something will come up by then.",
            "nextDialogs": [
              "130100616"
            ]
          },
          "130100616": {
            "id": "130100616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that's why you wanted me to carry the tracking device...",
            "nextDialogs": [
              "130100617"
            ]
          },
          "130100617": {
            "id": "130100617",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "They packed up in a hurry and didn't have time to carry off all their goods. They won't just leave them here.",
            "nextDialogs": [
              "130100618"
            ]
          },
          "130100618": {
            "id": "130100618",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Once they think we've left the premises, they'll be back to pick up their belongings. We just need to make sure the tracker goes far enough from here to make them assume that it's safe to come back.",
            "nextDialogs": [
              "130100619"
            ]
          },
          "130100619": {
            "id": "130100619",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, Paimon gets it! We'll lure them out because they'll think we've left!",
            "nextDialogs": [
              "130100620"
            ]
          },
          "130100620": {
            "id": "130100620",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Okay, we'll start heading away and leave this place to you.",
            "nextDialogs": [
              "130100621"
            ]
          },
          "130100621": {
            "id": "130100621",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Yes, and don't worry, if they dare to return, I'll make sure they stay."
          }
        }
      }
    },
    {
      "subId": "1301010",
      "subQuestName": "Leave the auction with the tracker",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130101001"
        ],
        "dialogs": {
          "130101001": {
            "id": "130101001",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh... So tired... We've probably gone far enough now, right?",
            "nextDialogs": [
              "130101003",
              "130101005"
            ]
          },
          "130101003": {
            "id": "130101003",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yay! Let's rest for a little while before we go back to find Cyno!",
            "nextDialogs": [
              "130101006"
            ]
          },
          "130101006": {
            "id": "130101006",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You sit and rest for a while nearby.",
            "nextDialogs": [
              "130101007"
            ]
          },
          "130101007": {
            "id": "130101007",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, it's probably about time for us to head back to the auction.",
            "nextDialogs": [
              "130101008"
            ]
          },
          "130101008": {
            "id": "130101008",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's go, maybe Cyno's finally found some leads."
          },
          "130101005": {
            "id": "130101005",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Further? But Paimon can't go another step... How about we rest here for a while."
          }
        }
      }
    },
    {
      "subId": "1301011",
      "subQuestName": "Meet up with Cyno",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130100701"
        ],
        "dialogs": {
          "130100701": {
            "id": "130100701",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Looks like Cyno caught someone!",
            "nextDialogs": [
              "130100702"
            ]
          },
          "130100702": {
            "id": "130100702",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So you're the bad guy behind all this, aren't ya? Alright, tell Paimon everything you know!",
            "nextDialogs": [
              "130100705"
            ]
          },
          "130100705": {
            "id": "130100705",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "I didn't act immediately when he showed up. Rather, I laid low and observed for a while instead.",
            "nextDialogs": [
              "130100706"
            ]
          },
          "130100706": {
            "id": "130100706",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "He is not the primary instigator, but he is most likely one of the more important dealers here. Am I right?",
            "nextDialogs": [
              "130100707"
            ]
          },
          "130100707": {
            "id": "130100707",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Yes, impressive... You certainly live up to your reputation, Cyno. If I had any idea you were still around, I wouldn't have gotten so greedy.",
            "nextDialogs": [
              "130100708"
            ]
          },
          "130100708": {
            "id": "130100708",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Greedy? What do you mean by that?",
            "nextDialogs": [
              "130100709"
            ]
          },
          "130100709": {
            "id": "130100709",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Once everyone knew you were coming, all the Canned Knowledge dealers abandoned their goods and fled at once. Obviously, there wasn't time to pack up everything.",
            "nextDialogs": [
              "130100710"
            ]
          },
          "130100710": {
            "id": "130100710",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Since all the goods were just left here unsupervised, I thought I'd use the opportunity to come back and take what I could. You know, free merchandise is good business, but... *sigh* I suppose there's no use explaining it now.",
            "nextDialogs": [
              "130100711"
            ]
          },
          "130100711": {
            "id": "130100711",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "You must know who's manufacturing and selling the Canned Knowledge, correct? Will you tell us willingly, or do I need to make you talk?",
            "nextDialogs": [
              "130100712"
            ]
          },
          "130100712": {
            "id": "130100712",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "No, no, I'll talk. But before that, perhaps we can take the conversation elsewhere?",
            "nextDialogs": [
              "130100713"
            ]
          },
          "130100713": {
            "id": "130100713",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "If we stay here, chances are that someone will see me with you. That would put both me and my family in danger.",
            "nextDialogs": [
              "130100714"
            ]
          },
          "130100714": {
            "id": "130100714",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Alright. Where do you suggest we go?",
            "nextDialogs": [
              "130100715"
            ]
          },
          "130100715": {
            "id": "130100715",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "How about my home in Aaru Village? It should be safe there.",
            "nextDialogs": [
              "130100716"
            ]
          },
          "130100716": {
            "id": "130100716",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "#Fine, let's head out. You can throw away the tracker now, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "1301007",
      "subQuestName": "Follow Bahari to Aaru Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1301008",
      "subQuestName": "Follow Bahari to Aaru Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130100801"
        ],
        "dialogs": {
          "130100801": {
            "id": "130100801",
            "speakerId": 1005,
            "speakerName": "Simin",
            "text": "Dad, you're back!",
            "nextDialogs": [
              "130100802"
            ]
          },
          "130100802": {
            "id": "130100802",
            "speakerId": 1005,
            "speakerName": "Simin",
            "text": "Oh, we have guests? Uh, hi there...",
            "nextDialogs": [
              "130100803"
            ]
          },
          "130100803": {
            "id": "130100803",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "This is my daughter, Simin. She can be a little shy of strangers.",
            "nextDialogs": [
              "130100804"
            ]
          },
          "130100804": {
            "id": "130100804",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Why don't you run along now, dear? Dad needs to talk with our guests.",
            "nextDialogs": [
              "130100805"
            ]
          },
          "130100805": {
            "id": "130100805",
            "speakerId": 1005,
            "speakerName": "Simin",
            "text": "Oh... okay.",
            "nextDialogs": [
              "130100806"
            ]
          },
          "130100806": {
            "id": "130100806",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Everyone knows Cyno in our business, but let me ask, who are you two?",
            "nextDialogs": [
              "130100807"
            ]
          },
          "130100807": {
            "id": "130100807",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Paimon is Paimon, and this is {NICKNAME}!",
            "nextDialogs": [
              "130100808"
            ]
          },
          "130100808": {
            "id": "130100808",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "To be honest, I really didn't expect to see Cyno the lone operator working with any partners. When I saw the tracker start moving away, I assumed you had decided to just go back empty-handed.",
            "nextDialogs": [
              "130100809"
            ]
          },
          "130100809": {
            "id": "130100809",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "But even though you caught me, I'd still urge you to stop while you still can. You should abandon this investigation.",
            "nextDialogs": [
              "130100810"
            ]
          },
          "130100810": {
            "id": "130100810",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Why's that?",
            "nextDialogs": [
              "130100811"
            ]
          },
          "130100811": {
            "id": "130100811",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Everything from the manufacturing of Canned Knowledge, to the sales and even splitting the profits... every step of the process involves dozens, if not hundreds of people. Massive profits have brought everyone together in this business.",
            "nextDialogs": [
              "130100812"
            ]
          },
          "130100812": {
            "id": "130100812",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Everyone will try their best to defend this industry that we've worked to build. It will be a long and difficult fight, even for you, Cyno.",
            "nextDialogs": [
              "130100813"
            ]
          },
          "130100813": {
            "id": "130100813",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "And even if you manage to win in the end, no one will thank you. If anything, you yourself might even feel remorse... Why are you so bent on putting us out of business?",
            "nextDialogs": [
              "130100814"
            ]
          },
          "130100814": {
            "id": "130100814",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Everyone has their own reasons for what they do. I don't have to explain mine.",
            "nextDialogs": [
              "130100815"
            ]
          },
          "130100815": {
            "id": "130100815",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "*sigh*...",
            "nextDialogs": [
              "130100816"
            ]
          },
          "130100816": {
            "id": "130100816",
            "speakerId": 1005,
            "speakerName": "Simin",
            "text": "Here's some tea, Dad... and for the guests, too.",
            "nextDialogs": [
              "130100817"
            ]
          },
          "130100817": {
            "id": "130100817",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Ah, right. I forgot to offer tea to our guests. Thank you.",
            "nextDialogs": [
              "130100818"
            ]
          },
          "130100818": {
            "id": "130100818",
            "speakerId": 1005,
            "speakerName": "Simin",
            "text": "Don't mention it... And, uh...",
            "nextDialogs": [
              "130100819"
            ]
          },
          "130100819": {
            "id": "130100819",
            "speakerId": 1005,
            "speakerName": "Simin",
            "text": "I should tell you that our tea tastes kinda bitter, but I put some sugar in to make it a little tastier.",
            "nextDialogs": [
              "130100820"
            ]
          },
          "130100820": {
            "id": "130100820",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "That's my girl. Do we still have any sugar left? If not, I'll buy some more next time.",
            "nextDialogs": [
              "130100821"
            ]
          },
          "130100821": {
            "id": "130100821",
            "speakerId": 1005,
            "speakerName": "Simin",
            "text": "Yes, we do... Okay, I'm gonna go have a rest now.",
            "nextDialogs": [
              "130100822"
            ]
          },
          "130100822": {
            "id": "130100822",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Didn't you say that everyone's in it for the massive profits? That sure doesn't seem to be the case for you.",
            "nextDialogs": [
              "130100823"
            ]
          },
          "130100823": {
            "id": "130100823",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Ahem, actually that's what I wanted to talk to you about. I was hoping to ask you for a favor.",
            "nextDialogs": [
              "130100824"
            ]
          },
          "130100824": {
            "id": "130100824",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "My daughter was born with a chronic disease, so she has a relatively weak heart and lungs. Even slightly strenuous exercise can cause her to faint and prove to be a life-threatening risk.",
            "nextDialogs": [
              "130100825"
            ]
          },
          "130100825": {
            "id": "130100825",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "That's why she's never really had any friends to play with, and why she locks herself up in her room most of the time. She has to take lots of medicine, and it doesn't come cheap.",
            "nextDialogs": [
              "130100826"
            ]
          },
          "130100826": {
            "id": "130100826",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "As for me, I was just an average merchant. I would wake up early and travel all around to make a profit, but the Mora was still nowhere near enough. I could only watch my daughter's health deteriorate day by day.",
            "nextDialogs": [
              "130100827"
            ]
          },
          "130100827": {
            "id": "130100827",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "Until one day, someone reached out and showed me a way to really make a profit...",
            "nextDialogs": [
              "130100828"
            ]
          },
          "130100828": {
            "id": "130100828",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Selling Canned Knowledge?",
            "nextDialogs": [
              "130100829"
            ]
          },
          "130100829": {
            "id": "130100829",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "That's right. With all the Mora I made, I could finally afford medical treatment for my daughter. Nothing made me happier than seeing her get better.",
            "nextDialogs": [
              "130100830"
            ]
          },
          "130100830": {
            "id": "130100830",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "There are many others like me. Smuggling Canned Knowledge might seem like an unforgivable crime to you, but to us, it's a means of survival.",
            "nextDialogs": [
              "130100831"
            ]
          },
          "130100831": {
            "id": "130100831",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "I wanted to tell you all this so that maybe you could understand and change your mind. Please stay out of this, Cyno. Give us a way to survive.",
            "nextDialogs": [
              "130100832"
            ]
          },
          "130100832": {
            "id": "130100832",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh no... That means that if we prevent the sale of Canned Knowledge, his daughter will...",
            "nextDialogs": [
              "130100833"
            ]
          },
          "130100833": {
            "id": "130100833",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "130100834"
            ]
          },
          "130100834": {
            "id": "130100834",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "...",
            "nextDialogs": [
              "130100835"
            ]
          },
          "130100835": {
            "id": "130100835",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "I must get to the truth.",
            "nextDialogs": [
              "130100836"
            ]
          },
          "130100836": {
            "id": "130100836",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "I can find someone to help treat your child, but I cannot turn a blind eye to the smuggling. These are two completely different issues.",
            "nextDialogs": [
              "130100837"
            ]
          },
          "130100837": {
            "id": "130100837",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "*sigh* I somehow knew you would say that, but having your word to help my daughter is enough for me. Since you insist on continuing the investigation, you should have a look around the back of my home.",
            "nextDialogs": [
              "130100838"
            ]
          },
          "130100838": {
            "id": "130100838",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "You'll find some goods I received just recently. I think everything will become clear to you once you see them.",
            "nextDialogs": [
              "130100839"
            ]
          },
          "130100839": {
            "id": "130100839",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You go to the back of the house with Cyno.",
            "nextDialogs": [
              "130100840"
            ]
          },
          "130100840": {
            "id": "130100840",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! Look at all of this!",
            "nextDialogs": [
              "130100841"
            ]
          },
          "130100841": {
            "id": "130100841",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Yes, all neatly packed away and organized in boxes. To think that this is only one dealer's worth...",
            "nextDialogs": [
              "130100842"
            ]
          },
          "130100842": {
            "id": "130100842",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Small producers couldn't possibly support such a large quantity of goods. Hmm, could the Akademiya have a hand in this? But such a volume of goods wouldn't be able to slip through inspection...",
            "nextDialogs": [
              "130100843"
            ]
          },
          "130100843": {
            "id": "130100843",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, look! These seem different from the other Knowledge Capsules we've seen. Maybe they contain knowledge about the Court of Desolation?",
            "nextDialogs": [
              "130100844"
            ]
          },
          "130100844": {
            "id": "130100844",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Yes, that would make sense. Wait, what's this...?",
            "nextDialogs": [
              "130100847"
            ]
          },
          "130100847": {
            "id": "130100847",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Yes, it's a matra seal, indicating that the goods have passed matra inspection.",
            "nextDialogs": [
              "130100848"
            ]
          },
          "130100848": {
            "id": "130100848",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "I started to suspect that someone in the Akademiya might be involved when I found the tracker earlier, but how they could ship so much Canned Knowledge out of the Akademiya was still a mystery.",
            "nextDialogs": [
              "130100849"
            ]
          },
          "130100849": {
            "id": "130100849",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "The pieces have now all fallen into place. With this matra seal, goods can leave the Akademiya without undergoing a second inspection.",
            "nextDialogs": [
              "130100850"
            ]
          },
          "130100850": {
            "id": "130100850",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Hmph, no wonder they don't want me to investigate. It turns out that a matra is behind this. Even I find it hard to believe.",
            "nextDialogs": [
              "130100851"
            ]
          },
          "130100851": {
            "id": "130100851",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It could be a misunderstanding.",
            "nextDialogs": [
              "130100852"
            ]
          },
          "130100852": {
            "id": "130100852",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "#Could I ask you for a favor, {NICKNAME}?",
            "nextDialogs": [
              "130100853"
            ]
          },
          "130100853": {
            "id": "130100853",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Since all this Canned Knowledge came from the Akademiya, then it's highly likely that the knowledge regarding the Court of Desolation originated from research files stored within the Akademiya.",
            "nextDialogs": [
              "130100854"
            ]
          },
          "130100854": {
            "id": "130100854",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "If we can enter the repository, we can find out who accessed these files.",
            "nextDialogs": [
              "130100855"
            ]
          },
          "130100855": {
            "id": "130100855",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "But considering my current status, if I suddenly show up at the Akademiya now, it will only draw unnecessary attention.",
            "nextDialogs": [
              "130100856"
            ]
          },
          "130100856": {
            "id": "130100856",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "You'll need to be the one who checks the records. I'll write a letter to Nabil and he'll take you there.",
            "nextDialogs": [
              "130100857"
            ]
          },
          "130100857": {
            "id": "130100857",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sure thing, leave it to us!",
            "nextDialogs": [
              "130100858"
            ]
          },
          "130100858": {
            "id": "130100858",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "I'll also keep working here in the meantime. Although our leads all are currently pointing to someone within the Akademiya, it's obvious that they also have power outside of it.",
            "nextDialogs": [
              "130100859"
            ]
          },
          "130100859": {
            "id": "130100859",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "We can get more information on other dealers from Bahari. I'll stay here and make some preparations. You can come find me anytime if you uncover more info."
          }
        }
      }
    },
    {
      "subId": "1301011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130101101"
        ],
        "dialogs": {
          "130101101": {
            "id": "130101101",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "There's no time to lose. Leave as soon as you're ready."
          }
        }
      }
    },
    {
      "subId": "1301099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130109902"
        ],
        "dialogs": {
          "130109902": {
            "id": "130109902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Listen buddy, you'd better not try to trick us!",
            "nextDialogs": [
              "130109903"
            ]
          },
          "130109903": {
            "id": "130109903",
            "speakerId": 1004,
            "speakerName": "Bahari",
            "text": "C'mon now, do you really think I'd try to pull anything under Cyno's watch? Seriously, what can I even do?"
          }
        }
      }
    }
  ]
}
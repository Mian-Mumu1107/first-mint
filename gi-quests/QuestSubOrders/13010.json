    {
      "subId": "1301002",
      "subQuestName": "Go to the desert auction site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130100201"
        ],
        "dialogs": {
          "130100201": {
            "id": "130100201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So... hot... If only there was some shade for us to cool off under...",
            "nextDialogs": [
              "130100202"
            ]
          },
          "130100202": {
            "id": "130100202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe we should take a break.",
            "nextDialogs": [
              "130100203"
            ]
          },
          "130100203": {
            "id": "130100203",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "We still have a long way to go, so you'll need to hang in there for a while longer. This is not a good place to rest, anyway.",
            "nextDialogs": [
              "130100204"
            ]
          },
          "130100204": {
            "id": "130100204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*pant* Okay... But don't you feel hot too, Cyno?",
            "nextDialogs": [
              "130100205"
            ]
          },
          "130100205": {
            "id": "130100205",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Of course, but I'm accustomed to these conditions.",
            "nextDialogs": [
              "130100206"
            ]
          },
          "130100206": {
            "id": "130100206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Care to share any tips? Paimon's about to melt away...",
            "nextDialogs": [
              "130100207"
            ]
          },
          "130100207": {
            "id": "130100207",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Just try to stay focused — use your willpower to support your mind. The moment you start to give in is when you'll feel more tired.",
            "nextDialogs": [
              "130100208"
            ]
          },
          "130100208": {
            "id": "130100208",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Take one step after another. Don't let your mind perceive your body's limitations. We must get somewhere safe before we can relax.",
            "nextDialogs": [
              "130100209"
            ]
          },
          "130100209": {
            "id": "130100209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh okay, if you say so. But where would be a more safe place to rest? Paimon thinks this is a perfectly safe place to stop.",
            "nextDialogs": [
              "130100210"
            ]
          },
          "130100210": {
            "id": "130100210",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Just look around, it's just sand and desert. There aren't any monsters for miles around... Whoa! Where did these scorpions come from!?",
            "nextDialogs": [
              "130100211"
            ]
          },
          "130100211": {
            "id": "130100211",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Watch out, something's not right about them..."
          }
        }
      }
    },
    {
      "subId": "1301003",
      "subQuestName": "Defeat the ambushing monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1301004",
      "subQuestName": "Talk to Cyno",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130100401"
        ],
        "dialogs": {
          "130100401": {
            "id": "130100401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Phew... Well, Paimon really didn't expect to see those here.",
            "nextDialogs": [
              "130100402"
            ]
          },
          "130100402": {
            "id": "130100402",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Those weren't just normal scorpions.",
            "nextDialogs": [
              "130100403"
            ]
          },
          "130100403": {
            "id": "130100403",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "See, there are marked numbers on their pincers. They were raised by someone.",
            "nextDialogs": [
              "130100404"
            ]
          },
          "130100404": {
            "id": "130100404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, you mean...",
            "nextDialogs": [
              "130100405"
            ]
          },
          "130100405": {
            "id": "130100405",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Someone doesn't want us to show up at the auction. These scorpions were sent to keep us away.",
            "nextDialogs": [
              "130100406"
            ]
          },
          "130100406": {
            "id": "130100406",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "We are surrounded by desert as far as the eye can see. If we were killed out here, nobody would ever know.",
            "nextDialogs": [
              "130100407"
            ]
          },
          "130100407": {
            "id": "130100407",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This place is super dangerous! Good thing we didn't let our guard down.",
            "nextDialogs": [
              "130100408"
            ]
          },
          "130100408": {
            "id": "130100408",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Something's not right... There are no roads in the desert, so how could they know where we are?",
            "nextDialogs": [
              "130100409"
            ]
          },
          "130100409": {
            "id": "130100409",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "#Stay still, {NICKNAME}.",
            "nextDialogs": [
              "130100410"
            ]
          },
          "130100410": {
            "id": "130100410",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Here's the answer... They must have planted this on you.",
            "nextDialogs": [
              "130100411"
            ]
          },
          "130100411": {
            "id": "130100411",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? What is it?",
            "nextDialogs": [
              "130100412"
            ]
          },
          "130100412": {
            "id": "130100412",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "A miniature tracking device made by the Kshahrewar. They can use this to discern your approximate location.",
            "nextDialogs": [
              "130100413"
            ]
          },
          "130100413": {
            "id": "130100413",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "But this device wasn't licensed for mass production. Where did they get it... Could someone from the Kshahrewar also be involved? Hmm, but that doesn't seem right...",
            "nextDialogs": [
              "130100414"
            ]
          },
          "130100414": {
            "id": "130100414",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Whoa, Paimon never knew that kind of thing even existed! Why would it be on {NICKNAME}?",
            "nextDialogs": [
              "130100415"
            ]
          },
          "130100415": {
            "id": "130100415",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "They probably planted it on the Traveler during our fight with the mercenaries earlier.",
            "nextDialogs": [
              "130100418"
            ]
          },
          "130100418": {
            "id": "130100418",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "It was a frantic fight. It's only natural you didn't notice the device.",
            "nextDialogs": [
              "130100419"
            ]
          },
          "130100419": {
            "id": "130100419",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, good thing you were able to find it, Cyno! Now let's get rid of it!",
            "nextDialogs": [
              "130100420"
            ]
          },
          "130100420": {
            "id": "130100420",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Hmm, no... Hold on to it for now. It might still be useful for us.",
            "nextDialogs": [
              "130100421"
            ]
          },
          "130100421": {
            "id": "130100421",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Let's keep heading to the auction. It would be dangerous to linger here any longer."
          }
        }
      }
    },
    {
      "subId": "1301005",
      "subQuestName": "Continue heading to the desert auction",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

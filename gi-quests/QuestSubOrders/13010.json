      }
    },
    {
      "subId": "1301006",
      "subQuestName": "Defeat the ambushing monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130100601"
        ],
        "dialogs": {
          "130100601": {
            "id": "130100601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Weird... Is this where the auction is?",
            "nextDialogs": [
              "130100602"
            ]
          },
          "130100602": {
            "id": "130100602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's nobody here.",
            "nextDialogs": [
              "130100603"
            ]
          },
          "130100603": {
            "id": "130100603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, not a single soul... Maybe they're on break right now or something?",
            "nextDialogs": [
              "130100604"
            ]
          },
          "130100604": {
            "id": "130100604",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "We didn't waste any time getting here after we defeated those mercenaries. They shouldn't have been able to give any warning of our arrival.",
            "nextDialogs": [
              "130100605"
            ]
          },
          "130100605": {
            "id": "130100605",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "But even so, they still knew we were coming. Someone here must have been watching the tracker, and warned everyone to clear out.",
            "nextDialogs": [
              "130100606"
            ]
          },
          "130100606": {
            "id": "130100606",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aw, what should we do now?",
            "nextDialogs": [
              "130100607"
            ]
          },
          "130100607": {
            "id": "130100607",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "We search the area. They couldn't have moved all the Knowledge Capsules so quickly. There might still be something left for us to find.",
            "nextDialogs": [
              "130100608"
            ]
          },
          "130100608": {
            "id": "130100608",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, let's take a good look around the area!"
          }
        }
      }
    },
    {
      "subId": "1301009",
      "subQuestName": "Continue heading to the desert auction",
      "sceneId": null,

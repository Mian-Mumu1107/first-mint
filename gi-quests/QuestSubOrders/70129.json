{
  "lineCounts": {
    "Bragin": 26,
    "Churin": 6,
    "Fadeev": 5,
    "Paimon": 5,
    "Player": 5
  },
  "subQuests": [
    {
      "subId": "7012901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701290101"
        ],
        "dialogs": {
          "701290101": {
            "id": "701290101",
            "speakerId": 22746,
            "speakerName": "Churin",
            "text": "But... But Master Bragin, I'm not sure if I can keep doing this.",
            "nextDialogs": [
              "701290102"
            ]
          },
          "701290102": {
            "id": "701290102",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Oh, come now! If you can't even resist this cold, how will you be able to feel the blizzard's might like those blasted Snegovik do?",
            "nextDialogs": [
              "701290103"
            ]
          },
          "701290103": {
            "id": "701290103",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Hang in there a while longer, Churin, Fadeev!",
            "nextDialogs": [
              "701290104"
            ]
          },
          "701290104": {
            "id": "701290104",
            "speakerId": 22746,
            "speakerName": "Churin",
            "text": "*whimper*...",
            "nextDialogs": [
              "701290105"
            ]
          },
          "701290105": {
            "id": "701290105",
            "speakerId": 22747,
            "speakerName": "Fadeev",
            "text": "Y—You're right, Master!",
            "nextDialogs": [
              "701290106"
            ]
          },
          "701290106": {
            "id": "701290106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, what are you doing out here in this crazy cold?",
            "nextDialogs": [
              "701290107"
            ]
          },
          "701290107": {
            "id": "701290107",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Huh. I didn't think a deserted ice-carving workshop like ours would get guests. Are you two also adherents of the Path of the Ice Sculpt-Dancer?",
            "nextDialogs": [
              "701290108"
            ]
          },
          "701290108": {
            "id": "701290108",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Hmm. You there, blondie! You walk through these frigid winds without any irregularity in your footwork... You must be an incredible fighter.",
            "nextDialogs": [
              "701290109"
            ]
          },
          "701290109": {
            "id": "701290109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's this Path of the Ice Sculpt-Dancer, anyway? Is it a dance mat you make from Prime Ice?",
            "nextDialogs": [
              "701290110"
            ]
          },
          "701290110": {
            "id": "701290110",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Hahah. Looks like you don't quite get it, Miss. Creating ice sculptures using Prime Ice techniques is an art unique in all the world to Snezhnaya.",
            "nextDialogs": [
              "701290111"
            ]
          },
          "701290111": {
            "id": "701290111",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "And carving should be elegant, like a dance.",
            "nextDialogs": [
              "701290112"
            ]
          },
          "701290112": {
            "id": "701290112",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Once upon a time, I was able to enter the Pale Crown Palace and perform before the very throne of the Belyi Tsar, by dint of my ability to slice Prime Ice with my bare hands.",
            "nextDialogs": [
              "701290113"
            ]
          },
          "701290113": {
            "id": "701290113",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "To my shame, the noble lady of the Snegurochka said that my sculptures lacked the breath of the blizzard in nature... Her words — Lady Pavlina's words — roused inspiration within me...",
            "nextDialogs": [
              "701290114"
            ]
          },
          "701290114": {
            "id": "701290114",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "After that day, I built a training ground here, and have made it my life's work to sculpt amidst the blizzard, pursuing ever greater artistic heights!",
            "nextDialogs": [
              "701290115"
            ]
          },
          "701290115": {
            "id": "701290115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohhh...",
            "nextDialogs": [
              "701290116"
            ]
          },
          "701290116": {
            "id": "701290116",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Are the two of you not here for that same reason?",
            "nextDialogs": [
              "701290117"
            ]
          },
          "701290117": {
            "id": "701290117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're just adventurers...",
            "nextDialogs": [
              "701290118"
            ]
          },
          "701290118": {
            "id": "701290118",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Incredible... Incredible. To think there'd be adventurers who could reach this place...",
            "nextDialogs": [
              "701290119"
            ]
          },
          "701290119": {
            "id": "701290119",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Ah, yes. I've heard my disciples say that adventurers from the Adventurers' Guild will sometimes take on these... commissions. Is that right, Churin?",
            "nextDialogs": [
              "701290120"
            ]
          },
          "701290120": {
            "id": "701290120",
            "speakerId": 22746,
            "speakerName": "Churin",
            "text": "Yes, Master Churin! But... we'll have to pay them...",
            "nextDialogs": [
              "701290121"
            ]
          },
          "701290121": {
            "id": "701290121",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Oh, come now, I can afford remuneration of a sort. In any case, good adventurer, could I commission you to spar with us?",
            "nextDialogs": [
              "701290122"
            ]
          },
          "701290122": {
            "id": "701290122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Spar? How? Do you mean... in Prime Ice sculpting?",
            "nextDialogs": [
              "701290123"
            ]
          },
          "701290123": {
            "id": "701290123",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Oh, nay, not that. I refer to a physical duel. After all, the Path of the Ice Sculpt-Dancer is also a martial art...",
            "nextDialogs": [
              "701290124"
            ]
          },
          "701290124": {
            "id": "701290124",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "So, how about it? Would you grace us with your presence?",
            "nextDialogs": [
              "701290125"
            ]
          },
          "701290125": {
            "id": "701290125",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, you meant a fight... Well, sure. We aren't scared of anyone!"
          }
        }
      }
    },
    {
      "subId": "7012902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701290201"
        ],
        "dialogs": {
          "701290201": {
            "id": "701290201",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "What do you say, great adventurer? Would you like to spar with us Domovoy — we who pursue the path of the ice sculptor?",
            "nextDialogs": [
              "701290203",
              "701290205"
            ]
          },
          "701290203": {
            "id": "701290203",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "My thanks for your aid. I am sure this will help my apprentices see how vast this world is."
          },
          "701290205": {
            "id": "701290205",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Is that so? When you're willing, mighty adventurer, simply say the word."
          }
        }
      }
    },
    {
      "subId": "7012909",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701290901"
        ],
        "dialogs": {
          "701290901": {
            "id": "701290901",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Wonderful! I never thought I'd meet one as strong as you, adventurer.",
            "nextDialogs": [
              "701290902"
            ]
          },
          "701290902": {
            "id": "701290902",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Sparring with you has filled me with inspiration like a flowing spring... Ah, marvelous.",
            "nextDialogs": [
              "701290903"
            ]
          },
          "701290903": {
            "id": "701290903",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Here, this is your payment... What a fine warm-up this match has been! My body is all toasty now, haha!",
            "nextDialogs": [
              "701290904"
            ]
          },
          "701290904": {
            "id": "701290904",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Still, I must say that Churin is, in truth, the best fighter amongst us. His sculpting, though, could use some work...",
            "nextDialogs": [
              "701290905"
            ]
          },
          "701290905": {
            "id": "701290905",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Find him if you'd like to spar with him! It'll do him good, trust me."
          }
        }
      }
    },
    {
      "subId": "7012910",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701291001"
        ],
        "dialogs": {
          "701291001": {
            "id": "701291001",
            "speakerId": 22747,
            "speakerName": "Fadeev",
            "text": "*sigh* Master, does your method really work, though?",
            "nextDialogs": [
              "701291002"
            ]
          },
          "701291002": {
            "id": "701291002",
            "speakerId": 22747,
            "speakerName": "Fadeev",
            "text": "I don't think I've made any progress in Prime Ice sculpting... Sure, I've gotten a lot faster, but that's it.",
            "nextDialogs": [
              "701291003"
            ]
          },
          "701291003": {
            "id": "701291003",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "Well, is that not an improvement?",
            "nextDialogs": [
              "701291004"
            ]
          },
          "701291004": {
            "id": "701291004",
            "speakerId": 22747,
            "speakerName": "Fadeev",
            "text": "Huh?",
            "nextDialogs": [
              "701291005"
            ]
          },
          "701291005": {
            "id": "701291005",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "I was summoned to perform at the Pale Crown Palace back then on account of my speed, you know.",
            "nextDialogs": [
              "701291006"
            ]
          },
          "701291006": {
            "id": "701291006",
            "speakerId": 22748,
            "speakerName": "Bragin",
            "text": "I could create a statue in but an instant. What, did you think I'd make His Majesty the Tsar sit there all day waiting for me to finish performing?",
            "nextDialogs": [
              "701291007"
            ]
          },
          "701291007": {
            "id": "701291007",
            "speakerId": 22747,
            "speakerName": "Fadeev",
            "text": "I—I see..."
          }
        }
      }
    },
    {
      "subId": "7012911",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701291101"
        ],
        "dialogs": {
          "701291101": {
            "id": "701291101",
            "speakerId": 22746,
            "speakerName": "Churin",
            "text": "Hmm? What is it...? Do you need anything, adventurer?",
            "nextDialogs": [
              "701291103",
              "701291105"
            ]
          },
          "701291103": {
            "id": "701291103",
            "speakerId": 22746,
            "speakerName": "Churin",
            "text": "A—Alright. Master did say that sparring would do me good as well..."
          },
          "701291105": {
            "id": "701291105",
            "speakerId": 22746,
            "speakerName": "Churin",
            "text": "Um... Then, please don't disturb me. I still need to finish my sculptures for today."
          }
        }
      }
    }
  ]
}
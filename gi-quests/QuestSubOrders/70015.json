        ],
        "dialogs": {
          "700150101": {
            "id": "700150101",
            "speakerId": 1000,
            "speakerName": "Pensive Hilichurl",
            "text": "Emmm... Yoyo, ika? Tomo?",
            "nextDialogs": [
              "700150102"
            ]
          },
          "700150102": {
            "id": "700150102",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Mimi tomo.",
            "nextDialogs": [
              "700150103"
            ]
          },
          "700150103": {
            "id": "700150103",
            "speakerId": 1000,
            "speakerName": "Pensive Hilichurl",
            "text": "Tomo tomo. Tomo dala si? Domu nye, ika nye.",
            "nextDialogs": [
              "700150104"
            ]
          },
          "700150104": {
            "id": "700150104",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Ye muhe dala? Mimi mani ye.",
            "nextDialogs": [
              "700150105"
            ]
          },
          "700150105": {
            "id": "700150105",
            "speakerId": 1000,
            "speakerName": "Pensive Hilichurl",
            "text": "Ya tomo mani, mani yaya tome nye... Mi muhe du, du <color=#00E1FFFF>lata boya sada</color> si.",
            "nextDialogs": [
              "700150106"
            ]
          },
          "700150106": {
            "id": "700150106",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "It appears to want something... Oh, I think there's something about this in my handbook, why not take a look?"
          }
        }
      }
    },
    {
      "subId": "7001502",
      "subQuestName": "Give an item to the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700150301"
        ],
        "dialogs": {
          "700150301": {
            "id": "700150301",
            "speakerId": 1000,
            "speakerName": "Pensive Hilichurl",
            "text": "Mosi mita, yoyo tomo, mimi tomo.",
            "nextDialogs": [
              "700150302"
            ]
          },
          "700150302": {
            "id": "700150302",
            "speakerId": 1000,
            "speakerName": "Pensive Hilichurl",
            "text": "Odomu tomo zido mi! <color=#00E1FFFF>Unta mosi dada</color>!",
            "nextDialogs": [
              "700150303"
            ]
          },
          "700150303": {
            "id": "700150303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "<color=#00E1FFFF>Unta mosi dada</color>... Feels like we've heard this before. Maybe it'll be in the handbook?",
            "nextDialogs": [
              "700150306"
            ]
          },
          "700150306": {
            "id": "700150306",
            "speakerId": 1000,
            "speakerName": "Pensive Hilichurl",
            "text": "Valo, mi tomo!",
            "nextDialogs": [
              "700150307"
            ]
          },
          "700150307": {
            "id": "700150307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Valo!"
          }
        }
      }
    },

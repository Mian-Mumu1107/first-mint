              "726770112"
            ]
          },
          "726770104": {
            "id": "726770104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#But it is very special, isn't it? How would you describe it, {NICKNAME}?"
          },
          "726770109": {
            "id": "726770109",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm, splendid, like Paimon!",
            "nextDialogs": [
              "726770110"
            ]
          },
          "726770110": {
            "id": "726770110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Uh, Paimon doesn't think that's what {NICKNAME} means... But whatever! That's a clever boy, Kichiboushi!"
          },
          "726770112": {
            "id": "726770112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Huh, aren't you using a couple of words too few, {NICKNAME}?"
          }
        }
      }

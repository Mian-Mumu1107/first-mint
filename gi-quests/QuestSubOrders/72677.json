        ],
        "dialogs": {
          "726770101": {
            "id": "726770101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is a super special view, isn't it?",
            "nextDialogs": [
              "726770102"
            ]
          },
          "726770102": {
            "id": "726770102",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "So much water, super special colors, mm!",

    {
      "subId": "7267708",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726770801"
        ],
        "dialogs": {
          "726770801": {
            "id": "726770801",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "So warm.",
            "nextDialogs": [
              "726770802"
            ]
          },
          "726770802": {
            "id": "726770802",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "If we had a Flaming Flower at Dragonspine, would be good!",
            "nextDialogs": [
              "726770803"
            ]
          },
          "726770803": {
            "id": "726770803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He's got a point. We should probably have gone better prepared...",
            "nextDialogs": [
              "726770804"
            ]
          },
          "726770804": {
            "id": "726770804",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Paimon, if we had a very big flower, could we make the snowy mountain have no snow?",
            "nextDialogs": [
              "726770805"
            ]
          },
          "726770805": {
            "id": "726770805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "P—Probably not...",
            "nextDialogs": [
              "726770806"
            ]
          },
          "726770806": {
            "id": "726770806",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm.",
            "nextDialogs": [
              "726770807"
            ]
          },
          "726770807": {
            "id": "726770807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We could take Kichiboushi to see a \"very big Flaming Flower.\"",
            "nextDialogs": [
              "726770808"
            ]
          },
          "726770808": {
            "id": "726770808",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Wait, you mean...",
            "nextDialogs": [
              "726770811"
            ]
          },
          "726770811": {
            "id": "726770811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright then, guess that's Kichiboushi's training for today!"
          }
        }
      }
    },
    {
      "subId": "7267703",
      "subQuestName": "Go into the depths of the cavern where the Pyro Regisvine is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726770301"
        ],
        "dialogs": {
          "726770301": {
            "id": "726770301",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "So big! So hot! Amazing to have big fire flower!",
            "nextDialogs": [
              "726770302"
            ]
          },
          "726770302": {
            "id": "726770302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right? Ooh, also...",
            "nextDialogs": [
              "726770303"
            ]
          },
          "726770303": {
            "id": "726770303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hang on a moment, Kichiboushi. Let's take a photo of you!",
            "nextDialogs": [
              "726770304"
            ]
          },
          "726770304": {
            "id": "726770304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In this steaming hot place?",
            "nextDialogs": [
              "726770305"
            ]
          },
          "726770305": {
            "id": "726770305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's the whole point!",
            "nextDialogs": [
              "726770306"
            ]
          },
          "726770306": {
            "id": "726770306",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm... Okay..."
          }
        }
      }
    },
    {
      "subId": "7267704",
      "subQuestName": "Take a picture of Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726770401"
        ],
        "dialogs": {
          "726770401": {
            "id": "726770401",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ooh.. So hot...",
            "nextDialogs": [
              "726770402"
            ]
          },
          "726770402": {
            "id": "726770402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, guess you know now, eh, Kichiboushi?",
            "nextDialogs": [
              "726770403"
            ]
          },
          "726770403": {
            "id": "726770403",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm?",
            "nextDialogs": [
              "726770404"
            ]
          },
          "726770404": {
            "id": "726770404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Know what, Paimon?",
            "nextDialogs": [
              "726770405"
            ]
          },
          "726770405": {
            "id": "726770405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Can you imagine if we had to draw you?",
            "nextDialogs": [
              "726770406"
            ]
          },
          "726770406": {
            "id": "726770406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And that's why we chose to take photos instead! It's not that we don't care. It's precisely because we care about you that we decided to save time!",
            "nextDialogs": [
              "726770410"
            ]
          },
          "726770410": {
            "id": "726770410",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Understood. Photo, good. So... hot...",
            "nextDialogs": [
              "726770411"
            ]
          },
          "726770411": {
            "id": "726770411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's take the heat source out. The quicker, the better.",
            "nextDialogs": [
              "726770412"
            ]
          },
          "726770412": {
            "id": "726770412",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mmmm..."
          }
        }
      }
    },

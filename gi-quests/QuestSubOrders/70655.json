  "subQuests": [
    {
      "subId": "7065501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706550101"
        ],
        "dialogs": {
          "706550101": {
            "id": "706550101",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "We meet again, Traveler!",
            "nextDialogs": [
              "706550102"
            ]
          },
          "706550102": {
            "id": "706550102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, you seem to be in pretty high spirits, Dr. Livingstone. Did something good happen?",
            "nextDialogs": [
              "706550103"
            ]
          },
          "706550103": {
            "id": "706550103",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "It's something that might seem troublesome, but is in fact pretty interesting.",
            "nextDialogs": [
              "706550104"
            ]
          },
          "706550104": {
            "id": "706550104",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "I'm sure that it would interest an adventurer as wise, strong, and disposed to action as you are.",
            "nextDialogs": [
              "706550107"
            ]
          },
          "706550107": {
            "id": "706550107",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "Do you remember the <color=#00E1FFFF>Meaty Tribe's Arena</color>? Lately, it seems like some sort of no-holds-barred fighting tournament is being held around there.",
            "nextDialogs": [
              "706550108"
            ]
          },
          "706550108": {
            "id": "706550108",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "As I've mentioned before, I still have further research that I intend to conduct in this area. But the whole gorge is all a-bustle these days due to this tournament, which has disrupted my progress.",
            "nextDialogs": [
              "706550109"
            ]
          },
          "706550109": {
            "id": "706550109",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "Still, the idea of a no-holds-barred tournament is a rather intriguing one, don't you think?",
            "nextDialogs": [
              "706550110"
            ]
          },
          "706550110": {
            "id": "706550110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "I—Intriguing?",
            "nextDialogs": [
              "706550111"
            ]
          },
          "706550111": {
            "id": "706550111",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "I'm sure that the desire to be the strongest in Teyvat has crossed everyone's mind at some point, right? It seems hilichurls are no exception.",
            "nextDialogs": [
              "706550112"
            ]
          },
          "706550112": {
            "id": "706550112",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "Dadaupa Gorge is sacred to the hilichurls, and strong fighters are gathering from every corner of the continent to this place.",
            "nextDialogs": [
              "706550113"
            ]
          },
          "706550113": {
            "id": "706550113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Now, I wouldn't claim to be that strong...",
            "nextDialogs": [
              "706550114"
            ]
          },
          "706550114": {
            "id": "706550114",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "What I'm trying to say is: You once conquered the <color=#00E1FFFF>Meaty Tribe's Arena</color>. Why don't you give the tournament a whirl?",
            "nextDialogs": [
              "706550115"
            ]
          },
          "706550115": {
            "id": "706550115",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "The sooner you win that tournament, the sooner I can get back to work. It's a win-win!",
            "nextDialogs": [
              "706550116"
            ]
          },
          "706550116": {
            "id": "706550116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll consider it.",
            "nextDialogs": [
              "706550117"
            ]
          },
          "706550117": {
            "id": "706550117",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "I'll do my best to support you, for my part. Ad astra abyssosque!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2204601",
      "subQuestName": "Talk to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220460101"
        ],
        "dialogs": {
          "220460101": {
            "id": "220460101",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "The shrine is getting messy again...",
            "nextDialogs": [
              "220460102"
            ]
          },
          "220460102": {
            "id": "220460102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "220460103"
            ]
          },
          "220460103": {
            "id": "220460103",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow, it is you again. Well met.",
            "nextDialogs": [
              "220460104"
            ]
          },
          "220460104": {
            "id": "220460104",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "After a little neglect, the shrine's surroundings have started to collect dirt.",
            "nextDialogs": [
              "220460105"
            ]
          },
          "220460105": {
            "id": "220460105",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "This is no way to greet those humans coming to pay their respects.",
            "nextDialogs": [
              "220460106"
            ]
          },
          "220460106": {
            "id": "220460106",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Could you aid me in cleaning up the shrine, as you did before?",
            "nextDialogs": [
              "220460108",
              "220460113"
            ]
          },
          "220460108": {
            "id": "220460108",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "I... will not speak to those two green humans of my own accord.",
            "nextDialogs": [
              "220460109"
            ]
          },
          "220460109": {
            "id": "220460109",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "The tall human always looks upon me with a strange gaze...",
            "nextDialogs": [
              "220460110"
            ]
          },
          "220460110": {
            "id": "220460110",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "And the other green human never seems particularly... motivated?",
            "nextDialogs": [
              "220460111"
            ]
          },
          "220460111": {
            "id": "220460111",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow meow, regardless, they are not reliable humans.",
            "nextDialogs": [
              "220460115"
            ]
          },
          "220460115": {
            "id": "220460115",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Whatever the case, I can only rely on you for this task. Just use the long stick and the water to clean up."
          },
          "220460113": {
            "id": "220460113",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "The stone human is always busy with his knock-knock-knocking. Who knows what he is doing.",
            "nextDialogs": [
              "220460114"
            ]
          },
          "220460114": {
            "id": "220460114",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "The stone was knocked, after all. What is he knocking this time, I wonder... How annoying..."
          }
        }
      }
    },
    {
      "subId": "2204602",
      "subQuestName": "Clean the dirt around the Asase Shrine away",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220460201"
        ],
        "dialogs": {
          "220460201": {
            "id": "220460201",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "In any case, the cleanup shall be left to you. I will wait for you here, meow meow."
          }
        }
      }
    },
    {
      "subId": "2204603",
      "subQuestName": "Report back to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220460301"
        ],
        "dialogs": {
          "220460301": {
            "id": "220460301",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Mm, have you finished this \"cleanup\" business?",
            "nextDialogs": [
              "220460302"
            ]
          },
          "220460302": {
            "id": "220460302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We sure have.",
            "nextDialogs": [
              "220460303"
            ]
          },
          "220460303": {
            "id": "220460303",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow meow, that is good. You are indeed very reliable.",
            "nextDialogs": [
              "220460304"
            ]
          },
          "220460304": {
            "id": "220460304",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "The shrine certainly looks the part now. Ah, Hibiki will be pleased when she returns.",
            "nextDialogs": [
              "220460305"
            ]
          },
          "220460305": {
            "id": "220460305",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "I must continue taking good care of this shrine... Meow meow..."
          }
        }
      }
    }
  ]

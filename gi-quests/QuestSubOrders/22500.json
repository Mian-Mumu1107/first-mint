  },
  "subQuests": [
    {
      "subId": "2250001",
      "subQuestName": "Talk to Little Lulu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225000101"
        ],
        "dialogs": {
          "225000101": {
            "id": "225000101",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "When will it be ready?",
            "nextDialogs": [
              "225000102"
            ]
          },
          "225000102": {
            "id": "225000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No playtime today?",
            "nextDialogs": [
              "225000103"
            ]
          },
          "225000103": {
            "id": "225000103",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Oh, hello! No, playtime doesn't seem to come at all these days.",
            "nextDialogs": [
              "225000104"
            ]
          },
          "225000104": {
            "id": "225000104",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Little Meng's in a bad mood and prefers to sulk by himself, and Little Fei keeps disappearing all the time.",
            "nextDialogs": [
              "225000105"
            ]
          },
          "225000105": {
            "id": "225000105",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "I asked Little Meng what's wrong, but he wouldn't tell me. They're both acting so strange these days, I honestly don't know what's gotten into them.",
            "nextDialogs": [
              "225000107",
              "225000111"
            ]
          },
          "225000107": {
            "id": "225000107",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Wait, so when you grow up you stop being happy? Then why do Little Meng and Little Fei want to grow up so bad...",
            "nextDialogs": [
              "225000108"
            ]
          },
          "225000108": {
            "id": "225000108",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "I guess I'll just not grow up, then.",
            "nextDialogs": [
              "225000109"
            ]
          },
          "225000109": {
            "id": "225000109",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Anyway, we're getting sidetracked. I actually need your help with something.",
            "nextDialogs": [
              "225000112"
            ]
          },
          "225000112": {
            "id": "225000112",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Can you fetch something from Ying'er's place for me? We already talked about it, so she should have it ready by now."
          },
          "225000111": {
            "id": "225000111",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Me? No, I'm okay. But... I do need your help with something."
          }
        }
      }
    },
    {
      "subId": "2250002",
      "subQuestName": "Talk to Ying'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225000301"
        ],
        "dialogs": {
          "225000301": {
            "id": "225000301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How does 3,000 Mora sound?",
            "nextDialogs": [
              "225000302"
            ]
          },
          "225000302": {
            "id": "225000302",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Wow, someone's desperate... Alright then, I will prioritize Lulu's perfume for the sake of our friendship.",
            "nextDialogs": [
              "225000303"
            ]
          },
          "225000303": {
            "id": "225000303",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "I have to watch the shop during the day, though. My personal affairs are best dealt with at night.",
            "nextDialogs": [
              "225000304"
            ]
          },
          "225000304": {
            "id": "225000304",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Swing by tonight and I'll have everything ready for you."
          }
        }
      }
    },
    {
      "subId": "2250003",
      "subQuestName": "Wait until night",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2250004",
      "subQuestName": "Talk to Ying'er and obtain the perfume",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225000501"
        ],
        "dialogs": {
          "225000501": {
            "id": "225000501",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "The perfume is ready. A bespoke variety made with Mint Essential Oil.",
            "nextDialogs": [
              "225000502"
            ]
          },
          "225000502": {
            "id": "225000502",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Here you go. It's ready for Little Lulu now.",
            "nextDialogs": [
              "225000505"
            ]
          },
          "225000505": {
            "id": "225000505",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "It counteracts some of the more... hmm, stimulating elements with its neutral scent...",
            "nextDialogs": [
              "225000506"
            ]
          },
          "225000506": {
            "id": "225000506",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "To be honest, I was very surprised to receive an order from Lulu.",
            "nextDialogs": [
              "225000507"
            ]
          },
          "225000507": {
            "id": "225000507",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "It does make me reminisce about being that age, when one has one's first taste of love, oh how it makes the heart flutter... If only I had been a little more worldly wise back then...",
            "nextDialogs": [
              "225000508"
            ]
          },
          "225000508": {
            "id": "225000508",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Ahem... Anyway, I should let you get back to Lulu."
          }
        }
      }
    },
    {
      "subId": "2250005",
      "subQuestName": "Search for 3 Mint leaves",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2250006",
      "subQuestName": "Craft Mint Essential Oil",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225000601"
        ],
        "dialogs": {
          "225000601": {
            "id": "225000601",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Hi, did you get my perfume?",
            "nextDialogs": [
              "225000602"
            ]
          },
          "225000602": {
            "id": "225000602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I did.",
            "nextDialogs": [
              "225000603"
            ]
          },
          "225000603": {
            "id": "225000603",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Thank you! Ying'er makes the best perfume ever.",
            "nextDialogs": [
              "225000604"
            ]
          },
          "225000604": {
            "id": "225000604",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "I wonder what Little Meng and Little Fei will do when they smell it...",
            "nextDialogs": [
              "225000605"
            ]
          },
          "225000605": {
            "id": "225000605",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "I think that however they react, it will be a lot of fun to watch.",
            "nextDialogs": [
              "225000607",
              "225000609"
            ]
          },
          "225000607": {
            "id": "225000607",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Hope so. That would be the best.",
            "nextDialogs": [
              "225000610"
            ]
          },
          "225000610": {
            "id": "225000610",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Thanks for helping me. I'll go home soon and have a go of my new perfume.",
            "nextDialogs": [
              "225000611"
            ]
          },
          "225000611": {
            "id": "225000611",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "If it's good, then I can keep using it again and again."
          },
          "225000609": {
            "id": "225000609",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Hmm? I don't prefer either of them... I prefer both of them! Little Meng and Little Fei are both my best friends."
          }
        }
      }
    },
    {
      "subId": "2250007",
      "subQuestName": "Wait for Ying'er to decoct the perfume",
      "sceneId": null,
      "locations": [],
      "dialogue": {

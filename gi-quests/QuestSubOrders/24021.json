    {
      "subId": "2402107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240210701"
        ],
        "dialogs": {
          "240210701": {
            "id": "240210701",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "You... Why did you bring both boxes of files over?",
            "nextDialogs": [
              "240210703",
              "240210705"
            ]
          },
          "240210703": {
            "id": "240210703",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Pffft... I guess that's just how you roll. Thanks! Both boxes have files I need to organize, anyway.",
            "nextDialogs": [
              "240210706"
            ]
          },
          "240210706": {
            "id": "240210706",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Since you've brought them both over, I should get going now. This is going to be a huge task!",
            "nextDialogs": [
              "240210707"
            ]
          },
          "240210707": {
            "id": "240210707",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Please, take these, and thank you again for your help, Honorary Senior Researcher.",
            "nextDialogs": [
              "240210708"
            ]
          },
          "240210708": {
            "id": "240210708",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "*sigh* When will the Institute finally assign me an assistant..."
          },
          "240210705": {
            "id": "240210705",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Your instincts are accurate as ever. Both boxes do indeed contain files I need to organize."
          }
        }
      }
    },
    {
      "subId": "2402108",

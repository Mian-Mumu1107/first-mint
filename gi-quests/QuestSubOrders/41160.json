            ]
          },
          "411600304": {
            "id": "411600304",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "Could I trouble you to deliver this Jewelry Soup for me? <color=#00E1FFFF>Just try not to use your wind glider to get there</color>, or some of the soup might spill."
          }

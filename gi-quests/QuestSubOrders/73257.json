    {
      "subId": "7325704",
      "subQuestName": "Talk to Mihir and Rashnu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732570401"
        ],
        "dialogs": {
          "732570401": {
            "id": "732570401",
            "speakerId": 20892,
            "speakerName": "Rashnu",
            "text": "What took Sorush so long...",
            "nextDialogs": [
              "732570402"
            ]
          },
          "732570402": {
            "id": "732570402",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "We've been waiting here for a very long time.",
            "nextDialogs": [
              "732570403"
            ]
          },
          "732570403": {
            "id": "732570403",
            "speakerId": 20892,
            "speakerName": "Rashnu",
            "text": "I'm so tired... I want to... go back to sleep. Zzz...",
            "nextDialogs": [
              "732570404"
            ]
          },
          "732570404": {
            "id": "732570404",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "Hey, that's not fair. I'm the one who's been laboring hard all along and you didn't do anything!",
            "nextDialogs": [
              "732570405"
            ]
          },
          "732570405": {
            "id": "732570405",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "That's not true. Waiting is also an important job. In fact, acting is only momentary while waiting is eternal.",
            "nextDialogs": [
              "732570406"
            ]
          },
          "732570406": {
            "id": "732570406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's with this weird logic...",
            "nextDialogs": [
              "732570407"
            ]
          },
          "732570407": {
            "id": "732570407",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "That's just the philosophy of us Pari.",
            "nextDialogs": [
              "732570408"
            ]
          },
          "732570408": {
            "id": "732570408",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "But now is not the time to discuss philosophies. What matters is the Great Songs of Khvarena. I trust you've collected all of them, no?",
            "nextDialogs": [
              "732570409"
            ]
          },
          "732570409": {
            "id": "732570409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Of course we have!",
            "nextDialogs": [
              "732570410"
            ]
          },
          "732570410": {
            "id": "732570410",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "In that case, let us remove the seal. Then you can gather the power of Khvarena with the Great Songs.",
            "nextDialogs": [
              "732570411"
            ]
          },
          "732570411": {
            "id": "732570411",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "But be careful. Since the filth has been building up for centuries, I have no idea what will emerge once I remove the seal."
          }
        }
      }
    },
    {
      "subId": "7325705",
      "subQuestName": "Place the Great Song of Khvarena",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7325730",
      "subQuestName": "Talk to Mihir",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732573001"
        ],
        "dialogs": {
          "732573001": {
            "id": "732573001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now that we've placed the Great Khvarena properly, everything around here seems to have recovered!",
            "nextDialogs": [
              "732573002"
            ]
          },
          "732573002": {
            "id": "732573002",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "These trees were originally cultivated with Khvarena to resist the corrosion of the cataclysm. It's just that their power has ebbed away with the passage of time.",
            "nextDialogs": [
              "732573003"
            ]
          },
          "732573003": {
            "id": "732573003",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "With the Great Songs' nourishment, they will be able to regain their former glory.",
            "nextDialogs": [
              "732573004"
            ]
          },
          "732573004": {
            "id": "732573004",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "But with the seal removed now, the filth from the past has been freed, too.",
            "nextDialogs": [
              "732573005"
            ]
          },
          "732573005": {
            "id": "732573005",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "The rite won't be able to continue if Rashnu and I spend all our energy here. So please take care of these locations for us.",
            "nextDialogs": [
              "732573006"
            ]
          },
          "732573006": {
            "id": "732573006",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "Hehe, leave it to me! It's the Bloomguard's job to fight defilement!"
          }
        }
      }
    },

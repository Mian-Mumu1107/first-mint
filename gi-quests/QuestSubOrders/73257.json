  "subQuests": [
    {
      "subId": "7325715",
      "subQuestName": "Go to the Vourukasha Oasis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571501"
        ],
        "dialogs": {
          "732571501": {
            "id": "732571501",
            "speakerId": 4283,
            "speakerName": "Nasejuna",
            "text": "Then I shall leave the matter of the Twin-Horned Chaplet to you. I have some leftover work to take care of.",
            "nextDialogs": [
              "732571502"
            ]
          },
          "732571502": {
            "id": "732571502",
            "speakerId": 4283,
            "speakerName": "Nasejuna",
            "text": "I believe that all people, no matter who they are, will submit to you and the Envoy's awesome glory.",
            "nextDialogs": [
              "732571503"
            ]
          },
          "732571503": {
            "id": "732571503",
            "speakerId": 4283,
            "speakerName": "Nasejuna",
            "text": "When we have each done what we must, let us meet at the campsite upon the Temir Mountains."
          }
        }
      }
    },
    {
      "subId": "7325701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732570101"
        ],
        "dialogs": {
          "732570101": {
            "id": "732570101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sorush's been pretty quiet since we left the ruined factory.",
            "nextDialogs": [
              "732570102"
            ]
          },
          "732570102": {
            "id": "732570102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She used to keep talking on and on, so Paimon's not used to her being silent now.",
            "nextDialogs": [
              "732570106"
            ]
          },
          "732570106": {
            "id": "732570106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Cheer up, Sorush! We've still got so many things to do!",
            "nextDialogs": [
              "732570107"
            ]
          },
          "732570107": {
            "id": "732570107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "For instance, we need to perform... um, that rite with a name Paimon can't remember, and then fix the giant hole.",
            "nextDialogs": [
              "732570108"
            ]
          },
          "732570108": {
            "id": "732570108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "After we're done, let's treat ourselves to something delicious for our hard work!",
            "nextDialogs": [
              "732570109"
            ]
          },
          "732570109": {
            "id": "732570109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We can have... Um, Paimon doesn't know what Pari prefer for food...",
            "nextDialogs": [
              "732570110"
            ]
          },
          "732570110": {
            "id": "732570110",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "...",
            "nextDialogs": [
              "732570111"
            ]
          },
          "732570111": {
            "id": "732570111",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "...Pari don't need to eat, Silly Floater.",
            "nextDialogs": [
              "732570112"
            ]
          },
          "732570112": {
            "id": "732570112",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "*sigh* To think I have fallen so low to require the Pale Floater's comfort, what a shame.",
            "nextDialogs": [
              "732570113"
            ]
          },
          "732570113": {
            "id": "732570113",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "I'd rather be sealed into the Gray Crystals right away or find myself a cavern to slumber undisturbed for eternity, till everyone I know ceases to exist.",
            "nextDialogs": [
              "732570114"
            ]
          },
          "732570114": {
            "id": "732570114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon said Paimon's not a Pale Floater! But is there really such a cavern?"
          }
        }
      }
    },
    {
      "subId": "7325702",
      "subQuestName": "Talk to Zurvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732570201"
        ],
        "dialogs": {
          "732570201": {
            "id": "732570201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Zurvan, we're back!",
            "nextDialogs": [
              "732570202"
            ]
          },
          "732570202": {
            "id": "732570202",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "#Ah, it's {NICKNAME}, Sorush, and Paimon.",
            "nextDialogs": [
              "732570203"
            ]
          },
          "732570203": {
            "id": "732570203",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "By the looks of it, you must've obtained all the Great Songs of Khvarena.",
            "nextDialogs": [
              "732570206"
            ]
          },
          "732570206": {
            "id": "732570206",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "Whatever the case, the result is desirable. I was right to entrust the mission to you.",
            "nextDialogs": [
              "732570207"
            ]
          },
          "732570207": {
            "id": "732570207",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "Without you, the Great Songs of Khvarena might've been robbed away by those with ill intent.",
            "nextDialogs": [
              "732570208"
            ]
          },
          "732570208": {
            "id": "732570208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, why does Paimon feel like Zurvan saw what was coming?",
            "nextDialogs": [
              "732570209"
            ]
          },
          "732570209": {
            "id": "732570209",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "Eh-he, so I was on to something! You didn't run into the followers of the dark hollow, did you?"
          }
        }
      }
    },

    {
      "subId": "7325714",
      "subQuestName": "Talk to Mihir and Rashnu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571401"
        ],
        "dialogs": {
          "732571401": {
            "id": "732571401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's gotten quiet, finally.",
            "nextDialogs": [
              "732571402"
            ]
          },
          "732571402": {
            "id": "732571402",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Now, perform the Rite of Chinvat before the filth starts to ooze out again.",
            "nextDialogs": [
              "732571403"
            ]
          },
          "732571403": {
            "id": "732571403",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Then our job will be done.",
            "nextDialogs": [
              "732571404"
            ]
          },
          "732571404": {
            "id": "732571404",
            "speakerId": 20892,
            "speakerName": "Rashnu",
            "text": "And that means... I can sleep in peace... without anyone disturbing me.",
            "nextDialogs": [
              "732571405"
            ]
          },
          "732571405": {
            "id": "732571405",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Come on, Sorush!",
            "nextDialogs": [
              "732571406"
            ]
          },
          "732571406": {
            "id": "732571406",
            "speakerId": 20892,
            "speakerName": "Rashnu",
            "text": "Sorush, hurry up!",
            "nextDialogs": [
              "732571407"
            ]
          },
          "732571407": {
            "id": "732571407",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "It has to be the three of us."
          }
        }
      }
    },
    {
      "subId": "7325711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571101"
        ],
        "dialogs": {
          "732571101": {
            "id": "732571101",
            "speakerId": 20892,
            "speakerName": "Rashnu",
            "text": "I'm so tired... I want to... go back to sleep. Zzz..."
          }
        }
      }
    },
    {
      "subId": "7325729",
      "subQuestName": "Talk to Mihir and Rashnu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732572901"
        ],
        "dialogs": {
          "732572901": {
            "id": "732572901",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Done. The path to the depths has opened, and our mission is completed.",
            "nextDialogs": [
              "732572902"
            ]
          },
          "732572902": {
            "id": "732572902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, that was quick. You kept talking about \"rite\" and stuff, so Paimon thought it'd take a whole bunch of complicated incantations to conduct.",
            "nextDialogs": [
              "732572903"
            ]
          },
          "732572903": {
            "id": "732572903",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Hmph, only humans need such things, as they can't even wield the power of the elements on their own.",
            "nextDialogs": [
              "732572904"
            ]
          },
          "732572904": {
            "id": "732572904",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "We Pari are different, for our power and that of the Khvarena hail from the same source. It's like how you humans don't need to recite incantations to walk.",
            "nextDialogs": [
              "732572905"
            ]
          },
          "732572905": {
            "id": "732572905",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Um... Although you don't walk, you float.",
            "nextDialogs": [
              "732572906"
            ]
          },
          "732572906": {
            "id": "732572906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Like Paimon said, your logic is weird.",
            "nextDialogs": [
              "732572907"
            ]
          },
          "732572907": {
            "id": "732572907",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Anyway, let's not waste our time on this irrelevant topic. I'll leave what's next up to you.",
            "nextDialogs": [
              "732572908"
            ]
          },
          "732572908": {
            "id": "732572908",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "\"May the eternal Khvarena guide us on the upward path.\""
          }
        }
      }
    },
    {
      "subId": "7325710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571001"
        ],
        "dialogs": {
          "732571001": {
            "id": "732571001",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Whether it is Sorush or myself, all Pari have a duty that they must undertake.",
            "nextDialogs": [
              "732571002"
            ]
          },
          "732571002": {
            "id": "732571002",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "But you are different. You have come to help us out of the goodness of your hearts. For that, you have my thanks."
          }
        }
      }

    {
      "subId": "7325717",
      "subQuestName": "Talk to Mihir",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732571701"
        ],
        "dialogs": {
          "732571701": {
            "id": "732571701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mm, our work is done!",
            "nextDialogs": [
              "732571702"
            ]
          },
          "732571702": {
            "id": "732571702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It seems that some flowers have grown on the tree. But what do we do next?",
            "nextDialogs": [
              "732571703"
            ]
          },
          "732571703": {
            "id": "732571703",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Ah, don't look at me. I'm as clueless as you.",
            "nextDialogs": [
              "732571704"
            ]
          },
          "732571704": {
            "id": "732571704",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Now that Sorush has already put on the Twin-Horned Chaplet, she can connect to the memories and wisdom of the Harvisptokhm using the Chaplet.",
            "nextDialogs": [
              "732571705"
            ]
          },
          "732571705": {
            "id": "732571705",
            "speakerId": 20887,
            "speakerName": "Mihir",
            "text": "Give it a try, Sorush.",
            "nextDialogs": [
              "732571706"
            ]
          },
          "732571706": {
            "id": "732571706",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "I know, but I'm not yet used to the Chaplet!",
            "nextDialogs": [
              "732571707"
            ]
          },
          "732571707": {
            "id": "732571707",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "Um... I think I see new shoots sprouting, but the filth hasn't been fully cleansed yet.",
            "nextDialogs": [
              "732571708"
            ]
          },
          "732571708": {
            "id": "732571708",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "We still need to purify these flowers.",
            "nextDialogs": [
              "732571709"
            ]
          },
          "732571709": {
            "id": "732571709",
            "speakerId": 20883,
            "speakerName": "Sorush",
            "text": "Then the pure power of Khvarena will thrive again."
          }
        }
      }
    },

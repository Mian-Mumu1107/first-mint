    {
      "subId": "7501016",
      "subQuestName": "Save the scaredy-cat Alpaca",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750101601"
        ],
        "dialogs": {
          "750101601": {
            "id": "750101601",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750101602"
            ]
          },
          "750101602": {
            "id": "750101602",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "#Only after much \"Rawr! Rawr!\"-ing encouragement from {REALNAME[ID(2)|SHOWHOST(true)]} does the timid Alpaca climb back up using the freshly-laid wood plank path...",
            "nextDialogs": [
              "750101603"
            ]
          },
          "750101603": {
            "id": "750101603",
            "speakerId": 21490,
            "speakerName": "Scaredy-Cat Alpaca",
            "text": "Moo... Mmmmoo—",
            "nextDialogs": [
              "750101604"
            ]
          },
          "750101604": {
            "id": "750101604",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Oroo? Rawr! Raaawr!",
            "nextDialogs": [
              "750101605"
            ]
          },
          "750101605": {
            "id": "750101605",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "#Faced with {REALNAME[ID(2)|SHOWHOST(true)]}'s enthusiasm, the timid-looking Alpaca seems unafraid, instead bending down and gently touching {REALNAME[ID(2)|SHOWHOST(true)]} with its nose...",
            "nextDialogs": [
              "750101606"
            ]
          },
          "750101606": {
            "id": "750101606",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Roooah... Rawr!",
            "nextDialogs": [
              "750101607"
            ]
          },
          "750101607": {
            "id": "750101607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe! Guess that means you're getting on great, huh?",
            "nextDialogs": [
              "750101609",
              "750101611"
            ]
          },
          "750101609": {
            "id": "750101609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And Paimon's too... Wait, when did this become a competition?",
            "nextDialogs": [
              "750101612"
            ]
          },
          "750101612": {
            "id": "750101612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, it's kinda dangerous for this Alpaca to be out here completely on its own. We'd better go tell Wactana what's going on.",
            "nextDialogs": [
              "750101613"
            ]
          },
          "750101613": {
            "id": "750101613",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Also, Paimon's sure she'll be happy to hear that {REALNAME[ID(2)|SHOWHOST(true)]}'s made a friend, too!"
          },
          "750101611": {
            "id": "750101611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Jealous of who exactly...?"
          }
        }
      }
    },
    {
      "subId": "7501012",
      "subQuestName": "Report back to Wactana",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750101201"
        ],
        "dialogs": {
          "750101201": {
            "id": "750101201",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "I see you're back, little fella. How did it go? Make any Alpaca friends?",
            "nextDialogs": [
              "750101202"
            ]
          },
          "750101202": {
            "id": "750101202",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr rawr!",
            "nextDialogs": [
              "750101203"
            ]
          },
          "750101203": {
            "id": "750101203",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "Haha, aren't you a happy camper? Why, you're even making me feel all jolly!",
            "nextDialogs": [
              "750101204"
            ]
          },
          "750101204": {
            "id": "750101204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey, Wactana, shouldn't you be a bit more concerned about what happens to the Alpacas? The one {REALNAME[ID(2)|SHOWHOST(true)]} made friends with was in a real tight spot back there.",
            "nextDialogs": [
              "750101205"
            ]
          },
          "750101205": {
            "id": "750101205",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "That so? Guess I gotta talk to Half-Baked real quick then, tell it to take more care.",
            "nextDialogs": [
              "750101207",
              "750101209"
            ]
          },
          "750101207": {
            "id": "750101207",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "I mean, I am living the dream! C'mon, be happy for me and stuff!",
            "nextDialogs": [
              "750101211"
            ]
          },
          "750101211": {
            "id": "750101211",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "#Ah, yes. If {REALNAME[ID(2)|SHOWHOST(true)]}'s fond of the Alpaca toy over by the side, I can let y'all have it.",
            "nextDialogs": [
              "750101212"
            ]
          },
          "750101212": {
            "id": "750101212",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawwr!",
            "nextDialogs": [
              "750101213"
            ]
          },
          "750101213": {
            "id": "750101213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Guess {REALNAME[ID(2)|SHOWHOST(true)]} doesn't know what \"standing on ceremony\" is, huh. Thanks then, Wactana!",
            "nextDialogs": [
              "750101214"
            ]
          },
          "750101214": {
            "id": "750101214",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "Eh, no biggie. And if you wanna drop by again, you're always welcome."
          },
          "750101209": {
            "id": "750101209",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "Sure... But he was always a massive worrywart. If I took him off Alpaca guard, he'd start losing fur from stress, I tell you!",
            "nextDialogs": [
              "750101210"
            ]
          },
          "750101210": {
            "id": "750101210",
            "speakerId": 21487,
            "speakerName": "Wactana",
            "text": "So this arrangement's best. Job satisfaction for him, free-and-easy living for me. Win-win, wouldn't you say?"
          }
        }
      }
    },

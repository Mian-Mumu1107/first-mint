    {
      "subId": "100914",
      "subQuestName": "Meet Cloud Retainer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10091401"
        ],
        "dialogs": {
          "10091401": {
            "id": "10091401",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "One is most impressed. The path that leads through this abode defies those of ordinary abilities.",
            "nextDialogs": [
              "10091402"
            ]
          },
          "10091402": {
            "id": "10091402",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "The one before you is the adeptus, Cloud Retainer. Now, speak of the matter which brings you here.",
            "nextDialogs": [
              "10091404",
              "10091406"
            ]
          },
          "10091404": {
            "id": "10091404",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "You surmise correctly. This place did oneself build, as did one design the mechanisms within.",
            "nextDialogs": [
              "10091407"
            ]
          },
          "10091407": {
            "id": "10091407",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "In fact, even Guizhong and Rex Lapis themselves found one's technological accomplishments to be worthy of commendation.",
            "nextDialogs": [
              "10091408"
            ]
          },
          "10091408": {
            "id": "10091408",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This place is huge! And there are so many mechanisms... Do you really have this whole place to yourself?",
            "nextDialogs": [
              "10091409"
            ]
          },
          "10091409": {
            "id": "10091409",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's it even for? Did you build it as your private mechanism workshop or something?",
            "nextDialogs": [
              "10091410"
            ]
          },
          "10091410": {
            "id": "10091410",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's just like the stories say. The adepti leave the human world, find somewhere to go be a hermit, and then they research and invent all these amazing things...",
            "nextDialogs": [
              "10091411"
            ]
          },
          "10091411": {
            "id": "10091411",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "One is simply not partial to the tedium of social interaction, and wished to find some peace and quiet.",
            "nextDialogs": [
              "10091412"
            ]
          },
          "10091412": {
            "id": "10091412",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "Find it one did... Shortly after which, you arrived bearing your Sigil of Permission...",
            "nextDialogs": [
              "10091413"
            ]
          },
          "10091413": {
            "id": "10091413",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "But enough! State the matter which brings you here, at once! You have disturbed the tranquility of this place for long enough.",
            "nextDialogs": [
              "10091414"
            ]
          },
          "10091414": {
            "id": "10091414",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "Rex Lapis... Assassinated!?",
            "nextDialogs": [
              "10091415"
            ]
          },
          "10091415": {
            "id": "10091415",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "How can this be!? Such a heinous crime... Who would dare?",
            "nextDialogs": [
              "10091416"
            ]
          },
          "10091416": {
            "id": "10091416",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "The notion is so preposterous as to be unbelievable... one shall have to verify the truth of the matter independently...",
            "nextDialogs": [
              "10091417"
            ]
          },
          "10091417": {
            "id": "10091417",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "...Perhaps one shall quash Liyue first, then convene with the other adepti—",
            "nextDialogs": [
              "10091418"
            ]
          },
          "10091418": {
            "id": "10091418",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Excuse me!?",
            "nextDialogs": [
              "10091419"
            ]
          },
          "10091419": {
            "id": "10091419",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, what!? Did you just say \"squash Liyue Harbor\"? Are you seriously gonna wipe out the whole city?",
            "nextDialogs": [
              "10091420"
            ]
          },
          "10091420": {
            "id": "10091420",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "Only a response of sufficient magnitude can negate the possibility of further incidents."
          },
          "10091406": {
            "id": "10091406",
            "speakerId": 1001,
            "speakerName": "Cloud Retainer",
            "text": "You surmise correctly."
          }
        }
      }
    },
    {

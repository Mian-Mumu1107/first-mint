  "subQuests": [
    {
      "subId": "7470601",
      "subQuestName": "Head near the aquarium tank",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747060101"
        ],
        "dialogs": {
          "747060101": {
            "id": "747060101",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Hmm... What about this one?",
            "nextDialogs": [
              "747060102"
            ]
          },
          "747060102": {
            "id": "747060102",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Mm, I still feel like it's missing something...",
            "nextDialogs": [
              "747060103"
            ]
          },
          "747060103": {
            "id": "747060103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Columbina? Furina? What are you guys up to?",
            "nextDialogs": [
              "747060104"
            ]
          },
          "747060104": {
            "id": "747060104",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Director Furina and I are... \"casting\"?",
            "nextDialogs": [
              "747060105"
            ]
          },
          "747060105": {
            "id": "747060105",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "What a wonderful way to put it! But the \"actors\" we're looking for... just so happen to be fish!",
            "nextDialogs": [
              "747060106"
            ]
          },
          "747060106": {
            "id": "747060106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Fish could be \"actors\"?",
            "nextDialogs": [
              "747060107"
            ]
          },
          "747060107": {
            "id": "747060107",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Animal actors are hardly a rarity these days. We're looking to cast a charismatic little fishie with just the right attitude to shoot some B-roll... It's essential for setting the mood.",
            "nextDialogs": [
              "747060108"
            ]
          },
          "747060108": {
            "id": "747060108",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "But I feel like we've seen every fish in the whole aquarium, and none of them quite fit the bill.",
            "nextDialogs": [
              "747060109"
            ]
          },
          "747060109": {
            "id": "747060109",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "#Should we try asking {NICKNAME} and Paimon for help? They have a knack for solving tricky problems.",
            "nextDialogs": [
              "747060110"
            ]
          },
          "747060110": {
            "id": "747060110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's happy you have so much faith in us... but when it comes to casting fish...",
            "nextDialogs": [
              "747060113"
            ]
          },
          "747060113": {
            "id": "747060113",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Great idea! You're the ones with aquarium management experience, after all.",
            "nextDialogs": [
              "747060114"
            ]
          },
          "747060114": {
            "id": "747060114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you're saying we should be on the lookout for talent whenever we go swimming? Paimon doesn't see why not!",
            "nextDialogs": [
              "747060115"
            ]
          },
          "747060115": {
            "id": "747060115",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Then it's settled! I'll fill you in on the attitude we're looking for later.",
            "nextDialogs": [
              "747060116"
            ]
          },
          "747060116": {
            "id": "747060116",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "I guess this makes you \"talent scouts\"?",
            "nextDialogs": [
              "747060117"
            ]
          },
          "747060117": {
            "id": "747060117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You've really picked up the showbiz vocab since you started hanging out with Furina..."
          }
        }
      }
    }
  ]
}
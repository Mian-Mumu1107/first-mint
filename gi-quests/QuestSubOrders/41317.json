      "dialogue": {
        "startDialogs": [
          "413111101"
        ],
        "dialogs": {
          "413111101": {
            "id": "413111101",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "So you're back, what do you think? Yi'nian makes some mean grub, huh?",
            "nextDialogs": [
              "413111102"
            ]
          },
          "413111102": {
            "id": "413111102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ahh, soooo tasty!",
            "nextDialogs": [
              "413111103"
            ]
          },
          "413111103": {
            "id": "413111103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He said he wouldn't look at the document...",
            "nextDialogs": [
              "413111104"
            ]
          },
          "413111104": {
            "id": "413111104",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Oh yeah? ...He said that last year, too... If he'd listened to our marketing tips, he'd be doing even better by now.",
            "nextDialogs": [
              "413111105"
            ]
          },
          "413111105": {
            "id": "413111105",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Anyway, not to worry. Here's the gift I was talking about. This Xiao Lantern is for you.",
            "nextDialogs": [
              "413111106"
            ]
          },
          "413111106": {
            "id": "413111106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! Such a beautiful lantern! How is it made?",
            "nextDialogs": [
              "413111107"
            ]
          },
          "413111107": {
            "id": "413111107",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Uh... I'm afraid I wouldn't be able to explain the process concisely.",
            "nextDialogs": [
              "413111108"
            ]
          },
          "413111108": {
            "id": "413111108",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "But if you're interested in Xiao Lanterns, you can ask <color=#00E1FFFF>Jingming</color> over there. He's in charge of both the Xiao and Mingxiao Lanterns.",
            "nextDialogs": [
              "413111109"
            ]
          },
          "413111109": {
            "id": "413111109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So he's responsible for the super-duper huge one too?",
            "nextDialogs": [
              "413111110"
            ]
          },
          "413111110": {
            "id": "413111110",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "That's right! He should be easy to find. Just over there, I think.",
            "nextDialogs": [
              "413111111"
            ]
          },
          "413111111": {
            "id": "413111111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If we could make a Xiao Lantern for Xiao... maybe that would cheer him up a bit!",
            "nextDialogs": [
              "413111112"
            ]
          },
          "413111112": {
            "id": "413111112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's find <color=#00E1FFFF>Jingming</color> and see what he has to say."
          }
        }
      }
    }
  ]
}
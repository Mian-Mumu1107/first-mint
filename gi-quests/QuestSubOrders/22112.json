  },
  "subQuests": [
    {
      "subId": "2211201",
      "subQuestName": "Talk to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120101"
        ],
        "dialogs": {
          "221120101": {
            "id": "221120101",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Looks like this is going to need repairing...",
            "nextDialogs": [
              "221120102"
            ]
          },
          "221120102": {
            "id": "221120102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "221120103"
            ]
          },
          "221120103": {
            "id": "221120103",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Ah, it's you. See for yourself — the staircase is broken...",
            "nextDialogs": [
              "221120104"
            ]
          },
          "221120104": {
            "id": "221120104",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "It's in pretty bad shape. Someone is definitely going to have an accident if it isn't repaired.",
            "nextDialogs": [
              "221120105"
            ]
          },
          "221120105": {
            "id": "221120105",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "How it broke, you ask? Well, a group of monsters tried to get inside, so I came out to fight them off.",
            "nextDialogs": [
              "221120106"
            ]
          },
          "221120106": {
            "id": "221120106",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "I should have pulled my punches... I sent one of the big heavy ones flying and he landed right on the staircase. It smashed on impact.",
            "nextDialogs": [
              "221120107"
            ]
          },
          "221120107": {
            "id": "221120107",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "I promised myself I'd fix it but I just haven't found the time. Reason being, the inn is just getting busier and busier at the moment. All the more reason why this repair is getting urgent...",
            "nextDialogs": [
              "221120108"
            ]
          },
          "221120108": {
            "id": "221120108",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "It's not a difficult job. I can easily repair this myself.",
            "nextDialogs": [
              "221120109"
            ]
          },
          "221120109": {
            "id": "221120109",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "If you have the time, could you fetch some Wooden Planks for me? I need to stay here in case someone else misses their step...",
            "nextDialogs": [
              "221120111",
              "221120114"
            ]
          },
          "221120111": {
            "id": "221120111",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Great. I actually bought the Wooden Planks already, they're currently stored just outside the inn.",
            "nextDialogs": [
              "221120112"
            ]
          },
          "221120112": {
            "id": "221120112",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "See if you can find them and bring a few back here."
          },
          "221120114": {
            "id": "221120114",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "That won't happen. I'm getting old anyway... and I'll make sure I restrain myself next time.",
            "nextDialogs": [
              "221120115"
            ]
          },
          "221120115": {
            "id": "221120115",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "In any case, it needs fixing whatever happens. I actually bought the Wooden Planks already, they're currently stored just outside the inn.",
            "nextDialogs": [
              "221120116"
            ]
          },
          "221120116": {
            "id": "221120116",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Please bring a few of them here for me."
          }
        }
      }
    },
    {
      "subId": "2211202",
      "subQuestName": "Collect 5 wooden planks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120201"
        ],
        "dialogs": {
          "221120201": {
            "id": "221120201",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Found them?",
            "nextDialogs": [
              "221120202"
            ]
          },
          "221120202": {
            "id": "221120202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "221120203"
            ]
          },
          "221120203": {
            "id": "221120203",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "They're just outside, they can't be that hard to find.",
            "nextDialogs": [
              "221120204"
            ]
          },
          "221120204": {
            "id": "221120204",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Go and take a look. I need to stay here in case someone else comes rushing past and has an accident..."
          }
        }
      }
    },
    {
      "subId": "2211203",
      "subQuestName": "Talk to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120301"
        ],
        "dialogs": {
          "221120301": {
            "id": "221120301",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Found them?",
            "nextDialogs": [
              "221120302"
            ]
          },
          "221120302": {
            "id": "221120302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "221120303"
            ]
          },
          "221120303": {
            "id": "221120303",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Let's see... Yes, that should be enough. Thanks.",
            "nextDialogs": [
              "221120304"
            ]
          },
          "221120304": {
            "id": "221120304",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Right, I should get to work. I need to repair this as quickly as I can..."
          }
        }
      }
    },
    {
      "subId": "2211204",
      "subQuestName": "Watch the repairing of the bridge",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2211205",
      "subQuestName": "Talk to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221120501"
        ],
        "dialogs": {
          "221120501": {
            "id": "221120501",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "There, that should do it. I don't think anyone's going to fall on this.",
            "nextDialogs": [
              "221120502"
            ]
          },
          "221120502": {
            "id": "221120502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It doesn't match the style though...",
            "nextDialogs": [
              "221120503"
            ]
          },
          "221120503": {
            "id": "221120503",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Not much I can do about that. I'm not some sort of master craftsman, you know.",
            "nextDialogs": [
              "221120504"
            ]
          },
          "221120504": {
            "id": "221120504",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Wait... That was only one of them. There's another hole I still need to fix...",
            "nextDialogs": [
              "221120505"
            ]
          },
          "221120505": {
            "id": "221120505",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Oh well, that will have to do for today. The inn is still open and I need to go back to serving the guests.",
            "nextDialogs": [
              "221120506"
            ]
          },
          "221120506": {
            "id": "221120506",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "No matter how badly it needs fixing, business is business... Thanks for your help. Take this for your trouble."
          }
        }
      }
    }
  ]
}
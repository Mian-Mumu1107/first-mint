    "Wriothesley": 33
  },
  "subQuests": [
    {
      "subId": "7469501",
      "subQuestName": "Talk to Wriothesley",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746950101"
        ],
        "dialogs": {
          "746950101": {
            "id": "746950101",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Hello there, Lady Trismegistus.",
            "nextDialogs": [
              "746950102"
            ]
          },
          "746950102": {
            "id": "746950102",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Oh? Such perfect pronunciation... I can only assume we share a friend?",
            "nextDialogs": [
              "746950103"
            ]
          },
          "746950103": {
            "id": "746950103",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "A certain Miss Columbina recommended your services.",
            "nextDialogs": [
              "746950104"
            ]
          },
          "746950104": {
            "id": "746950104",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "A very unpredictable lady, that Miss Columbina. I'm sure your encounter must have been full of surprises.",
            "nextDialogs": [
              "746950105"
            ]
          },
          "746950105": {
            "id": "746950105",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "It sure was. \"Unpredictable\" is the perfect word.",
            "nextDialogs": [
              "746950106"
            ]
          },
          "746950106": {
            "id": "746950106",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Pleased to make your acquaintance. The name's Wriothesley.",
            "nextDialogs": [
              "746950107"
            ]
          },
          "746950107": {
            "id": "746950107",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Le duc sous l'eau, in the flesh. It's a pleasure to meet you.",
            "nextDialogs": [
              "746950108"
            ]
          },
          "746950108": {
            "id": "746950108",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "I wouldn't have thought such a great mage as yourself would have heard of me. I'm honored.",
            "nextDialogs": [
              "746950109"
            ]
          },
          "746950109": {
            "id": "746950109",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Or perhaps you saw my arrival in the stars, Lady Trismegistus?",
            "nextDialogs": [
              "746950110"
            ]
          },
          "746950110": {
            "id": "746950110",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Hehe... Since we're already acquainted, let's dispense with the formalities. You can call me Barbeloth.",
            "nextDialogs": [
              "746950111"
            ]
          },
          "746950111": {
            "id": "746950111",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Then please, call me Wriothesley. This isn't official business, so there's no need for titles. I'm just a regular citizen of Fontaine enjoying some time off the clock.",
            "nextDialogs": [
              "746950112"
            ]
          },
          "746950112": {
            "id": "746950112",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "I came across some freshly baked Conch Madeleines on my way here. I hear mages enjoy a good tea party. Please, take one.",
            "nextDialogs": [
              "746950113"
            ]
          },
          "746950113": {
            "id": "746950113",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Oh my, this is a very popular dessert at our parties.",
            "nextDialogs": [
              "746950114"
            ]
          },
          "746950114": {
            "id": "746950114",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "I've been here for quite some time now, and read the fortunes of a fair few people, but this is the first time anyone's come bearing gifts.",
            "nextDialogs": [
              "746950115"
            ]
          },
          "746950115": {
            "id": "746950115",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Thank you, Mr. Wriothesley. I'll make sure to share it with Alice and the others.",
            "nextDialogs": [
              "746950116"
            ]
          },
          "746950116": {
            "id": "746950116",
            "speakerId": 1002,
            "speakerName": "Barbeloth?",
            "text": "...Is that my ears I feel tingling? Barbie! You simply have to save some for me!",
            "nextDialogs": [
              "746950117"
            ]
          },
          "746950117": {
            "id": "746950117",
            "speakerId": 1003,
            "speakerName": "Alice",
            "text": "Don't let Nicole scarf the lot down before I get there — it's not like she hasn't done it before!",
            "nextDialogs": [
              "746950118"
            ]
          },
          "746950118": {
            "id": "746950118",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Ahem! Yes, yes, I'll make sure she leaves some for you.",
            "nextDialogs": [
              "746950119"
            ]
          },
          "746950119": {
            "id": "746950119",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Honestly, you could have timed this better. Here I am, hoping to maintain the Hexenzirkel's dignity in front of our new friend...",
            "nextDialogs": [
              "746950120"
            ]
          },
          "746950120": {
            "id": "746950120",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "It's quite all right. Where's the harm? Powerful people don't have to be serious all the time. Everyone's entitled to a little personality.",
            "nextDialogs": [
              "746950121"
            ]
          },
          "746950121": {
            "id": "746950121",
            "speakerId": 1003,
            "speakerName": "Alice",
            "text": "Exactly! As a matter of fact, optimism and cheerfulness are core entry requirements of the Hexenzirkel.",
            "nextDialogs": [
              "746950122"
            ]
          },
          "746950122": {
            "id": "746950122",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "This is the first I've heard of it...",
            "nextDialogs": [
              "746950123"
            ]
          },
          "746950123": {
            "id": "746950123",
            "speakerId": 1003,
            "speakerName": "Alice",
            "text": "It's a new rule I just came up with! The Hexenzirkel is supposed to bring joy to the world. It's only natural that we're cheerful and optimistic!",
            "nextDialogs": [
              "746950124"
            ]
          },
          "746950124": {
            "id": "746950124",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Speaking only for myself, I support everyone enjoying life however they please — provided no laws are broken, of course.",
            "nextDialogs": [
              "746950125"
            ]
          },
          "746950125": {
            "id": "746950125",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "That's a provision you might struggle to get Alice to stick to...",
            "nextDialogs": [
              "746950126"
            ]
          },
          "746950126": {
            "id": "746950126",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Oh my, well this is a concern.",
            "nextDialogs": [
              "746950127"
            ]
          },
          "746950127": {
            "id": "746950127",
            "speakerId": 1003,
            "speakerName": "Alice",
            "text": "Hah, you two do realize I'm still here, right!?",
            "nextDialogs": [
              "746950128"
            ]
          },
          "746950128": {
            "id": "746950128",
            "speakerId": 1003,
            "speakerName": "Alice",
            "text": "Besides, I'm not going to do anything criminal in front of the Administrator of the Fortress of Meropide.",
            "nextDialogs": [
              "746950129"
            ]
          },
          "746950129": {
            "id": "746950129",
            "speakerId": 1003,
            "speakerName": "Alice",
            "text": "...And even if I was, I imagine your rooms are more spacious than the Knights of Favonius's solitary confinement room. Isn't that right, Mr. Wriothesley?",
            "nextDialogs": [
              "746950130"
            ]
          },
          "746950130": {
            "id": "746950130",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Haha! As though a mere solitary confinement room could hold a legendary mage such as yourself.",
            "nextDialogs": [
              "746950131"
            ]
          },
          "746950131": {
            "id": "746950131",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "I'm sure Lady Alice has willingly accepted her punishment, no doubt due to her humility and unimpeachable trustworthiness.",
            "nextDialogs": [
              "746950132"
            ]
          },
          "746950132": {
            "id": "746950132",
            "speakerId": 1003,
            "speakerName": "Alice",
            "text": "Exactly — you couldn't be more right!",
            "nextDialogs": [
              "746950133"
            ]
          },
          "746950133": {
            "id": "746950133",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Please stop, Mr. Wriothesley. You really shouldn't encourage her.",
            "nextDialogs": [
              "746950134"
            ]
          },
          "746950134": {
            "id": "746950134",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Once she's in a good mood, there's no telling what Alice might do.",
            "nextDialogs": [
              "746950137"
            ]
          },
          "746950137": {
            "id": "746950137",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "#That's right! {NICKNAME}'s the Honorary Knight of the Knights of Favonius, y'know! No talking bad about the solitary confinement room behind its back, hehe...",
            "nextDialogs": [
              "746950138"
            ]
          },
          "746950138": {
            "id": "746950138",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Does that mean it's up to the Honorary Knight to chase down escaped mages? That would make for a wonderful show. Please be sure to invite me.",
            "nextDialogs": [
              "746950139"
            ]
          },
          "746950139": {
            "id": "746950139",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "You just love watching the drama unfold!",
            "nextDialogs": [
              "746950140"
            ]
          },
          "746950140": {
            "id": "746950140",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Still, Paimon didn't expect you to come here by yourself, Wriothesley. That saves us a trip underwater to fetch you!",
            "nextDialogs": [
              "746950141"
            ]
          },
          "746950141": {
            "id": "746950141",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This must be the power of divination.",
            "nextDialogs": [
              "746950142"
            ]
          },
          "746950142": {
            "id": "746950142",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Ah, speaking of which, it's about time we got down to business.",
            "nextDialogs": [
              "746950143"
            ]
          },
          "746950143": {
            "id": "746950143",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Mr. Wriothesley, whether out of respect for Miss Columbina or as thanks for your confectionery, please draw a Lunar Arcanum.",
            "nextDialogs": [
              "746950144"
            ]
          },
          "746950144": {
            "id": "746950144",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Perhaps a gift from fate lies hidden within.",
            "nextDialogs": [
              "746950145"
            ]
          },
          "746950145": {
            "id": "746950145",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Does that count as a prophecy?",
            "nextDialogs": [
              "746950146"
            ]
          },
          "746950146": {
            "id": "746950146",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "You could say that.",
            "nextDialogs": [
              "746950147"
            ]
          },
          "746950147": {
            "id": "746950147",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Then no Fontainian would fail to take it seriously.",
            "nextDialogs": [
              "746950148"
            ]
          },
          "746950148": {
            "id": "746950148",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Having said how seriously he would take it, Wriothesley goes straight for the topmost card...",
            "nextDialogs": [
              "746950149"
            ]
          },
          "746950149": {
            "id": "746950149",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "I'm not too familiar with these cards. This one appears to be...",
            "nextDialogs": [
              "746950150"
            ]
          },
          "746950150": {
            "id": "746950150",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "The upright Emperor...",
            "nextDialogs": [
              "746950151"
            ]
          },
          "746950151": {
            "id": "746950151",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "You seem lost for words... Is this card bad? There's no need to worry, I can handle whatever you tell me.",
            "nextDialogs": [
              "746950152"
            ]
          },
          "746950152": {
            "id": "746950152",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "...Quite the opposite. This card signifies eternal dominion and unshakable authority.",
            "nextDialogs": [
              "746950153"
            ]
          },
          "746950153": {
            "id": "746950153",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "If this represents your future, then you have already reached your destination.",
            "nextDialogs": [
              "746950154"
            ]
          },
          "746950154": {
            "id": "746950154",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "But... Hehe, your fate keeps rolling forward, forever changing, which can only mean...",
            "nextDialogs": [
              "746950155"
            ]
          },
          "746950155": {
            "id": "746950155",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Perhaps it's not the person who changes, but their environment?",
            "nextDialogs": [
              "746950156"
            ]
          },
          "746950156": {
            "id": "746950156",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Mmhmm... At least for now, such a tendency does seem to exist.",
            "nextDialogs": [
              "746950157"
            ]
          },
          "746950157": {
            "id": "746950157",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Then I guess I can be a bit more confident in my intuition from now on.",
            "nextDialogs": [
              "746950158"
            ]
          },
          "746950158": {
            "id": "746950158",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "I previously visited Nod-Krai on official business and gained quite a bit of insight. Since then, I can't help but keep an eye on the local news.",
            "nextDialogs": [
              "746950159"
            ]
          },
          "746950159": {
            "id": "746950159",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Then, one night, as I was gazing at an unusually bright moon, I found myself thinking that the world is changing.",
            "nextDialogs": [
              "746950160"
            ]
          },
          "746950160": {
            "id": "746950160",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "The world is constantly changing, but with the introduction of such huge variables, we must all be prepared to face the unknown.",
            "nextDialogs": [
              "746950161"
            ]
          },
          "746950161": {
            "id": "746950161",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "That said, judging by the card you picked, you shouldn't have much to worry about. No matter how your environment changes, you have the means to either adapt or resist.",
            "nextDialogs": [
              "746950162"
            ]
          },
          "746950162": {
            "id": "746950162",
            "speakerId": 1000,
            "speakerName": "Wriothesley",
            "text": "Such wonderful news! Looks like I didn't take that punch for nothing..."
          }
        }
      }
    },

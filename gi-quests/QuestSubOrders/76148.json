  "subQuests": [
    {
      "subId": "7614801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761480101"
        ],
        "dialogs": {
          "761480101": {
            "id": "761480101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh! Where did you two go just now? Paimon nearly had a heart attack there.",
            "nextDialogs": [
              "761480102"
            ]
          },
          "761480102": {
            "id": "761480102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon was calling your names the whole time!",
            "nextDialogs": [
              "761480103"
            ]
          },
          "761480103": {
            "id": "761480103",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Hmm? Why wasn't Paimon dragged into the Apathic Interval?",
            "nextDialogs": [
              "761480104"
            ]
          },
          "761480104": {
            "id": "761480104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well... maybe because other than eating and sleeping...",
            "nextDialogs": [
              "761480105"
            ]
          },
          "761480105": {
            "id": "761480105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She doesn't really think about much at all?",
            "nextDialogs": [
              "761480106"
            ]
          },
          "761480106": {
            "id": "761480106",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Hmm. Makes sense.",
            "nextDialogs": [
              "761480107"
            ]
          },
          "761480107": {
            "id": "761480107",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Looks like Melanta really is angry now.",
            "nextDialogs": [
              "761480108"
            ]
          },
          "761480108": {
            "id": "761480108",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "#Sending {NICKNAME} up to face him has become urgent.",
            "nextDialogs": [
              "761480109"
            ]
          },
          "761480109": {
            "id": "761480109",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Let's talk somewhere else. This place isn't exactly safe anymore.",
            "nextDialogs": [
              "761480110"
            ]
          },
          "761480110": {
            "id": "761480110",
            "speakerId": 22311,
            "speakerName": "Alara",
            "text": "Um, well, I know no one asked, but... Hello, everyone. My name is Alara."
          }
        }
      }
    },
    {
      "subId": "7614806",
      "subQuestName": "Explore up ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {

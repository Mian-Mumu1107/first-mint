    {
      "subId": "7510707",
      "subQuestName": "Scout the area where the Saurian traffickers operate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070701"
        ],
        "dialogs": {
          "751070701": {
            "id": "751070701",
            "speakerId": 1006,
            "speakerName": "Sinister Voice From Above",
            "text": "It's a real shame that Qucusaurus got away. That quality would fetch top Mora, no doubt about it...",
            "nextDialogs": [
              "751070702"
            ]
          },
          "751070702": {
            "id": "751070702",
            "speakerId": 1007,
            "speakerName": "Sly Voice From Above",
            "text": "It's cool. The boss enhanced the frangible rounds. The new models could knock a Tatankasaurus out cold without even leaving a trace!",
            "nextDialogs": [
              "751070703"
            ]
          },
          "751070703": {
            "id": "751070703",
            "speakerId": 1007,
            "speakerName": "Sly Voice From Above",
            "text": "Once those new rounds have been distributed amongst us, we'll be able to capture whichever Saurians we like. We'll strike it rich sooner or later!",
            "nextDialogs": [
              "751070704"
            ]
          },
          "751070704": {
            "id": "751070704",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hear that? Those guys seem to wanna resell Saurian companions... Those low-down, no-good poachers!",
            "nextDialogs": [
              "751070705"
            ]
          },
          "751070705": {
            "id": "751070705",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751070706"
            ]
          },
          "751070706": {
            "id": "751070706",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Wow, {REALNAME[ID(2)|SHOWHOST(true)]}, you sounded a little different just then! Looks like those guys have really riled you up, huh?",
            "nextDialogs": [
              "751070707"
            ]
          },
          "751070707": {
            "id": "751070707",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrr...",
            "nextDialogs": [
              "751070708"
            ]
          },
          "751070708": {
            "id": "751070708",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Speaking of that, {REALNAME[ID(2)|SHOWHOST(true)]} — do you think you could sneak up to their camp from below and check out what's going on?",
            "nextDialogs": [
              "751070709"
            ]
          },
          "751070709": {
            "id": "751070709",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "If you find anything important of theirs in the camp, destroy it — let's create some chaos!",
            "nextDialogs": [
              "751070710"
            ]
          },
          "751070710": {
            "id": "751070710",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But if things aren't looking too good, just get out of there and leave things up to us. Always focus on your safety first!",
            "nextDialogs": [
              "751070711"
            ]
          },
          "751070711": {
            "id": "751070711",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Hrrmm!"
          }
        }
      }
    },
    {
      "subId": "7510712",
      "subQuestName": "Wait for your Saurian companion to act",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071201"
        ],
        "dialogs": {
          "751071201": {
            "id": "751071201",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Phew! Not only did we destroy their base... We also figured out what's going on! Let's get back to King Coconut first.",
            "nextDialogs": [
              "751071202"
            ]
          },
          "751071202": {
            "id": "751071202",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And then we can explain everything that happened to Qax."
          }
        }
      }
    },

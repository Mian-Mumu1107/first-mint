    {
      "subId": "7510709",
      "subQuestName": "Return to the camp where King Coconut is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070901"
        ],
        "dialogs": {
          "751070901": {
            "id": "751070901",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "What do we do...",
            "nextDialogs": [
              "751070902"
            ]
          },
          "751070902": {
            "id": "751070902",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "My friend, please, just say something. Even the slightest peep would be fine — I just need to know what's happened to you.",
            "nextDialogs": [
              "751070903"
            ]
          },
          "751070903": {
            "id": "751070903",
            "speakerId": 1001,
            "speakerName": "Debilitated Tepetlisaurus",
            "text": "...Grr?",
            "nextDialogs": [
              "751070904"
            ]
          },
          "751070904": {
            "id": "751070904",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "...Nope, don't get you at all.",
            "nextDialogs": [
              "751070905"
            ]
          },
          "751070905": {
            "id": "751070905",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Even if it were {REALNAME[ID(2)|SHOWHOST(true)]}, such a simple noise wouldn't be enough to get anything across to us right away.",
            "nextDialogs": [
              "751070906"
            ]
          },
          "751070906": {
            "id": "751070906",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Errh?",
            "nextDialogs": [
              "751070909"
            ]
          },
          "751070909": {
            "id": "751070909",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "#Ah, it's master {NICKNAME} and master Paimon. Saved at last!",
            "nextDialogs": [
              "751070910"
            ]
          },
          "751070910": {
            "id": "751070910",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "It's a pleasure to meet the pair of you! Here's the situation, in a nutshell...",
            "nextDialogs": [
              "751070911"
            ]
          },
          "751070911": {
            "id": "751070911",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "I'm Qax, a traveling merchant. I was out fetching water today when I got separated from my Saurian companion, King Coconut.",
            "nextDialogs": [
              "751070912"
            ]
          },
          "751070912": {
            "id": "751070912",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "When I got back, my dear Saurian had been hurt somehow, and had fallen down on the side of the road, unable to walk...",
            "nextDialogs": [
              "751070913"
            ]
          },
          "751070913": {
            "id": "751070913",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "I thought maybe he'd set off a hunter's trap, but closer inspection didn't reveal any wounds on his leg or blood spatter on his body... Could he have sprained his ankle or something?",
            "nextDialogs": [
              "751070914"
            ]
          },
          "751070914": {
            "id": "751070914",
            "speakerId": 1005,
            "speakerName": "\"King Coconut\"",
            "text": "Rroooh! Hroo! Rrooooh!",
            "nextDialogs": [
              "751070915"
            ]
          },
          "751070915": {
            "id": "751070915",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751070916"
            ]
          },
          "751070916": {
            "id": "751070916",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Seems like your Saurian buddy's in great pain. Neither {NICKNAME} nor Paimon's a sauro-vet, though..."
          }
        }
      }
    },
    {
      "subId": "7510710",
      "subQuestName": "Return to the camp where King Coconut is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071001"
        ],
        "dialogs": {
          "751071001": {
            "id": "751071001",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Welcome back!",
            "nextDialogs": [
              "751071002"
            ]
          },
          "751071002": {
            "id": "751071002",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "I guess you're going to collect some cooking ingredients and get breakfast ready.",
            "nextDialogs": [
              "751071005"
            ]
          },
          "751071005": {
            "id": "751071005",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Did you bring the vet by already? That was super quick!",
            "nextDialogs": [
              "751071006"
            ]
          },
          "751071006": {
            "id": "751071006",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Ehrrr?",
            "nextDialogs": [
              "751071007"
            ]
          },
          "751071007": {
            "id": "751071007",
            "speakerId": 1005,
            "speakerName": "\"King Coconut\"",
            "text": "Hrroo, mrroo!",
            "nextDialogs": [
              "751071008"
            ]
          },
          "751071008": {
            "id": "751071008",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Looks as though King Coconut's made good progress — he's even able to stand up already. Nice!",
            "nextDialogs": [
              "751071009"
            ]
          },
          "751071009": {
            "id": "751071009",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Still, where's that vet?",
            "nextDialogs": [
              "751071010"
            ]
          },
          "751071010": {
            "id": "751071010",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "I didn't see any of you when I brought him here, so I took him to treat King Coconut first.",
            "nextDialogs": [
              "751071011"
            ]
          },
          "751071011": {
            "id": "751071011",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "He assessed that King Coconut was hit by a rock flying at high speed and suffered internal bruising... I can't put two and two together, though. There weren't any loose rocks around the spot where King Coconut collapsed.",
            "nextDialogs": [
              "751071012"
            ]
          },
          "751071012": {
            "id": "751071012",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Luckily, the vet is experienced in dealing with this kind of injury, so he had a special medicine ready to treat King Coconut's internal bruising and greatly relieve the pain...",
            "nextDialogs": [
              "751071013"
            ]
          },
          "751071013": {
            "id": "751071013",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Now that King Coconut can walk slowly, we can take him to the vet for more comprehensive treatment.",
            "nextDialogs": [
              "751071014"
            ]
          },
          "751071014": {
            "id": "751071014",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "We found another Qucusaurus near the camp bearing similar injuries — a lost Saurian companion from the Flower-Feather Clan, apparently.",
            "nextDialogs": [
              "751071015"
            ]
          },
          "751071015": {
            "id": "751071015",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "After treating it, the vet took it back to the tribe.",
            "nextDialogs": [
              "751071016"
            ]
          },
          "751071016": {
            "id": "751071016",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "A \"rock flying at high speed\"... Would that be those frangible rounds that the Saurian poachers were talking about?",
            "nextDialogs": [
              "751071017"
            ]
          },
          "751071017": {
            "id": "751071017",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ugh, Paimon's getting peeved now...",
            "nextDialogs": [
              "751071018"
            ]
          },
          "751071018": {
            "id": "751071018",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "You and Paimon tell Qax the whole story...\\n",
            "nextDialogs": [
              "751071019"
            ]
          },
          "751071019": {
            "id": "751071019",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "So, King Coconut was ambushed by those criminals, leading to those internal injuries... Good thing I came back early, or the consequences would've been too dreadful to contemplate!",
            "nextDialogs": [
              "751071020"
            ]
          },
          "751071020": {
            "id": "751071020",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Those scum! I've a mind to give them a punch or two...",
            "nextDialogs": [
              "751071021"
            ]
          },
          "751071021": {
            "id": "751071021",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "No, that's too few. Let them pay it off in installments: Two thousand punches for every victim who had their Saurian companion kidnapped!",
            "nextDialogs": [
              "751071022"
            ]
          },
          "751071022": {
            "id": "751071022",
            "speakerId": 1005,
            "speakerName": "\"King Coconut\"",
            "text": "Awrrrh!",
            "nextDialogs": [
              "751071023"
            ]
          },
          "751071023": {
            "id": "751071023",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm, that's true! Had we known, we would've tied a few of them up and brought them over to you and King Coconut. Might do you some good to give them a thorough drubbing and let off a little steam.",
            "nextDialogs": [
              "751071024"
            ]
          },
          "751071024": {
            "id": "751071024",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Anyway, let's put venting to one side for now...",
            "nextDialogs": [
              "751071025"
            ]
          },
          "751071025": {
            "id": "751071025",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "So the two of you wiped out this criminal syndicate in the time it takes to make breakfast? That's beyond incredible!"
          }
        }
      }
    },
    {
      "subId": "7510702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

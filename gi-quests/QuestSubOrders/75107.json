        "dialogs": {
          "751070201": {
            "id": "751070201",
            "speakerId": 1010,
            "speakerName": "Weakened Qucusaur",
            "text": "Bad guys... In the hills... Threw stones... It hurt...",
            "nextDialogs": [
              "751070202"
            ]
          },
          "751070202": {
            "id": "751070202",
            "speakerId": 1010,
            "speakerName": "Weakened Qucusaur",
            "text": "I... ran...",
            "nextDialogs": [
              "751070203"
            ]
          },
          "751070203": {
            "id": "751070203",
            "speakerId": 1005,
            "speakerName": "\"King Coconut\"",
            "text": "Many... Bad guys... Beat me... Secretly...",
            "nextDialogs": [
              "751070204"
            ]
          },
          "751070204": {
            "id": "751070204",
            "speakerId": 1005,
            "speakerName": "\"King Coconut\"",
            "text": "Qax came back... And they left..."
          }
        }
      }
    },

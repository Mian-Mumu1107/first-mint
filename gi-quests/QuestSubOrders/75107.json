  "subQuests": [
    {
      "subId": "7510701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070101"
        ],
        "dialogs": {
          "751070101": {
            "id": "751070101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "What do we do...",
            "nextDialogs": [
              "751070102"
            ]
          },
          "751070102": {
            "id": "751070102",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "My friend, please, just say something. Even a growl would be fine — I just need to know what's happened to you.",
            "nextDialogs": [
              "751070103"
            ]
          },
          "751070103": {
            "id": "751070103",
            "speakerId": 1001,
            "speakerName": "Debilitated Tepetlisaurus",
            "text": "...Hrrooh?",
            "nextDialogs": [
              "751070104"
            ]
          },
          "751070104": {
            "id": "751070104",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "...Nope, don't get you at all.",
            "nextDialogs": [
              "751070105"
            ]
          },
          "751070105": {
            "id": "751070105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Even if it were {REALNAME[ID(2)|SHOWHOST(true)]}, such a simple statement alone wouldn't be enough to get anything across to us right away.",
            "nextDialogs": [
              "751070106"
            ]
          },
          "751070106": {
            "id": "751070106",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Ehrrr?",
            "nextDialogs": [
              "751070109"
            ]
          },
          "751070109": {
            "id": "751070109",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Ah, passing adventurers. We're saved!",
            "nextDialogs": [
              "751070110"
            ]
          },
          "751070110": {
            "id": "751070110",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Thank you so much, kind souls! Here's the situation in a nutshell...",
            "nextDialogs": [
              "751070111"
            ]
          },
          "751070111": {
            "id": "751070111",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "I'm Qax, a traveling merchant. I was out fetching water today when I got separated from my Saurian, King Coconut.",
            "nextDialogs": [
              "751070112"
            ]
          },
          "751070112": {
            "id": "751070112",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "When I got back, my dear Saurian had been hurt somehow, and had fallen down on the side of the road, unable to walk...",
            "nextDialogs": [
              "751070113"
            ]
          },
          "751070113": {
            "id": "751070113",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "I thought maybe he'd set off a hunter's trap, but closer inspection didn't reveal any wounds on his leg or blood spatter on his body... Could it have been blunt trauma?",
            "nextDialogs": [
              "751070114"
            ]
          },
          "751070114": {
            "id": "751070114",
            "speakerId": 1005,
            "speakerName": "\"King Coconut\"",
            "text": "Rroooh! Hroo! Rrooooh!",
            "nextDialogs": [
              "751070115"
            ]
          },
          "751070115": {
            "id": "751070115",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751070116"
            ]
          },
          "751070116": {
            "id": "751070116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Seems like your Saurian buddy's in great pain. Neither {NICKNAME} nor Paimon's a sauro-vet, though..."
          }
        }
      }
    },
    {
      "subId": "7510715",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071501"
        ],
        "dialogs": {
          "751071501": {
            "id": "751071501",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What's up? Any idea what's going on?",
            "nextDialogs": [
              "751071504"
            ]
          },
          "751071504": {
            "id": "751071504",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh? Attacked by bad guys? From the hill over there?",
            "nextDialogs": [
              "751071505"
            ]
          },
          "751071505": {
            "id": "751071505",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, do you still remember? We've been around here before... We rescued tons of Saurians and other animals from some poachers.",
            "nextDialogs": [
              "751071506"
            ]
          },
          "751071506": {
            "id": "751071506",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Could it be the same people? And they're trying to steal Saurian companions... Are they seriously looking to resell them?",
            "nextDialogs": [
              "751071507"
            ]
          },
          "751071507": {
            "id": "751071507",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Never mind that... Anyone hiding behind the scenes and harming the Saurian companions of others is pure scum. We can't just let them go!"
          }
        }
      }
    },
    {
      "subId": "7510717",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071701"
        ],
        "dialogs": {
          "751071701": {
            "id": "751071701",
            "speakerId": 1006,
            "speakerName": "Sinister Voice From Above",
            "text": "#Gah, what crappy luck! Last time, it was that blonde {M#boy}{F#girl} and the white-haired fairy who cost me a big paycheck, releasing all the animals I had on me like that. And just now, that Qucusaurus escaped yet again...",
            "nextDialogs": [
              "751071702"
            ]
          },
          "751071702": {
            "id": "751071702",
            "speakerId": 1007,
            "speakerName": "Sly Voice From Above",
            "text": "*sigh* If nothing else, we've got the boss and his enhanced frangible rounds. They're guaranteed to knock even the strongest Tatankasaurus out without leaving a trace!",
            "nextDialogs": [
              "751071703"
            ]
          },
          "751071703": {
            "id": "751071703",
            "speakerId": 1007,
            "speakerName": "Sly Voice From Above",
            "text": "Once the boss's new rounds are mass-produced, we'll put this one to bed in no time...",
            "nextDialogs": [
              "751071704"
            ]
          },
          "751071704": {
            "id": "751071704",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hear that? It really is those nasty Saurian poachers and animal traffickers from back then. C'mon, let's round 'em all up this time!",
            "nextDialogs": [
              "751071705"
            ]
          },
          "751071705": {
            "id": "751071705",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751071706"
            ]
          },
          "751071706": {
            "id": "751071706",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Wow {REALNAME[ID(2)|SHOWHOST(true)]}, you sounded a little different just then! Don't worry, we'll get justice for your Blubberbeast friend this time!",
            "nextDialogs": [
              "751071707"
            ]
          },
          "751071707": {
            "id": "751071707",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrr...",
            "nextDialogs": [
              "751071708"
            ]
          },
          "751071708": {
            "id": "751071708",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Speaking of that, {REALNAME[ID(2)|SHOWHOST(true)]} — do you think you could sneak up to their camp from below and check out what's going on?",
            "nextDialogs": [
              "751071709"
            ]
          },
          "751071709": {
            "id": "751071709",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "If you find anything important of theirs in the camp, destroy it — let's create some chaos!",
            "nextDialogs": [
              "751071710"
            ]
          },
          "751071710": {
            "id": "751071710",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But if things aren't looking too good, just get out of there and leave things up to us. Always focus on your safety first!",
            "nextDialogs": [
              "751071711"
            ]
          },
          "751071711": {
            "id": "751071711",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Hrrmm!"
          }
        }
      }
    },
    {
      "subId": "7510703",
      "subQuestName": "Gather materials to build the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070301"
        ],
        "dialogs": {
          "751070301": {
            "id": "751070301",
            "speakerId": 1008,
            "speakerName": "Qax's Gear",
            "text": "(Rucksacks and boxes packed with various daily necessities. Looks like Qax is running a small business. Place the materials you've gathered here. You can start building a camp in a moment.)"
          }
        }
      }
    },
    {
      "subId": "7510719",
      "subQuestName": "Gather materials to build the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070501"
        ],
        "dialogs": {
          "751070501": {
            "id": "751070501",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Great — now we can put up a huge camp tent!"
          }
        }
      }
    },
    {
      "subId": "7510704",
      "subQuestName": "Talk to Qax",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751070801"
        ],
        "dialogs": {
          "751070801": {
            "id": "751070801",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "Qax returns after a while, carrying a few logs. He pulls out a pot and some fabric from his bag.\\nPaimon has picked up a bunch of branches and is using them to make a fire to cook with...",
            "nextDialogs": [
              "751070802"
            ]
          },
          "751070802": {
            "id": "751070802",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "#Qax is very dexterous and, with your help, has soon built a hut. Paimon and {REALNAME[ID(2)|SHOWHOST(true)]} set up a pot, and ignite some kindling...",
            "nextDialogs": [
              "751070803"
            ]
          },
          "751070803": {
            "id": "751070803",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Alright, that's our camp done and dusted. Thanks for all your hard work!",
            "nextDialogs": [
              "751070804"
            ]
          },
          "751070804": {
            "id": "751070804",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "It's pretty basic, so not the best accommodation. But please make do for now. I'll repay you all later for sure!",
            "nextDialogs": [
              "751070807"
            ]
          },
          "751070807": {
            "id": "751070807",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Then I shan't ramble on. I'll get going and find a vet as soon as possible.",
            "nextDialogs": [
              "751070808"
            ]
          },
          "751070808": {
            "id": "751070808",
            "speakerId": 1004,
            "speakerName": "Qax",
            "text": "Both so King Coconut can recover faster, but also so as not to keep you waiting!",
            "nextDialogs": [
              "751070809"
            ]
          },
          "751070809": {
            "id": "751070809",
            "speakerId": 1005,
            "speakerName": "\"King Coconut\"",
            "text": "*whimper*",
            "nextDialogs": [
              "751070810"
            ]
          },
          "751070810": {
            "id": "751070810",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "This traveling merchant's quite the straight shooter, and practical, too... Let's hope he can find a vet soon.",
            "nextDialogs": [
              "751070811"
            ]
          },
          "751070811": {
            "id": "751070811",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Next up, time for us to get camping, cooking, and eating together!",
            "nextDialogs": [
              "751070812"
            ]
          },
          "751070812": {
            "id": "751070812",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751070813"
            ]
          },
          "751070813": {
            "id": "751070813",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "#You prepare food by the fire with Paimon, and cook up several of your specialty dishes — including a sick meal that's easy on the stomach, made especially for King Coconut.\\nAfterwards, everyone enjoys a casual, filling meal together. Paimon and {REALNAME[ID(2)|SHOWHOST(true)]} feed the debilitated King Coconut.",
            "nextDialogs": [
              "751070814"
            ]
          },
          "751070814": {
            "id": "751070814",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "#After the meal, {REALNAME[ID(2)|SHOWHOST(true)]} patiently stays with King Coconut, helping him relax, and his condition improves. \\nYou chat with Paimon until midnight, and everyone in the camp falls into a peaceful slumber...",
            "nextDialogs": [
              "751070815"
            ]
          },
          "751070815": {
            "id": "751070815",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Mmm~ Paimon slept so well! Guess it was all that hard work yesterday, huh?",
            "nextDialogs": [
              "751070816"
            ]
          },
          "751070816": {
            "id": "751070816",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm?",
            "nextDialogs": [
              "751070817"
            ]
          },
          "751070817": {
            "id": "751070817",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Uh-oh, {NICKNAME} — King Coconut's turned into a Qucusaurus!"
          }
        }
      }
    },
    {
      "subId": "7510711",
      "subQuestName": "Find a way to communicate with King Coconut and the other Saurian",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751071101"
        ],
        "dialogs": {
          "751071101": {
            "id": "751071101",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What's up? Any idea what's going on?",
            "nextDialogs": [
              "751071104"
            ]
          },
          "751071104": {
            "id": "751071104",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh? Attacked by bad guys? From the hill over there?",
            "nextDialogs": [
              "751071105"
            ]
          },
          "751071105": {
            "id": "751071105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Were those bad guys just trying to hunt wild Saurians? But if it was an accident, we didn't see 'em apologizing to Qax or King Coconut...",
            "nextDialogs": [
              "751071106"
            ]
          },
          "751071106": {
            "id": "751071106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Or... are they poachers, waiting to steal other people's Saurian buddies instead?",
            "nextDialogs": [
              "751071107"
            ]
          },
          "751071107": {
            "id": "751071107",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Never mind that... Anyone hiding behind the scenes and harming the Saurian companions of others is pure scum. We can't just let them go!"
          }
        }
      }
    },
    {
      "subId": "7510706",

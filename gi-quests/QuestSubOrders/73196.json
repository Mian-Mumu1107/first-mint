            "id": "731960101",
            "speakerId": 1000,
            "speakerName": "Kalimi Exchange Bulletin Board",
            "text": "This is the Bulletin Board of the Kalimi Exchange for dealers from home and abroad to post business information. Irrelevant posts are prohibited."
          }
        }
      }
    },
    {
      "subId": "7319602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960201"
        ],
        "dialogs": {
          "731960201": {
            "id": "731960201",
            "speakerId": 1001,
            "speakerName": "Exchange Disclaimer",
            "text": "This exchange makes every effort to ensure the accuracy and reliability of all provided information, but does not guarantee its accuracy and integrity in any form.",
            "nextDialogs": [
              "731960202"
            ]
          },
          "731960202": {
            "id": "731960202",
            "speakerId": 1001,
            "speakerName": "Exchange Disclaimer",
            "text": "All clients may not claim for losses arising from the usage of market information published on this Bulletin Board, whether in whole or in part."
          }
        }
      }
    },
    {
      "subId": "7319603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960301"
        ],
        "dialogs": {
          "731960301": {
            "id": "731960301",
            "speakerId": 1002,
            "speakerName": "Fontaine Flyers Advertisement",
            "text": "Have you heard of levitation? Have you seen someone flying? Would you like to discover the secrets of the flying Sumpter Beast? Then don't miss out on the Fontaine Flyers' first performance in Sumeru!",
            "nextDialogs": [
              "731960302"
            ]
          },
          "731960302": {
            "id": "731960302",
            "speakerId": 1002,
            "speakerName": "Fontaine Flyers Advertisement",
            "text": "Welcome, show's on! Don't miss out on this unique art show. Only five Mora for a ticket!",
            "nextDialogs": [
              "731960303"
            ]
          },
          "731960303": {
            "id": "731960303",
            "speakerId": 1003,
            "speakerName": "Mahamata Announcement",
            "text": "Due to reports from the public, we have found that this performance has not been approved by the Akademiya. We have revoked their permission to perform and this ad will be taken down immediately."
          }
        }
      }
    },
    {
      "subId": "7319604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960401"
        ],
        "dialogs": {
          "731960401": {
            "id": "731960401",
            "speakerId": 1004,
            "speakerName": "Northland Bank Notice",
            "text": "Our bank is about to open an office in Sumeru! Please look forward to it, our esteemed future customers!",
            "nextDialogs": [
              "731960402"
            ]
          },
          "731960402": {
            "id": "731960402",
            "speakerId": 1004,
            "speakerName": "Northland Bank Notice",
            "text": "If you have any business to take care of, please contact Viktor to have it done in our Liyue branch!",
            "nextDialogs": [
              "731960403"
            ]
          },
          "731960403": {
            "id": "731960403",
            "speakerId": 1004,
            "speakerName": "Northland Bank Notice",
            "text": "If you're thinking about taking out a loan, come consult our agent today!"
          }
        }
      }
    },
    {
      "subId": "7319605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960501"
        ],
        "dialogs": {
          "731960501": {
            "id": "731960501",
            "speakerId": 1005,
            "speakerName": "Sulaykha Carpets Advertisement",
            "text": "Hand-knitted carpets, a masterpiece of Sumeru art!",
            "nextDialogs": [
              "731960502"
            ]
          },
          "731960502": {
            "id": "731960502",
            "speakerId": 1005,
            "speakerName": "Sulaykha Carpets Advertisement",
            "text": "Every resident of Sumeru should have one such carpet in their life!",
            "nextDialogs": [
              "731960503"
            ]
          },
          "731960503": {
            "id": "731960503",
            "speakerId": 1005,
            "speakerName": "Sulaykha Carpets Advertisement",
            "text": "Carpets may be priced, but art is priceless!"
          }
        }
      }
    },
    {
      "subId": "7319606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960601"
        ],
        "dialogs": {
          "731960601": {
            "id": "731960601",
            "speakerId": 1006,
            "speakerName": "Jut's Spices Advertisement",
            "text": "Excellent quality and affordable prices. Jut's Spices is the one for you.",
            "nextDialogs": [
              "731960602"
            ]
          },
          "731960602": {
            "id": "731960602",
            "speakerId": 1006,
            "speakerName": "Jut's Spices Advertisement",
            "text": "Buy now and get a free gift!"
          }
        }
      }
    },
    {
      "subId": "7319607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960701"
        ],
        "dialogs": {
          "731960701": {
            "id": "731960701",
            "speakerId": 1007,
            "speakerName": "Bakhra Grocery Advertisement",
            "text": "We sell a vast assortment of daily necessities. All of our items have been personally inspected by the owner. Quality guaranteed!",
            "nextDialogs": [
              "731960702"
            ]
          },
          "731960702": {
            "id": "731960702",
            "speakerId": 1008,
            "speakerName": "Message",
            "text": "\"Dad, can you lend me a little more Mora? I heard the price of Ajilenakh Nuts will be skyrocketing soon. I'm certain I'll make a bundle this time.\""
          }
        }
      }
    },
    {
      "subId": "7319608",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960801"
        ],
        "dialogs": {
          "731960801": {
            "id": "731960801",
            "speakerId": 1009,
            "speakerName": "Menakeri's Advertisement",
            "text": "We seek to purchase \"Kazeni's Lost Golden Statues.\" The price is negotiable. Please contact our shop owner.",
            "nextDialogs": [
              "731960802"
            ]
          },
          "731960802": {
            "id": "731960802",
            "speakerId": 1009,
            "speakerName": "Menakeri's Advertisement",
            "text": "If you have information on them, please visit Menakeri's and contact Khalid. You'll be rewarded for your troubles!"
          }
        }
      }
    },
    {
      "subId": "7319609",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731960901"
        ],
        "dialogs": {
          "731960901": {
            "id": "731960901",
            "speakerId": 1010,
            "speakerName": "Barbecue Stall Advertisement",
            "text": "Authentic desert barbeque! Using King Deshret's secret sauce and roasted with locally produced Spice!",
            "nextDialogs": [
              "731960902"
            ]
          },
          "731960902": {
            "id": "731960902",
            "speakerId": 1010,
            "speakerName": "Barbecue Stall Advertisement",
            "text": "Great food and great drinks that everyone can enjoy!"
          }
        }
      }
    },
    {
      "subId": "7319610",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961001"
        ],
        "dialogs": {
          "731961001": {
            "id": "731961001",
            "speakerId": 1011,
            "speakerName": "Housein Vegetables",
            "text": "\"I once possessed endless wealth, but splurging could not calm my heart.\"",
            "nextDialogs": [
              "731961002"
            ]
          },
          "731961002": {
            "id": "731961002",
            "speakerId": 1011,
            "speakerName": "Housein Vegetables",
            "text": "\"After this trip, not one Mora is left in my pocket, yet I feel at peace.\"",
            "nextDialogs": [
              "731961003"
            ]
          },
          "731961003": {
            "id": "731961003",
            "speakerId": 1011,
            "speakerName": "Housein Vegetables",
            "text": "\"If you would like to hear my story, then come to my vegetable shop. Of course, it's best if you buy some vegetables while you're here.\""
          }
        }
      }
    },
    {
      "subId": "7319611",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961101"
        ],
        "dialogs": {
          "731961101": {
            "id": "731961101",
            "speakerId": 1012,
            "speakerName": "Ani's Dyes Advertisement",
            "text": "Ani's Dyes provides the most professional way to add exquisite new colors to your clothing.",
            "nextDialogs": [
              "731961102"
            ]
          },
          "731961102": {
            "id": "731961102",
            "speakerId": 1008,
            "speakerName": "Message",
            "text": "\"When can I collect the clothes I sent here last month?\"",
            "nextDialogs": [
              "731961103"
            ]
          },
          "731961103": {
            "id": "731961103",
            "speakerId": 1013,
            "speakerName": "Reply",
            "text": "\"Our sincere apologies! My wife gave birth to our baby yesterday, so I didn't have time to work. Please return tomorrow. I'll make sure to have them ready by then.\"",
            "nextDialogs": [
              "731961104"
            ]
          },
          "731961104": {
            "id": "731961104",
            "speakerId": 1008,
            "speakerName": "Message",
            "text": "\"It's been three months. Just return my clothes. I don't want them dyed anymore.\"",
            "nextDialogs": [
              "731961105"
            ]
          },
          "731961105": {
            "id": "731961105",
            "speakerId": 1013,
            "speakerName": "Reply",
            "text": "\"Sorry! Your clothes were stolen by a thief while being dried after the dyeing process. Please hunt down the thief if you want them back.\""
          }
        }
      }
    },
    {
      "subId": "7319612",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961201"
        ],
        "dialogs": {
          "731961201": {
            "id": "731961201",
            "speakerId": 1014,
            "speakerName": "Farzaneh Shipping Company Advertisement",
            "text": "We specialize in overseas trade services, and we have long-term cooperation with powerful fleets like the Crux Fleet to escort your goods safely.",
            "nextDialogs": [
              "731961202"
            ]
          },
          "731961202": {
            "id": "731961202",
            "speakerId": 1014,
            "speakerName": "Farzaneh Shipping Company Advertisement",
            "text": "We've opened four new routes this summer for commodities such as silk, spices, and ores. Our new ships have large cargo capacities, and we sincerely welcome you to work with us.",
            "nextDialogs": [
              "731961203"
            ]
          },
          "731961203": {
            "id": "731961203",
            "speakerId": 1014,
            "speakerName": "Farzaneh Shipping Company Advertisement",
            "text": "If you would like to book the entire route, please speak to Farzaneh."
          }
        }
      }
    },
    {
      "subId": "7319613",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961301"
        ],
        "dialogs": {
          "731961301": {
            "id": "731961301",
            "speakerId": 1015,
            "speakerName": "Exchange Decision Announcement",
            "text": "Due to consumer complaints, Ani's Dyes has been closed down on suspicion of clothing theft.",
            "nextDialogs": [
              "731961302"
            ]
          },
          "731961302": {
            "id": "731961302",
            "speakerId": 1015,
            "speakerName": "Exchange Decision Announcement",
            "text": "Ain's Dyes has been found to be completely cleared out. We're working on retrieving the stolen property of the complainants."
          }
        }
      }
    },
    {
      "subId": "7319614",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961401"
        ],
        "dialogs": {
          "731961401": {
            "id": "731961401",
            "speakerId": 1015,
            "speakerName": "Exchange Decision Announcement",
            "text": "About the ownership of Puspa Café.",
            "nextDialogs": [
              "731961402"
            ]
          },
          "731961402": {
            "id": "731961402",
            "speakerId": 1015,
            "speakerName": "Exchange Decision Announcement",
            "text": "The original owner has been determined to have gone missing during a desert expedition three years ago. In accordance with regulations, management of the café should be passed to Vahumana.",
            "nextDialogs": [
              "731961403"
            ]
          },
          "731961403": {
            "id": "731961403",
            "speakerId": 1015,
            "speakerName": "Exchange Decision Announcement",
            "text": "Decision: Due to the withdrawal of the complaint by the claimant, the case has been suspended indefinitely."
          }
        }
      }
    },
    {
      "subId": "7319615",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961501"
        ],
        "dialogs": {
          "731961501": {
            "id": "731961501",
            "speakerId": 1016,
            "speakerName": "Grand Bazaar Travel Guide",
            "text": "\"Speaking of the Grand Bazaar, you absolutely can't miss Zubayr Theater.\"",
            "nextDialogs": [
              "731961502"
            ]
          },
          "731961502": {
            "id": "731961502",
            "speakerId": 1016,
            "speakerName": "Grand Bazaar Travel Guide",
            "text": "\"The performance that you should definitely see there is Nilou's dance!\"",
            "nextDialogs": [
              "731961503"
            ]
          },
          "731961503": {
            "id": "731961503",
            "speakerId": 1016,
            "speakerName": "Grand Bazaar Travel Guide",
            "text": "\"If you miss Nilou's Dance of Sabzeruz on your trip to Sumeru, then you've wasted the entire trip!\""
          }
        }
      }
    },
    {
      "subId": "7319616",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961601"
        ],
        "dialogs": {
          "731961601": {
            "id": "731961601",
            "speakerId": 1017,
            "speakerName": "Adventurers' Guilt Advertisement",
            "text": "Pursue happiness in life! Set sail from home to explore the world! Join the Adventurers' Guilt now! Membership for the first month only costs five Mora!",
            "nextDialogs": [
              "731961602"
            ]
          },
          "731961602": {
            "id": "731961602",
            "speakerId": 1017,
            "speakerName": "Adventurers' Guilt Advertisement",
            "text": "True knowledge can only be obtained from real practice. Losing your life in an arduous traverse is much more meaningful than lazing all your time away!",
            "nextDialogs": [
              "731961603"
            ]
          },
          "731961603": {
            "id": "731961603",
            "speakerId": 1008,
            "speakerName": "Message",
            "text": "\"Look closer! This is from the Adventurers' Guilt, not Adventurers' Guild.\"",
            "nextDialogs": [
              "731961604"
            ]
          },
          "731961604": {
            "id": "731961604",
            "speakerId": 1018,
            "speakerName": "Another Person's Message",
            "text": "\"What!? I paid for a year's membership! Can I get my money back?\""
          }
        }
      }
    },
    {
      "subId": "7319617",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731961701"
        ],
        "dialogs": {
          "731961701": {
            "id": "731961701",
            "speakerId": 1019,
            "speakerName": "Someone's Advertisement",
            "text": "\"Everyone's heard of Lord Sangemah Bay, so there's no need for introductions.\"",
            "nextDialogs": [
              "731961702"
            ]
          },
          "731961702": {
            "id": "731961702",
            "speakerId": 1019,
            "speakerName": "Someone's Advertisement",
            "text": "\"Anyway, a new batch of carpets has arrived. They can't fly, but they're better than Sulaykha's! Act now if you want one! You know the drill. Hehe!\"",
            "nextDialogs": [
              "731961703"
            ]
          },
          "731961703": {
            "id": "731961703",
            "speakerId": 1008,
            "speakerName": "Message",
            "text": "\"Dori, you are outrageous!\""
          }
        }
      }
    }
  ]
}
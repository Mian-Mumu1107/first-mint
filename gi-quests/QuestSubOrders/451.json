    {
      "subId": "45103",
      "subQuestName": "Defeat the slimes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510301"
        ],
        "dialogs": {
          "4510301": {
            "id": "4510301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*panting* Th—Thank you— Aaah! Wolves! Ruuuun!",
            "nextDialogs": [
              "4510303"
            ]
          },
          "4510303": {
            "id": "4510303",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Do not worry. Wolves friends. But, you are...?",
            "nextDialogs": [
              "4510304"
            ]
          },
          "4510304": {
            "id": "4510304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're just some boring old travelers passing through...",
            "nextDialogs": [
              "4510305"
            ]
          },
          "4510305": {
            "id": "4510305",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Don't smell boring. You smell... *sniff* familiar...",
            "nextDialogs": [
              "4510306"
            ]
          },
          "4510306": {
            "id": "4510306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...We smell?",
            "nextDialogs": [
              "4510307"
            ]
          },
          "4510307": {
            "id": "4510307",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You smell like Knights of Favonius. They are friends.",
            "nextDialogs": [
              "4510310",
              "4510313"
            ]
          },
          "4510310": {
            "id": "4510310",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I am Razor.",
            "nextDialogs": [
              "4510311"
            ]
          },
          "4510311": {
            "id": "4510311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you one of the Knights of Favonius too?",
            "nextDialogs": [
              "4510312"
            ]
          },
          "4510312": {
            "id": "4510312",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I am not.",
            "nextDialogs": [
              "4510314"
            ]
          },
          "4510314": {
            "id": "4510314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh?",
            "nextDialogs": [
              "4510315"
            ]
          },
          "4510315": {
            "id": "4510315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's with the wolf pack?",
            "nextDialogs": [
              "4510316"
            ]
          },
          "4510316": {
            "id": "4510316",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "My wolf pack... they are my family.",
            "nextDialogs": [
              "4510317"
            ]
          },
          "4510317": {
            "id": "4510317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Your family!?",
            "nextDialogs": [
              "4510318"
            ]
          },
          "4510318": {
            "id": "4510318",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Yes. They raised me. We live together. We are family.",
            "nextDialogs": [
              "4510319"
            ]
          },
          "4510319": {
            "id": "4510319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So many questions...",
            "nextDialogs": [
              "4510320"
            ]
          },
          "4510320": {
            "id": "4510320",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "They are angry with me. I help you, exposed our ambush, boar ran away.",
            "nextDialogs": [
              "4510321"
            ]
          },
          "4510321": {
            "id": "4510321",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh, ah... don't worry, Paimon will get {NICKNAME} to catch you another boar.",
            "nextDialogs": [
              "4510322"
            ]
          },
          "4510322": {
            "id": "4510322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME} is stronger than {M#he}{F#she} looks.",
            "nextDialogs": [
              "4510323"
            ]
          },
          "4510323": {
            "id": "4510323",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "N—No need. When knights try to help, wolves go hungry...",
            "nextDialogs": [
              "4510324"
            ]
          },
          "4510324": {
            "id": "4510324",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't be silly! Wait here — we won't screw this up, just watch!"
          },
          "4510313": {
            "id": "4510313",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I am Razor. I am no knight."
          }
        }
      }
    },

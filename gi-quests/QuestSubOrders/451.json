    {
      "subId": "45105",
      "subQuestName": "Collect enough Raw Meat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510501"
        ],
        "dialogs": {
          "4510501": {
            "id": "4510501",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "...You really want to help?",
            "nextDialogs": [
              "4510502"
            ]
          },
          "4510502": {
            "id": "4510502",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Wolves hunt on instinct. Works every time. But... setting trap sounds fun.",
            "nextDialogs": [
              "4510503"
            ]
          },
          "4510503": {
            "id": "4510503",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "First, we set trap. Next, chase boar in — yes?",
            "nextDialogs": [
              "4510504"
            ]
          },
          "4510504": {
            "id": "4510504",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Hope it won't explode..."
          }
        }
      }
    },
    {
      "subId": "45108",
      "subQuestName": "Hunting Tip",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510801"
        ],
        "dialogs": {
          "4510801": {
            "id": "4510801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ho-ho! Time to show us what you're made of!"
          }
        }
      }
    },
    {
      "subId": "45106",
      "subQuestName": "Give three chunks of Raw Meat to Razor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510601"
        ],
        "dialogs": {
          "4510601": {
            "id": "4510601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haha! Told you we could do it!",
            "nextDialogs": [
              "4510602"
            ]
          },
          "4510602": {
            "id": "4510602",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I— thanks, but...",
            "nextDialogs": [
              "4510603"
            ]
          },
          "4510603": {
            "id": "4510603",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "...Wolves catch five or six every hunt... *sigh* Tonight, they go hungry...",
            "nextDialogs": [
              "4510604"
            ]
          },
          "4510604": {
            "id": "4510604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh-oh...",
            "nextDialogs": [
              "4510605"
            ]
          },
          "4510605": {
            "id": "4510605",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Don't worry. You tried.",
            "nextDialogs": [
              "4510606"
            ]
          },
          "4510606": {
            "id": "4510606",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "At least you did better than other knight friend... the red one, burny girl.",
            "nextDialogs": [
              "4510607"
            ]
          },
          "4510607": {
            "id": "4510607",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "If she was here, whole mountain is fire. Can't catch even one boar.",
            "nextDialogs": [
              "4510608"
            ]
          },
          "4510608": {
            "id": "4510608",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I must go now.",
            "nextDialogs": [
              "4510609"
            ]
          },
          "4510609": {
            "id": "4510609",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Here is not safe. Careful. Always watching.",
            "nextDialogs": [
              "4510610"
            ]
          },
          "4510610": {
            "id": "4510610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a weirdo...",
            "nextDialogs": [
              "4510611"
            ]
          },
          "4510611": {
            "id": "4510611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Burny girl\"? From the Knights of Favonius? What is he—",
            "nextDialogs": [
              "4510612"
            ]
          },
          "4510612": {
            "id": "4510612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, who do you think it is?"
          }
        }
      }
    }

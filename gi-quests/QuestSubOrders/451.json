    {
      "subId": "45101",
      "subQuestName": "Go to Wolvendom",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4510101"
        ],
        "dialogs": {
          "4510101": {
            "id": "4510101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is Wolvendom. People from Mondstadt hardly ever come here...",
            "nextDialogs": [
              "4510102"
            ]
          },
          "4510102": {
            "id": "4510102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Even though it's not so far away from the city, the environment here is totally untouched. It's a wild place ruled by the laws of nature.",
            "nextDialogs": [
              "4510103"
            ]
          },
          "4510103": {
            "id": "4510103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's survival of the fittest out here. Even the slimes around here are huuuge!",
            "nextDialogs": [
              "4510104"
            ]
          },
          "4510104": {
            "id": "4510104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Like those super-duper massive ones over there!",
            "nextDialogs": [
              "4510105"
            ]
          },
          "4510105": {
            "id": "4510105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Eek, they've seen us! Prepare for battle!"
          }
        }
      }
    },

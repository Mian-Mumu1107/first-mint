    {
      "subId": "2000306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030601"
        ],
        "dialogs": {
          "200030601": {
            "id": "200030601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Knights of Favonius Library, I'd say.",
            "nextDialogs": [
              "200030602"
            ]
          },
          "200030602": {
            "id": "200030602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The library... Ooh, that's right! The library's a pretty big place. Maybe she's looking for research materials in there!",
            "nextDialogs": [
              "200030603"
            ]
          },
          "200030603": {
            "id": "200030603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, time to get moving!"
          }
        }
      }
    },
    {
      "subId": "2000307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030701"
        ],
        "dialogs": {
          "200030701": {
            "id": "200030701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Good Hunter. I hear there's salad to be had there.",
            "nextDialogs": [
              "200030702"
            ]
          },
          "200030702": {
            "id": "200030702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Good Hunter... Hmm... Right, maybe she's gone there for some salad. Let's go have a look.",
            "nextDialogs": [
              "200030703"
            ]
          },
          "200030703": {
            "id": "200030703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that's assuming she has enough Mora on hand to buy salad..."
          }
        }
      }
    },
    {
      "subId": "2000308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030801"
        ],
        "dialogs": {
          "200030801": {
            "id": "200030801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's just go to Katheryne directly.",
            "nextDialogs": [
              "200030802"
            ]
          },
          "200030802": {
            "id": "200030802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Katheryne, huh? That's a good pick for sure — she knows basically everything, after all!",
            "nextDialogs": [
              "200030803"
            ]
          },
          "200030803": {
            "id": "200030803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, let's get going!"
          }
        }
      }
    },
    {
      "subId": "2000305",
      "subQuestName": "Pay Mona a visit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2000309",
      "subQuestName": "Look for Mona in the library",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030901"
        ],
        "dialogs": {
          "200030901": {
            "id": "200030901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, no sign of Mona. Lisa isn't in, either.",
            "nextDialogs": [
              "200030902"
            ]
          },
          "200030902": {
            "id": "200030902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's go ask that Knight at the door. Maybe he's seen Mona."
          }
        }
      }
    },
    {
      "subId": "2000310",
      "subQuestName": "Ask Wyratt about Mona's whereabouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031001"
        ],
        "dialogs": {
          "200031001": {
            "id": "200031001",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "Hello. How may I assist?",
            "nextDialogs": [
              "200031002"
            ]
          },
          "200031002": {
            "id": "200031002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, have you seen a girl who looks something like this...",
            "nextDialogs": [
              "200031003"
            ]
          },
          "200031003": {
            "id": "200031003",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You describe Mona's distinguishing features to Wyratt...",
            "nextDialogs": [
              "200031004"
            ]
          },
          "200031004": {
            "id": "200031004",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "Oh! I know who you're talking about. It's the girl with the really big hat!",
            "nextDialogs": [
              "200031005"
            ]
          },
          "200031005": {
            "id": "200031005",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "She often comes by to consult some of the texts we keep here. She spends the whole day reading, so she's quite the memorable patron.",
            "nextDialogs": [
              "200031006"
            ]
          },
          "200031006": {
            "id": "200031006",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "That said, she hasn't swung by recently. I doubt you'll find her hereabouts...",
            "nextDialogs": [
              "200031007"
            ]
          },
          "200031007": {
            "id": "200031007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems we're a little late.",
            "nextDialogs": [
              "200031008"
            ]
          },
          "200031008": {
            "id": "200031008",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "If she does come by, I'll make sure to tell her that you're looking for her.",
            "nextDialogs": [
              "200031009"
            ]
          },
          "200031009": {
            "id": "200031009",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "That's all I can do for you in this case, unfortunately...",
            "nextDialogs": [
              "200031010"
            ]
          },
          "200031010": {
            "id": "200031010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No problem. Thank you.",
            "nextDialogs": [
              "200031011"
            ]
          },
          "200031011": {
            "id": "200031011",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "Think nothing of it.",
            "nextDialogs": [
              "200031012"
            ]
          },
          "200031012": {
            "id": "200031012",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, looks like Mona's not in the library. Guess we've got to tell Goth that we couldn't find her..."
          }
        }
      }
    },
    {
      "subId": "2000311",
      "subQuestName": "Go to Good Hunter to look for Mona",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031101"
        ],
        "dialogs": {
          "200031101": {
            "id": "200031101",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Hi there! Would you like to order anything?",
            "nextDialogs": [
              "200031102"
            ]
          },
          "200031102": {
            "id": "200031102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, have you seen a girl who looks something like this...",
            "nextDialogs": [
              "200031103"
            ]
          },
          "200031103": {
            "id": "200031103",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You describe Mona's distinguishing features to Sara...",
            "nextDialogs": [
              "200031104"
            ]
          },
          "200031104": {
            "id": "200031104",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Oh, you mean Mona, don't you? At one time, she came by every evening to grab some salad — she sometimes even asked me for an extra egg or two.",
            "nextDialogs": [
              "200031105"
            ]
          },
          "200031105": {
            "id": "200031105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Guess she's as short of Mora as ever, huh...",
            "nextDialogs": [
              "200031106"
            ]
          },
          "200031106": {
            "id": "200031106",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "She hasn't come once in the past few days, though.",
            "nextDialogs": [
              "200031107"
            ]
          },
          "200031107": {
            "id": "200031107",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "If you're in a hurry to find her, I can pass a message on to her for you the next time she comes by to get salad.",
            "nextDialogs": [
              "200031108"
            ]
          },
          "200031108": {
            "id": "200031108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks.",
            "nextDialogs": [
              "200031109"
            ]
          },
          "200031109": {
            "id": "200031109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like Mona hasn't been to Good Hunter. Ugh, guess we've got to go tell Goth that we couldn't find her today..."
          }
        }
      }
    },
    {
      "subId": "2000312",
      "subQuestName": "Ask Katheryne about Mona's whereabouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031201"
        ],
        "dialogs": {
          "200031201": {
            "id": "200031201",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "Hello, how may I help you?",
            "nextDialogs": [
              "200031202"
            ]
          },
          "200031202": {
            "id": "200031202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen Mona recently?",
            "nextDialogs": [
              "200031203"
            ]
          },
          "200031203": {
            "id": "200031203",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "Mona? Hmm... No, I can't say I have...",
            "nextDialogs": [
              "200031204"
            ]
          },
          "200031204": {
            "id": "200031204",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "If you're in a hurry to find her, why not post a commission here at the Guild?",
            "nextDialogs": [
              "200031205"
            ]
          },
          "200031205": {
            "id": "200031205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks, but we'll look for her ourselves.",
            "nextDialogs": [
              "200031206"
            ]
          },
          "200031206": {
            "id": "200031206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm. Katheryne's got no clue where Mona is. Guess it's back to Goth to tell him that we couldn't find her today..."
          }
        }
      }
    },
    {
      "subId": "2000313",
      "subQuestName": "Report back to Goth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031301"
        ],
        "dialogs": {
          "200031301": {
            "id": "200031301",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "How did it go? Were you able to find that Ast... Well, your friend?",
            "nextDialogs": [
              "200031302"
            ]
          },
          "200031302": {
            "id": "200031302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She doesn't seem to be home today.",
            "nextDialogs": [
              "200031303"
            ]
          },
          "200031303": {
            "id": "200031303",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "Well, alright that. She doesn't really owe that much rent. We can put it off for a few days.",
            "nextDialogs": [
              "200031304"
            ]
          },
          "200031304": {
            "id": "200031304",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "Ah, yes. Please take these for your help in the meantime."
          }
        }
      }
    },
    {
      "subId": "2000304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030401"
        ],
        "dialogs": {
          "200030401": {
            "id": "200030401",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "As... Astro... Hmm, what was her name again?"
          }
        }
      }
    },
    {
      "subId": "2000305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030501"
        ],
        "dialogs": {
          "200030501": {
            "id": "200030501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mona, are you home?",
            "nextDialogs": [
              "200030502"
            ]
          },
          "200030502": {
            "id": "200030502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mona, it's rent time!",
            "nextDialogs": [
              "200030503"
            ]
          },
          "200030503": {
            "id": "200030503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Mona really doesn't seem to be home...",
            "nextDialogs": [
              "200030504"
            ]
          },
          "200030504": {
            "id": "200030504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's weird. Isn't she cooped up in that house most of the time? Is she out on some business?",
            "nextDialogs": [
              "200030505"
            ]
          },
          "200030505": {
            "id": "200030505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Or maybe she's unable to come to the door, faint from hunger as she is?",
            "nextDialogs": [
              "200030508"
            ]
          },
          "200030508": {
            "id": "200030508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Is that so?",
            "nextDialogs": [
              "200030509"
            ]
          },
          "200030509": {
            "id": "200030509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But where should we go to find Mona..."
          }
        }
      }
    }
  ]
}
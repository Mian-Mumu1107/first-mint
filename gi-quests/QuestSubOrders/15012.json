    {
      "subId": "1501212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150121201"
        ],
        "dialogs": {
          "150121201": {
            "id": "150121201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So... She crafts Ancient Names?",
            "nextDialogs": [
              "150121202"
            ]
          },
          "150121202": {
            "id": "150121202",
            "speakerId": 1002,
            "speakerName": "Cheven",
            "text": "That's right... Or, well, she used to. Now, she just handles regular forging commissions."
          }
        }
      }
    },
    {
      "subId": "1501213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150121301"
        ],
        "dialogs": {
          "150121301": {
            "id": "150121301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Xilonen's in that line of business too.",
            "nextDialogs": [
              "150121302"
            ]
          },
          "150121302": {
            "id": "150121302",
            "speakerId": 1002,
            "speakerName": "Cheven",
            "text": "Oh, you know Xilonen? Haha, try mentioning that name in front of Tlazolli. She could sing Xilonen's praises forever.",
            "nextDialogs": [
              "150121303"
            ]
          },
          "150121303": {
            "id": "150121303",
            "speakerId": 1002,
            "speakerName": "Cheven",
            "text": "\"The foremost expert in Ancient Names\" \"the future of our tribe,\" \"the finest artisan in Natlan\"... You'll never hear the end of it.",
            "nextDialogs": [
              "150121304"
            ]
          },
          "150121304": {
            "id": "150121304",
            "speakerId": 1002,
            "speakerName": "Cheven",
            "text": "I know Tlazolli misses the days when she used to forge Ancient Names. She'd never say as much... but I can tell."
          }
        }
      }
    },

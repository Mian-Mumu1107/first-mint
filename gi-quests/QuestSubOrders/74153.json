  "subQuests": [
    {
      "subId": "7415309",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530901"
        ],
        "dialogs": {
          "741530901": {
            "id": "741530901",
            "speakerId": 1000,
            "speakerName": "Door",
            "text": "(We've already decided to investigate any strange goings-on regarding the Leroy family, knocking on the door would only alert them to what we're doing.)",
            "nextDialogs": [
              "741530902"
            ]
          },
          "741530902": {
            "id": "741530902",
            "speakerId": 1000,
            "speakerName": "Door",
            "text": "(Let's knock again once we have a better understanding of the situation.)"
          }
        }
      }
    },
    {
      "subId": "7415301",
      "subQuestName": "Go near Benoit's house to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530101"
        ],
        "dialogs": {
          "741530101": {
            "id": "741530101",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "Hello? Anyone there? Do you still want your newspaper? Hey! Anybody there?",
            "nextDialogs": [
              "741530102"
            ]
          },
          "741530102": {
            "id": "741530102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello there.",
            "nextDialogs": [
              "741530103"
            ]
          },
          "741530103": {
            "id": "741530103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is Benoit not at home?",
            "nextDialogs": [
              "741530104"
            ]
          },
          "741530104": {
            "id": "741530104",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "How should I know? Either way, it's right weird, subscribing to a paper and not collecting it.",
            "nextDialogs": [
              "741530105"
            ]
          },
          "741530105": {
            "id": "741530105",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "Whenever I delivered here, he would always at least reply, but recently, I haven't seen hide nor hair of him at all.",
            "nextDialogs": [
              "741530106"
            ]
          },
          "741530106": {
            "id": "741530106",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "The copies of The Steambird I've left here are already piling up. You know him, do you?",
            "nextDialogs": [
              "741530107"
            ]
          },
          "741530107": {
            "id": "741530107",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yup, that's right. We're good friends of his.",
            "nextDialogs": [
              "741530108"
            ]
          },
          "741530108": {
            "id": "741530108",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "Good friends? ...Eh, whatever. How about I give you the papers, and you pass them along when you see him?",
            "nextDialogs": [
              "741530111"
            ]
          },
          "741530111": {
            "id": "741530111",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "That's that, then. I did my best to deliver them. Don't you turn around and say I didn't! I've got other things to do.",
            "nextDialogs": [
              "741530112"
            ]
          },
          "741530112": {
            "id": "741530112",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That said, we haven't seen him recently either...",
            "nextDialogs": [
              "741530113"
            ]
          },
          "741530113": {
            "id": "741530113",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "You too? Seriously, what's he been busy with recently? Could he have gone back to his old home? I haven't heard anything about that, though...",
            "nextDialogs": [
              "741530114"
            ]
          },
          "741530114": {
            "id": "741530114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Old home?",
            "nextDialogs": [
              "741530115"
            ]
          },
          "741530115": {
            "id": "741530115",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "That's right. His old place over in the Fleuve Cendre.",
            "nextDialogs": [
              "741530116"
            ]
          },
          "741530116": {
            "id": "741530116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait, so that's where he used to live!?",
            "nextDialogs": [
              "741530117"
            ]
          },
          "741530117": {
            "id": "741530117",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "Wait. You didn't know that he moved here from down there? Are you really his friends?",
            "nextDialogs": [
              "741530118"
            ]
          },
          "741530118": {
            "id": "741530118",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh... We...",
            "nextDialogs": [
              "741530119"
            ]
          },
          "741530119": {
            "id": "741530119",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "Whatever, forget it. No need to explain. I don't care a whit what your relationship is.",
            "nextDialogs": [
              "741530120"
            ]
          },
          "741530120": {
            "id": "741530120",
            "speakerId": 1001,
            "speakerName": "Pip",
            "text": "Just get the newspapers to him, and I'll be grateful. Okay, here you go — I'm off.",
            "nextDialogs": [
              "741530121"
            ]
          },
          "741530121": {
            "id": "741530121",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm. It feels like there's a lot we don't understand about Benoit. Do you think this might have something to do with what we're investigating?"
          }
        }
      }
    },
    {
      "subId": "7415302",
      "subQuestName": "Investigate near Benoit's house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7415303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530301"
        ],
        "dialogs": {
          "741530301": {
            "id": "741530301",
            "speakerId": 1003,
            "speakerName": "Strange Boxes",
            "text": "(You've seen these boxes near Benoit's house before. Judging by the traces left in the layer of dust covering them, they were opened quite recently.)",
            "nextDialogs": [
              "741530302"
            ]
          },
          "741530302": {
            "id": "741530302",
            "speakerId": 1003,
            "speakerName": "Strange Boxes",
            "text": "(Up close, a rank smell of fish and dampness assaults your nostrils, but when you passed by before, the boxes hadn't been moved. Where did the smell come from?)",
            "nextDialogs": [
              "741530303"
            ]
          },
          "741530303": {
            "id": "741530303",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Urgh, this stinks like a sewer... This stuff didn't smell like this when we came around a few days back. Didn't Benoit say he only used these to store old furniture and stuff?",
            "nextDialogs": [
              "741530304"
            ]
          },
          "741530304": {
            "id": "741530304",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Where'd this horrible stench come from, then? Did some new stuff get dumped here? ...Hmm, there's a piece of paper sticking out. Let's take a look!",
            "nextDialogs": [
              "741530305"
            ]
          },
          "741530305": {
            "id": "741530305",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "This receipt's been torn up — only half of it is left. Huh, Bracari's General Store... We've seen that name somewhere, haven't we?"
          }
        }
      }
    },
    {
      "subId": "7415304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530401"
        ],
        "dialogs": {
          "741530401": {
            "id": "741530401",
            "speakerId": 1004,
            "speakerName": "Strange Traces",
            "text": "(It has a slick, oily sensation that you're sure had to have been left by a candle.)",
            "nextDialogs": [
              "741530402"
            ]
          },
          "741530402": {
            "id": "741530402",
            "speakerId": 1004,
            "speakerName": "Strange Traces",
            "text": "(Who lingered here with a candle in hand, and for what purpose?)"
          }
        }
      }
    },
    {
      "subId": "7415312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741531201"
        ],
        "dialogs": {
          "741531201": {
            "id": "741531201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What can you tell me about this receipt...",
            "nextDialogs": [
              "741531202"
            ]
          },
          "741531202": {
            "id": "741531202",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "A recent sale of pliers, saws, and candles? Well now, that's a strange question...",
            "nextDialogs": [
              "741531203"
            ]
          },
          "741531203": {
            "id": "741531203",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "If you want ingredients for snacks, I've got them aplenty, but these things are difficult to move, darling, I haven't got many in stock.",
            "nextDialogs": [
              "741531204"
            ]
          },
          "741531204": {
            "id": "741531204",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We don't want to buy this stuff, Ma'am. We're just asking if someone else came to purchase them from you recently.",
            "nextDialogs": [
              "741531205"
            ]
          },
          "741531205": {
            "id": "741531205",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "Ooh, let me think, then... Yes, yes, I remember some people indeed.",
            "nextDialogs": [
              "741531206"
            ]
          },
          "741531206": {
            "id": "741531206",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "It was two youngsters, a man and a woman. They bought the items several days ago.",
            "nextDialogs": [
              "741531207"
            ]
          },
          "741531207": {
            "id": "741531207",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "They said that they wanted to do some woodwork at home, but needed some tools. Is something the matter?",
            "nextDialogs": [
              "741531208"
            ]
          },
          "741531208": {
            "id": "741531208",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, no, no, w—we're just doing a... socioeconomic survey.",
            "nextDialogs": [
              "741531209"
            ]
          },
          "741531209": {
            "id": "741531209",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "A socioeconomic survey, you say? Hehe, you're here looking for information on them, aren't you?",
            "nextDialogs": [
              "741531210"
            ]
          },
          "741531210": {
            "id": "741531210",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "This happens all too often, little one. No need to try so hard to make excuses.",
            "nextDialogs": [
              "741531211"
            ]
          },
          "741531211": {
            "id": "741531211",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "The two of them went to Benoit Leroy's old house, if that's what you're asking.",
            "nextDialogs": [
              "741531212"
            ]
          },
          "741531212": {
            "id": "741531212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could you tell me anything about Benoit?",
            "nextDialogs": [
              "741531213"
            ]
          },
          "741531213": {
            "id": "741531213",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "Ah, so that's what you're here for. Well, that's no surprise.",
            "nextDialogs": [
              "741531214"
            ]
          },
          "741531214": {
            "id": "741531214",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "Once you've reached a certain age, your past will catch up to you — it matters not where you move to.",
            "nextDialogs": [
              "741531215"
            ]
          },
          "741531215": {
            "id": "741531215",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Do you know anything about all this, Ma'am?",
            "nextDialogs": [
              "741531216"
            ]
          },
          "741531216": {
            "id": "741531216",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "Me? Well, I wasn't very close to Benoit. If you'd like to know about his family, you should look for Snodgrass.",
            "nextDialogs": [
              "741531217"
            ]
          },
          "741531217": {
            "id": "741531217",
            "speakerId": 1005,
            "speakerName": "Bracari",
            "text": "Go on, then. Snodgrass is a right layabout. You should be able to find him loitering about nearby."
          }
        }
      }
    },
    {
      "subId": "7415310",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741531001"
        ],
        "dialogs": {
          "741531001": {
            "id": "741531001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could you tell me about Benoit Leroy?",
            "nextDialogs": [
              "741531002"
            ]
          },
          "741531002": {
            "id": "741531002",
            "speakerId": 1006,
            "speakerName": "Areta",
            "text": "Well, I've certainly heard the name, but he moved away a long time ago, and even before that, we rarely spoke.",
            "nextDialogs": [
              "741531003"
            ]
          },
          "741531003": {
            "id": "741531003",
            "speakerId": 1006,
            "speakerName": "Areta",
            "text": "I'm none too familiar with him, so it might be best if you asked someone else."
          }
        }
      }
    },
    {
      "subId": "7415305",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530501"
        ],
        "dialogs": {
          "741530501": {
            "id": "741530501",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That box looks completely out of place, and it stinks...",
            "nextDialogs": [
              "741530502"
            ]
          },
          "741530502": {
            "id": "741530502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I suspect it was brought here from the Fleuve Cendre.",
            "nextDialogs": [
              "741530503"
            ]
          },
          "741530503": {
            "id": "741530503",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Meaning that someone from Benoit's family went there recently... And he was from there himself, wasn't he...",
            "nextDialogs": [
              "741530504"
            ]
          },
          "741530504": {
            "id": "741530504",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#All the clues we've got have to do with that place, {NICKNAME}. We'll probably get more useful information there.",
            "nextDialogs": [
              "741530505"
            ]
          },
          "741530505": {
            "id": "741530505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go, then.",
            "nextDialogs": [
              "741530506"
            ]
          },
          "741530506": {
            "id": "741530506",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Off to the Fleuve Cendre!"
          }
        }
      }
    },
    {
      "subId": "7415306",
      "subQuestName": "Go to the Fleuve Cendre",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7415311",
      "subQuestName": "Look for the fish stall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741531101"
        ],
        "dialogs": {
          "741531101": {
            "id": "741531101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What can you tell me about Benoit Leroy?",
            "nextDialogs": [
              "741531102"
            ]
          },
          "741531102": {
            "id": "741531102",
            "speakerId": 1007,
            "speakerName": "Faustier",
            "text": "The name's one I've heard, but I can't say I know him."
          }
        }
      }
    },
    {
      "subId": "7415307",
      "subQuestName": "Ask around",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530701"
        ],
        "dialogs": {
          "741530701": {
            "id": "741530701",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Ugh, so boring... I don't wanna work... When am I gonna get rich...",
            "nextDialogs": [
              "741530702"
            ]
          },
          "741530702": {
            "id": "741530702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about Benoit Leroy...",
            "nextDialogs": [
              "741530703"
            ]
          },
          "741530703": {
            "id": "741530703",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "...Leroy? Huh. I've heard that name before. Give me a moment...",
            "nextDialogs": [
              "741530704"
            ]
          },
          "741530704": {
            "id": "741530704",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Right, I got it. Benoit Leroy owned a stall that sold all kinda stuff.",
            "nextDialogs": [
              "741530705"
            ]
          },
          "741530705": {
            "id": "741530705",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Also, who are you? And why're you asking after this kinda stuff?",
            "nextDialogs": [
              "741530706"
            ]
          },
          "741530706": {
            "id": "741530706",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Actually, we just...",
            "nextDialogs": [
              "741530709"
            ]
          },
          "741530709": {
            "id": "741530709",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Uh... wait, um, has he done something wrong?",
            "nextDialogs": [
              "741530710"
            ]
          },
          "741530710": {
            "id": "741530710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "741530711"
            ]
          },
          "741530711": {
            "id": "741530711",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Oh, right, I getcha now... But, um, I gotta ask real quick, you guys from the Spina di Rosula, or the Maison Gardiennage?",
            "nextDialogs": [
              "741530712"
            ]
          },
          "741530712": {
            "id": "741530712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You have the right to remain silent...",
            "nextDialogs": [
              "741530713"
            ]
          },
          "741530713": {
            "id": "741530713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Anything you say can and will be used against you in a court of law...",
            "nextDialogs": [
              "741530714"
            ]
          },
          "741530714": {
            "id": "741530714",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#(Wow, you're really good at this, {NICKNAME}!)",
            "nextDialogs": [
              "741530715"
            ]
          },
          "741530715": {
            "id": "741530715",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Alright, alright! I get it. I won't ask no more questions. Well, not like he made an honest fortune or nothing, innit? Fontaine's got a lotta laws, he's probably broken quite a few!",
            "nextDialogs": [
              "741530716"
            ]
          },
          "741530716": {
            "id": "741530716",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Anyway, Officer, you've come to the right fella. Lemme tell you, I know all about Benoit, nobody knows him better — there's not much that scoundrel Benoit wouldn't stoop to.",
            "nextDialogs": [
              "741530717"
            ]
          },
          "741530717": {
            "id": "741530717",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Hmm. I'm old enough to get married, so he should be an old fogey by now, huh?",
            "nextDialogs": [
              "741530718"
            ]
          },
          "741530718": {
            "id": "741530718",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Anyway, I remember that his daughter, Autumn, was a real beauty — shame he never let any of us talk to her!",
            "nextDialogs": [
              "741530719"
            ]
          },
          "741530719": {
            "id": "741530719",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Autumn?",
            "nextDialogs": [
              "741530720"
            ]
          },
          "741530720": {
            "id": "741530720",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "That's right, Autumn Leroy, his adopted daughter.",
            "nextDialogs": [
              "741530721"
            ]
          },
          "741530721": {
            "id": "741530721",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Just think about it. He was just a fella selling flotsam and jetsam, making a little Mora here and there — how'd he suddenly get rich enough to move up to the surface so fast, huh?",
            "nextDialogs": [
              "741530722"
            ]
          },
          "741530722": {
            "id": "741530722",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "How else but by using his daughter, of course! Poor, pretty little thing — forced her to marry some rich old coot, he did!",
            "nextDialogs": [
              "741530723"
            ]
          },
          "741530723": {
            "id": "741530723",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "And whaddaya know, that rich old fart kicked the bucket after just a few years, leaving his house to her. And what's hers is Benoit's — all in all, a pretty quick way to win a life \"up there,\" if you catch my drift.",
            "nextDialogs": [
              "741530724"
            ]
          },
          "741530724": {
            "id": "741530724",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "Tsk tsk, why did he get to be the one to get rich overnight— I mean, what an ol' bloodsucker, am I right?",
            "nextDialogs": [
              "741530725"
            ]
          },
          "741530725": {
            "id": "741530725",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "(Wait, did something like that actually happen!?)",
            "nextDialogs": [
              "741530726"
            ]
          },
          "741530726": {
            "id": "741530726",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Let's press him further.)",
            "nextDialogs": [
              "741530727"
            ]
          },
          "741530727": {
            "id": "741530727",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "So, Officer, was that what you wanted to ask about?",
            "nextDialogs": [
              "741530728"
            ]
          },
          "741530728": {
            "id": "741530728",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "I mean, if this stuff's useful to you, you could say that I've contributed to Fontaine's security, yeah?",
            "nextDialogs": [
              "741530729"
            ]
          },
          "741530729": {
            "id": "741530729",
            "speakerId": 1008,
            "speakerName": "Snodgrass",
            "text": "And wouldn't you say that the Maison might wanna reward a... productive, upstanding citizen such as myself?"
          }
        }
      }
    },
    {
      "subId": "7415308",
      "subQuestName": "Leave the Fleuve Cendre",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530801"
        ],
        "dialogs": {
          "741530801": {
            "id": "741530801",
            "speakerId": 1009,
            "speakerName": "Athos",
            "text": "The Fleuve Cendre area just doesn't smell nice. It's not quite like \"upstairs,\" where the air's the furthest thing from foul.",
            "nextDialogs": [
              "741530802"
            ]
          },
          "741530802": {
            "id": "741530802",
            "speakerId": 1009,
            "speakerName": "Athos",
            "text": "How was it? Did you have fun strolling about the Fleuve Cendre? I'm sure you had a good time talking to Snodgrass.",
            "nextDialogs": [
              "741530803"
            ]
          },
          "741530803": {
            "id": "741530803",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Y—You were following us?",
            "nextDialogs": [
              "741530804"
            ]
          },
          "741530804": {
            "id": "741530804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How long have you been tailing us?",
            "nextDialogs": [
              "741530805"
            ]
          },
          "741530805": {
            "id": "741530805",
            "speakerId": 1009,
            "speakerName": "Athos",
            "text": "I have no interest in bandying words with children. *sigh* Even if you were to go home and tattle to your parents, I doubt they'd believe you.",
            "nextDialogs": [
              "741530806"
            ]
          },
          "741530806": {
            "id": "741530806",
            "speakerId": 1009,
            "speakerName": "Athos",
            "text": "A word of advice — sometimes, what you see or hear is neither real nor true.",
            "nextDialogs": [
              "741530807"
            ]
          },
          "741530807": {
            "id": "741530807",
            "speakerId": 1009,
            "speakerName": "Athos",
            "text": "When it comes to other people's affairs, don't insist on meddling until after you've got the full picture.",
            "nextDialogs": [
              "741530808"
            ]
          },
          "741530808": {
            "id": "741530808",
            "speakerId": 1009,
            "speakerName": "Athos",
            "text": "By the way, Pip said that our newspapers are in your possession. I'd like you to return them, thank you.",
            "nextDialogs": [
              "741530809"
            ]
          },
          "741530809": {
            "id": "741530809",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "You have little choice but to give the newspapers to Athos.",
            "nextDialogs": [
              "741530810"
            ]
          },
          "741530810": {
            "id": "741530810",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "He gives you a cold look before swiftly turning and departing.",
            "nextDialogs": [
              "741530811"
            ]
          },
          "741530811": {
            "id": "741530811",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's got a bad feeling about that guy...",
            "nextDialogs": [
              "741530814"
            ]
          },
          "741530814": {
            "id": "741530814",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ugh, this is so annoying! It feels like we've discovered something, but we can't put the pieces together.",
            "nextDialogs": [
              "741530815"
            ]
          },
          "741530815": {
            "id": "741530815",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And... and Paimon's kinda confused now. Benoit's a good person who's in danger, so we should be helping him... That's what's going on, right?"
          }
        }
      }
    },
    {
      "subId": "7415104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741510401"
        ],
        "dialogs": {
          "741510401": {
            "id": "741510401",
            "speakerId": 1000,
            "speakerName": "Door",
            "text": "You hear nothing within the house. No one speaks, and you hear no footsteps either.",
            "nextDialogs": [
              "741510402"
            ]
          },
          "741510402": {
            "id": "741510402",
            "speakerId": 1000,
            "speakerName": "Door",
            "text": "It's a bit strange how silent Benoit's household is. Almost as if the place is empty."
          }
        }
      }
    },
    {
      "subId": "7415399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741539901"
        ],
        "dialogs": {
          "741539901": {
            "id": "741539901",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "All we know is that Benoit Leroy used to live in the Fleuve Cendre, but we don't have a clue exactly where...",
            "nextDialogs": [
              "741539902"
            ]
          },
          "741539902": {
            "id": "741539902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "If only we had some clues to help us narrow things down..."
          }
        }
      }
    }
  ]
}
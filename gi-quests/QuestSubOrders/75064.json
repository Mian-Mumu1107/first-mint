{
  "lineCounts": {
    "#{REALNAME[ID(2)|SHOWHOST(true)]}": 11,
    "Black Screen": 3,
    "Magnifico": 51,
    "Paimon": 33,
    "Player": 14
  },
  "subQuests": [
    {
      "subId": "7506404",
      "subQuestName": "Go to the location of Magnifico's photoshoot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750641501"
        ],
        "dialogs": {
          "750641501": {
            "id": "750641501",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Now I thought I heard people talking about me — but I never expected it to be you! Hah, what a coincidence!",
            "nextDialogs": [
              "750641502"
            ]
          },
          "750641502": {
            "id": "750641502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! Guess we forgot you have a hot-air balloon, huh? Not that you've ever brought us along on it, you stingy...!",
            "nextDialogs": [
              "750641503"
            ]
          },
          "750641503": {
            "id": "750641503",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawoo! Rawoo!",
            "nextDialogs": [
              "750641504"
            ]
          },
          "750641504": {
            "id": "750641504",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Well, you've never asked, have you?",
            "nextDialogs": [
              "750641505"
            ]
          },
          "750641505": {
            "id": "750641505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And why would we... Ugh, you never told us, so how would we know that asking was even an option!",
            "nextDialogs": [
              "750641507"
            ]
          },
          "750641507": {
            "id": "750641507",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "#A pleasure to meet you all again, {M#Mr.}{F#Ms.} {NICKNAME}, and dear little Paimon!",
            "nextDialogs": [
              "750641508"
            ]
          },
          "750641508": {
            "id": "750641508",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "See, I knew we'd meet again! Just in time, too — there's something I need your help with.",
            "nextDialogs": [
              "750641509"
            ]
          },
          "750641509": {
            "id": "750641509",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Here? Is it something tricky?",
            "nextDialogs": [
              "750641510"
            ]
          },
          "750641510": {
            "id": "750641510",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Not too much trouble, really. You'll find out in a jiffy!",
            "nextDialogs": [
              "750641511"
            ]
          },
          "750641511": {
            "id": "750641511",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Magnifico leaps nimbly from his hot-air balloon and retrieves his Film Kamera and tripod from his luggage, assembling them in an open space.\\nHe soon finishes his work and stands before you proudly.",
            "nextDialogs": [
              "750641506"
            ]
          },
          "750641506": {
            "id": "750641506",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Hehe, either way, do make way. I'm about to make landfall!"
          }
        }
      }
    },
    {
      "subId": "7506412",
      "subQuestName": "Go to the location of Magnifico's photoshoot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750640412"
        ],
        "dialogs": {
          "750640412": {
            "id": "750640412",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Ker-chak! Behold, a miracle of light and shadow — Fontaine's latest industrial achievement!",
            "nextDialogs": [
              "750640413"
            ]
          },
          "750640413": {
            "id": "750640413",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? That's nothing new to us. Also, you haven't told us what you need help with yet!",
            "nextDialogs": [
              "750640415",
              "750640417"
            ]
          },
          "750640415": {
            "id": "750640415",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "From the looks of it, you probably want us to help you take a photo, right?",
            "nextDialogs": [
              "750640418"
            ]
          },
          "750640418": {
            "id": "750640418",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Oh... Well, sure! Here's your deposit. Please take it.",
            "nextDialogs": [
              "750640419"
            ]
          },
          "750640419": {
            "id": "750640419",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait. This is a ton of Mora!",
            "nextDialogs": [
              "750640420"
            ]
          },
          "750640420": {
            "id": "750640420",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Wrraa!",
            "nextDialogs": [
              "750640421"
            ]
          },
          "750640421": {
            "id": "750640421",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "As you have seen, I need to take a few pictures of Saurians, and I'm not talking about one of those three-view drawings you see in animal illustration books either... What I'm going for is something full of vitality!",
            "nextDialogs": [
              "750640422"
            ]
          },
          "750640422": {
            "id": "750640422",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Y—Yeah, okay!",
            "nextDialogs": [
              "750640423"
            ]
          },
          "750640423": {
            "id": "750640423",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "But on the other hand... more vitality means \"less likely to listen to me.\" So, if it's convenient, could you dear adventurers please help me take the ideal pictures I need?",
            "nextDialogs": [
              "750640424"
            ]
          },
          "750640424": {
            "id": "750640424",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Y—Yeah, okay!",
            "nextDialogs": [
              "750640425"
            ]
          },
          "750640425": {
            "id": "750640425",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Of course, you don't have to force yourself to do things beyond your ability, but I suspect you could at least protect me from hostile life forms.",
            "nextDialogs": [
              "750640426"
            ]
          },
          "750640426": {
            "id": "750640426",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "So please, keep the deposit... and as for whether to help or not, I'll leave that decision to you!",
            "nextDialogs": [
              "750640427"
            ]
          },
          "750640427": {
            "id": "750640427",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa... All this money's making this bag super heavy... You sure it's all ours?",
            "nextDialogs": [
              "750640428"
            ]
          },
          "750640428": {
            "id": "750640428",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Come on, you think I'd deceive you? Or should I double-check the sum for you?",
            "nextDialogs": [
              "750640429"
            ]
          },
          "750640429": {
            "id": "750640429",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehehe... Hahaha! Well, looks like you've come to the right people, because Paimon is a renowned Saurian tamer here in Natlan!",
            "nextDialogs": [
              "750640430"
            ]
          },
          "750640430": {
            "id": "750640430",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Don'cha worry. So long as {NICKNAME} and Paimon are here, any Saurian you wish to tame will be tamed!",
            "nextDialogs": [
              "750640431"
            ]
          },
          "750640431": {
            "id": "750640431",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Tepetlisaurs? Easy-peasy? Qucusaurs? Cheddar-cheesy! Iktomisaurs? Lemon-squeezy... Uh, we also do Koholasaurs, Yumkasaurs, Tachankasaurs..."
          },
          "750640417": {
            "id": "750640417",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're super cool, so Mora up front."
          }
        }
      }
    },
    {
      "subId": "7506408",
      "subQuestName": "Talk to Magnifico once again",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750640801"
        ],
        "dialogs": {
          "750640801": {
            "id": "750640801",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "\"Louis, Louis!\" ...Ah! You scared me half to death there!",
            "nextDialogs": [
              "750640802"
            ]
          },
          "750640802": {
            "id": "750640802",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "So, have you changed your mind, or are you just here to say hello?",
            "nextDialogs": [
              "750640804",
              "750640807"
            ]
          },
          "750640804": {
            "id": "750640804",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Hoohroo~",
            "nextDialogs": [
              "750640805"
            ]
          },
          "750640805": {
            "id": "750640805",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Haha. That's wonderful, then. Let us get started!"
          },
          "750640807": {
            "id": "750640807",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Alright then, best of luck!"
          }
        }
      }
    },
    {
      "subId": "7506410",
      "subQuestName": "Listen to the photographer's request",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750641101"
        ],
        "dialogs": {
          "750641101": {
            "id": "750641101",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Hmm... Next up, an Iktomisaurus under the moonlight! Yes, that sounds good. Getting the ideal lighting is going to take some work, though.",
            "nextDialogs": [
              "750641102"
            ]
          },
          "750641102": {
            "id": "750641102",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "#Hmm... Aha! It's your time to shine, {REALNAME[ID(2)|SHOWHOST(true)]}, my little friend!",
            "nextDialogs": [
              "750641103"
            ]
          },
          "750641103": {
            "id": "750641103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Little? Pfft. He's nearly taller than you, Paimon'll have you know!",
            "nextDialogs": [
              "750641104"
            ]
          },
          "750641104": {
            "id": "750641104",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrwar? Roo?",
            "nextDialogs": [
              "750641105"
            ]
          },
          "750641105": {
            "id": "750641105",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Very good, very good... The timing's perfect... Haha! My masterpiece is almost complete...",
            "nextDialogs": [
              "750641106"
            ]
          },
          "750641106": {
            "id": "750641106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then make sure you get a good shot, just like the subject's one of your Fontainian girls! Hehe, that's how the line goes, right?",
            "nextDialogs": [
              "750641107"
            ]
          },
          "750641107": {
            "id": "750641107",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Hrooo, rroooh!",
            "nextDialogs": [
              "750641108"
            ]
          },
          "750641108": {
            "id": "750641108",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Haha, just relax!",
            "nextDialogs": [
              "750641109"
            ]
          },
          "750641109": {
            "id": "750641109",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "This angle! This moonlight Ah! Ah! Simply perfecto!",
            "nextDialogs": [
              "750641110"
            ]
          },
          "750641110": {
            "id": "750641110",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Just a moment, let me see... I'll need two more light sources. One needs to light up the Iktomisaurus's profile, so we get that contrast between warm light and the backdrop of night... That's how we'll create an air of mystery.",
            "nextDialogs": [
              "750641111"
            ]
          },
          "750641111": {
            "id": "750641111",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "And the other light source needs to illuminate the Saurian's silhouette. Not for any complicated reasons, but it is a necessity.",
            "nextDialogs": [
              "750641112"
            ]
          },
          "750641112": {
            "id": "750641112",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Yes, yes... That's what we're looking for! Just like a dream...",
            "nextDialogs": [
              "750641113"
            ]
          },
          "750641113": {
            "id": "750641113",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "What the... Drat!",
            "nextDialogs": [
              "750641114"
            ]
          },
          "750641114": {
            "id": "750641114",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "I'm sorry, but perhaps the atmospheric elemental concentration here differs from that in Fontaine. Something must've gone wrong with the machine... But no rush, everyone. Let me check.",
            "nextDialogs": [
              "750641115"
            ]
          },
          "750641115": {
            "id": "750641115",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "*humming* Hmm... Not here... Not here either...",
            "nextDialogs": [
              "750641116"
            ]
          },
          "750641116": {
            "id": "750641116",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Dammit, dammit, damn it all! Gah! You sickened blackguard, you cosseted, coddled nincompoop! Arrrgh!",
            "nextDialogs": [
              "750641117"
            ]
          },
          "750641117": {
            "id": "750641117",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "You... You...!",
            "nextDialogs": [
              "750641118"
            ]
          },
          "750641118": {
            "id": "750641118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, hey, calm down!",
            "nextDialogs": [
              "750641122",
              "750641121"
            ]
          },
          "750641122": {
            "id": "750641122",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Phew... Well... It's a goner now, isn't it?",
            "nextDialogs": [
              "750641123"
            ]
          },
          "750641123": {
            "id": "750641123",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "750641124"
            ]
          },
          "750641124": {
            "id": "750641124",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Heh. Don't look at me like that. If nothing else, I feel better now!",
            "nextDialogs": [
              "750641125"
            ]
          },
          "750641125": {
            "id": "750641125",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "*sigh* Well, it's as you see. Our artificial lighting is broken — and after all that Mora I spent on it, too. Disappointing. Just like my ex-wife...",
            "nextDialogs": [
              "750641126"
            ]
          },
          "750641126": {
            "id": "750641126",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright, just... stop for now. Chill out, and don't panic. We're here to help!",
            "nextDialogs": [
              "750641127"
            ]
          },
          "750641127": {
            "id": "750641127",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "*sigh* I'm sorry... Phew. Alright. What do I need? Ah, yes. I need to shine one light on the <color=#00E1FFFF>left side of the Iktomisaurus's face</color>, and the other on the <color=#00E1FFFF>contours of its back</color>.",
            "nextDialogs": [
              "750641128"
            ]
          },
          "750641128": {
            "id": "750641128",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No problem! Let's do this!",
            "nextDialogs": [
              "750641129"
            ]
          },
          "750641129": {
            "id": "750641129",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "And so, Magnifico begins tinkering with his Kamera once more, leaving you all to think about how to make a suitable light source..."
          },
          "750641121": {
            "id": "750641121",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What!?"
          }
        }
      }
    },
    {
      "subId": "7506405",
      "subQuestName": "Complete the lighting setup for the shoot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7506407",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750640701"
        ],
        "dialogs": {
          "750640701": {
            "id": "750640701",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Go work on the lighting. I don't require any help over here.",
            "nextDialogs": [
              "750640702"
            ]
          },
          "750640702": {
            "id": "750640702",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "<color=#00E1FFFF>Light up the left side of its face, as well as the outline of its back!</color>"
          }
        }
      }
    },
    {
      "subId": "7506406",
      "subQuestName": "Talk to Magnifico",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750640601"
        ],
        "dialogs": {
          "750640601": {
            "id": "750640601",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Haha, good, good! Come now, my little model, stay still... Yes, you're so very clever! Three, two, one, say cheese!",
            "nextDialogs": [
              "750640602"
            ]
          },
          "750640602": {
            "id": "750640602",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Ah, would you look at that? A masterpiece? And whose work is it? Yes, mine — Magnifico de la Magnificans!",
            "nextDialogs": [
              "750640603"
            ]
          },
          "750640603": {
            "id": "750640603",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Thank you, thank you so much! Haha! Now then, here's the balance I owe you! Ah... and this too. Look.",
            "nextDialogs": [
              "750640604"
            ]
          },
          "750640604": {
            "id": "750640604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, a final payment...",
            "nextDialogs": [
              "750640605"
            ]
          },
          "750640605": {
            "id": "750640605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait... Of only one Mora?",
            "nextDialogs": [
              "750640606"
            ]
          },
          "750640606": {
            "id": "750640606",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Great... And now, our true protagonists are about to make an appearance! Come on in, don't be shy! You're a star, so make that entrance dazzle!",
            "nextDialogs": [
              "750640607"
            ]
          },
          "750640607": {
            "id": "750640607",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Phew, and that's a wrap! Here, take this copy as a gift... and know that you have obtained this masterpiece before any Fontainian gallery could!",
            "nextDialogs": [
              "750640609",
              "750640611"
            ]
          },
          "750640609": {
            "id": "750640609",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But, the final payment...",
            "nextDialogs": [
              "750640613"
            ]
          },
          "750640613": {
            "id": "750640613",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "I'll be heading to this location next... Here, let me mark it out on your map. Who knows, perhaps our next meeting might be just around the corner!",
            "nextDialogs": [
              "750640614"
            ]
          },
          "750640614": {
            "id": "750640614",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "And when it comes, I might even need your help once more!",
            "nextDialogs": [
              "750640615"
            ]
          },
          "750640615": {
            "id": "750640615",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, you're practically taking us for granted, aren't you?",
            "nextDialogs": [
              "750640616"
            ]
          },
          "750640616": {
            "id": "750640616",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Well, our meeting wasn't for me to decide. T'was fate — yes, fate! — that brought us together.",
            "nextDialogs": [
              "750640617"
            ]
          },

        ],
        "dialogs": {
          "730500301": {
            "id": "730500301",
            "speakerId": 1007,
            "speakerName": "Aranaga",
            "text": "Festival Utsava... Feels familiar... Eh? It's White Floaty... and the Golden Nara.",
            "nextDialogs": [
              "730500302"
            ]
          },
          "730500302": {
            "id": "730500302",
            "speakerId": 1008,
            "speakerName": "Aranakin",
            "text": "It's the Nara friend, and the Nara friend's friend. Hope you will have fun during Festival Utsava.",
            "nextDialogs": [
              "730500303"
            ]
          },
          "730500303": {
            "id": "730500303",
            "speakerId": 1009,
            "speakerName": "Aragaru",
            "text": "A friend's friend is also our friend! Golden Nara and White Floaty are both Aragaru's friends!"
          }
        }
      }

  "subQuests": [
    {
      "subId": "7305001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730500101"
        ],
        "dialogs": {
          "730500101": {
            "id": "730500101",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#Nara {NICKNAME} and Paimon! Thanks to your help, the Varuna Contraption is now in good shape, and so is the Ashavan Realm.",
            "nextDialogs": [
              "730500102"
            ]
          },
          "730500102": {
            "id": "730500102",
            "speakerId": 1001,
            "speakerName": "Arakunti",
            "text": "All Aranara have returned to Vanarana for the celebration of Festival Utsava, like birds returning to their nests.",
            "nextDialogs": [
              "730500103"
            ]
          },
          "730500103": {
            "id": "730500103",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "The angry rain becomes gentle again. And Aranakula finally gets to take care of the garden, growing Viparyas, happy Viparyas...",
            "nextDialogs": [
              "730500104"
            ]
          },
          "730500104": {
            "id": "730500104",
            "speakerId": 1003,
            "speakerName": "Arakara",
            "text": "Happy Viparyas make happy lanterns, and happy lanterns light the happy Festival Utsava...",
            "nextDialogs": [
              "730500105"
            ]
          },
          "730500105": {
            "id": "730500105",
            "speakerId": 1003,
            "speakerName": "Arakara",
            "text": "#Nara {NICKNAME}, Paimon, the garden is doing great now, and Festival Utsava was a blast. Thank you for your help with healing the Varuna Contraption and bringing Aranakula back.",
            "nextDialogs": [
              "730500106"
            ]
          },
          "730500106": {
            "id": "730500106",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "All's well that ends well! Hee-hee...",
            "nextDialogs": [
              "730500107"
            ]
          },
          "730500107": {
            "id": "730500107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Speaking of which... I'm quite curious about something...",
            "nextDialogs": [
              "730500108"
            ]
          },
          "730500108": {
            "id": "730500108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why is Nara Varuna named Nara Varuna?",
            "nextDialogs": [
              "730500109"
            ]
          },
          "730500109": {
            "id": "730500109",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "Oh, it's because that Nara helped us heal the Varuna Contraption.",
            "nextDialogs": [
              "730500110"
            ]
          },
          "730500110": {
            "id": "730500110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Then what's {M#her}{F#his} real name?",
            "nextDialogs": [
              "730500111"
            ]
          },
          "730500111": {
            "id": "730500111",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#Um... No idea. Nara Varuna never told us {M#her}{F#his} real name.",
            "nextDialogs": [
              "730500114"
            ]
          },
          "730500114": {
            "id": "730500114",
            "speakerId": 1005,
            "speakerName": "Arabalika",
            "text": "#Nara {NICKNAME} has also helped a lot. Nara {NICKNAME} is a brave Nara and has overcome many difficulties. That we can gather here together at Festival Utsava makes me very happy.",
            "nextDialogs": [
              "730500115"
            ]
          },
          "730500115": {
            "id": "730500115",
            "speakerId": 1001,
            "speakerName": "Arakunti",
            "text": "#We have something for Nara {NICKNAME}.",
            "nextDialogs": [
              "730500116"
            ]
          },
          "730500116": {
            "id": "730500116",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "This is how Aranara say thank you.",
            "nextDialogs": [
              "730500117"
            ]
          },
          "730500117": {
            "id": "730500117",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "#Nara {NICKNAME} will like it, and so will Paimon.",
            "nextDialogs": [
              "730500118"
            ]
          },
          "730500118": {
            "id": "730500118",
            "speakerId": 1005,
            "speakerName": "Arabalika",
            "text": "Here is an Aranara flower for brave Nara and Paimon.",
            "nextDialogs": [
              "730500119"
            ]
          },
          "730500119": {
            "id": "730500119",
            "speakerId": 1003,
            "speakerName": "Arakara",
            "text": "#Arakara also has a flower. It's not a Viparyas, but still, it's for Nara {NICKNAME} and Paimon!",
            "nextDialogs": [
              "730500120"
            ]
          },
          "730500120": {
            "id": "730500120",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#Nara {NICKNAME}, Paimon, thanks for everything you did for Vana. We Aranara will never forget our friends!"
          }
        }
      }
    },
    {
      "subId": "7305002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730500201"
        ],
        "dialogs": {
          "730500201": {
            "id": "730500201",
            "speakerId": 1006,
            "speakerName": "Ararycan",
            "text": "#Nara {NICKNAME} and Paimon! Don't worry. The baddies that made Vanarana sick won't be coming back!",
            "nextDialogs": [
              "730500202"
            ]
          },
          "730500202": {
            "id": "730500202",
            "speakerId": 1006,
            "speakerName": "Ararycan",
            "text": "#Thank you, Nara {NICKNAME} and Paimon for helping Ararycan protect Vanarana. Ararycan has flowers for you!",
            "nextDialogs": [
              "730500203"
            ]
          },
          "730500203": {
            "id": "730500203",
            "speakerId": 1006,
            "speakerName": "Ararycan",
            "text": "Take the flowers, friends of Ararycan!"
          }
        }
      }
    },
    {
      "subId": "7305003",

  "subQuests": [
    {
      "subId": "7050101",
      "subQuestName": "Talk to Cloud Retainer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010101"
        ],
        "dialogs": {
          "705010101": {
            "id": "705010101",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "One wonders if this device may make desserts also...",
            "nextDialogs": [
              "705010102"
            ]
          },
          "705010102": {
            "id": "705010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you making this time?",
            "nextDialogs": [
              "705010103"
            ]
          },
          "705010103": {
            "id": "705010103",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Impeccable timing, Traveler. One just finished ruminating on the making of this next dish — a \"pudding,\" so it is named.",
            "nextDialogs": [
              "705010104"
            ]
          },
          "705010104": {
            "id": "705010104",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Much consultation did one have with the most recent and popular recipes before deciding on this dish. It is said to be soft and tasty — a fine dessert indeed.",
            "nextDialogs": [
              "705010105"
            ]
          },
          "705010105": {
            "id": "705010105",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Changes and improvements, too, has one made to it...",
            "nextDialogs": [
              "705010106"
            ]
          },
          "705010106": {
            "id": "705010106",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "...Along with the addition of rice.",
            "nextDialogs": [
              "705010107"
            ]
          },
          "705010107": {
            "id": "705010107",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Naturally, one's entitlement it is to name this new dish. Mmm... \"Rice Pudding\" shall its name be.",
            "nextDialogs": [
              "705010108"
            ]
          },
          "705010108": {
            "id": "705010108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sounds really filling...",
            "nextDialogs": [
              "705010109"
            ]
          },
          "705010109": {
            "id": "705010109",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "The quality of the rice is key to this dish. Upon one's activation of the Supreme Cuisine Machine, order it one did to search for high-quality rice. The resulting search led one here.",
            "nextDialogs": [
              "705010110"
            ]
          },
          "705010110": {
            "id": "705010110",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Well now, Traveler. Since you are presently here, will you help one collect some rice of fine stock? The Machine indicates that it may be found not far from here.",
            "nextDialogs": [
              "705010113"
            ]
          },
          "705010113": {
            "id": "705010113",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "This device needs tending, and one cannot be in two places at once.",
            "nextDialogs": [
              "705010114"
            ]
          },
          "705010114": {
            "id": "705010114",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Skilled you are in mind and hand, and are thus an invaluable helper. Go forth to one's aid, and one promises that you shall have a share in the Rice Pudding also.",
            "nextDialogs": [
              "705010115"
            ]
          },
          "705010115": {
            "id": "705010115",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Well then, one presumes upon your aid.",
            "nextDialogs": [
              "705010116"
            ]
          },
          "705010116": {
            "id": "705010116",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Supreme Cuisine Machine... activate!",
            "nextDialogs": [
              "705010117"
            ]
          },
          "705010117": {
            "id": "705010117",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Traveler, one has now activated the machine. Follow the tracks it has created and retrieve the Rice that one desires."
          }
        }
      }
    },
    {
      "subId": "7050102",
      "subQuestName": "Follow the aura trail and find the ingredients",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010201"
        ],
        "dialogs": {
          "705010201": {
            "id": "705010201",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Thank you! You saved my life... I'm Brunn, a merchant.",
            "nextDialogs": [
              "705010202"
            ]
          },
          "705010202": {
            "id": "705010202",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "*sigh* Just my luck. I was originally transporting a batch of cargo...",
            "nextDialogs": [
              "705010203"
            ]
          },
          "705010203": {
            "id": "705010203",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "But... I never expected to get attacked by monsters while I was on my way.",
            "nextDialogs": [
              "705010204"
            ]
          },
          "705010204": {
            "id": "705010204",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "I just kept running, I didn't have time to worry about the goods, or to tell which way I was going... Eventually, I ended up here.",
            "nextDialogs": [
              "705010205"
            ]
          },
          "705010205": {
            "id": "705010205",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "After I got here, I thought I had completely shaken them off. That's why I wanted to get out of the cart and check the goods.",
            "nextDialogs": [
              "705010206"
            ]
          },
          "705010206": {
            "id": "705010206",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "But they suddenly came out of nowhere... Thank goodness for your help.",
            "nextDialogs": [
              "705010207"
            ]
          },
          "705010207": {
            "id": "705010207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What kind of goods are you transporting?",
            "nextDialogs": [
              "705010208"
            ]
          },
          "705010208": {
            "id": "705010208",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "I'm transporting a batch of ingredients, rice and stuff like that...",
            "nextDialogs": [
              "705010209"
            ]
          },
          "705010209": {
            "id": "705010209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like this is the rice that the adeptus wanted us to find, but it doesn't look like there's much left...",
            "nextDialogs": [
              "705010210"
            ]
          },
          "705010210": {
            "id": "705010210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could you sell me some rice?",
            "nextDialogs": [
              "705010211"
            ]
          },
          "705010211": {
            "id": "705010211",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "You want to buy rice? It's not that I don't want to sell it, it's just that...I basically lost all the goods in my cart on the road when I was running away.",
            "nextDialogs": [
              "705010212"
            ]
          },
          "705010212": {
            "id": "705010212",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Those monsters must have brought the goods as loot back to their camp.",
            "nextDialogs": [
              "705010213"
            ]
          },
          "705010213": {
            "id": "705010213",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "What a headache. How can I get those goods back? If I can't get them back, I will lose a lot of money...",
            "nextDialogs": [
              "705010214"
            ]
          },
          "705010214": {
            "id": "705010214",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Traveler... I see that you are very skilled. Can you help me get those goods back?",
            "nextDialogs": [
              "705010215"
            ]
          },
          "705010215": {
            "id": "705010215",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "I—If you are willing to help me, I will give you as much rice as you want!",
            "nextDialogs": [
              "705010217",
              "705010219"
            ]
          },
          "705010217": {
            "id": "705010217",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Thank you! I'm counting on you then!",
            "nextDialogs": [
              "705010220"
            ]
          },
          "705010220": {
            "id": "705010220",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Bring my transport balloon along and place the goods on it.",
            "nextDialogs": [
              "705010221"
            ]
          },
          "705010221": {
            "id": "705010221",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "I'll leave it to you, Traveler. I'll be waiting for you here. After you get the goods, please bring them back to me."
          },
          "705010219": {
            "id": "705010219",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Don't worry, I have a solution."
          }
        }
      }
    },
    {
      "subId": "7050103",
      "subQuestName": "Rescue the person surrounded by monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010301"
        ],
        "dialogs": {
          "705010301": {
            "id": "705010301",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Did you bring the goods back? Thank you so much, Traveler!",
            "nextDialogs": [
              "705010302"
            ]
          },
          "705010302": {
            "id": "705010302",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "You wanted... rice, right? Please wait a moment, I will pick rice of better quality for you...",
            "nextDialogs": [
              "705010303"
            ]
          },
          "705010303": {
            "id": "705010303",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "There! This rice is for you, it should be enough.",
            "nextDialogs": [
              "705010304"
            ]
          },
          "705010304": {
            "id": "705010304",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "Thank you, Traveler. I should be on my way now.",
            "nextDialogs": [
              "705010305"
            ]
          },
          "705010305": {
            "id": "705010305",
            "speakerId": 20395,
            "speakerName": "Brunn",
            "text": "I hope I don't meet any more monsters..."
          }
        }
      }
    },

    {
      "subId": "7050116",
      "subQuestName": "Report back to Cloud Retainer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705011401"
        ],
        "dialogs": {
          "705011401": {
            "id": "705011401",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Indeed, this is most fine. Just the quality that one needs.",
            "nextDialogs": [
              "705011402"
            ]
          },
          "705011402": {
            "id": "705011402",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Since the ingredients are readied, one shall now activate the machine.",
            "nextDialogs": [
              "705011403"
            ]
          },
          "705011403": {
            "id": "705011403",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "As before, in your hands shall one leave the heat control, Traveler.",
            "nextDialogs": [
              "705011404"
            ]
          },
          "705011404": {
            "id": "705011404",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "One would have you report your readiness once you are sufficiently prepared."
          }
        }
      }
    },

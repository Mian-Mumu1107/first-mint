    {
      "subId": "7050105",
      "subQuestName": "Seize the ingredients back and ensure the safety of the transport balloon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010501"
        ],
        "dialogs": {
          "705010501": {
            "id": "705010501",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Well then. Is the Rice Pudding complete?",
            "nextDialogs": [
              "705010502"
            ]
          },
          "705010502": {
            "id": "705010502",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Mm, a lovely flavor indeed. No less would one expect of oneself, or one's own Supreme Cuisine Machine. Haha!",
            "nextDialogs": [
              "705010503"
            ]
          },
          "705010503": {
            "id": "705010503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's not get all high-strung here...",
            "nextDialogs": [
              "705010506"
            ]
          },
          "705010506": {
            "id": "705010506",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Your hand in this matter was mighty also, Traveler. Come. Prepared one has your recipe, as promised.",
            "nextDialogs": [
              "705010507"
            ]
          },
          "705010507": {
            "id": "705010507",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "What then shall one cook next? Hmm..."
          }
        }
      }
    },
    {
      "subId": "7050106",
      "subQuestName": "Defeat the incoming monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705010601"
        ],
        "dialogs": {
          "705010601": {
            "id": "705010601",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "One could not call the heat control desirable...",
            "nextDialogs": [
              "705010602"
            ]
          },
          "705010602": {
            "id": "705010602",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "But no matter. One has ingredients to spare with which to attempt this once more."
          }
        }
      }
    },
    {

            ]
          },
          "705011305": {
            "id": "705011305",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Your hand in this matter was mighty also, Traveler. Come. Prepared one has your recipe, as promised.",
            "nextDialogs": [
              "705011306"
            ]
          },
          "705011306": {
            "id": "705011306",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "What then shall one cook next? Hmm..."
          },
          "705011304": {
            "id": "705011304",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Cunning one's hands are, and no less should be expected of one's hand-crafted masterwork. Hardly a cause for alarm, one would say."
          }
        }
      }
    },

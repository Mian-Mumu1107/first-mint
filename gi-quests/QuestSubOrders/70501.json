    {
      "subId": "7050115",
      "subQuestName": "Report back to Cloud Retainer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705011301"
        ],
        "dialogs": {
          "705011301": {
            "id": "705011301",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "Mm, a lovely flavor indeed. No less would one expect of oneself, or one's own Supreme Cuisine Machine. Haha!",
            "nextDialogs": [
              "705011305",

        "startDialogs": [
          "708230401"
        ],
        "dialogs": {
          "708230401": {
            "id": "708230401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's so many monsters... Things really don't look good here.",
            "nextDialogs": [
              "708230402"
            ]
          },
          "708230402": {
            "id": "708230402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "They've already set up camp. Are they gathering more monsters to this area?",
            "nextDialogs": [
              "708230403"
            ]
          },
          "708230403": {
            "id": "708230403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It does look like this place isn't safe for work...",
            "nextDialogs": [
              "708230404"
            ]
          },
          "708230404": {
            "id": "708230404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Even the Treasure Hoarders are here! What are they doing?",
            "nextDialogs": [
              "708230405"
            ]
          },
          "708230405": {
            "id": "708230405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But Paimon thinks it makes sense. They're the only people who would do any work here...",
            "nextDialogs": [
              "708230406"
            ]
          },
          "708230406": {
            "id": "708230406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Things really don't look good over here. Let's go back to Manager Kuan."
          }
        }
      }
    },
    {
      "subId": "7082305",
      "subQuestName": "Dismantle the monster camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708230501"
        ],
        "dialogs": {
          "708230501": {
            "id": "708230501",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "What's the situation?",
            "nextDialogs": [
              "708230503",
              "708230505"
            ]
          },
          "708230503": {
            "id": "708230503",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "Is that so... *sigh* Then it seems like that work site can't be reopened.",
            "nextDialogs": [
              "708230508"
            ]
          },
          "708230508": {
            "id": "708230508",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "I understand the situation. Please take this as thanks for your help.",
            "nextDialogs": [
              "708230509"
            ]
          },
          "708230509": {
            "id": "708230509",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "But at this rate, our quotas are going to require some extensions.",
            "nextDialogs": [
              "708230510"
            ]
          },
          "708230510": {
            "id": "708230510",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "Gah, I have to find some place where we can start work..."
          },
          "708230505": {
            "id": "708230505",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "Treasure Hoarders? And lots of monsters too? Ugh...",
            "nextDialogs": [
              "708230506"
            ]
          },
          "708230506": {
            "id": "708230506",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "Those Treasure Hoarders would really do anything for Mora, huh...",
            "nextDialogs": [
              "708230507"
            ]
          },
          "708230507": {
            "id": "708230507",
            "speakerId": 1000,
            "speakerName": "Manager Kuan",
            "text": "Then it does indeed seem like that work site can't be reopened."
          }
        }
      }

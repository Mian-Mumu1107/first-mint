  },
  "subQuests": [
    {
      "subId": "7213801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721380101"
        ],
        "dialogs": {
          "721380101": {
            "id": "721380101",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Yeargh!!! I'm... I'm nobody suspicious, I swear! Just a local doctor!",
            "nextDialogs": [
              "721380102"
            ]
          },
          "721380102": {
            "id": "721380102",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "If you don't believe me, I can take you to my place. If you want anything, take it. Please just let me go!",
            "nextDialogs": [
              "721380103"
            ]
          },
          "721380103": {
            "id": "721380103",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Or take me to your General, Lord Kujou! H—He knows me!",
            "nextDialogs": [
              "721380106"
            ]
          },
          "721380106": {
            "id": "721380106",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Huh...? Oh, you don't look like someone from the Shogunate... or from Sangonomiya.",
            "nextDialogs": [
              "721380107"
            ]
          },
          "721380107": {
            "id": "721380107",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Are you... an outlander? What are you doing here?"
          }
        }
      }
    },
    {
      "subId": "7213802",
      "subQuestName": "Gather 12 Naku Weeds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721380201"
        ],
        "dialogs": {
          "721380201": {
            "id": "721380201",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Oh, you're here.",
            "nextDialogs": [
              "721380202"
            ]
          },
          "721380202": {
            "id": "721380202",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Have you gathered the herbs I mentioned?"
          }
        }
      }
    },
    {
      "subId": "7213807",
      "subQuestName": "Talk to Yasumoto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721380301"
        ],
        "dialogs": {
          "721380301": {
            "id": "721380301",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Yes, yes, the stems and leaves are all intact. And they are still fresh... Thank you very much.",
            "nextDialogs": [
              "721380302"
            ]
          },
          "721380302": {
            "id": "721380302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's all, right?",
            "nextDialogs": [
              "721380303"
            ]
          },
          "721380303": {
            "id": "721380303",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Good, yes. That's enough. Now, I can start researching some new remedies.",
            "nextDialogs": [
              "721380304"
            ]
          },
          "721380304": {
            "id": "721380304",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Thank you again for your effort. Here is the reward I promised you. I hope it's not too paltry a sum for you.",
            "nextDialogs": [
              "721380305"
            ]
          },
          "721380305": {
            "id": "721380305",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "By the way, outlander...",
            "nextDialogs": [
              "721380306"
            ]
          },
          "721380306": {
            "id": "721380306",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Ah, excuse me. I have troubled you so much, but I still don't know what to call you.",
            "nextDialogs": [
              "721380307"
            ]
          },
          "721380307": {
            "id": "721380307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Just call me {NICKNAME}.",
            "nextDialogs": [
              "721380308"
            ]
          },
          "721380308": {
            "id": "721380308",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#{NICKNAME}, if you are interested in helping me again, please come back later.",
            "nextDialogs": [
              "721380309"
            ]
          },
          "721380309": {
            "id": "721380309",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Of course, I'll compensate you fairly. Haha."
          }
        }
      }
    },
    {
      "subId": "7213803",
      "subQuestName": "Wait till 18:00 – 21:00 the next day and talk to Yasumoto",
      "sceneId": null,
      "locations": [],

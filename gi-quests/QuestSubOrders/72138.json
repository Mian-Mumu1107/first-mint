      }
    },
    {
      "subId": "7213804",
      "subQuestName": "Talk to Yasumoto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721380701"
        ],
        "dialogs": {
          "721380701": {
            "id": "721380701",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Blarghhh!! Ahem... ha... ha...",
            "nextDialogs": [
              "721380704"
            ]
          },
          "721380704": {
            "id": "721380704",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Well... ahem, it tastes bitter and my tongue has gone numb. Local paralysis might be caused by the Tatarigami.",
            "nextDialogs": [
              "721380705"
            ]
          },
          "721380705": {
            "id": "721380705",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "It tastes horrible. But seems harmless.",
            "nextDialogs": [
              "721380706"
            ]
          },
          "721380706": {
            "id": "721380706",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "It may take a long time to observe the side effects of the medicine. I don't know... Hey?",
            "nextDialogs": [
              "721380707"
            ]
          },
          "721380707": {
            "id": "721380707",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#They... They're coming toward us! {NICKNAME}! Get rid of them!"
          }
        }
      }
    },
    {
      "subId": "7213805",
      "subQuestName": "Protect Yasumoto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721380501"
        ],
        "dialogs": {
          "721380501": {
            "id": "721380501",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Phew... Phew... My heart almost jumped out. Thank you for saving my life. I won't forget it.",
            "nextDialogs": [
              "721380502"
            ]
          },
          "721380502": {
            "id": "721380502",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "This is a normal phenomenon. Living beings affected by Tatarigami will be unconsciously attracted to inauspicious energy.",
            "nextDialogs": [
              "721380503"
            ]
          },
          "721380503": {
            "id": "721380503",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Because this remedy is saturated with Tatarigami energy, it's normal that it would attract them.",
            "nextDialogs": [
              "721380504"
            ]
          },
          "721380504": {
            "id": "721380504",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Phew, anyway... I think I know how to improve this remedy now.",
            "nextDialogs": [
              "721380505"
            ]
          },
          "721380505": {
            "id": "721380505",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "But the last failure wasted some fresh herbs. I need some more herbs to continue with my new remedy evaluations.",
            "nextDialogs": [
              "721380506"
            ]
          },
          "721380506": {
            "id": "721380506",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#In your upcoming journey, {NICKNAME}, please watch out for any useful herbs on the island. Just leave them in the bamboo basket in front of the house in the mornings.",
            "nextDialogs": [
              "721380511"
            ]
          },
          "721380511": {
            "id": "721380511",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "I will give you the reward as I've promised. But I'm afraid you'll have to wait a while.",
            "nextDialogs": [
              "721380507"
            ]
          },
          "721380507": {
            "id": "721380507",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#{NICKNAME}, it's fine if you're busy. Maybe I can find someone else to help.",
            "nextDialogs": [
              "721380510"
            ]
          },
          "721380510": {
            "id": "721380510",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#Goodbye, traveler {NICKNAME}. I hope you will have a safe journey on Yashiori Island."
          }
        }
      }
    },
    {
      "subId": "7213806",
      "subQuestName": "Talk to Yasumoto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7213804",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721380401"
        ],
        "dialogs": {
          "721380401": {
            "id": "721380401",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#Thank you, {NICKNAME}. I'm sorry if I've caused you any inconvenience.",
            "nextDialogs": [
              "721380404"
            ]
          },
          "721380404": {
            "id": "721380404",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "I have mixed a new remedy with the herbs you gathered. But I don't have any test subjects to assess the efficacy of the medicine.",
            "nextDialogs": [
              "721380405"
            ]
          },
          "721380405": {
            "id": "721380405",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#{NICKNAME}, can you please...",
            "nextDialogs": [
              "721380406"
            ]
          },
          "721380406": {
            "id": "721380406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please tell me straight-forward.",
            "nextDialogs": [
              "721380407"
            ]
          },
          "721380407": {
            "id": "721380407",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "#{NICKNAME}, can I ask you to witness the efficacy of my new remedy?",
            "nextDialogs": [
              "721380408"
            ]
          },
          "721380408": {
            "id": "721380408",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "The new prescription is still unstable and there's no way to foresee the worst consequences.",
            "nextDialogs": [
              "721380409"
            ]
          },
          "721380409": {
            "id": "721380409",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "So I hope at least someone can witness my success... Or help me deal with the consequences, if the worst comes to the worst.",
            "nextDialogs": [
              "721380410"
            ]
          },
          "721380410": {
            "id": "721380410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright."
          }
        }
      }
    },
    {
      "subId": "7213806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721380601"
        ],
        "dialogs": {
          "721380601": {
            "id": "721380601",
            "speakerId": 20238,
            "speakerName": "Yasumoto",
            "text": "Thank you very much for your help. But please be careful on Yashiori Island... This is not a safe place to stay."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2004801",
      "subQuestName": "Talk to Timmie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480101"
        ],
        "dialogs": {
          "200480101": {
            "id": "200480101",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Argh! YOU again! You've scared all my pigeons off... again!",
            "nextDialogs": [
              "200480102"
            ]
          },
          "200480102": {
            "id": "200480102",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "I was feeding them. What do you have to say for yourself?",
            "nextDialogs": [
              "200480103"
            ]
          },
          "200480103": {
            "id": "200480103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oops...",
            "nextDialogs": [
              "200480104"
            ]
          },
          "200480104": {
            "id": "200480104",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Hmph. Well, Mommy always tells me that if someone's really sorry, they will show it with their actions, not their words.",
            "nextDialogs": [
              "200480105"
            ]
          },
          "200480105": {
            "id": "200480105",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "The bridge pigeons are my friends. I feed them all the time.",
            "nextDialogs": [
              "200480106"
            ]
          },
          "200480106": {
            "id": "200480106",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "But these days the ducks are coming and stealing their food, and the pigeons never have enough to eat anymore.",
            "nextDialogs": [
              "200480107"
            ]
          },
          "200480107": {
            "id": "200480107",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "I want you to find three wheats for me and feed them to the ducks. While you're doing that, I can make sure the bridge pigeons get enough to eat.",
            "nextDialogs": [
              "200480108"
            ]
          },
          "200480108": {
            "id": "200480108",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Once both sides have had enough to eat, maybe everyone can become friends.",
            "nextDialogs": [
              "200480111",
              "200480113"
            ]
          },
          "200480111": {
            "id": "200480111",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Thank you.",
            "nextDialogs": [
              "200480112"
            ]
          },
          "200480112": {
            "id": "200480112",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "If you treat the animals well, maybe you can become friends with them too."
          },
          "200480113": {
            "id": "200480113",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Whether you want to be their friend or not... You owe them an apology!",
            "nextDialogs": [
              "200480114"
            ]
          },
          "200480114": {
            "id": "200480114",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "So hurry up and get that wheat!"
          }
        }
      }
    },
    {
      "subId": "2004802",
      "subQuestName": "Find and collect three Wheat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480201"
        ],
        "dialogs": {
          "200480201": {
            "id": "200480201",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Found the wheat yet?",
            "nextDialogs": [
              "200480202"
            ]
          },
          "200480202": {
            "id": "200480202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yep.",
            "nextDialogs": [
              "200480203"
            ]
          },
          "200480203": {
            "id": "200480203",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "It looks like enough.",
            "nextDialogs": [
              "200480204"
            ]
          },
          "200480204": {
            "id": "200480204",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Take it down to the lake and feed it to the ducks."
          }
        }
      }
    },
    {
      "subId": "2004803",
      "subQuestName": "Give the Wheat to Timmie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2004804",
      "subQuestName": "Go to the lakeside and scatter the Wheat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480401"
        ],
        "dialogs": {
          "200480401": {
            "id": "200480401",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Have you found the wheat yet?",
            "nextDialogs": [
              "200480402"
            ]
          },
          "200480402": {
            "id": "200480402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still looking...",
            "nextDialogs": [
              "200480403"
            ]
          },
          "200480403": {
            "id": "200480403",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Fine. But make sure you find it before the ducks get back!",
            "nextDialogs": [
              "200480404"
            ]
          },
          "200480404": {
            "id": "200480404",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "The pigeons? They're not here yet. Don't you worry about them, they'll be here."
          }
        }
      }
    },
    {
      "subId": "2004805",
      "subQuestName": "Talk to Timmie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480301"
        ],
        "dialogs": {
          "200480301": {
            "id": "200480301",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "I'm sure they'll all get on much better after a nice meal.",
            "nextDialogs": [
              "200480302"
            ]
          },
          "200480302": {
            "id": "200480302",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Next time you're passing by, please try not to scare off the pigeons. It's hard work to get them to come back again.",
            "nextDialogs": [
              "200480303"
            ]
          },
          "200480303": {
            "id": "200480303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll be more careful in the future.",
            "nextDialogs": [
              "200480304"
            ]
          },
          "200480304": {
            "id": "200480304",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Alright. I forgive you. Here, have a Mondstadt hash brown — they're my favorite!",
            "nextDialogs": [
              "200480305"
            ]
          },
          "200480305": {
            "id": "200480305",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Mommy says you should always be kind to others."
          }
        }
      }
    },
    {
      "subId": "2004806",
      "subQuestName": "Talk to angry Timmie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480601"
        ],
        "dialogs": {
          "200480601": {
            "id": "200480601",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "WHAT HAVE YOU DONE!? I saw that, you... you... Those poor ducks...!",
            "nextDialogs": [
              "200480602"
            ]
          },
          "200480602": {
            "id": "200480602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was for the pigeons...",
            "nextDialogs": [
              "200480603"
            ]
          },
          "200480603": {
            "id": "200480603",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Go away! I never want to see you again... EVER!",
            "nextDialogs": [
              "200480604"
            ]
          },
          "200480604": {
            "id": "200480604",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "*sobbing* I'm telling Mommy..."
          }
        }
      }
    },
    {
      "subId": "2004805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480501"
        ],
        "dialogs": {
          "200480501": {
            "id": "200480501",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Why aren't my pigeons here yet..."
          }
        }
      }
    }
  ]
}
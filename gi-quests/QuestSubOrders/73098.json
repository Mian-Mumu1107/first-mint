            ]
          },
          "730980302": {
            "id": "730980302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's rude to tamper around...",
            "nextDialogs": [
              "730980303"
            ]
          },
          "730980303": {
            "id": "730980303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Who knows how many adventurer camps and treasure chests we have rummaged through!",
            "nextDialogs": [
              "730980304"
            ]
          },
          "730980304": {
            "id": "730980304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's put it this way. We didn't see Aranara anywhere near the house, and we were worried, so we'd rather see if there were any leads. We might even help some trapped Aranara!",
            "nextDialogs": [
              "730980307"
            ]
          },
          "730980307": {
            "id": "730980307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Of course! Anyway, seems like the painting depicts some views near here, right? Ah, maybe it's a treasure map...",
            "nextDialogs": [
              "730980308"
            ]
          },
          "730980308": {
            "id": "730980308",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, we should go to the spot shown in the painting! Maybe we'll find some treasure left by the Aranara!"
          }
        }
      }
    },

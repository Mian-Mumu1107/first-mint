        "dialogs": {
          "730980401": {
            "id": "730980401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Let's take a look. It seems like a new treasure map!",
            "nextDialogs": [
              "730980402"
            ]
          },
          "730980402": {
            "id": "730980402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aren't we going to help \"the trapped Aranara\"?",
            "nextDialogs": [
              "730980403"
            ]
          },
          "730980403": {
            "id": "730980403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Ahem! We haven't found the house owner. This is worrying! So, {NICKNAME}, why don't we check some other places shown in the painting?",
            "nextDialogs": [
              "730980404"
            ]
          },
          "730980404": {
            "id": "730980404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "After we get there, we could...",
            "nextDialogs": [
              "730980406",
              "730980408"
            ]
          },
          "730980406": {
            "id": "730980406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yes! Wait, Paimon means... no! Find the trapped Aranara!",
            "nextDialogs": [
              "730980409"
            ]
          },
          "730980409": {
            "id": "730980409",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And what an interesting \"mailbox.\" It may receive some new paintings later. We should keep an eye on it!"
          },
          "730980408": {
            "id": "730980408",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yes! We might even find some treasure!"
          }
        }
      }

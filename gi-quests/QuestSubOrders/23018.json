{
  "lineCounts": {
    "Aftab": 9,
    "Azra": 8,
    "Gurgen": 9,
    "Player": 24,
    "Zakariya": 63
  },
  "subQuests": [
    {
      "subId": "2301801",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180101"
        ],
        "dialogs": {
          "230180101": {
            "id": "230180101",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "*sigh* What a headache...",
            "nextDialogs": [
              "230180119",
              "230180104"
            ]
          },
          "230180119": {
            "id": "230180119",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "We have been really shorthanded lately, and I haven't slept for days on end.",
            "nextDialogs": [
              "230180120"
            ]
          },
          "230180120": {
            "id": "230180120",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "If you would, Traveler, could you help me deliver some medicine to the patients nearby? Please check on them as well."
          },
          "230180104": {
            "id": "230180104",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "You must be a traveler. This is Bimarstan, a hospital that aids the masses... Um... by spreading the blessings of the Dendro Archon.",
            "nextDialogs": [
              "230180105"
            ]
          },
          "230180105": {
            "id": "230180105",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "No matter rich or poor, anyone in need shall get medical help here.",
            "nextDialogs": [
              "230180106"
            ]
          },
          "230180106": {
            "id": "230180106",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "But as a result... We have too many patients and not enough hands to see to them all.",
            "nextDialogs": [
              "230180107"
            ]
          },
          "230180107": {
            "id": "230180107",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "*sigh* The benevolence of the Dendro Archon might be endless... But our budget and manpower are not.",
            "nextDialogs": [
              "230180108"
            ]
          },
          "230180108": {
            "id": "230180108",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "And then there are patients who ignore all medical instructions, but just keep asking about how to better embrace the blessings of the Dendro Archon.",
            "nextDialogs": [
              "230180109"
            ]
          },
          "230180109": {
            "id": "230180109",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Haha, blessings of the Dendro Archon... My goodness!",
            "nextDialogs": [
              "230180110"
            ]
          },
          "230180110": {
            "id": "230180110",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "If the Dendro Archon really could just rain down blessings, they wouldn't have gotten sick in the first place!",
            "nextDialogs": [
              "230180111"
            ]
          },
          "230180111": {
            "id": "230180111",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "...Phew, sorry, I shouldn't have said that. Please don't tell Golshan about this, or she might lecture me again."
          }
        }
      }
    },
    {
      "subId": "2301802",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180201"
        ],
        "dialogs": {
          "230180201": {
            "id": "230180201",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "The medicine delivery this time is for Gurgen, who is at the medicine farm.",
            "nextDialogs": [
              "230180202"
            ]
          },
          "230180202": {
            "id": "230180202",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "He strained his arm from doing too much work a few days before.",
            "nextDialogs": [
              "230180203"
            ]
          },
          "230180203": {
            "id": "230180203",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Please give him this medicine. By the way, tell him to also stay at home and pray silently to the Dendro Archon. Farm work can wait.",
            "nextDialogs": [
              "230180207",
              "230180206"
            ]
          },
          "230180207": {
            "id": "230180207",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Please come back once the delivery is done. I will have the payment ready for you."
          },
          "230180206": {
            "id": "230180206",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "He won't listen to a word I say if I don't say that. Just do as I instructed, alright?"
          }
        }
      }
    },
    {
      "subId": "2301820",
      "subQuestName": "Bring the medicine to Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230182001"
        ],
        "dialogs": {
          "230182001": {
            "id": "230182001",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "I'm counting on you for the medicine delivery. Don't forget to pass the medical instructions on either."
          }
        }
      }
    },
    {
      "subId": "2301803",
      "subQuestName": "Talk to Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180301"
        ],
        "dialogs": {
          "230180301": {
            "id": "230180301",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Huh? This is...",
            "nextDialogs": [
              "230180302"
            ]
          },
          "230180302": {
            "id": "230180302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's your medicine, remember to pray quietly to the Dendro Archon.",
            "nextDialogs": [
              "230180303"
            ]
          },
          "230180303": {
            "id": "230180303",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Ah, thanks. Pray quietly to the Dendro Archon... Yes, I must do that...",
            "nextDialogs": [
              "230180304"
            ]
          },
          "230180304": {
            "id": "230180304",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "But there are so many <color=#00E1FFFF>weeds in the field</color>... If I keep doing nothing, it's going to affect the yield.",
            "nextDialogs": [
              "230180305"
            ]
          },
          "230180305": {
            "id": "230180305",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Um... I'll just <color=#00E1FFFF>deal with the weeds</color> first, then do my silent prayers when I finish."
          }
        }
      }
    },
    {
      "subId": "2301804",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180401"
        ],
        "dialogs": {
          "230180401": {
            "id": "230180401",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "You're back. How did it go?",
            "nextDialogs": [
              "230180402"
            ]
          },
          "230180402": {
            "id": "230180402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He wanted to deal with the weeds first...",
            "nextDialogs": [
              "230180403"
            ]
          },
          "230180403": {
            "id": "230180403",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "*sigh* So even the silent prayer line didn't work... I suppose I'll have to come up with something else.",
            "nextDialogs": [
              "230180404"
            ]
          },
          "230180404": {
            "id": "230180404",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Thanks for your hard work. Please, take this as payment."
          }
        }
      }
    },
    {
      "subId": "2301806",
      "subQuestName": "Talk to Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180601"
        ],
        "dialogs": {
          "230180601": {
            "id": "230180601",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "The weeds... You've removed them all? I... You're too kind!",
            "nextDialogs": [
              "230180602"
            ]
          },
          "230180602": {
            "id": "230180602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just go back home and rest.",
            "nextDialogs": [
              "230180603"
            ]
          },
          "230180603": {
            "id": "230180603",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "I will, thank you. May the Dendro Archon bless and protect you!",
            "nextDialogs": [
              "230180604"
            ]
          },
          "230180604": {
            "id": "230180604",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "I should hurry home to conduct my silent prayers to the Dendro Archon as well."
          }
        }
      }
    },
    {
      "subId": "2301807",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180701"
        ],
        "dialogs": {
          "230180701": {
            "id": "230180701",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "You are back. How did it go?",
            "nextDialogs": [
              "230180702"
            ]
          },
          "230180702": {
            "id": "230180702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About removing the weeds...",
            "nextDialogs": [
              "230180703"
            ]
          },
          "230180703": {
            "id": "230180703",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Ah, that's great. This way, Gurgen can finally have some proper rest. He should be able to recover sooner.",
            "nextDialogs": [
              "230180704"
            ]
          },
          "230180704": {
            "id": "230180704",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "I can't thank you enough. Please take this as your payment."
          }
        }
      }
    },
    {
      "subId": "2301808",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180801"
        ],
        "dialogs": {
          "230180801": {
            "id": "230180801",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "The medicine this time is for Azra at the theater entrance.",
            "nextDialogs": [
              "230180802"
            ]
          },
          "230180802": {
            "id": "230180802",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "She has been coughing lately, but she refused to take the medicine I prescribed, saying that it tastes too bitter.",
            "nextDialogs": [
              "230180803"
            ]
          },
          "230180803": {
            "id": "230180803",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Please give her this medicine. Also, tell her that... Um...",
            "nextDialogs": [
              "230180804"
            ]
          },
          "230180804": {
            "id": "230180804",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "This... bitterness in the medicine is but a... test, yes, a test, bestowed by the Dendro Archon.",
            "nextDialogs": [
              "230180808",
              "230180807"
            ]
          },
          "230180808": {
            "id": "230180808",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Please come back once the delivery is done. I will have the payment ready for you."
          },
          "230180807": {
            "id": "230180807",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "I didn't exactly learn it? I've just heard these kinds of things too often."
          }
        }
      }
    },
    {
      "subId": "2301821",
      "subQuestName": "Bring the medicine to Azra",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230182101"
        ],
        "dialogs": {
          "230182101": {
            "id": "230182101",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "*sigh* I guess my body isn't what it used to be... No, I can't give up yet. I must persist for a while more."
          }
        }
      }
    },
    {
      "subId": "2301809",
      "subQuestName": "Talk to Azra",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180901"
        ],
        "dialogs": {
          "230180901": {
            "id": "230180901",
            "speakerId": 1002,
            "speakerName": "Azra",
            "text": "Hmm... This smells familiar...",
            "nextDialogs": [
              "230180902"
            ]
          },
          "230180902": {
            "id": "230180902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's your medicine. Remember to finish all of it...",
            "nextDialogs": [
              "230180903"
            ]
          },
          "230180903": {
            "id": "230180903",
            "speakerId": 1002,
            "speakerName": "Azra",
            "text": "Ugh, this <color=#00E1FFFF>super bitter medicine</color> again. I can't take it...",
            "nextDialogs": [
              "230180904"
            ]
          },
          "230180904": {
            "id": "230180904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is but a test from the Dendro Archon, you know?",
            "nextDialogs": [
              "230180905"
            ]
          },
          "230180905": {
            "id": "230180905",
            "speakerId": 1002,
            "speakerName": "Azra",
            "text": "Eh? Is that so? But <color=#00E1FFFF>it's so bitter</color>... Can't the Dendro Archon be just a wee bit nicer?",
            "nextDialogs": [
              "230180906"
            ]
          },
          "230180906": {
            "id": "230180906",
            "speakerId": 1002,
            "speakerName": "Azra",
            "text": "...Alright, alright, hand me the medicine. I'll take it later..."
          }
        }
      }
    },
    {
      "subId": "2301810",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181001"
        ],
        "dialogs": {
          "230181001": {
            "id": "230181001",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "You're back. How did it go?",
            "nextDialogs": [
              "230181002"
            ]
          },
          "230181002": {
            "id": "230181002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She complained that the medicine was too bitter.",
            "nextDialogs": [
              "230181003"
            ]
          },
          "230181003": {
            "id": "230181003",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Well, there's nothing I can do about that. After all, the nature and components of the herbs... Ahem, I mean blessings, come with some bitterness.",
            "nextDialogs": [
              "230181004"
            ]
          },
          "230181004": {
            "id": "230181004",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Hopefully, she will finish it all this time. There was so much left over previously...",
            "nextDialogs": [
              "230181005"
            ]
          },
          "230181005": {
            "id": "230181005",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Thanks for your hard work. Please take this as payment."
          }
        }
      }
    },
    {
      "subId": "2301812",
      "subQuestName": "Talk to Azra",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181201"
        ],
        "dialogs": {
          "230181201": {
            "id": "230181201",
            "speakerId": 1002,
            "speakerName": "Azra",
            "text": "Eh? Are these for me? Thank you...",
            "nextDialogs": [
              "230181202"
            ]
          },
          "230181202": {
            "id": "230181202",
            "speakerId": 1002,
            "speakerName": "Azra",
            "text": "Alright! I'll give the medicine another go... I'll finish it all for sure this time!"
          }
        }
      }
    },
    {
      "subId": "2301813",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181301"
        ],
        "dialogs": {
          "230181301": {
            "id": "230181301",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "You're back. How did it go?",
            "nextDialogs": [
              "230181302"
            ]
          },
          "230181302": {
            "id": "230181302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I gave her some candies.",
            "nextDialogs": [
              "230181303"
            ]
          },
          "230181303": {
            "id": "230181303",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Candies? They'll reduce the efficacy of that medicine, though.",
            "nextDialogs": [
              "230181304"
            ]
          },
          "230181304": {
            "id": "230181304",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "...Ah, never mind. Reduced efficacy is better than no efficacy at all, and at least she can finish the medicine this time around.",
            "nextDialogs": [
              "230181305"
            ]
          },
          "230181305": {
            "id": "230181305",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "I really can't thank you enough. Please take this as payment."
          }
        }
      }
    },
    {
      "subId": "2301814",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181401"
        ],
        "dialogs": {
          "230181401": {
            "id": "230181401",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "The medicine delivery this time is for Aftab at the farmhouse.",
            "nextDialogs": [
              "230181402"
            ]
          },
          "230181402": {
            "id": "230181402",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "That fellow's been living on a greasy diet, so he has serious digestion problems.",
            "nextDialogs": [
              "230181403"
            ]
          },
          "230181403": {
            "id": "230181403",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "So please give him this medicine. By the way, tell him that... Um...",
            "nextDialogs": [
              "230181404"
            ]
          },
          "230181404": {
            "id": "230181404",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Tell him that eating lighter foods and having less alcohol and meat is the way to better embrace the blessings of the Dendro Archon.",
            "nextDialogs": [
              "230181408",
              "230181407"
            ]
          },
          "230181408": {
            "id": "230181408",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Please come back once the delivery is done. I will have the payment ready for you."
          },
          "230181407": {
            "id": "230181407",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Some Akademiya researchers have said that we can do something like that, though I don't understand why..."
          }
        }
      }
    },
    {
      "subId": "2301822",
      "subQuestName": "Bring the medicine to Aftab",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230182201"
        ],
        "dialogs": {
          "230182201": {
            "id": "230182201",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "I just need to hold on for several days more..."
          }
        }
      }
    },
    {
      "subId": "2301815",
      "subQuestName": "Talk to Aftab",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181501"
        ],
        "dialogs": {
          "230181501": {
            "id": "230181501",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "Hmm? What is this medicine?",
            "nextDialogs": [
              "230181502"
            ]
          },
          "230181502": {
            "id": "230181502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's your medicine. Please maintain a light diet.",
            "nextDialogs": [
              "230181503"
            ]
          },
          "230181503": {
            "id": "230181503",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "*sigh* Okay, I will. Honestly, I <color=#00E1FFFF>haven't touched a slice of meat</color> in days. I'm sure that this will definitely help me to embrace the Dendro Archon's blessings better...",
            "nextDialogs": [
              "230181504"
            ]
          },
          "230181504": {
            "id": "230181504",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "But why do I feel worse than before? *sigh* No, no, I must've just spent too little time dieting, that's all..."
          }
        }
      }
    },
    {
      "subId": "2301816",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181601"
        ],
        "dialogs": {
          "230181601": {
            "id": "230181601",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "You're back. How did it go?",
            "nextDialogs": [
              "230181602"
            ]
          },
          "230181602": {
            "id": "230181602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He has kept away from meat for quite a few days now...",
            "nextDialogs": [
              "230181603"
            ]
          },
          "230181603": {
            "id": "230181603",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "What? I was telling him to eat lighter, not to completely stop eating meat!",
            "nextDialogs": [
              "230181604"
            ]
          },
          "230181604": {
            "id": "230181604",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Does he think that he can best embrace the Dendro Archon's blessings this way?",
            "nextDialogs": [
              "230181605"
            ]
          },
          "230181605": {
            "id": "230181605",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Alright... I guess I have to come up with something else...",
            "nextDialogs": [
              "230181606"
            ]
          },
          "230181606": {
            "id": "230181606",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Thanks for your hard work. Here, this is for you."
          }
        }
      }
    },
    {
      "subId": "2301818",
      "subQuestName": "Talk to Aftab",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181801"
        ],
        "dialogs": {
          "230181801": {
            "id": "230181801",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "What is this? No... The scent is just too...",
            "nextDialogs": [
              "230181802"
            ]
          },
          "230181802": {
            "id": "230181802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So here's what happened...",
            "nextDialogs": [
              "230181803"
            ]
          },
          "230181803": {
            "id": "230181803",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "Really? A light diet doesn't mean a full ban on meat? Even the Akademiya researchers don't do that?",
            "nextDialogs": [
              "230181804"
            ]
          },
          "230181804": {
            "id": "230181804",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "S—So that's it! I was afraid of making the Dendro Archon angry by eating meat.",
            "nextDialogs": [
              "230181805"
            ]
          },
          "230181805": {
            "id": "230181805",
            "speakerId": 1003,
            "speakerName": "Aftab",
            "text": "If even the researchers do eat meat... I won't worry about eating meat anymore. Thank you!"
          }
        }
      }
    },
    {
      "subId": "2301819",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181901"
        ],
        "dialogs": {
          "230181901": {
            "id": "230181901",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "You're back. How did it go?",
            "nextDialogs": [
              "230181902"
            ]
          },
          "230181902": {
            "id": "230181902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I told him that he could just eat a steak or two...",
            "nextDialogs": [
              "230181903"
            ]
          },
          "230181903": {
            "id": "230181903",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Oh? It didn't occur to me you could put it like that...",
            "nextDialogs": [
              "230181904"
            ]
          },
          "230181904": {
            "id": "230181904",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Well, as long as Aftab is treating his body right, everything should be fine.",
            "nextDialogs": [
              "230181905"
            ]
          },
          "230181905": {
            "id": "230181905",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "I can't thank you enough. Please take this as your payment."
          }
        }
      }
    },
    {
      "subId": "2301823",

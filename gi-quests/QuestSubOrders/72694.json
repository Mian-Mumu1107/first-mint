  "subQuests": [
    {
      "subId": "7269401",
      "subQuestName": "Go to the Adventurers' Guild in Inazuma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940101"
        ],
        "dialogs": {
          "726940101": {
            "id": "726940101",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "Traveler and Paimon, you're right on cue!",
            "nextDialogs": [
              "726940102"
            ]
          },
          "726940102": {
            "id": "726940102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right on cue for what?",
            "nextDialogs": [
              "726940103"
            ]
          },
          "726940103": {
            "id": "726940103",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "For a commission that's suited for you! I was just about to reach out to you.",
            "nextDialogs": [
              "726940104"
            ]
          },
          "726940104": {
            "id": "726940104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A commission that's suited for us... Don't tell Paimon that you want us to look for things or drive hilichurls off.",
            "nextDialogs": [
              "726940107"
            ]
          },
          "726940107": {
            "id": "726940107",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "Oh, don't misunderstand. The commission is indeed suited for you, and by \"suited\" I mean...",
            "nextDialogs": [
              "726940108"
            ]
          },
          "726940108": {
            "id": "726940108",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "It's fun, and there are rich rewards to be had as well.",
            "nextDialogs": [
              "726940109"
            ]
          },
          "726940109": {
            "id": "726940109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rich rewards!",
            "nextDialogs": [
              "726940110"
            ]
          },
          "726940110": {
            "id": "726940110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Being fun certainly doesn't seem important to Paimon, huh?",
            "nextDialogs": [
              "726940111"
            ]
          },
          "726940111": {
            "id": "726940111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "U—Um... Being fun is also important! So, what is this commission about?",
            "nextDialogs": [
              "726940112"
            ]
          },
          "726940112": {
            "id": "726940112",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "The requester is a toy merchant from Fontaine. His name is Bertrand. He came to sell toys in Inazuma and is currently looking for an assistant to help him with toy-making.",
            "nextDialogs": [
              "726940113"
            ]
          },
          "726940113": {
            "id": "726940113",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "He's a businessman, after all. That explains why he promised some very generous rewards when he put up the request at the Adventurers' Guild.",
            "nextDialogs": [
              "726940114"
            ]
          },
          "726940114": {
            "id": "726940114",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "But he somehow can't leave Ritou at the moment. Please go and ask him about the details of the commission.",
            "nextDialogs": [
              "726940115"
            ]
          },
          "726940115": {
            "id": "726940115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sure, we'll head to Ritou and look for him right away!"
          }
        }
      }
    },
    {
      "subId": "7269402",
      "subQuestName": "Go to Ritou and look for Bertrand",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940201"
        ],
        "dialogs": {
          "726940201": {
            "id": "726940201",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Ahahah! I now have everything ready! I'll sell each toy for thousands of Mora. Then, with tens of thousands of them sold...",
            "nextDialogs": [
              "726940202"
            ]
          },
          "726940202": {
            "id": "726940202",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "I can easily earn tens of millions... Hahaha...",
            "nextDialogs": [
              "726940203"
            ]
          },
          "726940203": {
            "id": "726940203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello, are you Bertrand?",
            "nextDialogs": [
              "726940204"
            ]
          },
          "726940204": {
            "id": "726940204",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Ah yes, I am.",
            "nextDialogs": [
              "726940205"
            ]
          },
          "726940205": {
            "id": "726940205",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Are you two toy buyers who caught wind of my business?",
            "nextDialogs": [
              "726940206"
            ]
          },
          "726940206": {
            "id": "726940206",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "But it's a shame that I can't sell you any toys yet, because I haven't started mass production.",
            "nextDialogs": [
              "726940207"
            ]
          },
          "726940207": {
            "id": "726940207",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "But no worries, the production line is being built as of now. You can register and make a deposit if you're interested. I'll inform you when the toys are ready, and then you can proceed to pay the balance...",
            "nextDialogs": [
              "726940208"
            ]
          },
          "726940208": {
            "id": "726940208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hold your horses! We're not here to buy your toys.",
            "nextDialogs": [
              "726940209"
            ]
          },
          "726940209": {
            "id": "726940209",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Oh, you aren't toy buyers... So if you've got something to say, tell me quick. Don't waste my time.",
            "nextDialogs": [
              "726940210"
            ]
          },
          "726940210": {
            "id": "726940210",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "And be concise, my time is precious.",
            "nextDialogs": [
              "726940211"
            ]
          },
          "726940211": {
            "id": "726940211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa... What a change of attitude!",
            "nextDialogs": [
              "726940214"
            ]
          },
          "726940214": {
            "id": "726940214",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Ah, so you're the assistants sent by the Adventurers' Guild! Welcome! You could've told me earlier!",
            "nextDialogs": [
              "726940215"
            ]
          },
          "726940215": {
            "id": "726940215",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Yes, I did put up that request. How should I address you two?",
            "nextDialogs": [
              "726940216"
            ]
          },
          "726940216": {
            "id": "726940216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(A sudden change of attitude again...)",
            "nextDialogs": [
              "726940217"
            ]
          },
          "726940217": {
            "id": "726940217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon is... Uh, Paimon.",
            "nextDialogs": [
              "726940218"
            ]
          },
          "726940218": {
            "id": "726940218",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Then, how about you?",
            "nextDialogs": [
              "726940219"
            ]
          },
          "726940219": {
            "id": "726940219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}...",
            "nextDialogs": [
              "726940220"
            ]
          },
          "726940220": {
            "id": "726940220",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "#{NICKNAME}? I think I've heard this name somewhere. Were you once... a wanted criminal too?"
          }
        }
      }
    },
    {
      "subId": "7269403",
      "subQuestName": "Collect 3 ores in the wild",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940301"
        ],
        "dialogs": {
          "726940301": {
            "id": "726940301",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Have you collected the source materials using the Collector? The source materials play a critical role in shaping the toys. Be careful with your choice, haha!"
          }
        }
      }
    },
    {
      "subId": "7269405",
      "subQuestName": "Collect 3 flowers in the wild",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940501"
        ],
        "dialogs": {
          "726940501": {
            "id": "726940501",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Heh! If that's the amount I'm getting for one of these, then I just need to sell 20,000 of them to pay off my debt!",
            "nextDialogs": [
              "726940502"
            ]
          },
          "726940502": {
            "id": "726940502",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "As simple as that... Uh, you seem to have some questions, I presume?",
            "nextDialogs": [
              "726940504",
              "726940506"
            ]
          },
          "726940504": {
            "id": "726940504",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "I plan to sell toys, but... Unfortunately, the toys are yet to be produced. Please check them out once I have them ready."
          },
          "726940506": {
            "id": "726940506",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "If you've nothing to say, then don't bother me. I'm currently making a batch of important products."
          }
        }
      }
    },
    {
      "subId": "7269406",
      "subQuestName": "Collect 6 fruits in the wild",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7269404",
      "subQuestName": "Return the Material Collector to Bertrand",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940401"
        ],
        "dialogs": {
          "726940401": {
            "id": "726940401",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "How's it going? Have you collected any materials?",
            "nextDialogs": [
              "726940402"
            ]
          },
          "726940402": {
            "id": "726940402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They're all in the Collector.",
            "nextDialogs": [
              "726940403"
            ]
          },
          "726940403": {
            "id": "726940403",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Alright then, lemme add the materials to my One-of-a-Kind, Never-Failing...",
            "nextDialogs": [
              "726940404"
            ]
          },
          "726940404": {
            "id": "726940404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's \"The Great Machine.\"",
            "nextDialogs": [
              "726940405"
            ]
          },
          "726940405": {
            "id": "726940405",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Fine. Lemme add the materials to the Great Machine...",
            "nextDialogs": [
              "726940406"
            ]
          },
          "726940406": {
            "id": "726940406",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Bertrand connects the Collector to The Great Machine.",
            "nextDialogs": [
              "726940407"
            ]
          },
          "726940407": {
            "id": "726940407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! And what's next?",
            "nextDialogs": [
              "726940408"
            ]
          },
          "726940408": {
            "id": "726940408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Will the machine go \"chug chug chug\" and then spill out the toys with \"crackle and kaboom\"?",
            "nextDialogs": [
              "726940409"
            ]
          },
          "726940409": {
            "id": "726940409",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Hahaha, that is totally...",
            "nextDialogs": [
              "726940410"
            ]
          },
          "726940410": {
            "id": "726940410",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Impossible.",
            "nextDialogs": [
              "726940411"
            ]
          },
          "726940411": {
            "id": "726940411",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "What are you thinking? That's only the first step of the three processes. We're far from getting things done.",
            "nextDialogs": [
              "726940412"
            ]
          },
          "726940412": {
            "id": "726940412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon gets it, so we need to complete all the processes, huh?",
            "nextDialogs": [
              "726940413"
            ]
          },
          "726940413": {
            "id": "726940413",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Yep, we need all three processes in order to produce the toys.",
            "nextDialogs": [
              "726940416"
            ]
          },
          "726940416": {
            "id": "726940416",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Look at you, always wanting a quick fix. It takes patience to make toys. We must infuse every process with...",
            "nextDialogs": [
              "726940417"
            ]
          },
          "726940417": {
            "id": "726940417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "With what? Oh, Paimon gets it. It's toys we're making, after all, so we must infuse every process with real passion!",
            "nextDialogs": [
              "726940418"
            ]
          },
          "726940418": {
            "id": "726940418",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "Yep, my passion for Mora!",
            "nextDialogs": [
              "726940419"
            ]
          },
          "726940419": {
            "id": "726940419",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... Although that's not what Paimon was thinking, Paimon does share the sentiment!",
            "nextDialogs": [
              "726940420"
            ]
          },
          "726940420": {
            "id": "726940420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey...",
            "nextDialogs": [
              "726940421"
            ]
          },
          "726940421": {
            "id": "726940421",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon was just trying to make conversation.",
            "nextDialogs": [
              "726940422"
            ]
          },
          "726940422": {
            "id": "726940422",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then, Bertrand, what do we do next? Should we move on to the following processes?",
            "nextDialogs": [
              "726940423"
            ]
          },
          "726940423": {
            "id": "726940423",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "No worries. Since I've recently adjusted the machine, and this particular process hasn't been tested yet, I need to check if it works well with the materials.",
            "nextDialogs": [
              "726940424"
            ]
          },
          "726940424": {
            "id": "726940424",
            "speakerId": 12522,
            "speakerName": "Bertrand",
            "text": "This requires some time. Please come back later."
          }
        }
      }
    }
  ]
}
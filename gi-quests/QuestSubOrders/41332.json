    {
      "subId": "4133202",
      "subQuestName": "Speak to Chef Mao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320201"
        ],
        "dialogs": {
          "413320201": {
            "id": "413320201",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "How many more dishes was that again...",
            "nextDialogs": [
              "413320202"
            ]
          },
          "413320202": {
            "id": "413320202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "413320203"
            ]
          },
          "413320203": {
            "id": "413320203",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "What am I doing? Why, I'm running Wanmin Restaurant, of course! Haha.",
            "nextDialogs": [
              "413320204"
            ]
          },
          "413320204": {
            "id": "413320204",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Things have been getting busy with everyone going out to eat during the Lantern Rite. Even travelers from faraway lands have come to visit and join the festivities.",
            "nextDialogs": [
              "413320205"
            ]
          },
          "413320205": {
            "id": "413320205",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Even though my dear Xiangling has returned to help, we're still struggling to keep our heads above water. As a matter of fact, she just went out on a delivery...",
            "nextDialogs": [
              "413320206"
            ]
          },
          "413320206": {
            "id": "413320206",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "While everyone else has been out hanging lanterns for the festival, we've been too busy to make a single lantern yet.",
            "nextDialogs": [
              "413320207"
            ]
          },
          "413320207": {
            "id": "413320207",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "If you don't mind, Traveler, could you lend us a hand?",
            "nextDialogs": [
              "413320208"
            ]
          },
          "413320208": {
            "id": "413320208",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Do you happen to know Atsuko? She's the girl from Inazuma down by the docks.",
            "nextDialogs": [
              "413320209"
            ]
          },
          "413320209": {
            "id": "413320209",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "We've prepared her order, so could you please go deliver the food to her? I've even made her extra large portions to celebrate the festival.",
            "nextDialogs": [
              "413320210"
            ]
          },
          "413320210": {
            "id": "413320210",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "There's also the others who work down by the docks... <color=#00E1FFFF>Wrench Wang, Hammer Li, Guanhai, and Zhihua</color>.",
            "nextDialogs": [
              "413320211"
            ]
          },
          "413320211": {
            "id": "413320211",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "They're regular patrons here and always look after our business. They seem to still be busy with work down by the docks, even though it's time for the festival.",
            "nextDialogs": [
              "413320212"
            ]
          },
          "413320212": {
            "id": "413320212",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "I would like to prepare some food to give them, but I'm afraid that we're simply too busy and won't have the chance to leave the restaurant...",
            "nextDialogs": [
              "413320213"
            ]
          },
          "413320213": {
            "id": "413320213",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "If you could, Traveler, please help me ask them what they would like to eat, and I'll whip up whatever they request.",
            "nextDialogs": [
              "413320214"
            ]
          },
          "413320214": {
            "id": "413320214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "413320215"
            ]
          },
          "413320215": {
            "id": "413320215",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Thanks a lot, Traveler. Just come back here and let me know once you've asked them."
          }
        }
      }
    },
    {
      "subId": "4133203",
      "subQuestName": "Deliver the food to Atsuko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320301"
        ],
        "dialogs": {
          "413320301": {
            "id": "413320301",
            "speakerId": 2077,
            "speakerName": "Atsuko",
            "text": "I wonder why my order from Wanmin Restaurant hasn't arrived yet...",
            "nextDialogs": [
              "413320302"
            ]
          },
          "413320302": {
            "id": "413320302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's your order. Enjoy!",
            "nextDialogs": [
              "413320303"
            ]
          },
          "413320303": {
            "id": "413320303",
            "speakerId": 2077,
            "speakerName": "Atsuko",
            "text": "Oh, thank you so much! I'd thought that it would still take a while longer before it arrived.",
            "nextDialogs": [
              "413320304"
            ]
          },
          "413320304": {
            "id": "413320304",
            "speakerId": 2077,
            "speakerName": "Atsuko",
            "text": "All the festivities for Lantern Rite have been making me feel a little homesick... But I certainly won't be returning to Inazuma any time soon.",
            "nextDialogs": [
              "413320305"
            ]
          },
          "413320305": {
            "id": "413320305",
            "speakerId": 2077,
            "speakerName": "Atsuko",
            "text": "I wonder how things are back in Inazuma..."
          }
        }
      }
    },
    {
      "subId": "4133204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320401"
        ],
        "dialogs": {
          "413320401": {
            "id": "413320401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, this dish is best while it's hot."
          }
        }
      }
    },
    {
      "subId": "4133208",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320621"
        ],
        "dialogs": {
          "413320621": {
            "id": "413320621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Black-Back Perch Stew</color>.",
            "nextDialogs": [
              "413320622"
            ]
          },
          "413320622": {
            "id": "413320622",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "Ah yes, Wanmin Restaurant's signature dish. I've eaten it many times already, and it doesn't have that sweet and sour taste I'm hankering after... I think I'd prefer something else."
          }
        }
      }
    },
    {
      "subId": "4133209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320631"
        ],
        "dialogs": {
          "413320631": {
            "id": "413320631",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Crystal Shrimp</color>.",
            "nextDialogs": [
              "413320632"
            ]
          },
          "413320632": {
            "id": "413320632",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "Hmm, there's no fish in that dish, is there? Besides, the flavor's too bland, I think I'd prefer something else."
          }
        }
      }
    },
    {
      "subId": "4133210",
      "subQuestName": "Ask about everyone's tastes (0/3)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320651"
        ],
        "dialogs": {
          "413320651": {
            "id": "413320651",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Squirrel Fish</color>.",
            "nextDialogs": [
              "413320652"
            ]
          },
          "413320652": {
            "id": "413320652",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "Oh right, that's the one! How could I forget Squirrel Fish!?",
            "nextDialogs": [
              "413320653"
            ]
          },
          "413320653": {
            "id": "413320653",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "Sweet and sour flavor with a crispy texture. I'm getting hungry just thinking about it. I can't wait to taste more of Chef Mao's cuisine."
          }
        }
      }
    },
    {
      "subId": "4133211",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320731"
        ],
        "dialogs": {
          "413320731": {
            "id": "413320731",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Tianshu Meat</color>.",
            "nextDialogs": [
              "413320732"
            ]
          },
          "413320732": {
            "id": "413320732",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "That dish is a little too oily..."
          }
        }
      }
    },
    {
      "subId": "4133212",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320721"
        ],
        "dialogs": {
          "413320721": {
            "id": "413320721",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Grilled Tiger Fish</color>.",
            "nextDialogs": [
              "413320722"
            ]
          },
          "413320722": {
            "id": "413320722",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "Grilled Tiger Fish is good and all... But the flavor is a little too strong for me and I'll smell like grilled fish for the rest of the day..."
          }
        }
      }
    },
    {
      "subId": "4133213",
      "subQuestName": "Ask about everyone's tastes (1/3)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320751"
        ],
        "dialogs": {
          "413320751": {
            "id": "413320751",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Lotus Flower Crisp</color>.",
            "nextDialogs": [
              "413320752"
            ]
          },
          "413320752": {
            "id": "413320752",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "Mm, that sounds good. It's nice and light and tastes great. That'll be perfect...",
            "nextDialogs": [
              "413320753"
            ]
          },
          "413320753": {
            "id": "413320753",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "Alright, put me down for Lotus Flower Crisp, please."
          }
        }
      }
    },
    {
      "subId": "4133205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320521"
        ],
        "dialogs": {
          "413320521": {
            "id": "413320521",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Triple-Layered Consommé</color>.",
            "nextDialogs": [
              "413320522"
            ]
          },
          "413320522": {
            "id": "413320522",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "I've heard storytellers say that it takes only one bite to finish all the soup of Triple-Layered Consommé. How 'bout something else?",
            "nextDialogs": [
              "413320523"
            ]
          },
          "413320523": {
            "id": "413320523",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "When have you ever gone to listen to stories? And why didn't you bring me along?"
          }
        }
      }
    },
    {
      "subId": "4133206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320531"
        ],
        "dialogs": {
          "413320531": {
            "id": "413320531",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Come and Get It</color>.",
            "nextDialogs": [
              "413320532"
            ]
          },
          "413320532": {
            "id": "413320532",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "I've heard storytellers say that Come and Get It is an exquisite dish, but there's no bamboo shoots. How 'bout something else?",
            "nextDialogs": [
              "413320533"
            ]
          },
          "413320533": {
            "id": "413320533",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Since when do storytellers ever talk about recipes? I've never heard them do that before..."
          }
        }
      }
    },
    {
      "subId": "4133207",
      "subQuestName": "Ask about everyone's tastes (2/3)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320551"
        ],
        "dialogs": {
          "413320551": {
            "id": "413320551",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I recommend <color=#00E1FFFF>Bamboo Shoot Soup</color>.",
            "nextDialogs": [
              "413320552"
            ]
          },
          "413320552": {
            "id": "413320552",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "That's a good one! I've heard a storyteller describe it once as a dish that's \"simmered to perfection over a low flame, with a distinctive savory taste.\"",
            "nextDialogs": [
              "413320553"
            ]
          },
          "413320553": {
            "id": "413320553",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Sounds pretty good to me, let's get that one then."
          }
        }
      }
    },
    {
      "subId": "4133214",
      "subQuestName": "Report back to Chef Mao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413321401"
        ],
        "dialogs": {
          "413321401": {
            "id": "413321401",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Did you deliver the food?",
            "nextDialogs": [
              "413321402"
            ]
          },
          "413321402": {
            "id": "413321402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, we did.",
            "nextDialogs": [
              "413321403"
            ]
          },
          "413321403": {
            "id": "413321403",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Great, I knew that I could count on you! Did you also happen to ask Wrench Wang, Guanhai, and Zhihua what they would like to eat?",
            "nextDialogs": [
              "413321404"
            ]
          },
          "413321404": {
            "id": "413321404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wrench Wang and Hammer Li would like to have Bamboo Shoot Soup.",
            "nextDialogs": [
              "413321405"
            ]
          },
          "413321405": {
            "id": "413321405",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Oh? These two have rather similar tastes, though Bamboo Shoot Soup will take some time to make. I'll have to start preparing it early.",
            "nextDialogs": [
              "413321407"
            ]
          },
          "413321407": {
            "id": "413321407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Guanhai would like to have Squirrel Fish.",
            "nextDialogs": [
              "413321408"
            ]
          },
          "413321408": {
            "id": "413321408",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "No problem, that dish is one of my specialties.",
            "nextDialogs": [
              "413321409"
            ]
          },
          "413321409": {
            "id": "413321409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Zhihua would like to have Lotus Flower Crisp.",
            "nextDialogs": [
              "413321410"
            ]
          },
          "413321410": {
            "id": "413321410",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Huh, I never would have guessed that Zhihua would have a liking for pastries and the like. Making Lotus Flower Crisp is straightforward enough, no problem.",
            "nextDialogs": [
              "413321411"
            ]
          },
          "413321411": {
            "id": "413321411",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Thanks for going and asking them what they'd like to eat. Here, take this as a token of my appreciation. Now, I should get started on all those dishes.",
            "nextDialogs": [
              "413321412"
            ]
          },
          "413321412": {
            "id": "413321412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Won't you be hanging any Xiao Lanterns?",
            "nextDialogs": [
              "413321413"
            ]
          },
          "413321413": {
            "id": "413321413",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Hah! We don't have time for that now, I've got more dishes to make and Xiangling has just gone out on another delivery...",
            "nextDialogs": [
              "413321414"
            ]
          },
          "413321414": {
            "id": "413321414",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "The two of us can barely keep up with the orders as it is. There's no way we'd have any time for hanging lanterns.",
            "nextDialogs": [
              "413321417"
            ]
          },
          "413321417": {
            "id": "413321417",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Y—You'd really do that? I'll leave the lantern to you then. I was just starting to worry that the restaurant doesn't look festive enough without any lanterns."
          }
        }
      }
    },
    {
      "subId": "4133215",
      "subQuestName": "Give the Xiao Lantern to Chef Mao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4133216",
      "subQuestName": "Speak to Chef Mao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413321601"
        ],
        "dialogs": {
          "413321601": {
            "id": "413321601",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "This Xiao Lantern looks great! I'll be sure to write a wish on it shortly. Once Xiangling gets back, we can release the lantern together as father and daughter.",
            "nextDialogs": [
              "413321602"
            ]
          },
          "413321602": {
            "id": "413321602",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Thanks for your help, Traveler. Here, take these as a token of my appreciation."
          }
        }
      }
    },
    {
      "subId": "4133205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320511"
        ],
        "dialogs": {
          "413320511": {
            "id": "413320511",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "I'll never finish all this work...",
            "nextDialogs": [
              "413320512"
            ]
          },
          "413320512": {
            "id": "413320512",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Let's finish this up so we can finally have a rest and enjoy the festival...",
            "nextDialogs": [
              "413320513"
            ]
          },
          "413320513": {
            "id": "413320513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Chef Mao would like to treat you to a meal...",
            "nextDialogs": [
              "413320514"
            ]
          },
          "413320514": {
            "id": "413320514",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Huh? Oh, I remember Chef Mao did say something about treating us to a meal during Lantern Rite. I guess he was serious, hahaha!",
            "nextDialogs": [
              "413320515"
            ]
          },
          "413320515": {
            "id": "413320515",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "This is too good to be true! Please give Chef Mao my thanks...",
            "nextDialogs": [
              "413320516"
            ]
          },
          "413320516": {
            "id": "413320516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So what would you like to eat?",
            "nextDialogs": [
              "413320517"
            ]
          },
          "413320517": {
            "id": "413320517",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "I'm not going to ask for too much, I'd be more than satisfied with just a sumptuous bowl of <color=#00E1FFFF>hot soup</color> and some <color=#00E1FFFF>crisp bamboo shoots</color>.",
            "nextDialogs": [
              "413320518"
            ]
          },
          "413320518": {
            "id": "413320518",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "I'm not picky, <color=#00E1FFFF>anything with meat is good enough for me</color>. I'm not one for fine dining, so what do you suggest?",
            "nextDialogs": [
              "413320541"
            ]
          },
          "413320541": {
            "id": "413320541",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Hmm, so that won't be any good. What else can you recommend?"
          }
        }
      }
    },
    {
      "subId": "4133206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320611"
        ],
        "dialogs": {
          "413320611": {
            "id": "413320611",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "*sigh* Here I am working while everyone else is out enjoying the festival...",
            "nextDialogs": [
              "413320612"
            ]
          },
          "413320612": {
            "id": "413320612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Chef Mao would like to treat you to a meal...",
            "nextDialogs": [
              "413320613"
            ]
          },
          "413320613": {
            "id": "413320613",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "Chef Mao would like to treat me to a meal? Hmm, it would be nice to kick back with a good meal and enjoy the festivities.",
            "nextDialogs": [
              "413320614"
            ]
          },
          "413320614": {
            "id": "413320614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So what would you like to eat?",
            "nextDialogs": [
              "413320615"
            ]
          },
          "413320615": {
            "id": "413320615",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "I really love the taste of <color=#00E1FFFF>fish</color>. It would be great if it was <color=#00E1FFFF>fish</color> paired with some special flavor — say, <color=#00E1FFFF>sweet-and-sour</color>, perhaps...",
            "nextDialogs": [
              "413320616"
            ]
          },
          "413320616": {
            "id": "413320616",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "I can't think of anything special off the top of my head. What would you recommend?",
            "nextDialogs": [
              "413320641"
            ]
          },
          "413320641": {
            "id": "413320641",
            "speakerId": 2036,
            "speakerName": "Guanhai",
            "text": "Hmm, can you recommend something else?"
          }
        }
      }
    },
    {
      "subId": "4133207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413320711"
        ],
        "dialogs": {
          "413320711": {
            "id": "413320711",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "As soon as I'm finished with work, I'll go release Xiao Lanterns with Qiming...",
            "nextDialogs": [
              "413320712"
            ]
          },
          "413320712": {
            "id": "413320712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Chef Mao would like to treat you to a meal...",
            "nextDialogs": [
              "413320713"
            ]
          },
          "413320713": {
            "id": "413320713",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "You say Chef Mao wants to treat me? That's great!",
            "nextDialogs": [
              "413320714"
            ]
          },
          "413320714": {
            "id": "413320714",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So what would you like to eat?",
            "nextDialogs": [
              "413320715"
            ]
          },
          "413320715": {
            "id": "413320715",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "But I'm planning to invite Qiming to release Xiao Lanterns later, so I'd prefer <color=#00E1FFFF>something without fish or meat</color>, and <color=#00E1FFFF>something without a strong flavor</color>...",
            "nextDialogs": [
              "413320716"
            ]
          },
          "413320716": {
            "id": "413320716",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "Maybe something like <color=#00E1FFFF>a light pastry</color> would be best?",
            "nextDialogs": [
              "413320717"
            ]
          },
          "413320717": {
            "id": "413320717",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "Do you have any recommendations?",
            "nextDialogs": [
              "413320741"
            ]
          },
          "413320741": {
            "id": "413320741",
            "speakerId": 2001,
            "speakerName": "Zhihua",
            "text": "How about something else... Do you have any other recommendations?"
          }
        }
      }
    },

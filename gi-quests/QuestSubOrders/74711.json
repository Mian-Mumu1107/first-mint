  "subQuests": [
    {
      "subId": "7471101",
      "subQuestName": "Talk to Sigewinne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747110101"
        ],
        "dialogs": {
          "747110101": {
            "id": "747110101",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "Aha! Everything's going smoothly...",
            "nextDialogs": [
              "747110102"
            ]
          },
          "747110102": {
            "id": "747110102",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "I'm convinced that our search for a cure is entering its final stages.",
            "nextDialogs": [
              "747110103"
            ]
          },
          "747110103": {
            "id": "747110103",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "But besides finding a few more aquatic patients to complete the list, I have another, more particular request...",
            "nextDialogs": [
              "747110104"
            ]
          },
          "747110104": {
            "id": "747110104",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "I need you to locate some key underwater mechanisms in the affected waters and retrieve the data recorded by their sensors...",
            "nextDialogs": [
              "747110107"
            ]
          },
          "747110107": {
            "id": "747110107",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "Exactly!",
            "nextDialogs": [
              "747110108"
            ]
          },
          "747110108": {
            "id": "747110108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We should also talk to the boat owners and divers to make sure they've learned their lessons!",
            "nextDialogs": [
              "747110109"
            ]
          },
          "747110109": {
            "id": "747110109",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "That's right, not to mention the fishermen and the tourists... Anyone who takes a boat out on the surface, and those who dive beneath it...",
            "nextDialogs": [
              "747110110"
            ]
          },
          "747110110": {
            "id": "747110110",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "Everyone who interacts with our waters needs to be mindful. They can't just dump things in the sea and go around destroying marine habitats.",
            "nextDialogs": [
              "747110111"
            ]
          },
          "747110111": {
            "id": "747110111",
            "speakerId": 1000,
            "speakerName": "Sigewinne",
            "text": "Otherwise, some very aggressive fish might come along and capsize their boats!"
          }
        }
      }
    }
  ]
}
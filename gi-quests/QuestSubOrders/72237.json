  "subQuests": [
    {
      "subId": "7223702",
      "subQuestName": "Talk to the afterimage in prison",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722370101"
        ],
        "dialogs": {
          "722370101": {
            "id": "722370101",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Are you the Jibashiri they've sent to release us?",
            "nextDialogs": [
              "722370102"
            ]
          },
          "722370102": {
            "id": "722370102",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Nah, you're too young, must be an apprentice or something.",
            "nextDialogs": [
              "722370103"
            ]
          },
          "722370103": {
            "id": "722370103",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Pfah, but you know what? I'm not shocked. I'll bet those high-and-mighty Jibashiri couldn't stand the loss of face from accusing three innocent people, so they sent some youngster down to do their dirty work and apologize in their stead. Isn't that right?",
            "nextDialogs": [
              "722370104"
            ]
          },
          "722370104": {
            "id": "722370104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you the people who've been suspected of stealing \"Before Sun and Moon\"?",
            "nextDialogs": [
              "722370105"
            ]
          },
          "722370105": {
            "id": "722370105",
            "speakerId": 20478,
            "speakerName": "Oogura",
            "text": "What \"suspect\"? The name's Oogura, and we were falsely accused, alright?",
            "nextDialogs": [
              "722370106"
            ]
          },
          "722370106": {
            "id": "722370106",
            "speakerId": 20478,
            "speakerName": "Oogura",
            "text": "But never mind that. You're not here to let us out, are you? Well, if not that, I suppose you're after that guy?",
            "nextDialogs": [
              "722370107"
            ]
          },
          "722370107": {
            "id": "722370107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"That guy\"?",
            "nextDialogs": [
              "722370108"
            ]
          },
          "722370108": {
            "id": "722370108",
            "speakerId": 20478,
            "speakerName": "Oogura",
            "text": "The third guy! I don't know him well, but the fellow next to me does — just a bit, but it counts! Go on, ask him.",
            "nextDialogs": [
              "722370109"
            ]
          },
          "722370109": {
            "id": "722370109",
            "speakerId": 20478,
            "speakerName": "Oogura",
            "text": "The guy who escaped is a rather fierce character. But I can guarantee that he, like the two of us here, is innocent.",
            "nextDialogs": [
              "722370110"
            ]
          },
          "722370110": {
            "id": "722370110",
            "speakerId": 20478,
            "speakerName": "Oogura",
            "text": "I mean, come on, it's Enkanomiya's last day. Let's not endanger human lives now, shall we?"
          }
        }
      }
    },
    {
      "subId": "7223703",
      "subQuestName": "Talk to the afterimage in prison",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722370201"
        ],
        "dialogs": {
          "722370201": {
            "id": "722370201",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Forget the book, forget whether we were falsely accused or not. Go find Antei!",
            "nextDialogs": [
              "722370202"
            ]
          },
          "722370202": {
            "id": "722370202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Antei?",
            "nextDialogs": [
              "722370203"
            ]
          },
          "722370203": {
            "id": "722370203",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "Yes, he's the third guy who was locked up together with us. I'm Ooshima, and as for that guy, his name's Antigonus, or Antei, if you want the Narukami Island-ized version.",
            "nextDialogs": [
              "722370204"
            ]
          },
          "722370204": {
            "id": "722370204",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "He was an apprentice Jibashiri as well. Fierce temper, and super strong to boot. He escaped by grabbing the tiny bumps in the cliff and climbing right out of here.",
            "nextDialogs": [
              "722370205"
            ]
          },
          "722370205": {
            "id": "722370205",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "That's just horrifying. Is that even possible for normal people?",
            "nextDialogs": [
              "722370206"
            ]
          },
          "722370206": {
            "id": "722370206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, I can do that too.",
            "nextDialogs": [
              "722370207"
            ]
          },
          "722370207": {
            "id": "722370207",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "Ugh, forget it. You people who volunteer to become Jibashiri, I bet you've trained so hard that you've ceased to be human anymore.",
            "nextDialogs": [
              "722370208"
            ]
          },
          "722370208": {
            "id": "722370208",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "I've heard that the test to become a Jibashiri involves the candidate lifting one foot with both hands and standing in a circle.",
            "nextDialogs": [
              "722370209"
            ]
          },
          "722370209": {
            "id": "722370209",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "Then they get 12 other Jibashiri to stab at them with spears, and if they can go an entire night without being injured, they pass.",
            "nextDialogs": [
              "722370210"
            ]
          },
          "722370210": {
            "id": "722370210",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "I mean, you're a Jibashiri candidate. Is that rumor true?",
            "nextDialogs": [
              "722370211"
            ]
          },
          "722370211": {
            "id": "722370211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not as far as I know...",
            "nextDialogs": [
              "722370212"
            ]
          },
          "722370212": {
            "id": "722370212",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "Seriously? Are you telling me that it's even worse?",
            "nextDialogs": [
              "722370213"
            ]
          },
          "722370213": {
            "id": "722370213",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "C'mon, tell me!",
            "nextDialogs": [
              "722370214"
            ]
          },
          "722370214": {
            "id": "722370214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't the issue with Antei more important?",
            "nextDialogs": [
              "722370215"
            ]
          },
          "722370215": {
            "id": "722370215",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "Oh... Right. Yeah. *cough*",
            "nextDialogs": [
              "722370216"
            ]
          },
          "722370216": {
            "id": "722370216",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "He said that he would leave us a picture of a \"byrde\" as a sign to mark his path.",
            "nextDialogs": [
              "722370217"
            ]
          },
          "722370217": {
            "id": "722370217",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "It's an animal you can't find here in Enkanomiya. It can fly, it has wings, and it symbolizes freedom. Or something.",
            "nextDialogs": [
              "722370218"
            ]
          },
          "722370218": {
            "id": "722370218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Isn't that a \"bird\"?",
            "nextDialogs": [
              "722370219"
            ]
          },
          "722370219": {
            "id": "722370219",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "Right. That's right. \"Bird.\"",
            "nextDialogs": [
              "722370220"
            ]
          },
          "722370220": {
            "id": "722370220",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "He told me his plan was to climb up, retrieve a set of official-issue exploration gear that he'd hidden there beforehand, and then set off in the direction of the Serpent's Heart. Said he was following some leads about a delegation from Khaenri'ah.",
            "nextDialogs": [
              "722370221"
            ]
          },
          "722370221": {
            "id": "722370221",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "He said that he'd prove our innocence, even if that was the last thing he did, and that if any officials or shrine maidens came to look for us, we should tell them that he was headed for the Serpent's Heart.",
            "nextDialogs": [
              "722370222"
            ]
          },
          "722370222": {
            "id": "722370222",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "So yeah, even if he doesn't make it, he'll leave a bird picture behind as a clue to lead people to the proof that we're innocent.",
            "nextDialogs": [
              "722370223"
            ]
          },
          "722370223": {
            "id": "722370223",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "As long as nothing goes wrong, you should be able to find him by following the bird pictures.",
            "nextDialogs": [
              "722370224"
            ]
          },
          "722370224": {
            "id": "722370224",
            "speakerId": 20479,
            "speakerName": "Ooshima",
            "text": "Our lives are at stake here, so please, go!"
          }
        }
      }
    },
    {
      "subId": "7223704",
      "subQuestName": "Look for Antei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722370401"
        ],
        "dialogs": {
          "722370401": {
            "id": "722370401",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "I once heard a Narukami Island envoy talk about this creature named a \"bird.\" It has wings and it can fly through the skies.",
            "nextDialogs": [
              "722370402"
            ]
          },
          "722370402": {
            "id": "722370402",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "That's just amazing, can you imagine it?",
            "nextDialogs": [
              "722370403"
            ]
          },
          "722370403": {
            "id": "722370403",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "Some people believe that they are messengers from the gods who carry word of human fates.",
            "nextDialogs": [
              "722370404"
            ]
          },
          "722370404": {
            "id": "722370404",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "And if some exiled person finally expires out in the wild, the very same creature will come to peck and consume their mortal flesh.",
            "nextDialogs": [
              "722370405"
            ]
          },
          "722370405": {
            "id": "722370405",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "These animals fascinate me, to be honest. If I should see the light of another day, I will definitely keep a bird."
          }
        }
      }
    },
    {
      "subId": "7223705",
      "subQuestName": "Talk to Antei's afterimage",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722370301"
        ],
        "dialogs": {
          "722370301": {
            "id": "722370301",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You two are...",
            "nextDialogs": [
              "722370302"
            ]
          },
          "722370302": {
            "id": "722370302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you Antei?",
            "nextDialogs": [
              "722370303"
            ]
          },
          "722370303": {
            "id": "722370303",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "That's right. That's me. I feel... a little strange...",
            "nextDialogs": [
              "722370304"
            ]
          },
          "722370304": {
            "id": "722370304",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "I remember chasing those scoundrels... ripping a core out and throwing it into a camp. Then after that, I got a little woozy from my own injuries... I was hurt pretty bad...",
            "nextDialogs": [
              "722370305"
            ]
          },
          "722370305": {
            "id": "722370305",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "But then I woke up, and then I met you, and now I feel fine. Tell me, am I going to die soon or something?",
            "nextDialogs": [
              "722370306"
            ]
          },
          "722370306": {
            "id": "722370306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "722370307"
            ]
          },
          "722370307": {
            "id": "722370307",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "...No, that's not important right now. Are you here to arrest me again? I've already proven my innocence.",
            "nextDialogs": [
              "722370308"
            ]
          },
          "722370308": {
            "id": "722370308",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "It was those people from Khaenri'ah. They were the ones who stole that library book. I was assigned as one of their bodyguards, sure, but there's no way I would have been in cahoots with them!",
            "nextDialogs": [
              "722370309"
            ]
          },
          "722370309": {
            "id": "722370309",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "I tracked their diplomatic team to this place and beat them all.",
            "nextDialogs": [
              "722370310"
            ]
          },
          "722370310": {
            "id": "722370310",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "But I spent a long time dealing with some giant mechanical creature they had with them. Finally, I was able to tear its core out, but I was wounded seriously in the process.",
            "nextDialogs": [
              "722370311"
            ]
          },
          "722370311": {
            "id": "722370311",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "The disabled machine crashed on top of the lost book. There's no way to retrieve it now.",
            "nextDialogs": [
              "722370312"
            ]
          },
          "722370312": {
            "id": "722370312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, Byakuyakoku's Jibashiri are pretty tough...",
            "nextDialogs": [
              "722370313"
            ]
          },
          "722370313": {
            "id": "722370313",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "Wait, you aren't Jibashiri or candidates yourselves? *sigh* Whatever. The Jibashiri started out as heroes who fought against the Bathysmal Vishaps. It was only later that they became law enforcement — the judges of the nether.",
            "nextDialogs": [
              "722370314"
            ]
          },
          "722370314": {
            "id": "722370314",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "The machine's core is in the camp. Go there and have a look if you don't believe me."
          }
        }
      }
    },

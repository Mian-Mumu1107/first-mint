    {
      "subId": "7223708",
      "subQuestName": "Talk to Antei's afterimage",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722370501"
        ],
        "dialogs": {
          "722370501": {
            "id": "722370501",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "Did you get the book?",
            "nextDialogs": [
              "722370502"
            ]
          },
          "722370502": {
            "id": "722370502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We did. You're indeed innocent, Antei.",
            "nextDialogs": [
              "722370503"
            ]
          },
          "722370503": {
            "id": "722370503",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "From how you spoke earlier, you aren't Jibashiri... Which is a shame. You could've declared me innocent on the spot otherwise.",
            "nextDialogs": [
              "722370504"
            ]
          },
          "722370504": {
            "id": "722370504",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "That would have saved me some time.",
            "nextDialogs": [
              "722370505"
            ]
          },
          "722370505": {
            "id": "722370505",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "Again, I feel really energized, but I'm quite sure that I was exhausted from losing too much blood just a while ago. I just can't shake the feeling that I'm going to die shortly...",
            "nextDialogs": [
              "722370506"
            ]
          },
          "722370506": {
            "id": "722370506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh...",
            "nextDialogs": [
              "722370507"
            ]
          },
          "722370507": {
            "id": "722370507",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "*sigh* Let me ask you a question, stranger. Does a man sin who has been wrongly convicted by Byakuyakoku?",
            "nextDialogs": [
              "722370508"
            ]
          },
          "722370508": {
            "id": "722370508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "722370509"
            ]
          },
          "722370509": {
            "id": "722370509",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "If I, due to my disturbed state of mind, was left here by Tokoyo Ookami as a Sinshade. Is this transgression?",
            "nextDialogs": [
              "722370510"
            ]
          },
          "722370510": {
            "id": "722370510",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "Am I guilty?",
            "nextDialogs": [
              "722370511"
            ]
          },
          "722370511": {
            "id": "722370511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, you aren't.",
            "nextDialogs": [
              "722370512"
            ]
          },
          "722370512": {
            "id": "722370512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Be careful {NICKNAME}. If he realizes that... you know, then he's gonna disappear.",
            "nextDialogs": [
              "722370513"
            ]
          },
          "722370513": {
            "id": "722370513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're just an afterimage that Antei left behind.",
            "nextDialogs": [
              "722370514"
            ]
          },
          "722370514": {
            "id": "722370514",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "...",
            "nextDialogs": [
              "722370515"
            ]
          },
          "722370515": {
            "id": "722370515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You are innocent, and I will make sure the world knows that.",
            "nextDialogs": [
              "722370516"
            ]
          },
          "722370516": {
            "id": "722370516",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "Haha. So that's it? So, I'm just a shadow, left behind after my death.",
            "nextDialogs": [
              "722370517"
            ]
          },
          "722370517": {
            "id": "722370517",
            "speakerId": 20480,
            "speakerName": "Antei",
            "text": "And... I am innocent."
          }
        }
      }
    }
  ]
}
      "dialogue": {
        "startDialogs": [
          "190982301"
        ],
        "dialogs": {
          "190982301": {
            "id": "190982301",
            "speakerId": 1005,
            "speakerName": "Performance Bulletin",
            "text": "The Qabus Theatre is in town. Buy a drink and enjoy the performance for free!"
          }
        }
      }
    },
    {
      "subId": "1909899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190989901"
        ],
        "dialogs": {
          "190989901": {
            "id": "190989901",
            "speakerId": 1006,
            "speakerName": "Kaeya",
            "text": "There are worse ways to pass the time than watching a little outdoor theater... Too bad I already know the story.",
            "nextDialogs": [
              "190989902"
            ]
          },
          "190989902": {
            "id": "190989902",
            "speakerId": 1006,
            "speakerName": "Kaeya",
            "text": "#Having {NICKNAME} here will help to keep things interesting, though. And being close to where the action's happening is always exciting.",
            "nextDialogs": [
              "190989903"
            ]
          },
          "190989903": {
            "id": "190989903",
            "speakerId": 1006,
            "speakerName": "Kaeya",
            "text": "So must it be... Hahaha, yes, so must it be!",
            "nextDialogs": [
              "190989904"
            ]
          },
          "190989904": {
            "id": "190989904",
            "speakerId": 1006,
            "speakerName": "Kaeya",
            "text": "I always like to extricate myself before things start getting tedious.",
            "nextDialogs": [
              "190989905"
            ]
          },
          "190989905": {
            "id": "190989905",
            "speakerId": 1000,
            "speakerName": "Qabus",
            "text": "No matter how you look at it, life as an actor is more stable than life as a mercenary.",
            "nextDialogs": [
              "190989906"
            ]
          },
          "190989906": {
            "id": "190989906",
            "speakerId": 1001,
            "speakerName": "Gundafar",
            "text": "Good heavens, these lines are a bit much. Who talks like this in real life? Guess this is the wisdom of the Akademiya in action...",
            "nextDialogs": [
              "190989907"
            ]
          },
          "190989907": {
            "id": "190989907",
            "speakerId": 1004,
            "speakerName": "Nesmil",
            "text": "That outlander sure is easy on the eyes...",
            "nextDialogs": [
              "190989908"
            ]
          },
          "190989908": {
            "id": "190989908",
            "speakerId": 1007,
            "speakerName": "Roshana",
            "text": "Huh, so he's from Mondstadt? I could have sworn he was a desert-dweller...",
            "nextDialogs": [
              "190989909"
            ]
          },
          "190989909": {
            "id": "190989909",
            "speakerId": 1002,
            "speakerName": "Eymen",
            "text": "It's too bad that Darbil's troupe is always on the move. I wish they could stay here for longer.",
            "nextDialogs": [
              "190989910"
            ]
          },
          "190989910": {
            "id": "190989910",
            "speakerId": 1003,
            "speakerName": "Oguz",
            "text": "Can't tell if this counts as me slacking off during work... It's a gray area, for sure."
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "205030501": {
            "id": "205030501",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "What do you want?",
            "nextDialogs": [
              "205030504"
            ]
          },
          "205030504": {
            "id": "205030504",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "Oh. Yes. I'd forgotten about that.",
            "nextDialogs": [
              "205030505"
            ]
          },
          "205030505": {
            "id": "205030505",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "These are okay I guess. Should be able to salvage something from them.",
            "nextDialogs": [
              "205030506"
            ]
          },
          "205030506": {
            "id": "205030506",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "I'd like something made"
          }
        }
      }
    },
    {
      "subId": "2050306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205030601"
        ],
        "dialogs": {
          "205030601": {
            "id": "205030601",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "If you ever find ore in the future, you can always come and see me.",
            "nextDialogs": [
              "205030602"
            ]
          },
          "205030602": {
            "id": "205030602",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "Ideally when I'm not busy.",
            "nextDialogs": [
              "205030603"
            ]
          },
          "205030603": {
            "id": "205030603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You seem to be in a bad mood.",
            "nextDialogs": [
              "205030604"
            ]
          },
          "205030604": {
            "id": "205030604",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "A blacksmith's work takes focus and concentration. It does not take small talk with customers.",
            "nextDialogs": [
              "205030605"
            ]
          },
          "205030605": {
            "id": "205030605",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "When the craft is good, business is good. That's all there is to this trade, and anyone who tells you different is trying to con you.",
            "nextDialogs": [
              "205030606"
            ]
          },
          "205030606": {
            "id": "205030606",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "If there's nothing else, I'll carry on with my work."
          }
        }
      }
    }

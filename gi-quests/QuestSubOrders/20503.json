    {
      "subId": "2050302",
      "subQuestName": "Talk to Wagner the blacksmith",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205030201"
        ],
        "dialogs": {
          "205030201": {
            "id": "205030201",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "What?",
            "nextDialogs": [
              "205030203",
              "205030205"
            ]
          },
          "205030203": {
            "id": "205030203",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "Over there. Take your pick. Or, if you need something else I can make it on request.",
            "nextDialogs": [
              "205030207"
            ]
          },
          "205030207": {
            "id": "205030207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, he does bespoke weaponry...",
            "nextDialogs": [
              "205030208"
            ]
          },
          "205030208": {
            "id": "205030208",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "Of course. I sell weapons, make them to order, and do refinements. All in the job description for a blacksmith.",
            "nextDialogs": [
              "205030209"
            ]
          },
          "205030209": {
            "id": "205030209",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "All you need is the ore."
          },
          "205030205": {
            "id": "205030205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is the first Paimon's heard about it! What, so you want Paimon on the front line now!?",
            "nextDialogs": [
              "205030206"
            ]
          },
          "205030206": {
            "id": "205030206",
            "speakerId": 1417,
            "speakerName": "Wagner",
            "text": "She's a tiny one isn't she. It'd need to be purpose-built."
          }
        }
      }
    },

{
  "lineCounts": {
    "Grace": 29,
    "Player": 14,
    "Timmie": 15
  },
  "subQuests": [
    {
      "subId": "2006801",
      "subQuestName": "Talk to Grace",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680101"
        ],
        "dialogs": {
          "200680101": {
            "id": "200680101",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Ah, whatever shall I do...",
            "nextDialogs": [
              "200680102"
            ]
          },
          "200680102": {
            "id": "200680102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Um, what happened?",
            "nextDialogs": [
              "200680103"
            ]
          },
          "200680103": {
            "id": "200680103",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Oh, it's you. You've come at just the right moment. Timmie's told me what you did to the ducks.",
            "nextDialogs": [
              "200680104"
            ]
          },
          "200680104": {
            "id": "200680104",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "You... you... How should I say this? It's not as if I haven't heard of your deeds...",
            "nextDialogs": [
              "200680105"
            ]
          },
          "200680105": {
            "id": "200680105",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "But did you really have to use your courage and strength in that way?",
            "nextDialogs": [
              "200680109",
              "200680111",
              "200680112"
            ]
          },
          "200680109": {
            "id": "200680109",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "If you really were hungry, you could have done some honest work.",
            "nextDialogs": [
              "200680110"
            ]
          },
          "200680110": {
            "id": "200680110",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "With your capabilities, you'd definitely have a place at the Adventurers' Guild.",
            "nextDialogs": [
              "200680113"
            ]
          },
          "200680113": {
            "id": "200680113",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Ah, it's all water under the bridge at this point. But Timmie's been quite down because of this.",
            "nextDialogs": [
              "200680114"
            ]
          },
          "200680114": {
            "id": "200680114",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "I... Timmie's father once taught me how to make a certain dish. Mondstadt Hash Brown with Philanemo Mushrooms is Timmie's favorite.",
            "nextDialogs": [
              "200680115"
            ]
          },
          "200680115": {
            "id": "200680115",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Why don't you help me find three Philanemo Mushrooms, so we can make some for Timmie? That should perk him up a bit, and also serve by way of apology."
          },
          "200680111": {
            "id": "200680111",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "You accidentally hit those ducks and pigeons? Did you accidentally defeat the tough enemies you've encountered on your adventures too?"
          },
          "200680112": {
            "id": "200680112",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "You... I... Forget it. Looks like your \"strength\" really is all-rounded."
          }
        }
      }
    },
    {
      "subId": "2006802",
      "subQuestName": "Bring 3 Philanemo Mushrooms to Grace",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680201"
        ],
        "dialogs": {
          "200680201": {
            "id": "200680201",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Did you find any Philanemo Mushrooms? I believe that you should be able to find some under the eaves of the city's houses..."
          }
        }
      }
    },
    {
      "subId": "2006804",
      "subQuestName": "Wait for Grace to finish making Mondstadt Hash Brown",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680401"
        ],
        "dialogs": {
          "200680401": {
            "id": "200680401",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Thank you, these should be enough. Please wait a moment...",
            "nextDialogs": [
              "200680402"
            ]
          },
          "200680402": {
            "id": "200680402",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "This should be fine. Please give this Mondstadt Hash Brown to Timmie.",
            "nextDialogs": [
              "200680403"
            ]
          },
          "200680403": {
            "id": "200680403",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "And please, don't... do such things in the future. It's not worth the trouble.",
            "nextDialogs": [
              "200680404"
            ]
          },
          "200680404": {
            "id": "200680404",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Please listen to my advice. Don't disappoint Timmie... or me.",
            "nextDialogs": [
              "200680405"
            ]
          },
          "200680405": {
            "id": "200680405",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Well, if only everyone listened to advice. If that were the case, Sister Victoria wouldn't be so busy."
          }
        }
      }
    },
    {
      "subId": "2006803",
      "subQuestName": "Talk to Timmie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680301"
        ],
        "dialogs": {
          "200680301": {
            "id": "200680301",
            "speakerId": 1001,
            "speakerName": "Timmie",
            "text": "...Eat, eat. Eat and go, quickly...",
            "nextDialogs": [
              "200680305",
              "200680306",
              "200680307"
            ]
          },
          "200680305": {
            "id": "200680305",
            "speakerId": 1001,
            "speakerName": "Timmie",
            "text": "You again!",
            "nextDialogs": [
              "200680308"
            ]
          },
          "200680308": {
            "id": "200680308",
            "speakerId": 1001,
            "speakerName": "Timmie",
            "text": "What are you planning? Are you trying to hurt the ducks and the pigeons?"
          },
          "200680306": {
            "id": "200680306",
            "speakerId": 1001,
            "speakerName": "Timmie",
            "text": "You again? Leave me alone!"
          },
          "200680307": {
            "id": "200680307",
            "speakerId": 1001,
            "speakerName": "Timmie",
            "text": "How can you even ask me that?"
          }
        }
      }
    },
    {
      "subId": "2006805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680501"
        ],
        "dialogs": {
          "200680501": {
            "id": "200680501",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Please give that hash brown to Timmie.",
            "nextDialogs": [
              "200680503",
              "200680507"
            ]
          },
          "200680503": {
            "id": "200680503",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "It's me. I've been taking care of the children who need care for a while now.",
            "nextDialogs": [
              "200680504"
            ]
          },
          "200680504": {
            "id": "200680504",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Timmie's the one I've looked after longest. He's even come to call me Mommy.",
            "nextDialogs": [
              "200680505"
            ]
          },
          "200680505": {
            "id": "200680505",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "But in truth, I'm not his real family."
          },
          "200680507": {
            "id": "200680507",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "How can you even ask such a thing?",
            "nextDialogs": [
              "200680508"
            ]
          },
          "200680508": {
            "id": "200680508",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "That child hasn't got many friends or people he's close to in this city. So other than Nora and Glory, he only has the small animals to keep him company.",
            "nextDialogs": [
              "200680509"
            ]
          },
          "200680509": {
            "id": "200680509",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "In fact, those pigeons even...",
            "nextDialogs": [
              "200680510"
            ]
          },
          "200680510": {
            "id": "200680510",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "...No, never mind. Please give the hash brown to Timmie as soon as you can."
          }
        }
      }
    },
    {
      "subId": "2006806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200680601"
        ],
        "dialogs": {
          "200680601": {
            "id": "200680601",
            "speakerId": 1001,
            "speakerName": "Timmie",
            "text": "...Why isn't he back yet...",
            "nextDialogs": [
              "200680602"
            ]
          },
          "200680602": {
            "id": "200680602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey, Timmie...",
            "nextDialogs": [
              "200680603"
            ]
          },
          "200680603": {
            "id": "200680603",
            "speakerId": 1001,
            "speakerName": "Timmie",
            "text": "Why are you back again!? Go away! The pigeons and the ducks... You're scaring them off!"
          }
        }
      }
    }
  ]
}
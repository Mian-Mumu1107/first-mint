        "dialogs": {
          "721200201": {
            "id": "721200201",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Let's hope that everything goes smoothly. The sooner we settle this affair, the better. Who knows what we will happen if we delay further..."

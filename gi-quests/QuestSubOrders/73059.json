  "subQuests": [
    {
      "subId": "7305901",
      "subQuestName": "Reach the Mawtiyima Forest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730590101"
        ],
        "dialogs": {
          "730590101": {
            "id": "730590101",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "\"The pomegranate sings, the apples clap...\"",
            "nextDialogs": [
              "730590102"
            ]
          },
          "730590102": {
            "id": "730590102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello, Mr. Khayyam! What are you doing here?",
            "nextDialogs": [
              "730590103"
            ]
          },
          "730590103": {
            "id": "730590103",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "Oh, hello, hello. Child in white, and... *sigh* Apologies, my children. My memories are getting blurry, and names just fade after a while...",
            "nextDialogs": [
              "730590104"
            ]
          },
          "730590104": {
            "id": "730590104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Just call me {NICKNAME}.",
            "nextDialogs": [
              "730590105"
            ]
          },
          "730590105": {
            "id": "730590105",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "Haha... Okay, so you were the...",
            "nextDialogs": [
              "730590106"
            ]
          },
          "730590106": {
            "id": "730590106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes! We were the Javans - the brave young ones!",
            "nextDialogs": [
              "730590107"
            ]
          },
          "730590107": {
            "id": "730590107",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "Hmm... So, please tell me, do the Aranara still remember me? Do they remember us all?",
            "nextDialogs": [
              "730590108"
            ]
          },
          "730590108": {
            "id": "730590108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, uh...",
            "nextDialogs": [
              "730590110",
              "730590113"
            ]
          },
          "730590110": {
            "id": "730590110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "730590111"
            ]
          },
          "730590111": {
            "id": "730590111",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "I see... But I can't see them anymore, nor can I know how much they miss me... What a pity.",
            "nextDialogs": [
              "730590114"
            ]
          },
          "730590114": {
            "id": "730590114",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "Hehe... I can't see them anymore. I am too old to see their faces or hear their voices... Gone, it's all gone.",
            "nextDialogs": [
              "730590115"
            ]
          },
          "730590115": {
            "id": "730590115",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "*cough*... Apologies, I have to take my leave now. Perhaps a miracle is my only hope...",
            "nextDialogs": [
              "730590116"
            ]
          },
          "730590116": {
            "id": "730590116",
            "speakerId": 20744,
            "speakerName": "Khayyam",
            "text": "One cannot understand or chase after a miracle. The only thing one can do is wait.",
            "nextDialogs": [
              "730590117"
            ]
          },
          "730590117": {
            "id": "730590117",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Khayyam unsteadily walks away..."
          },
          "730590113": {
            "id": "730590113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... We can befriend them all over again!"
          }
        }
      }
    },

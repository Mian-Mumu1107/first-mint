    {
      "subId": "7305904",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730590401"
        ],
        "dialogs": {
          "730590401": {
            "id": "730590401",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Hi, Golden Nara and White Floaty.",
            "nextDialogs": [
              "730590402"
            ]
          },
          "730590402": {
            "id": "730590402",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Thank you. I can't remember the past, but trusty friends, you surely are."
          }
        }
      }
    },
    {
      "subId": "7305903",
      "subQuestName": "Talk to Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730590201"
        ],
        "dialogs": {
          "730590201": {
            "id": "730590201",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "#Aranaga, {M#he}{F#she}'s here, they're here!",
            "nextDialogs": [
              "730590202"
            ]
          },
          "730590202": {
            "id": "730590202",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Yeah, here, they're here!",
            "nextDialogs": [
              "730590203"
            ]
          },
          "730590203": {
            "id": "730590203",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "#Here you are, Nara {NICKNAME}, White Floaty. Welcome you, the three of us.",
            "nextDialogs": [
              "730590204"
            ]
          },
          "730590204": {
            "id": "730590204",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Here comes the moon. Now, is the time to plant flowers. Are you ready?",
            "nextDialogs": [
              "730590205"
            ]
          },
          "730590205": {
            "id": "730590205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I am ready.",
            "nextDialogs": [
              "730590206"
            ]
          },
          "730590206": {
            "id": "730590206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon too!",
            "nextDialogs": [
              "730590207"
            ]
          },
          "730590207": {
            "id": "730590207",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "So... Aranakin, Aragaru, let's start the ritual.",
            "nextDialogs": [
              "730590208"
            ]
          },
          "730590208": {
            "id": "730590208",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "\"Be back home, be back home, dreams of the garden, memories of the forest...\"",
            "nextDialogs": [
              "730590209"
            ]
          },
          "730590209": {
            "id": "730590209",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "\"Embrace, let us:\"",
            "nextDialogs": [
              "730590210"
            ]
          },
          "730590210": {
            "id": "730590210",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "\"Deeper dreams, everlasting happiness.\"",
            "nextDialogs": [
              "730590211"
            ]
          },
          "730590211": {
            "id": "730590211",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "\"Rejoice, let us:\"",
            "nextDialogs": [
              "730590212"
            ]
          },
          "730590212": {
            "id": "730590212",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "\"The pomegranate sings, the apples clap!\"",
            "nextDialogs": [
              "730590213"
            ]
          },
          "730590213": {
            "id": "730590213",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The Aranara plant the dried flowers. With the ballad echoing in the wind, the flowers come back to life magically...",
            "nextDialogs": [
              "730590214"
            ]
          },
          "730590214": {
            "id": "730590214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow... The three flowers are alive again!",
            "nextDialogs": [
              "730590215"
            ]
          },
          "730590215": {
            "id": "730590215",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Yes, because benevolent, Mawtiyima is. So, she gives memories a chance to resurrect.",
            "nextDialogs": [
              "730590216"
            ]
          },
          "730590216": {
            "id": "730590216",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Yeah! Even if we forget about you, the memories will... Hmm, be woven into the leaf veins and roots, turn into leaves, turn into tree rings!",
            "nextDialogs": [
              "730590217"
            ]
          },
          "730590217": {
            "id": "730590217",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Or turn into fatty worms, eaten by other worms. Other worms make things that nourish the plants, and make us grow!",
            "nextDialogs": [
              "730590218"
            ]
          },
          "730590218": {
            "id": "730590218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... You still can't recall anything about us, right?",
            "nextDialogs": [
              "730590219"
            ]
          },
          "730590219": {
            "id": "730590219",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Yes... Because, memories don't belong to you and me... The stories from the past, we have shared with all grass and trees in the forest...",
            "nextDialogs": [
              "730590220"
            ]
          },
          "730590220": {
            "id": "730590220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "730590221"
            ]
          },
          "730590221": {
            "id": "730590221",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "But it doesn't matter, because we are new friends now, right?",
            "nextDialogs": [
              "730590222"
            ]
          },
          "730590222": {
            "id": "730590222",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Yeah! New friends!"
          }
        }
      }
    },
    {

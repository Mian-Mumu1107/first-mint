  "subQuests": [
    {
      "subId": "45301",
      "subQuestName": "Talk to Draff",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4530101"
        ],
        "dialogs": {
          "4530101": {
            "id": "4530101",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Oh dear... This is awful, poor lad can't even stand.",
            "nextDialogs": [
              "4530102"
            ]
          },
          "4530102": {
            "id": "4530102",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "That's terrible!",
            "nextDialogs": [
              "4530103"
            ]
          },
          "4530103": {
            "id": "4530103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Except... he's not actually injured...",
            "nextDialogs": [
              "4530104"
            ]
          },
          "4530104": {
            "id": "4530104",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Right. It's awful, the wolves frightened him so badly that he's paralyzed with fear.",
            "nextDialogs": [
              "4530105"
            ]
          },
          "4530105": {
            "id": "4530105",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "That... really is awful.",
            "nextDialogs": [
              "4530106"
            ]
          },
          "4530106": {
            "id": "4530106",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Do you remember any significant details of what you saw?",
            "nextDialogs": [
              "4530107"
            ]
          },
          "4530107": {
            "id": "4530107",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "I—I've never seen a wolf in my life before today, it was terrifying...",
            "nextDialogs": [
              "4530108"
            ]
          },
          "4530108": {
            "id": "4530108",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "...No details then, huh?",
            "nextDialogs": [
              "4530109"
            ]
          },
          "4530109": {
            "id": "4530109",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Let's investigate the area again."
          }
        }
      }
    },
    {
      "subId": "45302",
      "subQuestName": "Investigate clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4530201"
        ],
        "dialogs": {
          "4530201": {
            "id": "4530201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "These claw marks... This was more than just a couple of wolves. And... No friggin' way, they must have been two meters high!"
          }
        }
      }
    },
    {
      "subId": "45307",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4530701"
        ],
        "dialogs": {
          "4530701": {
            "id": "4530701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "These claw marks...",
            "nextDialogs": [
              "4530702"
            ]
          },
          "4530702": {
            "id": "4530702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "From them, we can tell the number and size of the wolves.",
            "nextDialogs": [
              "4530703"
            ]
          },
          "4530703": {
            "id": "4530703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This time there were at least two wolves, and they must be...",
            "nextDialogs": [
              "4530704"
            ]
          },
          "4530704": {
            "id": "4530704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Be what?",
            "nextDialogs": [
              "4530705"
            ]
          },
          "4530705": {
            "id": "4530705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes, yes! They must be at least... two meters high!",
            "nextDialogs": [
              "4530706"
            ]
          },
          "4530706": {
            "id": "4530706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Paimon, you do know what a wolf is, right?",
            "nextDialogs": [
              "4530707"
            ]
          },
          "4530707": {
            "id": "4530707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Wolves are mysterious creatures, it's not like you see them every day."
          }
        }
      }
    },
    {
      "subId": "45303",
      "subQuestName": "Investigate clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "45308",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4530801"
        ],
        "dialogs": {
          "4530801": {
            "id": "4530801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is a wolf's tooth.",
            "nextDialogs": [
              "4530802"
            ]
          },
          "4530802": {
            "id": "4530802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He must have smashed into the door when he pounced.",
            "nextDialogs": [
              "4530803"
            ]
          },
          "4530803": {
            "id": "4530803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps it's calcium deficient.",
            "nextDialogs": [
              "4530804"
            ]
          },
          "4530804": {
            "id": "4530804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, seems pretty lucky how no one in the village got seriously injured."
          }
        }
      }
    },
    {
      "subId": "45304",
      "subQuestName": "Investigate clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "45305",
      "subQuestName": "Important clue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4530501"
        ],
        "dialogs": {
          "4530501": {
            "id": "4530501",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Wolf fur... I heard that in Liyue they make calligraphy brushes out of this stuff.",
            "nextDialogs": [
              "4530502"
            ]
          },
          "4530502": {
            "id": "4530502",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "The color looks nothing like Mondstadt wolf fur, based on what the books say. Could it be that they're from somewhere else entirely?",
            "nextDialogs": [
              "4530503"
            ]
          },
          "4530503": {
            "id": "4530503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hair looks different at every place on the body, same applies to wolves. You don't know where it's from...",
            "nextDialogs": [
              "4530504"
            ]
          },
          "4530504": {
            "id": "4530504",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "But look at this—",
            "nextDialogs": [
              "4530505"
            ]
          },
          "4530505": {
            "id": "4530505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Another hair. But what's that stuck to it?",
            "nextDialogs": [
              "4530508"
            ]
          },
          "4530508": {
            "id": "4530508",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "It's the seed of a Wolfhook berry. Look, there are little hooks on the seed.",
            "nextDialogs": [
              "4530509"
            ]
          },
          "4530509": {
            "id": "4530509",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "The only places this grows in Mondstadt are Wolvendom and Brightcrown Canyon.",
            "nextDialogs": [
              "4530510"
            ]
          },
          "4530510": {
            "id": "4530510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So it's Wolvendom wolves after all?",
            "nextDialogs": [
              "4530511"
            ]
          },
          "4530511": {
            "id": "4530511",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "From that area, yes, but it could be that there are other wolf packs encroaching on their territory.",
            "nextDialogs": [
              "4530512"
            ]
          },
          "4530512": {
            "id": "4530512",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "This doesn't tell us everything, but it does give us a strong lead. Enough to start investigating.",
            "nextDialogs": [
              "4530513"
            ]
          },
          "4530513": {
            "id": "4530513",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I'll go and see to the villagers before we head off."
          }
        }
      }
    },
    {
      "subId": "45306",
      "subQuestName": "Calm the Springvale villagers down",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4530601"
        ],
        "dialogs": {
          "4530601": {
            "id": "4530601",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "How is your investigation coming along?",
            "nextDialogs": [
              "4530602"
            ]
          },
          "4530602": {
            "id": "4530602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wha— You're standing!",
            "nextDialogs": [
              "4530603"
            ]
          },
          "4530603": {
            "id": "4530603",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "I have recovered, thankfully. I managed to claw my way back out of the depths of hell.",
            "nextDialogs": [
              "4530604"
            ]
          },
          "4530604": {
            "id": "4530604",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "So, Knights of Favonius — what have you found out?",
            "nextDialogs": [
              "4530605"
            ]
          },
          "4530605": {
            "id": "4530605",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "From inspecting wolf fur left at the scene, we can tell that the wolves came from Wolvendom. Beyond that, we don't know anything.",
            "nextDialogs": [
              "4530606"
            ]
          },
          "4530606": {
            "id": "4530606",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "But please remain calm. I will head to Wolvendom shortly and get to the bottom of this.",
            "nextDialogs": [
              "4530607"
            ]
          },
          "4530607": {
            "id": "4530607",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "The Knights of Favonius will not allow this danger to continue any longer.",
            "nextDialogs": [
              "4530608"
            ]
          },
          "4530608": {
            "id": "4530608",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "Good. Better late than never I suppose.",
            "nextDialogs": [
              "4530609"
            ]
          },
          "4530609": {
            "id": "4530609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How rude!",
            "nextDialogs": [
              "4530610"
            ]
          },
          "4530610": {
            "id": "4530610",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "In the meantime, we'll just have to keep dealing with this on our own.",
            "nextDialogs": [
              "4530611"
            ]
          },
          "4530611": {
            "id": "4530611",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Please, don't do anything stupid.",
            "nextDialogs": [
              "4530612"
            ]
          },
          "4530612": {
            "id": "4530612",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "Hah! We do things a bit differently around here, you lot from the order probably aren't used to it. They will pay for what they've done!",
            "nextDialogs": [
              "4530613"
            ]
          },
          "4530613": {
            "id": "4530613",
            "speakerId": 1543,
            "speakerName": "Hopkins the Marvelous",
            "text": "Goodbye!",
            "nextDialogs": [
              "4530614"
            ]
          },
          "4530614": {
            "id": "4530614",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "It's awful, it really is...",
            "nextDialogs": [
              "4530615"
            ]
          },
          "4530615": {
            "id": "4530615",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is?",
            "nextDialogs": [
              "4530616"
            ]
          },
          "4530616": {
            "id": "4530616",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Their future outlook, I mean.",
            "nextDialogs": [
              "4530617"
            ]
          },
          "4530617": {
            "id": "4530617",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I agree.",
            "nextDialogs": [
              "4530618"
            ]
          },
          "4530618": {
            "id": "4530618",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Young people can be so impulsive sometimes. If it's not too much to ask, I hope you can keep an eye on them, stop them from getting into trouble.",
            "nextDialogs": [
              "4530619"
            ]
          },
          "4530619": {
            "id": "4530619",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "It's no trouble — that's what we're here for. Even though that guy really isn't much of a charmer.",
            "nextDialogs": [
              "4530620"
            ]
          },
          "4530620": {
            "id": "4530620",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Leave it to us.",
            "nextDialogs": [
              "4530621"
            ]
          },
          "4530621": {
            "id": "4530621",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Off to Wolvendom we go!"
          }
        }
      }
    }
  ]
}
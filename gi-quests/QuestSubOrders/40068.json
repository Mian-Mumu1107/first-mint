    {
      "subId": "4006804",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400680401"
        ],
        "dialogs": {
          "400680401": {
            "id": "400680401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*cough* *cough* Paimon just got a mouthful of dirt...",
            "nextDialogs": [
              "400680402"
            ]
          },
          "400680402": {
            "id": "400680402",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Paimon, are you okay?",
            "nextDialogs": [
              "400680403"
            ]
          },
          "400680403": {
            "id": "400680403",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Just as we thought... we've been sent to another place.",
            "nextDialogs": [
              "400680404"
            ]
          },
          "400680404": {
            "id": "400680404",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Why does this place feel so bleak? ...Xinyan, are you sure this is your mirage?",
            "nextDialogs": [
              "400680405"
            ]
          },
          "400680405": {
            "id": "400680405",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "I think so, yeah, but... you're right, why is it so bleak here?",
            "nextDialogs": [
              "400680406"
            ]
          },
          "400680406": {
            "id": "400680406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look, there's something really bright over there. It's almost like it's inviting us to go check it out.",
            "nextDialogs": [
              "400680407"
            ]
          },
          "400680407": {
            "id": "400680407",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Okay, let's go have a look.",
            "nextDialogs": [
              "400680408"
            ]
          },
          "400680408": {
            "id": "400680408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, wait, wait! This is too obvious. Surely it's gotta be a trap?",
            "nextDialogs": [
              "400680409"
            ]
          },
          "400680409": {
            "id": "400680409",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "That may well be, but there's also nowhere else for us to go.",
            "nextDialogs": [
              "400680410"
            ]
          },
          "400680410": {
            "id": "400680410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Indeed...",
            "nextDialogs": [
              "400680411"
            ]
          },
          "400680411": {
            "id": "400680411",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "If this mirage belongs to Xinyan, I don't think we will find any traps there.",
            "nextDialogs": [
              "400680412"
            ]
          },
          "400680412": {
            "id": "400680412",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Now you're talking! You know that wouldn't be my style.",
            "nextDialogs": [
              "400680413"
            ]
          },
          "400680413": {
            "id": "400680413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, that makes sense. Alright, let's go then, but let's also make sure to be careful."
          }
        }
      }
    },
    {
      "subId": "4006805",
      "subQuestName": "Go to the brightly lit place",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400680501"
        ],
        "dialogs": {
          "400680501": {
            "id": "400680501",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "The door is locked.",
            "nextDialogs": [
              "400680503",
              "400680505"
            ]
          },
          "400680503": {
            "id": "400680503",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Keep your nonsense to yourself, thank you very much.",
            "nextDialogs": [
              "400680506"
            ]
          },
          "400680506": {
            "id": "400680506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Xinyan, why did you lock the door?",
            "nextDialogs": [
              "400680507"
            ]
          },
          "400680507": {
            "id": "400680507",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "You'd think I'd know this... Haha...",
            "nextDialogs": [
              "400680508"
            ]
          },
          "400680508": {
            "id": "400680508",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Oh, actually... I usually put my key under the flower pot next to the door. So... maybe the key is nearby.",
            "nextDialogs": [
              "400680509"
            ]
          },
          "400680509": {
            "id": "400680509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! Is there a flower pot around here?",
            "nextDialogs": [
              "400680510"
            ]
          },
          "400680510": {
            "id": "400680510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There are no pots, but there is... a flower.",
            "nextDialogs": [
              "400680511"
            ]
          },
          "400680511": {
            "id": "400680511",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "I guess it's worth a shot."
          },
          "400680505": {
            "id": "400680505",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "...Let's keep thinking this through."
          }
        }
      }
    },
    {
      "subId": "4006806",

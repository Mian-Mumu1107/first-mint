        "startDialogs": [
          "4890501"
        ],
        "dialogs": {
          "4890501": {
            "id": "4890501",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Is it ready? Let me see, let me seeee!",
            "nextDialogs": [
              "4890502"
            ]
          },
          "4890502": {
            "id": "4890502",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "This is a very good effort. I think you really captured the essence of what the dish is all about.",
            "nextDialogs": [
              "4890503"
            ]
          },
          "4890503": {
            "id": "4890503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are we released from kitchen duty now?",
            "nextDialogs": [
              "4890504"
            ]
          },
          "4890504": {
            "id": "4890504",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Yes, thanks ever so much for your help. Amber should be able to take care of everything else.",
            "nextDialogs": [
              "4890505"
            ]
          },
          "4890505": {
            "id": "4890505",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "If you ever get tired of being an adventurer, there'll be a job waiting for you at Good Hunter if you want it!"
          }
        }

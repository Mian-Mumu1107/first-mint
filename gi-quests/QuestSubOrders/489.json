  "subQuests": [
    {
      "subId": "48901",
      "subQuestName": "Find Sara and ask about her commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4890101"
        ],
        "dialogs": {
          "4890101": {
            "id": "4890101",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Got it. I'll set off right away!",
            "nextDialogs": [
              "4890102"
            ]
          },
          "4890102": {
            "id": "4890102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Amber! Are you here to help out with Jean's commission?",
            "nextDialogs": [
              "4890103"
            ]
          },
          "4890103": {
            "id": "4890103",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Oh, hi. Yeah, I was just getting ready. Who better than an Outrider to mop up some hilichurls on the delivery route?",
            "nextDialogs": [
              "4890104"
            ]
          },
          "4890104": {
            "id": "4890104",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "*sigh* ...",
            "nextDialogs": [
              "4890105"
            ]
          },
          "4890105": {
            "id": "4890105",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Sara... What are you still stressing about? I'm an Outrider, and I won't disappoint!",
            "nextDialogs": [
              "4890106"
            ]
          },
          "4890106": {
            "id": "4890106",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "You misunderstand me. I don't doubt your abilities, I'm just overwhelmed at the number of orders piling up in front of me.",
            "nextDialogs": [
              "4890107"
            ]
          },
          "4890107": {
            "id": "4890107",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Another bizarre order came in just now. It's like they're hosting a banquet or something...",
            "nextDialogs": [
              "4890108"
            ]
          },
          "4890108": {
            "id": "4890108",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "*clears throat*...",
            "nextDialogs": [
              "4890109"
            ]
          },
          "4890109": {
            "id": "4890109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything we can help with?",
            "nextDialogs": [
              "4890110"
            ]
          },
          "4890110": {
            "id": "4890110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can help with the cooking!",
            "nextDialogs": [
              "4890111"
            ]
          },
          "4890111": {
            "id": "4890111",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Really! You don't mind helping?",
            "nextDialogs": [
              "4890112"
            ]
          },
          "4890112": {
            "id": "4890112",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "That would be wonderful! You really are the Good Hunter's guardian angel.",
            "nextDialogs": [
              "4890113"
            ]
          },
          "4890113": {
            "id": "4890113",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Yeah well... Those hilichurls are going to be a handful, too.",
            "nextDialogs": [
              "4890114"
            ]
          },
          "4890114": {
            "id": "4890114",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Well, why don't you take this order. Start by getting the ingredients.",
            "nextDialogs": [
              "4890115"
            ]
          },
          "4890115": {
            "id": "4890115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Are you sure {NICKNAME} can be trusted? It might end up tasting a bit funky...",
            "nextDialogs": [
              "4890116"
            ]
          },
          "4890116": {
            "id": "4890116",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "We're well past the point of aiming for perfection. This is now a fight to save the Good Hunter's business.",
            "nextDialogs": [
              "4890117"
            ]
          },
          "4890117": {
            "id": "4890117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A fight?",
            "nextDialogs": [
              "4890118"
            ]
          },
          "4890118": {
            "id": "4890118",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "For this dish, we need... <color=#00E1FFFF>three Sweet Flowers and three Fowls</color>.",
            "nextDialogs": [
              "4890119"
            ]
          },
          "4890119": {
            "id": "4890119",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Okay, go and get ready. You too, Amber. I'll be waiting here.",
            "nextDialogs": [
              "4890120"
            ]
          },
          "4890120": {
            "id": "4890120",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "O—Okay..."
          }
        }
      }
    },
    {
      "subId": "48902",
      "subQuestName": "Collect 3 Sweet Flowers and 3 Fowl each",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4890201"
        ],
        "dialogs": {
          "4890201": {
            "id": "4890201",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "You're back — have you brought the ingredients? Let me see...",
            "nextDialogs": [
              "4890202"
            ]
          },
          "4890202": {
            "id": "4890202",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "...Yep. That's everything.",
            "nextDialogs": [
              "4890203"
            ]
          },
          "4890203": {
            "id": "4890203",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Now — order number seven is for one <color=#00E1FFFF>Sweet Madame</color>.",
            "nextDialogs": [
              "4890204"
            ]
          },
          "4890204": {
            "id": "4890204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And so begins the story of us becoming basic kitchen hands!",
            "nextDialogs": [
              "4890205"
            ]
          },
          "4890205": {
            "id": "4890205",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "You did say you'd help Good Hunter out — be sure to serve it while it's hot."
          }
        }
      }
    },

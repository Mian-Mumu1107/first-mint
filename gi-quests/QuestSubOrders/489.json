    {
      "subId": "48903",
      "subQuestName": "Cook Sweet Madame",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4890301"
        ],
        "dialogs": {
          "4890301": {
            "id": "4890301",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "One Sweet Madame, received!",
            "nextDialogs": [
              "4890302"
            ]
          },
          "4890302": {
            "id": "4890302",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Mmm, it smells... pretty good! You have a knack for this — just the person I need!",
            "nextDialogs": [
              "4890303"
            ]
          },
          "4890303": {
            "id": "4890303",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Hmm, since you cook so well... You might as well take this <color=#00E1FFFF>Sticky Honey Roast</color> next.",
            "nextDialogs": [
              "4890304"
            ]
          },
          "4890304": {
            "id": "4890304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "<color=#00E1FFFF>Sticky Honey Roast</color>! We tried that before, with Amber!",
            "nextDialogs": [
              "4890305"
            ]
          },
          "4890305": {
            "id": "4890305",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "That's right, a mainstay of the Good Hunter menu. It's my pride and joy!",
            "nextDialogs": [
              "4890306"
            ]
          },
          "4890306": {
            "id": "4890306",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "The Knights order it almost every time they come here for a gathering.",
            "nextDialogs": [
              "4890307"
            ]
          },
          "4890307": {
            "id": "4890307",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Let me teach you the recipe for a <color=#00E1FFFF>Sticky Honey Roast</color>...",
            "nextDialogs": [
              "4890308"
            ]
          },
          "4890308": {
            "id": "4890308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, didn't you say it's your pride and joy? You're going to teach us how to make it, just like that?",
            "nextDialogs": [
              "4890309"
            ]
          },
          "4890309": {
            "id": "4890309",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "With your cooking skills, I don't think you will be doing a disservice to the Good Hunter brand! Hee-hee.",
            "nextDialogs": [
              "4890310"
            ]
          },
          "4890310": {
            "id": "4890310",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "As soon as that <color=#00E1FFFF>Sticky Honey Roast</color> is ready, please bring it here."
          }
        }
      }
    },

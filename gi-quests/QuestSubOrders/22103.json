  },
  "subQuests": [
    {
      "subId": "2210301",
      "subQuestName": "Talk to Verr Goldet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221030101"
        ],
        "dialogs": {
          "221030101": {
            "id": "221030101",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "What a colossal nuisance...",
            "nextDialogs": [
              "221030102"
            ]
          },
          "221030102": {
            "id": "221030102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "221030103"
            ]
          },
          "221030103": {
            "id": "221030103",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Oh, is that one of our guests? My apologies, things have been awfully unusual around here lately...",
            "nextDialogs": [
              "221030104"
            ]
          },
          "221030104": {
            "id": "221030104",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Our guests keep getting attacked by monsters nearby. Naturally, many are now less inclined to stay here.",
            "nextDialogs": [
              "221030105"
            ]
          },
          "221030105": {
            "id": "221030105",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "If this pattern continues, things will eventually escalate out of control.",
            "nextDialogs": [
              "221030106"
            ]
          },
          "221030106": {
            "id": "221030106",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Judging by your attire, you are a traveler, correct? Would you mind taking care of this on the inn's behalf?",
            "nextDialogs": [
              "221030109",
              "221030110"
            ]
          },
          "221030109": {
            "id": "221030109",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Thank you. You're very kind.",
            "nextDialogs": [
              "221030113"
            ]
          },
          "221030113": {
            "id": "221030113",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "So it's better that you deal with it instead. I will be sure to arrange adequate compensation."
          },
          "221030110": {
            "id": "221030110",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Not very. In fact, they are the lesser of my concerns.",
            "nextDialogs": [
              "221030111"
            ]
          },
          "221030111": {
            "id": "221030111",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "The bigger issue is... if any of them was unfortunate enough to run into a certain young gentleman...",
            "nextDialogs": [
              "221030112"
            ]
          },
          "221030112": {
            "id": "221030112",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "His method of dealing with monsters tends not to consider the best interests of the surrounding area or the people in it..."
          }
        }
      }
    },
    {
      "subId": "2210302",
      "subQuestName": "Go and check the suspicious location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221030201"
        ],
        "dialogs": {
          "221030201": {
            "id": "221030201",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Is it done?",
            "nextDialogs": [
              "221030202"
            ]
          },
          "221030202": {
            "id": "221030202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "221030203"
            ]
          },
          "221030203": {
            "id": "221030203",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Time is of the essence here. The young gentleman tends to show up without warning and disappear without a trace. There's no telling when he'll be here next.",
            "nextDialogs": [
              "221030204"
            ]
          },
          "221030204": {
            "id": "221030204",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "And in the event he does show up, that'll be us out of business for a while."
          }
        }
      }
    },
    {
      "subId": "2210303",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221030301"
        ],
        "dialogs": {
          "221030301": {
            "id": "221030301",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Is it done?",
            "nextDialogs": [
              "221030302"
            ]
          },
          "221030302": {
            "id": "221030302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "221030303"
            ]
          },
          "221030303": {
            "id": "221030303",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Wonderful! Well, that's a load off my mind. Business as usual once again.",
            "nextDialogs": [
              "221030304"
            ]
          },
          "221030304": {
            "id": "221030304",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Here. Your compensation, as agreed.",
            "nextDialogs": [
              "221030305"
            ]
          },
          "221030305": {
            "id": "221030305",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Hmm? Oh, the young gentleman? I would have thought you'd seen him around.",
            "nextDialogs": [
              "221030306"
            ]
          },
          "221030306": {
            "id": "221030306",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "Perhaps you've noticed him resting on the roof of the inn? He does that occasionally.",
            "nextDialogs": [
              "221030307"
            ]
          },
          "221030307": {
            "id": "221030307",
            "speakerId": 1000,
            "speakerName": "Verr Goldet",
            "text": "But if you do notice him, try not to disturb him. He prefers to be left alone."
          }
        }
      }
    },
    {
      "subId": "2210304",
      "subQuestName": "Report back to Verr Goldet",
      "sceneId": null,
      "locations": [],

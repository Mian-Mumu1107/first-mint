      }
    },
    {
      "subId": "2103304",
      "subQuestName": "Talk to Lan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210330401"
        ],
        "dialogs": {
          "210330401": {
            "id": "210330401",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "How did it go, Traveler? Have you found something?",
            "nextDialogs": [
              "210330402"
            ]
          },
          "210330402": {
            "id": "210330402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found this sword hilt..."
          }
        }
      }
    },
    {
      "subId": "2103306",
      "subQuestName": "Talk to Lan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210330403"
        ],
        "dialogs": {
          "210330403": {
            "id": "210330403",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "This sword hilt... looks still intact.",
            "nextDialogs": [
              "210330404"
            ]
          },
          "210330404": {
            "id": "210330404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Does it have anything to do with the Unseen Razor?",
            "nextDialogs": [
              "210330405"
            ]
          },
          "210330405": {
            "id": "210330405",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I must examine it in detail to know... Ah. I forgot to mention that I've already been scouring the lands for these weapon fragments for quite some time.",
            "nextDialogs": [
              "210330406"
            ]
          },
          "210330406": {
            "id": "210330406",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I gathered countless pieces from the marketplace, the wilds, and even bought some off adventurers. I thought that they could perhaps lead me to the Unseen Razor...",
            "nextDialogs": [
              "210330407"
            ]
          },
          "210330407": {
            "id": "210330407",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Yet, till now, I haven't found even a hint of its shadow...",
            "nextDialogs": [
              "210330408"
            ]
          },
          "210330408": {
            "id": "210330408",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Ah, no matter. We have a saying in Liyue: \"Where there's a will, there's a way.\" I'll keep searching... Till I find the Unseen Razor, that is.",
            "nextDialogs": [
              "210330409"
            ]
          },
          "210330409": {
            "id": "210330409",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Here, Traveler. Take these as a reward for your efforts."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2103301",
      "subQuestName": "Talk to Lan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210330101"
        ],
        "dialogs": {
          "210330101": {
            "id": "210330101",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I have an idea that may or may not pay dividends...",
            "nextDialogs": [
              "210330102"
            ]
          },
          "210330102": {
            "id": "210330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you still looking for that sword of yours?",
            "nextDialogs": [
              "210330103"
            ]
          },
          "210330103": {
            "id": "210330103",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Oh, it's you, Traveler. Indeed, I am still seeking the Unseen Razor.",
            "nextDialogs": [
              "210330104"
            ]
          },
          "210330104": {
            "id": "210330104",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "But, even now, I have yet to find any worthwhile leads.",
            "nextDialogs": [
              "210330105"
            ]
          },
          "210330105": {
            "id": "210330105",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Searching for a sword in Liyue is like trying to find a straw from a haystack.",
            "nextDialogs": [
              "210330106"
            ]
          },
          "210330106": {
            "id": "210330106",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Someone said to me that the sword may have been destroyed long ago by a monster. But even if it were so, I would find and claim each and every last shard.",
            "nextDialogs": [
              "210330107"
            ]
          },
          "210330107": {
            "id": "210330107",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Apologies. I've been rambling. The location I need you to check this time has been marked on your map. I thank you for your aid, Traveler.",
            "nextDialogs": [
              "210330108"
            ]
          },
          "210330108": {
            "id": "210330108",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I just hope the sword isn't really broken..."
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "4014401",
      "subQuestName": "Talk to Lisa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440101"
        ],
        "dialogs": {
          "401440101": {
            "id": "401440101",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Oh, it's you, cutie! To what do I owe the honor of your visit?",
            "nextDialogs": [
              "401440102"
            ]
          },
          "401440102": {
            "id": "401440102",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Are you here to peruse the library? Or, perhaps you're here to visit a certain someone...",
            "nextDialogs": [
              "401440104",
              "401440106"
            ]
          },
          "401440104": {
            "id": "401440104",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Hehe, as considerate as ever, I see.",
            "nextDialogs": [
              "401440107"
            ]
          },
          "401440107": {
            "id": "401440107",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Alas, what rotten luck... You just so happen to have caught me in the middle of some important work. I'll have to treat you to afternoon tea some other time.",
            "nextDialogs": [
              "401440108"
            ]
          },
          "401440108": {
            "id": "401440108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, you're actually busy... with work? That's not a sight you see every day...",
            "nextDialogs": [
              "401440109"
            ]
          },
          "401440109": {
            "id": "401440109",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Haha, you're right. The last time I was this consumed with research must have been way back at the Akademiya.",
            "nextDialogs": [
              "401440110"
            ]
          },
          "401440110": {
            "id": "401440110",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "I haven't done this much thinking for a long time. It's rather exhausting."
          },
          "401440106": {
            "id": "401440106",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "And decided to stop by for a chat along the way?"
          }
        }
      }
    },
    {
      "subId": "4014402",
      "subQuestName": "Go to the shop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440201"
        ],
        "dialogs": {
          "401440201": {
            "id": "401440201",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "This is the shop.",
            "nextDialogs": [
              "401440202"
            ]
          },
          "401440202": {
            "id": "401440202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow! Looks like you've made a lot of preparations already! Did you do all this by yourself?",
            "nextDialogs": [
              "401440203"
            ]
          },
          "401440203": {
            "id": "401440203",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "It was a group effort. A whole bunch of knights helped out.",
            "nextDialogs": [
              "401440204"
            ]
          },
          "401440204": {
            "id": "401440204",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Jean secured the initial funds to open the shop. Albedo and Sucrose provided the ingredients and equipment needed to brew the potions.",
            "nextDialogs": [
              "401440205"
            ]
          },
          "401440205": {
            "id": "401440205",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "And the Logistics Company is handling the provision of all future supplies.",
            "nextDialogs": [
              "401440206"
            ]
          },
          "401440206": {
            "id": "401440206",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Now with your help, it's like an additional weight has been lifted off my shoulders.",
            "nextDialogs": [
              "401440207"
            ]
          },
          "401440207": {
            "id": "401440207",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "The Knights have been busy spreading the word about our shop over the past few days. So, we should be ready to open once we've finished our final preparations.",
            "nextDialogs": [
              "401440208"
            ]
          },
          "401440208": {
            "id": "401440208",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Okay, let's not keep everyone waiting, then. Why don't you take these ingredients and try your hand at brewing a potion?"
          }
        }
      }
    },
    {
      "subId": "4014403",
      "subQuestName": "Try brewing a potion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440301"
        ],
        "dialogs": {
          "401440301": {
            "id": "401440301",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "All you need to do is add the ingredients into the cauldron, follow the steps provided, and you're good to go."
          }
        }
      }
    },
    {
      "subId": "4014404",
      "subQuestName": "Try to sell your product",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440401"
        ],
        "dialogs": {
          "401440401": {
            "id": "401440401",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Ooh, seems like everything is going well. You've already sold your first batch of potions. Not a bad start at all.",
            "nextDialogs": [
              "401440402"
            ]
          },
          "401440402": {
            "id": "401440402",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "As for what potions you should brew next, we'll need to consult the news from the market.",
            "nextDialogs": [
              "401440403"
            ]
          },
          "401440403": {
            "id": "401440403",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "That means staying up to date on the latest news and trends to try and anticipate people's needs. It's an essential skill when it comes to business.",
            "nextDialogs": [
              "401440404"
            ]
          },
          "401440404": {
            "id": "401440404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, that sounds kinda hard...",
            "nextDialogs": [
              "401440405"
            ]
          },
          "401440405": {
            "id": "401440405",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Hehe... Don't worry. I already took it upon myself to compile all the latest news on the market for you.",
            "nextDialogs": [
              "401440406"
            ]
          },
          "401440406": {
            "id": "401440406",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "What do you think? Have any ideas on the kinds of potions you should sell next?",
            "nextDialogs": [
              "401440407"
            ]
          },
          "401440407": {
            "id": "401440407",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Go ahead and try to cultivate some herbs then. Bio-alchemical processing can infuse herbs with different effects and properties.",
            "nextDialogs": [
              "401440408"
            ]
          },
          "401440408": {
            "id": "401440408",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Using different herbs in the brewing process will, in turn, alter the effects of the potion. There's a whole bunch of combinations to try.",
            "nextDialogs": [
              "401440409"
            ]
          },
          "401440409": {
            "id": "401440409",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Alright cutie, why don't you get started?"
          }
        }
      }
    },
    {
      "subId": "4014405",
      "subQuestName": "End the current operation cycle",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440501"
        ],
        "dialogs": {
          "401440501": {
            "id": "401440501",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Go ahead and try to cultivate some herbs."
          }
        }
      }
    },
    {
      "subId": "4014406",
      "subQuestName": "Talk to Lisa",
      "sceneId": null,

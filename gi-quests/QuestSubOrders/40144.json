    {
      "subId": "4014407",
      "subQuestName": "Try to cultivate ingredients",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440701"
        ],
        "dialogs": {
          "401440701": {
            "id": "401440701",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "#Greetings, Honorary Knight! Greetings, Paimon! My name is Freda. I'm a knight from the Logistics Company. It's such an honor to meet the famous {NICKNAME} and {M#his}{F#her} loyal attendant!",
            "nextDialogs": [
              "401440702"
            ]
          },
          "401440702": {
            "id": "401440702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Wow, Paimon's fame is really spreading across the land, hehe! One small correction though. Paimon's {M#his}{F#her} companion, not {M#his}{F#her} attendant!",
            "nextDialogs": [
              "401440703"
            ]
          },
          "401440703": {
            "id": "401440703",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "Ah, my apologies. I guess I got a bit carried away after hearing all about your exploits. It's just like something out of a novel!",
            "nextDialogs": [
              "401440704"
            ]
          },
          "401440704": {
            "id": "401440704",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "You're practically legends at this point. I'm a bit jealous, actually...",
            "nextDialogs": [
              "401440705"
            ]
          },
          "401440705": {
            "id": "401440705",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "I'd love to wander the land in search of adventure like one of those knights you read about in stories! Seems like a really fun life.",
            "nextDialogs": [
              "401440707",
              "401440709"
            ]
          },
          "401440707": {
            "id": "401440707",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "Yeah! That's what I'm hoping, at least!",
            "nextDialogs": [
              "401440710"
            ]
          },
          "401440710": {
            "id": "401440710",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "Anyway, we've got some prep work to wrap up, right?",
            "nextDialogs": [
              "401440711"
            ]
          },
          "401440711": {
            "id": "401440711",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "My orders from the Acting Grand Master are to support your business in any way I can.",
            "nextDialogs": [
              "401440712"
            ]
          },
          "401440712": {
            "id": "401440712",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "If there's anything you need, just let me know!"
          },
          "401440709": {
            "id": "401440709",
            "speakerId": 1002,
            "speakerName": "Freda",
            "text": "I bet. The knights in the stories are always running into all sorts of danger..."
          }
        }
      }
    },
    {
      "subId": "4014408",
      "subQuestName": "Talk to Lisa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440601"
        ],
        "dialogs": {
          "401440601": {
            "id": "401440601",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Seems like you've gotten the hang of the cultivation side of things.",
            "nextDialogs": [
              "401440602"
            ]
          },
          "401440602": {
            "id": "401440602",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Ah, I should probably mention, a knight from the Logistics Company has arrived. She'll be the one handling the provision of all future supplies. You should go have a chat with her in a little bit.",
            "nextDialogs": [
              "401440603"
            ]
          },
          "401440603": {
            "id": "401440603",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "And after that, it'll be your time to shine!",
            "nextDialogs": [
              "401440604"
            ]
          },
          "401440604": {
            "id": "401440604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait, what about you?",
            "nextDialogs": [
              "401440605"
            ]
          },
          "401440605": {
            "id": "401440605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! Shouldn't it be our time to shine? Y'know, the three of us? What about your role in all this?",
            "nextDialogs": [
              "401440606"
            ]
          },
          "401440606": {
            "id": "401440606",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "My role? Naturally, it was to ensure my cuties had all the business and alchemy knowledge they needed to succeed!",
            "nextDialogs": [
              "401440607"
            ]
          },
          "401440607": {
            "id": "401440607",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Okay, I'll be rooting for you! Good luck!",
            "nextDialogs": [
              "401440608"
            ]
          },
          "401440608": {
            "id": "401440608",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon knew this would happen..."
          }
        }
      }
    },
    {
      "subId": "4014409",

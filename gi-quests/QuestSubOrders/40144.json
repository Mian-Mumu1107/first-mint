    {
      "subId": "4014410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401441001"
        ],
        "dialogs": {
          "401441001": {
            "id": "401441001",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Why don't you put your potion on that shelf over there?"
          }
        }
      }
    },
    {
      "subId": "4014411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401441101"
        ],
        "dialogs": {
          "401441101": {
            "id": "401441101",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Oh, you're finished already? Guess it's time to start advertising the grand opening of our shop! I'll tell the knights to start putting up the announcements right away."
          }
        }
      }
    },
    {
      "subId": "4014499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401449901"
        ],
        "dialogs": {
          "401449901": {
            "id": "401449901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's been a while since we last visited the Knights of Favonius! Paimon wonders what Jean and Lisa have been up to recently. Let's go pay them a visit!",
            "nextDialogs": [
              "401449902"
            ]
          },
          "401449902": {
            "id": "401449902",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Ooh, looks like you finished your potion! Now, all we need to do is put it on display for sale.",
            "nextDialogs": [
              "401449903"
            ]
          },
          "401449903": {
            "id": "401449903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like we're done with all the prep work! Why don't we take a short break over there while we wait for customers to arrive?"
          }
        }
      }
    }
  ]
}
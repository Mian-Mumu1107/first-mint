  "subQuests": [
    {
      "subId": "7610701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071101"
        ],
        "dialogs": {
          "761071101": {
            "id": "761071101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I am your Harbinger, Marionette!",
            "nextDialogs": [
              "761071102"
            ]
          },
          "761071102": {
            "id": "761071102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? W—Wait, is that what we're going with...?",
            "nextDialogs": [
              "761071103"
            ]
          },
          "761071103": {
            "id": "761071103",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Hmph. I'll give you points for boldness, but if you think such a blatant lie will work, you clearly underestimate us Fatui!"
          }
        }
      }
    },
    {
      "subId": "7610710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071001"
        ],
        "dialogs": {
          "761071001": {
            "id": "761071001",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Who are you? What are you doing here? The cargo crew's supposed to be down by the port."
          }
        }
      }
    },
    {
      "subId": "7610712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071201"
        ],
        "dialogs": {
          "761071201": {
            "id": "761071201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm a... specially appointed researcher under Marionette.",
            "nextDialogs": [
              "761071202"
            ]
          },
          "761071202": {
            "id": "761071202",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "A \"specially appointed researcher\"? Lady Marionette has already reached the pinnacle of both mechanical and kuuvahki research. Why would she need to hire some external researchers?"
          }
        }
      }
    },
    {
      "subId": "7610713",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071301"
        ],
        "dialogs": {
          "761071301": {
            "id": "761071301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Scientific progress is built on collaboration, I'll have you know.",
            "nextDialogs": [
              "761071302"
            ]
          },
          "761071302": {
            "id": "761071302",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Hmm... fair point. I've helped collect quite a few research papers from the Fontaine Research Institute for her myself.",
            "nextDialogs": [
              "761071303"
            ]
          },
          "761071303": {
            "id": "761071303",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Since you're an expert in this field, I assume fixing this Landcruiser's malfunction would be quite easy for you?"
          }
        }
      }
    },
    {
      "subId": "7610714",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071401"
        ],
        "dialogs": {
          "761071401": {
            "id": "761071401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Umm... I fear my research focus is more theoretical...",
            "nextDialogs": [
              "761071402"
            ]
          },
          "761071402": {
            "id": "761071402",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Ah, I see! Kuuvahki theory is a most profound areas of study — truly impressive! By comparison, repairing a Landcruiser is much more application-oriented. And it is as you say — they are completely different disciplines.",
            "nextDialogs": [
              "761071403"
            ]
          },
          "761071403": {
            "id": "761071403",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "That said, Lady Marionette isn't here right now. You could check with Commander Azalea — she might know about any further arrangements."
          }
        }
      }
    },
    {
      "subId": "7610715",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071501"
        ],
        "dialogs": {
          "761071501": {
            "id": "761071501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course, leave it to me.",
            "nextDialogs": [
              "761071502"
            ]
          },
          "761071502": {
            "id": "761071502",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You give the Landcruiser a few good whacks. *clang, clang, clang*... rendering it completely immobile.",
            "nextDialogs": [
              "761071503"
            ]
          },
          "761071503": {
            "id": "761071503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's... totally broken... What do we do now?",
            "nextDialogs": [
              "761071504"
            ]
          },
          "761071504": {
            "id": "761071504",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Hmph, I knew something was off about you from the start. A real researcher would never make such outlandish claims. You're clearly an impostor!"
          }
        }
      }
    },
    {
      "subId": "7610716",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071601"
        ],
        "dialogs": {
          "761071601": {
            "id": "761071601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You could say I'm practically her mentor.",
            "nextDialogs": [
              "761071602"
            ]
          },
          "761071602": {
            "id": "761071602",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Oh! Speaking of which, I've helped collect quite a few research papers from the Fontaine Research Institute for her myself. She spoke very highly of Dr. Mosso's research findings. Wait... could you possibly be...?",
            "nextDialogs": [
              "761071603"
            ]
          },
          "761071603": {
            "id": "761071603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*cough* *cough*... Mm-hmm.",
            "nextDialogs": [
              "761071604"
            ]
          },
          "761071604": {
            "id": "761071604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y—Yeah! Never thought your reputation would reach all the way out here, Dr. Mosso!",
            "nextDialogs": [
              "761071605"
            ]
          },
          "761071605": {
            "id": "761071605",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Hmph. And as far as I know, you should be thirty years dead. Well, better late than never!"
          }
        }
      }
    },
    {
      "subId": "7610717",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071701"
        ],
        "dialogs": {
          "761071701": {
            "id": "761071701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmph, I'm not playing by Fatui rules.",
            "nextDialogs": [
              "761071702"
            ]
          },
          "761071702": {
            "id": "761071702",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Then if you won't follow the rules... Disappear!"
          }
        }
      }
    },
    {
      "subId": "7610718",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071801"
        ],
        "dialogs": {
          "761071801": {
            "id": "761071801",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "This is a restricted military area. If you've got nothing else to do here, leave as soon as possible."
          }
        }
      }
    },
    {
      "subId": "7610719",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761071901"
        ],
        "dialogs": {
          "761071901": {
            "id": "761071901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, I do — I was hoping for a little sparring match.",
            "nextDialogs": [
              "761071902"
            ]
          },
          "761071902": {
            "id": "761071902",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "Sparring? But you said you were an external researcher... Hmph, now that I think about it, I don't recall the Lady ever hiring any researchers... Wait. You're a spy, aren't you? Then, prepare to die!"
          }
        }
      }
    },
    {
      "subId": "7610720",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761072001"
        ],
        "dialogs": {
          "761072001": {
            "id": "761072001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sorry, I got a little lost...",
            "nextDialogs": [
              "761072002"
            ]
          },
          "761072002": {
            "id": "761072002",
            "speakerId": 22243,
            "speakerName": "Risto",
            "text": "You can leave through either the port or the main gate. Commander Azalea runs tight security around here — even you need to follow the rules."
          }
        }
      }
    }
  ]
}
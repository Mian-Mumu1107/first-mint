    },
    {
      "subId": "2400802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240080201"
        ],
        "dialogs": {
          "240080201": {
            "id": "240080201",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "The weather's good, the fishing spot's great, no Blubberbeasts, and no journalists... Ah, this is the life!",
            "nextDialogs": [
              "240080202"
            ]
          },
          "240080202": {
            "id": "240080202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In a good mood today, I see.",
            "nextDialogs": [
              "240080203"
            ]
          },
          "240080203": {
            "id": "240080203",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "In various ways, yes, and now that you're here, I've never been better, haha!",
            "nextDialogs": [
              "240080204"
            ]
          },
          "240080204": {
            "id": "240080204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Did something good happen? Or something interesting, maybe?",
            "nextDialogs": [
              "240080205"
            ]
          },
          "240080205": {
            "id": "240080205",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "No, no, in fact, everything's as peaceful as placid waters!",
            "nextDialogs": [
              "240080206"
            ]
          },
          "240080206": {
            "id": "240080206",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "No journalists, no announcements, no leaks, and no lost forms or documents.",
            "nextDialogs": [
              "240080207"
            ]
          },
          "240080207": {
            "id": "240080207",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Everything is operating as it should without any mistakes...",
            "nextDialogs": [
              "240080208"
            ]
          },
          "240080208": {
            "id": "240080208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait... Don't move! Whatever you do, don't move!",
            "nextDialogs": [
              "240080209"
            ]
          },
          "240080209": {
            "id": "240080209",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "What? Why so sudden...?",
            "nextDialogs": [
              "240080210"
            ]
          },
          "240080210": {
            "id": "240080210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just freeze...",
            "nextDialogs": [
              "240080211"
            ]
          },
          "240080211": {
            "id": "240080211",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "What happened? Did those Blubberbeasts come back? Haha, I looked all around, you know. They...",
            "nextDialogs": [
              "240080212"
            ]
          },
          "240080212": {
            "id": "240080212",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Agh! Slimes!? Where did they all pop out from? Help! Help!",
            "nextDialogs": [
              "240080213"
            ]
          },
          "240080213": {
            "id": "240080213",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "C'mon, that's why we told you not to move about!",
            "nextDialogs": [
              "240080214"
            ]
          },
          "240080214": {
            "id": "240080214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Get down!",
            "nextDialogs": [
              "240080215"
            ]
          },
          "240080215": {
            "id": "240080215",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Help me, please!"
          }
        }
      }
    },
    {
      "subId": "2400806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240080601"
        ],
        "dialogs": {
          "240080601": {
            "id": "240080601",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "I take back what I said before. It seems that not everything is going to plan today...",
            "nextDialogs": [
              "240080602"
            ]
          },
          "240080602": {
            "id": "240080602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Those Slimes were just going about their day.",
            "nextDialogs": [
              "240080603"
            ]
          },
          "240080603": {
            "id": "240080603",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Funny, aren't you? I envy your good humor... Following your logic, I suppose that today was, in fact, the Slimes' lucky day, and I was just a bit actor in their play?",
            "nextDialogs": [
              "240080604"
            ]
          },
          "240080604": {
            "id": "240080604",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "It seems that everyone's definition of a \"good day\" need not be the same, nor must they be in conflict with one another.",
            "nextDialogs": [
              "240080605"
            ]
          },
          "240080605": {
            "id": "240080605",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Ugh... I think I injured my waist during the kerfuffle earlier. I need to get it checked in the city soon... Ow, ow...",
            "nextDialogs": [
              "240080606"
            ]
          },
          "240080606": {
            "id": "240080606",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Here's your payment, Traveler. I... Ow, ow... Ugh, that really hurts."
          }
        }
      }
    },
    {
      "subId": "2400807",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240080701"
        ],
        "dialogs": {
          "240080701": {
            "id": "240080701",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Have you brought the bait back? Wonderful! Time to continue fishing, I say.",
            "nextDialogs": [
              "240080702"
            ]
          },
          "240080702": {
            "id": "240080702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Boucicaut wants to relay this message...",
            "nextDialogs": [
              "240080703"
            ]
          },
          "240080703": {
            "id": "240080703",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You pass Boucicaut's words onto Roialte...",
            "nextDialogs": [
              "240080704"
            ]
          },
          "240080704": {
            "id": "240080704",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Hahaha, is he worried about me? It's fine, I know what I'm doing.",
            "nextDialogs": [
              "240080705"
            ]
          },
          "240080705": {
            "id": "240080705",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "As for inviting my old fishing buddies... Some of them have settled down with family, while others are busy with work. Either way, we haven't been in touch for a long time.",
            "nextDialogs": [
              "240080706"
            ]
          },
          "240080706": {
            "id": "240080706",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "And I'm not the type to go fishing with strangers, so rather than do that, I'd prefer to go it alone.",
            "nextDialogs": [
              "240080707"
            ]
          },
          "240080707": {
            "id": "240080707",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Hmm, now that you mention it... I could call Iaune to come fishing with me. He could use the break, in any case.",
            "nextDialogs": [
              "240080708"
            ]
          },
          "240080708": {
            "id": "240080708",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Anyway, Traveler, here's your payment. Thanks for your help.",
            "nextDialogs": [
              "240080709"
            ]
          },
          "240080709": {
            "id": "240080709",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Yes, this sounds good. I'll go fish for Iaune's opinion tomorrow at work.",
            "nextDialogs": [
              "240080710"
            ]
          },
          "240080710": {
            "id": "240080710",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "If he's willing to come, we'll be able to bring more gear, go further, and find some better fishing spots..."
          }
        }
      }
    },
    {
      "subId": "2400810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240081001"
        ],
        "dialogs": {
          "240081001": {
            "id": "240081001",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Hmm, what should I say next..."
          }
        }
      }
    },
    {
      "subId": "2400811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240081101"
        ],
        "dialogs": {
          "240081101": {
            "id": "240081101",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "*sigh* These silly Blubberbeasts just won't leave, will they..."
          }
        }
      }
    },
    {
      "subId": "2400812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240081201"
        ],
        "dialogs": {
          "240081201": {
            "id": "240081201",
            "speakerId": 1000,
            "speakerName": "Roialte",
            "text": "Agh! Slimes!? Where did they all pop out from?"
          }
        }
      }
    },
    {
      "subId": "2400899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240089901"
        ],
        "dialogs": {
          "240089901": {
            "id": "240089901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Come on, can't you see we're listening to a story here? Shoo!",
            "nextDialogs": [
              "240089902"
            ]
          },
          "240089902": {
            "id": "240089902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This'll do. Let's go back to Roialte and see what sort of story he'll spin.",
            "nextDialogs": [
              "240089903"
            ]
          },
          "240089903": {
            "id": "240089903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This should do it! Let's head back and look for Roialte.",
            "nextDialogs": [
              "240089904"
            ]
          },
          "240089904": {
            "id": "240089904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Gah, where did these Hydro Slimes come from? Stop 'em!"
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "750250101": {
            "id": "750250101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, where is this mysterious place? So many little Tepetlisaurs...",
            "nextDialogs": [
              "750250102"
            ]
          },
          "750250102": {
            "id": "750250102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Could it be some sort of... Tepetlisaurus gathering spot?",
            "nextDialogs": [
              "750250103"
            ]
          },
          "750250103": {
            "id": "750250103",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! ...Rrrawr?",
            "nextDialogs": [
              "750250104"
            ]
          },
          "750250104": {
            "id": "750250104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} looks so excited! Not often that you get to meet so many companions all in one go, huh?",
            "nextDialogs": [
              "750250105"
            ]
          },
          "750250105": {
            "id": "750250105",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr?",
            "nextDialogs": [
              "750250106"
            ]
          },
          "750250106": {
            "id": "750250106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Oh, you mean you wanna go over there and play with them? Come to think of it, {REALNAME[ID(2)|SHOWHOST(true)]} hardly ever gets to hang out with other little Tepetlisaurs...",
            "nextDialogs": [
              "750250109"
            ]
          },
          "750250109": {
            "id": "750250109",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750250110"
            ]
          },
          "750250110": {
            "id": "750250110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Uhh, Paimon's still a bit worried... Anyway, let's find somewhere to relax and have something to eat while we wait for {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "750250111"
            ]
          },
          "750250111": {
            "id": "750250111",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "#You and Paimon find a nice spot nearby to rest until {REALNAME[ID(2)|SHOWHOST(true)]} is done playing.",
            "nextDialogs": [
              "750250112"
            ]
          },
          "750250112": {
            "id": "750250112",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "But you end up waiting longer than you expected...",
            "nextDialogs": [
              "750250113"
            ]
          },
          "750250113": {
            "id": "750250113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Strange... How come {REALNAME[ID(2)|SHOWHOST(true)]} isn't back yet?",
            "nextDialogs": [
              "750250114"
            ]
          },
          "750250114": {
            "id": "750250114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon sure hopes nothing bad's happened...",
            "nextDialogs": [
              "750250115"
            ]
          },
          "750250115": {
            "id": "750250115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Gotten a bit carried away with the fun and games, perhaps?",
            "nextDialogs": [
              "750250116"
            ]
          },
          "750250116": {
            "id": "750250116",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If so, we'll have to give him a good talking-to. The sun's nearly set!",
            "nextDialogs": [
              "750250117"
            ]
          },
          "750250117": {
            "id": "750250117",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh... Let's go track it down before it gets so dark we can't even see."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7305701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570101"
        ],
        "dialogs": {
          "730570101": {
            "id": "730570101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, he's gone... But Paimon understands, he's forgotten our adventures together, after all.",
            "nextDialogs": [
              "730570104"
            ]
          },
          "730570104": {
            "id": "730570104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes, you're right... Oh, Paimon has an idea!",
            "nextDialogs": [
              "730570105"
            ]
          },
          "730570105": {
            "id": "730570105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aranakin taught us a song, right? Let's play it, and maybe he would recognize it!"
          }
        }
      }
    },
    {
      "subId": "7305702",
      "subQuestName": "Play Aranakin's song",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570201"
        ],
        "dialogs": {
          "730570201": {
            "id": "730570201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haha, here he comes! Hello, little thing!",
            "nextDialogs": [
              "730570202"
            ]
          },
          "730570202": {
            "id": "730570202",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Aranakin is not a little thing! You are! You floaty white little thing!",
            "nextDialogs": [
              "730570203"
            ]
          },
          "730570203": {
            "id": "730570203",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Speaking of which, golden sand... Nara, why do you know this song?",
            "nextDialogs": [
              "730570204"
            ]
          },
          "730570204": {
            "id": "730570204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well...",
            "nextDialogs": [
              "730570206",
              "730570208"
            ]
          },
          "730570206": {
            "id": "730570206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes, during our last adventure, you taught the song to us!",
            "nextDialogs": [
              "730570209"
            ]
          },
          "730570209": {
            "id": "730570209",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Is that... so? Hmph, Aranakin is not clever, but you don't look like those bad sand grains.",
            "nextDialogs": [
              "730570210"
            ]
          },
          "730570210": {
            "id": "730570210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No, we don't! You told us that sand is Valuka. So the bad sand grains are a group of bad Nara Valuka, right? But we are good Nara!",
            "nextDialogs": [
              "730570211"
            ]
          },
          "730570211": {
            "id": "730570211",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Ohh? Did I tell you that as well?",
            "nextDialogs": [
              "730570212"
            ]
          },
          "730570212": {
            "id": "730570212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Haha, that's right! {NICKNAME}, let's tell the stories to him again!",
            "nextDialogs": [
              "730570213"
            ]
          },
          "730570213": {
            "id": "730570213",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You recount the adventures to Aranakin, as well as how you neutralized The Withering together.",
            "nextDialogs": [
              "730570214"
            ]
          },
          "730570214": {
            "id": "730570214",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "...I see.",
            "nextDialogs": [
              "730570215"
            ]
          },
          "730570215": {
            "id": "730570215",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Aranakin is not clever, but what you said, sounds to be true. Aranakin can't remember, sorry.",
            "nextDialogs": [
              "730570216"
            ]
          },
          "730570216": {
            "id": "730570216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No, no need for that! Y'know, it's pretty normal to forget things... Besides, we can become friends again, right?"
          },
          "730570208": {
            "id": "730570208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe, how did {NICKNAME} do? See? We still remember the melody you taught us!"
          }
        }
      }
    },

    {
      "subId": "7305703",
      "subQuestName": "Follow Aranakin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570301"
        ],
        "dialogs": {
          "730570301": {
            "id": "730570301",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "We're here! Here it is!",
            "nextDialogs": [
              "730570302"
            ]
          },
          "730570302": {
            "id": "730570302",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "This is my place, please rest here!"
          }
        }
      }
    },
    {
      "subId": "7305704",
      "subQuestName": "Talk to Aranakin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730571001"
        ],
        "dialogs": {
          "730571001": {
            "id": "730571001",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "#Thank you, Nara {NICKNAME} and White Floaty! I'm going back to where Aranaga is. You can find me there!"
          }
        }
      }
    },
    {
      "subId": "7305712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570401"
        ],
        "dialogs": {
          "730570401": {
            "id": "730570401",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "This is Nara instrument, Aranakin is keeping it. But it can't sing now... The strings are not in the right place.",
            "nextDialogs": [
              "730570402"
            ]
          },
          "730570402": {
            "id": "730570402",
            "speakerId": 1003,
            "speakerName": "Old Oud",
            "text": "(An antiquated oud, marked with multiple breaking scars, but seeming to be carefully-repaired and well-maintained.)"
          }
        }
      }
    },
    {
      "subId": "7305713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570501"
        ],
        "dialogs": {
          "730570501": {
            "id": "730570501",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Nara... Hm, what's the name? Aranakin doesn't sleep with that, so forget the word...",
            "nextDialogs": [
              "730570502"
            ]
          },
          "730570502": {
            "id": "730570502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's a \"bed\"! It looks pretty new, indeed... Did someone sleep on it before?",
            "nextDialogs": [
              "730570503"
            ]
          },
          "730570503": {
            "id": "730570503",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Hehe, Aranakin keeps tidying it... If you want to sleep here, that's okay!"
          }
        }
      }
    },
    {
      "subId": "7305715",
      "subQuestName": "Investigate the tree house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305714",
      "subQuestName": "Talk to Aranakin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570601"
        ],
        "dialogs": {
          "730570601": {
            "id": "730570601",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "There are leaves Nara left upstairs, but... Aranakin can't read them, Aranakin doesn't understand...",
            "nextDialogs": [
              "730570602"
            ]
          },
          "730570602": {
            "id": "730570602",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Those are the leaves Nara use to keep memories... Nara write on the leaves, and put them together. But the words of Nara, Aranakin doesn't understand.",
            "nextDialogs": [
              "730570606"
            ]
          },
          "730570606": {
            "id": "730570606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you mean... \"notebook\"?",
            "nextDialogs": [
              "730570603"
            ]
          },
          "730570603": {
            "id": "730570603",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "\"Notebook\"...? That's how Nara keep their memories?",
            "nextDialogs": [
              "730570604"
            ]
          },
          "730570604": {
            "id": "730570604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup, that's right... Will Aranakin mind if we go upstairs together, and see what it says?",
            "nextDialogs": [
              "730570605"
            ]
          },
          "730570605": {
            "id": "730570605",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Me? Not at all!"
          }
        }
      }
    },
    {
      "subId": "7305705",
      "subQuestName": "Read the notebook on the second floor of the tree house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570901"
        ],
        "dialogs": {
          "730570901": {
            "id": "730570901",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "\"...I've repaired the oud Uncle Bakr dropped, so stop crying by yourself, alright? You can talk to Khayyam and me if you're unhappy...\"",
            "nextDialogs": [
              "730570902"
            ]
          },
          "730570902": {
            "id": "730570902",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "\"...I've been accepted into the Akademiya! Haha, congratulations to me! I don't want to be some warrior's wife! I'm going to be Siman, the Great Sage!\"",
            "nextDialogs": [
              "730570903"
            ]
          },
          "730570903": {
            "id": "730570903",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "\"Hehe... Irfan the 'Great musician' and Khayyam 'the Wise!' Don't forget me! Especially you, Khayyam! Don't you dare forget me!\"",
            "nextDialogs": [
              "730570904"
            ]
          },
          "730570904": {
            "id": "730570904",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "\"...Farewell, notebook! Farewell, Irfan and Siman, my best friends! I hope that the forest never forgets our story, and I hope we remember each other...\"",
            "nextDialogs": [
              "730570905"
            ]
          },
          "730570905": {
            "id": "730570905",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "(...The rest is a mess and filled with the children's happy and sorrowful memories...)",
            "nextDialogs": [
              "730570906"
            ]
          },
          "730570906": {
            "id": "730570906",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "\"...Aranakin is gone. Vanished into thin air, and without so much as a sign as to when. It's time for me to bid farewell to the oud too. I'll be a craftsman, just like my father had hoped I would...\"",
            "nextDialogs": [
              "730570907"
            ]
          },
          "730570907": {
            "id": "730570907",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "(There seems to be more, but it's been crossed and blacked out with ink.)",
            "nextDialogs": [
              "730570908"
            ]
          },
          "730570908": {
            "id": "730570908",
            "speakerId": 20765,
            "speakerName": "Battered Notebook",
            "text": "\"...To the person reading this notebook, if I by some miracle am allowed to meet Aranakin and the others again, years from now, then please give this flower to him...\"",
            "nextDialogs": [
              "730570909"
            ]
          },
          "730570909": {
            "id": "730570909",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, something fell out of the notebook!",
            "nextDialogs": [
              "730570910"
            ]
          },
          "730570910": {
            "id": "730570910",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It looks like... a flower? It looks... exactly like the ones we got."
          }
        }
      }
    },
    {
      "subId": "7305706",
      "subQuestName": "Talk to Aranakin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570701"
        ],
        "dialogs": {
          "730570701": {
            "id": "730570701",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "What memories is it keeping? What did you see?",
            "nextDialogs": [
              "730570702"
            ]
          },
          "730570702": {
            "id": "730570702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It seems that the owner of the notebook knows you.",
            "nextDialogs": [
              "730570703"
            ]
          },
          "730570703": {
            "id": "730570703",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Is that so...? I can't remember...",
            "nextDialogs": [
              "730570704"
            ]
          },
          "730570704": {
            "id": "730570704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He said... He couldn't see you anymore. Because he grew up, maybe...",
            "nextDialogs": [
              "730570705"
            ]
          },
          "730570705": {
            "id": "730570705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Growing up is really troubling.",
            "nextDialogs": [
              "730570706"
            ]
          },
          "730570706": {
            "id": "730570706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh right! He also said in the notebook that... This flower is for you!",
            "nextDialogs": [
              "730570707"
            ]
          },
          "730570707": {
            "id": "730570707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here.",
            "nextDialogs": [
              "730570708"
            ]
          },
          "730570708": {
            "id": "730570708",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Huh...? Ahh! This flower is very important! Why do you... how did he get it?",
            "nextDialogs": [
              "730570709"
            ]
          },
          "730570709": {
            "id": "730570709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually, you once gave us the same flower as well... It's just that you forgot everything.",
            "nextDialogs": [
              "730570710"
            ]
          },
          "730570710": {
            "id": "730570710",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Really...? I can still make friends with you again. But... As for him, I can't even recall his face...",
            "nextDialogs": [
              "730570711"
            ]
          },
          "730570711": {
            "id": "730570711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "I—It's okay... Don't be sad, we still have this flower. It will bring you more memories, right?",
            "nextDialogs": [
              "730570712"
            ]
          },
          "730570712": {
            "id": "730570712",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Yes, White Floaty is right.",
            "nextDialogs": [
              "730570713"
            ]
          },
          "730570713": {
            "id": "730570713",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "I am taking this flower back, Mawtiyima should know how to wake her up.",
            "nextDialogs": [
              "730570714"
            ]
          },
          "730570714": {
            "id": "730570714",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "#Hmm... Nara {NICKNAME} and White Floaty, I am going back to where Aranaga is, planting her, and listening to her songs. If you are not busy, you know where to find us!",
            "nextDialogs": [
              "730570715"
            ]
          },
          "730570715": {
            "id": "730570715",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes, see you soon!"
          }
        }
      }
    },
    {
      "subId": "7305708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730570801"
        ],
        "dialogs": {
          "730570801": {
            "id": "730570801",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Let me know if you find anything interesting!"
          }
        }
      }
    }
  ]
}
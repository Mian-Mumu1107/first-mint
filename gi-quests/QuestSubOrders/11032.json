    {
      "subId": "1103202",
      "subQuestName": "Talk to Huixin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110320201"
        ],
        "dialogs": {
          "110320201": {
            "id": "110320201",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Ms. Ganyu, thank you for accepting my invitation. And as for the two of you, your presence is also much appreciated.",
            "nextDialogs": [
              "110320202"
            ]
          },
          "110320202": {
            "id": "110320202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sure!",
            "nextDialogs": [
              "110320203"
            ]
          },
          "110320203": {
            "id": "110320203",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "That's so kind of you, Huixin. You went to great lengths to organize this.",
            "nextDialogs": [
              "110320204"
            ]
          },
          "110320204": {
            "id": "110320204",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Ha, truth be told... Apart from thanking you for all the help, there's something I'd like to tell you...",
            "nextDialogs": [
              "110320205"
            ]
          },
          "110320205": {
            "id": "110320205",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Oh? If there's anything I can help you with, just tell me straight away. No need to hesitate.",
            "nextDialogs": [
              "110320206"
            ]
          },
          "110320206": {
            "id": "110320206",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Ah... No, no, I don't really need help. Uh... Could you just listen for a bit?",
            "nextDialogs": [
              "110320207"
            ]
          },
          "110320207": {
            "id": "110320207",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "With pleasure.",
            "nextDialogs": [
              "110320208"
            ]
          },
          "110320208": {
            "id": "110320208",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Ha... When I was a little girl, my father used to tell me many stories about you, Ms. Ganyu.",
            "nextDialogs": [
              "110320209"
            ]
          },
          "110320209": {
            "id": "110320209",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Even though I have the utmost respect for my father... I always admired how gentle and reliable you are.",
            "nextDialogs": [
              "110320210"
            ]
          },
          "110320210": {
            "id": "110320210",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "I only decided to join the Yuehai Pavilion staff because I've always looked up to you.",
            "nextDialogs": [
              "110320211"
            ]
          },
          "110320211": {
            "id": "110320211",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I didn't know that you think so highly of me.",
            "nextDialogs": [
              "110320212"
            ]
          },
          "110320212": {
            "id": "110320212",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "However, in reality, working at the Yuehai Pavilion turned out to be an arduous task.",
            "nextDialogs": [
              "110320213"
            ]
          },
          "110320213": {
            "id": "110320213",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "I can't compare myself to such an outstanding secretary like you. I often doubt myself as a result...",
            "nextDialogs": [
              "110320214"
            ]
          },
          "110320214": {
            "id": "110320214",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I disagree. You're a great secretary in your own right.",
            "nextDialogs": [
              "110320215"
            ]
          },
          "110320215": {
            "id": "110320215",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Aha, thank you.",
            "nextDialogs": [
              "110320216"
            ]
          },
          "110320216": {
            "id": "110320216",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Over the years, I became a mother, too...",
            "nextDialogs": [
              "110320217"
            ]
          },
          "110320217": {
            "id": "110320217",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh! So Uncle Tian is a grandpa!",
            "nextDialogs": [
              "110320218"
            ]
          },
          "110320218": {
            "id": "110320218",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Influenced by my youthful ideals, she followed my footsteps and came to be a secretary at the Yuehai Pavilion, too.",
            "nextDialogs": [
              "110320219"
            ]
          },
          "110320219": {
            "id": "110320219",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "At first, I was worried about her. It's not an easy job, after all. To tell the truth, I'm still unsure if she's capable enough.",
            "nextDialogs": [
              "110320220"
            ]
          },
          "110320220": {
            "id": "110320220",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "But after all that happened this time, I've... made up my mind to support her choice.",
            "nextDialogs": [
              "110320221"
            ]
          },
          "110320221": {
            "id": "110320221",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "So, what made you change your mind?",
            "nextDialogs": [
              "110320222"
            ]
          },
          "110320222": {
            "id": "110320222",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "The fact that she'll have you, Ms. Ganyu, as her senior colleague.",
            "nextDialogs": [
              "110320223"
            ]
          },
          "110320223": {
            "id": "110320223",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "You'll help her, gentle as always, and tell her, \"Your mom used to do it like that.\" Heh.",
            "nextDialogs": [
              "110320224"
            ]
          },
          "110320224": {
            "id": "110320224",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "It'd be such a beautiful moment.",
            "nextDialogs": [
              "110320225"
            ]
          },
          "110320225": {
            "id": "110320225",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "If it's not too much to ask for, she might still need your guidance in twenty plus years, too.",
            "nextDialogs": [
              "110320226"
            ]
          },
          "110320226": {
            "id": "110320226",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Huixin...",
            "nextDialogs": [
              "110320227"
            ]
          },
          "110320227": {
            "id": "110320227",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I... I never thought that I meant so much to you.",
            "nextDialogs": [
              "110320228"
            ]
          },
          "110320228": {
            "id": "110320228",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Heh, just like when you showed me my father's trick. Having you as their \"witness\" makes people feel at ease.",
            "nextDialogs": [
              "110320229"
            ]
          },
          "110320229": {
            "id": "110320229",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "\"Witness\"...",
            "nextDialogs": [
              "110320230"
            ]
          },
          "110320230": {
            "id": "110320230",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "...It's true that I've witnessed thousands of years of Liyue Harbor's history. All the changes it's gone through, the stories of its people...",
            "nextDialogs": [
              "110320231"
            ]
          },
          "110320231": {
            "id": "110320231",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "But I've always regarded it as nothing more than the source of my loneliness.",
            "nextDialogs": [
              "110320232"
            ]
          },
          "110320232": {
            "id": "110320232",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Huixin, you don't know how important those words are to me...",
            "nextDialogs": [
              "110320233"
            ]
          },
          "110320233": {
            "id": "110320233",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "You've made me realize that I share another connection with the people of Liyue Harbor, apart from my contract with Rex Lapis.",
            "nextDialogs": [
              "110320234"
            ]
          },
          "110320234": {
            "id": "110320234",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "They rely on me, accept me, and long for me to bear witness to their stories.",
            "nextDialogs": [
              "110320235"
            ]
          },
          "110320235": {
            "id": "110320235",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Of course! You're irreplaceable to us!",
            "nextDialogs": [
              "110320236"
            ]
          },
          "110320236": {
            "id": "110320236",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Ehehe... That's right. That's why I can't disappoint you.",
            "nextDialogs": [
              "110320237"
            ]
          },
          "110320237": {
            "id": "110320237",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hooray! Ganyu's finally cheered up!",
            "nextDialogs": [
              "110320238"
            ]
          },
          "110320238": {
            "id": "110320238",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Even if I've really been supplanted, I wish to fight for my place...",
            "nextDialogs": [
              "110320239"
            ]
          },
          "110320239": {
            "id": "110320239",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I won't let you down. I'm going to fulfill my contract and keep working as the Qixing's secretary.",
            "nextDialogs": [
              "110320242"
            ]
          },
          "110320242": {
            "id": "110320242",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Regardless, I'll go back and see for myself.",
            "nextDialogs": [
              "110320243"
            ]
          },
          "110320243": {
            "id": "110320243",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I'm afraid that it might've all become a mess during my absence.",
            "nextDialogs": [
              "110320244"
            ]
          },
          "110320244": {
            "id": "110320244",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "No time to waste — let's get back to work!",
            "nextDialogs": [
              "110320245"
            ]
          },
          "110320245": {
            "id": "110320245",
            "speakerId": 1000,
            "speakerName": "Huixin",
            "text": "Good luck, Ms. Ganyu!",
            "nextDialogs": [
              "110320246"
            ]
          },
          "110320246": {
            "id": "110320246",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huuuuh!? We leaving already? Paimon's still hungry!"
          }
        }
      }
    },

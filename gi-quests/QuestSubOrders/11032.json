    {
      "subId": "1103204",
      "subQuestName": "Talk to the Jade Chamber secretaries",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110320301"
        ],
        "dialogs": {
          "110320301": {
            "id": "110320301",
            "speakerId": 1003,
            "speakerName": "Baishi",
            "text": "Ahhhh...",
            "nextDialogs": [
              "110320302"
            ]
          },
          "110320302": {
            "id": "110320302",
            "speakerId": 1004,
            "speakerName": "Baiwen",
            "text": "Baishi, are you okay? Did you fall asleep standing up?",
            "nextDialogs": [
              "110320303"
            ]
          },
          "110320303": {
            "id": "110320303",
            "speakerId": 1005,
            "speakerName": "Baixiao",
            "text": "Look... Look who's back!",
            "nextDialogs": [
              "110320304"
            ]
          },
          "110320304": {
            "id": "110320304",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "You even have enough time for leisure? It seems you three are a suitable replacement for me after all.",
            "nextDialogs": [
              "110320305"
            ]
          },
          "110320305": {
            "id": "110320305",
            "speakerId": 1004,
            "speakerName": "Baiwen",
            "text": "Not at all! We just... We've been working for too long. If we didn't take a break...",
            "nextDialogs": [
              "110320306"
            ]
          },
          "110320306": {
            "id": "110320306",
            "speakerId": 1005,
            "speakerName": "Baixiao",
            "text": "We wouldn't have survived long enough to see you again, Ms. Ganyu.",
            "nextDialogs": [
              "110320307"
            ]
          },
          "110320307": {
            "id": "110320307",
            "speakerId": 1003,
            "speakerName": "Baishi",
            "text": "Ms. Ganyu, we've missed you...",
            "nextDialogs": [
              "110320308"
            ]
          },
          "110320308": {
            "id": "110320308",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Ehehe. That's so kind of you all, given we've only met once.",
            "nextDialogs": [
              "110320309"
            ]
          },
          "110320309": {
            "id": "110320309",
            "speakerId": 1004,
            "speakerName": "Baiwen",
            "text": "We've been praying day and night for you to return and take over your duties again.",
            "nextDialogs": [
              "110320310"
            ]
          },
          "110320310": {
            "id": "110320310",
            "speakerId": 1003,
            "speakerName": "Baishi",
            "text": "To us, you're like an adeptus coming down to the human world to save all life.",
            "nextDialogs": [
              "110320311"
            ]
          },
          "110320311": {
            "id": "110320311",
            "speakerId": 1005,
            "speakerName": "Baixiao",
            "text": "Forget all our envious complaints from before — just free us from this strenuous work, please...",
            "nextDialogs": [
              "110320312"
            ]
          },
          "110320312": {
            "id": "110320312",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Alright, alright, I see.",
            "nextDialogs": [
              "110320313"
            ]
          },
          "110320313": {
            "id": "110320313",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Please divide the matters at hand into government affairs, business affairs, and civil affairs. Mark out the tasks that haven't been started and those that are in progress...",
            "nextDialogs": [
              "110320314"
            ]
          },
          "110320314": {
            "id": "110320314",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I'll take care of the rest.",
            "nextDialogs": [
              "110320315"
            ]
          },
          "110320315": {
            "id": "110320315",
            "speakerId": 1004,
            "speakerName": "Baiwen",
            "text": "Of course! We'll do it right away!",
            "nextDialogs": [
              "110320316"
            ]
          },
          "110320316": {
            "id": "110320316",
            "speakerId": 1003,
            "speakerName": "Baishi",
            "text": "Finally... We're saved...",
            "nextDialogs": [
              "110320317"
            ]
          },
          "110320317": {
            "id": "110320317",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Ah, yes, there's one more thing.",
            "nextDialogs": [
              "110320318"
            ]
          },
          "110320318": {
            "id": "110320318",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I'd like to earnestly thank you, Traveler. If it weren't for your companionship, I would still be embroiled in my inner conflict right now.",
            "nextDialogs": [
              "110320321"
            ]
          },
          "110320321": {
            "id": "110320321",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Hehe, to think that I'd gain a human friend outside of work. It makes me happier than I could've imagined.",
            "nextDialogs": [
              "110320322"
            ]
          },
          "110320322": {
            "id": "110320322",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "I'd like to repay you when I'm done with the work at hand. What would you say if I... accompanied you on one of your trips?",
            "nextDialogs": [
              "110320323"
            ]
          },
          "110320323": {
            "id": "110320323",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sure, but... are you ever done with work, Ganyu?",
            "nextDialogs": [
              "110320324"
            ]
          },
          "110320324": {
            "id": "110320324",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Hm...",
            "nextDialogs": [
              "110320325"
            ]
          },
          "110320325": {
            "id": "110320325",
            "speakerId": 1002,
            "speakerName": "Ganyu",
            "text": "Uh, let's cross that bridge when we come to it, shall we..."
          }
        }
      }
    }
  ]
}
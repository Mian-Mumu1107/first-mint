      "dialogue": {
        "startDialogs": [
          "752580101"
        ],
        "dialogs": {
          "752580101": {
            "id": "752580101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Why's there someone passed out here?",
            "nextDialogs": [
              "752580102"
            ]
          },
          "752580102": {
            "id": "752580102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Heeey! Can you hear Paimon? Are you okay?",
            "nextDialogs": [
              "752580103"
            ]
          },
          "752580103": {
            "id": "752580103",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You help the man up, and he slowly regains consciousness...",
            "nextDialogs": [
              "752580104"
            ]
          },
          "752580104": {
            "id": "752580104",
            "speakerId": 21981,
            "speakerName": "Unconscious Employee",
            "text": "Ow, ow, ow...",
            "nextDialogs": [
              "752580107"
            ]
          },
          "752580107": {
            "id": "752580107",
            "speakerId": 21981,
            "speakerName": "Unconscious Employee",
            "text": "Head hurts... How'd I... Lemme think...",
            "nextDialogs": [
              "752580108"
            ]
          },
          "752580108": {
            "id": "752580108",
            "speakerId": 21981,
            "speakerName": "Unconscious Employee",
            "text": "Ah! I remember! I think I got knocked out by someone... but I didn't see who. Wait... It wasn't you, was it!?",
            "nextDialogs": [
              "752580109"
            ]
          },
          "752580109": {
            "id": "752580109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! We're the ones who helped you up! You should be thanking us!",
            "nextDialogs": [
              "752580110"
            ]
          },
          "752580110": {
            "id": "752580110",
            "speakerId": 21981,
            "speakerName": "Unconscious Employee",
            "text": "Oh, sorry... Uhm, I work at the Me & Dew bar. I was originally going to deliver some goods to the port in the north... A merchants' association from Nod-Krai bought some Aphimead from us, you see.",
            "nextDialogs": [
              "752580111"
            ]
          },
          "752580111": {
            "id": "752580111",
            "speakerId": 21981,
            "speakerName": "Unconscious Employee",
            "text": "Oh! No! The Aphimead! It's gone! Did they steal it? Wait, YOU didn't steal it, did you!?",
            "nextDialogs": [
              "752580112"
            ]
          },
          "752580112": {
            "id": "752580112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why do you keep accusing us!?",
            "nextDialogs": [
              "752580113"
            ]
          },
          "752580113": {
            "id": "752580113",
            "speakerId": 21981,
            "speakerName": "Unconscious Employee",
            "text": "Oh, right. Sorry, sorry... I guess it must be the dizziness. Thanks, you two. I need to head back to the bar and tell them what happened...",
            "nextDialogs": [
              "752580114"
            ]
          },
          "752580114": {
            "id": "752580114",
            "speakerId": 21981,
            "speakerName": "Unconscious Employee",
            "text": "If there really are bandits on the loose, you should probably stay away from the northern port. It could be dangerous."
          }
        }
      }
    }
  ]
}
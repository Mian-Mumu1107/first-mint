    {
      "subId": "19023011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902301191"
        ],
        "dialogs": {
          "1902301191": {
            "id": "1902301191",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"At the foot of Mt. Qingce is a Violetgrass that has turned into a gigantic, man-eating monster.\"",
            "nextDialogs": [
              "1902301192"
            ]
          },
          "1902301192": {
            "id": "1902301192",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"There's a ghostly shadow skulking about Feiyun Slope at night. It's suspected to be a vengeful spirit.\"",
            "nextDialogs": [
              "1902301193"
            ]
          },
          "1902301193": {
            "id": "1902301193",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Lurking in Liyue Harbor is a massive demon that was transformed from a popsicle.\""
          }
        }
      }
    },
    {
      "subId": "19023015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902301591"
        ],
        "dialogs": {
          "1902301591": {
            "id": "1902301591",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Deep in the Sea of Clouds, a marauding demon has been raiding commercial fishing boats and building a luxurious palace.\"",
            "nextDialogs": [
              "1902301592"
            ]
          },
          "1902301592": {
            "id": "1902301592",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"In Jueyun Karst, there's a piece of thousand-year-old amber that has gained consciousness and now roams about causing trouble.\"",
            "nextDialogs": [
              "1902301593"
            ]
          },
          "1902301593": {
            "id": "1902301593",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"It's said that people often see a demon who loves eating chilis in Wanmin Restaurant.\""
          }
        }
      }
    },
    {
      "subId": "19023019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902301905"
        ],
        "dialogs": {
          "1902301905": {
            "id": "1902301905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"A strange man wearing a mask and wielding a pole was once seen in the distance around Guili Plains. There's something eerie about his presence.\"",
            "nextDialogs": [
              "1902301906"
            ]
          },
          "1902301906": {
            "id": "1902301906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"I saw an exorcist with blue hair who is actually a transformed demon.\"",
            "nextDialogs": [
              "1902301907"
            ]
          },
          "1902301907": {
            "id": "1902301907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"There is a vigilant demon adept at concealing itself in mist. Recently, people have found traces of it in Mingyun Village, Guili Plains, and Yaoguang Shoal.\""
          }
        }
      }
    },
    {
      "subId": "19023021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902302117"
        ],
        "dialogs": {
          "1902302117": {
            "id": "1902302117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not all rumors are not necessarily fake. Let's have a look around.",
            "nextDialogs": [
              "1902302120"
            ]
          },
          "1902302120": {
            "id": "1902302120",
            "speakerId": 1023,
            "speakerName": "Chongyun",
            "text": "You're right. I just need to stay disciplined.",
            "nextDialogs": [
              "1902302119"
            ]
          },
          "1902302119": {
            "id": "1902302119",
            "speakerId": 1023,
            "speakerName": "Chongyun",
            "text": "*sigh* ...You're right. It's a shame to say that I've grown accustomed to such things. You shouldn't have to comfort me."
          }
        }
      }
    }
  ]

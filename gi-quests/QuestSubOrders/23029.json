  "subQuests": [
    {
      "subId": "2302901",
      "subQuestName": "Talk to Yasmin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230290101"
        ],
        "dialogs": {
          "230290101": {
            "id": "230290101",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "It's about time now...",
            "nextDialogs": [
              "230290102"
            ]
          },
          "230290102": {
            "id": "230290102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you still working on the roots of the Divine Tree?",
            "nextDialogs": [
              "230290103"
            ]
          },
          "230290103": {
            "id": "230290103",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Ah, Traveler, you are always showing up just in time...",
            "nextDialogs": [
              "230290104"
            ]
          },
          "230290104": {
            "id": "230290104",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Many thanks for all your help. The Divine Tree is now in perfect condition.",
            "nextDialogs": [
              "230290105"
            ]
          },
          "230290105": {
            "id": "230290105",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "After discussing the matter with Ladep, we think it should be able to stay in that condition for quite some time.",
            "nextDialogs": [
              "230290106"
            ]
          },
          "230290106": {
            "id": "230290106",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Now we can finally dedicate some time to preparing our theses.",
            "nextDialogs": [
              "230290107"
            ]
          },
          "230290107": {
            "id": "230290107",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "See, I borrowed a Kamera from Pharez, which I am going to use to record the condition of the Divine Tree.",
            "nextDialogs": [
              "230290108"
            ]
          },
          "230290108": {
            "id": "230290108",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Traveler, could you take a picture of the Divine Tree in its entirety? I have marked the spot on your map.",
            "nextDialogs": [
              "230290111"
            ]
          },
          "230290111": {
            "id": "230290111",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Well, it's... too high up for me...",
            "nextDialogs": [
              "230290112"
            ]
          },
          "230290112": {
            "id": "230290112",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "I've always been terrified of being in high places on my own... The feeling of being blown away... Or losing my manuscript to a gust of wind keeps coming to me...",
            "nextDialogs": [
              "230290113"
            ]
          },
          "230290113": {
            "id": "230290113",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Pharez is usually the one up there, but he seems to have other things to attend to right now. You're the only one I can rely on, Traveler."
          }
        }
      }
    },
    {
      "subId": "2302902",
      "subQuestName": "Take a picture of the Divine Tree in its entirety at the designated location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230290201"
        ],
        "dialogs": {
          "230290201": {
            "id": "230290201",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Please take a picture of the Divine Tree in its entirety. I'm counting on you, Traveler."
          }
        }
      }
    },
    {
      "subId": "2302903",
      "subQuestName": "Take a picture of the Divine Tree in its entirety",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2302904",
      "subQuestName": "Report back to Yasmin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230290401"
        ],
        "dialogs": {
          "230290401": {
            "id": "230290401",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "How did it go? Did you take the picture?",
            "nextDialogs": [
              "230290402"
            ]
          },
          "230290402": {
            "id": "230290402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course.",
            "nextDialogs": [
              "230290403"
            ]
          },
          "230290403": {
            "id": "230290403",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Wow! Let me see...",
            "nextDialogs": [
              "230290404"
            ]
          },
          "230290404": {
            "id": "230290404",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Well done. Perfectly angled, and the image is pretty clear as well.",
            "nextDialogs": [
              "230290405"
            ]
          },
          "230290405": {
            "id": "230290405",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Here is your payment. Thank you for helping me, Traveler.",
            "nextDialogs": [
              "230290406"
            ]
          },
          "230290406": {
            "id": "230290406",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "The trunk is fine... And the shape of surrounding branches hasn't changed...",
            "nextDialogs": [
              "230290407"
            ]
          },
          "230290407": {
            "id": "230290407",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Great, I'll wait till Ladep and Pharez finish gathering their data, and we can move on to the next subject."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1300301",
      "subQuestName": "Talk to Katheryne in Sumeru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130030101"
        ],
        "dialogs": {
          "130030101": {
            "id": "130030101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Anyway, so the contaminated region turned out to be a Ley Line effluence deep in the forest. Things are already getting back to normal.",
            "nextDialogs": [
              "130030102"
            ]
          },
          "130030102": {
            "id": "130030102",
            "speakerId": 1001,
            "speakerName": "Katheryne",
            "text": "I see. Thank you for your hard work.",
            "nextDialogs": [
              "130030103"
            ]
          },
          "130030103": {
            "id": "130030103",
            "speakerId": 1001,
            "speakerName": "Katheryne",
            "text": "Once the excess Ley Line energy dissipates from the air, we should be able to make an announcement for residents to resume their normal activities.",
            "nextDialogs": [
              "130030104"
            ]
          },
          "130030104": {
            "id": "130030104",
            "speakerId": 1001,
            "speakerName": "Katheryne",
            "text": "This is the stipulated reward. Please accept it.",
            "nextDialogs": [
              "130030105"
            ]
          },
          "130030105": {
            "id": "130030105",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "After leaving the Adventurers' Guild, Paimon takes you to a quiet place...",
            "nextDialogs": [
              "130030106"
            ]
          },
          "130030106": {
            "id": "130030106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is Karkata... going to be sent back to the Akademiya?",
            "nextDialogs": [
              "130030107"
            ]
          },
          "130030107": {
            "id": "130030107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's already damaged, but Paimon feels sad thinking about it getting disassembled.",
            "nextDialogs": [
              "130030108"
            ]
          },
          "130030108": {
            "id": "130030108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Me too.",
            "nextDialogs": [
              "130030109"
            ]
          },
          "130030109": {
            "id": "130030109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Then how about we find Tighnari tomorrow and ask him to not do that?",
            "nextDialogs": [
              "130030110"
            ]
          },
          "130030110": {
            "id": "130030110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon really wants to go right now, but Tighnari said that we would \"discuss matters tomorrow.\" We'll probably make him mad if we go now, huh?",
            "nextDialogs": [
              "130030111"
            ]
          },
          "130030111": {
            "id": "130030111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Probably.",
            "nextDialogs": [
              "130030112"
            ]
          },
          "130030112": {
            "id": "130030112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright then! We'll find Tighnari tomorrow and tell him not to disassemble Karkata!"
          }
        }
      }
    },
    {
      "subId": "1300302",

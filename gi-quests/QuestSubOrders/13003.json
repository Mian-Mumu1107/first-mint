        ],
        "dialogs": {
          "130039901": {
            "id": "130039901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#How are you feeling {NICKNAME}? Sleep well?",
            "nextDialogs": [
              "130039902"
            ]
          },
          "130039902": {
            "id": "130039902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We should go find Tighnari... Um... How do you think we should ask him...?"

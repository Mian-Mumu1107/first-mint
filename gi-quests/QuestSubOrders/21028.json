        "dialogs": {
          "210280301": {
            "id": "210280301",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Traveler, have you found the Mint?"
          }
        }
      }
    },
    {
      "subId": "2102805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

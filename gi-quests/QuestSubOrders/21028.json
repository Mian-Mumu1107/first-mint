    {
      "subId": "2102804",
      "subQuestName": "Give the Mints to Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210280401"
        ],
        "dialogs": {
          "210280401": {
            "id": "210280401",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Thank you!",
            "nextDialogs": [
              "210280402"
            ]
          },
          "210280402": {
            "id": "210280402",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Yes, these will be enough for me to make some medicine with.",
            "nextDialogs": [
              "210280403"
            ]
          },
          "210280403": {
            "id": "210280403",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "I'll put the heatstroke medicine into the next batch and have them delivered to you.",
            "nextDialogs": [
              "210280404"
            ]
          },
          "210280404": {
            "id": "210280404",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Thanks, Big Brother Gui!",
            "nextDialogs": [
              "210280405"
            ]
          },
          "210280405": {
            "id": "210280405",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "And these are for you, Traveler. Thanks for your help! Let's head back now, shall we?",
            "nextDialogs": [
              "210280406"
            ]
          },
          "210280406": {
            "id": "210280406",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Hehe, Dad will be pleased to hear this, I'm sure of it...",
            "nextDialogs": [
              "210280407"
            ]
          },
          "210280407": {
            "id": "210280407",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "One moment please, Little Meng.",
            "nextDialogs": [
              "210280408"
            ]
          },
          "210280408": {
            "id": "210280408",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Eh? What is it?",
            "nextDialogs": [
              "210280409"
            ]
          },
          "210280409": {
            "id": "210280409",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Weren't you supposed to check the medicines? You still haven't gone through the checklists in the back.",
            "nextDialogs": [
              "210280410"
            ]
          },
          "210280410": {
            "id": "210280410",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Eh... What? I... But I was checking for so long...",
            "nextDialogs": [
              "210280411"
            ]
          },
          "210280411": {
            "id": "210280411",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "And there's more where that came from, Little Meng. Now then, let's continue the reviewing process...",
            "nextDialogs": [
              "210280412"
            ]
          },
          "210280412": {
            "id": "210280412",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Wah... Okay..."
          }
        }
      }
    },
    {
      "subId": "2102805",

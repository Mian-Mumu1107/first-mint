  "subQuests": [
    {
      "subId": "2102801",
      "subQuestName": "Talk to Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210280101"
        ],
        "dialogs": {
          "210280101": {
            "id": "210280101",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Traveler, great timing! I was just looking to ask you something.",
            "nextDialogs": [
              "210280105",
              "210280104"
            ]
          },
          "210280105": {
            "id": "210280105",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "He said that the journey is going to be a long one, and that we'll need some medicine.",
            "nextDialogs": [
              "210280106"
            ]
          },
          "210280106": {
            "id": "210280106",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Stuff for headaches, diarrhea, heatstroke, hangovers, stuff to help digestion... There's just a lot.",
            "nextDialogs": [
              "210280107"
            ]
          },
          "210280107": {
            "id": "210280107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually, why do they need stuff for hangovers...",
            "nextDialogs": [
              "210280108"
            ]
          },
          "210280108": {
            "id": "210280108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's probably for business negotiations.",
            "nextDialogs": [
              "210280109"
            ]
          },
          "210280109": {
            "id": "210280109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? What does hangover medicine have to do with business deals? It's not like business will boom the more you can drink, right?",
            "nextDialogs": [
              "210280110"
            ]
          },
          "210280110": {
            "id": "210280110",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Whatever the case, Dad wants me to go to Bubu Pharmacy to ask if the medicines have been prepared yet.",
            "nextDialogs": [
              "210280111"
            ]
          },
          "210280111": {
            "id": "210280111",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Could you accompany me there? There's something I'd like to ask you for help with."
          },
          "210280104": {
            "id": "210280104",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Well, it's mostly Dad and his friends preparing... But Dad's also given me a task!"
          }
        }
      }
    },
    {
      "subId": "2102802",
      "subQuestName": "Go to Bubu Pharmacy",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210280201"
        ],
        "dialogs": {
          "210280201": {
            "id": "210280201",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Welcome. Are you here to procure a herbal remedy?",
            "nextDialogs": [
              "210280202"
            ]
          },
          "210280202": {
            "id": "210280202",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "...Little Meng? What brings you here today?",
            "nextDialogs": [
              "210280203"
            ]
          },
          "210280203": {
            "id": "210280203",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "...Oh, right. I remember now. You're here about those medicines, yes?",
            "nextDialogs": [
              "210280204"
            ]
          },
          "210280204": {
            "id": "210280204",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Don't worry, they're almost all ready. I'll send them to your father in batches.",
            "nextDialogs": [
              "210280205"
            ]
          },
          "210280205": {
            "id": "210280205",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "That said, his order has drained our reserves of herbs, so some of those medicines will only be ready later.",
            "nextDialogs": [
              "210280206"
            ]
          },
          "210280206": {
            "id": "210280206",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Let me see... Well, the main thing we're low on is Mint, which has put a stop on heatstroke medicine production for now.",
            "nextDialogs": [
              "210280207"
            ]
          },
          "210280207": {
            "id": "210280207",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "I mean, we are also taking medicine orders other than your father's...",
            "nextDialogs": [
              "210280208"
            ]
          },
          "210280208": {
            "id": "210280208",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Then...",
            "nextDialogs": [
              "210280210",
              "210280212"
            ]
          },
          "210280210": {
            "id": "210280210",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Hehe, thanks, Traveler!",
            "nextDialogs": [
              "210280213"
            ]
          },
          "210280213": {
            "id": "210280213",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I'm counting on you to get those herbs! I've got to stay here in the meantime and check those medicines, just like Dad asked me to!",
            "nextDialogs": [
              "210280214"
            ]
          },
          "210280214": {
            "id": "210280214",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Haha, aren't you an earnest kid?",
            "nextDialogs": [
              "210280215"
            ]
          },
          "210280215": {
            "id": "210280215",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Alright then, right this way. I'll go through this batch of medicines with you in detail.",
            "nextDialogs": [
              "210280216"
            ]
          },
          "210280216": {
            "id": "210280216",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Whoa, that's... a lot...",
            "nextDialogs": [
              "210280217"
            ]
          },
          "210280217": {
            "id": "210280217",
            "speakerId": 2103,
            "speakerName": "Herbalist Gui",
            "text": "Have a look at these first. I'll bring the next batch out shortly.",
            "nextDialogs": [
              "210280218"
            ]
          },
          "210280218": {
            "id": "210280218",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Eh? There's more!?"
          },
          "210280212": {
            "id": "210280212",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Hehe, no problem! Thanks, Traveler!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7603601",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760360101"
        ],
        "dialogs": {
          "760360101": {
            "id": "760360101",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Not this blue, then?",
            "nextDialogs": [
              "760360102"
            ]
          },
          "760360102": {
            "id": "760360102",
            "speakerId": 1001,
            "speakerName": "Kuuhenki",
            "text": "...",
            "nextDialogs": [
              "760360105"
            ]
          },
          "760360105": {
            "id": "760360105",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Oh? It's you.",
            "nextDialogs": [
              "760360106"
            ]
          },
          "760360106": {
            "id": "760360106",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Could you help me? I'll be sure to return the favor.",
            "nextDialogs": [
              "760360107"
            ]
          },
          "760360107": {
            "id": "760360107",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Are you kidding? You know you don't owe us anything, right..."
          }
        }
      }
    },
    {
      "subId": "7603602",
      "subQuestName": "Give the kuuhenki some objects with vivid colors",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760360201"
        ],
        "dialogs": {
          "760360201": {
            "id": "760360201",
            "speakerId": 1001,
            "speakerName": "Kuuhenki",
            "text": "!!!",
            "nextDialogs": [
              "760360202"
            ]
          },
          "760360202": {
            "id": "760360202",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Okay, relax, don't worry, we're searching. Colorful plants from Nod-Krai would be the number-one choice, right?"
          }
        }
      }
    },
    {
      "subId": "7603603",
      "subQuestName": "Talk to the kuuhenki",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760360301"
        ],
        "dialogs": {
          "760360301": {
            "id": "760360301",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Will these do?",
            "nextDialogs": [
              "760360302"
            ]
          },
          "760360302": {
            "id": "760360302",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes. The kuuhenki looks quite satisfied.",
            "nextDialogs": [
              "760360303"
            ]
          },
          "760360303": {
            "id": "760360303",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "!",
            "nextDialogs": [
              "760360304"
            ]
          },
          "760360304": {
            "id": "760360304",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Man, Paimon never knew kuuhenki could do art.",
            "nextDialogs": [
              "760360305"
            ]
          },
          "760360305": {
            "id": "760360305",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Kuuhenki are much like us, in truth. Each one has its own personality and hobbies.",
            "nextDialogs": [
              "760360306"
            ]
          },
          "760360306": {
            "id": "760360306",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait, does that mean you can tell all the kuuhenki in Nod-Krai apart from each other?",
            "nextDialogs": [
              "760360307"
            ]
          },
          "760360307": {
            "id": "760360307",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The ones I've met, yes.",
            "nextDialogs": [
              "760360308"
            ]
          },
          "760360308": {
            "id": "760360308",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That's impressive! Especially because, other than Luonnotar, all the other kuuhenki kinda look the same...",
            "nextDialogs": [
              "760360309"
            ]
          },
          "760360309": {
            "id": "760360309",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So, what is this little painter's name?",
            "nextDialogs": [
              "760360310"
            ]
          },
          "760360310": {
            "id": "760360310",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Name...?",
            "nextDialogs": [
              "760360311"
            ]
          },
          "760360311": {
            "id": "760360311",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait... They do have names, don't they?",
            "nextDialogs": [
              "760360312"
            ]
          },
          "760360312": {
            "id": "760360312",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "We recognize each other, and that's enough. We don't need names... I don't have one either.",
            "nextDialogs": [
              "760360313"
            ]
          },
          "760360313": {
            "id": "760360313",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That doesn't mean mean you have to continue the cycle!",
            "nextDialogs": [
              "760360314"
            ]
          },
          "760360314": {
            "id": "760360314",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... Let's think... \"Luonnotar\" means \"a creature born beneath the Moon Goddess's blessing\"...",
            "nextDialogs": [
              "760360315"
            ]
          },
          "760360315": {
            "id": "760360315",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So... What would \"painting\" be in the language of the Frostmoon Scions?",
            "nextDialogs": [
              "760360316"
            ]
          },
          "760360316": {
            "id": "760360316",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I think it would be... Maa... naus? Maalaus? Yes. Maalaus.",
            "nextDialogs": [
              "760360317"
            ]
          },
          "760360317": {
            "id": "760360317",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ooh, sounds nice! Let's go with that!",
            "nextDialogs": [
              "760360318"
            ]
          },
          "760360318": {
            "id": "760360318",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "??",
            "nextDialogs": [
              "760360319"
            ]
          },
          "760360319": {
            "id": "760360319",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What is it, Maalaus? Done with your painting?",
            "nextDialogs": [
              "760360320"
            ]
          },
          "760360320": {
            "id": "760360320",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "!!!",
            "nextDialogs": [
              "760360321"
            ]
          },
          "760360321": {
            "id": "760360321",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ooh! Let's see, let's see... Whoa. What in the...!",
            "nextDialogs": [
              "760360322"
            ]
          },
          "760360322": {
            "id": "760360322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "760360323"
            ]
          },
          "760360323": {
            "id": "760360323",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "This is amazing!",
            "nextDialogs": [
              "760360324"
            ]
          },
          "760360324": {
            "id": "760360324",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon was expecting something a lot more childish... or, y'know, Melusine-like...",
            "nextDialogs": [
              "760360325"
            ]
          },
          "760360325": {
            "id": "760360325",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The kuuhenki are adept at sensing their surroundings. When it comes to recreating what they've seen, they tend to capture things exactly as they were.",
            "nextDialogs": [
              "760360326"
            ]
          },
          "760360326": {
            "id": "760360326",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, is this a drawing of Columbina, Maalaus?",
            "nextDialogs": [
              "760360327"
            ]
          },
          "760360327": {
            "id": "760360327",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "!!!",
            "nextDialogs": [
              "760360328"
            ]
          },
          "760360328": {
            "id": "760360328",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hm...?",
            "nextDialogs": [
              "760360329"
            ]
          },
          "760360329": {
            "id": "760360329",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...It looks like Columbina when she was first born.",
            "nextDialogs": [
              "760360330"
            ]
          },
          "760360330": {
            "id": "760360330",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Huh?",
            "nextDialogs": [
              "760360331"
            ]
          },
          "760360331": {
            "id": "760360331",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Lauma said your birth was recorded by the Frostmoon Scions... But, this painting does look a bit different.",
            "nextDialogs": [
              "760360334"
            ]
          },
          "760360334": {
            "id": "760360334",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "This little one, Maalaus, was one of the first kuuhenki born. It's possible this is Maalaus' interpretation of how things looked back then.",
            "nextDialogs": [
              "760360335"
            ]
          },
          "760360335": {
            "id": "760360335",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Seems like you're trying to help us get to know your goddess, huh, Maalaus?",
            "nextDialogs": [
              "760360336"
            ]
          },
          "760360336": {
            "id": "760360336",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "!",
            "nextDialogs": [
              "760360337"
            ]
          },
          "760360337": {
            "id": "760360337",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760360338"
            ]
          },
          "760360338": {
            "id": "760360338",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Don't worry, Maalaus. We appreciate it! We're all friends here!",
            "nextDialogs": [
              "760360339"
            ]
          },
          "760360339": {
            "id": "760360339",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "!!!",
            "nextDialogs": [
              "760360340"
            ]
          },
          "760360340": {
            "id": "760360340",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow, that was quick. You've finished another painting already?",
            "nextDialogs": [
              "760360341"
            ]
          },
          "760360341": {
            "id": "760360341",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...?",
            "nextDialogs": [
              "760360342"
            ]
          },
          "760360342": {
            "id": "760360342",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "This... must depict the Frostmoon Scions worshipping Columbina as their goddess.",
            "nextDialogs": [
              "760360343"
            ]
          },
          "760360343": {
            "id": "760360343",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm? What's she doing by the altar? The details are too small to make out.",
            "nextDialogs": [
              "760360344"
            ]
          },
          "760360344": {
            "id": "760360344",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "!",
            "nextDialogs": [
              "760360345"
            ]
          },
          "760360345": {
            "id": "760360345",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, so she was eating the offerings!",
            "nextDialogs": [
              "760360346"
            ]
          },
          "760360346": {
            "id": "760360346",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...Was I not supposed to?",
            "nextDialogs": [
              "760360347"
            ]
          },
          "760360347": {
            "id": "760360347",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, no no no. It's just a bit, um... unconventional?",
            "nextDialogs": [
              "760360348"
            ]
          },
          "760360348": {
            "id": "760360348",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like you were having a good time...",
            "nextDialogs": [
              "760360349"
            ]
          },
          "760360349": {
            "id": "760360349",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Well... They were delicious...",
            "nextDialogs": [
              "760360350"
            ]
          },
          "760360350": {
            "id": "760360350",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Fair point.",
            "nextDialogs": [
              "760360351"
            ]
          },
          "760360351": {
            "id": "760360351",
            "speakerId": 1003,
            "speakerName": "Maalaus",
            "text": "!",
            "nextDialogs": [
              "760360352"
            ]
          },
          "760360352": {
            "id": "760360352",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes, I understand.",
            "nextDialogs": [
              "760360353"
            ]
          },
          "760360353": {
            "id": "760360353",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Give me your hand."
          }
        }
      }
    },
    {
      "subId": "7603699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

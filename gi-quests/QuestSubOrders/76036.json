        ],
        "dialogs": {
          "760369901": {
            "id": "760369901",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Last time, Columbina told us a whole bunch about the Fatui. Wonder what sort of things she'll talk about today... Let's hope she's in the mood to share!",
            "nextDialogs": [
              "760369902"
            ]
          },
          "760369902": {
            "id": "760369902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Columbina?",
            "nextDialogs": [
              "760369903"
            ]
          },
          "760369903": {
            "id": "760369903",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh, it looks like something's bothering her!",
            "nextDialogs": [
              "760369904"
            ]
          },
          "760369904": {
            "id": "760369904",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Is it this one?",
            "nextDialogs": [
              "760369905"
            ]
          },
          "760369905": {
            "id": "760369905",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Not this one either, then?",
            "nextDialogs": [
              "760369906"
            ]
          },
          "760369906": {
            "id": "760369906",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "What about this?"
          }
        }
      }
    }
  ]

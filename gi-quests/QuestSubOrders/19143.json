    {
      "subId": "1914301",
      "subQuestName": "Track Mamoru and the others down",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191430901"
        ],
        "dialogs": {
          "191430901": {
            "id": "191430901",
            "speakerId": 1004,
            "speakerName": "Aikawa Susumu",
            "text": "I was just doing some cleaning when I suddenly heard a loud noise outside.",
            "nextDialogs": [
              "191430902"
            ]
          },
          "191430902": {
            "id": "191430902",
            "speakerId": 1004,
            "speakerName": "Aikawa Susumu",
            "text": "I got to the door just in time to see <color=#00E1FFFF>a shadowy figure disappear up that tree</color>!",
            "nextDialogs": [
              "191430903"
            ]
          },
          "191430903": {
            "id": "191430903",
            "speakerId": 1004,
            "speakerName": "Aikawa Susumu",
            "text": "This is a busy street... Surely it wouldn't be a burglar, would it...?"
          }
        }
      }
    },
    {

    {
      "subId": "1914304",
      "subQuestName": "Track Genta and whoever else is with him down",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191431001"
        ],
        "dialogs": {
          "191431001": {
            "id": "191431001",
            "speakerId": 1000,
            "speakerName": "Souta",
            "text": "What are we gonna do? Do we really have to give up on playing Genius Invokation today?",
            "nextDialogs": [
              "191431002"
            ]
          },
          "191431002": {
            "id": "191431002",
            "speakerId": 1002,
            "speakerName": "Eita",
            "text": "We could try playing somewhere else. But where else apart from under the bridge can we escape from the grown-ups?",
            "nextDialogs": [
              "191431003"
            ]
          },
          "191431003": {
            "id": "191431003",
            "speakerId": 1000,
            "speakerName": "Souta",
            "text": "Oh, I know! We can get Yoimiya to set off some fireworks and scare off the guy that took our spot!",
            "nextDialogs": [
              "191431004"
            ]
          },
          "191431004": {
            "id": "191431004",
            "speakerId": 1002,
            "speakerName": "Eita",
            "text": "That's kinda mean... Although, he kicked us out first...",
            "nextDialogs": [
              "191431005"
            ]
          },
          "191431005": {
            "id": "191431005",
            "speakerId": 1000,
            "speakerName": "Souta",
            "text": "Yeah, so it's his own fault!",
            "nextDialogs": [
              "191431006"
            ]
          },
          "191431006": {
            "id": "191431006",
            "speakerId": 1001,
            "speakerName": "Yuma",
            "text": "I think... maybe we should just go home and do our homework?",
            "nextDialogs": [
              "191431007"
            ]
          },
          "191431007": {
            "id": "191431007",
            "speakerId": 1001,
            "speakerName": "Yuma",
            "text": "People who spend all their time playing and never studying turn into <color=#00E1FFFF>the kind of grown-ups who hang out under bridges</color>, too..."
          }
        }
      }
    },

        ],
        "dialogs": {
          "191431101": {
            "id": "191431101",
            "speakerId": 1003,
            "speakerName": "Kuki Shinobu",
            "text": "Alright you two, stay here, you understand? No running off.",
            "nextDialogs": [
              "191431102"
            ]
          },
          "191431102": {
            "id": "191431102",
            "speakerId": 1006,
            "speakerName": "Mamoru",
            "text": "You can count on that... We ain't going anywhere right now...",
            "nextDialogs": [
              "191431103"
            ]
          },
          "191431103": {
            "id": "191431103",
            "speakerId": 1003,
            "speakerName": "Kuki Shinobu",
            "text": "Yes, I can see that. But you'd better not change your mind once you've caught your breath.",
            "nextDialogs": [
              "191431104"
            ]
          },
          "191431104": {
            "id": "191431104",
            "speakerId": 1007,
            "speakerName": "Genta",
            "text": "We won't! Never again!"
          }
        }
      }

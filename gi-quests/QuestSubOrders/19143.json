        "dialogs": {
          "191430101": {
            "id": "191430101",
            "speakerId": 1005,
            "speakerName": "Matsumoto",
            "text": "Did I see anyone come by this way? Sorry, I was concentrating on my lemon water tasting...",
            "nextDialogs": [
              "191430102"
            ]
          },
          "191430102": {
            "id": "191430102",
            "speakerId": 1005,
            "speakerName": "Matsumoto",
            "text": "Your best bet would probably be to ask someone at the bathhouse across the road."
          }
        }

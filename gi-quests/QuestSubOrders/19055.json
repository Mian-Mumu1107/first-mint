  "subQuests": [
    {
      "subId": "1905516",
      "subQuestName": "Wait until night (20:00 – 24:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190551601"
        ],
        "dialogs": {
          "190551601": {
            "id": "190551601",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "#I apologize again for not being completely honest with you, {NICKNAME}. I truly am sorry, but... I had to do it.",
            "nextDialogs": [
              "190551602"
            ]
          },
          "190551602": {
            "id": "190551602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I understand.",
            "nextDialogs": [
              "190551603"
            ]
          },
          "190551603": {
            "id": "190551603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "By the way, does Kokomi know about all this?",
            "nextDialogs": [
              "190551604"
            ]
          },
          "190551604": {
            "id": "190551604",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "Ah yes, Her Excellency... Well, let's just say that the war brought many terrible things while also forcing us to learn a lot.",
            "nextDialogs": [
              "190551605"
            ]
          },
          "190551605": {
            "id": "190551605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right, but that still doesn't answer the question.",
            "nextDialogs": [
              "190551606"
            ]
          },
          "190551606": {
            "id": "190551606",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "Well, ahem... aren't you curious about who's been pushing for the new commodity bill? It certainly isn't the Kanjou Commission, because it doesn't immediately benefit them, and we don't have any connections there.",
            "nextDialogs": [
              "190551607"
            ]
          },
          "190551607": {
            "id": "190551607",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah... it's kinda as if the gods suddenly appeared to offer you a divine hand.",
            "nextDialogs": [
              "190551608"
            ]
          },
          "190551608": {
            "id": "190551608",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "Haha, yeah, the gods...",
            "nextDialogs": [
              "190551609"
            ]
          },
          "190551609": {
            "id": "190551609",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "I was invited to attend the Irodori Festival on Narukami Island with Her Excellency a while back.",
            "nextDialogs": [
              "190551610"
            ]
          },
          "190551610": {
            "id": "190551610",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "At the festival, I waited in the marketplace while Her Excellency..."
          }
        }
      }
    },
    {
      "subId": "1905501",
      "subQuestName": "Head to Bourou Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190550901"
        ],
        "dialogs": {
          "190550901": {
            "id": "190550901",
            "speakerId": 1002,
            "speakerName": "Tokuda",
            "text": "Todoroki, the shipment has arrived and is ready for inspection.",
            "nextDialogs": [
              "190550902"
            ]
          },
          "190550902": {
            "id": "190550902",
            "speakerId": 1003,
            "speakerName": "Todoroki",
            "text": "Good, let's go.",
            "nextDialogs": [
              "190550903"
            ]
          },
          "190550903": {
            "id": "190550903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, it's Todo... mmph!",
            "nextDialogs": [
              "190550904"
            ]
          },
          "190550904": {
            "id": "190550904",
            "speakerId": 1004,
            "speakerName": "Shikanoin Heizou",
            "text": "Shh! Keep quiet. Let's follow him and see where he leads us."
          }
        }
      }
    },
    {
      "subId": "1905503",
      "subQuestName": "Follow Todoroki and Tokuda",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1905504",
      "subQuestName": "Listen in on Todoroki and Tokuda's conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190551001"
        ],
        "dialogs": {
          "190551001": {
            "id": "190551001",
            "speakerId": 1002,
            "speakerName": "Tokuda",
            "text": "Your intel was spot on. When we arrived, the Nobushi were all still asleep, haha.",
            "nextDialogs": [
              "190551002"
            ]
          },
          "190551002": {
            "id": "190551002",
            "speakerId": 1002,
            "speakerName": "Tokuda",
            "text": "We captured them all, and the goods were retrieved and brought back here.",
            "nextDialogs": [
              "190551003"
            ]
          },
          "190551003": {
            "id": "190551003",
            "speakerId": 1003,
            "speakerName": "Todoroki",
            "text": "I'll take a look. Hmm... Everything seems in order, good work.",
            "nextDialogs": [
              "190551004"
            ]
          },
          "190551004": {
            "id": "190551004",
            "speakerId": 1002,
            "speakerName": "Tokuda",
            "text": "It's nothing. Thanks to the efforts of your caravan, the price of grain in the village has decreased.",
            "nextDialogs": [
              "190551005"
            ]
          },
          "190551005": {
            "id": "190551005",
            "speakerId": 1005,
            "speakerName": "Masashi",
            "text": "That's right, and who would have thought that the injuries we sustained during the war would have such a lingering effect on our bodies. But thankfully, you also brought back some life-saving medicine.",
            "nextDialogs": [
              "190551006"
            ]
          },
          "190551006": {
            "id": "190551006",
            "speakerId": 1003,
            "speakerName": "Todoroki",
            "text": "Things are improving thanks to the help from those up top. By the way, what is the state of the village's inventory?",
            "nextDialogs": [
              "190551007"
            ]
          },
          "190551007": {
            "id": "190551007",
            "speakerId": 1003,
            "speakerName": "Todoroki",
            "text": "Make sure that it's confirmed tonight, I have to leave tomorrow morning after I go to the Sangonomiya Shrine and get instructions from General Gorou.",
            "nextDialogs": [
              "190551008"
            ]
          },
          "190551008": {
            "id": "190551008",
            "speakerId": 1005,
            "speakerName": "Masashi",
            "text": "Don't worry. We've already prepared the list. Just follow us."
          }
        }
      }
    },
    {
      "subId": "1905514",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190551401"
        ],
        "dialogs": {
          "190551401": {
            "id": "190551401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This box is packed so tight, it looks like it could burst. Let's see what's inside.",
            "nextDialogs": [
              "190551402"
            ]
          },
          "190551402": {
            "id": "190551402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What are all these plants and flowers? Oh, there's a small note here.",
            "nextDialogs": [
              "190551403"
            ]
          },
          "190551403": {
            "id": "190551403",
            "speakerId": 1006,
            "speakerName": "Torn Bill",
            "text": "(A torn bill. The handwriting has been smudged by water stains, making it difficult to read. Only a faint outline of the words \"Foreign Trade Association\" can be seen at the signature.)"
          }
        }
      }
    },

    {
      "subId": "1905517",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190551701"
        ],
        "dialogs": {
          "190551701": {
            "id": "190551701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Went to see Lady Yae.",
            "nextDialogs": [
              "190551702"
            ]
          },
          "190551702": {
            "id": "190551702",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "Yeah.",
            "nextDialogs": [
              "190551802"
            ]
          },
          "190551802": {
            "id": "190551802",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "She went to the Kanjou Commission to see Lady Yae — purportedly for a book review, but there were other items on the agenda, too. The meeting wasn't made public.",
            "nextDialogs": [
              "190551803"
            ]
          },
          "190551803": {
            "id": "190551803",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "Following her return, we began our attempts at boosting commercial activity, and it wasn't long before there was a push for a new commodity bill on Narukami Island...",
            "nextDialogs": [
              "190551804"
            ]
          },
          "190551804": {
            "id": "190551804",
            "speakerId": 1000,
            "speakerName": "Gorou",
            "text": "So, what do you make of it? Do you think Her Excellency knows about this?"
          }
        }
      }
    },

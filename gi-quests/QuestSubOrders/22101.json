  },
  "subQuests": [
    {
      "subId": "2210101",
      "subQuestName": "Talk to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221010101"
        ],
        "dialogs": {
          "221010101": {
            "id": "221010101",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "*sigh* It's just one thing after another...",
            "nextDialogs": [
              "221010102"
            ]
          },
          "221010102": {
            "id": "221010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "221010103"
            ]
          },
          "221010103": {
            "id": "221010103",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "This location... It's a real challenge to run an inn here.",
            "nextDialogs": [
              "221010104"
            ]
          },
          "221010104": {
            "id": "221010104",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "It could just be me, but I feel like we're seeing more and more monsters around these parts recently.",
            "nextDialogs": [
              "221010105"
            ]
          },
          "221010105": {
            "id": "221010105",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "They wouldn't dare come anywhere near the inn itself, but guests need to get in and out and the Millelith can't be here all the time.",
            "nextDialogs": [
              "221010106"
            ]
          },
          "221010106": {
            "id": "221010106",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "If you're free, do you think you could take a look around and clear out any monsters nearby?",
            "nextDialogs": [
              "221010109",
              "221010110"
            ]
          },
          "221010109": {
            "id": "221010109",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Haha... Ah, I must say I do find your forthrightness refreshing...",
            "nextDialogs": [
              "221010113"
            ]
          },
          "221010113": {
            "id": "221010113",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Speaking of tiring jobs... I do feel bad making you do this.",
            "nextDialogs": [
              "221010114"
            ]
          },
          "221010114": {
            "id": "221010114",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "But I promise I will make it worth your time.",
            "nextDialogs": [
              "221010115"
            ]
          },
          "221010115": {
            "id": "221010115",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Best of luck, and thank you."
          },
          "221010110": {
            "id": "221010110",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Yes, we should have known what we were getting into when we chose the location.",
            "nextDialogs": [
              "221010111"
            ]
          },
          "221010111": {
            "id": "221010111",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "But then, where would passing travelers stay if it weren't for us?",
            "nextDialogs": [
              "221010112"
            ]
          },
          "221010112": {
            "id": "221010112",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "It's a tiring job, but a necessary one."
          }
        }
      }
    },
    {
      "subId": "2210102",
      "subQuestName": "Clear out nearby monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221010201"
        ],
        "dialogs": {
          "221010201": {
            "id": "221010201",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "How's it coming along? All clear?",
            "nextDialogs": [
              "221010202"
            ]
          },
          "221010202": {
            "id": "221010202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "221010203"
            ]
          },
          "221010203": {
            "id": "221010203",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Okay. Well, take your time. These monsters may be no end of trouble to people coming and going, but they wouldn't dare set foot in the inn itself.",
            "nextDialogs": [
              "221010204"
            ]
          },
          "221010204": {
            "id": "221010204",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "And in the highly unlikely event that a few of the gutsier ones did venture inside... I'm sure I could, ahem, persuade them to leave. My guests' safety would not be at risk.",
            "nextDialogs": [
              "221010205"
            ]
          },
          "221010205": {
            "id": "221010205",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "No one runs an inn this far out of town unless they know a bit of self-defense!"
          }
        }
      }
    },
    {
      "subId": "2210103",
      "subQuestName": "Report back to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221010301"
        ],
        "dialogs": {
          "221010301": {
            "id": "221010301",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "How's it coming along? All clear?",
            "nextDialogs": [
              "221010302"
            ]
          },
          "221010302": {
            "id": "221010302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All clear.",
            "nextDialogs": [
              "221010303"
            ]
          },
          "221010303": {
            "id": "221010303",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Great. Thanks a lot.",
            "nextDialogs": [
              "221010304"
            ]
          },
          "221010304": {
            "id": "221010304",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Here's your payment.",
            "nextDialogs": [
              "221010305"
            ]
          },
          "221010305": {
            "id": "221010305",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "These days, honestly... If I hadn't done martial arts since I was a kid, I wouldn't dream about working in the hospitality sector."
          }
        }
      }
    }
  ]
}
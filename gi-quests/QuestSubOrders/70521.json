          },
          "705210102": {
            "id": "705210102",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Ah. Found you.",
            "nextDialogs": [
              "705210103"
            ]
          },
          "705210103": {
            "id": "705210103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Wait, you came here looking for us?",
            "nextDialogs": [
              "705210104"
            ]
          },
          "705210104": {
            "id": "705210104",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Of course! Do you have any idea how popular your charity stall is? Everyone's been talking about it...",
            "nextDialogs": [
              "705210105"
            ]
          },
          "705210105": {
            "id": "705210105",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "\"Favonian Goodies and Buddies, run by the Honorary Knight and their sidekick, is selling all kinds of fantastic treasures — and even giving away some wonderful others for FREE! Don't miss out!\"",
            "nextDialogs": [
              "705210106"
            ]
          },
          "705210106": {
            "id": "705210106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, so after all that, Paimon's back to being the sidekick? Hmm... Still, Paimon's really happy to hear that people are giving good reviews!",
            "nextDialogs": [
              "705210109"
            ]
          },
          "705210109": {
            "id": "705210109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, what have you two been up to these days? Did you go off on a trip or something? We haven't seen you around all festival.",
            "nextDialogs": [
              "705210110"
            ]
          },
          "705210110": {
            "id": "705210110",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Haha, that's because we're still working.",
            "nextDialogs": [
              "705210111"
            ]
          },
          "705210111": {
            "id": "705210111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? You still have to work?"
          }
        }
      }
    },

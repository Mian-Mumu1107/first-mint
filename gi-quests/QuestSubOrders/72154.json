  "subQuests": [
    {
      "subId": "7215401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540101"
        ],
        "dialogs": {
          "721540101": {
            "id": "721540101",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Wait! Ah, Sir Soldier, the line you just read lacks the right emotional gravitas.",
            "nextDialogs": [
              "721540102"
            ]
          },
          "721540102": {
            "id": "721540102",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "\"Samurai, like the wind sweeping the earth.\"",
            "nextDialogs": [
              "721540103"
            ]
          },
          "721540103": {
            "id": "721540103",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Do you still remember what I said about the play? It is supposed to feel liberating and give the audience a sense of the vicissitudes of life. I said liberating! Liberating, you understand?",
            "nextDialogs": [
              "721540104"
            ]
          },
          "721540104": {
            "id": "721540104",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "This line is key to the whole play. You must express your emotions completely, fully, and perfectly!",
            "nextDialogs": [
              "721540105"
            ]
          },
          "721540105": {
            "id": "721540105",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "Uh...",
            "nextDialogs": [
              "721540106"
            ]
          },
          "721540106": {
            "id": "721540106",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Moreover, don't swing your sword in such haste... Make sure you are in view, otherwise, the Film Kamera will not be able to capture your movements at all.",
            "nextDialogs": [
              "721540107"
            ]
          },
          "721540107": {
            "id": "721540107",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Pose, and then pause, okay? Stop for a moment, then slice downwards with great force.",
            "nextDialogs": [
              "721540108"
            ]
          },
          "721540108": {
            "id": "721540108",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "But you can't swing your sword like that when you fight against people...",
            "nextDialogs": [
              "721540109"
            ]
          },
          "721540109": {
            "id": "721540109",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "True, but you have to tailor your acting to the production's needs.",
            "nextDialogs": [
              "721540110"
            ]
          },
          "721540110": {
            "id": "721540110",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Well then. Please ready up, and we shall give this another go...",
            "nextDialogs": [
              "721540114",
              "721540113"
            ]
          },
          "721540114": {
            "id": "721540114",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "#Oh, it's you! Ah, my dear {F#girl}{M#boy}, a fair wind must have blown you here.",
            "nextDialogs": [
              "721540115"
            ]
          },
          "721540115": {
            "id": "721540115",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "As you can see, I'm shooting a swashbuckler film with our good soldier here. I call it \"The Seventh Samurai.\"",
            "nextDialogs": [
              "721540116"
            ]
          },
          "721540116": {
            "id": "721540116",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Oh, \"swashbuckler film\" is what I'm calling films of this genre.",
            "nextDialogs": [
              "721540117"
            ]
          },
          "721540117": {
            "id": "721540117",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "This sort of film shall have sword-fighting scenes, and it shall take the viewers on an incredible journey across the battlefield... Well, that's the idea, at least!"
          },
          "721540113": {
            "id": "721540113",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "You said those words with too much passion. It should be..."
          }
        }
      }
    },
    {
      "subId": "7215405",
      "subQuestName": "Talk to Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540601"
        ],
        "dialogs": {
          "721540601": {
            "id": "721540601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ready when you are.",
            "nextDialogs": [
              "721540602"
            ]
          },
          "721540602": {
            "id": "721540602",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Wonderful, bravo! In that case, let's begin!",
            "nextDialogs": [
              "721540603"
            ]
          },
          "721540603": {
            "id": "721540603",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "I shall make a few adjustments to the Film Kamera and call the soldiers back..."
          }
        }
      }
    },
    {
      "subId": "7215402",
      "subQuestName": "Help Xavier produce a film",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540201"
        ],
        "dialogs": {
          "721540201": {
            "id": "721540201",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Oh dear me, this film doesn't seem to have come out right...",
            "nextDialogs": [
              "721540202"
            ]
          },
          "721540202": {
            "id": "721540202",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Please get ready again, and we shall give it another go."
          }
        }
      }
    },
    {
      "subId": "7215404",
      "subQuestName": "Talk to Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540901"
        ],
        "dialogs": {
          "721540901": {
            "id": "721540901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready.",
            "nextDialogs": [
              "721540902"
            ]
          },
          "721540902": {
            "id": "721540902",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Wonderful, bravo! In that case, let's begin!",
            "nextDialogs": [
              "721540903"
            ]
          },
          "721540903": {
            "id": "721540903",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "I shall make a few adjustments to the Film Kamera and call the soldiers back..."
          }
        }
      }
    },
    {
      "subId": "7215403",
      "subQuestName": "Talk to Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540301"
        ],
        "dialogs": {
          "721540301": {
            "id": "721540301",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "#Perfect! As expected of the {F#heroine}{M#hero} of my heart! A perfect demonstration! You truly are a star!",
            "nextDialogs": [
              "721540303",
              "721540305"
            ]
          },
          "721540303": {
            "id": "721540303",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "A star! That is to say, the most important actor in a film.",
            "nextDialogs": [
              "721540306"
            ]
          },
          "721540306": {
            "id": "721540306",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Now then, Mr. Soldier. You saw that demonstration clearly, I trust?",
            "nextDialogs": [
              "721540307"
            ]
          },
          "721540307": {
            "id": "721540307",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "On the whole, yes. When swinging my blade, I should focus not so much on the \"action,\" itself, but on the \"posture,\" yes?",
            "nextDialogs": [
              "721540308"
            ]
          },
          "721540308": {
            "id": "721540308",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "If you only require the \"posture\"... I have some ideas about that.",
            "nextDialogs": [
              "721540309"
            ]
          },
          "721540309": {
            "id": "721540309",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Oh? That's wonderful! Please discuss the matter with your fellow soldiers, and we'll do another take in a while.",
            "nextDialogs": [
              "721540310"
            ]
          },
          "721540310": {
            "id": "721540310",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "You have my utmost gratitude for your help, Traveler. Here. These are for you.",
            "nextDialogs": [
              "721540311"
            ]
          },
          "721540311": {
            "id": "721540311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the theme of your next film?",
            "nextDialogs": [
              "721540312"
            ]
          },
          "721540312": {
            "id": "721540312",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "The next film, hmm? Well... Actually, I'm quite torn on what its topic should be myself.",
            "nextDialogs": [
              "721540313"
            ]
          },
          "721540313": {
            "id": "721540313",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Should we do one about the various traditions of the Grand Narukami Shrine? Or the tales of the kitsune and the tanuki?",
            "nextDialogs": [
              "721540314"
            ]
          },
          "721540314": {
            "id": "721540314",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "There are so many islands here in Inazuma, and so many stories to be told!",
            "nextDialogs": [
              "721540315"
            ]
          },
          "721540315": {
            "id": "721540315",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "But regardless, I have to finish producing \"The Seventh Samurai\" first.",
            "nextDialogs": [
              "721540316"
            ]
          },
          "721540316": {
            "id": "721540316",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "If this satisfies those fellows upstairs, I do suspect that future film projects shall progress much more smoothly."
          },
          "721540305": {
            "id": "721540305",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "No problem at all! Once this film has been completed, we should start planning a whole new one."
          }
        }
      }
    },
    {
      "subId": "7215404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540401"
        ],
        "dialogs": {
          "721540401": {
            "id": "721540401",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "A \"swashbuckler film,\" huh. Mr. Xavier sure does have interesting taste in names.",
            "nextDialogs": [
              "721540403",
              "721540408"
            ]
          },
          "721540403": {
            "id": "721540403",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "Our superiors believe that these films will help to increase the Shogunate's prestige.",
            "nextDialogs": [
              "721540404"
            ]
          },
          "721540404": {
            "id": "721540404",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "Perhaps I am simply a little slow on the uptake... but I do not see how this is the case.",
            "nextDialogs": [
              "721540405"
            ]
          },
          "721540405": {
            "id": "721540405",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "This script is full of these... pessimistic lines. There is nothing of samurai dignity here.",
            "nextDialogs": [
              "721540406"
            ]
          },
          "721540406": {
            "id": "721540406",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "Who knows what they were thinking, that they agreed to all this..."
          },
          "721540408": {
            "id": "721540408",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "Ever since Sir Hanbei's \"promotion,\" Yousuke has taken over as the person in charge.",
            "nextDialogs": [
              "721540409"
            ]
          },
          "721540409": {
            "id": "721540409",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "He is a craftsman by birth and trade, and is very down-to-earth and steady. He gets things done, as well.",
            "nextDialogs": [
              "721540410"
            ]
          },
          "721540410": {
            "id": "721540410",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "With the Mikage Furnace under his management, I doubt there will be any further problems."
          }
        }
      }
    },
    {
      "subId": "7215405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540501"
        ],
        "dialogs": {
          "721540501": {
            "id": "721540501",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "So, are you ready?"
          }
        }
      }
    },
    {
      "subId": "7215407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540701"
        ],
        "dialogs": {
          "721540701": {
            "id": "721540701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not quite ready yet...",
            "nextDialogs": [
              "721540702"
            ]
          },
          "721540702": {
            "id": "721540702",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Well, don't worry. Take your time — just let me know when you're ready."
          }
        }
      }
    },
    {
      "subId": "7215408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540801"
        ],
        "dialogs": {
          "721540801": {
            "id": "721540801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you mean to capture through film?",
            "nextDialogs": [
              "721540802"
            ]
          },
          "721540802": {
            "id": "721540802",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Aha! That's a fine question. A fine question indeed. But to be honest, I have yet to think it all through, either.",
            "nextDialogs": [
              "721540803"
            ]
          },
          "721540803": {
            "id": "721540803",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "I believe that films can be about anything.",
            "nextDialogs": [
              "721540804"
            ]
          },
          "721540804": {
            "id": "721540804",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Romance! Suspense! Combat! Even all manner of baseless legends can be the subject of films.",
            "nextDialogs": [
              "721540805"
            ]
          },
          "721540805": {
            "id": "721540805",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Though I must say that I think films have some sort of charm that I have yet to fully bring out.",
            "nextDialogs": [
              "721540806"
            ]
          },
          "721540806": {
            "id": "721540806",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Still, I believe that I will find the answer to that question as long as I keep making films."
          }
        }
      }
    },

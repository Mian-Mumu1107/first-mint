          "4690002": {
            "id": "4690002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's make an offering and see if the gods respond!",
            "nextDialogs": [
              "4690003"
            ]
          },
          "4690003": {
            "id": "4690003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, it's one of those consolidated wind thingies...",
            "nextDialogs": [

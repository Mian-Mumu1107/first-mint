            ]
          },
          "4690004": {
            "id": "4690004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, let's head back to the Statue of The Seven at Windrise and offer it to the gods!",
            "nextDialogs": [

    {
      "subId": "46902",
      "subQuestName": "Offer the Anemoculus to the Statue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4690201"
        ],
        "dialogs": {
          "4690201": {
            "id": "4690201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Can you feel the blessings of The Seven?",
            "nextDialogs": [
              "4690202"
            ]
          },
          "4690202": {
            "id": "4690202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "In Mondstadt, people refer to the consolidated wind as Anemoculi.",
            "nextDialogs": [
              "4690203"
            ]
          },
          "4690203": {
            "id": "4690203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They're called this because they can be fitted into the statue's eyes.",
            "nextDialogs": [
              "4690204"
            ]
          },
          "4690204": {
            "id": "4690204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Some fairy tales say the statues' eyes originally had gems that were taken by swallows.",
            "nextDialogs": [
              "4690205"
            ]
          },
          "4690205": {
            "id": "4690205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Anemoculi never had a physical form from the start.",
            "nextDialogs": [
              "4690207"
            ]
          },
          "4690207": {
            "id": "4690207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "People with Visions collect them to offer to the statues in exchange for blessings.",
            "nextDialogs": [
              "4690208"
            ]
          },
          "4690208": {
            "id": "4690208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Unlike others with powers, you don't have a Vision. But then the rules of this world don't apply to you anyway so...",
            "nextDialogs": [
              "4690209"
            ]
          },
          "4690209": {
            "id": "4690209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Keep offering Anemoculi, and maybe you'll receive more blessings!"
          }
        }
      }
    },

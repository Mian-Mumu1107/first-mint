    {
      "subId": "7620299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762029904"
        ],
        "dialogs": {
          "762029904": {
            "id": "762029904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look, it's that ball of light again! Let's follow it!",
            "nextDialogs": [
              "762029905"
            ]
          },
          "762029905": {
            "id": "762029905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, it disappeared behind that door! Does that mean we can open it now?",
            "nextDialogs": [
              "762029906"
            ]
          },
          "762029906": {
            "id": "762029906",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "...And look, the tea's still nice and warm. Mmm, just right, in fact!",
            "nextDialogs": [
              "762029907"
            ]
          },
          "762029907": {
            "id": "762029907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you just plan this whole thing just so you could sit back and enjoy this moment yourself...?",
            "nextDialogs": [
              "762029908"
            ]
          },
          "762029908": {
            "id": "762029908",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Hehe, come now... This is your reward. You were the ones who earned it, after all. Go on, then — open it up!",
            "nextDialogs": [
              "762029909"
            ]
          },
          "762029909": {
            "id": "762029909",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Nicole! Help us out here, will ya!?",
            "nextDialogs": [
              "762029910"
            ]
          },
          "762029910": {
            "id": "762029910",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Alright, alright... \"Heaven's will, made mine\"!"
          }
        }

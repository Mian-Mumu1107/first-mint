    {
      "subId": "7620214",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762021401"
        ],
        "dialogs": {
          "762021401": {
            "id": "762021401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What do you mean, much better!?",
            "nextDialogs": [
              "762021402"
            ]
          },
          "762021402": {
            "id": "762021402",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "#Mm? Come on, it's barely attacking you. You can handle a little spirited tickling, can't you? Besides, this is the perfect opportunity for {NICKNAME} to show off some skills.",
            "nextDialogs": [
              "762021403"
            ]
          },
          "762021403": {
            "id": "762021403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Nicole! Help us out here, will ya!?",
            "nextDialogs": [
              "762021404"
            ]
          },
          "762021404": {
            "id": "762021404",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Alright, alright... \"Heaven's will, made mine\"!"
          }
        }
      }
    },
    {
      "subId": "7620216",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762021601"
        ],
        "dialogs": {
          "762021601": {
            "id": "762021601",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "If you don't mind, could you come back a little while later? I still need to check that the other rooms are all in working order..."
          }
        }
      }
    },

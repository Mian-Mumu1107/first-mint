    {
      "subId": "7620204",
      "subQuestName": "Explore the room",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762020301"
        ],
        "dialogs": {
          "762020301": {
            "id": "762020301",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "A gust of wind suddenly brushes across your face.\\nHow strange... It carries the aroma of Fruit Tandem Turnovers, Midsommar Torte, Crispy Roast, and Berry Herbal Candy.",
            "nextDialogs": [
              "762020302"
            ]
          },
          "762020302": {
            "id": "762020302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh! A gust of super sweet wind just blew right down Paimon's throat! *cough*... Hey! Where are we? That teapot and those cups look really, really big...",
            "nextDialogs": [
              "762020303"
            ]
          },
          "762020303": {
            "id": "762020303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a second... Did we shrink!?",
            "nextDialogs": [
              "762020304"
            ]
          },
          "762020304": {
            "id": "762020304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This feels like Nicole's magic at work.",
            "nextDialogs": [
              "762020305"
            ]
          },
          "762020305": {
            "id": "762020305",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Apologies, I was hoping to invite animal actors, but alas... I'm used to dealing with thespians of a more... \"stony-faced\" persuasion.",
            "nextDialogs": [
              "762020306"
            ]
          },
          "762020306": {
            "id": "762020306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Nicole, you've shrunk, too? Paimon thought you were gonna be huge!",
            "nextDialogs": [
              "762020307"
            ]
          },
          "762020307": {
            "id": "762020307",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Nicole, the Magnificent Massive Mage, propping up the heavens while crouching down to talk? No, thank you! I'm quite happy with my current size.",
            "nextDialogs": [
              "762020308"
            ]
          },
          "762020308": {
            "id": "762020308",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Aaaanyway... Welcome to the Great Mage's Tea Party! Now, pour yourselves some tea!"
          }
        }
      }
    },
    {
      "subId": "7620205",
      "subQuestName": "Use Pyro to heat the teapot",

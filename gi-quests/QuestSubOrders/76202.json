    },
    {
      "subId": "7620206",
      "subQuestName": "Explore the room",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762020601"
        ],
        "dialogs": {
          "762020601": {
            "id": "762020601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Why did it just suddenly slide down like that? And is that a... giant Mandragora statue?",
            "nextDialogs": [
              "762020602"
            ]
          },
          "762020602": {
            "id": "762020602",
            "speakerId": 16015,
            "speakerName": "Mandragora",
            "text": "Clunk...",
            "nextDialogs": [
              "762020603"
            ]
          },
          "762020603": {
            "id": "762020603",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Hold on a moment. Sorry, just a minor technical difficulty. Let me see...",
            "nextDialogs": [
              "762020604"
            ]
          },
          "762020604": {
            "id": "762020604",
            "speakerId": 16015,
            "speakerName": "Mandragora",
            "text": "Click... Clack...",
            "nextDialogs": [
              "762020605"
            ]
          },
          "762020605": {
            "id": "762020605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's moving! Hey! Is this thing attacking us!?",
            "nextDialogs": [
              "762020606"
            ]
          },
          "762020606": {
            "id": "762020606",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Aha, much better..."
          }
        }
      }
    },

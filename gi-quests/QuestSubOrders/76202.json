    {
      "subId": "7620202",
      "subQuestName": "Enter the small lodge",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762020201"
        ],
        "dialogs": {
          "762020201": {
            "id": "762020201",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Welcome.",
            "nextDialogs": [
              "762020204"
            ]
          },
          "762020204": {
            "id": "762020204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, your home's so pretty! Paimon loves what you've done with it!",
            "nextDialogs": [
              "762020205"
            ]
          },
          "762020205": {
            "id": "762020205",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Hehe, I knew you'd appreciate it, Paimon. Hearing that makes it all feel worthwhile, even if I had to squeeze it in during my spare time.",
            "nextDialogs": [
              "762020206"
            ]
          },
          "762020206": {
            "id": "762020206",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "It all started the day I finished building this secret lodge...",
            "nextDialogs": [
              "762020207"
            ]
          },
          "762020207": {
            "id": "762020207",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "I was planning to keep the streak going and build a few more, but there was no one around to inspire me. So after a while, my enthusiasm just sort of... fizzled out.",
            "nextDialogs": [
              "762020208"
            ]
          },
          "762020208": {
            "id": "762020208",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "\"Is there no way to have fun, enjoy myself, and feel like I've accomplished something all at the same time?\" Then the answer suddenly popped into my head!",
            "nextDialogs": [
              "762020209"
            ]
          },
          "762020209": {
            "id": "762020209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, have we skipped straight to the answer?",
            "nextDialogs": [
              "762020210"
            ]
          },
          "762020210": {
            "id": "762020210",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Keep up, Paimon — time waits for no one. Look, it's right in front of your eyes.",
            "nextDialogs": [
              "762020211"
            ]
          },
          "762020211": {
            "id": "762020211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Through this door?",
            "nextDialogs": [
              "762020212"
            ]
          },
          "762020212": {
            "id": "762020212",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Well, not just this door, but you're not wrong. Everything has to start somewhere — what better place than here? Are you ready?",
            "nextDialogs": [
              "762020213"
            ]
          },
          "762020213": {
            "id": "762020213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "W—Wait a minute, you're going too fast! Paimon can't keep up... What are we supposed to be getting ready for?",
            "nextDialogs": [
              "762020214"
            ]
          },
          "762020214": {
            "id": "762020214",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Oh, don't you worry about that. You don't need to get ready for anything — it's just a turn of phrase.",
            "nextDialogs": [
              "762020215"
            ]
          },
          "762020215": {
            "id": "762020215",
            "speakerId": 1322,
            "speakerName": "Nicole",
            "text": "Based on my observations and understanding... you're not a fan of complex introductions and explanations. You prefer to find your fun in the heat of adventure, am I right?"
          }
        }
      }
    },

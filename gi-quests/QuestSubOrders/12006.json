  },
  "subQuests": [
    {
      "subId": "1200601",
      "subQuestName": "Talk to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060101"
        ],
        "dialogs": {
          "120060101": {
            "id": "120060101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are we here? Ooh, it's one of those streetside places! Looks cute and cozy!",
            "nextDialogs": [
              "120060102"
            ]
          },
          "120060102": {
            "id": "120060102",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Welcome!",
            "nextDialogs": [
              "120060103"
            ]
          },
          "120060103": {
            "id": "120060103",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Miss Kiminami, how do you do?",
            "nextDialogs": [
              "120060104"
            ]
          },
          "120060104": {
            "id": "120060104",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Aha, Miss Kamisato! Perfect timing. Your booking was for... Well, right now!",
            "nextDialogs": [
              "120060105"
            ]
          },
          "120060105": {
            "id": "120060105",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "I believe so.",
            "nextDialogs": [
              "120060106"
            ]
          },
          "120060106": {
            "id": "120060106",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "We'll be sticking to the order I placed in advance. As for the other matter we discussed... Thank you for your help.",
            "nextDialogs": [
              "120060107"
            ]
          },
          "120060107": {
            "id": "120060107",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Excellent, no problem. And everything you asked for is ready and waiting.",
            "nextDialogs": [
              "120060108"
            ]
          },
          "120060108": {
            "id": "120060108",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Traveler, tiny customer, please wait here for a moment while I prepare your food.",
            "nextDialogs": [
              "120060109"
            ]
          },
          "120060109": {
            "id": "120060109",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Go ahead and take a seat. There's something I need to take care of, but I'll be back momentarily.",
            "nextDialogs": [
              "120060112"
            ]
          },
          "120060112": {
            "id": "120060112",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Ahem... It's nothing of that sort.",
            "nextDialogs": [
              "120060113"
            ]
          },
          "120060113": {
            "id": "120060113",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "I just have a few minor things I need to attend to. I won't be long.",
            "nextDialogs": [
              "120060114"
            ]
          },
          "120060114": {
            "id": "120060114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She sure left in a hurry... Whatever it is, it must be pretty urgent.",
            "nextDialogs": [
              "120060115"
            ]
          },
          "120060115": {
            "id": "120060115",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "So, you two are Miss Kamisato's friends?",
            "nextDialogs": [
              "120060116"
            ]
          },
          "120060116": {
            "id": "120060116",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Haha, well, we serve all the classics. Sure, there are fancier-looking places out there, but the food here speaks for itself! Hope you enjoy it.",
            "nextDialogs": [
              "120060117"
            ]
          },
          "120060117": {
            "id": "120060117",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Over the years we've been in business, we've gotten to know the Kamisato Clan quite well.",
            "nextDialogs": [
              "120060118"
            ]
          },
          "120060118": {
            "id": "120060118",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Miss Kamisato and her brother are both fond of our food. They're always sending staff down here to order something and take it back to them.",
            "nextDialogs": [
              "120060119"
            ]
          },
          "120060119": {
            "id": "120060119",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Her table booking surprised me — not least because it was a group reservation! This is the first time I've ever heard of Miss Kamisato going out for dinner with friends!",
            "nextDialogs": [
              "120060120"
            ]
          },
          "120060120": {
            "id": "120060120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The first time ever!? Whoa... Guess that makes us pretty important people, huh!",
            "nextDialogs": [
              "120060121"
            ]
          },
          "120060121": {
            "id": "120060121",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Sure does, and I'm probably crossing the line here, but... I'm just telling you what others have told me. Apparently, Miss Kamisato doesn't have a lot of friends.",
            "nextDialogs": [
              "120060122"
            ]
          },
          "120060122": {
            "id": "120060122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...That really surprises me.",
            "nextDialogs": [
              "120060123"
            ]
          },
          "120060123": {
            "id": "120060123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How is that possible? She's so kind and polite to everyone, Paimon would've thought that would make her really popular.",
            "nextDialogs": [
              "120060124"
            ]
          },
          "120060124": {
            "id": "120060124",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "That's what I used to think, too. But it turns out the rules of social interaction are a bit more complicated than that.",
            "nextDialogs": [
              "120060125"
            ]
          },
          "120060125": {
            "id": "120060125",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Nobody in the neighborhood has a bad word to say about her. They all say she's beautiful, elegant, graceful, not to mention that she belongs to one of the most illustrious clans in the land. In short, they see her as a model young lady.",
            "nextDialogs": [
              "120060126"
            ]
          },
          "120060126": {
            "id": "120060126",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "But that's just it — people look at her and see a model of perfection, and they don't feel like that's something they can relate to. So the majority of kids from ordinary families don't dare even try to talk to her.",
            "nextDialogs": [
              "120060127"
            ]
          },
          "120060127": {
            "id": "120060127",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "So you see? On paper, she sounds like a girl everyone would want to get to know, but in practice, she finds it difficult to make friends...",
            "nextDialogs": [
              "120060128"
            ]
          },
          "120060128": {
            "id": "120060128",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, Paimon never would have guessed...",
            "nextDialogs": [
              "120060129"
            ]
          },
          "120060129": {
            "id": "120060129",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "We don't speak all that much, but we do go quite a way back. I've always admired her for taking on so many responsibilities at such a young age.",
            "nextDialogs": [
              "120060130"
            ]
          },
          "120060130": {
            "id": "120060130",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "So it makes me really happy to see her here with friends today!",
            "nextDialogs": [
              "120060131"
            ]
          },
          "120060131": {
            "id": "120060131",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Anyway — relax, enjoy your meal, and... please talk to her as much as possible. I know she'll appreciate it.",
            "nextDialogs": [
              "120060132"
            ]
          },
          "120060132": {
            "id": "120060132",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Consider it a favor for the whole neighborhood... Look after her for us!",
            "nextDialogs": [
              "120060133"
            ]
          },
          "120060133": {
            "id": "120060133",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ah...!",
            "nextDialogs": [
              "120060134"
            ]
          },
          "120060134": {
            "id": "120060134",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? That sounded like Ayaka...!",
            "nextDialogs": [
              "120060135"
            ]
          },
          "120060135": {
            "id": "120060135",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "*sigh* I'm so sorry, Traveler..."
          }
        }
      }
    },
    {
      "subId": "1200602",
      "subQuestName": "Give the pizza to Kamisato Ayaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060201"
        ],
        "dialogs": {
          "120060201": {
            "id": "120060201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, it's ready!",
            "nextDialogs": [
              "120060202"
            ]
          },
          "120060202": {
            "id": "120060202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here it is.",
            "nextDialogs": [
              "120060203"
            ]
          },
          "120060203": {
            "id": "120060203",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "*sniff* It smells delicious... You're an excellent cook, Traveler.",
            "nextDialogs": [
              "120060204"
            ]
          },
          "120060204": {
            "id": "120060204",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "*sigh* I would love to be able to master dishes from all over the world...",
            "nextDialogs": [
              "120060205"
            ]
          },
          "120060205": {
            "id": "120060205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, all you need to learn is a recipe. We can bring you some more recipes in the future, if you like.",
            "nextDialogs": [
              "120060206"
            ]
          },
          "120060206": {
            "id": "120060206",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Great! I look forward to learning from your culinary expertise.",
            "nextDialogs": [
              "120060207"
            ]
          },
          "120060207": {
            "id": "120060207",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "How are you all doing?",
            "nextDialogs": [
              "120060208"
            ]
          },
          "120060208": {
            "id": "120060208",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Whoa, is this...? Miss Kamisato, this must be the dish you were talking about?",
            "nextDialogs": [
              "120060209"
            ]
          },
          "120060209": {
            "id": "120060209",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Yes, an overseas dish cooked by the Traveler.",
            "nextDialogs": [
              "120060210"
            ]
          },
          "120060210": {
            "id": "120060210",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Could I trouble you to package it for me?",
            "nextDialogs": [
              "120060211"
            ]
          },
          "120060211": {
            "id": "120060211",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Sure, no problem!",
            "nextDialogs": [
              "120060212"
            ]
          },
          "120060212": {
            "id": "120060212",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Ooh, it smells good! I bet it tastes amazing. Aw, now I really want to put something like this on our menu...",
            "nextDialogs": [
              "120060213"
            ]
          },
          "120060213": {
            "id": "120060213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, want us to teach you how to make it?",
            "nextDialogs": [
              "120060214"
            ]
          },
          "120060214": {
            "id": "120060214",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh! Could you?",
            "nextDialogs": [
              "120060215"
            ]
          },
          "120060215": {
            "id": "120060215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure could.",
            "nextDialogs": [
              "120060216"
            ]
          },
          "120060216": {
            "id": "120060216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The most satisfying meals are the ones you share with other people. So Paimon thinks that our friends in Mondstadt wouldn't mind us sharing this dish with Inazuma.",
            "nextDialogs": [
              "120060217"
            ]
          },
          "120060217": {
            "id": "120060217",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Really? Aw, that's great, I've always wanted to learn how to cook some international dishes!",
            "nextDialogs": [
              "120060218"
            ]
          },
          "120060218": {
            "id": "120060218",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "If you can write down a recipe for me, I'll add it to our menu and put a promotion where everyone will see it!",
            "nextDialogs": [
              "120060219"
            ]
          },
          "120060219": {
            "id": "120060219",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Since we became a closed nation, people haven't had the chance to try anything new. Traveler, you're the best!",
            "nextDialogs": [
              "120060220"
            ]
          },
          "120060220": {
            "id": "120060220",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "I'll go pack up this dish for Miss Kamisato. Please make your way back to the restaurant whenever you're ready, the food will be waiting for you.",
            "nextDialogs": [
              "120060221"
            ]
          },
          "120060221": {
            "id": "120060221",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "You could have sold that recipe for a high price, but you selflessly gave it away for free...",
            "nextDialogs": [
              "120060222"
            ]
          },
          "120060222": {
            "id": "120060222",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "...You're a wonderful person.",
            "nextDialogs": [
              "120060223"
            ]
          },
          "120060223": {
            "id": "120060223",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aw shucks, Ayaka...",
            "nextDialogs": [
              "120060224"
            ]
          },
          "120060224": {
            "id": "120060224",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "I mean it... I admire you a lot, and I'm so proud to be friends with someone of such fine character.",
            "nextDialogs": [
              "120060225"
            ]
          },
          "120060225": {
            "id": "120060225",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Well, you should probably write down the recipe now, no?",
            "nextDialogs": [
              "120060226"
            ]
          },
          "120060226": {
            "id": "120060226",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Yeah, {NICKNAME}, let's make sure we include all the details and then give it to Miss Kiminami!",
            "nextDialogs": [
              "120060227"
            ]
          },
          "120060227": {
            "id": "120060227",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, pizza! Start with the basic ingredients.",
            "nextDialogs": [
              "120060229",
              "120060231"
            ]
          },
          "120060229": {
            "id": "120060229",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Correctamundo!",
            "nextDialogs": [
              "120060232"
            ]
          },
          "120060232": {
            "id": "120060232",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right, now to add the next couple of ingredients!"
          },
          "120060231": {
            "id": "120060231",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seriously? Okay, well, you're the chef..."
          }
        }
      }
    },
    {
      "subId": "1200603",
      "subQuestName": "Talk to Kamisato Ayaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1200607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060401"
        ],
        "dialogs": {
          "120060401": {
            "id": "120060401",
            "speakerId": 3006,
            "speakerName": "Ogura Mio",
            "text": "Your garment is ready, Miss Kamisato. I've folded and packaged it for you.",
            "nextDialogs": [
              "120060402"
            ]
          },
          "120060402": {
            "id": "120060402",
            "speakerId": 3006,
            "speakerName": "Ogura Mio",
            "text": "Oh, and the other item we discussed — that's ready too!",
            "nextDialogs": [
              "120060403"
            ]
          },
          "120060403": {
            "id": "120060403",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Thank you very much.",
            "nextDialogs": [
              "120060404"
            ]
          },
          "120060404": {
            "id": "120060404",
            "speakerId": 3006,
            "speakerName": "Ogura Mio",
            "text": "No, thank you! It is a beautiful piece of clothing, and it was a pleasure to work on. See you again next time!",
            "nextDialogs": [
              "120060405"
            ]
          },
          "120060405": {
            "id": "120060405",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Traveler, I have a gift for you.",
            "nextDialogs": [
              "120060406"
            ]
          },
          "120060406": {
            "id": "120060406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm? Really?",
            "nextDialogs": [
              "120060407"
            ]
          },
          "120060407": {
            "id": "120060407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa... Looks super fancy! Is that for wearing in your hair?",
            "nextDialogs": [
              "120060408"
            ]
          },
          "120060408": {
            "id": "120060408",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "It's a hairpin in the style of a white heron. As well as a hair accessory, you can also use it as an ornament.",
            "nextDialogs": [
              "120060409"
            ]
          },
          "120060409": {
            "id": "120060409",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "I couldn't ask for your help and offer nothing at all in return, so this is my gift to you.",
            "nextDialogs": [
              "120060412"
            ]
          },
          "120060412": {
            "id": "120060412",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "I'm glad you like it!",
            "nextDialogs": [
              "120060413"
            ]
          },
          "120060413": {
            "id": "120060413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Speaking of white herons, that's what your title means, doesn't it? Shirasagi Himegimi. So this gift is like a little piece of yourself. It's just as elegant and beautiful as you are.",
            "nextDialogs": [
              "120060414"
            ]
          },
          "120060414": {
            "id": "120060414",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Hehe, you flatter me, Paimon. If this gift reminds you of me, that is all I could ask for.",
            "nextDialogs": [
              "120060415"
            ]
          },
          "120060415": {
            "id": "120060415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hee-hee, it definitely will.",
            "nextDialogs": [
              "120060416"
            ]
          },
          "120060416": {
            "id": "120060416",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, well, now we've got what we came for, we can set off.",
            "nextDialogs": [
              "120060417"
            ]
          },
          "120060417": {
            "id": "120060417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Time to go meet Tsubaki!"
          }
        }
      }
    },
    {
      "subId": "1200606",
      "subQuestName": "Talk to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120060601"
        ],
        "dialogs": {
          "120060601": {
            "id": "120060601",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Here it is!",
            "nextDialogs": [
              "120060602"
            ]
          },
          "120060602": {
            "id": "120060602",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Thank you!",
            "nextDialogs": [
              "120060603"
            ]
          },
          "120060603": {
            "id": "120060603",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Wowee, this is so exciting! I want to make it right away.",
            "nextDialogs": [
              "120060604"
            ]
          },
          "120060604": {
            "id": "120060604",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Traveler, Paimon, please accept my sincerest apologies for delaying your meal.",
            "nextDialogs": [
              "120060605"
            ]
          },
          "120060605": {
            "id": "120060605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, no problem! Food always tastes better when you've worked up an appetite.",
            "nextDialogs": [
              "120060606"
            ]
          },
          "120060606": {
            "id": "120060606",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Alright, let's dig in before it gets cold.",
            "nextDialogs": [
              "120060607"
            ]
          },
          "120060607": {
            "id": "120060607",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Well, what do you think? Is Inazuman cuisine to your liking?",
            "nextDialogs": [
              "120060608"
            ]
          },
          "120060608": {
            "id": "120060608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's amazing! Paimon loved this one... Oh! A—And especially that one over there...",
            "nextDialogs": [
              "120060611"
            ]
          },
          "120060611": {
            "id": "120060611",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Haha, good. I'm relieved.",
            "nextDialogs": [
              "120060612"
            ]
          },
          "120060612": {
            "id": "120060612",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Um... When I was attempting to cook earlier on, did you... chat with the owner at all?",
            "nextDialogs": [
              "120060613"
            ]
          },
          "120060613": {
            "id": "120060613",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "And did she, uh... say anything about me?",
            "nextDialogs": [
              "120060614"
            ]
          },
          "120060614": {
            "id": "120060614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She did, but don't worry, she's just happy for you is all.",
            "nextDialogs": [
              "120060615"
            ]
          },
          "120060615": {
            "id": "120060615",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "She's... happy for me?",
            "nextDialogs": [
              "120060616"
            ]
          },
          "120060616": {
            "id": "120060616",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh... then... she must have told you. D—Did she, um...",
            "nextDialogs": [
              "120060617"
            ]
          },
          "120060617": {
            "id": "120060617",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "*sigh* What does it matter... I know just as well as anybody else that I've got no friends...",
            "nextDialogs": [
              "120060618"
            ]
          },
          "120060618": {
            "id": "120060618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, it's not you, most people just haven't had the chance to talk to you one-on-one before.",
            "nextDialogs": [
              "120060619"
            ]
          },
          "120060619": {
            "id": "120060619",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Thank you for your comforting words, Paimon.",
            "nextDialogs": [
              "120060620"
            ]
          },
          "120060620": {
            "id": "120060620",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "It's all true, though. I just... don't have very many friends.",
            "nextDialogs": [
              "120060621"
            ]
          },
          "120060621": {
            "id": "120060621",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Most of the time I'm either accompanied by family or staff. So everyone must have found it quite a surprise to see me taking you out for a meal..."
          }
        }
      }

  "subQuests": [
    {
      "subId": "7666501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766506501"
        ],
        "dialogs": {
          "766506501": {
            "id": "766506501",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "You've been hard at work, Kukkia.",
            "nextDialogs": [
              "766506502"
            ]
          },
          "766506502": {
            "id": "766506502",
            "speakerId": 1001,
            "speakerName": "Kukkia",
            "text": "Lady Lauma? What brings you here? Also, I was just cleaning up on the side. It was no trouble at all.",
            "nextDialogs": [
              "766506503"
            ]
          },
          "766506503": {
            "id": "766506503",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "But you do often come by to maintain the statue as well, don't you?",
            "nextDialogs": [
              "766506504"
            ]
          },
          "766506504": {
            "id": "766506504",
            "speakerId": 1001,
            "speakerName": "Kukkia",
            "text": "Yes, occasionally. Did the birds tell you? Or did the Moon Goddess?",
            "nextDialogs": [
              "766506505"
            ]
          },
          "766506505": {
            "id": "766506505",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Haha, our Goddess did indeed guide me with her light.",
            "nextDialogs": [
              "766506506"
            ]
          },
          "766506506": {
            "id": "766506506",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "It was by that guiding radiance that I noticed you switching out the flowers in front of her statue for new ones, and cleaning the statue's base.",
            "nextDialogs": [
              "766506507"
            ]
          },
          "766506507": {
            "id": "766506507",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Still, please take care yourself, your devotion notwithstanding.",
            "nextDialogs": [
              "766506508"
            ]
          },
          "766506508": {
            "id": "766506508",
            "speakerId": 1001,
            "speakerName": "Kukkia",
            "text": "...I will. Thank you, Lady Lauma.",
            "nextDialogs": [
              "766506509"
            ]
          },
          "766506509": {
            "id": "766506509",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "I should be thanking you. Please, come a little closer, Kukkia.",
            "nextDialogs": [
              "766506510"
            ]
          },
          "766506510": {
            "id": "766506510",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "May the Moon Goddess guard your path...",
            "nextDialogs": [
              "766506511"
            ]
          },
          "766506511": {
            "id": "766506511",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "...And that of us all."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1080601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "698220101"
        ],
        "dialogs": {
          "698220101": {
            "id": "698220101",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...Yes. The biggest issue here is pricing.",
            "nextDialogs": [
              "698220102"
            ]
          },
          "698220102": {
            "id": "698220102",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Oh, you're here. Come, sit.",
            "nextDialogs": [
              "698220105"
            ]
          },
          "698220105": {
            "id": "698220105",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I'm looking over the winery's recent production and sales reports. Don't worry, I just finished.",
            "nextDialogs": [
              "698220106"
            ]
          },
          "698220106": {
            "id": "698220106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there some trouble?",
            "nextDialogs": [
              "698220107"
            ]
          },
          "698220107": {
            "id": "698220107",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I wouldn't go that far. It's just that the last grape harvest was adversely affected by the weather, reducing the yield.",
            "nextDialogs": [
              "698220108"
            ]
          },
          "698220108": {
            "id": "698220108",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Elzer responded in time, and as such, there are no issues with the quality. What I need to do is settle on a price for them.",
            "nextDialogs": [
              "698220109"
            ]
          },
          "698220109": {
            "id": "698220109",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Our supply has decreased, but demand from Mondstadt and beyond has not changed. At times such as this, pricing must be carefully considered.",
            "nextDialogs": [
              "698220110"
            ]
          },
          "698220110": {
            "id": "698220110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Scarcity drives value up...",
            "nextDialogs": [
              "698220111"
            ]
          },
          "698220111": {
            "id": "698220111",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Precisely. When demand exceeds supply, some will seek to profit more. Our distributors are all thinking the same thing.",
            "nextDialogs": [
              "698220112"
            ]
          },
          "698220112": {
            "id": "698220112",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "However, Dawn Winery has no intention to gouge our customers. We've been in business for a long time, and purchasing our liquors and spirits has long become a part of life here in Mondstadt.",
            "nextDialogs": [
              "698220113"
            ]
          },
          "698220113": {
            "id": "698220113",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Sullying the memories people have when they think of Dawn Winery in exchange for short-term profit... is unnecessary.",
            "nextDialogs": [
              "698220114"
            ]
          },
          "698220114": {
            "id": "698220114",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I'm not so poor that I'd stoop that low.",
            "nextDialogs": [
              "698220115"
            ]
          },
          "698220115": {
            "id": "698220115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that's how a bona fide winery boss operates, huh?",
            "nextDialogs": [
              "698220116"
            ]
          },
          "698220116": {
            "id": "698220116",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...Is that so surprising? Elzer was actually quite quick to accept this reasoning. In fact, he went to meet with our distributors immediately.",
            "nextDialogs": [
              "698220117"
            ]
          },
          "698220117": {
            "id": "698220117",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Ah, yes. It's been a while since you've come by. Would you like me to open a bottle for you?"
          }
        }
      }
    }
  ]
}
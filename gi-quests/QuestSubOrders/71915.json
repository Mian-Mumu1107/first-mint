          },
          "719150102": {
            "id": "719150102",
            "speakerId": 2097,
            "speakerName": "Chunshui",
            "text": "Thank you, and mine to you... If you don't mind, please take this.",
            "nextDialogs": [
              "719150103"
            ]
          },
          "719150103": {
            "id": "719150103",
            "speakerId": 2097,
            "speakerName": "Chunshui",
            "text": "This is called a Windwheel Aster. I asked a friend to bring one back from Mondstadt for me.",
            "nextDialogs": [
              "719150104"
            ]
          },
          "719150104": {
            "id": "719150104",
            "speakerId": 2097,
            "speakerName": "Chunshui",
            "text": "There, this plant symbolizes the \"visible winds.\" I hope it can keep my husband safe at sea.",
            "nextDialogs": [
              "719150105"
            ]
          },
          "719150105": {
            "id": "719150105",
            "speakerId": 2097,
            "speakerName": "Chunshui",
            "text": "You are a good person. I hope that you, too, may be blessed be the wind."
          }

    {
      "subId": "7609503",
      "subQuestName": "Talk to Istoria",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760950301"
        ],
        "dialogs": {
          "760950301": {
            "id": "760950301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Istoria, we've basically freed all three areas. Most of the people are safe now, too.",
            "nextDialogs": [
              "760950302"
            ]
          },
          "760950302": {
            "id": "760950302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And we even found everything Zeitlind lost.",
            "nextDialogs": [
              "760950303"
            ]
          },
          "760950303": {
            "id": "760950303",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Oh, thank you very much. I have to say, Nihilita's got quite the eye for people now that he's opened it.",
            "nextDialogs": [
              "760950304"
            ]
          },
          "760950304": {
            "id": "760950304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright, your turn now! You mentioned a way to go up above before, and a price to go with it.",
            "nextDialogs": [
              "760950305"
            ]
          },
          "760950305": {
            "id": "760950305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Bring it on! Paimon's not scared of a couple of adventures or a bit of Mora!",
            "nextDialogs": [
              "760950306"
            ]
          },
          "760950306": {
            "id": "760950306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh! And what about Zeitlind? How are we supposed to send her back down now that she's done here?",
            "nextDialogs": [
              "760950307"
            ]
          },
          "760950307": {
            "id": "760950307",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "I can explain all of that, but you should rest first. I'll go through everything in detail tomorrow.",
            "nextDialogs": [
              "760950308"
            ]
          },
          "760950308": {
            "id": "760950308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay. But um, there's no bed here. Or food!",
            "nextDialogs": [
              "760950309"
            ]
          },
          "760950309": {
            "id": "760950309",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Such desires cease here. Think about it. You've been here all this time, but you are neither hungry nor tired.",
            "nextDialogs": [
              "760950310"
            ]
          },
          "760950310": {
            "id": "760950310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Then what's Paimon supposed to do all day while we rest?",
            "nextDialogs": [
              "760950311"
            ]
          },
          "760950311": {
            "id": "760950311",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "This place is full of remarkable people from every age — speaking with them could be fun.",
            "nextDialogs": [
              "760950312"
            ]
          },
          "760950312": {
            "id": "760950312",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Alright, fine. But Paimon gets to sleep whenever she wants. Tired or not, Paimon's still sleeping on {NICKNAME}'s head!",
            "nextDialogs": [
              "760950313"
            ]
          },
          "760950313": {
            "id": "760950313",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Zeitlind, after you've rested a bit, could we talk? It's about what I mentioned earlier, the thing I needed time to think about.",
            "nextDialogs": [
              "760950314"
            ]
          },
          "760950314": {
            "id": "760950314",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "Speak with me a while, would you?",
            "nextDialogs": [
              "760950315"
            ]
          },
          "760950315": {
            "id": "760950315",
            "speakerId": 1000,
            "speakerName": "Zeitlind",
            "text": "Okay.",
            "nextDialogs": [
              "760950316"
            ]
          },
          "760950316": {
            "id": "760950316",
            "speakerId": 1002,
            "speakerName": "Istoria",
            "text": "#{NICKNAME}. Paimon. Once you're feeling rested, come see me."
          }
        }
      }
    },
    {
      "subId": "7609506",
      "subQuestName": "Talk to everyone $HIDDEN",
      "sceneId": null,
      "locations": [],

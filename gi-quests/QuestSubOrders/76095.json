  "subQuests": [
    {
      "subId": "7609501",
      "subQuestName": "Find Zeitlind's lost belongings and liberate the areas",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760950101"
        ],
        "dialogs": {
          "760950101": {
            "id": "760950101",
            "speakerId": 1000,
            "speakerName": "Zeitlind",
            "text": "#{NICKNAME}, Paimon... thank you. I'm really glad I met you at the end.",
            "nextDialogs": [
              "760950102"
            ]
          },
          "760950102": {
            "id": "760950102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe. If anything, it feels like you got dragged into all this because of us.",
            "nextDialogs": [
              "760950103"
            ]
          },
          "760950103": {
            "id": "760950103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, \"the end\"? What do you mean?",
            "nextDialogs": [
              "760950104"
            ]
          },
          "760950104": {
            "id": "760950104",
            "speakerId": 1000,
            "speakerName": "Zeitlind",
            "text": "I mean... ours were all pretty dangerous adventures. But I got to see so many incredible things.",
            "nextDialogs": [
              "760950105"
            ]
          },
          "760950105": {
            "id": "760950105",
            "speakerId": 1000,
            "speakerName": "Zeitlind",
            "text": "That's not so bad.",
            "nextDialogs": [
              "760950106"
            ]
          },
          "760950106": {
            "id": "760950106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Don't just brush Paimon's question off like that.",
            "nextDialogs": [
              "760950107"
            ]
          },
          "760950107": {
            "id": "760950107",
            "speakerId": 1000,
            "speakerName": "Zeitlind",
            "text": "Did I?"
          }
        }
      }
    },

        ],
        "dialogs": {
          "750690801": {
            "id": "750690801",
            "speakerId": 1002,
            "speakerName": "Cold Body",
            "text": "(The cold, statue-like body of one resembling Quenin, somehow preserved without decay, seems frozen in time....)",
            "nextDialogs": [
              "750690802"
            ]
          },
          "750690802": {
            "id": "750690802",
            "speakerId": 1002,
            "speakerName": "Cold Body",
            "text": "(And judging by the surroundings, it has remained in this state for a long time...)"
          }

    {
      "subId": "7506911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750691101"
        ],
        "dialogs": {
          "750691101": {
            "id": "750691101",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "The waterfall, haha... The roar of the falls drowns out everything else, so you can't hear a thing.",
            "nextDialogs": [
              "750691102"
            ]
          },
          "750691102": {
            "id": "750691102",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Oh, it's you. Need anything?",
            "nextDialogs": [
              "750691103"
            ]
          },
          "750691103": {
            "id": "750691103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nope, don't need anything.",
            "nextDialogs": [
              "750691104"
            ]
          },
          "750691104": {
            "id": "750691104",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Is that so... Ah, then take my advice, brave warrior. Leave here quickly."
          }
        }
      }
    },
    {
      "subId": "7506912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750691201"
        ],
        "dialogs": {
          "750691201": {
            "id": "750691201",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "The waterfall, haha... The roar of the falls drowns out everything else, so you can't hear a thing.",
            "nextDialogs": [
              "750691202"
            ]
          },
          "750691202": {
            "id": "750691202",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Oh, it's you. Need anything?",
            "nextDialogs": [
              "750691204",
              "750691208"
            ]
          },
          "750691204": {
            "id": "750691204",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "I'm... a warrior of the adventure team. Not one as mighty as our leader, Lord Taika, but I do have my strengths.",
            "nextDialogs": [
              "750691205"
            ]
          },
          "750691205": {
            "id": "750691205",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "I guard our camp... Sometimes, when I can't sleep at night, I patrol to keep the camp safe.",
            "nextDialogs": [
              "750691206"
            ]
          },
          "750691206": {
            "id": "750691206",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Now, I don't know when it started, but there have been fewer and fewer people in camp every day... Huh, wait. Strange... Why am I here now?"
          },
          "750691208": {
            "id": "750691208",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Is that so... Ah, then take my advice, brave warrior. Leave here quickly."
          }
        }
      }
    },
    {
      "subId": "7506913",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750691301"
        ],
        "dialogs": {
          "750691301": {
            "id": "750691301",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "The waterfall, haha... The roar of the falls drowns out everything else, so you can't hear a thing.",
            "nextDialogs": [
              "750691302"
            ]
          },
          "750691302": {
            "id": "750691302",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Oh, it's you. Need anything?",
            "nextDialogs": [
              "750691304",
              "750691308",
              "750691314"
            ]
          },
          "750691304": {
            "id": "750691304",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "I'm... a warrior of the adventure team. Not one as mighty as our leader, Lord Taika, but I do have my strengths.",
            "nextDialogs": [
              "750691305"
            ]
          },
          "750691305": {
            "id": "750691305",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "I guard our camp... Sometimes, when I can't sleep at night, I patrol to keep the camp safe.",
            "nextDialogs": [
              "750691306"
            ]
          },
          "750691306": {
            "id": "750691306",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Now, I don't know when it started, but there have been fewer and fewer people in camp every day... Huh, wait. Strange... Why am I here now?"
          },
          "750691308": {
            "id": "750691308",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Yes, and only here at the waterfall can the sound of water drown them out...",
            "nextDialogs": [
              "750691309"
            ]
          },
          "750691309": {
            "id": "750691309",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Can't you hear it? Someone whimpers by your ear, like one who is dying but cannot scream, making only the sound of their lungs struggling for air.",
            "nextDialogs": [
              "750691310"
            ]
          },
          "750691310": {
            "id": "750691310",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "And then, you will see a pale face, staring at you with anger. A face... like your own.",
            "nextDialogs": [
              "750691311"
            ]
          },
          "750691311": {
            "id": "750691311",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Ah, only at the waterfall, only there can I escape those haunting sounds. Hehe, can't you hear them...",
            "nextDialogs": [
              "750691312"
            ]
          },
          "750691312": {
            "id": "750691312",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Stay here for too long, brave warrior, and you might end up like me. So, leave while you can."
          },
          "750691314": {
            "id": "750691314",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Is that so... Ah, then take my advice, brave warrior. Leave here quickly."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7506902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750690201"
        ],
        "dialogs": {
          "750690201": {
            "id": "750690201",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Ah, this place... Few visit it... After all, it's dangerous here.",
            "nextDialogs": [
              "750690202"
            ]
          },
          "750690202": {
            "id": "750690202",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Are you with the adventure team too...? Hmph, they say the shadow of a black serpent has descended from the Tonatiuh... You should be careful.",
            "nextDialogs": [
              "750690203"
            ]
          },
          "750690203": {
            "id": "750690203",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "Or better, leave while you can. There are inhuman things, ha, hiding within the team... Those voices, those curses... so noisy...",
            "nextDialogs": [
              "750690204"
            ]
          },
          "750690204": {
            "id": "750690204",
            "speakerId": 1000,
            "speakerName": "Quenin",
            "text": "It's pretty quiet around here thanks to the waterfall. Haha... The roar of the falls drowns out everything else, so you can't hear a thing."
          }
        }
      }
    },
    {
      "subId": "7506903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750690501"
        ],
        "dialogs": {
          "750690501": {
            "id": "750690501",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "(A torn page, with neatly written words at the beginning...)",
            "nextDialogs": [
              "750690502"
            ]
          },
          "750690502": {
            "id": "750690502",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "\"...Abyss monsters are growing in number, as expected... The adventure team has failed in the end, and a planned retreat is in progress.\"",
            "nextDialogs": [
              "750690503"
            ]
          },
          "750690503": {
            "id": "750690503",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "\"We must ensure the remaining members can evacuate safely. Be wary of those who vanish at night, or return from places devoid of light.\"",
            "nextDialogs": [
              "750690504"
            ]
          },
          "750690504": {
            "id": "750690504",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "\"...The Abyss monsters are appearing more frequently. The stronghold may be discovered soon, but before that...\"",
            "nextDialogs": [
              "750690505"
            ]
          },
          "750690505": {
            "id": "750690505",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "(The handwriting becomes shaky and distorted...)",
            "nextDialogs": [
              "750690506"
            ]
          },
          "750690506": {
            "id": "750690506",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "\"Ah, it's cold... So cold... There, over there, blood is draining...\"",
            "nextDialogs": [
              "750690507"
            ]
          },
          "750690507": {
            "id": "750690507",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "\"The sound of the waterfall, so loud... yes, this is good. As long as... under the waterfall, it'll be quiet there... pale faces, opened mouths, drained blood...\"",
            "nextDialogs": [
              "750690508"
            ]
          },
          "750690508": {
            "id": "750690508",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "\"Just there... just... there... something... something is there...\"",
            "nextDialogs": [
              "750690509"
            ]
          },
          "750690509": {
            "id": "750690509",
            "speakerId": 1001,
            "speakerName": "Quenin's Diary",
            "text": "\"Under the waterfall under the waterfall under the waterfall under the waterfall under the waterfall under the waterfall...\""
          }
        }
      }
    },

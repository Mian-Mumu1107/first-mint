        "dialogs": {
          "190280801": {
            "id": "190280801",
            "speakerId": 1000,
            "speakerName": "Kozue",
            "text": "That gang of Treasure Hoarders must have been planning this for a long time. Judging by how skillfully they infiltrated this place and the fact that they've managed to remain hidden ever since, it is clear that they are a group of seasoned thieves.",
            "nextDialogs": [
              "190280802"
            ]
          },
          "190280802": {
            "id": "190280802",
            "speakerId": 1000,
            "speakerName": "Kozue",
            "text": "But our own negligence is also to blame. We shouldn't have re-allocated so many people to other duties..."
          }
        }
      }

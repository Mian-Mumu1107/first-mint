        "dialogs": {
          "220430101": {
            "id": "220430101",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Huh, how did I run out of wood...",
            "nextDialogs": [
              "220430102"
            ]
          },
          "220430102": {
            "id": "220430102",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Oh, hey there, Traveler! You're just the person I was hoping to see. Do you mind doing me a favor?",
            "nextDialogs": [
              "220430105"
            ]
          },
          "220430105": {
            "id": "220430105",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I've been trying to make smaller-scale wood carvings of our provisional head priestess.",
            "nextDialogs": [
              "220430106"
            ]
          },
          "220430106": {
            "id": "220430106",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I've been thinking to bring a batch of these to Narukami Island to see if they'll sell...",
            "nextDialogs": [
              "220430107"
            ]
          },
          "220430107": {
            "id": "220430107",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "If they do, they would make for a source of consistent income for me."
          }
        }
      }
    },
    {

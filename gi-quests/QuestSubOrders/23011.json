  "subQuests": [
    {
      "subId": "2301101",
      "subQuestName": "Talk to Viktor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230110101"
        ],
        "dialogs": {
          "230110101": {
            "id": "230110101",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Hmm... How should I carve this again...",
            "nextDialogs": [
              "230110104"
            ]
          },
          "230110104": {
            "id": "230110104",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Ugh, who's there? Stop bothering me already, I'm...",
            "nextDialogs": [
              "230110105"
            ]
          },
          "230110105": {
            "id": "230110105",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Eh!? Traveler!? What brings you here to Sumeru?",
            "nextDialogs": [
              "230110106"
            ]
          },
          "230110106": {
            "id": "230110106",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Come on, Rudolf can't have sent you to beat me up, right? I did nothing but send Lily a little gift way back when!"
          }
        }
      }
    },
    {
      "subId": "2301102",
      "subQuestName": "Talk to Hamawi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230110301"
        ],
        "dialogs": {
          "230110301": {
            "id": "230110301",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "What awful luck...",
            "nextDialogs": [
              "230110302"
            ]
          },
          "230110302": {
            "id": "230110302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Viktor's wood delivery...",
            "nextDialogs": [
              "230110303"
            ]
          },
          "230110303": {
            "id": "230110303",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "Are you talking about the wood that the Fatuus ordered?",
            "nextDialogs": [
              "230110304"
            ]
          },
          "230110304": {
            "id": "230110304",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "*sigh* I knew dealing with the Fatui wouldn't end well.",
            "nextDialogs": [
              "230110305"
            ]
          },
          "230110305": {
            "id": "230110305",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "We were attacked by monsters while transporting that wood. All of us made it back alive, but our cart didn't. We were forced to leave the wood by the roadside.",
            "nextDialogs": [
              "230110306"
            ]
          },
          "230110306": {
            "id": "230110306",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "I dare not go over there, nor can I find someone to get rid of those monsters so soon...",
            "nextDialogs": [
              "230110308"
            ]
          },
          "230110308": {
            "id": "230110308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We aren't Fatui...",
            "nextDialogs": [
              "230110309"
            ]
          },
          "230110309": {
            "id": "230110309",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "Aren't you a Fatuus? Then why are you helping him?",
            "nextDialogs": [
              "230110310"
            ]
          },
          "230110310": {
            "id": "230110310",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "Anyway, I can only leave my cart there for now and see if I can hire someone to deal with the situation.",
            "nextDialogs": [
              "230110311"
            ]
          },
          "230110311": {
            "id": "230110311",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "If you are anxious to get the wood, I'll mark the approximate location of the cart on the map for you, then you can go take a look for yourself.",
            "nextDialogs": [
              "230110312"
            ]
          },
          "230110312": {
            "id": "230110312",
            "speakerId": 4052,
            "speakerName": "Hamawi",
            "text": "*sigh* Nothing good ever comes of things that the Fatui are involved in..."
          }
        }
      }
    },
    {
      "subId": "2301107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230110701"
        ],
        "dialogs": {
          "230110701": {
            "id": "230110701",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "How did it go? Has my wood arrived?",
            "nextDialogs": [
              "230110702"
            ]
          },
          "230110702": {
            "id": "230110702",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You tell Viktor what happened...",
            "nextDialogs": [
              "230110703"
            ]
          },
          "230110703": {
            "id": "230110703",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Monsters again? Why does it feel like every cart in the world is being attacked by monsters...",
            "nextDialogs": [
              "230110704"
            ]
          },
          "230110704": {
            "id": "230110704",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Never mind, as long my wood gets here.",
            "nextDialogs": [
              "230110705"
            ]
          },
          "230110705": {
            "id": "230110705",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Oh, right. Here's the payment I promised you. You can tally it up if you like.",
            "nextDialogs": [
              "230110706"
            ]
          },
          "230110706": {
            "id": "230110706",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Uh, by the way... Um, is Lily doing well?",
            "nextDialogs": [
              "230110707"
            ]
          },
          "230110707": {
            "id": "230110707",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I didn't say goodbye to her before I left. I hope she isn't angry...",
            "nextDialogs": [
              "230110709",
              "230110711"
            ]
          },
          "230110709": {
            "id": "230110709",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Alright. Ahem... Don't look at me like that. I was just a little concerned!",
            "nextDialogs": [
              "230110714"
            ]
          },
          "230110714": {
            "id": "230110714",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Anyway, count your compensation. I prepared the exact amount, Traveler."
          },
          "230110711": {
            "id": "230110711",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Mr. Vsevolod will give me a real hiding if I do that. Forget it.",
            "nextDialogs": [
              "230110712"
            ]
          },
          "230110712": {
            "id": "230110712",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I don't quite dare to send a letter directly either.",
            "nextDialogs": [
              "230110713"
            ]
          },
          "230110713": {
            "id": "230110713",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Receiving a letter from a Fatuus sounds like a bad thing, either. Hahaha..."
          }
        }
      }
    },

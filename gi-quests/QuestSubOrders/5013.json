    {
      "subId": "501308",
      "subQuestName": "Share battlefield intel with your companions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50130801"
        ],
        "dialogs": {
          "50130801": {
            "id": "50130801",
            "speakerId": 1000,
            "speakerName": "Xilonen",
            "text": "The Children of Echoes' territory is secure. All monsters down.",
            "nextDialogs": [
              "50130802"
            ]
          },
          "50130802": {
            "id": "50130802",
            "speakerId": 1001,
            "speakerName": "Kachina",
            "text": "I'll go deal with the Abyss Tumor!",
            "nextDialogs": [
              "50130803"
            ]
          },
          "50130803": {
            "id": "50130803",
            "speakerId": 1002,
            "speakerName": "Mualani",
            "text": "All good here at the People of the Springs, too. We crushed it!",
            "nextDialogs": [
              "50130804"
            ]
          },
          "50130804": {
            "id": "50130804",
            "speakerId": 1003,
            "speakerName": "Citlali",
            "text": "Masters of the Night-Wind are also safe. Should I go support the Flower-Feather Clan?",
            "nextDialogs": [
              "50130805"
            ]
          },
          "50130805": {
            "id": "50130805",
            "speakerId": 1004,
            "speakerName": "Ororon",
            "text": "Things are still pretty rough over there. I'm already en route.",
            "nextDialogs": [
              "50130806"
            ]
          },
          "50130806": {
            "id": "50130806",
            "speakerId": 1005,
            "speakerName": "Chasca",
            "text": "No need. I just dealt with it.",
            "nextDialogs": [
              "50130807"
            ]
          },
          "50130807": {
            "id": "50130807",
            "speakerId": 1006,
            "speakerName": "Paimon",
            "text": "Already!? But you were just at the Stadium!",
            "nextDialogs": [
              "50130808"
            ]
          },
          "50130808": {
            "id": "50130808",
            "speakerId": 1005,
            "speakerName": "Chasca",
            "text": "Yeah, well. You have no idea how long I've been itching to bash some heads in.",
            "nextDialogs": [
              "50130809"
            ]
          },
          "50130809": {
            "id": "50130809",
            "speakerId": 1006,
            "speakerName": "Paimon",
            "text": "Oh... Fair enough...",
            "nextDialogs": [
              "50130810"
            ]
          },
          "50130810": {
            "id": "50130810",
            "speakerId": 1002,
            "speakerName": "Mualani",
            "text": "Iansan, what should we do about the Collective of Plenty? Your home's a long ways away from the stadium.",
            "nextDialogs": [
              "50130811"
            ]
          },
          "50130811": {
            "id": "50130811",
            "speakerId": 1007,
            "speakerName": "Iansan",
            "text": "Oh, no need to worry. I just heard from Varesa, she says they're safe now.",
            "nextDialogs": [
              "50130812"
            ]
          },
          "50130812": {
            "id": "50130812",
            "speakerId": 1008,
            "speakerName": "Kinich",
            "text": "Sounds like all regions are secured. The Abyss forces are weakening.",
            "nextDialogs": [
              "50130813"
            ]
          },
          "50130813": {
            "id": "50130813",
            "speakerId": 1006,
            "speakerName": "Paimon",
            "text": "Yeah! Their only game-plan was to outnumber us, and that ain't gonna work now that we have the Ode of Resurrection on our side!",
            "nextDialogs": [
              "50130814"
            ]
          },
          "50130814": {
            "id": "50130814",
            "speakerId": 1008,
            "speakerName": "Kinich",
            "text": "Hold up... The Abyss is sending a sizeable unit towards the Stadium.",
            "nextDialogs": [
              "50130815"
            ]
          },
          "50130815": {
            "id": "50130815",
            "speakerId": 1008,
            "speakerName": "Kinich",
            "text": "I guess they've realized that the Ode of Resurrection is a game changer, so now, they are going to try to destroy the sacred flame.",
            "nextDialogs": [
              "50130816"
            ]
          },
          "50130816": {
            "id": "50130816",
            "speakerId": 1002,
            "speakerName": "Mualani",
            "text": "We ain't gonna let them get away with that. Friends, let's gather at the stadium!",
            "nextDialogs": [
              "50130817"
            ]
          },
          "50130817": {
            "id": "50130817",
            "speakerId": 1000,
            "speakerName": "Xilonen",
            "text": "More Abyss Tumors have descended, all near the Stadium. Let's split up and take them out.",
            "nextDialogs": [
              "50130818"
            ]
          },
          "50130818": {
            "id": "50130818",
            "speakerId": 1000,
            "speakerName": "Xilonen",
            "text": "Oh, and we need someone to guard the main entrance.",
            "nextDialogs": [
              "50130819"
            ]
          },
          "50130819": {
            "id": "50130819",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Allow me.",
            "nextDialogs": [
              "50130820"
            ]
          },
          "50130820": {
            "id": "50130820",
            "speakerId": 1002,
            "speakerName": "Mualani",
            "text": "Alright. This is the final battle!"
          }
        }
      }
    },

    },
    {
      "subId": "7214412",
      "subQuestName": "Talk to Yan'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441201"
        ],
        "dialogs": {
          "721441201": {
            "id": "721441201",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "#So, {NICKNAME}, do you have any news?",
            "nextDialogs": [
              "721441204"
            ]
          },
          "721441204": {
            "id": "721441204",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "I see...",
            "nextDialogs": [
              "721441205"
            ]
          },
          "721441205": {
            "id": "721441205",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "It's alright. If you find her, please inform me as soon as possible."
          }
        }
      }
    },
    {
      "subId": "7214414",
      "subQuestName": "Talk to Yan'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721442101"
        ],
        "dialogs": {
          "721442101": {
            "id": "721442101",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Oh, is this a gift? Thanks!",
            "nextDialogs": [
              "721442102"
            ]
          },
          "721442102": {
            "id": "721442102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's from Hiromi.",
            "nextDialogs": [
              "721442103"
            ]
          },
          "721442103": {
            "id": "721442103",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Hiromi... who's that?",
            "nextDialogs": [
              "721442106"
            ]
          },
          "721442106": {
            "id": "721442106",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Sorry. I don't know any officer who catches thieves.",
            "nextDialogs": [
              "721442107"
            ]
          },
          "721442107": {
            "id": "721442107",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Especially idiots. I don't know any of them.",
            "nextDialogs": [
              "721442108"
            ]
          },
          "721442108": {
            "id": "721442108",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "However... please thank him for returning the badge.",
            "nextDialogs": [
              "721442109"
            ]
          },
          "721442109": {
            "id": "721442109",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Also, the Uyuu Restaurant seems like a fine place. I will go there for drinks when I am free.",
            "nextDialogs": [
              "721442110"
            ]
          },
          "721442110": {
            "id": "721442110",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Go for a few drinks and get to know that idiot along the way."
          }
        }
      }
    },
    {
      "subId": "7214409",
      "subQuestName": "Go back and find Hiromi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440601"
        ],
        "dialogs": {
          "721440601": {
            "id": "721440601",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "So, did you manage to get any news of \"Big Sis\"?",
            "nextDialogs": [
              "721440602"
            ]
          },
          "721440602": {
            "id": "721440602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We've spoken, aye.",
            "nextDialogs": [
              "721440603"
            ]
          },
          "721440603": {
            "id": "721440603",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "What did she say? Don't tell me she's already forgotten about me?",
            "nextDialogs": [
              "721440604"
            ]
          },
          "721440604": {
            "id": "721440604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She doesn't know a Hiromi.",
            "nextDialogs": [
              "721440605"
            ]
          },
          "721440605": {
            "id": "721440605",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "But...!",
            "nextDialogs": [
              "721440606"
            ]
          },
          "721440606": {
            "id": "721440606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, that's because she can't get to know any public servants.",
            "nextDialogs": [
              "721440607"
            ]
          },
          "721440607": {
            "id": "721440607",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "...",
            "nextDialogs": [
              "721440608"
            ]
          },
          "721440608": {
            "id": "721440608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Idiotic ones least of all.",
            "nextDialogs": [
              "721440609"
            ]
          },
          "721440609": {
            "id": "721440609",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Uhh...",
            "nextDialogs": [
              "721440610"
            ]
          },
          "721440610": {
            "id": "721440610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still, she thinks that...",
            "nextDialogs": [
              "721440611"
            ]
          },
          "721440611": {
            "id": "721440611",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "She thinks that?",
            "nextDialogs": [
              "721440612"
            ]
          },
          "721440612": {
            "id": "721440612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That she can give it a try.",
            "nextDialogs": [
              "721440613"
            ]
          },
          "721440613": {
            "id": "721440613",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Uh...?",
            "nextDialogs": [
              "721440614"
            ]
          },
          "721440614": {
            "id": "721440614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sounds like a date, doesn't it?",
            "nextDialogs": [
              "721440615"
            ]
          },
          "721440615": {
            "id": "721440615",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Eh! Eh!? Is that how you see it?",
            "nextDialogs": [
              "721440616"
            ]
          },
          "721440616": {
            "id": "721440616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is that so strange...?",
            "nextDialogs": [
              "721440617"
            ]
          },
          "721440617": {
            "id": "721440617",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "N—No... it's just... I wasn't expecting this response.",
            "nextDialogs": [
              "721440618"
            ]
          },
          "721440618": {
            "id": "721440618",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll go if you won't.",
            "nextDialogs": [
              "721440619"
            ]
          },
          "721440619": {
            "id": "721440619",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Wha—! No! There's no need for that! I can take care of this myself!",
            "nextDialogs": [
              "721440620"
            ]
          },
          "721440620": {
            "id": "721440620",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "But... she didn't mention when she'll \"try to get to know me,\" did she?",
            "nextDialogs": [
              "721440623"
            ]
          },
          "721440623": {
            "id": "721440623",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "#Yes, you're right... Anyway, you have my thanks, {NICKNAME}.",
            "nextDialogs": [
              "721440624"
            ]
          },
          "721440624": {
            "id": "721440624",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Perhaps I still need time to digest everything that she said. Well, I can't claim to be disappointed with this answer either way.",
            "nextDialogs": [
              "721440625"
            ]
          },
          "721440625": {
            "id": "721440625",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Sorry for the trouble. Here's your payment.",
            "nextDialogs": [
              "721440626"
            ]
          },
          "721440626": {
            "id": "721440626",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't forget, now: \"Uyuu Restaurant.\"",
            "nextDialogs": [
              "721440627"
            ]
          },
          "721440627": {
            "id": "721440627",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "I got it. Thank you!",
            "nextDialogs": [
              "721440628"
            ]
          },
          "721440628": {
            "id": "721440628",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "#By the way, {NICKNAME}, I wish you all the best here in Inazuma."
          }
        }
      }
    },
    {
      "subId": "7214401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440101"
        ],
        "dialogs": {
          "721440101": {
            "id": "721440101",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Yo, outlander! What are you doing sneaking around?",
            "nextDialogs": [
              "721440104"
            ]
          },
          "721440104": {
            "id": "721440104",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Don't bother me with anything unimportant, outlander. Otherwise, I'll kindly have you accompany me to the Outlander Affairs Agency.",
            "nextDialogs": [
              "721440105"
            ]
          },
          "721440105": {
            "id": "721440105",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "I have no idea how you got here, but it's a criminal offense to interfere with a samurai's job.",
            "nextDialogs": [
              "721440106"
            ]
          },
          "721440106": {
            "id": "721440106",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "The Kanjou Commissioner will punish you severely should he find out.",
            "nextDialogs": [
              "721440107"
            ]
          },
          "721440107": {
            "id": "721440107",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "So I'd advise you to stay back — for your own safety.",
            "nextDialogs": [
              "721440108"
            ]
          },
          "721440108": {
            "id": "721440108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Kanjou Commission?",
            "nextDialogs": [
              "721440109"
            ]
          },
          "721440109": {
            "id": "721440109",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Are you serious? Do you outlanders not fear the Commissioner anymore nowadays?"
          }
        }
      }
    },
    {
      "subId": "7214408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440801"
        ],
        "dialogs": {
          "721440801": {
            "id": "721440801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you waiting for someone?",
            "nextDialogs": [
              "721440802"
            ]
          },
          "721440802": {
            "id": "721440802",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "... So what if I am?"
          }
        }
      }
    },
    {
      "subId": "7214409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440901"
        ],
        "dialogs": {
          "721440901": {
            "id": "721440901",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "If you've got something to say, say it fast. Us Treasure Hoarders, our time's not yours for the wastin'."
          }
        }
      }
    },
    {
      "subId": "7214410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441001"
        ],
        "dialogs": {
          "721441001": {
            "id": "721441001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about Hiromi...",
            "nextDialogs": [
              "721441002"
            ]
          },
          "721441002": {
            "id": "721441002",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Ah, he's a good lad... But he's a big baby, too. He needs a bit more time to grow.",
            "nextDialogs": [
              "721441003"
            ]
          },
          "721441003": {
            "id": "721441003",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "So I say, but in the end, being immature is better than being evil.",
            "nextDialogs": [
              "721441004"
            ]
          },
          "721441004": {
            "id": "721441004",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "He has his livelihood and his responsibilities...",
            "nextDialogs": [
              "721441005"
            ]
          },
          "721441005": {
            "id": "721441005",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "It's not all his fault either that he's scared to make choices.",
            "nextDialogs": [
              "721441006"
            ]
          },
          "721441006": {
            "id": "721441006",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "At least he's still got some choices to make."
          }
        }
      }
    },
    {
      "subId": "7214413",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441301"
        ],
        "dialogs": {
          "721441301": {
            "id": "721441301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, just asking.",
            "nextDialogs": [
              "721441302"
            ]
          },
          "721441302": {
            "id": "721441302",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Please don't ask me pointless questions while I'm on duty.",
            "nextDialogs": [
              "721441303"
            ]
          },
          "721441303": {
            "id": "721441303",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Come on, please stop bothering me. Please leave."
          }
        }
      }
    },
    {
      "subId": "7214415",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441501"
        ],
        "dialogs": {
          "721441501": {
            "id": "721441501",
            "speakerId": 1003,
            "speakerName": "Sun Yu",
            "text": "Please go after those bandits. Don't let me slow you down.",
            "nextDialogs": [
              "721441502"
            ]
          },
          "721441502": {
            "id": "721441502",
            "speakerId": 1003,
            "speakerName": "Sun Yu",
            "text": "Oh! I see! Then you must be here to help me—",
            "nextDialogs": [
              "721441503"
            ]
          },
          "721441503": {
            "id": "721441503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "By your leave!"
          }
        }
      }
    },
    {
      "subId": "7214416",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441601"
        ],
        "dialogs": {
          "721441601": {
            "id": "721441601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here?",
            "nextDialogs": [
              "721441602"
            ]
          },
          "721441602": {
            "id": "721441602",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "What else could it be? I'm one of the Treasure Hoarders, so I'm here for the treasure, of course!"
          }
        }
      }
    },
    {
      "subId": "7214417",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441701"
        ],
        "dialogs": {
          "721441701": {
            "id": "721441701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And why won't you go inside?",
            "nextDialogs": [
              "721441702"
            ]
          },
          "721441702": {
            "id": "721441702",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Are you trying to get me killed? It's dangerous inside!",
            "nextDialogs": [
              "721441703"
            ]
          },
          "721441703": {
            "id": "721441703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, if someone were to get the treasure first...",
            "nextDialogs": [
              "721441704"
            ]
          },
          "721441704": {
            "id": "721441704",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Hah! What I don't know about can't affect my bottom line.",
            "nextDialogs": [
              "721441705"
            ]
          },
          "721441705": {
            "id": "721441705",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "That's a Treasure Hoarder-patented survival technique!",
            "nextDialogs": [
              "721441706"
            ]
          },
          "721441706": {
            "id": "721441706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Jeez...",
            "nextDialogs": [
              "721441707"
            ]
          },
          "721441707": {
            "id": "721441707",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Hehe~"
          }
        }
      }
    },
    {
      "subId": "7214418",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441801"
        ],
        "dialogs": {
          "721441801": {
            "id": "721441801",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Yes, I did. What of it?",
            "nextDialogs": [
              "721441802"
            ]
          },
          "721441802": {
            "id": "721441802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you referring to this?"
          }
        }
      }
    },
    {
      "subId": "7214419",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441901"
        ],
        "dialogs": {
          "721441901": {
            "id": "721441901",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Well then, what's the matter? Did you finally remember that you might have to arrest me, O Hero of Liyue?",
            "nextDialogs": [
              "721441902"
            ]
          },
          "721441902": {
            "id": "721441902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please take this."
          }
        }
      }
    }
  ]
}
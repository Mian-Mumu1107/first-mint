  "subQuests": [
    {
      "subId": "7214401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440701"
        ],
        "dialogs": {
          "721440701": {
            "id": "721440701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "721440702"
            ]
          },
          "721440702": {
            "id": "721440702",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "None of your business.",
            "nextDialogs": [
              "721440703"
            ]
          },
          "721440703": {
            "id": "721440703",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Alright, I'll... let you go this time. Just please, leave me alone."
          }
        }
      }
    },
    {
      "subId": "7214410",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441401"
        ],
        "dialogs": {
          "721441401": {
            "id": "721441401",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "... Why'd you come again? If you got something to say, hurry up!",
            "nextDialogs": [
              "721441402"
            ]
          },
          "721441402": {
            "id": "721441402",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Don't interrupt a man while he's waiting for someone!",
            "nextDialogs": [
              "721441403"
            ]
          },
          "721441403": {
            "id": "721441403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Waiting for someone far outside his realm of jurisdiction?",
            "nextDialogs": [
              "721441404"
            ]
          },
          "721441404": {
            "id": "721441404",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "What are you trying to say?",
            "nextDialogs": [
              "721441405"
            ]
          },
          "721441405": {
            "id": "721441405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not some proper folk you're meeting then, eh?",
            "nextDialogs": [
              "721441406"
            ]
          },
          "721441406": {
            "id": "721441406",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "O—Of course I wouldn't... Are you questioning a public servant?",
            "nextDialogs": [
              "721441407"
            ]
          },
          "721441407": {
            "id": "721441407",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "I'm on duty and waiting for my informant... a contact...",
            "nextDialogs": [
              "721441408"
            ]
          },
          "721441408": {
            "id": "721441408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Speak up, I can barely hear you anymore.",
            "nextDialogs": [
              "721441409"
            ]
          },
          "721441409": {
            "id": "721441409",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Ugh, enough! Leave, or you'll be coming with me to the Outlander Affairs Agency on charges of obstructing a personnel on official duty!",
            "nextDialogs": [
              "721441412"
            ]
          },
          "721441412": {
            "id": "721441412",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "!?",
            "nextDialogs": [
              "721441413"
            ]
          },
          "721441413": {
            "id": "721441413",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Are you not afraid of being deported by the Commissioner?"
          }
        }
      }
    },
    {
      "subId": "7214411",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441101"
        ],
        "dialogs": {
          "721441101": {
            "id": "721441101",
            "speakerId": 1001,
            "speakerName": "Little Que'er",
            "text": "If you have anything to say, please talk to my senior disciple. I know you don't like listening to me anyway.",
            "nextDialogs": [
              "721441102"
            ]
          },
          "721441102": {
            "id": "721441102",
            "speakerId": 1001,
            "speakerName": "Little Que'er",
            "text": "Hmph... No one likes to listen to me..."
          }
        }
      }
    },
    {
      "subId": "7214413",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721442001"
        ],
        "dialogs": {
          "721442001": {
            "id": "721442001",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "This is it! Her badge is inside, too.",
            "nextDialogs": [
              "721442002"
            ]
          },
          "721442002": {
            "id": "721442002",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "I don't know how to thank you enough...",
            "nextDialogs": [
              "721442003"
            ]
          },
          "721442003": {
            "id": "721442003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You wouldn't mind me reading it, would you?",
            "nextDialogs": [
              "721442004"
            ]
          },
          "721442004": {
            "id": "721442004",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Eh? What? Please don't...",
            "nextDialogs": [
              "721442005"
            ]
          },
          "721442005": {
            "id": "721442005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Do you still remember the Uyuu Restaurant?\"",
            "nextDialogs": [
              "721442006"
            ]
          },
          "721442006": {
            "id": "721442006",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Uh...",
            "nextDialogs": [
              "721442007"
            ]
          },
          "721442007": {
            "id": "721442007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"We shall meet there... \"",
            "nextDialogs": [
              "721442008"
            ]
          },
          "721442008": {
            "id": "721442008",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Wait—",
            "nextDialogs": [
              "721442009"
            ]
          },
          "721442009": {
            "id": "721442009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"You will find money for wine attached herein.\"",
            "nextDialogs": [
              "721442010"
            ]
          },
          "721442010": {
            "id": "721442010",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Okay—",
            "nextDialogs": [
              "721442011"
            ]
          },
          "721442011": {
            "id": "721442011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"But if you are not the one I was expecting to receive this letter...\"",
            "nextDialogs": [
              "721442012"
            ]
          },
          "721442012": {
            "id": "721442012",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "#Please stop reading it! {NICKNAME}, that was very, incredibly rude of you!",
            "nextDialogs": [
              "721442015"
            ]
          },
          "721442015": {
            "id": "721442015",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Stop messing around! If you want to help me, just say so!"
          }
        }
      }
    },
    {
      "subId": "7214403",
      "subQuestName": "Go to the north of Narukami Island to find traces of Shun",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440201"
        ],
        "dialogs": {
          "721440201": {
            "id": "721440201",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Huh? Why are you here? And who's that you've brought along?",
            "nextDialogs": [
              "721440202"
            ]
          },
          "721440202": {
            "id": "721440202",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Didn't we agree to meet alone?",
            "nextDialogs": [
              "721440203"
            ]
          },
          "721440203": {
            "id": "721440203",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Eh, I understand. But if it's about \"that case,\" then tell your colleagues that it's not time yet.",
            "nextDialogs": [
              "721440204"
            ]
          },
          "721440204": {
            "id": "721440204",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "This isn't about that... it's the matter from last week. The one you promised me about.",
            "nextDialogs": [
              "721440205"
            ]
          },
          "721440205": {
            "id": "721440205",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Oh? Not that case? Then which one are you talking about? I'm a law-abiding citizen these days, you know! I'm squeaky clean!",
            "nextDialogs": [
              "721440206"
            ]
          },
          "721440206": {
            "id": "721440206",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "This isn't the time we agreed on, either way. I mean, I just got out of jail two weeks ago.",
            "nextDialogs": [
              "721440207"
            ]
          },
          "721440207": {
            "id": "721440207",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Oh yeah, I've got it now... are you trying to preemptively arrest me to gain some credit?",
            "nextDialogs": [
              "721440208"
            ]
          },
          "721440208": {
            "id": "721440208",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "No, that's not it at all... And what gain would there be in catching someone like you?",
            "nextDialogs": [
              "721440209"
            ]
          },
          "721440209": {
            "id": "721440209",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Ouch! Not in the feelings, man! I'm at least a Treasure Hoarder Cadre. I'll have you know that I'm pretty well-known on the streets, too!",
            "nextDialogs": [
              "721440210"
            ]
          },
          "721440210": {
            "id": "721440210",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "No, wait, I get it now! You must be—",
            "nextDialogs": [
              "721440213"
            ]
          },
          "721440213": {
            "id": "721440213",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "*sigh*",
            "nextDialogs": [
              "721440214"
            ]
          },
          "721440214": {
            "id": "721440214",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Man, not even knowing who the Treasure Hoarders are... Is your colleague over here new or something?",
            "nextDialogs": [
              "721440215"
            ]
          },
          "721440215": {
            "id": "721440215",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Shut up.",
            "nextDialogs": [
              "721440216"
            ]
          },
          "721440216": {
            "id": "721440216",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "#Listen, {NICKNAME}. Shun is my informant. Please, don't make an unnecessary fuss out of this.",
            "nextDialogs": [
              "721440217"
            ]
          },
          "721440217": {
            "id": "721440217",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "Look, Shun, I came here with this outl— I mean, friend of mine, to ask you about where \"Big Sis\" is. I... I want to get in touch with her again.",
            "nextDialogs": [
              "721440218"
            ]
          },
          "721440218": {
            "id": "721440218",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Oh... Hahahahhaha!",
            "nextDialogs": [
              "721440219"
            ]
          },
          "721440219": {
            "id": "721440219",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "What on earth are you laughing at, huh? What's your issue?",
            "nextDialogs": [
              "721440220"
            ]
          },
          "721440220": {
            "id": "721440220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, what he said.",
            "nextDialogs": [
              "721440221"
            ]
          },
          "721440221": {
            "id": "721440221",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Hahaha, you're hilarious!",
            "nextDialogs": [
              "721440222"
            ]
          },
          "721440222": {
            "id": "721440222",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "So here's the skinny, Traveler. The three of us have known each other since we were wetting beds.",
            "nextDialogs": [
              "721440223"
            ]
          },
          "721440223": {
            "id": "721440223",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "This was back before the Sakoku Decree. Way before Hiromi became some stick-in-the-mud, too.",
            "nextDialogs": [
              "721440224"
            ]
          },
          "721440224": {
            "id": "721440224",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "*sigh* I mean, just look at what the Commission headquarters did to a good boy like him.",
            "nextDialogs": [
              "721440225"
            ]
          },
          "721440225": {
            "id": "721440225",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "With me, they turned a good boy into a public servant who protects the people. With him, they turned a bad boy into a Treasure Hoarder.",
            "nextDialogs": [
              "721440226"
            ]
          },
          "721440226": {
            "id": "721440226",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Alright, alright, I'll be straight with you. See, you knew who we were before the Sakoku Decree was implemented, right?",
            "nextDialogs": [
              "721440227"
            ]
          },
          "721440227": {
            "id": "721440227",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "There you have it: that's why she left Inazuma.",
            "nextDialogs": [
              "721440228"
            ]
          },
          "721440228": {
            "id": "721440228",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Bet you wrote about Uyuu Restaurant in your last letter, eh? Don't worry, I miss it too.",
            "nextDialogs": [
              "721440229"
            ]
          },
          "721440229": {
            "id": "721440229",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "We even had a drink there the day before the Sakoku Decree took effect.",
            "nextDialogs": [
              "721440230"
            ]
          },
          "721440230": {
            "id": "721440230",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Everyone could tell what you were thinking, trust me.",
            "nextDialogs": [
              "721440231"
            ]
          },
          "721440231": {
            "id": "721440231",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "But well, isn't it a crying shame that your Shogun hates outlander drifters, eh?",
            "nextDialogs": [
              "721440232"
            ]
          },
          "721440232": {
            "id": "721440232",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "...Let's just get back to business.",
            "nextDialogs": [
              "721440233"
            ]
          },
          "721440233": {
            "id": "721440233",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Is any of this business?",
            "nextDialogs": [
              "721440234"
            ]
          },
          "721440234": {
            "id": "721440234",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "Alright, I'm done messing with you. And I'd love to help you too, but... I don't think I can.",
            "nextDialogs": [
              "721440235"
            ]
          },
          "721440235": {
            "id": "721440235",
            "speakerId": 1000,
            "speakerName": "Hiromi",
            "text": "What do you mean?",
            "nextDialogs": [
              "721440236"
            ]
          },
          "721440236": {
            "id": "721440236",
            "speakerId": 1002,
            "speakerName": "Shun",
            "text": "...It's a long story."
          }
        }
      }
    },
    {
      "subId": "7214404",
      "subQuestName": "Go to Jueyun Karst to search for Sun Yu and Little Que'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440301"
        ],
        "dialogs": {
          "721440301": {
            "id": "721440301",
            "speakerId": 1003,
            "speakerName": "Sun Yu",
            "text": "Ah, it's you, Traveler. Your great name is known throughout Liyue Harbor. Might I inquire as to why you have elected to grace us with your...",
            "nextDialogs": [
              "721440302"
            ]
          },
          "721440302": {
            "id": "721440302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're talking all funny.",
            "nextDialogs": [
              "721440303"
            ]
          },
          "721440303": {
            "id": "721440303",
            "speakerId": 1003,
            "speakerName": "Sun Yu",
            "text": "Ah. I am presently trying to teach Que'er how to treat people with the proper etiquette. As the saying goes, \"Those without credibility have no leg to stand on, and those without etiquette...\"",
            "nextDialogs": [
              "721440306"
            ]
          },
          "721440306": {
            "id": "721440306",
            "speakerId": 1003,
            "speakerName": "Sun Yu",
            "text": "Alright. Then, may I help you?",
            "nextDialogs": [
              "721440307"
            ]
          },
          "721440307": {
            "id": "721440307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm looking for a certain female thief.",
            "nextDialogs": [
              "721440308"
            ]
          },
          "721440308": {
            "id": "721440308",
            "speakerId": 1003,
            "speakerName": "Sun Yu",
            "text": "Oh, so you have come to perform the chivalrous act of hunting down criminals. The Guhua Clan will definitely support that! What aid may we lend you?"
          }
        }
      }
    },
    {
      "subId": "7214405",
      "subQuestName": "Go to Mt. Hulao to search for traces of \"Big Sis\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440501"
        ],
        "dialogs": {
          "721440501": {
            "id": "721440501",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "So, I suppose that you've got something you need my help with, then!",
            "nextDialogs": [
              "721440504"
            ]
          },
          "721440504": {
            "id": "721440504",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Hah! You can't fool me.",
            "nextDialogs": [
              "721440505"
            ]
          },
          "721440505": {
            "id": "721440505",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "You outlanders have faces that can hide no secrets."
          }
        }
      }
    },
    {
      "subId": "7214406",
      "subQuestName": "Talk to \"Big Sis\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440401"
        ],
        "dialogs": {
          "721440401": {
            "id": "721440401",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "*cough* *cough* *panting* Phew, thought I'd never get out!",
            "nextDialogs": [
              "721440402"
            ]
          },
          "721440402": {
            "id": "721440402",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Thanks for saving my life, stranger...?",
            "nextDialogs": [
              "721440403"
            ]
          },
          "721440403": {
            "id": "721440403",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Eh!? It's you!",
            "nextDialogs": [
              "721440404"
            ]
          },
          "721440404": {
            "id": "721440404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're...",
            "nextDialogs": [
              "721440405"
            ]
          },
          "721440405": {
            "id": "721440405",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Aren't you that... that... !",
            "nextDialogs": [
              "721440406"
            ]
          },
          "721440406": {
            "id": "721440406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, so it's \"that\"...",
            "nextDialogs": [
              "721440407"
            ]
          },
          "721440407": {
            "id": "721440407",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Yes! And that time in Qingce, too... that...!",
            "nextDialogs": [
              "721440408"
            ]
          },
          "721440408": {
            "id": "721440408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah. Definitely \"that.\"",
            "nextDialogs": [
              "721440409"
            ]
          },
          "721440409": {
            "id": "721440409",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Yes! That's right! So... did you get any mileage out of those Chi remains?",
            "nextDialogs": [
              "721440412"
            ]
          },
          "721440412": {
            "id": "721440412",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Ah—hahahaha!",
            "nextDialogs": [
              "721440413"
            ]
          },
          "721440413": {
            "id": "721440413",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Ah, you're something, alright. So it really was you who turned my brothers inside-out back in Qingce Village.",
            "nextDialogs": [
              "721440414"
            ]
          },
          "721440414": {
            "id": "721440414",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Well, regardless, you have my thanks for saving my life.",
            "nextDialogs": [
              "721440415"
            ]
          },
          "721440415": {
            "id": "721440415",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "Otherwise, I don't know how long I would have been trapped in this accursed amber. It was awful in there...",
            "nextDialogs": [
              "721440416"
            ]
          },
          "721440416": {
            "id": "721440416",
            "speakerId": 1004,
            "speakerName": "Yan'er",
            "text": "The vaunted adepti of Jueyun Karst — a pack of petty jerks, I tell you!"
          }
        }
      }
    },
    {
      "subId": "7214407",
      "subQuestName": "Rescue Yan'er",
      "sceneId": null,
      "locations": [],

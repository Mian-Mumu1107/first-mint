  "subQuests": [
    {
      "subId": "2401601",
      "subQuestName": "Talk to Chalmet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160101"
        ],
        "dialogs": {
          "240160101": {
            "id": "240160101",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "That should do it... I hope these materials will actually be useful.",
            "nextDialogs": [
              "240160102"
            ]
          },
          "240160102": {
            "id": "240160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you still organizing files?",
            "nextDialogs": [
              "240160103"
            ]
          },
          "240160103": {
            "id": "240160103",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Oho! Pleasure to see you, Honorary Senior Researcher.",
            "nextDialogs": [
              "240160104"
            ]
          },
          "240160104": {
            "id": "240160104",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "That's correct! I am continuing to organize the documents and files according to Mr. Raimondo's instructions... Wait, haven't I said this before?",
            "nextDialogs": [
              "240160105"
            ]
          },
          "240160105": {
            "id": "240160105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But this place is huge! It's way too much work for one person. Why didn't he assign anyone to help you?",
            "nextDialogs": [
              "240160106"
            ]
          },
          "240160106": {
            "id": "240160106",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "The Research Institute has many pressing matters to deal with. It's normal that there's no one available to help me.",
            "nextDialogs": [
              "240160107"
            ]
          },
          "240160107": {
            "id": "240160107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And you're a Director too...",
            "nextDialogs": [
              "240160108"
            ]
          },
          "240160108": {
            "id": "240160108",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "You mean my title as Fontaine Research Institute Materials Retrieval Project Director? *sigh* Please don't mock me so...",
            "nextDialogs": [
              "240160109"
            ]
          },
          "240160109": {
            "id": "240160109",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "In what way am I actually a Director? From the very beginning, I have been no more than an ordinary staffer responsible for organizing files.",
            "nextDialogs": [
              "240160110"
            ]
          },
          "240160110": {
            "id": "240160110",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "After Mr. Raimondo assigned me here to organize the files, I was suddenly informed of my new title.",
            "nextDialogs": [
              "240160111"
            ]
          },
          "240160111": {
            "id": "240160111",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Someone said this was Mr. Choiseul's idea. Apparently he thinks that since our work is so onerous, giving us such titles will make providing additional compensation easier...",
            "nextDialogs": [
              "240160112"
            ]
          },
          "240160112": {
            "id": "240160112",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Ah! Don't tell anyone else, how could I... how could I just say it out loud like that...",
            "nextDialogs": [
              "240160113"
            ]
          },
          "240160113": {
            "id": "240160113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm the silent type, relax.",
            "nextDialogs": [
              "240160114"
            ]
          },
          "240160114": {
            "id": "240160114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That sounds not bad at all! And after all, it's only fair that those who do all the work should receive a bit more compensation.",
            "nextDialogs": [
              "240160115"
            ]
          },
          "240160115": {
            "id": "240160115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But why use such a roundabout method? Can't they just give everyone more Mora?",
            "nextDialogs": [
              "240160118"
            ]
          },
          "240160118": {
            "id": "240160118",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "*sigh* I can never understand just what the two of them are thinking...",
            "nextDialogs": [
              "240160119"
            ]
          },
          "240160119": {
            "id": "240160119",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "But I have to keep working, no matter what! There's too much to do.",
            "nextDialogs": [
              "240160120"
            ]
          },
          "240160120": {
            "id": "240160120",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Honorary Senior Researcher, if you are willing, could you please give me a hand?"
          }
        }
      }
    },
    {
      "subId": "2401602",
      "subQuestName": "Clean up the filth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160201"
        ],
        "dialogs": {
          "240160201": {
            "id": "240160201",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "*sigh* I never noticed there were so many files in the Institute before..."
          }
        }
      }
    },
    {
      "subId": "2401603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160301"
        ],
        "dialogs": {
          "240160301": {
            "id": "240160301",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Phew... Thanks for your help. Were it not for you, who knows how long it would have taken me...",
            "nextDialogs": [
              "240160302"
            ]
          },
          "240160302": {
            "id": "240160302",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "No wonder you're the Honorary Senior Researcher. No matter what you do, you do it well.",
            "nextDialogs": [
              "240160306",
              "240160305"
            ]
          },
          "240160306": {
            "id": "240160306",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "I must thank you again for your help, Honorary Senior Researcher. Please, take these."
          },
          "240160305": {
            "id": "240160305",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Huh? Then you truly are multitalented, and eminently worthy of your title!"
          }
        }
      }
    },
    {
      "subId": "2401604",
      "subQuestName": "Report back to Chalmet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2401604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240160401"
        ],
        "dialogs": {
          "240160401": {
            "id": "240160401",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Phew... Thanks for your help. Were it not for you, who knows how long it would have taken me...",
            "nextDialogs": [
              "240160402"
            ]
          },
          "240160402": {
            "id": "240160402",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Though, if you had been a bit gentler with the cleaning, that would have been even better...",
            "nextDialogs": [
              "240160405"
            ]
          },
          "240160405": {
            "id": "240160405",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "Don't misunderstand! I'm not blaming you, you really did do me a huge favor.",
            "nextDialogs": [
              "240160406"
            ]
          },
          "240160406": {
            "id": "240160406",
            "speakerId": 5256,
            "speakerName": "Chalmet",
            "text": "These are for you. Thank you for your help, Honorary Senior Researcher."
          }
        }
      }
    }
  ]
}
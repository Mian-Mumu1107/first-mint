            "speakerName": "\"Masanori\"",
            "text": "You're here.",
            "nextDialogs": [
              "721590102"
            ]
          },
          "721590102": {
            "id": "721590102",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "Shall we spar?"
          }
        }
      }
    },
    {
      "subId": "7215902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721590201"
        ],
        "dialogs": {
          "721590201": {
            "id": "721590201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well then, have at it.",
            "nextDialogs": [
              "721590202"
            ]
          },
          "721590202": {
            "id": "721590202",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "Very good. Let us fight."
          }
        }
      }
    },
    {
      "subId": "7215903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721590301"
        ],
        "dialogs": {
          "721590301": {
            "id": "721590301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd like to talk.",
            "nextDialogs": [
              "721590302"
            ]
          },
          "721590302": {
            "id": "721590302",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "I have forsaken my past. There is nothing to be said between me and this world.",
            "nextDialogs": [
              "721590303"
            ]
          },
          "721590303": {
            "id": "721590303",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "If you are looking for someone to chat with, you have come to the wrong person.",
            "nextDialogs": [
              "721590304"
            ]
          },
          "721590304": {
            "id": "721590304",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "Kindly leave."
          }
        }
      }
    },
    {
      "subId": "7215904",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721590501"
        ],
        "dialogs": {
          "721590501": {
            "id": "721590501",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "It seems that you have neglected your training.",
            "nextDialogs": [
              "721590502"
            ]
          },
          "721590502": {
            "id": "721590502",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "A single day of sloth will waste ten of a warrior's work. I'm sure you understand this principle well.",
            "nextDialogs": [
              "721590503"
            ]
          },
          "721590503": {
            "id": "721590503",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "Hone yourself further. I do not believe that is all you can do."
          }
        }
      }
    },
    {
      "subId": "7215905",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721590401"
        ],
        "dialogs": {
          "721590401": {
            "id": "721590401",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "Haha. I am still not your match.",
            "nextDialogs": [
              "721590402"
            ]
          },
          "721590402": {
            "id": "721590402",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "I should probably have expected that. You are ever advancing in skill, and the limits of my nature prevent me from making a similar breakthrough.",
            "nextDialogs": [
              "721590403"
            ]
          },
          "721590403": {
            "id": "721590403",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "Nonetheless, should you learn any new techniques, I would be glad to see them.",
            "nextDialogs": [
              "721590404"
            ]
          },
          "721590404": {
            "id": "721590404",
            "speakerId": 3174,
            "speakerName": "\"Masanori\"",
            "text": "Until we meet again, then."
          }
        }
      }
    }
  ]
}
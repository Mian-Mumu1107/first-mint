    {
      "subId": "7215801",
      "subQuestName": "Seal the Warding Stone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721580101"
        ],
        "dialogs": {
          "721580101": {
            "id": "721580101",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "The storm... has passed.",
            "nextDialogs": [
              "721580102"
            ]
          },
          "721580102": {
            "id": "721580102",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "It seems like all four Warding Stones have been sealed.",
            "nextDialogs": [
              "721580103"
            ]
          },
          "721580103": {
            "id": "721580103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That they have.",
            "nextDialogs": [
              "721580104"
            ]
          },
          "721580104": {
            "id": "721580104",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "I—It's you! How did you get up there?",
            "nextDialogs": [
              "721580105"
            ]
          },
          "721580105": {
            "id": "721580105",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "Taisuke said that you passed through some kind of door — and then you disappeared.",
            "nextDialogs": [
              "721580106"
            ]
          },
          "721580106": {
            "id": "721580106",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "What on earth is with that door? How strange...",
            "nextDialogs": [
              "721580107"
            ]
          },
          "721580107": {
            "id": "721580107",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "What happened up there, exactly?",
            "nextDialogs": [
              "721580108"
            ]
          },
          "721580108": {
            "id": "721580108",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "Etsuko and I heard a sudden rumbling from above, almost like thunder.",
            "nextDialogs": [
              "721580109"
            ]
          },
          "721580109": {
            "id": "721580109",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "But the storm should have abated already...",
            "nextDialogs": [
              "721580110"
            ]
          },
          "721580110": {
            "id": "721580110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, here's what happened...",
            "nextDialogs": [
              "721580111"
            ]
          },
          "721580111": {
            "id": "721580111",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "Rocks floating in the sky... formed a platform...",
            "nextDialogs": [
              "721580112"
            ]
          },
          "721580112": {
            "id": "721580112",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "Huh. That's... I must confess that I've never heard of such a natural phenomenon occurring on Seirai Island...",
            "nextDialogs": [
              "721580113"
            ]
          },
          "721580113": {
            "id": "721580113",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "...Which part of that sounds like a natural phenomenon, seriously...",
            "nextDialogs": [
              "721580114"
            ]
          },
          "721580114": {
            "id": "721580114",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "It's super unnatural no matter how you look at it.",
            "nextDialogs": [
              "721580117"
            ]
          },
          "721580117": {
            "id": "721580117",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "Well, natural or otherwise, the storm over Seirai Island has been calmed, and our commission is complete...",
            "nextDialogs": [
              "721580118"
            ]
          },
          "721580118": {
            "id": "721580118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know, we also found this strange feather...",
            "nextDialogs": [
              "721580119"
            ]
          },
          "721580119": {
            "id": "721580119",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "This is... Taisuke, you have a look.",
            "nextDialogs": [
              "721580120"
            ]
          },
          "721580120": {
            "id": "721580120",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "Alright, allow me...",
            "nextDialogs": [
              "721580121"
            ]
          },
          "721580121": {
            "id": "721580121",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "Apologies, but I have no idea where this feather came from.",
            "nextDialogs": [
              "721580122"
            ]
          },
          "721580122": {
            "id": "721580122",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "This feather's pattern and texture are nothing like any birds I know of.",
            "nextDialogs": [
              "721580123"
            ]
          },
          "721580123": {
            "id": "721580123",
            "speakerId": 1001,
            "speakerName": "Taisuke",
            "text": "And if you study its dimensions and the ratios involved, this bird would have been as large as that stone platform up there in the sky.",
            "nextDialogs": [
              "721580124"
            ]
          },
          "721580124": {
            "id": "721580124",
            "speakerId": 1000,
            "speakerName": "Etsuko",
            "text": "Is this feather that important? If you want to figure its history out, why don't you put up a commission at the Guild? Who knows, you might run into someone who can give you a lead."
          }
        }
      }
    },

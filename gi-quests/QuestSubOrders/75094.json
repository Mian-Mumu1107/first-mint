        "dialogs": {
          "750940601": {
            "id": "750940601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whew... That sure was scary, with those monsters attacking out of nowhere like that. Good thing we're super strong, huh?",

              "750940605"
            ]
          },
          "750940603": {
            "id": "750940603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? No no no, Paimon can't do that! Who'd want to fight those scary monsters, anyway!?",
            "nextDialogs": [
              "750940606"
            ]
          },
          "750940606": {
            "id": "750940606",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr!",

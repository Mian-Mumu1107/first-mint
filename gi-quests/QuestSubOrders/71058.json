      "dialogue": {
        "startDialogs": [
          "710580101"
        ],
        "dialogs": {
          "710580101": {
            "id": "710580101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "*cough*... W—Wait! Stop! Who are you? Why are you here...?",
            "nextDialogs": [
              "710580102"
            ]
          },
          "710580102": {
            "id": "710580102",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "And... why are you attacking me?",
            "nextDialogs": [
              "710580103"
            ]
          },
          "710580103": {
            "id": "710580103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You are one to talk! We saw you sneaking around!",
            "nextDialogs": [
              "710580104"
            ]
          },
          "710580104": {
            "id": "710580104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Since you're the bad guy here, why don't you explain yourself first?",
            "nextDialogs": [
              "710580105"
            ]
          },
          "710580105": {
            "id": "710580105",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "...Katarina. My name is Katarina Snezhevna.",
            "nextDialogs": [
              "710580106"
            ]
          },
          "710580106": {
            "id": "710580106",
            "speakerId": 1002,
            "speakerName": "Katarina",
            "text": "My name is the most I can divulge. My apologies.",
            "nextDialogs": [
              "710580107"
            ]
          },
          "710580107": {
            "id": "710580107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh... We just want to know what's happening. We aren't trying to interrogate you!",
            "nextDialogs": [
              "710580108"
            ]
          },
          "710580108": {
            "id": "710580108",
            "speakerId": 1002,
            "speakerName": "Katarina",
            "text": "S—Sorry. That really is all I can disclose.",
            "nextDialogs": [
              "710580109"
            ]
          },
          "710580109": {
            "id": "710580109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are the Fatui doing here?",
            "nextDialogs": [
              "710580110"
            ]
          },
          "710580110": {
            "id": "710580110",
            "speakerId": 1002,
            "speakerName": "Katarina",
            "text": "That's classified.",
            "nextDialogs": [
              "710580111"
            ]
          },
          "710580111": {
            "id": "710580111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "710580112"
            ]
          },
          "710580112": {
            "id": "710580112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Come on, bad guys do have a thing for being secretive!",
            "nextDialogs": [
              "710580113"
            ]
          },
          "710580113": {
            "id": "710580113",
            "speakerId": 1002,
            "speakerName": "Katarina",
            "text": "Hehe, you're right. We're the bad guys and that's what we do.",
            "nextDialogs": [
              "710580114"
            ]
          },
          "710580114": {
            "id": "710580114",
            "speakerId": 1002,
            "speakerName": "Katarina",
            "text": "Alright, time's up for the question-and-answer session.. We've got company!"
          }
        }
      }
    },

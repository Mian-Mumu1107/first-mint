  "subQuests": [
    {
      "subId": "2051501",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150101"
        ],
        "dialogs": {
          "205150101": {
            "id": "205150101",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Oh, where has Anna gone this time...",
            "nextDialogs": [
              "205150102"
            ]
          },
          "205150102": {
            "id": "205150102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can't find Anna again?",
            "nextDialogs": [
              "205150103"
            ]
          },
          "205150103": {
            "id": "205150103",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Yes. I've searched all over the city for her, but no luck.",
            "nextDialogs": [
              "205150104"
            ]
          },
          "205150104": {
            "id": "205150104",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Please help me look for her. I'm so tired, I can barely move...",
            "nextDialogs": [
              "205150106",
              "205150108"
            ]
          },
          "205150106": {
            "id": "205150106",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "It's up to you, then. This girl... If she keeps running around like this when she's almost well, I might fall sick myself.",
            "nextDialogs": [
              "205150111"
            ]
          },
          "205150111": {
            "id": "205150111",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Hang on... Anna did once say that she's wanted to go to the Cathedral and thank the sisters there.",
            "nextDialogs": [
              "205150112"
            ]
          },
          "205150112": {
            "id": "205150112",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Perhaps you should check the Cathedral first. You can also check in with Albert...",
            "nextDialogs": [
              "205150113"
            ]
          },
          "205150113": {
            "id": "205150113",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "He often, uh, hangs around the Cathedral. Who knows, maybe he's noticed something."
          },
          "205150108": {
            "id": "205150108",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "That can't be. It can't be... Can it?",
            "nextDialogs": [
              "205150109"
            ]
          },
          "205150109": {
            "id": "205150109",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "H—Hey, won't you say something?"
          }
        }
      }
    },
    {
      "subId": "2051502",
      "subQuestName": "Find Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150201"
        ],
        "dialogs": {
          "205150201": {
            "id": "205150201",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Wow, the sisters really are alert. They almost discovered me.",
            "nextDialogs": [
              "205150202"
            ]
          },
          "205150202": {
            "id": "205150202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're an agile one...",
            "nextDialogs": [
              "205150203"
            ]
          },
          "205150203": {
            "id": "205150203",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Wah! How did you know I'd be here? Even the sisters didn't spot me.",
            "nextDialogs": [
              "205150204"
            ]
          },
          "205150204": {
            "id": "205150204",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Well, since you've found me, I guess I'll head back now.",
            "nextDialogs": [
              "205150205"
            ]
          },
          "205150205": {
            "id": "205150205",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I just wanted to enjoy the scenery, so don't worry about me."
          }
        }
      }
    },
    {
      "subId": "2051503",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150301"
        ],
        "dialogs": {
          "205150301": {
            "id": "205150301",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Did you find Anna?",
            "nextDialogs": [
              "205150302"
            ]
          },
          "205150302": {
            "id": "205150302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's on the roof of the Cathedral.",
            "nextDialogs": [
              "205150303"
            ]
          },
          "205150303": {
            "id": "205150303",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "The Cathedral roof? All those sisters, and not one of them spotted her?",
            "nextDialogs": [
              "205150304"
            ]
          },
          "205150304": {
            "id": "205150304",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "How did she manage that? Maybe she really does have talent for being an Adventurer...",
            "nextDialogs": [
              "205150305"
            ]
          },
          "205150305": {
            "id": "205150305",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I'll go get her to come down. We really shouldn't be bothering the sisters.",
            "nextDialogs": [
              "205150306"
            ]
          },
          "205150306": {
            "id": "205150306",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Thanks for your help. Please take these as a token of my thanks."
          }
        }
      }
    },
    {
      "subId": "2051504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150401"
        ],
        "dialogs": {
          "205150401": {
            "id": "205150401",
            "speakerId": 1602,
            "speakerName": "Albert",
            "text": "This kid's really nimble...",
            "nextDialogs": [
              "205150402"
            ]
          },
          "205150402": {
            "id": "205150402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, have you seen a girl...",
            "nextDialogs": [
              "205150403"
            ]
          },
          "205150403": {
            "id": "205150403",
            "speakerId": 1602,
            "speakerName": "Albert",
            "text": "You mean Anna? I've seen her, she just ran past me and disappeared down that corner.",
            "nextDialogs": [
              "205150404"
            ]
          },
          "205150404": {
            "id": "205150404",
            "speakerId": 1602,
            "speakerName": "Albert",
            "text": "Still, the Anna I remember has always been ill, and would sometimes come to the Cathedral to be healed.",
            "nextDialogs": [
              "205150405"
            ]
          },
          "205150405": {
            "id": "205150405",
            "speakerId": 1602,
            "speakerName": "Albert",
            "text": "But she doesn't look sick at all. Why, I'd wager that she's got more energy than I do. What happened, I wonder?"
          }
        }
      }
    },
    {
      "subId": "2051505",
      "subQuestName": "Find Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150501"
        ],
        "dialogs": {
          "205150501": {
            "id": "205150501",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Wow, the sisters really are alert. They almost discovered me.",
            "nextDialogs": [
              "205150502"
            ]
          },
          "205150502": {
            "id": "205150502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're an agile one...",
            "nextDialogs": [
              "205150503"
            ]
          },
          "205150503": {
            "id": "205150503",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Wah! How did you know I'd be here? Even the sisters didn't spot me.",
            "nextDialogs": [
              "205150504"
            ]
          },
          "205150504": {
            "id": "205150504",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "You say Albert told you about me? Huh. Who's Albert...",
            "nextDialogs": [
              "205150505"
            ]
          },
          "205150505": {
            "id": "205150505",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Ah, I remember now. He's that man who always hangs around the Cathedral.",
            "nextDialogs": [
              "205150506"
            ]
          },
          "205150506": {
            "id": "205150506",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I don't know what he's there for. But I don't think he's a bad person.",
            "nextDialogs": [
              "205150507"
            ]
          },
          "205150507": {
            "id": "205150507",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Well, since you've found me, I guess I'll head back now.",
            "nextDialogs": [
              "205150508"
            ]
          },
          "205150508": {
            "id": "205150508",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I just wanted to enjoy the scenery, so don't worry about me."
          }
        }
      }
    },
    {
      "subId": "2051506",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150601"
        ],
        "dialogs": {
          "205150601": {
            "id": "205150601",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Have you found Anna?",
            "nextDialogs": [
              "205150602"
            ]
          },
          "205150602": {
            "id": "205150602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's on the roof of the Cathedral.",
            "nextDialogs": [
              "205150603"
            ]
          },
          "205150603": {
            "id": "205150603",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "The Cathedral roof? All those sisters, and not one of them spotted her?",
            "nextDialogs": [
              "205150604"
            ]
          },
          "205150604": {
            "id": "205150604",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "How did she manage that? Maybe she really does have talent for being an Adventurer...",
            "nextDialogs": [
              "205150605"
            ]
          },
          "205150605": {
            "id": "205150605",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "What? It was thanks to a tip from Albert? Haha, Albert...",
            "nextDialogs": [
              "205150606"
            ]
          },
          "205150606": {
            "id": "205150606",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "He's something, he is. No matter how many times the sisters warn him, he can always be found loitering around the Cathedral for no good reason.",
            "nextDialogs": [
              "205150607"
            ]
          },
          "205150607": {
            "id": "205150607",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Well, I'll go get Anna to come down. We shouldn't bother the sisters. Right, and I also need to give Albert my thanks.",
            "nextDialogs": [
              "205150608"
            ]
          },
          "205150608": {
            "id": "205150608",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Thanks for your help. Please take these as a token of my thanks."
          }
        }
      }
    },
    {
      "subId": "2051507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

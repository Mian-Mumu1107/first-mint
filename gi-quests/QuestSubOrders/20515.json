          "205150801"
        ],
        "dialogs": {
          "205150801": {
            "id": "205150801",
            "speakerId": 10003,
            "speakerName": "Anna",
            "text": "If I became a sister, I'd be able to help lots of people, wouldn't I..."
          }
        }
      }
    },
    {
      "subId": "2051509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

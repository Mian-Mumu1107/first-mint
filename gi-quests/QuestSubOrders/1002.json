        ],
        "dialogs": {
          "10020201": {
            "id": "10020201",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "And who might we be? Those that dare enter Jueyun Karst?",
            "nextDialogs": [
              "10020203"
            ]
          },
          "10020203": {
            "id": "10020203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please take a look at this.",
            "nextDialogs": [
              "10020204"
            ]
          },
          "10020204": {
            "id": "10020204",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "A Sigil of Permission... Many a season has passed since one was last in the presence of such an item.",
            "nextDialogs": [
              "10020205"
            ]
          },
          "10020205": {
            "id": "10020205",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "He before you is the mighty and illuminated adeptus, Moon Carver. Speak, traveler. What business have you here?",
            "nextDialogs": [
              "10020206"
            ]
          },
          "10020206": {
            "id": "10020206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually...",
            "nextDialogs": [
              "10020207"
            ]
          },
          "10020207": {
            "id": "10020207",
            "speakerId": 2003004,
            "speakerName": "Millelith Sergeant",
            "text": "It's the assassin! They dared to flee here to Jueyun Karst!",
            "nextDialogs": [
              "10020208"
            ]
          },
          "10020208": {
            "id": "10020208",
            "speakerId": 2003001,
            "speakerName": "Millelith Soldier",
            "text": "Sir, we've already stepped too far into Jueyun Karst ourselves...",
            "nextDialogs": [
              "10020209"
            ]
          },
          "10020209": {
            "id": "10020209",
            "speakerId": 2003004,
            "speakerName": "Millelith Sergeant",
            "text": "We... Argh, there's no choice. Apprehending the assassin is top priority, we must press on!",
            "nextDialogs": [
              "10020210"
            ]
          },
          "10020210": {
            "id": "10020210",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "...disturbing our borders.",
            "nextDialogs": [
              "10020211"
            ]
          },
          "10020211": {
            "id": "10020211",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "See them gone. One will not have interruption."
          }
        }
      }
    },
    {

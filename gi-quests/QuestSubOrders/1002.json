    {
      "subId": "100205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10020501"
        ],
        "dialogs": {
          "10020501": {
            "id": "10020501",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "We've digressed. State your purpose, traveler.",
            "nextDialogs": [
              "10020502"
            ]
          },
          "10020502": {
            "id": "10020502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well...",
            "nextDialogs": [
              "10020503"
            ]
          },
          "10020503": {
            "id": "10020503",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "Preposterous...",
            "nextDialogs": [
              "10020504"
            ]
          },
          "10020504": {
            "id": "10020504",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "PREPOSTEROUS!!!",
            "nextDialogs": [
              "10020505"
            ]
          },
          "10020505": {
            "id": "10020505",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "The Liyue Qixing... utterly disappointing.",
            "nextDialogs": [
              "10020506"
            ]
          },
          "10020506": {
            "id": "10020506",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "How could someone possibly assassinate Rex Lapis during the Rite of Descension...",
            "nextDialogs": [
              "10020507"
            ]
          },
          "10020507": {
            "id": "10020507",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "And then place suspicion upon the attendees!?",
            "nextDialogs": [
              "10020508"
            ]
          },
          "10020508": {
            "id": "10020508",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "...",
            "nextDialogs": [
              "10020509"
            ]
          },
          "10020509": {
            "id": "10020509",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "Traveler, of the unjust accusations placed upon you, one has become aware.",
            "nextDialogs": [
              "10020510"
            ]
          },
          "10020510": {
            "id": "10020510",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "The mind knows its answer. Though one must consult with one's fellows, lest the mind be misguided.",
            "nextDialogs": [
              "10020511"
            ]
          },
          "10020511": {
            "id": "10020511",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "Go. Take your Sigil of Permission, carry with you a message.",
            "nextDialogs": [
              "10020513"
            ]
          },
          "10020513": {
            "id": "10020513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where should I go?",
            "nextDialogs": [
              "10020514"
            ]
          },
          "10020514": {
            "id": "10020514",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "Mountain Shaper and Cloud Retainer can be found here. Only fate will decide if you shall find them — only fate.",
            "nextDialogs": [
              "10020515"
            ]
          },
          "10020515": {
            "id": "10020515",
            "speakerId": 2002801,
            "speakerName": "Moon Carver",
            "text": "There exists a Conqueror of Demons, a Guardian Yaksha. Go to Wangshu Inn. There you shall seek him."
          }
        }
      }
    }
  ]

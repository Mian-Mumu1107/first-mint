        "dialogs": {
          "50042001": {
            "id": "50042001",
            "speakerId": 1000,
            "speakerName": "Vichama",
            "text": "I heard you made it back from the Night Kingdom!",
            "nextDialogs": [
              "50042002"
            ]
          },
          "50042002": {
            "id": "50042002",
            "speakerId": 1000,
            "speakerName": "Vichama",
            "text": "Very impressive. Considering your courage, conviction, and strength... I'd say you're the most outstanding warriors I've ever met. If only I could be more like you...",
            "nextDialogs": [
              "50042003"
            ]
          },
          "50042003": {
            "id": "50042003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We saw Mallko in the Night Kingdom.",
            "nextDialogs": [
              "50042004"
            ]
          },
          "50042004": {
            "id": "50042004",
            "speakerId": 1000,
            "speakerName": "Vichama",
            "text": "What!?",
            "nextDialogs": [
              "50042005"
            ]
          },
          "50042005": {
            "id": "50042005",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You recount what you saw in the Night Kingdom to Vichama.",
            "nextDialogs": [
              "50042006"
            ]
          },
          "50042006": {
            "id": "50042006",
            "speakerId": 1000,
            "speakerName": "Vichama",
            "text": "So that's what happened... Mallko, he chose to...",
            "nextDialogs": [
              "50042007"
            ]
          },
          "50042007": {
            "id": "50042007",
            "speakerId": 1000,
            "speakerName": "Vichama",
            "text": "I'm sorry. It's hard to express what I'm feeling right now. Even though we're separated by death, we still managed to accomplish something together... It's like we had the chance to fight side by side again.",
            "nextDialogs": [
              "50042008"
            ]
          },
          "50042008": {
            "id": "50042008",
            "speakerId": 1000,
            "speakerName": "Vichama",
            "text": "I'll finally be able to get a good night's sleep, now. Mallko, my friend... just keep waiting. We'll be together again one day."
          }
        }
      }
    }
  ]

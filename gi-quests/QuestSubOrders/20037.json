    "Paimon": 5,
    "Player": 9
  },
  "subQuests": [
    {
      "subId": "2003701",
      "subQuestName": "Something seems to be troubling Godwin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370101"
        ],
        "dialogs": {
          "200370101": {
            "id": "200370101",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "...Ugh, I am so ready to just get back to Mondstadt...",
            "nextDialogs": [
              "200370102"
            ]
          },
          "200370102": {
            "id": "200370102",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Oh, Traveler! Hi! Can I ask you a favor?",
            "nextDialogs": [
              "200370103"
            ]
          },
          "200370103": {
            "id": "200370103",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "As you can see, I'm with the Knights, and I'm on patrol right now.",
            "nextDialogs": [
              "200370104"
            ]
          },
          "200370104": {
            "id": "200370104",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "I told my girlfriend I would send her a letter before too long, just to let her know I'm safe and sound.",
            "nextDialogs": [
              "200370105"
            ]
          },
          "200370105": {
            "id": "200370105",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Then things got busy and I forgot all about it... dear me. Could you deliver this <color=#00E1FFFF>letter</color> to her for me? Her name's <color=#00E1FFFF>Glory</color>...",
            "nextDialogs": [
              "200370106"
            ]
          },
          "200370106": {
            "id": "200370106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait— Glory?",
            "nextDialogs": [
              "200370107"
            ]
          },
          "200370107": {
            "id": "200370107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The blind girl... Dandelion Seed collector...",
            "nextDialogs": [
              "200370108"
            ]
          },
          "200370108": {
            "id": "200370108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aha! You must be Godwin? Glory mentioned you!",
            "nextDialogs": [
              "200370109"
            ]
          },
          "200370109": {
            "id": "200370109",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Wha— How do you know Glory?",
            "nextDialogs": [
              "200370110"
            ]
          },
          "200370110": {
            "id": "200370110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She had us run an errand for her.",
            "nextDialogs": [
              "200370111"
            ]
          },
          "200370111": {
            "id": "200370111",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "She made you run an errand, you say? I hope it wasn't anything dangerous...",
            "nextDialogs": [
              "200370112"
            ]
          },
          "200370112": {
            "id": "200370112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She just asked us to get her some Dandelion Seeds, that's all. She said by releasing them into the wind, they would convey her heart's desires to you.",
            "nextDialogs": [
              "200370113"
            ]
          },
          "200370113": {
            "id": "200370113",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Dandelion Seeds, eh? That does sound like my Glory alright.",
            "nextDialogs": [
              "200370114"
            ]
          },
          "200370114": {
            "id": "200370114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hang on, she said you were supposed to be somewhere far away from Mondstadt?",
            "nextDialogs": [
              "200370115"
            ]
          },
          "200370115": {
            "id": "200370115",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Yes— erm, well that was the plan... Let me, uh, fill you in.",
            "nextDialogs": [
              "200370116"
            ]
          },
          "200370116": {
            "id": "200370116",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Did you hear about the time the Grand Master left Mondstadt and took four out of every five knights with him?",
            "nextDialogs": [
              "200370117"
            ]
          },
          "200370117": {
            "id": "200370117",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Right, well, I was one of the ones assigned to that expedition. But unfortunately... just as we were getting ready to set off, I realized I'd lost the keepsake that Glory gave me. By the time I was done looking for it, they'd already left...",
            "nextDialogs": [
              "200370118"
            ]
          },
          "200370118": {
            "id": "200370118",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "I—I still haven't figured out how to catch up with them, and in the meantime I've just been milling around here...",
            "nextDialogs": [
              "200370119"
            ]
          },
          "200370119": {
            "id": "200370119",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "I can't bring myself to go back to Mondstadt. I can only imagine what the knights would think of me if I just came crawling back...",
            "nextDialogs": [
              "200370120"
            ]
          },
          "200370120": {
            "id": "200370120",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Also... I promised Glory I would send her letters and gifts from all around the world. I said I would send her the world!",
            "nextDialogs": [
              "200370121"
            ]
          },
          "200370121": {
            "id": "200370121",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "If she found out I'd never even made it out of Mondstadt...",
            "nextDialogs": [
              "200370122"
            ]
          },
          "200370122": {
            "id": "200370122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You don't want to lose face.",
            "nextDialogs": [
              "200370123"
            ]
          },
          "200370123": {
            "id": "200370123",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Please, deliver this <color=#00E1FFFF>letter</color> to <color=#00E1FFFF>Glory</color> for me won't you? I bet she's worried sick about me.",
            "nextDialogs": [
              "200370125",
              "200370127"
            ]
          },
          "200370125": {
            "id": "200370125",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "I can't thank you enough, Traveler! Please keep everything I just told you a secret though."
          },
          "200370127": {
            "id": "200370127",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "There is so much I want to say to Glory, far more than a handful of Dandelion Seeds could ever hope to carry.",
            "nextDialogs": [
              "200370128"
            ]
          },
          "200370128": {
            "id": "200370128",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Thank you for taking her my letter. And remember, not a word about any of this!"
          }
        }
      }
    },
    {
      "subId": "2003702",
      "subQuestName": "Talk to Godwin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2003703",
      "subQuestName": "Give the letter to Glory",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370301"
        ],
        "dialogs": {
          "200370301": {
            "id": "200370301",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "Hello. I know that voice... Traveler! It's you, isn't it?",
            "nextDialogs": [
              "200370302"
            ]
          },
          "200370302": {
            "id": "200370302",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "What brings you here today?",
            "nextDialogs": [
              "200370303"
            ]
          },
          "200370303": {
            "id": "200370303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Someone told me to bring you this letter.",
            "nextDialogs": [
              "200370304"
            ]
          },
          "200370304": {
            "id": "200370304",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "A letter... for me? Who would do that...",
            "nextDialogs": [
              "200370305"
            ]
          },
          "200370305": {
            "id": "200370305",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "...Godwin.",
            "nextDialogs": [
              "200370306"
            ]
          },
          "200370306": {
            "id": "200370306",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "Have you seen him? I guess that must mean he's okay— Did he say when he'll be back?",
            "nextDialogs": [
              "200370307"
            ]
          },
          "200370307": {
            "id": "200370307",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "Sorry, forget all that. I'm sure he must be far too busy to answer all these questions, I don't want to put any more pressure on him.",
            "nextDialogs": [
              "200370308"
            ]
          },
          "200370308": {
            "id": "200370308",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "But could you read the letter to me?",
            "nextDialogs": [
              "200370309"
            ]
          },
          "200370309": {
            "id": "200370309",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "Quietly... No one needs to hear this but the two of us.",
            "nextDialogs": [
              "200370310"
            ]
          },
          "200370310": {
            "id": "200370310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Okay.",
            "nextDialogs": [
              "200370311"
            ]
          },
          "200370311": {
            "id": "200370311",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "Wow, you read it so nicely... Is this something you do a lot?",
            "nextDialogs": [
              "200370312"
            ]
          },
          "200370312": {
            "id": "200370312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's the end of the letter.",
            "nextDialogs": [
              "200370313"
            ]
          },
          "200370313": {
            "id": "200370313",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "Liyue Harbor... Wow, Godwin really is seeing the world after all!",
            "nextDialogs": [
              "200370314"
            ]
          },
          "200370314": {
            "id": "200370314",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "Thank you, I will treasure this letter. Next time you see <color=#00E1FFFF>Godwin</color>, do tell him I'm thinking of him."
          }
        }
      }
    },
    {
      "subId": "2003706",
      "subQuestName": "Report back to Godwin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370501"
        ],
        "dialogs": {
          "200370501": {
            "id": "200370501",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Did you deliver my letter?",
            "nextDialogs": [
              "200370502"
            ]
          },
          "200370502": {
            "id": "200370502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Glory sends her best wishes.",
            "nextDialogs": [
              "200370503"
            ]
          },
          "200370503": {
            "id": "200370503",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Phew... At least she's not mad at me after that long silence.",
            "nextDialogs": [
              "200370504"
            ]
          },
          "200370504": {
            "id": "200370504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How do you know about Liyue Harbor when you've been milling around Mondstadt this whole time?",
            "nextDialogs": [
              "200370505"
            ]
          },
          "200370505": {
            "id": "200370505",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Ah, yes... All my stories are based on things the Grand Master has told me. He's been everywhere.",
            "nextDialogs": [
              "200370506"
            ]
          },
          "200370506": {
            "id": "200370506",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Anyway, thanks again. You have been a big help.",
            "nextDialogs": [
              "200370507"
            ]
          },
          "200370507": {
            "id": "200370507",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Here, take these Dandelion Seeds. I picked them myself.",
            "nextDialogs": [
              "200370508"
            ]
          },
          "200370508": {
            "id": "200370508",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Next time Glory asks you for more Dandelion Seeds, I'd appreciate it if you could help her out again."
          }
        }
      }
    },
    {
      "subId": "2003702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370201"
        ],
        "dialogs": {
          "200370201": {
            "id": "200370201",
            "speakerId": 1553,
            "speakerName": "Godwin",
            "text": "Thank you for delivering my letter. *sigh* All I want to do is go back and see Glory... If only..."
          }
        }
      }
    },
    {
      "subId": "2003704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200370401"
        ],
        "dialogs": {
          "200370401": {
            "id": "200370401",
            "speakerId": 1521,
            "speakerName": "Glory",
            "text": "What is it? Is there something else you need to tell me?"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "664930401": {
            "id": "664930401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're not scared the boss'll find out?",
            "nextDialogs": [
              "664930402"
            ]
          },
          "664930402": {
            "id": "664930402",
            "speakerId": 1000,
            "speakerName": "Lawaia",
            "text": "He won't find out if you don't snitch. You're fresh, people like you don't mix with his type.",
            "nextDialogs": [
              "664930403"
            ]
          },
          "664930403": {
            "id": "664930403",
            "speakerId": 1000,
            "speakerName": "Lawaia",
            "text": "(Lawaia gives you a playful wink.)"
          }
        }
      }

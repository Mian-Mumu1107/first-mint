    {
      "subId": "7595302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "664920401"
        ],
        "dialogs": {
          "664920401": {
            "id": "664920401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lawaia told me you're selling fish that were caught yesterday.",
            "nextDialogs": [
              "664920402"
            ]
          },
          "664920402": {
            "id": "664920402",
            "speakerId": 1001,
            "speakerName": "Teuciztli",
            "text": "That little rascal... I was wondering why we weren't making as much as we ought to. Turns out Lawaia's been up to no good... I guess I'm going to have to let him go.",
            "nextDialogs": [
              "664920403"
            ]
          },
          "664920403": {
            "id": "664920403",
            "speakerId": 1001,
            "speakerName": "Teuciztli",
            "text": "You truly are an honest soul. If only there were more people like you out there, business wouldn't be such a cutthroat venture. Here, take this. It's a token of my gratitude."
          }
        }
      }
    },
    {
      "subId": "7595303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "664920501"
        ],
        "dialogs": {
          "664920501": {
            "id": "664920501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lawaia told me your fish are the freshest in town.",
            "nextDialogs": [
              "664920502"
            ]
          },
          "664920502": {
            "id": "664920502",
            "speakerId": 1001,
            "speakerName": "Teuciztli",
            "text": "Haha, that kid knows his stuff. Guess I made the right choice hiring him.",
            "nextDialogs": [
              "664920503"
            ]
          },
          "664920503": {
            "id": "664920503",
            "speakerId": 1001,
            "speakerName": "Teuciztli",
            "text": "And judging by how you chose to eat with us, it seems like you know your stuff as well. Here you go, these are for you."
          }
        }
      }
    }
  ]

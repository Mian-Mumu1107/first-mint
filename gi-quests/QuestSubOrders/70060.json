        "dialogs": {
          "700600101": {
            "id": "700600101",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Hey there, Honorary Knight. Who'd have thought our long-awaited reunion would be at this resort? Busy as ever, I assume?",
            "nextDialogs": [
              "700600104"
            ]
          },
          "700600104": {
            "id": "700600104",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Pictures? That's a vacation staple for sure.",
            "nextDialogs": [
              "700600105"
            ]
          },
          "700600105": {
            "id": "700600105",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "It took me ages to get to Natlan... and I still haven't had the chance to take a good look around. Once I finish my drink, I'll look for some picture-worthy spots.",
            "nextDialogs": [
              "700600106"
            ]
          },
          "700600106": {
            "id": "700600106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We can go together.",
            "nextDialogs": [
              "700600107"
            ]
          },
          "700600107": {
            "id": "700600107",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Now that sounds like fun. I must say, this outdoor bar has exquisite taste in furniture. We might as well take a picture while we're here.",
            "nextDialogs": [
              "700600108"
            ]
          },
          "700600108": {
            "id": "700600108",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "It's spacious and comfortable, perfect for enjoying the scenery while sipping on a glass of wine...",
            "nextDialogs": [
              "700600109"
            ]
          },
          "700600109": {
            "id": "700600109",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Come to think of it, the open-air furnishings at the Angel's Share are rather simple. Maybe we should have a word with the winery boss.",
            "nextDialogs": [
              "700600110"
            ]
          },
          "700600110": {
            "id": "700600110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A picture's worth a thousand words...",
            "nextDialogs": [
              "700600111"
            ]
          },
          "700600111": {
            "id": "700600111",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Very true. Let's pick a good angle.",
            "nextDialogs": [
              "700600112"
            ]
          },
          "700600112": {
            "id": "700600112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, I'm a professional.",
            "nextDialogs": [
              "700600113"
            ]
          },
          "700600113": {
            "id": "700600113",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Haha, I trust your judgment. Let's do it.",
            "nextDialogs": [
              "700600114"
            ]
          },
          "700600114": {
            "id": "700600114",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Oh, and since I'm going to be your model, you can pick my pose."
          }
        }
      }
    }
  ]

    {
      "subId": "2074306",
      "subQuestName": "Talk to Elzer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207432001"
        ],
        "dialogs": {
          "207432001": {
            "id": "207432001",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "Have you cleared the merchant roads out?",
            "nextDialogs": [
              "207432002"
            ]
          },
          "207432002": {
            "id": "207432002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They're spick and span.",
            "nextDialogs": [
              "207432003"
            ]
          },
          "207432003": {
            "id": "207432003",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "That's great. Our winery's business can gradually resume now.",
            "nextDialogs": [
              "207432004"
            ]
          },
          "207432004": {
            "id": "207432004",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "Honestly, I should have reported this matter to Master Diluc...",
            "nextDialogs": [
              "207432005"
            ]
          },
          "207432005": {
            "id": "207432005",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "But he's upped and disappeared. I've searched high and low for him all over the winery, but no one knows where he's gone.",
            "nextDialogs": [
              "207432006"
            ]
          },
          "207432006": {
            "id": "207432006",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "Adelinde said something like \"Master Diluc has gone to attend to a personal matter,\" but refused to say anything more. She didn't even look worried.",
            "nextDialogs": [
              "207432007"
            ]
          },
          "207432007": {
            "id": "207432007",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "*sigh* Forget it. Once he's back, I will have a good talk with him..."
          }
        }
      }
    },
    {
      "subId": "2074310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207431001"
        ],
        "dialogs": {
          "207431001": {
            "id": "207431001",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "If our winery's business remains closed for any longer, how will I face Master Diluc...",
            "nextDialogs": [
              "207431002"
            ]
          },
          "207431002": {
            "id": "207431002",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "Traveler, if you meet Master Diluc, could you tell him about this?",
            "nextDialogs": [
              "207431003"
            ]
          },
          "207431003": {
            "id": "207431003",
            "speakerId": 1000,
            "speakerName": "Elzer",
            "text": "It just won't do, the way he just leaves the winery to its own devices all the time."
          }
        }
      }
    }
  ]

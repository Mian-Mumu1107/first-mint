              "771319903"
            ]
          },
          "771319903": {
            "id": "771319903",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Could the fragment be in there...? No, doesn't look like it. All Paimon can see are strange paintings and Prime Ice sculptures!",
            "nextDialogs": [
              "771319904"
            ]
          },
          "771319904": {
            "id": "771319904",
            "speakerId": 1005,
            "speakerName": "Eye of Graeae",
            "text": "That's strange. While I can sense the fragment is more or less around here...",

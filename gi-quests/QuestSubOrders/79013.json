    {
      "subId": "7901324",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132501"
        ],
        "dialogs": {
          "790132501": {
            "id": "790132501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This notebook... Oh, it's \"Wolfgang.\"",
            "nextDialogs": [
              "790132504"
            ]
          },
          "790132504": {
            "id": "790132504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "I guess some people need some punishment before they'll learn anything...",
            "nextDialogs": [
              "790132505"
            ]
          },
          "790132505": {
            "id": "790132505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#These underwater buildings... They should be the mountain ruins that we saw on the island on the other side of the lake. Let's go inside again to make sure, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7901312",
      "subQuestName": "Go to the place on the lake island where the notes were left",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790131201"
        ],
        "dialogs": {
          "790131201": {
            "id": "790131201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This place should be eye-catching enough!",
            "nextDialogs": [
              "790131202"
            ]
          },
          "790131202": {
            "id": "790131202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's hope Wolfgang does see it, and doesn't go running around the secret chambers in these ruins anymore...",
            "nextDialogs": [
              "790131203"
            ]
          },
          "790131203": {
            "id": "790131203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's go back and have a look. Maybe his notes might have changed this time, too!"
          }
        }
      }
    },

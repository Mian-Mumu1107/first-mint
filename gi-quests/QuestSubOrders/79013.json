      }
    },
    {
      "subId": "7901319",
      "subQuestName": "Leave hints and a Sweet Madame",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7901331",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132701"
        ],
        "dialogs": {
          "790132701": {
            "id": "790132701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon really hopes that Wolfgang can give that notion of going to Dragonspine a rest...",
            "nextDialogs": [
              "790132702"
            ]
          },
          "790132702": {
            "id": "790132702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's go to the ruins we were at previously once we get out through the lake. Maybe we'll find some sign of him changing his mind!"
          }
        }
      }
    },
    {
      "subId": "7901321",
      "subQuestName": "Go back outside the lake to check Wolfgang's etchings",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132101"
        ],
        "dialogs": {
          "790132101": {
            "id": "790132101",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Should we really leave the message here? Shouldn't we look for a place closer to the door?"
          }
        }
      }
    },
    {
      "subId": "7901322",
      "subQuestName": "Go to check the etchings that Wolfgang left behind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132901"
        ],
        "dialogs": {
          "790132901": {
            "id": "790132901",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "(These etchings are old. They have been written as such...)",
            "nextDialogs": [
              "790132902"
            ]
          },
          "790132902": {
            "id": "790132902",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"The wind is very strong here, so I'm not going to use a notebook.\"",
            "nextDialogs": [
              "790132910"
            ]
          },
          "790132910": {
            "id": "790132910",
            "speakerId": 1002,
            "speakerName": "Etchings",
            "text": "\"Haha, to think that I'd find a Sweet Madame here — and still warm, too! It's practically a miracle.\"",
            "nextDialogs": [
              "790132903"
            ]
          },
          "790132903": {
            "id": "790132903",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"I don't know who left that Sweet Madame there or how they knew that I wanted to have some. It's all very strange... But I'm very thankful all the same.\"",
            "nextDialogs": [
              "790132904"
            ]
          },
          "790132904": {
            "id": "790132904",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"Thank you, person who left the etchings behind! Your Sweet Madame was the best I've ever tasted.\"",
            "nextDialogs": [
              "790132905"
            ]
          },
          "790132905": {
            "id": "790132905",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"And thank you. I do know that Dragonspine is very dangerous... and I know my limits as well. But I must go.\"",
            "nextDialogs": [
              "790132906"
            ]
          },
          "790132906": {
            "id": "790132906",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"Who knows, a sign that says 'here be traps' might be all that shall be left of my journey to Dragonspine.\"",
            "nextDialogs": [
              "790132907"
            ]
          },
          "790132907": {
            "id": "790132907",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"But if someone else can avoid that danger and get further than I did, that to me would be something even more precious than a Sweet Madame.\"",
            "nextDialogs": [
              "790132908"
            ]
          },
          "790132908": {
            "id": "790132908",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"Thank you, whoever you are who left those etchings. But we adventurers exist precisely because of perils like Dragonspine.\"",
            "nextDialogs": [
              "790132909"
            ]
          },
          "790132909": {
            "id": "790132909",
            "speakerId": 1003,
            "speakerName": "Old Etchings",
            "text": "\"Dearest Regards, Wolfgang.\""
          }
        }
      }
    },
    {
      "subId": "7901326",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7901320",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132001"
        ],
        "dialogs": {
          "790132001": {
            "id": "790132001",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He should have gone into the secret chamber by the time he sees this message. Paimon thinks it won't be of that much use here..."
          }
        }
      }
    },
    {
      "subId": "7901346",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

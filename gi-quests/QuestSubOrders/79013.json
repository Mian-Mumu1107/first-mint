    {
      "subId": "7901302",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790130201"
        ],
        "dialogs": {
          "790130201": {
            "id": "790130201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, Sweet Madame really is delicious.",
            "nextDialogs": [
              "790130202"
            ]
          },
          "790130202": {
            "id": "790130202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon really gets why this Wolfgang guy misses it!",
            "nextDialogs": [
              "790130203"
            ]
          },
          "790130203": {
            "id": "790130203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Poor guy, trapped in here without any chance of having Sweet Madame just one last time...",
            "nextDialogs": [
              "790130206"
            ]
          },
          "790130206": {
            "id": "790130206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Yeah, but... Do you remember how we crossed through something like a lake on an island to reach another island on the other side, {NICKNAME}?",
            "nextDialogs": [
              "790130217"
            ]
          },
          "790130217": {
            "id": "790130217",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The buildings on the island inside the lake do look way more complete than the ones outside it.",
            "nextDialogs": [
              "790130218"
            ]
          },
          "790130218": {
            "id": "790130218",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The buildings on the current island look like ruins in comparison..."
          }
        }
      }
    },

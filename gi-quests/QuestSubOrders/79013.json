    {
      "subId": "7901330",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790133501"
        ],
        "dialogs": {
          "790133501": {
            "id": "790133501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wolfgang hasn't left his notebook here either. Looks like he hasn't arrived yet.",
            "nextDialogs": [
              "790133502"
            ]
          },
          "790133502": {
            "id": "790133502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's leave him some hints on how to open this secret chamber again, shall we?",
            "nextDialogs": [
              "790133505"
            ]
          },
          "790133505": {
            "id": "790133505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh yeah, that's true. If Wolfgang can't make use of the elements...",
            "nextDialogs": [
              "790133506"
            ]
          },
          "790133506": {
            "id": "790133506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then the solution's useless to him. What should we do..."
          }
        }
      }
    },
    {
      "subId": "7901315",

    {
      "subId": "7901323",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790132401"
        ],
        "dialogs": {
          "790132401": {
            "id": "790132401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, it looks like he got out of that secret chamber after all! ... And he... credited his sharp eyes for his escape!? C'mon, we left the clue in such an obvious spot!",
            "nextDialogs": [
              "790132410"
            ]
          },
          "790132410": {
            "id": "790132410",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Also, how many notebooks does this guy carry around!?",
            "nextDialogs": [
              "790132402"
            ]
          },
          "790132402": {
            "id": "790132402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*sigh* He didn't go back after getting out of that chamber. He actually wants to continue adventuring...",
            "nextDialogs": [
              "790132405"
            ]
          },
          "790132405": {
            "id": "790132405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's... That's true. The secret chamber that would trap him forever has now become an obstacle that he easily overcame...",
            "nextDialogs": [
              "790132406"
            ]
          },
          "790132406": {
            "id": "790132406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That said, the mountain ruins that he mentioned can't be seen in the island outside the lake at all.",
            "nextDialogs": [
              "790132407"
            ]
          },
          "790132407": {
            "id": "790132407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's been a really long time since, Paimon...",
            "nextDialogs": [
              "790132408"
            ]
          },
          "790132408": {
            "id": "790132408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Did it collapse and then fall into the sea, then? Paimon's pretty sure that we saw some similar buildings outside in the ocean...",
            "nextDialogs": [
              "790132409"
            ]
          },
          "790132409": {
            "id": "790132409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's explore the nearby sea regions when we've got the time!"
          }
        }
      }
    },
    {
      "subId": "7901311",

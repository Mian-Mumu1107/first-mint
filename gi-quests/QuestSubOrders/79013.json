    {
      "subId": "7901306",
      "subQuestName": "Find a way to open the secret chamber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790130601"
        ],
        "dialogs": {
          "790130601": {
            "id": "790130601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's leave a few words here, he should be able to see 'em!",
            "nextDialogs": [
              "790130602"
            ]
          },
          "790130602": {
            "id": "790130602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's go back to the island outside the lake. Maybe the notes might already be gone!"
          }
        }
      }
    },
    {
      "subId": "7901329",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790131101"
        ],
        "dialogs": {
          "790131101": {
            "id": "790131101",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The door opened! Whew, that was kinda tricky.",
            "nextDialogs": [
              "790131102"
            ]
          },
          "790131102": {
            "id": "790131102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Huh, looks like Wolfgang hasn't written any notes here yet, {NICKNAME}...",
            "nextDialogs": [
              "790131103"
            ]
          },
          "790131103": {
            "id": "790131103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So he hasn't been here...",
            "nextDialogs": [
              "790131104"
            ]
          },
          "790131104": {
            "id": "790131104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We did open the chamber for him back then... This means he won't get stuck now, right?",
            "nextDialogs": [
              "790131107"
            ]
          },
          "790131107": {
            "id": "790131107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, then... Um, why don't we leave him a message?",
            "nextDialogs": [
              "790131108"
            ]
          },
          "790131108": {
            "id": "790131108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's try etching our message into someplace obvious. We'll tell him how to decipher the mechanism!"
          }
        }
      }
    },

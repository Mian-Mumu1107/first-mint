    {
      "subId": "800919",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80091101"
        ],
        "dialogs": {
          "80091101": {
            "id": "80091101",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You and Paimon make a fire, and before you know it, night sets in.",
            "nextDialogs": [
              "80091102"
            ]
          },
          "80091102": {
            "id": "80091102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ahh, your cooking is as good as ever! Even if there was no other reason, the food alone would be enough for Paimon to stick with you, hee-hee!",
            "nextDialogs": [
              "80091105"
            ]
          },
          "80091105": {
            "id": "80091105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Changing the subject, Dain's taking forever! He said that there might be an issue with the nearby Ley Lines... How bad do you think it could be?",
            "nextDialogs": [
              "80091106"
            ]
          },
          "80091106": {
            "id": "80091106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*sigh* We came together, but now it's back to just being the two of us again... Y'know, now that Paimon mentions it, we really have spent lots and lots of time together, haven't we?",
            "nextDialogs": [
              "80091107"
            ]
          },
          "80091107": {
            "id": "80091107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, so... don't take this the wrong way or anything, but, uh... d—do you ever get tired of Paimon being around?"
          }
        }
      }
    },
    {
      "subId": "800908",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80091201"
        ],
        "dialogs": {
          "80091201": {
            "id": "80091201",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Hey, time to wake up. The sun has risen.",
            "nextDialogs": [
              "80091202"
            ]
          },
          "80091202": {
            "id": "80091202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...)",
            "nextDialogs": [
              "80091203"
            ]
          },
          "80091203": {
            "id": "80091203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...Dain?)",
            "nextDialogs": [
              "80091204"
            ]
          },
          "80091204": {
            "id": "80091204",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "What a deep sleeper. You do know that we need to...",
            "nextDialogs": [
              "80091205"
            ]
          },
          "80091205": {
            "id": "80091205",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Hmm? Tear stains... You dreamed of your sibling last night, didn't you?",
            "nextDialogs": [
              "80091206"
            ]
          },
          "80091206": {
            "id": "80091206",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "...Alright. Rest here a bit longer then. I'll head into the forest to investigate.",
            "nextDialogs": [
              "80091207"
            ]
          },
          "80091207": {
            "id": "80091207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Huh? Why're you going back into the forest...)",
            "nextDialogs": [
              "80091208"
            ]
          },
          "80091208": {
            "id": "80091208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*yawn*...",
            "nextDialogs": [
              "80091209"
            ]
          },
          "80091209": {
            "id": "80091209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hmm? How did I sleep till morning? Why didn't Paimon wake me up to switch shifts? ... Hang on a moment... Where IS Paimon, anyway?)",
            "nextDialogs": [
              "80091210"
            ]
          },
          "80091210": {
            "id": "80091210",
            "speakerId": -1,
            "speakerName": "Player",

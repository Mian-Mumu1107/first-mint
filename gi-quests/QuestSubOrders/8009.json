  "subQuests": [
    {
      "subId": "800901",
      "subQuestName": "Talk to Masrur",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090101"
        ],
        "dialogs": {
          "80090101": {
            "id": "80090101",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "Huh? Wait, you're that blond traveler who's on a journey to all corners of Teyvat, right?",
            "nextDialogs": [
              "80090102"
            ]
          },
          "80090102": {
            "id": "80090102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Who's asking...? Do you need something from us?",
            "nextDialogs": [
              "80090103"
            ]
          },
          "80090103": {
            "id": "80090103",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "You bet I do! Phew, I was worried I wouldn't be able to find you! I have a letter for you, you see — it's from another outlander...",
            "nextDialogs": [
              "80090104"
            ]
          },
          "80090104": {
            "id": "80090104",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "He was a crafty fellow, lemme tell you... Took advantage of a loophole in our mailing system by opting for Guaranteed Delivery then filling in the most obscure mailing address I've ever seen!",
            "nextDialogs": [
              "80090105"
            ]
          },
          "80090105": {
            "id": "80090105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, we are always on the road, so yeah, it's pretty tough to get mail to us unless we happen to go to the post office on a whim...",
            "nextDialogs": [
              "80090106"
            ]
          },
          "80090106": {
            "id": "80090106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, um... what address did that person give you, anyway?",
            "nextDialogs": [
              "80090107"
            ]
          },
          "80090107": {
            "id": "80090107",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "Uh... he just wrote, \"next to a small, white-haired talking fairy.\"",
            "nextDialogs": [
              "80090108"
            ]
          },
          "80090108": {
            "id": "80090108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What!? So the address is Paimon!?",
            "nextDialogs": [
              "80090109"
            ]
          },
          "80090109": {
            "id": "80090109",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "*sigh* Exactly, right? And if I'd failed to deliver the letter, I'd have been bound by regulation to compensate him...",
            "nextDialogs": [
              "80090110"
            ]
          },
          "80090110": {
            "id": "80090110",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "Really, he got me good. I count myself very lucky that I ran into you here.",
            "nextDialogs": [
              "80090113"
            ]
          },
          "80090113": {
            "id": "80090113",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "Of course, here it is. All yours!",
            "nextDialogs": [
              "80090114"
            ]
          },
          "80090114": {
            "id": "80090114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "C'mon, Paimon wants to have a look, too!",
            "nextDialogs": [
              "80090115"
            ]
          },
          "80090115": {
            "id": "80090115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Kaeya, huh? So he's here in Sumeru... Hmm, now that Paimon thinks about it, \"crafty\" does describe him pretty well."
          }
        }
      }
    },
    {
      "subId": "800902",
      "subQuestName": "Wait until the following afternoon (16:00 – 18:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090201"
        ],
        "dialogs": {
          "80090201": {
            "id": "80090201",
            "speakerId": 1000,
            "speakerName": "Masrur",
            "text": "This was a first for me. It's a good thing luck was on my side..."
          }
        }
      }
    },
    {
      "subId": "800903",
      "subQuestName": "Go to Djafar Tavern and look for Kaeya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090301"
        ],
        "dialogs": {
          "80090301": {
            "id": "80090301",
            "speakerId": 1002,
            "speakerName": "Kaeya",
            "text": "...I'll have something I haven't tried yet, Boss.",
            "nextDialogs": [
              "80090302"
            ]
          },
          "80090302": {
            "id": "80090302",
            "speakerId": 1003,
            "speakerName": "Eymen",
            "text": "Um... Sorry, Sir, I'm afraid you've already tried every type of liquor we serve...",
            "nextDialogs": [
              "80090303"
            ]
          },
          "80090303": {
            "id": "80090303",
            "speakerId": 1002,
            "speakerName": "Kaeya",
            "text": "Oh? Well then, just the bill, please. It's just as well, I suppose. I do have other matters to attend to...",
            "nextDialogs": [
              "80090304"
            ]
          },
          "80090304": {
            "id": "80090304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Kaeya! You're really here! Paimon half thought you were playing some sort of prank on us...",
            "nextDialogs": [
              "80090305"
            ]
          },
          "80090305": {
            "id": "80090305",
            "speakerId": 1002,
            "speakerName": "Kaeya",
            "text": "#Hey, Paimon, {NICKNAME}. Looks like the gods smile upon me after all. And come now, I wouldn't joke about wanting to see my good friends, haha...",
            "nextDialogs": [
              "80090308"
            ]
          },
          "80090308": {
            "id": "80090308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait a second, you must be here on official business, right? What do you think you're doing, spending every afternoon drinking at the tavern? You itching for a lecture from Jean?",
            "nextDialogs": [
              "80090309"
            ]
          },
          "80090309": {
            "id": "80090309",
            "speakerId": 1002,
            "speakerName": "Kaeya",
            "text": "Hahaha, not at all. The Acting Grand Master positively terrifies me. Why would I ever do anything that might displease her?"
          }
        }
      }
    },
    {
      "subId": "800904",
      "subQuestName": "Go to the place Dainsleif mentioned",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090501"
        ],
        "dialogs": {
          "80090501": {
            "id": "80090501",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Wait... This place, it's... familiar.",
            "nextDialogs": [
              "80090502"
            ]
          },
          "80090502": {
            "id": "80090502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What about it? It looks pretty normal to Paimon... Was it like this hundreds of years ago, too?",
            "nextDialogs": [
              "80090503"
            ]
          },
          "80090503": {
            "id": "80090503",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Yes. The forest has barely changed from how I remember it. There is very little human activity here, after all.",
            "nextDialogs": [
              "80090504"
            ]
          },
          "80090504": {
            "id": "80090504",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Let's search the area and see what we can find.",
            "nextDialogs": [
              "80090505"
            ]
          },
          "80090505": {
            "id": "80090505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is this a field? It must belong to whoever owns that house over there...",
            "nextDialogs": [
              "80090506"
            ]
          },
          "80090506": {
            "id": "80090506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But it looks like it's been abandoned for a long time. You could be forgiven for thinking nothing was ever grown here... Or wait, maybe nothing ever WAS grown here.",
            "nextDialogs": [
              "80090507"
            ]
          },
          "80090507": {
            "id": "80090507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's an extinguished bonfire. Forest Rangers, perhaps?",
            "nextDialogs": [
              "80090508"
            ]
          },
          "80090508": {
            "id": "80090508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like it's been ages since it was last lit. And clearly they put it out carefully to prevent a forest fire, too. That's responsible.",
            "nextDialogs": [
              "80090509"
            ]
          },
          "80090509": {
            "id": "80090509",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Nothing else stands out in this area. All that's left is that building. Come on.",
            "nextDialogs": [
              "80090510"
            ]
          },
          "80090510": {
            "id": "80090510",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, we're just gonna go barging in? What if someone's home?",
            "nextDialogs": [
              "80090511"
            ]
          },
          "80090511": {
            "id": "80090511",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Unlikely. There are no signs of life in this area. We should be able to enter without incident.",
            "nextDialogs": [
              "80090512"
            ]
          },
          "80090512": {
            "id": "80090512",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If you say so... Well, uh... you lead the way then, Dain. Hehe..."
          }
        }
      }
    },
    {
      "subId": "800907",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090701"
        ],
        "dialogs": {
          "80090701": {
            "id": "80090701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This bed looks pretty ordinary. Huh, there's nothing underneath it, either.",
            "nextDialogs": [
              "80090702"
            ]
          },
          "80090702": {
            "id": "80090702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What sort of person would wanna live here? It's so dark and damp... Can't be all that comfortable..."
          }
        }
      }
    },
    {
      "subId": "800910",
      "subQuestName": "Enter the house to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80091001"
        ],
        "dialogs": {
          "80091001": {
            "id": "80091001",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "I doubt that the appearance of those monsters was wholly random. There must be something nearby that attracted them.",
            "nextDialogs": [
              "80091002"
            ]
          },
          "80091002": {
            "id": "80091002",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "A Ley Line anomaly, perhaps? ...Hmm, but it seems to be more than that.",
            "nextDialogs": [
              "80091003"
            ]
          },
          "80091003": {
            "id": "80091003",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Okay — I'll go slightly further out to investigate any issues with the nearby Ley Lines. I might be a while. You should wait for me here.",
            "nextDialogs": [
              "80091004"
            ]
          },
          "80091004": {
            "id": "80091004",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? You're going alone? You'd better not be trying to keep some secret from us!",
            "nextDialogs": [
              "80091005"
            ]
          },
          "80091005": {
            "id": "80091005",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "...Your suspicions are as banal as they are unwarranted. I merely think that this house should remain the focus of our investigation, and as such, someone ought to stay here and keep an eye on it.",
            "nextDialogs": [
              "80091006"
            ]
          },
          "80091006": {
            "id": "80091006",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Not to mention that if even Forest Rangers are capable of investigating Ley Lines, I will be more than able to handle it alone.",
            "nextDialogs": [
              "80091007"
            ]
          },
          "80091007": {
            "id": "80091007",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, fair enough. Guess we'll just camp out here, then?",
            "nextDialogs": [
              "80091008"
            ]
          },
          "80091008": {
            "id": "80091008",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Good thing there's a bonfire over there. Let's make ourselves something to eat! All this running around has made Paimon real hungry."
          }
        }
      }
    },
    {
      "subId": "800911",
      "subQuestName": "Investigate the interior of the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090601"
        ],
        "dialogs": {
          "80090601": {
            "id": "80090601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey look, it's a bowl. Guess whoever used to live here liked to cook, huh?",
            "nextDialogs": [
              "80090602"
            ]
          },
          "80090602": {
            "id": "80090602",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "Can't you smell it? There's a heavy scent of medicinal herbs in here.",
            "nextDialogs": [
              "80090603"
            ]
          },
          "80090603": {
            "id": "80090603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ohh, so it's a medicine bowl? ...*sniff* Hmm, seems you're right! You've got a good nose on you, Dain!"
          }
        }
      }
    },
    {
      "subId": "800912",
      "subQuestName": "Investigate the interior of the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800913",
      "subQuestName": "Investigate the interior of the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090801"
        ],
        "dialogs": {
          "80090801": {
            "id": "80090801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's a box over here. Why don't we open it? Uh, and by \"we,\" Paimon means you... Paimon's just scared that... whatever's inside might bite her fingertips off...",
            "nextDialogs": [
              "80090804"
            ]
          },
          "80090804": {
            "id": "80090804",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? This is... a mirror.",
            "nextDialogs": [
              "80090805"
            ]
          },
          "80090805": {
            "id": "80090805",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's broken, too. Was this a makeup box?"
          }
        }
      }
    },
    {
      "subId": "800916",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090901"
        ],
        "dialogs": {
          "80090901": {
            "id": "80090901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Doesn't look like there's anything else worth our attention here. You sure we're in the right place, Dain?",
            "nextDialogs": [
              "80090902"
            ]
          },
          "80090902": {
            "id": "80090902",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "My memories are quite foggy, but my subconscious and instincts both assert that something once happened here.",
            "nextDialogs": [
              "80090903"
            ]
          },
          "80090903": {
            "id": "80090903",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "But, we'll exhaust ourselves if we search aimlessly... I hear noises outside. Let's go and check.",
            "nextDialogs": [
              "80090904"
            ]
          },
          "80090904": {
            "id": "80090904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Noises? Is it...",
            "nextDialogs": [
              "80090905"
            ]
          },
          "80090905": {
            "id": "80090905",
            "speakerId": 1004,
            "speakerName": "Dainsleif",
            "text": "It's not much. Just some minor adversaries."
          }
        }
      }
    },
    {
      "subId": "800921",

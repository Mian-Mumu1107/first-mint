    {
      "subId": "2303101",
      "subQuestName": "Talk to Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310201"
        ],
        "dialogs": {
          "230310201": {
            "id": "230310201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What kind of materials do you need?",
            "nextDialogs": [
              "230310202"
            ]
          },
          "230310202": {
            "id": "230310202",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "I'm feeling... Zaytun Peach today.",
            "nextDialogs": [
              "230310203"
            ]
          },
          "230310203": {
            "id": "230310203",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "It's common, but few consider it an ingredient with which to make bait.",
            "nextDialogs": [
              "230310204"
            ]
          },
          "230310204": {
            "id": "230310204",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Please find that for me, would you?"
          }
        }
      }
    },

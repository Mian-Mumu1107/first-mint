    {
      "subId": "2303101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310101"
        ],
        "dialogs": {
          "230310101": {
            "id": "230310101",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "You look like... You're a Traveler, right? Hanging out in such a place, are we? Nice choice.",
            "nextDialogs": [
              "230310102"
            ]
          },
          "230310102": {
            "id": "230310102",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Could it be that you are another fisher with your eyes on this area?",
            "nextDialogs": [
              "230310103"
            ]
          },
          "230310103": {
            "id": "230310103",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "You've got a good eye! It's the best fishing site around these parts.",
            "nextDialogs": [
              "230310104"
            ]
          },
          "230310104": {
            "id": "230310104",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But no one's fishing here, right? How can you be so certain?",
            "nextDialogs": [
              "230310105"
            ]
          },
          "230310105": {
            "id": "230310105",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Well, because I can see things they can't.",
            "nextDialogs": [
              "230310106"
            ]
          },
          "230310106": {
            "id": "230310106",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "I'm the best angler here, and I have my own standards for fishing sites.",
            "nextDialogs": [
              "230310107"
            ]
          },
          "230310107": {
            "id": "230310107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "R—Really?",
            "nextDialogs": [
              "230310108"
            ]
          },
          "230310108": {
            "id": "230310108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But where's the fish you caught?",
            "nextDialogs": [
              "230310109"
            ]
          },
          "230310109": {
            "id": "230310109",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Say no more. I'll show you what it means to be the \"Supreme Hookshot.\"",
            "nextDialogs": [
              "230310112"
            ]
          },
          "230310112": {
            "id": "230310112",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Bring me some special materials, and I will catch \"fish\" you've never seen before using my handmade bait.",
            "nextDialogs": [
              "230310113"
            ]
          },
          "230310113": {
            "id": "230310113",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That feels... kinda suspicious. Will this handmade bait really work?",
            "nextDialogs": [
              "230310114"
            ]
          },
          "230310114": {
            "id": "230310114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wouldn't hurt to try.",
            "nextDialogs": [
              "230310115"
            ]
          },
          "230310115": {
            "id": "230310115",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "That's the spirit! I like you!",
            "nextDialogs": [
              "230310116"
            ]
          },
          "230310116": {
            "id": "230310116",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "My handmade bait is based on Sunsettia and Wheat and is then further elevated by another material."
          }
        }
      }
    },

    {
      "subId": "2303103",
      "subQuestName": "Talk to Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310601"
        ],
        "dialogs": {
          "230310601": {
            "id": "230310601",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Great, we have all the materials. Now witness the creation of a unique bait.",
            "nextDialogs": [
              "230310602"
            ]
          },
          "230310602": {
            "id": "230310602",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Kayvan skillfully prepares the bait.",
            "nextDialogs": [
              "230310603"
            ]
          },
          "230310603": {
            "id": "230310603",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Alright, here goes. Hooks away!",
            "nextDialogs": [
              "230310604"
            ]
          },
          "230310604": {
            "id": "230310604",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Hook depth good... Flow speed moderate...",
            "nextDialogs": [
              "230310605"
            ]
          },
          "230310605": {
            "id": "230310605",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "You gotta be quiet. The fish are really sensitive.",
            "nextDialogs": [
              "230310606"
            ]
          },
          "230310606": {
            "id": "230310606",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Even the footsteps on the bank could startle them.",
            "nextDialogs": [
              "230310609"
            ]
          },
          "230310609": {
            "id": "230310609",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Then be patient and wait...",
            "nextDialogs": [
              "230310610"
            ]
          },
          "230310610": {
            "id": "230310610",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Kayvan catches a wet package.",
            "nextDialogs": [
              "230310611"
            ]
          },
          "230310611": {
            "id": "230310611",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What is this? That's no fish!",
            "nextDialogs": [
              "230310612"
            ]
          },
          "230310612": {
            "id": "230310612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I sure have never seen a \"fish\" like that.",
            "nextDialogs": [
              "230310613"
            ]
          },
          "230310613": {
            "id": "230310613",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "So that happened again. Just as expected.",
            "nextDialogs": [
              "230310614"
            ]
          },
          "230310614": {
            "id": "230310614",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Don't worry, outlander, stay calm. Don't gripe too much about the details.",
            "nextDialogs": [
              "230310615"
            ]
          },
          "230310615": {
            "id": "230310615",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Everything that comes with a hook could be considered a \"fish.\"",
            "nextDialogs": [
              "230310616"
            ]
          },
          "230310616": {
            "id": "230310616",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Let me tell you, I didn't just invent the title of \"the greatest angler\" out of thin air.",
            "nextDialogs": [
              "230310617"
            ]
          },
          "230310617": {
            "id": "230310617",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "After all, always catching lifeless things that could never bite the bait is something quite special, wouldn't you say?",
            "nextDialogs": [
              "230310618"
            ]
          },
          "230310618": {
            "id": "230310618",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Other anglers have praised my unique talents."
          }
        }
      }
    },
    {
      "subId": "2303104",
      "subQuestName": "Look for the materials that Kayvan needs",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310401"
        ],
        "dialogs": {
          "230310401": {
            "id": "230310401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What kind of materials do you need?",
            "nextDialogs": [
              "230310402"
            ]
          },
          "230310402": {
            "id": "230310402",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "I'm feeling... How about a mushroom today?",
            "nextDialogs": [
              "230310403"
            ]
          },
          "230310403": {
            "id": "230310403",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "The mushrooms I usually use are found in a special area, I'll show you where they can be found.",
            "nextDialogs": [
              "230310404"
            ]
          },
          "230310404": {
            "id": "230310404",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "Please find this sort of mushroom for me."
          }
        }
      }
    },
    {
      "subId": "2303105",
      "subQuestName": "Give the bait materials to Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230310501"
        ],
        "dialogs": {
          "230310501": {
            "id": "230310501",
            "speakerId": 1000,
            "speakerName": "Kayvan",
            "text": "The bait this time requires Sunsettia, Wheat, and Zaytun Peach. Did you get them all?"
          }
        }
      }
    },

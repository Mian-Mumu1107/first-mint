  "subQuests": [
    {
      "subId": "7050601",
      "subQuestName": "Talk to Luka and enter the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705060101"
        ],
        "dialogs": {
          "705060101": {
            "id": "705060101",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Hi there, cutie. It's good to see you.",
            "nextDialogs": [
              "705060102"
            ]
          },
          "705060102": {
            "id": "705060102",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "It is certainly unusual for us to meet in a place like this, but as Lisa said, I'm glad to see you.",
            "nextDialogs": [
              "705060103"
            ]
          },
          "705060103": {
            "id": "705060103",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Hey, what do you mean by \"a place like this\"? The tavern is a wonderful place to relax and unwind a little.",
            "nextDialogs": [
              "705060104"
            ]
          },
          "705060104": {
            "id": "705060104",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "*sigh* Do you have any idea how hard it was for me to drag the Acting Grand Master away from her desk?",
            "nextDialogs": [
              "705060105"
            ]
          },
          "705060105": {
            "id": "705060105",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "We've only been here for a few minutes and worry is already written all over her face.",
            "nextDialogs": [
              "705060106"
            ]
          },
          "705060106": {
            "id": "705060106",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "*sigh* Lisa...",
            "nextDialogs": [
              "705060107"
            ]
          },
          "705060107": {
            "id": "705060107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, the Knights of Favonius do have a lot to handle...",
            "nextDialogs": [
              "705060108"
            ]
          },
          "705060108": {
            "id": "705060108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, this is the Acting Grand Master we're talking about. It's only natural that she has a lot on her plate!",
            "nextDialogs": [
              "705060109"
            ]
          },
          "705060109": {
            "id": "705060109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But you know what they say... \"Now that we're already here...\"",
            "nextDialogs": [
              "705060110"
            ]
          },
          "705060110": {
            "id": "705060110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Why don't you let {F#her}{M#him} mix a couple of drinks for you two. It'll make you feel a lot better!",
            "nextDialogs": [
              "705060111"
            ]
          },
          "705060111": {
            "id": "705060111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Think of it as a way to unwind.",
            "nextDialogs": [
              "705060112"
            ]
          },
          "705060112": {
            "id": "705060112",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Honestly, Jean is the only person I know who needs to be taught how to relax.",
            "nextDialogs": [
              "705060113"
            ]
          },
          "705060113": {
            "id": "705060113",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Hey cutie, whip me up a Love Poem. Medium, extra sweet.",
            "nextDialogs": [
              "705060114"
            ]
          },
          "705060114": {
            "id": "705060114",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "And how about you, Jean? What are you in the mood for?",
            "nextDialogs": [
              "705060115"
            ]
          },
          "705060115": {
            "id": "705060115",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "I'll just have... coffee. Medium, please.",
            "nextDialogs": [
              "705060116"
            ]
          },
          "705060116": {
            "id": "705060116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Master Jean, you drink coffee all the time. Wouldn't you like to try something else?",
            "nextDialogs": [
              "705060117"
            ]
          },
          "705060117": {
            "id": "705060117",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "Thanks, but no. I want something to help keep me awake.",
            "nextDialogs": [
              "705060118"
            ]
          },
          "705060118": {
            "id": "705060118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it. Coming right up!",
            "nextDialogs": [
              "705060119"
            ]
          },
          "705060119": {
            "id": "705060119",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "Thanks."
          }
        }
      }
    },

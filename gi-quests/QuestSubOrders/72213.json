    {
      "subId": "7221305",
      "subQuestName": "Give Ooshima Junpei three Iron Ores",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130501"
        ],
        "dialogs": {
          "722130501": {
            "id": "722130501",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Wonderful! These will do, I think.",
            "nextDialogs": [
              "722130502"
            ]
          },
          "722130502": {
            "id": "722130502",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I'll go find a suitable place outside to set a furnace up, and then I'll start making my tools.",
            "nextDialogs": [
              "722130503"
            ]
          },
          "722130503": {
            "id": "722130503",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Just let the Lady Priestess know, would you? I'll be packing up over here."
          }
        }
      }
    },
    {
      "subId": "7221304",
      "subQuestName": "Report back to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130601"
        ],
        "dialogs": {
          "722130601": {
            "id": "722130601",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow meow meow. Is something the matter? Not to worry, I will prepare an adequate \"celery.\"",
            "nextDialogs": [
              "722130605",
              "722130604"
            ]
          },
          "722130605": {
            "id": "722130605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, never mind. Basically, the stone human... Mr. Ooshima's tools are broken, but we gave him the materials he needs to repair 'em, so there shouldn't be any problem!",
            "nextDialogs": [
              "722130606"
            ]
          },
          "722130606": {
            "id": "722130606",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Mm? Problems, you say?"
          },
          "722130604": {
            "id": "722130604",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Mm? What does \"how much\" mean?"
          }
        }
      }
    },
    {
      "subId": "7221302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130201"
        ],
        "dialogs": {
          "722130201": {
            "id": "722130201",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "A \"celery\" is important to humans. I will remember that."
          }
        }
      }
    },
    {
      "subId": "7221304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130401"
        ],
        "dialogs": {
          "722130401": {
            "id": "722130401",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Hey there, have you secured the 3 Iron Chunks?"
          }
        }
      }
    }
  ]
}
          "190030706": {
            "id": "190030706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I will be accompanying her.",
            "nextDialogs": [
              "190030707"
            ]
          },
          "190030707": {
            "id": "190030707",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Ah, I trust she will be in good hands then. Please take good care of Sister Barbara, Honorary Knight.",

    {
      "subId": "1900303",
      "subQuestName": "Report back to Sister Victoria",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190030301"
        ],
        "dialogs": {
          "190030301": {
            "id": "190030301",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Oh, you're back again. If you're looking for Sister Barbara... she's yet to return.",
            "nextDialogs": [
              "190030304"
            ]
          },
          "190030304": {
            "id": "190030304",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Oh, I see... Thank Barbatos that she's alright.",
            "nextDialogs": [
              "190030305"
            ]
          },
          "190030305": {
            "id": "190030305",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "But it sounds like she won't be back any time soon... Hmm, perhaps I'll have to pass her responsibilities in the Cathedral to someone else...",
            "nextDialogs": [
              "190030306"
            ]
          },
          "190030306": {
            "id": "190030306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We can help.",
            "nextDialogs": [
              "190030307"
            ]
          },
          "190030307": {
            "id": "190030307",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Oh, well that's most kind of you. I certainly wouldn't want to trouble you...",
            "nextDialogs": [
              "190030308"
            ]
          },
          "190030308": {
            "id": "190030308",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Hmm... Let me think for a moment... Ah yes, you could help tidy up around the Cathedral a bit.",
            "nextDialogs": [
              "190030309"
            ]
          },
          "190030309": {
            "id": "190030309",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "People tend to bring dust in as they come into the Cathedral, so the floor is often quite dirty.",
            "nextDialogs": [
              "190030310"
            ]
          },
          "190030310": {
            "id": "190030310",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Cleaning and the like have always been Sister Barbara's responsibility... So the moment she's gone, everything starts getting dirty...",
            "nextDialogs": [
              "190030311"
            ]
          },
          "190030311": {
            "id": "190030311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Barbara is responsible for cleaning a place this huge by herself?",
            "nextDialogs": [
              "190030312"
            ]
          },
          "190030312": {
            "id": "190030312",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Yes, that's right. She always said that she could handle it herself and that there's no need to ask anyone else to help her.",
            "nextDialogs": [
              "190030313"
            ]
          },
          "190030313": {
            "id": "190030313",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "But she does often appear quite exhausted after she's finished with the cleaning.",
            "nextDialogs": [
              "190030314"
            ]
          },
          "190030314": {
            "id": "190030314",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "To be honest, I'm most surprised that you are willing to help... Or rather, that Barbara is willing to let you help.",
            "nextDialogs": [
              "190030315"
            ]
          },
          "190030315": {
            "id": "190030315",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "However, this would help to lighten her burden.",
            "nextDialogs": [
              "190030316"
            ]
          },
          "190030316": {
            "id": "190030316",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Anyway, I'll let you handle the cleaning for now, Honorary Knight."
          }
        }
      }
    },
    {
      "subId": "1900304",
      "subQuestName": "Clean the Cathedral grounds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190030401"
        ],
        "dialogs": {
          "190030401": {
            "id": "190030401",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Your kindness will not go unnoticed, Honorary Knight. Barbatos bless you."
          }
        }
      }
    },

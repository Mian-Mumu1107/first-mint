  "subQuests": [
    {
      "subId": "2005801",
      "subQuestName": "Talk to Nora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580101"
        ],
        "dialogs": {
          "200580101": {
            "id": "200580101",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Hmm, what to do...",
            "nextDialogs": [
              "200580102"
            ]
          },
          "200580102": {
            "id": "200580102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "200580103"
            ]
          },
          "200580103": {
            "id": "200580103",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "See the Anemo Archon statue? Now, look up there, the really high bit... where the archon's hands are.",
            "nextDialogs": [
              "200580104"
            ]
          },
          "200580104": {
            "id": "200580104",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "I wanna go play up there... But Grace won't let me climb the statue.",
            "nextDialogs": [
              "200580105"
            ]
          },
          "200580105": {
            "id": "200580105",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Please can you go and talk to Grace for a bit? Don't let her look this way. I climb really quickly, I'll be up there in no time...",
            "nextDialogs": [
              "200580107",
              "200580109"
            ]
          },
          "200580107": {
            "id": "200580107",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Yay, thanks!",
            "nextDialogs": [
              "200580110"
            ]
          },
          "200580110": {
            "id": "200580110",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Go and distract Aunty Grace for a minute, I'll go up right now...",
            "nextDialogs": [
              "200580111"
            ]
          },
          "200580111": {
            "id": "200580111",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "Nora! No!",
            "nextDialogs": [
              "200580112"
            ]
          },
          "200580112": {
            "id": "200580112",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "Phew, I look away for one second and she starts bothering you. I do apologize.",
            "nextDialogs": [
              "200580113"
            ]
          },
          "200580113": {
            "id": "200580113",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Whyyy! I just wanna play up there for a little bit...",
            "nextDialogs": [
              "200580114"
            ]
          },
          "200580114": {
            "id": "200580114",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "No means no! Your father would not approve either.",
            "nextDialogs": [
              "200580115"
            ]
          },
          "200580115": {
            "id": "200580115",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "And you — please refrain from indulging her! People would be just as worried about you if you did something so dangerous."
          },
          "200580109": {
            "id": "200580109",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "It'll be fine, I'm really good at climbing!"
          }
        }
      }
    },
    {
      "subId": "2005813",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580501"
        ],
        "dialogs": {
          "200580501": {
            "id": "200580501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's enough for today.",
            "nextDialogs": [
              "200580502"
            ]
          },
          "200580502": {
            "id": "200580502",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Okay... Time to have a rest."
          }
        }
      }
    },
    {
      "subId": "2005802",
      "subQuestName": "Talk to Nora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580201"
        ],
        "dialogs": {
          "200580201": {
            "id": "200580201",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Wah...",
            "nextDialogs": [
              "200580202"
            ]
          },
          "200580202": {
            "id": "200580202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you want to do up there?",
            "nextDialogs": [
              "200580203"
            ]
          },
          "200580203": {
            "id": "200580203",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Aunty Grace says that if you want to tell someone a secret, you just need to tell it to a dandelion then throw it to the wind... The Anemo Archon will carry the dandelion seeds and the secret you told it to the person you want.",
            "nextDialogs": [
              "200580204"
            ]
          },
          "200580204": {
            "id": "200580204",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "And the higher you throw it into the wind from, the faster your message will get there...",
            "nextDialogs": [
              "200580205"
            ]
          },
          "200580205": {
            "id": "200580205",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "This one time, Glory got an adventurer to climb up the statue and throw some dandelion seeds into the wind for her. Just a few days later, Godwin wrote her a letter back!",
            "nextDialogs": [
              "200580206"
            ]
          },
          "200580206": {
            "id": "200580206",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "I have a secret to tell Daddy, and I already got a dandelion.",
            "nextDialogs": [
              "200580207"
            ]
          },
          "200580207": {
            "id": "200580207",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "But Aunty Grace won't let me do it. She says that I can go back and live with Daddy when I've grown up.",
            "nextDialogs": [
              "200580208"
            ]
          },
          "200580208": {
            "id": "200580208",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "I wish there was a way to grow up faster... I'm trying as hard as I can, but I'm still so short...",
            "nextDialogs": [
              "200580209"
            ]
          },
          "200580209": {
            "id": "200580209",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Oh yeah— I always see you gliding around in the city. Can you teach me? How do you do it?",
            "nextDialogs": [
              "200580211",
              "200580213"
            ]
          },
          "200580211": {
            "id": "200580211",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Hee-hee, yay! I'll just stand by and watch, I'm sure I'm allowed to do that."
          },
          "200580213": {
            "id": "200580213",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "No way! Aunty Grace would go mad if she saw me doing that."
          }
        }
      }
    },
    {
      "subId": "2005808",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580801"
        ],
        "dialogs": {
          "200580801": {
            "id": "200580801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm gonna take a breather...",
            "nextDialogs": [
              "200580802"
            ]
          },
          "200580802": {
            "id": "200580802",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Don't be too long."
          }
        }
      }
    },
    {
      "subId": "2005809",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580901"
        ],
        "dialogs": {
          "200580901": {
            "id": "200580901",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "Oh, Nora...",
            "nextDialogs": [
              "200580903",
              "200580908"
            ]
          },
          "200580903": {
            "id": "200580903",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "Yes, for a number of reasons her mother is... away from home. In the meantime, I'm taking care of her.",
            "nextDialogs": [
              "200580904"
            ]
          },
          "200580904": {
            "id": "200580904",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "I also care for several other children who need someone to look after them. It's part of my duty as a sister.",
            "nextDialogs": [
              "200580905"
            ]
          },
          "200580905": {
            "id": "200580905",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "It's like I suddenly got a whole new family of children. They're good kids, and they get on well with Glory, too.",
            "nextDialogs": [
              "200580906"
            ]
          },
          "200580906": {
            "id": "200580906",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "Timmie's the one I've looked after longest. He's even started calling me Mommy..."
          },
          "200580908": {
            "id": "200580908",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "Patton is her father. His incessant drinking caused huge problems in the home.",
            "nextDialogs": [
              "200580909"
            ]
          },
          "200580909": {
            "id": "200580909",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "The Church and the Knights of Favonius both gave him a number of warnings, but he would not change his ways. In the end, it was Master Diluc who took action.",
            "nextDialogs": [
              "200580910"
            ]
          },
          "200580910": {
            "id": "200580910",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "Believing that Patton was in no shape to look after Nora, Sister Victoria put her under the care of the Church while Patton takes some time out to reflect.",
            "nextDialogs": [
              "200580911"
            ]
          },
          "200580911": {
            "id": "200580911",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "But when Nora grows up, the excuse we keep giving her that \"Daddy is busy with work and needs to be left alone...\" It's going to wear thin.",
            "nextDialogs": [
              "200580912"
            ]
          },
          "200580912": {
            "id": "200580912",
            "speakerId": 1001,
            "speakerName": "Grace",
            "text": "And even the Anemo Archon's dandelions are limited in their reach."
          }
        }
      }
    },
    {
      "subId": "2005803",
      "subQuestName": "Arrive at the destination",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580301"
        ],
        "dialogs": {
          "200580301": {
            "id": "200580301",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "You flew there in {ChallengeCurrValue10} minute(s), that's amazing!",
            "nextDialogs": [
              "200580302"
            ]
          },
          "200580302": {
            "id": "200580302",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Do you wanna go again? I bet you could go even faster...",
            "nextDialogs": [
              "200580303"
            ]
          },
          "200580303": {
            "id": "200580303",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "And I'll give you a prezzie if you do!"
          }
        }
      }
    },
    {
      "subId": "2005804",

    {
      "subId": "2005805",
      "subQuestName": "Talk to Nora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580601"
        ],
        "dialogs": {
          "200580601": {
            "id": "200580601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll do it again.",
            "nextDialogs": [
              "200580602"
            ]
          },
          "200580602": {
            "id": "200580602",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Yay! I'll be watching you the whole way."
          }
        }
      }
    },
    {
      "subId": "2005811",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200581101"
        ],
        "dialogs": {
          "200581101": {
            "id": "200581101",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Wooow! When I'm bigger, will I be able to glide like that?",
            "nextDialogs": [
              "200581103",
              "200581105"
            ]
          },
          "200581103": {
            "id": "200581103",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Woohoo! I'm gonna grow up as fast as possible, then, when Daddy's finished his work, he can play with me!",
            "nextDialogs": [
              "200581106"
            ]
          },
          "200581106": {
            "id": "200581106",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "But maybe it's easier for grown-ups.",
            "nextDialogs": [
              "200581107"
            ]
          },
          "200581107": {
            "id": "200581107",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Thank you. Here, this is a present for you. It's some treasure that I collected in secret.",
            "nextDialogs": [
              "200581108"
            ]
          },
          "200581108": {
            "id": "200581108",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Quick, take it... Also, don't tell Aunty Grace!"
          },
          "200581105": {
            "id": "200581105",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Gliding license? What's that? It sounds complicated..."
          }
        }
      }
    },
    {
      "subId": "2005804",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200580401"
        ],
        "dialogs": {
          "200580401": {
            "id": "200580401",
            "speakerId": 1000,
            "speakerName": "Nora",
            "text": "Hmm, I thought it looked cooler last time... Did you glide the same way?"
          }
        }
      }
    }
  ]
}
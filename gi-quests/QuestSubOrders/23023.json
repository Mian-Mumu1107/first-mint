{
  "lineCounts": {
    "Gurgen": 10,
    "Player": 7,
    "Vardan": 33
  },
  "subQuests": [
    {
      "subId": "2302301",
      "subQuestName": "Talk to Vardan and Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230230101"
        ],
        "dialogs": {
          "230230101": {
            "id": "230230101",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "We can't go on like this, Father. The roses are not growing well.",
            "nextDialogs": [
              "230230102"
            ]
          },
          "230230102": {
            "id": "230230102",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "We must work out something quick, or we won't be able to deliver all the herbs on time this year!",
            "nextDialogs": [
              "230230103"
            ]
          },
          "230230103": {
            "id": "230230103",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "The soil is good. We've disposed of the weeds and pests. So what's going on here?",
            "nextDialogs": [
              "230230104"
            ]
          },
          "230230104": {
            "id": "230230104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's bothering you?",
            "nextDialogs": [
              "230230105"
            ]
          },
          "230230105": {
            "id": "230230105",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Oh? Are you here to buy herbs?",
            "nextDialogs": [
              "230230106"
            ]
          },
          "230230106": {
            "id": "230230106",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Well, we send batches of herbs to Bimarstan at regular intervals.",
            "nextDialogs": [
              "230230107"
            ]
          },
          "230230107": {
            "id": "230230107",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "The most important herb of all is the special \"Sumeru Rose.\"",
            "nextDialogs": [
              "230230108"
            ]
          },
          "230230108": {
            "id": "230230108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Roses can be used as medicine?",
            "nextDialogs": [
              "230230109"
            ]
          },
          "230230109": {
            "id": "230230109",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "That's a question you need to direct toward the doctors at Bimarstan.",
            "nextDialogs": [
              "230230110"
            ]
          },
          "230230110": {
            "id": "230230110",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "They say the rose can be used in tandem with other medicines to cure heatstroke and soothe stomachaches, and that it even has some other benefits... none of which I recall at the moment.",
            "nextDialogs": [
              "230230112",
              "230230114"
            ]
          },
          "230230112": {
            "id": "230230112",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "We would be most grateful!"
          },
          "230230114": {
            "id": "230230114",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "For some reason, it is growing incredibly slowly.",
            "nextDialogs": [
              "230230115"
            ]
          },
          "230230115": {
            "id": "230230115",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Our experience tells us that this is usually either a soil or a pest problem.",
            "nextDialogs": [
              "230230116"
            ]
          },
          "230230116": {
            "id": "230230116",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "But we have planted other herbs here using the same soil, and those have grown up just fine.",
            "nextDialogs": [
              "230230117"
            ]
          },
          "230230117": {
            "id": "230230117",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "We also perform pest control every day. So it can't be the pests...",
            "nextDialogs": [
              "230230118"
            ]
          },
          "230230118": {
            "id": "230230118",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "This is no time to get obsessed with the possibilities. Any more stalling, and we won't be able to deliver the roses to Bimarstan on time.",
            "nextDialogs": [
              "230230119"
            ]
          },
          "230230119": {
            "id": "230230119",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Our current plan is to fertilize the soil with a special fertilizer.",
            "nextDialogs": [
              "230230120"
            ]
          },
          "230230120": {
            "id": "230230120",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "But we need to take care of other fields at the same time. As such, we haven't any time left to collect materials for the fertilizer.",
            "nextDialogs": [
              "230230121"
            ]
          },
          "230230121": {
            "id": "230230121",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Traveler, for the sake of the patients at Bimarstan, would you please do us this favor?",
            "nextDialogs": [
              "230230122"
            ]
          },
          "230230122": {
            "id": "230230122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I will.",
            "nextDialogs": [
              "230230123"
            ]
          },
          "230230123": {
            "id": "230230123",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "We would be most grateful!",
            "nextDialogs": [
              "230230124"
            ]
          },
          "230230124": {
            "id": "230230124",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Let's see. Our current situation is..."
          }
        }
      }
    },
    {
      "subId": "2302302",
      "subQuestName": "Hand 3 Harra Fruits to Vardan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230230201"
        ],
        "dialogs": {
          "230230201": {
            "id": "230230201",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "We'll need a lot of special fertilizer.",
            "nextDialogs": [
              "230230202"
            ]
          },
          "230230202": {
            "id": "230230202",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "We have some reserves of other ingredients for this type of special fertilizer, but we have run out of Harra Fruit.",
            "nextDialogs": [
              "230230203"
            ]
          },
          "230230203": {
            "id": "230230203",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Traveler, could we trouble you to get us some Harra Fruits?"
          }
        }
      }
    },
    {
      "subId": "2302304",
      "subQuestName": "Talk to Vardan and Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230230401"
        ],
        "dialogs": {
          "230230401": {
            "id": "230230401",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Soil fertility aside, perhaps \"water\" might also be a problem...",
            "nextDialogs": [
              "230230402"
            ]
          },
          "230230402": {
            "id": "230230402",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Maybe we buried the rose so deep that it couldn't get enough water?",
            "nextDialogs": [
              "230230403"
            ]
          },
          "230230403": {
            "id": "230230403",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Traveler, could you help us water the rose, please?"
          }
        }
      }
    },
    {
      "subId": "2302303",
      "subQuestName": "Talk to Vardan and Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230230301"
        ],
        "dialogs": {
          "230230301": {
            "id": "230230301",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "These will do the trick. Thank you so much, Traveler!",
            "nextDialogs": [
              "230230302"
            ]
          },
          "230230302": {
            "id": "230230302",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "With this special fertilizer, the fertility of the soil shouldn't be a problem, and the rose will surely grow well.",
            "nextDialogs": [
              "230230303"
            ]
          },
          "230230303": {
            "id": "230230303",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "Let's hope they'll actually take effect this time, unlike the ones we've used before.",
            "nextDialogs": [
              "230230304"
            ]
          },
          "230230304": {
            "id": "230230304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You've tried using fertilizers before already?",
            "nextDialogs": [
              "230230305"
            ]
          },
          "230230305": {
            "id": "230230305",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "We did use some ordinary ones. They didn't work well... Well, they didn't work at all.",
            "nextDialogs": [
              "230230306"
            ]
          },
          "230230306": {
            "id": "230230306",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "But they did amazingly in the other fields. Honestly, I wonder what's going on here...",
            "nextDialogs": [
              "230230307"
            ]
          },
          "230230307": {
            "id": "230230307",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Well, we shan't keep you any further. Take these as our thanks, please."
          }
        }
      }
    },
    {
      "subId": "2302305",
      "subQuestName": "Water the roses",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2302306",
      "subQuestName": "Talk to Vardan and Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230230601"
        ],
        "dialogs": {
          "230230601": {
            "id": "230230601",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Whew... The soil should have enough moisture for now.",
            "nextDialogs": [
              "230230602"
            ]
          },
          "230230602": {
            "id": "230230602",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "Many thanks, Traveler. We could have been all tuckered out by now if it wasn't for you.",
            "nextDialogs": [
              "230230603"
            ]
          },
          "230230603": {
            "id": "230230603",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Strange... It took so much water to permeate the soil thoroughly this time.",
            "nextDialogs": [
              "230230604"
            ]
          },
          "230230604": {
            "id": "230230604",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "I felt like we used at least twice as much water as usual.",
            "nextDialogs": [
              "230230605"
            ]
          },
          "230230605": {
            "id": "230230605",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "That can't be. Maybe you're just too tired.",
            "nextDialogs": [
              "230230606"
            ]
          },
          "230230606": {
            "id": "230230606",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "If we really had doubled the amount of water, the soil would be soaked. But see, the moisture levels seem normal.",
            "nextDialogs": [
              "230230607"
            ]
          },
          "230230607": {
            "id": "230230607",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "I guess so...",
            "nextDialogs": [
              "230230608"
            ]
          },
          "230230608": {
            "id": "230230608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, I hope the roses will grow well.",
            "nextDialogs": [
              "230230609"
            ]
          },
          "230230609": {
            "id": "230230609",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "No worries. We will take good care of the roses for the sake of the patients and doctors at Bimarstan.",
            "nextDialogs": [
              "230230610"
            ]
          },
          "230230610": {
            "id": "230230610",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Traveler, take these as our thanks, please.",
            "nextDialogs": [
              "230230611"
            ]
          },
          "230230611": {
            "id": "230230611",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Still, I really feel like we used a lot more water than usual this time..."
          }
        }
      }
    },
    {
      "subId": "2302307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230230701"
        ],
        "dialogs": {
          "230230701": {
            "id": "230230701",
            "speakerId": 1001,
            "speakerName": "Vardan",
            "text": "Traveler, please help us water the nearby roses.",
            "nextDialogs": [
              "230230702"
            ]
          },
          "230230702": {
            "id": "230230702",
            "speakerId": 1000,
            "speakerName": "Gurgen",
            "text": "With enough water, the roses will definitely start growing again!"
          }
        }
      }
    }
  ]
}
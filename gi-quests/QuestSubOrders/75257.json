    {
      "subId": "7525701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752570201"
        ],
        "dialogs": {
          "752570201": {
            "id": "752570201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That sounds like fun.",
            "nextDialogs": [
              "752570202"
            ]
          },
          "752570202": {
            "id": "752570202",
            "speakerId": 1000,
            "speakerName": "Yiztli",
            "text": "Fantastic! Alright then, who wants to go first?",
            "nextDialogs": [
              "752570203"
            ]
          },
          "752570203": {
            "id": "752570203",
            "speakerId": 1001,
            "speakerName": "Inti",
            "text": "I have a suggestion — ladies first.",
            "nextDialogs": [
              "752570204"
            ]
          },
          "752570204": {
            "id": "752570204",
            "speakerId": 1002,
            "speakerName": "Wechtekah",
            "text": "That's fine by me.",
            "nextDialogs": [
              "752570205"
            ]
          },
          "752570205": {
            "id": "752570205",
            "speakerId": 1003,
            "speakerName": "Xoma",
            "text": "My my, such gentlemen! To tell the truth, I'd like to take a photo with such fine young people as yourselves.",
            "nextDialogs": [
              "752570206"
            ]
          },
          "752570206": {
            "id": "752570206",
            "speakerId": 1001,
            "speakerName": "Inti",
            "text": "Huh? A—Alright, I suppose...",
            "nextDialogs": [
              "752570207"
            ]
          },
          "752570207": {
            "id": "752570207",
            "speakerId": 1002,
            "speakerName": "Wechtekah",
            "text": "Ahem, that's fine by me.",
            "nextDialogs": [
              "752570208"
            ]
          },
          "752570208": {
            "id": "752570208",
            "speakerId": 1003,
            "speakerName": "Xoma",
            "text": "Hmm... Wait, that's not enough. I'd like to add three more young men to the picture. You can manage that, can't you?",
            "nextDialogs": [
              "752570209"
            ]
          },
          "752570209": {
            "id": "752570209",
            "speakerId": 1003,
            "speakerName": "Xoma",
            "text": "Oh, and maybe some fireworks? I used to love that kind of thing when I was your age.",
            "nextDialogs": [
              "752570210"
            ]
          },
          "752570210": {
            "id": "752570210",
            "speakerId": 1000,
            "speakerName": "Yiztli",
            "text": "You got it. Let's get started!"
          }
        }
      }
    },
    {
      "subId": "7525703",

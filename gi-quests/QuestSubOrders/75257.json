            "text": "Let's do it!"
          }
        }
      }
    },
    {
      "subId": "7525704",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752570401"
        ],
        "dialogs": {
          "752570401": {
            "id": "752570401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Never mind. I've got other things to attend to.",
            "nextDialogs": [
              "752570402"
            ]
          },
          "752570402": {
            "id": "752570402",
            "speakerId": 1000,
            "speakerName": "Yiztli",
            "text": "*sigh* That's a shame."
          }
        }
      }
    },
    {
      "subId": "7525705",

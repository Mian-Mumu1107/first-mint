  "subQuests": [
    {
      "subId": "2051601",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160101"
        ],
        "dialogs": {
          "205160101": {
            "id": "205160101",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Oh, that girl, where has she run off to this time...",
            "nextDialogs": [
              "205160102"
            ]
          },
          "205160102": {
            "id": "205160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Anna's gone out to play again?",
            "nextDialogs": [
              "205160103"
            ]
          },
          "205160103": {
            "id": "205160103",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Really, how can you be so unperturbed?",
            "nextDialogs": [
              "205160104"
            ]
          },
          "205160104": {
            "id": "205160104",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Anna's become less and less obedient. I turn around for one second, and she just slips away.",
            "nextDialogs": [
              "205160105"
            ]
          },
          "205160105": {
            "id": "205160105",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "She hasn't fully recovered yet! Please help me find her.",
            "nextDialogs": [
              "205160107",
              "205160109",
              "205160112"
            ]
          },
          "205160107": {
            "id": "205160107",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Thank you.",
            "nextDialogs": [
              "205160115"
            ]
          },
          "205160115": {
            "id": "205160115",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Ah, right. Anna always told me that she wanted to see the statue of the Anemo Archon.",
            "nextDialogs": [
              "205160116"
            ]
          },
          "205160116": {
            "id": "205160116",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I remember that Sister Grace goes there often.",
            "nextDialogs": [
              "205160117"
            ]
          },
          "205160117": {
            "id": "205160117",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "You could go ask her first. Maybe she's noticed something..."
          },
          "205160109": {
            "id": "205160109",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Of course. I even searched outside the city!",
            "nextDialogs": [
              "205160110"
            ]
          },
          "205160110": {
            "id": "205160110",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "But still, no luck. So I could only turn to you."
          },
          "205160112": {
            "id": "205160112",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Well, she's fond of... Hey! Haven't I told you to stop treating her like a cat?",
            "nextDialogs": [
              "205160113"
            ]
          },
          "205160113": {
            "id": "205160113",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "In any case, she loves all sorts of food, more than I can count.",
            "nextDialogs": [
              "205160114"
            ]
          },
          "205160114": {
            "id": "205160114",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Okay, I'm counting on you to look for her. I'll be waiting for you here. I'm so tired, I feel like I could collapse..."
          }
        }
      }
    },
    {
      "subId": "2051602",
      "subQuestName": "Find Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160201"
        ],
        "dialogs": {
          "205160201": {
            "id": "205160201",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "So you really can see all of Mondstadt from up here...",
            "nextDialogs": [
              "205160202"
            ]
          },
          "205160202": {
            "id": "205160202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't catch a cold, now.",
            "nextDialogs": [
              "205160203"
            ]
          },
          "205160203": {
            "id": "205160203",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Wah! You gave me a fright, where'd you come from?",
            "nextDialogs": [
              "205160204"
            ]
          },
          "205160204": {
            "id": "205160204",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "I bet my brother's looking for me again. Haha, I knew he wouldn't find me here.",
            "nextDialogs": [
              "205160205"
            ]
          },
          "205160205": {
            "id": "205160205",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "I know, I know. I get it, I'll go back in a while. I won't make him worry."
          }
        }
      }
    },
    {
      "subId": "2051603",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160301"
        ],
        "dialogs": {
          "205160301": {
            "id": "205160301",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Have you found Anna already?",
            "nextDialogs": [
              "205160302"
            ]
          },
          "205160302": {
            "id": "205160302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's on the Anemo Archon statue's hand.",
            "nextDialogs": [
              "205160303"
            ]
          },
          "205160303": {
            "id": "205160303",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "The—The Anemo Archon statue's hand? How did she even get up there?",
            "nextDialogs": [
              "205160304"
            ]
          },
          "205160304": {
            "id": "205160304",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I'll head there immediately, get her to come down, and scold her a bit.",
            "nextDialogs": [
              "205160305"
            ]
          },
          "205160305": {
            "id": "205160305",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "My thanks. Please, take these."
          }
        }
      }
    },
    {
      "subId": "2051604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160401"
        ],
        "dialogs": {
          "205160401": {
            "id": "205160401",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "Hasn't this child always been ill? So how...",
            "nextDialogs": [
              "205160402"
            ]
          },
          "205160402": {
            "id": "205160402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen a certain girl...",
            "nextDialogs": [
              "205160403"
            ]
          },
          "205160403": {
            "id": "205160403",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "Ha... You must be referring to Anna. Look up — she's in the hands of the Anemo Archon statue.",
            "nextDialogs": [
              "205160404"
            ]
          },
          "205160404": {
            "id": "205160404",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "Honestly, I was quite stunned when she ran past me. I mean, she's been ill all this time, so where did she get this much energy from?",
            "nextDialogs": [
              "205160405"
            ]
          },
          "205160405": {
            "id": "205160405",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "By the time I recovered, she'd already gone all the way up to the Anemo Archon statue's hands.",
            "nextDialogs": [
              "205160406"
            ]
          },
          "205160406": {
            "id": "205160406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're... not angry?",
            "nextDialogs": [
              "205160407"
            ]
          },
          "205160407": {
            "id": "205160407",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "Angry? Well, I was a little angry. But that child has always been tormented by her sickness...",
            "nextDialogs": [
              "205160408"
            ]
          },
          "205160408": {
            "id": "205160408",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "Seeing her healthy like this... How do I say this? I just can't get angry.",
            "nextDialogs": [
              "205160409"
            ]
          },
          "205160409": {
            "id": "205160409",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "That said, the wind is very strong up there. I hope she doesn't catch a cold..."
          }
        }
      }
    },
    {
      "subId": "2051605",
      "subQuestName": "Find Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160501"
        ],
        "dialogs": {
          "205160501": {
            "id": "205160501",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "So you really can see all of Mondstadt from up here...",
            "nextDialogs": [
              "205160502"
            ]
          },
          "205160502": {
            "id": "205160502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't catch a cold, now.",
            "nextDialogs": [
              "205160503"
            ]
          },
          "205160503": {
            "id": "205160503",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Wah! You gave me a scare. Where did you pop out from, and how did you find me?",
            "nextDialogs": [
              "205160504"
            ]
          },
          "205160504": {
            "id": "205160504",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "I was so sure no one would find me here...",
            "nextDialogs": [
              "205160505"
            ]
          },
          "205160505": {
            "id": "205160505",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Ah, right. Sister Grace must have told you where I am. She's always around here.",
            "nextDialogs": [
              "205160506"
            ]
          },
          "205160506": {
            "id": "205160506",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "A lot of the medicine I've taken in the past were sent over by her.",
            "nextDialogs": [
              "205160507"
            ]
          },
          "205160507": {
            "id": "205160507",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Sister Grace is a wonderful person... But I don't want to stay in Mondstadt forever.",
            "nextDialogs": [
              "205160508"
            ]
          },
          "205160508": {
            "id": "205160508",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Alright, I know my brother's looking for me. I'll head back soon, so he doesn't worry."
          }
        }
      }
    },
    {
      "subId": "2051606",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160601"
        ],
        "dialogs": {
          "205160601": {
            "id": "205160601",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Have you managed to find Anna?",
            "nextDialogs": [
              "205160602"
            ]
          },
          "205160602": {
            "id": "205160602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's on the Anemo Archon statue's hand.",
            "nextDialogs": [
              "205160603"
            ]
          },
          "205160603": {
            "id": "205160603",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "The—The Anemo Archon statue's hand? How did she even get up there?",
            "nextDialogs": [
              "205160604"
            ]
          },
          "205160604": {
            "id": "205160604",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Ah, we've made trouble for Sister Grace again. I mean, we always do, but...",
            "nextDialogs": [
              "205160605"
            ]
          },
          "205160605": {
            "id": "205160605",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I'll head there immediately, get her to come down, and scold her a bit.",
            "nextDialogs": [
              "205160606"
            ]
          },
          "205160606": {
            "id": "205160606",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "My thanks. Please, take these."
          }
        }
      }
    },
    {
      "subId": "2051607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160701"
        ],
        "dialogs": {
          "205160701": {
            "id": "205160701",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Where's Anna gone this time? How did I not see before that she could be this much of a handful?"
          }
        }
      }
    },
    {
      "subId": "2051608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205160801"
        ],
        "dialogs": {
          "205160801": {
            "id": "205160801",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "If I had a wind glider, I'd try flying from up here, just to see how it feels."
          }
        }
      }
    },
    {
      "subId": "2051609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

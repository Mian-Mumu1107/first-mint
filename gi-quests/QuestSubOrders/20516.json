        ],
        "dialogs": {
          "205160901": {
            "id": "205160901",
            "speakerId": 1002,
            "speakerName": "Grace",
            "text": "The wind is very strong up here. I hope that child doesn't catch a cold..."
          }
        }
      }
    }
  ]
}
            "id": "755089901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, what a surprise! A letter from Mualani!",
            "nextDialogs": [
              "755089902"
            ]
          },
          "755089902": {
            "id": "755089902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It says... the People of the Springs are hosting a... music festival?",
            "nextDialogs": [
              "755089903"
            ]
          },
          "755089903": {
            "id": "755089903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that sounds fun! Let's go check it out!"
          }
        }

        ],
        "dialogs": {
          "755080101": {
            "id": "755080101",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Hey!",
            "nextDialogs": [
              "755080102"
            ]
          },
          "755080102": {
            "id": "755080102",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Our guests of honor are here! Now we can really get this party started!",
            "nextDialogs": [
              "755080103"
            ]
          },
          "755080103": {
            "id": "755080103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Mualani! Oh, and Xilonen's here too!",
            "nextDialogs": [
              "755080104"
            ]
          },
          "755080104": {
            "id": "755080104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And... Mizuki? You're back from Inazuma already!",
            "nextDialogs": [
              "755080105"
            ]
          },
          "755080105": {
            "id": "755080105",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "That's right! My friends in Natlan are like family to me. I like to think of the People of the Springs as my home away from home.",
            "nextDialogs": [
              "755080106"
            ]
          },
          "755080106": {
            "id": "755080106",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "If I want to help people here, I definitely can't neglect the Natlan branch of my practice.",
            "nextDialogs": [
              "755080107"
            ]
          },
          "755080107": {
            "id": "755080107",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Miss Mizuki's work ethic is impeccable.",
            "nextDialogs": [
              "755080108"
            ]
          },
          "755080108": {
            "id": "755080108",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "She puts the rest of us service-providers to shame...",
            "nextDialogs": [
              "755080111"
            ]
          },
          "755080111": {
            "id": "755080111",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Well, I've had some weird dreams lately... Like, a client expediting a commission from a four-week time-frame to just one.",
            "nextDialogs": [
              "755080112"
            ]
          },
          "755080112": {
            "id": "755080112",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Or, like a rush order for some kind of spherical accessory with an element of danger to it..."
          }
        }
      }
    },
    {
      "subId": "7550899",
      "subQuestName": "Additional",

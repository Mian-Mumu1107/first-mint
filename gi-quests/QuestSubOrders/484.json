    {
      "subId": "48431",
      "subQuestName": "Investigate the strange sound up ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4843101"
        ],
        "dialogs": {
          "4843101": {
            "id": "4843101",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "Thank goodness, the Knights of Favonius have arrived! The hilichurls won't dare pursue me any longer...",
            "nextDialogs": [
              "4843102"
            ]
          },
          "4843102": {
            "id": "4843102",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "What happened?",
            "nextDialogs": [
              "4843103"
            ]
          },
          "4843103": {
            "id": "4843103",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "I can't believe it but... the hilichurls attacked our carts. Luckily I outran them.",
            "nextDialogs": [
              "4843104"
            ]
          },
          "4843104": {
            "id": "4843104",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hilichurls? But I thought the Knights of Favonius had cleared out most of the hilichurl camps around these parts?",
            "nextDialogs": [
              "4843105"
            ]
          },
          "4843105": {
            "id": "4843105",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "It's a small camp not too far from the village. The route I take on my delivery runs ensures I steer clear of it.",
            "nextDialogs": [
              "4843106"
            ]
          },
          "4843106": {
            "id": "4843106",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "But today... some crazy fellow suddenly fell out of the sky and landed right in the camp!",
            "nextDialogs": [
              "4843107"
            ]
          },
          "4843107": {
            "id": "4843107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Now who does that remind me of...",
            "nextDialogs": [
              "4843108"
            ]
          },
          "4843108": {
            "id": "4843108",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "It really riled them up. They chased the funny-looking fellow as he fled, which brought them out into the open.",
            "nextDialogs": [
              "4843109"
            ]
          },
          "4843109": {
            "id": "4843109",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "I managed to get away, but they smashed my fruit carts to smithereens. I don't know what I'm gonna do when the merchant caravan gets here tomorrow—",
            "nextDialogs": [
              "4843110"
            ]
          },
          "4843110": {
            "id": "4843110",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "...Funny-looking? In what way?",
            "nextDialogs": [
              "4843111"
            ]
          },
          "4843111": {
            "id": "4843111",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "He was holding onto something. Must've been heavy, because he couldn't glide in a straight line to save his life... Maybe that's why he fell.",
            "nextDialogs": [
              "4843112"
            ]
          },
          "4843112": {
            "id": "4843112",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "Honestly, people like that shouldn't be allowed in the skies. It doesn't take a genius to know you're not supposed to carry heavy objects while gliding! I'm gonna report that idiot and make sure he gets his license revoked!",
            "nextDialogs": [
              "4843113"
            ]
          },
          "4843113": {
            "id": "4843113",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Heavy object... The artifact? This could well be our guy.",
            "nextDialogs": [
              "4843114"
            ]
          },
          "4843114": {
            "id": "4843114",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Tell me, did you see which way he went?",
            "nextDialogs": [
              "4843115"
            ]
          },
          "4843115": {
            "id": "4843115",
            "speakerId": 1256,
            "speakerName": "Farrah",
            "text": "I managed to catch a glimpse as I ran from the hilichurls. I think he went... that way.",
            "nextDialogs": [
              "4843116"
            ]
          },
          "4843116": {
            "id": "4843116",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "#Seems like a strong lead. {NICKNAME}, on with the chase!",
            "nextDialogs": [
              "4843117"
            ]
          },
          "4843117": {
            "id": "4843117",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Oh, and don't worry — as soon as I get back I'll tell the Knights to mop up the rest of the hilichurls as soon as possible."
          }
        }
      }
    },

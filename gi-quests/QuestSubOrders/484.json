    {
      "subId": "48404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4840401"
        ],
        "dialogs": {
          "4840401": {
            "id": "4840401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... How do we know if this was left by Raptor or an Anemo Slime?",
            "nextDialogs": [
              "4840402"
            ]
          },
          "4840402": {
            "id": "4840402",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Anemo Slimes are airborne creatures. They don't leave marks on the ground, unless someone stomped on one to take-off.",
            "nextDialogs": [
              "4840403"
            ]
          },
          "4840403": {
            "id": "4840403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait... Are you telling me people actually do that?",
            "nextDialogs": [
              "4840404"
            ]
          },
          "4840404": {
            "id": "4840404",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Either way, let's make a mental note of these markings. They're very clear."
          }
        }
      }
    },
    {
      "subId": "48405",
      "subQuestName": "Look for clues to track Raptor",
      "sceneId": null,

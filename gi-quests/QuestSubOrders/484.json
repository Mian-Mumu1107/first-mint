      }
    },
    {
      "subId": "48411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4841101"
        ],
        "dialogs": {
          "4841101": {
            "id": "4841101",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "It appears that the elemental markings point this way.",
            "nextDialogs": [
              "4841102"
            ]
          },
          "4841102": {
            "id": "4841102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Well... D'you think he ran off ahead?",
            "nextDialogs": [
              "4841103"
            ]
          },
          "4841103": {
            "id": "4841103",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "There's only one way to find out!",
            "nextDialogs": [
              "4841104"
            ]
          },
          "4841104": {
            "id": "4841104",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "#C'mon {NICKNAME}, we should keep following the markings.",
            "nextDialogs": [
              "4841105"
            ]
          },
          "4841105": {
            "id": "4841105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, what's that? Looks like something's going on up ahead...",
            "nextDialogs": [
              "4841106"
            ]
          },
          "4841106": {
            "id": "4841106",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "It sounds like there's a battle going on — could that be Raptor?",
            "nextDialogs": [
              "4841107"
            ]
          },
          "4841107": {
            "id": "4841107",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Quick, let's keep going!"
          }
        }
      }
    },
    {
      "subId": "48431",

    {
      "subId": "48406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4840601"
        ],
        "dialogs": {
          "4840601": {
            "id": "4840601",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hmm... a strip of cloth with Anemo markings on.",
            "nextDialogs": [
              "4840602"
            ]
          },
          "4840602": {
            "id": "4840602",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Looking at the design and the way it's woven, there's a good chance it came from a wind glider.",
            "nextDialogs": [
              "4840603"
            ]
          },
          "4840603": {
            "id": "4840603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, Outriders have to be textile experts now!? It's a harder job than Paimon thought.",
            "nextDialogs": [
              "4840604"
            ]
          },
          "4840604": {
            "id": "4840604",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "If this really belongs to Raptor, it must mean his wind glider is broken."
          }
        }
      }
    },

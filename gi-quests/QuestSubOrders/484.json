    {
      "subId": "48402",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4840201"
        ],
        "dialogs": {
          "4840201": {
            "id": "4840201",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "This is Springvale. There must be some clues about Raptor 'round here.",
            "nextDialogs": [
              "4840202"
            ]
          },
          "4840202": {
            "id": "4840202",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "The Sister from the Cathedral put some secret Anemo markings on the artifact he took.",
            "nextDialogs": [
              "4840203"
            ]
          },
          "4840203": {
            "id": "4840203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Use your <color=#00E1FFFF>Elemental Sight</color> and keep your eyes peeled for clues."
          }
        }
      }
    },
    {
      "subId": "48403",
      "subQuestName": "Look for clues to track Raptor",
      "sceneId": null,
      "locations": [],
      "dialogue": {

    {
      "subId": "48422",
      "subQuestName": "Look for the marks left by Raptor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4842201"
        ],
        "dialogs": {
          "4842201": {
            "id": "4842201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, look where we are...",
            "nextDialogs": [
              "4842202"
            ]
          },
          "4842202": {
            "id": "4842202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There are no more elemental markings ahead.",
            "nextDialogs": [
              "4842203"
            ]
          },
          "4842203": {
            "id": "4842203",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "The elemental power on the artifact must have worn off.",
            "nextDialogs": [
              "4842204"
            ]
          },
          "4842204": {
            "id": "4842204",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Raptor must have realized the markings would give away his position, and sent his minions to slow us down.",
            "nextDialogs": [
              "4842205"
            ]
          },
          "4842205": {
            "id": "4842205",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "That way, when the effect wears off, he can make his escape.",
            "nextDialogs": [
              "4842206"
            ]
          },
          "4842206": {
            "id": "4842206",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "He won't get away with this! After him!"
          }
        }
      }
    },
    {
      "subId": "48423",
      "subQuestName": "The direction of Raptor",
      "sceneId": null,
      "locations": [],

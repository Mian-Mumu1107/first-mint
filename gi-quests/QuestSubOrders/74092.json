  "subQuests": [
    {
      "subId": "7409201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740920101"
        ],
        "dialogs": {
          "740920101": {
            "id": "740920101",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Why... Why does it have to be this way... How vile...",
            "nextDialogs": [
              "740920104"
            ]
          },
          "740920104": {
            "id": "740920104",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "#{NICKNAME}! You're here! How wonderful... It's you... At least you know the truth...",
            "nextDialogs": [
              "740920105"
            ]
          },
          "740920105": {
            "id": "740920105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Calm down, Ms. Chronie. Are... are you okay?",
            "nextDialogs": [
              "740920106"
            ]
          },
          "740920106": {
            "id": "740920106",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Even... Even if my article doesn't get published...",
            "nextDialogs": [
              "740920107"
            ]
          },
          "740920107": {
            "id": "740920107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter with your article?",
            "nextDialogs": [
              "740920108"
            ]
          },
          "740920108": {
            "id": "740920108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! We were wondering when we'd finally see it!",
            "nextDialogs": [
              "740920109"
            ]
          },
          "740920109": {
            "id": "740920109",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Didn't see it... Didn't see it, right, that's right, you probably didn't see it...",
            "nextDialogs": [
              "740920110"
            ]
          },
          "740920110": {
            "id": "740920110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You seem... to be a bit flustered?",
            "nextDialogs": [
              "740920111"
            ]
          },
          "740920111": {
            "id": "740920111",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "It's like this... Ever since I got back from the Fontaine Research Institute, I started writing my article.",
            "nextDialogs": [
              "740920112"
            ]
          },
          "740920112": {
            "id": "740920112",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "I put everything I saw, heard, and felt into that draft.",
            "nextDialogs": [
              "740920113"
            ]
          },
          "740920113": {
            "id": "740920113",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Such as how the Institute had never completely removed the Arkhium, but instead restarted another Arkhium-related research project.",
            "nextDialogs": [
              "740920114"
            ]
          },
          "740920114": {
            "id": "740920114",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Someone who used to work under Edwin was sent to explore the Institute ruins, but lost his life in an explosion.",
            "nextDialogs": [
              "740920115"
            ]
          },
          "740920115": {
            "id": "740920115",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Senior Technician Raimondo refused to confirm his death and insisted the explosion was a planned part of the project.",
            "nextDialogs": [
              "740920116"
            ]
          },
          "740920116": {
            "id": "740920116",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Plus the out-of-control giant machine in the ruins, and the polluted water...",
            "nextDialogs": [
              "740920117"
            ]
          },
          "740920117": {
            "id": "740920117",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "Everything that the Fontaine Research Institute wanted to cover up, I detailed it all in the article!",
            "nextDialogs": [
              "740920118"
            ]
          },
          "740920118": {
            "id": "740920118",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "But... after I submitted it, I was told the Institute filed a lawsuit against me!",
            "nextDialogs": [
              "740920119"
            ]
          },
          "740920119": {
            "id": "740920119",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "According to editorial regulations, everything I reported about the Fontaine Research Institute in the article must undergo a credibility review.",
            "nextDialogs": [
              "740920120"
            ]
          },
          "740920120": {
            "id": "740920120",
            "speakerId": 1000,
            "speakerName": "Chronie",
            "text": "And my article about Fontaine Research Institute was rejected..."
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Affan": 56,
    "Paimon": 5,
    "Player": 13
  },
  "subQuests": [
    {
      "subId": "7320507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732040701"
        ],
        "dialogs": {
          "732040701": {
            "id": "732040701",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Ah, I haven't had time to cook yet, so I'm afraid I have nothing with which to receive you as guests.",
            "nextDialogs": [
              "732040704"
            ]
          },
          "732040704": {
            "id": "732040704",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "So, this other kid is your friend, huh? She's pretty cute.",
            "nextDialogs": [
              "732040705"
            ]
          },
          "732040705": {
            "id": "732040705",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Do you want to come see the flowers when they bloom?",
            "nextDialogs": [
              "732040706"
            ]
          },
          "732040706": {
            "id": "732040706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No problem.",
            "nextDialogs": [
              "732040707"
            ]
          },
          "732040707": {
            "id": "732040707",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "They will most likely bloom in a few days. Come back later to see the flowers you helped to plant.",
            "nextDialogs": [
              "732040708"
            ]
          },
          "732040708": {
            "id": "732040708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Okay.",
            "nextDialogs": [
              "732040709"
            ]
          },
          "732040709": {
            "id": "732040709",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Alright, I understand.",
            "nextDialogs": [
              "732040710"
            ]
          },
          "732040710": {
            "id": "732040710",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "♪..."
          }
        }
      }
    },
    {
      "subId": "7320501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050101"
        ],
        "dialogs": {
          "732050101": {
            "id": "732050101",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Come, come, look at these seeds.",
            "nextDialogs": [
              "732050102"
            ]
          },
          "732050102": {
            "id": "732050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Doesn't look like there's been any change.",
            "nextDialogs": [
              "732050103"
            ]
          },
          "732050103": {
            "id": "732050103",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I've been growing crops for years, but growing flowers must be different.",
            "nextDialogs": [
              "732050104"
            ]
          },
          "732050104": {
            "id": "732050104",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Why else haven't they grown after so long?",
            "nextDialogs": [
              "732050105"
            ]
          },
          "732050105": {
            "id": "732050105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let Paimon see, hmm...",
            "nextDialogs": [
              "732050106"
            ]
          },
          "732050106": {
            "id": "732050106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Grandpa Affan, Paimon thinks your nursery is too dry. And there might not be enough nutrients in the soil around Aaru Village.",
            "nextDialogs": [
              "732050107"
            ]
          },
          "732050107": {
            "id": "732050107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We've helped a villager grow flowers before, so we have experience.",
            "nextDialogs": [
              "732050108"
            ]
          },
          "732050108": {
            "id": "732050108",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Huh. Is that so...",
            "nextDialogs": [
              "732050109"
            ]
          },
          "732050109": {
            "id": "732050109",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "That makes sense. Such rare flowers should be more delicate than normal ones. Indeed, I don't water and fertilize them enough.",
            "nextDialogs": [
              "732050110"
            ]
          },
          "732050110": {
            "id": "732050110",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "But this nursery is a little far from any water sources. It's not easy to bring water here.",
            "nextDialogs": [
              "732050111"
            ]
          },
          "732050111": {
            "id": "732050111",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "And I don't store much water for daily use either, so it is rather inconvenient to water the seeds in the nursery often.",
            "nextDialogs": [
              "732050112"
            ]
          },
          "732050112": {
            "id": "732050112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can help.",
            "nextDialogs": [
              "732050113"
            ]
          },
          "732050113": {
            "id": "732050113",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Alright, in that case, please water these three seeds first."
          }
        }
      }
    },
    {
      "subId": "7320502",
      "subQuestName": "Water the flowers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7320503",
      "subQuestName": "Talk to Affan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050301"
        ],
        "dialogs": {
          "732050301": {
            "id": "732050301",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Good, good, you two are very resourceful.",
            "nextDialogs": [
              "732050302"
            ]
          },
          "732050302": {
            "id": "732050302",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I have a feeling that they will grow well this time, now that I have guidance from the experts.",
            "nextDialogs": [
              "732050303"
            ]
          },
          "732050303": {
            "id": "732050303",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Were the Shawarma and Tahchin good?",
            "nextDialogs": [
              "732050305"
            ]
          },
          "732050305": {
            "id": "732050305",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Delicious, eh? I'll make more for you, then.",
            "nextDialogs": [
              "732050307"
            ]
          },
          "732050307": {
            "id": "732050307",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I'm not as good of a cook as my late wife, so forgive my poor cooking. Please take them. The portions are smaller this time, though.",
            "nextDialogs": [
              "732050308"
            ]
          },
          "732050308": {
            "id": "732050308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This is so tasty! You're really kind! We'll visit you often.",
            "nextDialogs": [
              "732050309"
            ]
          },
          "732050309": {
            "id": "732050309",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Haha, didn't you children want to ask me what kind of flower this is?",
            "nextDialogs": [
              "732050310"
            ]
          },
          "732050310": {
            "id": "732050310",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I guess I might as well tell you. I'm planting roses.",
            "nextDialogs": [
              "732050311"
            ]
          },
          "732050311": {
            "id": "732050311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "As in, Sumeru Roses?",
            "nextDialogs": [
              "732050312"
            ]
          },
          "732050312": {
            "id": "732050312",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "This type of flower is called the Golden Rose. It's much more precious than the Sumeru Rose.",
            "nextDialogs": [
              "732050313"
            ]
          },
          "732050313": {
            "id": "732050313",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Remember how I told you that these flower seeds were left to me by a friend?",
            "nextDialogs": [
              "732050314"
            ]
          },
          "732050314": {
            "id": "732050314",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Well, these seeds, and this old house I'm living in now were all left to me by that late \"old ghost.\"",
            "nextDialogs": [
              "732050315"
            ]
          },
          "732050315": {
            "id": "732050315",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Oh, I forgot. You're not from Aaru Village, so you're most likely not familiar with that name.",
            "nextDialogs": [
              "732050316"
            ]
          },
          "732050316": {
            "id": "732050316",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "No matter. Just think of that fellow as an old man who used to grow some flowers...",
            "nextDialogs": [
              "732050317"
            ]
          },
          "732050317": {
            "id": "732050317",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "...",
            "nextDialogs": [
              "732050318"
            ]
          },
          "732050318": {
            "id": "732050318",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, Grandpa Affan, you're spacing out all of a sudden. Hello! Hello?",
            "nextDialogs": [
              "732050319"
            ]
          },
          "732050319": {
            "id": "732050319",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Ah! Oh. I was lost in thought. I'm sorry, I'm old, and my mind has begun to wander. How embarrassing...",
            "nextDialogs": [
              "732050320"
            ]
          },
          "732050320": {
            "id": "732050320",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Thank you again, children. You can have a look around if there's anything else you want to see.",
            "nextDialogs": [
              "732050321"
            ]
          },
          "732050321": {
            "id": "732050321",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I won't drive people away anymore. But be careful not to tread on the nursery."
          }
        }
      }
    },
    {
      "subId": "7320504",
      "subQuestName": "Water the flowers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050401"
        ],
        "dialogs": {
          "732050401": {
            "id": "732050401",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Water these three seeds first, and I'll think about what to do about the fertilizer.",
            "nextDialogs": [
              "732050402"
            ]
          },
          "732050402": {
            "id": "732050402",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "After growing things for decades, I do know how to make some simple fertilizer."
          }
        }
      }
    },
    {
      "subId": "7320505",
      "subQuestName": "Water the flowers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732050501"
        ],
        "dialogs": {
          "732050501": {
            "id": "732050501",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "♪Rose, oh rose, grant me my wish...",
            "nextDialogs": [
              "732050502"
            ]
          },
          "732050502": {
            "id": "732050502",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Hmm? You're still here?",
            "nextDialogs": [
              "732050504",
              "732050514"
            ]
          },
          "732050504": {
            "id": "732050504",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Well, anyway, I'm an old weirdo, and \"old weirdos behave in inexplicable ways.\" Few people ask me questions like you do.",
            "nextDialogs": [
              "732050505"
            ]
          },
          "732050505": {
            "id": "732050505",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I've always wanted to go out and grab the chance to do something with my life.",
            "nextDialogs": [
              "732050506"
            ]
          },
          "732050506": {
            "id": "732050506",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "When I was a newlywed, I almost left with the Eremites, but then I thought about it, and I couldn't just leave my wife to take up a life of wandering.",
            "nextDialogs": [
              "732050507"
            ]
          },
          "732050507": {
            "id": "732050507",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Later, I met a traveling merchant and wanted to follow suit and do some business, but that didn't work out because I didn't have enough Mora.",
            "nextDialogs": [
              "732050508"
            ]
          },
          "732050508": {
            "id": "732050508",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Much later, my wife passed and nothing held me back anymore, but by then, I'd gotten too old to leave.",
            "nextDialogs": [
              "732050509"
            ]
          },
          "732050509": {
            "id": "732050509",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I've dragged things out up till now and I've missed out on too much.",
            "nextDialogs": [
              "732050510"
            ]
          },
          "732050510": {
            "id": "732050510",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "In retrospect, I've found that I belong neither to this village, nor to anywhere else.",
            "nextDialogs": [
              "732050511"
            ]
          },
          "732050511": {
            "id": "732050511",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "So in the end, I moved by myself to the edge of the village, and I found life here to be more comfortable.",
            "nextDialogs": [
              "732050512"
            ]
          },
          "732050512": {
            "id": "732050512",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "And decades went by, just like that.",
            "nextDialogs": [
              "732050525"
            ]
          },
          "732050525": {
            "id": "732050525",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I'd like to invite you to come and see these flowers when they bloom. It's probably going to be tomorrow or the day after. Will you be able to make it?",
            "nextDialogs": [
              "732050526"
            ]
          },
          "732050526": {
            "id": "732050526",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "732050527"
            ]
          },
          "732050527": {
            "id": "732050527",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Alright, alright...",
            "nextDialogs": [
              "732050528"
            ]
          },
          "732050528": {
            "id": "732050528",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "♪Rose, oh rose, grant me my wish..."
          },
          "732050514": {
            "id": "732050514",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Only outsiders ask about the old ghost. The children of the village all know his name.",
            "nextDialogs": [
              "732050515"
            ]
          },
          "732050515": {
            "id": "732050515",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Whenever a child is naughty, their parents will say, \"The old ghost will come take you away.\"",
            "nextDialogs": [
              "732050516"
            ]
          },
          "732050516": {
            "id": "732050516",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "These younglings don't know the old ghost at all, but are pretty good at using his name to scare people.",
            "nextDialogs": [
              "732050517"
            ]
          },
          "732050517": {
            "id": "732050517",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I met the old ghost myself as a child. He did dislike children, but he wasn't scary.",
            "nextDialogs": [
              "732050518"
            ]
          },
          "732050518": {
            "id": "732050518",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "For some reason, he became known as the old ghost. I thought it was just a bunch of people talking about him behind his back.",
            "nextDialogs": [
              "732050519"
            ]
          },
          "732050519": {
            "id": "732050519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Weren't you friends?",
            "nextDialogs": [
              "732050520"
            ]
          },
          "732050520": {
            "id": "732050520",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "When I was young, I used to sneak close to his garden to play. He'd chase me away with a garden hoe as soon as he saw me.",
            "nextDialogs": [
              "732050521"
            ]
          },
          "732050521": {
            "id": "732050521",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "He probably took me for a naughty child looking to cause trouble. Why would he remember me?",
            "nextDialogs": [
              "732050522"
            ]
          },
          "732050522": {
            "id": "732050522",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "He might not have known who I was, but I still remember him and his little garden.",
            "nextDialogs": [
              "732050523"
            ]
          },
          "732050523": {
            "id": "732050523",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "So I suppose I can call him my friend, right?",
            "nextDialogs": [
              "732050524"
            ]
          },
          "732050524": {
            "id": "732050524",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "I want to grow the same flowers, just to recreate that little garden in my memories."
          }
        }
      }
    }
  ]
}
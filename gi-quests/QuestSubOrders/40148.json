    {
      "subId": "4014892",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489201"
        ],
        "dialogs": {
          "401489201": {
            "id": "401489201",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Oil, salt, sauce, vinegar... Right, that's everything we need."
          }
        }
      }
    },
    {
      "subId": "4014893",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489301"
        ],
        "dialogs": {
          "401489301": {
            "id": "401489301",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "#Why, {NICKNAME}, this year's off to a good start, wouldn't you say?"
          }
        }
      }
    },
    {
      "subId": "4014894",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489401"
        ],
        "dialogs": {
          "401489401": {
            "id": "401489401",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "The air was getting stifling, so I made some excuses and slipped away... Anyway, thanks for taking the hint earlier. I'll fill you in later."
          }
        }
      }
    },
    {
      "subId": "4014895",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489501"
        ],
        "dialogs": {
          "401489501": {
            "id": "401489501",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "I never knew tofu allergy was even a thing... Okay, I'll handle the appetizers, you take care of the main event.",
            "nextDialogs": [
              "401489502"
            ]
          },
          "401489502": {
            "id": "401489502",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "I can help, too. Don't worry, I'm qualified — I passed Liyue's senior culinary exam once."
          }
        }
      }
    },
    {
      "subId": "4014896",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489601"
        ],
        "dialogs": {
          "401489601": {
            "id": "401489601",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "...Seriously, if I'd blinked I would've missed it! Crimson Staff just launched itself at Bloom Pruner and sent it flying!",
            "nextDialogs": [
              "401489602"
            ]
          },
          "401489602": {
            "id": "401489602",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "I'd expect no less of the Bona-Fide Beetle Battle King himself. It sounds like a truly epoch-defining duel."
          }
        }
      }
    },
    {
      "subId": "4014897",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489701"
        ],
        "dialogs": {
          "401489701": {
            "id": "401489701",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "\"Count Crushmore,\" \"Instant Kill\"... I never knew there were so many elite beetle-fighters in Liyue.",
            "nextDialogs": [
              "401489702"
            ]
          },
          "401489702": {
            "id": "401489702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You didn't really come for the Onikabuto-fighting contest, did you...?",
            "nextDialogs": [
              "401489703"
            ]
          },
          "401489703": {
            "id": "401489703",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "Heh, can you imagine? That would be tardiness of the most unfashionable variety. No, in truth, this trip is part-business, part-leisure.",
            "nextDialogs": [
              "401489704"
            ]
          },
          "401489704": {
            "id": "401489704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How come you didn't come to the Lantern Rite then?",
            "nextDialogs": [
              "401489705"
            ]
          },
          "401489705": {
            "id": "401489705",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "Every visitor has their own agenda. For some, the festivities are all the more reason to visit, for others, all the more reason to avoid the crowds.",
            "nextDialogs": [
              "401489706"
            ]
          },
          "401489706": {
            "id": "401489706",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "In any case, one way or another I seem to have ended up in the right place at the right time... Now, as for the leftover tofu... yes, I'm sure Thoma will dispose of it as he sees fit."
          }
        }
      }
    },
    {
      "subId": "4014898",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401489801"
        ],
        "dialogs": {
          "401489801": {
            "id": "401489801",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I have to get back to the docks as soon as this meal is done...",
            "nextDialogs": [
              "401489802"
            ]
          },
          "401489802": {
            "id": "401489802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, why did you really come to Liyue?",
            "nextDialogs": [
              "401489803"
            ]
          },
          "401489803": {
            "id": "401489803",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Well, uh... thing is...",
            "nextDialogs": [
              "401489804"
            ]
          },
          "401489804": {
            "id": "401489804",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "...I can explain. Boss recently found work as a sailor, which allowed him to hitch a ride here.",
            "nextDialogs": [
              "401489805"
            ]
          },
          "401489805": {
            "id": "401489805",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "After the ship docked, he had some free time to do as he pleases. He's been using that time to hang out with Grandmaster Hanakado.",
            "nextDialogs": [
              "401489806"
            ]
          },
          "401489806": {
            "id": "401489806",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Just because he's here already! No other reason!"
          }
        }
      }
    }
  ]
}
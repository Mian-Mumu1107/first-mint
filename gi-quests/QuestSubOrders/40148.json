  "subQuests": [
    {
      "subId": "4014801",
      "subQuestName": "Wait till the next day (06:00 – 08:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480101"
        ],
        "dialogs": {
          "401480101": {
            "id": "401480101",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "#Morning {NICKNAME}. Time to fire up the stove for another day of customers. Thanks again!",
            "nextDialogs": [
              "401480102"
            ]
          },
          "401480102": {
            "id": "401480102",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "With days of experience now under your belt, the work is becoming second nature...",
            "nextDialogs": [
              "401480103"
            ]
          },
          "401480103": {
            "id": "401480103",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Great work... You're looking more like a head chef every day! Hehe, whatever crazy characters come walking through that door, I know you'll be able to handle them...",
            "nextDialogs": [
              "401480104"
            ]
          },
          "401480104": {
            "id": "401480104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, no! Every time you say something like that, you jinx it!",
            "nextDialogs": [
              "401480105"
            ]
          },
          "401480105": {
            "id": "401480105",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Hey, that's not true! Anyway, I didn't mean it like that...",
            "nextDialogs": [
              "401480106"
            ]
          },
          "401480106": {
            "id": "401480106",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ahahahaha!",
            "nextDialogs": [
              "401480107"
            ]
          },
          "401480107": {
            "id": "401480107",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Dude! What up, bro!? I didn't know you were in Liyue too! Ah, it's always nice to run into a broad Inazuman fellow... Wait, did I say that right?",
            "nextDialogs": [
              "401480108"
            ]
          },
          "401480108": {
            "id": "401480108",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Almost. I think you meant \"fellow Inazuman abroad,\" Boss.",
            "nextDialogs": [
              "401480109"
            ]
          },
          "401480109": {
            "id": "401480109",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Yeah, yeah, that's the one! We gotta look out for each other when we're this far from home! Don't we, Ayato?",
            "nextDialogs": [
              "401480110"
            ]
          },
          "401480110": {
            "id": "401480110",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "Hehe...",
            "nextDialogs": [
              "401480111"
            ]
          },
          "401480111": {
            "id": "401480111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Bull-Chucker! What are you doing here!?",
            "nextDialogs": [
              "401480112"
            ]
          },
          "401480112": {
            "id": "401480112",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Huh? Oh hey, Flying Lavender Melon... uh, of the \"Skycleaving White Iron\" variety! And my compadre, too! All my buddies in one place, today's my lucky day!",
            "nextDialogs": [
              "401480113"
            ]
          },
          "401480113": {
            "id": "401480113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Didn't you say you were gonna knuckle down and earn some Mora when you got home? How come you're back in Liyue so soon?",
            "nextDialogs": [
              "401480114"
            ]
          },
          "401480114": {
            "id": "401480114",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Haha, that can wait. As soon as I announce that Arataki Itto is available for hire, they'll be throwing Mora at me... Right now, I got a more urgent situation to attend to: I'm in the mood for some good, spicy food!",
            "nextDialogs": [
              "401480115"
            ]
          },
          "401480115": {
            "id": "401480115",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "...Oh, and while we're here, we were also gonna see if Grandmaster Hanakado's okay, and whatnot.",
            "nextDialogs": [
              "401480116"
            ]
          },
          "401480116": {
            "id": "401480116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(The look on Shinobu's face seems to say... \"Don't ask.\")",
            "nextDialogs": [
              "401480117"
            ]
          },
          "401480117": {
            "id": "401480117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So what about you, Ayato?",
            "nextDialogs": [
              "401480118"
            ]
          },
          "401480118": {
            "id": "401480118",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "...Not too long ago, I heard a rumor that someone was hosting an Onikabuto-fighting contest in Liyue. Naturally, I came here as soon as I could... but alas, it was too late.",
            "nextDialogs": [
              "401480119"
            ]
          },
          "401480119": {
            "id": "401480119",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "What? You missed it? Aw man, what a bummer!",
            "nextDialogs": [
              "401480120"
            ]
          },
          "401480120": {
            "id": "401480120",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "Quite the bummer indeed — though all is not lost. Since you're here, you'll be able to tell me all about it.",
            "nextDialogs": [
              "401480121"
            ]
          },
          "401480121": {
            "id": "401480121",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Haha, sure thing my man! But let's catch up over some food... Where's the chef, anyway? Hey, get the chef out here — I got compadres to feed!",
            "nextDialogs": [
              "401480122"
            ]
          },
          "401480122": {
            "id": "401480122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm the chef.",
            "nextDialogs": [
              "401480123"
            ]
          },
          "401480123": {
            "id": "401480123",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Yeah, sure, me too... What!?",
            "nextDialogs": [
              "401480124"
            ]
          },
          "401480124": {
            "id": "401480124",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, Bull-Chucker set that one up for us really nicely. Gotta give him some credit for that!",
            "nextDialogs": [
              "401480125"
            ]
          },
          "401480125": {
            "id": "401480125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...But the main chef is another guy.",
            "nextDialogs": [
              "401480126"
            ]
          },
          "401480126": {
            "id": "401480126",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Uh... Haha, good one compadre, you almost got me there. Alright, well get the chef out here!",
            "nextDialogs": [
              "401480127"
            ]
          },
          "401480127": {
            "id": "401480127",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You and Paimon go to the kitchen and fetch Smiley Yanxiao...",
            "nextDialogs": [
              "401480128"
            ]
          },
          "401480128": {
            "id": "401480128",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "So, uh... May I take your order? If you're entertaining guests, I can recommend The Palace Jewels, a Trembling Strings and Rushing Reeds, or...",
            "nextDialogs": [
              "401480129"
            ]
          },
          "401480129": {
            "id": "401480129",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "...Boss, don't forget the budget.",
            "nextDialogs": [
              "401480130"
            ]
          },
          "401480130": {
            "id": "401480130",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Yeah, okay, um... Got anything a little more, uh... down to earth?",
            "nextDialogs": [
              "401480131"
            ]
          },
          "401480131": {
            "id": "401480131",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Down to earth...? Oh... Well, we do a mean \"Humbly Enough.\" Real hearty dish with a ton of flavor, and we don't skimp on the portion size either. That'd be the best value for your Mora...",
            "nextDialogs": [
              "401480132"
            ]
          },
          "401480132": {
            "id": "401480132",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Humbly Enough, huh? Sounds like my kind of grub! We'll take that — no need for anything fancy, we're all friends here!",
            "nextDialogs": [
              "401480133"
            ]
          },
          "401480133": {
            "id": "401480133",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "Excellent choice, Itto — I'm no fan of culinary ostentation either. Heh... sometimes a bro just knows, hmm?",
            "nextDialogs": [
              "401480134"
            ]
          },
          "401480134": {
            "id": "401480134",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "A bro just knows... Yes, a bro just knows! Bros don't suppose, 'cause bros just knows!",
            "nextDialogs": [
              "401480135"
            ]
          },
          "401480135": {
            "id": "401480135",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is this for real? ...Whatever, Paimon's leaving you guys to it."
          }
        }
      }
    },
    {
      "subId": "4014802",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4014806",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480401"
        ],
        "dialogs": {
          "401480401": {
            "id": "401480401",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Gotta say, your friend's quite a character... Still, Humbly Enough isn't that hard to make, so I don't think we'll have any problems with this order.",
            "nextDialogs": [
              "401480402"
            ]
          },
          "401480402": {
            "id": "401480402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually, why is it called \"Humbly Enough\" anyway? A hearty meat dish is a good start, but in Paimon's experience, one humble dish is never enough!",
            "nextDialogs": [
              "401480403"
            ]
          },
          "401480403": {
            "id": "401480403",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Uh, I said it was hearty, but I never said it contained meat... Don't be fooled by the appearance — it's actually just tofu made to look and taste like meat.",
            "nextDialogs": [
              "401480404"
            ]
          },
          "401480404": {
            "id": "401480404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tofu!?",
            "nextDialogs": [
              "401480405"
            ]
          },
          "401480405": {
            "id": "401480405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait! Tofu is made of beans, isn't it... Bull-Chucker can't eat that! Guess we'll have to get them to pick something else instead...",
            "nextDialogs": [
              "401480406"
            ]
          },
          "401480406": {
            "id": "401480406",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "...What's the issue? I think I caught the word \"tofu\"...",
            "nextDialogs": [
              "401480407"
            ]
          },
          "401480407": {
            "id": "401480407",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Wait, what are you doing? The kitchen is staff members only... *sigh* Never mind, I'll let it slide. Ma'am, could you possibly ask your Boss to order something else instead?",
            "nextDialogs": [
              "401480408"
            ]
          },
          "401480408": {
            "id": "401480408",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "...Haha! No one gets my bro Ayato like I do! I hereby declare that Humbly Enough will be an everlasting symbol of our friendship, or my name ain't Arataki Itto!",
            "nextDialogs": [
              "401480409"
            ]
          },
          "401480409": {
            "id": "401480409",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "...Hey! Where's our food at? Hurry up, I'm almost done recounting the epic adventures of Crimson Staff!",
            "nextDialogs": [
              "401480410"
            ]
          },
          "401480410": {
            "id": "401480410",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "...As you can see, changing the order may be a little difficult.",
            "nextDialogs": [
              "401480411"
            ]
          },
          "401480411": {
            "id": "401480411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh brother, his whole ego is riding on this, huh... Even if we break the news to him, he'd probably rather eat the tofu than eat his words...",
            "nextDialogs": [
              "401480414"
            ]
          },
          "401480414": {
            "id": "401480414",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Sounds good. I'll make sure he fills up on those... We'll just have to play the rest by ear."
          }
        }
      }
    },
    {
      "subId": "4014803",
      "subQuestName": "Cook \"Humbly Enough\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480301"
        ],
        "dialogs": {
          "401480301": {
            "id": "401480301",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Looks like that's all sorted? Alright, take some time to collect yourself — the next big group is coming in.",
            "nextDialogs": [
              "401480302"
            ]
          },
          "401480302": {
            "id": "401480302",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "The rest of the day passes without incident..."
          }
        }
      }
    },
    {
      "subId": "4014804",
      "subQuestName": "Bring the food to the waiting Inazumans",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401480201"
        ],
        "dialogs": {
          "401480201": {
            "id": "401480201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... Food's here...",
            "nextDialogs": [
              "401480202"
            ]
          },
          "401480202": {
            "id": "401480202",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Oho, so this is Humbly Enough? You guys don't mess around! Love me that portion size!",
            "nextDialogs": [
              "401480203"
            ]
          },
          "401480203": {
            "id": "401480203",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Come on, compadre, grab a seat. We're all friends here, so don't hold back! I'm just gonna dig right in...",
            "nextDialogs": [
              "401480204"
            ]
          },
          "401480204": {
            "id": "401480204",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Ahem! Boss, we should respect the local customs. Here in Liyue, it's polite to let the guests eat first.",
            "nextDialogs": [
              "401480205"
            ]
          },
          "401480205": {
            "id": "401480205",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Polite? Uh... Shinobu, I thought old-timey traditions weren't your style...",
            "nextDialogs": [
              "401480208"
            ]
          },
          "401480208": {
            "id": "401480208",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Huh? Are you kidding me, compadre? ...Ohh wait, I get it. The food smells so dang good, now everyone's dying to go first! Well, guess I only got my own good taste to blame. Go on, dive in, I'll wait till last!",
            "nextDialogs": [
              "401480209"
            ]
          },
          "401480209": {
            "id": "401480209",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "...",
            "nextDialogs": [
              "401480210"
            ]
          },
          "401480210": {
            "id": "401480210",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You, Paimon, Ayato, and Shinobu help yourselves, leaving very little \"meat\" behind...",
            "nextDialogs": [
              "401480211"
            ]
          },
          "401480211": {
            "id": "401480211",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "...Hah, I see.",
            "nextDialogs": [
              "401480212"
            ]
          },
          "401480212": {
            "id": "401480212",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Finally, it's my turn! Hoohoo, I spy a big chunk of deliciousness with my name on it...",
            "nextDialogs": [
              "401480213"
            ]
          },
          "401480213": {
            "id": "401480213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, don't!",
            "nextDialogs": [
              "401480214"
            ]
          },
          "401480214": {
            "id": "401480214",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Huh? What is it now?"
          }
        }
      }
    },
    {
      "subId": "4014805",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {

{
  "lineCounts": {
    "Aurele": 25,
    "Black Screen": 1,
    "Louis": 6,
    "Lovi": 30,
    "Player": 11,
    "Verut": 17
  },
  "subQuests": [
    {
      "subId": "2400501",
      "subQuestName": "Talk to Verut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050101"
        ],
        "dialogs": {
          "240050101": {
            "id": "240050101",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "C'mon, brother, this way! We haven't seen that big house, have we?",
            "nextDialogs": [
              "240050102"
            ]
          },
          "240050102": {
            "id": "240050102",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Take it slow, Verut, or you'll fall again. You too, Lovi. Your father says that you're in ill health, so you might catch a cold.",
            "nextDialogs": [
              "240050103"
            ]
          },
          "240050103": {
            "id": "240050103",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Ugh, your brother's such a nag, just like my mom!",
            "nextDialogs": [
              "240050104"
            ]
          },
          "240050104": {
            "id": "240050104",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "I know, right?",
            "nextDialogs": [
              "240050105"
            ]
          },
          "240050105": {
            "id": "240050105",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "You two...",
            "nextDialogs": [
              "240050108"
            ]
          },
          "240050108": {
            "id": "240050108",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Hey, it's you! Well, we're not playing hide-and-seek this time.",
            "nextDialogs": [
              "240050109"
            ]
          },
          "240050109": {
            "id": "240050109",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "More precisely, we're done playing... and we got an earful from Ms. Nour too.",
            "nextDialogs": [
              "240050110"
            ]
          },
          "240050110": {
            "id": "240050110",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "She's always so serious when she's at work, lecturing people left and right. And I even gave her biscuits in the past!",
            "nextDialogs": [
              "240050111"
            ]
          },
          "240050111": {
            "id": "240050111",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Well, whatever, we were tired anyway. I was gonna take Verut and Aurele around to grab something delicious.",
            "nextDialogs": [
              "240050112"
            ]
          },
          "240050112": {
            "id": "240050112",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Would you like to join us in our... Uh... What do we call it?",
            "nextDialogs": [
              "240050113"
            ]
          },
          "240050113": {
            "id": "240050113",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "A stroll.",
            "nextDialogs": [
              "240050114"
            ]
          },
          "240050114": {
            "id": "240050114",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Yes, a stroll! Come with us!",
            "nextDialogs": [
              "240050115"
            ]
          },
          "240050115": {
            "id": "240050115",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Let's head to the plaza over there. I wanna see the fountain!"
          }
        }
      }
    },
    {
      "subId": "2400502",
      "subQuestName": "Go to the plaza",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050201"
        ],
        "dialogs": {
          "240050201": {
            "id": "240050201",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Wow... I'd just love to jump in and tread water or use the fountain to take a bath!",
            "nextDialogs": [
              "240050202"
            ]
          },
          "240050202": {
            "id": "240050202",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "And that'll get you scolded for sure. Just watch it from outside, please.",
            "nextDialogs": [
              "240050203"
            ]
          },
          "240050203": {
            "id": "240050203",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "But if the fountains aren't for people to play in, then why are they so big?",
            "nextDialogs": [
              "240050204"
            ]
          },
          "240050204": {
            "id": "240050204",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "They might look nice, but if you can only look at them, then they're just pools of ordinary water. Nothing to them!",
            "nextDialogs": [
              "240050205"
            ]
          },
          "240050205": {
            "id": "240050205",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "This is no ordinary fountain, you know. But... Wait, my dad did mention those ordinary fountains... What was it that he said again...?",
            "nextDialogs": [
              "240050206"
            ]
          },
          "240050206": {
            "id": "240050206",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "\"The main purpose of city beautification projects in the Court of Fontaine is to solve tax declaration issues in a flexible fashion.\"",
            "nextDialogs": [
              "240050207"
            ]
          },
          "240050207": {
            "id": "240050207",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Mr. Delerue was explaining this to me.",
            "nextDialogs": [
              "240050208"
            ]
          },
          "240050208": {
            "id": "240050208",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Hah, you even sounded like my father back there. No wonder he likes you, Aurele. I mean, he always takes that stack of books with him when he talks to you.",
            "nextDialogs": [
              "240050209"
            ]
          },
          "240050209": {
            "id": "240050209",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "I didn't understand a word of that, but I bet my brother's killing the mood again.",
            "nextDialogs": [
              "240050210"
            ]
          },
          "240050210": {
            "id": "240050210",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Lovi, let's find another place to play. I mean, you don't have to study today for once, right?",
            "nextDialogs": [
              "240050211"
            ]
          },
          "240050211": {
            "id": "240050211",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Alright, let's go see some other places. Let me think... The Steambird should still be open. Let's go over there!"
          }
        }
      }
    },
    {
      "subId": "2400503",
      "subQuestName": "Go to The Steambird",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050301"
        ],
        "dialogs": {
          "240050301": {
            "id": "240050301",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "So this is The Steambird? It... doesn't look all that special, really.",
            "nextDialogs": [
              "240050304"
            ]
          },
          "240050304": {
            "id": "240050304",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Wow, so they really do have a machine bird here! Cool!",
            "nextDialogs": [
              "240050305"
            ]
          },
          "240050305": {
            "id": "240050305",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Right? My father often takes me here to purchase a newspaper.",
            "nextDialogs": [
              "240050306"
            ]
          },
          "240050306": {
            "id": "240050306",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "He absolutely loves The Steambird. In fact, he could spend all day just reading the newspaper. Sometimes, he even cuts pieces out and sticks them in a book he keeps.",
            "nextDialogs": [
              "240050307"
            ]
          },
          "240050307": {
            "id": "240050307",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "He calls those his \"reviews,\" and sometimes, he even reads them out to my mother and me.",
            "nextDialogs": [
              "240050308"
            ]
          },
          "240050308": {
            "id": "240050308",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "We don't really like hearing them, though. We just say \"yeah,\" and \"oh,\" and \"is that so?\" and stuff, but he enjoys reading them so much that he doesn't even notice.",
            "nextDialogs": [
              "240050309"
            ]
          },
          "240050309": {
            "id": "240050309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And what does he mean by \"review\"?",
            "nextDialogs": [
              "240050310"
            ]
          },
          "240050310": {
            "id": "240050310",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Simply put, a review is a set of opinions that the reviewer expresses from their own perspective.",
            "nextDialogs": [
              "240050311"
            ]
          },
          "240050311": {
            "id": "240050311",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Lovi's father, Delerue, is a scientist at the Fontaine Research Institute.",
            "nextDialogs": [
              "240050320"
            ]
          },
          "240050320": {
            "id": "240050320",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "At the same time, he's also a \"reviewer\" who writes \"reviews\" on The Steambird.",
            "nextDialogs": [
              "240050312"
            ]
          },
          "240050312": {
            "id": "240050312",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Yeah, and he sure loves his lengthy reviews of... well, everything.",
            "nextDialogs": [
              "240050313"
            ]
          },
          "240050313": {
            "id": "240050313",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Sometimes, he'll think of something as he talks, and he'll rush into his room to scribble a draft. He won't even eat while he's at it. He just drinks tea.",
            "nextDialogs": [
              "240050314"
            ]
          },
          "240050314": {
            "id": "240050314",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Huh. You can make Mora just by giving your opinion?",
            "nextDialogs": [
              "240050315"
            ]
          },
          "240050315": {
            "id": "240050315",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "That alone won't make you a \"reviewer.\" You need to follow some principles if you want to write a review that others will acknowledge...",
            "nextDialogs": [
              "240050316"
            ]
          },
          "240050316": {
            "id": "240050316",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Um... Uh... Well, anyone hungry?",
            "nextDialogs": [
              "240050317"
            ]
          },
          "240050317": {
            "id": "240050317",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Mr. Louis told me that he's been selling Bulle Fruit-flavored fries recently. Let's go and try some. It'll be my treat!",
            "nextDialogs": [
              "240050318"
            ]
          },
          "240050318": {
            "id": "240050318",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Oh... yeah, sure! C'mon, brother, stop rambling. Let's go!",
            "nextDialogs": [
              "240050319"
            ]
          },
          "240050319": {
            "id": "240050319",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "You two..."
          }
        }
      }
    },
    {
      "subId": "2400504",
      "subQuestName": "Talk to Louis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050401"
        ],
        "dialogs": {
          "240050401": {
            "id": "240050401",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Mr. Louis! I'd like a few servings of Bulle Fruit-flavored fries!",
            "nextDialogs": [
              "240050402"
            ]
          },
          "240050402": {
            "id": "240050402",
            "speakerId": 5057,
            "speakerName": "Louis",
            "text": "Ah, if it isn't Lovi! I'm afraid I'm out of Bulle Fruit for the day. There were too many people at the port, you see...",
            "nextDialogs": [
              "240050403"
            ]
          },
          "240050403": {
            "id": "240050403",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "B—But I told you about this a while back, didn't I? And I even brought some friends with me...",
            "nextDialogs": [
              "240050404"
            ]
          },
          "240050404": {
            "id": "240050404",
            "speakerId": 5057,
            "speakerName": "Louis",
            "text": "*sigh* I'm sorry. There were too many customers today, and I forgot... I do have some ordinary fries here, though. Please, take them on the house.",
            "nextDialogs": [
              "240050405"
            ]
          },
          "240050405": {
            "id": "240050405",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Alright, then. Thanks, Mr. Louis...",
            "nextDialogs": [
              "240050408"
            ]
          },
          "240050408": {
            "id": "240050408",
            "speakerId": 5057,
            "speakerName": "Louis",
            "text": "Well, if you can provide me with some, I could make the sauce right away. I do have some of the other condiments left over...",
            "nextDialogs": [
              "240050409"
            ]
          },
          "240050409": {
            "id": "240050409",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Yay! You're just awesome!",
            "nextDialogs": [
              "240050410"
            ]
          },
          "240050410": {
            "id": "240050410",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Thanks!",
            "nextDialogs": [
              "240050411"
            ]
          },
          "240050411": {
            "id": "240050411",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "I'm very sorry. It seems that we always trouble you somehow whenever we meet..."
          }
        }
      }
    },
    {
      "subId": "2400505",
      "subQuestName": "Bring the Bulle Fruit to Louis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050501"
        ],
        "dialogs": {
          "240050501": {
            "id": "240050501",
            "speakerId": 5057,
            "speakerName": "Louis",
            "text": "Have you brought the Bulle Fruit?"
          }
        }
      }
    },
    {
      "subId": "2400506",
      "subQuestName": "Bring the Bulle Fruit to Louis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050601"
        ],
        "dialogs": {
          "240050601": {
            "id": "240050601",
            "speakerId": 5057,
            "speakerName": "Louis",
            "text": "These should do. Please give me a moment...",
            "nextDialogs": [
              "240050602"
            ]
          },
          "240050602": {
            "id": "240050602",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Louis starts making Bulle Fruit sauce...",
            "nextDialogs": [
              "240050603"
            ]
          },
          "240050603": {
            "id": "240050603",
            "speakerId": 5057,
            "speakerName": "Louis",
            "text": "And we're done! These fresh-from-the-oven fries are on the house. You can eat them right away, but be careful, they're hot!",
            "nextDialogs": [
              "240050604"
            ]
          },
          "240050604": {
            "id": "240050604",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Nice! Tuck in, all of you. They're great!",
            "nextDialogs": [
              "240050605"
            ]
          },
          "240050605": {
            "id": "240050605",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Oh, and Aurele, don't tell my father about this, or he'll lecture me again...",
            "nextDialogs": [
              "240050606"
            ]
          },
          "240050606": {
            "id": "240050606",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Heh. Don't worry. In any case, I doubt Mr. Delerue is all that interested in fries.",
            "nextDialogs": [
              "240050607"
            ]
          },
          "240050607": {
            "id": "240050607",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Well... what about me?",
            "nextDialogs": [
              "240050608"
            ]
          },
          "240050608": {
            "id": "240050608",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "You just eat up. As for my share, you can split it amongst yourselves. I don't really like eating fries.",
            "nextDialogs": [
              "240050609"
            ]
          },
          "240050609": {
            "id": "240050609",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Hehehe, in that case, I'll help myself! C'mon, here, you should try some too. This is all thanks to you, hehe!",
            "nextDialogs": [
              "240050610"
            ]
          },
          "240050610": {
            "id": "240050610",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Ah, right, I have to go buy Mr. Delerue some coffee later...",
            "nextDialogs": [
              "240050611"
            ]
          },
          "240050611": {
            "id": "240050611",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Wait, you can't do that! Mom has banned Dad from drinking coffee for a long time now.",
            "nextDialogs": [
              "240050612"
            ]
          },
          "240050612": {
            "id": "240050612",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Every time he drinks coffee, he will cough non-stop in his room. He even goes hoarse in the process.",
            "nextDialogs": [
              "240050613"
            ]
          },
          "240050613": {
            "id": "240050613",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Dad says that he does all this for work, but what sort of work makes you suffer like that?",
            "nextDialogs": [
              "240050614"
            ]
          },
          "240050614": {
            "id": "240050614",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "...Is this the \"price\" he mentioned for writing excellent reviews?",
            "nextDialogs": [
              "240050615"
            ]
          },
          "240050615": {
            "id": "240050615",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "The work of a reviewer sure seems hard..."
          }
        }
      }
    },
    {
      "subId": "2400511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240051101"
        ],
        "dialogs": {
          "240051101": {
            "id": "240051101",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Is your brother always so serious? I've never seen him smile...",
            "nextDialogs": [
              "240051102"
            ]
          },
          "240051102": {
            "id": "240051102",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Not in the past, but he started becoming like this ever since he started reading with your dad. Now, he's always frowning, and I don't know what he's thinking.",
            "nextDialogs": [
              "240051103"
            ]
          },
          "240051103": {
            "id": "240051103",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Urgh, that really does sound just like my dad. Mom says that it's like he's always wrestling with something.",
            "nextDialogs": [
              "240051104"
            ]
          },
          "240051104": {
            "id": "240051104",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "But what is he wrestling with? Did he argue with your mother or something?",
            "nextDialogs": [
              "240051105"
            ]
          },
          "240051105": {
            "id": "240051105",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "No, they never argue!",
            "nextDialogs": [
              "240051106"
            ]
          },
          "240051106": {
            "id": "240051106",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Adults are so weird..."
          }
        }
      }
    },
    {
      "subId": "2400512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240051201"
        ],
        "dialogs": {
          "240051201": {
            "id": "240051201",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Sorry for bothering you. I'll take care of them here. Someone's gotta stop them from running off...",
            "nextDialogs": [
              "240051202"
            ]
          },
          "240051202": {
            "id": "240051202",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "If I can become a reviewer for The Steambird, I'll be able to earn an income...",
            "nextDialogs": [
              "240051203"
            ]
          },
          "240051203": {
            "id": "240051203",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "But Mr. Delerue said that if I wanted to become a reviewer, I can't prize Mora too much. Otherwise, I'll start down the wrong path.",
            "nextDialogs": [
              "240051204"
            ]
          },
          "240051204": {
            "id": "240051204",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "But I really do need the Mora... What should I do... *sigh*"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7526301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630101"
        ],
        "dialogs": {
          "752630101": {
            "id": "752630101",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Attention, everyone! The Easybreeze Speed Champions Tournament is about to begin!",
            "nextDialogs": [
              "752630102"
            ]
          },
          "752630102": {
            "id": "752630102",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Whoever beats our reigning champ, \"Raging Wind Nanasian,\" our winner for three days straight, will win today's surprise grand prize! Now's your last chance to register for the tournament!",
            "nextDialogs": [
              "752630103"
            ]
          },
          "752630103": {
            "id": "752630103",
            "speakerId": 1001,
            "speakerName": "\"Raging Wind Nanasian\"",
            "text": "Hmph! No challengers left for me, \"Raging Wind Nanasian\"? Is that it? Everyone's too scared to lose?",
            "nextDialogs": [
              "752630104"
            ]
          },
          "752630104": {
            "id": "752630104",
            "speakerId": 1008,
            "speakerName": "Disheartened Visitor",
            "text": "*sigh* No one's a match for \"Raging Wind Nanasian.\" Three days in a row! That sort of consistency is hard to beat.",
            "nextDialogs": [
              "752630105"
            ]
          },
          "752630105": {
            "id": "752630105",
            "speakerId": 1009,
            "speakerName": "Enthusiastic Yumkasaur",
            "text": "Awrrrh!",
            "nextDialogs": [
              "752630106"
            ]
          },
          "752630106": {
            "id": "752630106",
            "speakerId": 1008,
            "speakerName": "Disheartened Visitor",
            "text": "Oh? You wanna give it a shot?",
            "nextDialogs": [
              "752630107"
            ]
          },
          "752630107": {
            "id": "752630107",
            "speakerId": 1001,
            "speakerName": "\"Raging Wind Nanasian\"",
            "text": "Hmph. So we've stooped to letting saurians enter now? Fine! Send out all your beasts, and I'll show you what true speed looks like!",
            "nextDialogs": [
              "752630108"
            ]
          },
          "752630108": {
            "id": "752630108",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "What a unique tournament this is turning out to be! Can these mighty saurian companions dethrone our three-time winner, \"Raging Wind Nanasian\"?"
          }
        }
      }
    },

    {
      "subId": "7526305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630501"
        ],
        "dialogs": {
          "752630501": {
            "id": "752630501",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Race over! It's over! What a shocking turn of events!",
            "nextDialogs": [
              "752630502"
            ]
          },
          "752630502": {
            "id": "752630502",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "#And our ultimate winner is... {NICKNAME}!",
            "nextDialogs": [
              "752630503"
            ]
          },
          "752630503": {
            "id": "752630503",
            "speakerId": 1003,
            "speakerName": "Excited Visitor",
            "text": "#Whoa! {M#He}{F#She}'s incredible! {M#He}{F#She} actually managed to beat both \"Easy Come\" and \"Easy Go\"!",
            "nextDialogs": [
              "752630504"
            ]
          },
          "752630504": {
            "id": "752630504",
            "speakerId": 1006,
            "speakerName": "Ecstatic Visitor",
            "text": "#{M#He}{F#She} was like a golden lightning bolt!",
            "nextDialogs": [
              "752630505"
            ]
          },
          "752630505": {
            "id": "752630505",
            "speakerId": 1007,
            "speakerName": "Paimon",
            "text": "Oh, c'mon! What about this silver lightning bolt? Did nobody see the silver lightning bolt?",
            "nextDialogs": [
              "752630506"
            ]
          },
          "752630506": {
            "id": "752630506",
            "speakerId": 1001,
            "speakerName": "\"Raging Wind Nanasian\"",
            "text": "A crushing defeat... I doubt I'll ever reach that kind of speed...",
            "nextDialogs": [
              "752630507"
            ]
          },
          "752630507": {
            "id": "752630507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't give up.",
            "nextDialogs": [
              "752630508"
            ]
          },
          "752630508": {
            "id": "752630508",
            "speakerId": 1001,
            "speakerName": "\"Raging Wind Nanasian\"",
            "text": "I... I'll take you as my role model...",
            "nextDialogs": [
              "752630509"
            ]
          },
          "752630509": {
            "id": "752630509",
            "speakerId": 1004,
            "speakerName": "\"Easy Come\"",
            "text": "♪, ♩~~",
            "nextDialogs": [
              "752630510"
            ]
          },
          "752630510": {
            "id": "752630510",
            "speakerId": 1005,
            "speakerName": "\"Easy Go\"",
            "text": "♫, ♩~~",
            "nextDialogs": [
              "752630511"
            ]
          },
          "752630511": {
            "id": "752630511",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Please accept this grand prize specially prepared for the tournament's champion — you deserve it!",
            "nextDialogs": [
              "752630512"
            ]
          },
          "752630512": {
            "id": "752630512",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Your name will go down in the annals of the Easybreeze Speed Champions Tournament forever!"
          }
        }
      }
    },

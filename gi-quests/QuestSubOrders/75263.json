      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630201"
        ],
        "dialogs": {
          "752630201": {
            "id": "752630201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd like to sign up too.",
            "nextDialogs": [
              "752630202"
            ]
          },
          "752630202": {
            "id": "752630202",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "What a twist! A brave challenger steps up!",
            "nextDialogs": [
              "752630203"
            ]
          },
          "752630203": {
            "id": "752630203",
            "speakerId": 1001,
            "speakerName": "\"Raging Wind Nanasian\"",
            "text": "Huh? You think you stand a chance against me?",
            "nextDialogs": [
              "752630204"
            ]
          },
          "752630204": {
            "id": "752630204",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "So many twists and turns today... Who'll be the champion in the end? Let's find out!",
            "nextDialogs": [
              "752630205"
            ]
          },
          "752630205": {
            "id": "752630205",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The staff mark out the course, and the crowd gathers around to watch. You take your place on the start line..."
          }
        }
      }
    },
    {
      "subId": "7526303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630301"
        ],
        "dialogs": {
          "752630301": {
            "id": "752630301",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Unbelievable! Someone actually beat \"Raging Wind Nanasian\"!",
            "nextDialogs": [
              "752630302"
            ]
          },
          "752630302": {
            "id": "752630302",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "#This challenger has claimed today's championship with {M#his}{F#her} lightning-quick moves. Let's hear it for {M#him}{F#her}! Congratulations!",
            "nextDialogs": [
              "752630303"
            ]
          },
          "752630303": {
            "id": "752630303",
            "speakerId": 1001,
            "speakerName": "\"Raging Wind Nanasian\"",
            "text": "I lost!? No way... This can't be real!",
            "nextDialogs": [
              "752630304"
            ]
          },
          "752630304": {
            "id": "752630304",
            "speakerId": 1003,
            "speakerName": "Excited Visitor",
            "text": "#{M#He}{F#She}'s amazing!",
            "nextDialogs": [
              "752630305"
            ]
          },
          "752630305": {
            "id": "752630305",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "However! Our longtime fans will be aware that \"Raging Wind Nanasian\" wasn't the strongest racer to ever grace this track...",
            "nextDialogs": [
              "752630306"
            ]
          },
          "752630306": {
            "id": "752630306",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Before him, two absolute local legends ruled the scene. And today — they're back!",
            "nextDialogs": [
              "752630307"
            ]
          },
          "752630307": {
            "id": "752630307",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Welcome... \"Easy Come\"!",
            "nextDialogs": [
              "752630308"
            ]
          },
          "752630308": {
            "id": "752630308",
            "speakerId": 1004,
            "speakerName": "\"Easy Come\"",
            "text": "♪, ♩~~",
            "nextDialogs": [
              "752630309"
            ]
          },
          "752630309": {
            "id": "752630309",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "And... \"Easy Go\"!",
            "nextDialogs": [
              "752630310"
            ]
          },
          "752630310": {
            "id": "752630310",
            "speakerId": 1005,
            "speakerName": "\"Easy Go\"",
            "text": "♫, ♩~~",
            "nextDialogs": [
              "752630311"
            ]
          },
          "752630311": {
            "id": "752630311",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Challenger, these two are the real deal. Even with what we just saw from you... taking them down will be next to impossible.",
            "nextDialogs": [
              "752630312"
            ]
          },
          "752630312": {
            "id": "752630312",
            "speakerId": 1000,
            "speakerName": "Kinowa",
            "text": "Are you ready?",
            "nextDialogs": [
              "752630313"
            ]
          },
          "752630313": {
            "id": "752630313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready!",
            "nextDialogs": [
              "752630314"
            ]
          },
          "752630314": {
            "id": "752630314",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The staff mark out the course, and the crowd gathers around to watch. You take your place on the start line..."
          }
        }
      }
    },
    {
      "subId": "7526304",

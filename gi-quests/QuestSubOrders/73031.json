    {
      "subId": "7303103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730310301"
        ],
        "dialogs": {
          "730310301": {
            "id": "730310301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Araja, Arama, we're back!",
            "nextDialogs": [
              "730310302"
            ]
          },
          "730310302": {
            "id": "730310302",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#So happy to see Nara {NICKNAME} and Paimon again!",
            "nextDialogs": [
              "730310303"
            ]
          },
          "730310303": {
            "id": "730310303",
            "speakerId": 4184,
            "speakerName": "Araja",
            "text": "#Oh, you're back! Everyone was talking about how a very tall, very powerful Nara named {NICKNAME} helped them out a lot. They were all very happy.",
            "nextDialogs": [
              "730310304"
            ]
          },
          "730310304": {
            "id": "730310304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's always nice to have someone help you out, right, {NICKNAME}?",
            "nextDialogs": [
              "730310307"
            ]
          },
          "730310307": {
            "id": "730310307",
            "speakerId": 4184,
            "speakerName": "Araja",
            "text": "No, they're happy because they made new friends. Even if Aranakin, Aranaga, and Aragaru can't remember anymore, the forest will. The story will always live on.",
            "nextDialogs": [
              "730310308"
            ]
          },
          "730310308": {
            "id": "730310308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "730310309"
            ]
          },
          "730310309": {
            "id": "730310309",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Festival Utsava is almost ready to go. Can't wait!"
          }
        }
      }
    },
    {
      "subId": "7303106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730310601"
        ],
        "dialogs": {
          "730310601": {
            "id": "730310601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rana seems...",
            "nextDialogs": [
              "730310602"
            ]
          },
          "730310602": {
            "id": "730310602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon wants to say she's having a sweet dream, but that doesn't sound right...",
            "nextDialogs": [
              "730310603"
            ]
          },
          "730310603": {
            "id": "730310603",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "(A blurry image appears in the \"bubble\" that envelopes Rana.)",
            "nextDialogs": [
              "730310604"
            ]
          },
          "730310604": {
            "id": "730310604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(You are enthralled by the image.)",
            "nextDialogs": [
              "730310605"
            ]
          },
          "730310605": {
            "id": "730310605",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You are in a forest, where everything looks massive and serene. You feel very comfortable here.\\nRays of sunshine peek through the sparkling gold leaves, with grass as tall as you swaying quietly all around, gently caressing your hand as you walk by.",
            "nextDialogs": [
              "730310606"
            ]
          },
          "730310606": {
            "id": "730310606",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You hear the sound of distressed crying amid the musical melody of the wind blowing through the trees and flowing water. Following the sound, you find a small girl.\\nShe looks like she has worn herself out from crying and fallen asleep in the meadow. You walk up to her and softly sing a song that can calm all beings...",
            "nextDialogs": [
              "730310607"
            ]
          },
          "730310607": {
            "id": "730310607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#...Hey! What's going on, {NICKNAME}?",
            "nextDialogs": [
              "730310608"
            ]
          },
          "730310608": {
            "id": "730310608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's glad you're okay... Paimon was so worried... You looked like you were going to pass out...",
            "nextDialogs": [
              "730310609"
            ]
          },
          "730310609": {
            "id": "730310609",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "#Nara {NICKNAME}! You're all here!",
            "nextDialogs": [
              "730310610"
            ]
          },
          "730310610": {
            "id": "730310610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, you freaked Paimon out!",
            "nextDialogs": [
              "730310611"
            ]
          },
          "730310611": {
            "id": "730310611",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "Whoa!",
            "nextDialogs": [
              "730310614"
            ]
          },
          "730310614": {
            "id": "730310614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Geez, you Aranara! Why are you always spooking people like that!",
            "nextDialogs": [
              "730310615"
            ]
          },
          "730310615": {
            "id": "730310615",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "You said \"Whoa\" first, White Floaty!",
            "nextDialogs": [
              "730310616"
            ]
          },
          "730310616": {
            "id": "730310616",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's Paimon, not White Floaty!",
            "nextDialogs": [
              "730310617"
            ]
          },
          "730310617": {
            "id": "730310617",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "Arana was in the ground to preserve Ararakalari powers. This way, Narana won't wither. But Bija, still needed, for her to be strong again.",
            "nextDialogs": [
              "730310618"
            ]
          },
          "730310618": {
            "id": "730310618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Okay, Paimon got it. By the way, what just happened to {NICKNAME}?",
            "nextDialogs": [
              "730310619"
            ]
          },
          "730310619": {
            "id": "730310619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Explain the vision you saw.)",
            "nextDialogs": [
              "730310620"
            ]
          },
          "730310620": {
            "id": "730310620",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "That should be Arana's memory.",
            "nextDialogs": [
              "730310621"
            ]
          },
          "730310621": {
            "id": "730310621",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Memory?",
            "nextDialogs": [
              "730310622"
            ]
          },
          "730310622": {
            "id": "730310622",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "Oh, let Arana explain. Memories and dreams are Aranara's power, their most precious things. With memories and dreams, Aranara can use Ararakalari to help Nara and Aranara in need of help.",
            "nextDialogs": [
              "730310623"
            ]
          },
          "730310623": {
            "id": "730310623",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "#Some Nara can sense the memories in Ararakalari. Nara {NICKNAME} is one of them.",
            "nextDialogs": [
              "730310624"
            ]
          },
          "730310624": {
            "id": "730310624",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sounds like Ararakalari is something very important! It was you who used Ararakalari to protect Iotham in that cave, right?",
            "nextDialogs": [
              "730310625"
            ]
          },
          "730310625": {
            "id": "730310625",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "Yes, it was Arana. Nara Iotham, Nara Kavus, and Nara Sudabeh are all friends, so Arana protected them.",
            "nextDialogs": [
              "730310626"
            ]
          },
          "730310626": {
            "id": "730310626",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "We hang out in the forest a lot, so Arana taught them things about the forests and language of the plants. They're very good friends, just like Narana.",
            "nextDialogs": [
              "730310627"
            ]
          },
          "730310627": {
            "id": "730310627",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the missing kids...",
            "nextDialogs": [
              "730310628"
            ]
          },
          "730310628": {
            "id": "730310628",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right! Before Iotham, Kavus and Sudabeh went missing too, but they were brought back to the village later. Was that also you?",
            "nextDialogs": [
              "730310629"
            ]
          },
          "730310629": {
            "id": "730310629",
            "speakerId": 20597,
            "speakerName": "Arana",
            "text": "Yes. Arana noticed some bad Nara and Nara Valuka taking them, so Arana helped Nara Kavus and Nara Sudabeh run back when the bad Nara weren't looking."
          }
        }
      }
    },

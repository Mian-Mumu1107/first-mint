    {
      "subId": "7619603",
      "subQuestName": "Talk to Dorota",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960201"
        ],
        "dialogs": {
          "761960201": {
            "id": "761960201",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Dorota? What are you doing here?",
            "nextDialogs": [
              "761960202"
            ]
          },
          "761960202": {
            "id": "761960202",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "You couldn't have come at a better time, Linnea! I was just telling everyone about the wonders of Moonfall Silver.",
            "nextDialogs": [
              "761960203"
            ]
          },
          "761960203": {
            "id": "761960203",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Oh, Moonfall Silver, Moonfall Silver... is there any gem more perfect in the sublunary sphere?",
            "nextDialogs": [
              "761960204"
            ]
          },
          "761960204": {
            "id": "761960204",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Look! Its flawless form, its smooth, rounded texture! And that iridescent white paired with unrivaled elemental affinity!",
            "nextDialogs": [
              "761960205"
            ]
          },
          "761960205": {
            "id": "761960205",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "In my eyes, only the moon in the sky can compare to you!",
            "nextDialogs": [
              "761960206"
            ]
          },
          "761960206": {
            "id": "761960206",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Umm... yeah. Moonfall Silver is a beautiful ore. I've collected a few samples myself.",
            "nextDialogs": [
              "761960207"
            ]
          },
          "761960207": {
            "id": "761960207",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "See, I knew you'd understand!",
            "nextDialogs": [
              "761960208"
            ]
          },
          "761960208": {
            "id": "761960208",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "But still, no one understands Moonfall Silver better than I do! Even if you're an advisor to the Adventurers' Guild, I'm not giving up first place that easily. Hehe.",
            "nextDialogs": [
              "761960209"
            ]
          },
          "761960209": {
            "id": "761960209",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Right! And since you're usually the one teaching adventurers, how about I test you for a change?",
            "nextDialogs": [
              "761960210"
            ]
          },
          "761960210": {
            "id": "761960210",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "I have three pieces of Moonfall Silver here. Sadly, two of them have minor flaws. The last one, though, that's my prized treasure. The Moonfall Silver among Moonfall Silvers!",
            "nextDialogs": [
              "761960211"
            ]
          },
          "761960211": {
            "id": "761960211",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Can you tell which one is the most perfect?",
            "nextDialogs": [
              "761960212"
            ]
          },
          "761960212": {
            "id": "761960212",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Let me see...",
            "nextDialogs": [
              "761960213"
            ]
          },
          "761960213": {
            "id": "761960213",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "The one on the left...",
            "nextDialogs": [
              "761960214"
            ]
          },
          "761960214": {
            "id": "761960214",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "(Hmm? What is Lumi doing?)",
            "nextDialogs": [
              "761960215"
            ]
          },
          "761960215": {
            "id": "761960215",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "I'll go with this one!",
            "nextDialogs": [
              "761960216"
            ]
          },
          "761960216": {
            "id": "761960216",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Haha, looks like even you can misjudge sometimes, Linnea. This one actually has a tiny flaw hidden in a very inconspicuous spot.",
            "nextDialogs": [
              "761960217"
            ]
          },
          "761960217": {
            "id": "761960217",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Okay, you got me. But next time, I'm not going down that easily!",
            "nextDialogs": [
              "761960218"
            ]
          },
          "761960218": {
            "id": "761960218",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Fine by me. I'm always ready!",
            "nextDialogs": [
              "761960232"
            ]
          },
          "761960232": {
            "id": "761960232",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Linnea ends up taking part in Dorota's Moonfall Silver Appreciation Event, and had a really lovely time...",
            "nextDialogs": [
              "761960219"
            ]
          },
          "761960219": {
            "id": "761960219",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Wow, didn't expect everyone to be so enthusiastic. It's a shame moments like this never seem to last... Alright, time to pack up and head back.",
            "nextDialogs": [
              "761960233"
            ]
          },
          "761960233": {
            "id": "761960233",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Let me help you.",
            "nextDialogs": [
              "761960234"
            ]
          },
          "761960234": {
            "id": "761960234",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Oh, that'd be nice! Thanks!"
          }
        }
      }
    },
    {
      "subId": "7619606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960601"
        ],
        "dialogs": {
          "761960601": {
            "id": "761960601",
            "speakerId": 1003,
            "speakerName": "Moonfall Silver Appreciation Event",
            "text": "\"If you've ever been captivated by the iridescent glow of Moonfall Silver, join us and become a member of the Moonfall Silver Appreciation Society!\""
          }
        }
      }
    },
    {
      "subId": "7619604",
      "subQuestName": "Reclaim the Moonfall Silver used for exhibition",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960401"
        ],
        "dialogs": {
          "761960401": {
            "id": "761960401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(There seems to be something nearby worth examining. <color=#FFCC33FF>Linnea</color>, with her deep knowledge of the local ecology, might find something useful...)"
          }
        }
      }
    },
    {
      "subId": "7619605",
      "subQuestName": "Talk to Dorota",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960301"
        ],
        "dialogs": {
          "761960301": {
            "id": "761960301",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Whew... we didn't miss any, right?",
            "nextDialogs": [
              "761960302"
            ]
          },
          "761960302": {
            "id": "761960302",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Hmm... nope, everything's just right!",
            "nextDialogs": [
              "761960303"
            ]
          },
          "761960303": {
            "id": "761960303",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "I saw you making those fun patterns on the ground with Moonfall Silver.",
            "nextDialogs": [
              "761960304"
            ]
          },
          "761960304": {
            "id": "761960304",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Yeah! It took quite a bit of effort, but I think it really helped to spark everyone's love for the Moonfall Silver.",
            "nextDialogs": [
              "761960305"
            ]
          },
          "761960305": {
            "id": "761960305",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Speaking of which, I heard that there's a folk tale from Natlan...",
            "nextDialogs": [
              "761960306"
            ]
          },
          "761960306": {
            "id": "761960306",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "It's about a girl who originally lived among the stars. When she fell to the earth, she left huge drawings on the ground in her effort to return to the sky.",
            "nextDialogs": [
              "761960307"
            ]
          },
          "761960307": {
            "id": "761960307",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "In the end, her father, the sun up in the heavens, saw her request and brought her back.",
            "nextDialogs": [
              "761960308"
            ]
          },
          "761960308": {
            "id": "761960308",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Maybe he'd see the patterns you made and become a fan of Moonfall Silver too!",
            "nextDialogs": [
              "761960309"
            ]
          },
          "761960309": {
            "id": "761960309",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Haha, if that's the case, then I'd be the ultimate Moonfall Silver ambassador!",
            "nextDialogs": [
              "761960310"
            ]
          },
          "761960310": {
            "id": "761960310",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "But compared to that, I'm still more worried about getting noticed by birds from above. You know, crows and all, they really like shiny things too.",
            "nextDialogs": [
              "761960311"
            ]
          },
          "761960311": {
            "id": "761960311",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "True. And besides crows, we've also got to watch out for Sniffer Moles and Weasel Thieves on the ground.",
            "nextDialogs": [
              "761960312"
            ]
          },
          "761960312": {
            "id": "761960312",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "And Lumi too!",
            "nextDialogs": [
              "761960313"
            ]
          },
          "761960313": {
            "id": "761960313",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Haha, right! And Lumi too!",
            "nextDialogs": [
              "761960314"
            ]
          },
          "761960314": {
            "id": "761960314",
            "speakerId": 1004,
            "speakerName": "Lumi",
            "text": "Ya-ho?",
            "nextDialogs": [
              "761960315"
            ]
          },
          "761960315": {
            "id": "761960315",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "Anyway, thanks for helping out earlier. Even though this is just a small portion of my collection... here, take them! Consider it a gift for Lumi.",
            "nextDialogs": [
              "761960316"
            ]
          },
          "761960316": {
            "id": "761960316",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "Hehe, today's a really lucky day, isn't it, Lumi?",
            "nextDialogs": [
              "761960317"
            ]
          },
          "761960317": {
            "id": "761960317",
            "speakerId": 1004,
            "speakerName": "Lumi",
            "text": "Ya-hoho!"
          }
        }
      }
    },
    {
      "subId": "7619605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761960501"
        ],
        "dialogs": {
          "761960501": {
            "id": "761960501",
            "speakerId": 1002,
            "speakerName": "Dorota",
            "text": "If they were crafted into artisanal pieces, wouldn't they be more of a hit...?"
          }
        }
      }
    }
  ]
}
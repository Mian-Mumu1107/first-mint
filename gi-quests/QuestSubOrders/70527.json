          "705270104": {
            "id": "705270104",
            "speakerId": 1002,
            "speakerName": "Nazafarin",
            "text": "Ah, by Lesser Lord Kusanali! Do you not recognize me anymore?",
            "nextDialogs": [
              "705270105"
            ]
          },
          "705270105": {
            "id": "705270105",
            "speakerId": 1002,
            "speakerName": "Nazafarin",
            "text": "Perhaps my presence is too weak, like a speck of dust that might be blown away by a gust at any time...",
            "nextDialogs": [
              "705270106"
            ]
          },
          "705270106": {
            "id": "705270106",
            "speakerId": 1002,
            "speakerName": "Nazafarin",
            "text": "But I, for my part, remember your great deed in helping me develop seasonings and inviting all and sundry to try them!"
          }
        }
      }
    },

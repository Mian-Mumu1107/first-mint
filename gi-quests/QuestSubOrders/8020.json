  "subQuests": [
    {
      "subId": "802008",
      "subQuestName": "Return to Vimara Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200101"
        ],
        "dialogs": {
          "80200101": {
            "id": "80200101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait a second... That person, it's... Dainsleif!",
            "nextDialogs": [
              "80200102"
            ]
          },
          "80200102": {
            "id": "80200102",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Ah, it's you two...",
            "nextDialogs": [
              "80200103"
            ]
          },
          "80200103": {
            "id": "80200103",
            "speakerId": 1002,
            "speakerName": "Atossa",
            "text": "Oh, a friend of yours?",
            "nextDialogs": [
              "80200104"
            ]
          },
          "80200104": {
            "id": "80200104",
            "speakerId": 1002,
            "speakerName": "Atossa",
            "text": "Well, I'll leave you all to it, then. I should head back to the village to check up on Chief Amadhiah and the others, anyway. See you later!",
            "nextDialogs": [
              "80200105"
            ]
          },
          "80200105": {
            "id": "80200105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yep! See you later, Atossa!",
            "nextDialogs": [
              "80200106"
            ]
          },
          "80200106": {
            "id": "80200106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why do you always have to pop up out of nowhere like that!? Is it your life's mission in life to jumpscare us or something?",
            "nextDialogs": [
              "80200107"
            ]
          },
          "80200107": {
            "id": "80200107",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "It's hardly personal... or intentional, for that matter. As long as you and I are both in pursuit of the Abyss Order, we're bound to cross paths.",
            "nextDialogs": [
              "80200108"
            ]
          },
          "80200108": {
            "id": "80200108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah, so you're here to investigate the Abyss Order, then! That would explain the monsters you were fighting just now...",
            "nextDialogs": [
              "80200109"
            ]
          },
          "80200109": {
            "id": "80200109",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Naturally. Hold on... Are you not here for the same purpose?",
            "nextDialogs": [
              "80200112"
            ]
          },
          "80200112": {
            "id": "80200112",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Hm, no matter. It may have taken you a while to catch on, but I'm sure you've also realized by now... That there's something strange about this place.",
            "nextDialogs": [
              "80200113"
            ]
          },
          "80200113": {
            "id": "80200113",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "The Abyss Order is most certainly planning something in this area... or worse, their plan could already be in motion.",
            "nextDialogs": [
              "80200114"
            ]
          },
          "80200114": {
            "id": "80200114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So you think the Abyss Order is behind the Hilichurl activity in the area?",
            "nextDialogs": [
              "80200115"
            ]
          },
          "80200115": {
            "id": "80200115",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "As things stand, I highly doubt that is their primary motive. I would imagine the increased Hilichurl activity is merely a byproduct of whatever it is they're really trying to accomplish.",
            "nextDialogs": [
              "80200116"
            ]
          },
          "80200116": {
            "id": "80200116",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Still, the Hilichurl activity is causing a lot of problems for the people here. We should stick around for a while and protect the village, don't you think?",
            "nextDialogs": [
              "80200117"
            ]
          },
          "80200117": {
            "id": "80200117",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "The best way to protect them is by figuring out what the Abyss Order is truly planning. That is how we prevent further tragedy."
          }
        }
      }
    },
    {
      "subId": "802009",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200122"
        ],
        "dialogs": {
          "80200122": {
            "id": "80200122",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You return to Vimara Village to gather intel based on what you've learned. You question the villagers until, eventually, the sky grows dark...",
            "nextDialogs": [
              "80200123"
            ]
          },
          "80200123": {
            "id": "80200123",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Ah, so that was the commission that brought you here to Vimara Village...",
            "nextDialogs": [
              "80200124"
            ]
          },
          "80200124": {
            "id": "80200124",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "\"Someone who seems to only exist in people's memories\"... That is indeed quite intriguing. I would agree that it's unlikely you have a simple missing person's case on your hands. However, any possible connection to the Abyss Order is still unclear.",
            "nextDialogs": [
              "80200125"
            ]
          },
          "80200125": {
            "id": "80200125",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "It appears all we have by way of clues is increased Hilichurl activity, and that is certainly not much to go off of.",
            "nextDialogs": [
              "80200128"
            ]
          },
          "80200128": {
            "id": "80200128",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Right! That mysterious voice {F#she}{M#he} heard in {F#her brother's}{M#his sister's} memory... The one who called himself a Sinner... Who is he?",
            "nextDialogs": [
              "80200129"
            ]
          },
          "80200129": {
            "id": "80200129",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...",
            "nextDialogs": [
              "80200130"
            ]
          },
          "80200130": {
            "id": "80200130",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "#{NICKNAME}, let me ask you this... Do you believe your sibling to have betrayed you?"
          }
        }
      }
    },
    {
      "subId": "802002",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200201"
        ],
        "dialogs": {
          "80200201": {
            "id": "80200201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, Dain? Hellooo... Dain! Why are you just zoning out over here?",
            "nextDialogs": [
              "80200202"
            ]
          },
          "80200202": {
            "id": "80200202",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...",
            "nextDialogs": [
              "80200203"
            ]
          },
          "80200203": {
            "id": "80200203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did something happen?",
            "nextDialogs": [
              "80200204"
            ]
          },
          "80200204": {
            "id": "80200204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong, Dain?",
            "nextDialogs": [
              "80200205"
            ]
          },
          "80200205": {
            "id": "80200205",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "The missing person from your commission... Could you describe them to me?",
            "nextDialogs": [
              "80200206"
            ]
          },
          "80200206": {
            "id": "80200206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, uh...",
            "nextDialogs": [
              "80200207"
            ]
          },
          "80200207": {
            "id": "80200207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Young guy, early twenties... Seriously, Dain... What's going on?",
            "nextDialogs": [
              "80200208"
            ]
          },
          "80200208": {
            "id": "80200208",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "There appear to be certain memories in my mind that weren't there before...",
            "nextDialogs": [
              "80200209"
            ]
          },
          "80200209": {
            "id": "80200209",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Memories... of him.",
            "nextDialogs": [
              "80200210"
            ]
          },
          "80200210": {
            "id": "80200210",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Maybe... Maybe we just talked too much about him yesterday, and you had a weird dream or something?",
            "nextDialogs": [
              "80200211"
            ]
          },
          "80200211": {
            "id": "80200211",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "No. It wasn't a dream. They're memories... memories that suddenly appeared in my mind after I woke up...",
            "nextDialogs": [
              "80200212"
            ]
          },
          "80200212": {
            "id": "80200212",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "And I'm certain I've never met this person before.",
            "nextDialogs": [
              "80200213"
            ]
          },
          "80200213": {
            "id": "80200213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, what exactly did you \"remember\"?",
            "nextDialogs": [
              "80200214"
            ]
          },
          "80200214": {
            "id": "80200214",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "I remember...",
            "nextDialogs": [
              "80200215"
            ]
          },
          "80200215": {
            "id": "80200215",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...Handing him the eye of the first Field Tiller.",
            "nextDialogs": [
              "80200216"
            ]
          },
          "80200216": {
            "id": "80200216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "!?",
            "nextDialogs": [
              "80200217"
            ]
          },
          "80200217": {
            "id": "80200217",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whaaaat!?",
            "nextDialogs": [
              "80200218"
            ]
          },
          "80200218": {
            "id": "80200218",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Okay, so this missing person definitely has something to do with the Abyss Order, then...",
            "nextDialogs": [
              "80200219"
            ]
          },
          "80200219": {
            "id": "80200219",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Indeed. And it appears he possesses the ability to \"implant\" memories into the minds of others.",
            "nextDialogs": [
              "80200220"
            ]
          },
          "80200220": {
            "id": "80200220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How is that even possible...",
            "nextDialogs": [
              "80200221"
            ]
          },
          "80200221": {
            "id": "80200221",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, then... All the memories the villagers have of him... Could they be fake too? Maybe they never knew him at all...",
            "nextDialogs": [
              "80200222"
            ]
          },
          "80200222": {
            "id": "80200222",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But why would he do something like that...",
            "nextDialogs": [
              "80200223"
            ]
          },
          "80200223": {
            "id": "80200223",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Whatever the Abyss Order is planning, an important truth has been revealed to us this morning...",
            "nextDialogs": [
              "80200224"
            ]
          },
          "80200224": {
            "id": "80200224",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What sort of truth?",
            "nextDialogs": [
              "80200225"
            ]
          },
          "80200225": {
            "id": "80200225",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "That their goal... is still to obtain the eye of the first Field Tiller. They haven't stopped searching for it.",
            "nextDialogs": [
              "80200226"
            ]
          },
          "80200226": {
            "id": "80200226",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "I am the only person who knows its location. Perhaps implanting that particular memory was an attempt to interfere with my mind in some way...",
            "nextDialogs": [
              "80200229"
            ]
          },
          "80200229": {
            "id": "80200229",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Your concerns are not entirely unfounded. I don't believe the Abyss Order is capable of altering reality like that just yet...",
            "nextDialogs": [
              "80200230"
            ]
          },
          "80200230": {
            "id": "80200230",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "However, considering their single-minded pursuit of the eye, I would say an equal level of caution is in order on our part.",
            "nextDialogs": [
              "80200231"
            ]
          },
          "80200231": {
            "id": "80200231",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Come with me. We must check whether the eye is still in our possession.",
            "nextDialogs": [
              "80200232"
            ]
          },
          "80200232": {
            "id": "80200232",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, so you're going to take us to where you hid it?",
            "nextDialogs": [
              "80200233"
            ]
          },
          "80200233": {
            "id": "80200233",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...But, what if someone follows us? If we go straight there, and someone is on our tail, aren't we just exposing the eye's location?)",
            "nextDialogs": [
              "80200234"
            ]
          },
          "80200234": {
            "id": "80200234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Maybe that's the reason the Abyss Order implanted that memory in the first place... To force Dain to confirm the eye's location...)",
            "nextDialogs": [
              "80200235"
            ]
          },
          "80200235": {
            "id": "80200235",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...",
            "nextDialogs": [
              "80200236"
            ]
          },
          "80200236": {
            "id": "80200236",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Given what I know of him, though, I'm sure Dain has already thought of that possibility... It seems like he might already have a plan...)"
          }
        }
      }
    },
    {
      "subId": "802003",
      "subQuestName": "Go to the place where the \"Field Tiller's Eye\" is hidden",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200301"
        ],
        "dialogs": {
          "80200301": {
            "id": "80200301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So you hid it way out here! Not an easy place to discover, that's for sure.",
            "nextDialogs": [
              "80200302"
            ]
          },
          "80200302": {
            "id": "80200302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, let's go check to see if it's safe!",
            "nextDialogs": [
              "80200303"
            ]
          },
          "80200303": {
            "id": "80200303",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "#{NICKNAME}, wait...",
            "nextDialogs": [
              "80200304"
            ]
          },
          "80200304": {
            "id": "80200304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hm?",
            "nextDialogs": [
              "80200305"
            ]
          },
          "80200305": {
            "id": "80200305",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...",
            "nextDialogs": [
              "80200306"
            ]
          },
          "80200306": {
            "id": "80200306",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...We've no time to lose. Let's head inside.",
            "nextDialogs": [
              "80200307"
            ]
          },
          "80200307": {
            "id": "80200307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(What was Dain going to tell me just now...)",
            "nextDialogs": [
              "80200308"
            ]
          },
          "80200308": {
            "id": "80200308",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, wait up!"
          }
        }
      }
    },

    {
      "subId": "802010",
      "subQuestName": "Enter the depths of the ruin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200501"
        ],
        "dialogs": {
          "80200501": {
            "id": "80200501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like we can't go any further...",
            "nextDialogs": [
              "80200502"
            ]
          },
          "80200502": {
            "id": "80200502",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Be on your guard. I sense the presence of the Abyss!",
            "nextDialogs": [
              "80200503"
            ]
          },
          "80200503": {
            "id": "80200503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's the Abyss Order! They're here!"
          }
        }
      }
    },
    {
      "subId": "802005",
      "subQuestName": "Defeat the Abyss Herald",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "802006",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200601"
        ],
        "dialogs": {
          "80200601": {
            "id": "80200601",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Just as I suspected... The false memories were a trap. The Abyss Order just wanted to follow us here...",
            "nextDialogs": [
              "80200602"
            ]
          },
          "80200602": {
            "id": "80200602",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Now that they're in the vicinity, we should have a chance to see...",
            "nextDialogs": [
              "80200603"
            ]
          },
          "80200603": {
            "id": "80200603",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Argh...!",
            "nextDialogs": [
              "80200604"
            ]
          },
          "80200604": {
            "id": "80200604",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Dain? What's wrong?",
            "nextDialogs": [
              "80200605"
            ]
          },
          "80200605": {
            "id": "80200605",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Can you feel that? There's been a disturbance in the Ley Lines. It must be the work of the Abyss...",
            "nextDialogs": [
              "80200606"
            ]
          },
          "80200606": {
            "id": "80200606",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, you must be really sensitive to that sort of thing. Paimon doesn't feel it...",
            "nextDialogs": [
              "80200607"
            ]
          },
          "80200607": {
            "id": "80200607",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "You two, do as I say... Use that mechanism over there and leave this place.",
            "nextDialogs": [
              "80200608"
            ]
          },
          "80200608": {
            "id": "80200608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave you here on your own? Will you be alright?",
            "nextDialogs": [
              "80200609"
            ]
          },
          "80200609": {
            "id": "80200609",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "The Abyss Order is putting something in motion. If you return to Vimara Village, I suspect you might finally have the opportunity to locate the missing villager.",
            "nextDialogs": [
              "80200610"
            ]
          },
          "80200610": {
            "id": "80200610",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...Just think of it as a way to divide and conquer.",
            "nextDialogs": [
              "80200611"
            ]
          },
          "80200611": {
            "id": "80200611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright.",
            "nextDialogs": [
              "80200612"
            ]
          },
          "80200612": {
            "id": "80200612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Dain does have a point...)",
            "nextDialogs": [
              "80200613"
            ]
          },
          "80200613": {
            "id": "80200613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(But, something still feels off... What am I missing...?)",
            "nextDialogs": [
              "80200614"
            ]
          },
          "80200614": {
            "id": "80200614",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Hmph... I knew going along with your trap would be the only way to meet with you face to face.",
            "nextDialogs": [
              "80200615"
            ]
          },
          "80200615": {
            "id": "80200615",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "You risked your safety and that of the eye...",
            "nextDialogs": [
              "80200616"
            ]
          },
          "80200616": {
            "id": "80200616",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "That's quite the gamble, Dainsleif... But I believe that I am the one walking into a trap laid by the Twilight Sword.",
            "nextDialogs": [
              "80200617"
            ]
          },
          "80200617": {
            "id": "80200617",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "So you came here all on your own? What about those followers of yours?",
            "nextDialogs": [
              "80200618"
            ]
          },
          "80200618": {
            "id": "80200618",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "When the Twilight Sword is prepared for battle, any army I could send would only be marching to their doom... Better that I face you alone.",
            "nextDialogs": [
              "80200619"
            ]
          },
          "80200619": {
            "id": "80200619",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "I know you must have a lot to say...",
            "nextDialogs": [
              "80200620"
            ]
          },
          "80200620": {
            "id": "80200620",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "...But, if it's a conversation you want, you'll have to defeat me first."
          }
        }
      }

    {
      "subId": "7281306",
      "subQuestName": "Go with Gorou to investigate the suspicious person",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130501"
        ],
        "dialogs": {
          "728130501": {
            "id": "728130501",
            "speakerId": 1004,
            "speakerName": "Hiroyuki",
            "text": "Stay right there and don't move!",
            "nextDialogs": [
              "728130502"
            ]
          },
          "728130502": {
            "id": "728130502",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "I—I'm not moving! You asked me to explain, and I explained that I'm really a researcher from the Akademiya!",
            "nextDialogs": [
              "728130503"
            ]
          },
          "728130503": {
            "id": "728130503",
            "speakerId": 1004,
            "speakerName": "Hiroyuki",
            "text": "Didn't you say that you're advertising fertilizer?",
            "nextDialogs": [
              "728130504"
            ]
          },
          "728130504": {
            "id": "728130504",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "I... Can't a researcher from the Akademiya also advertise for fertilizers? Just... Just listen to me for a moment, will you...",
            "nextDialogs": [
              "728130505"
            ]
          },
          "728130505": {
            "id": "728130505",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Is this the person?",
            "nextDialogs": [
              "728130506"
            ]
          },
          "728130506": {
            "id": "728130506",
            "speakerId": 1003,
            "speakerName": "Ookubo Daisuke",
            "text": "Yes, sir.",
            "nextDialogs": [
              "728130507"
            ]
          },
          "728130507": {
            "id": "728130507",
            "speakerId": 1003,
            "speakerName": "Ookubo Daisuke",
            "text": "When we caught her, she was sneaking around the place and wouldn't stop writing certain things down.",
            "nextDialogs": [
              "728130508"
            ]
          },
          "728130508": {
            "id": "728130508",
            "speakerId": 1003,
            "speakerName": "Ookubo Daisuke",
            "text": "General, I'm positive that she's a Shogunate spy!",
            "nextDialogs": [
              "728130509"
            ]
          },
          "728130509": {
            "id": "728130509",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "I'm not! And I wasn't! I already told you, I'm a researcher! I was just collecting material for my thesis!",
            "nextDialogs": [
              "728130510"
            ]
          },
          "728130510": {
            "id": "728130510",
            "speakerId": 1004,
            "speakerName": "Hiroyuki",
            "text": "Cut the crap! Do you seriously expect us to believe that you'd walk into a battlefield over a thesis? You're definitely playing at something else!",
            "nextDialogs": [
              "728130511"
            ]
          },
          "728130511": {
            "id": "728130511",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "...What could I really dare to play at other than my thesis anyway...",
            "nextDialogs": [
              "728130514"
            ]
          },
          "728130514": {
            "id": "728130514",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Traveler! Oh, this is wonderful! Please tell them I'm not a bad person! I'm just here to write my thesis!",
            "nextDialogs": [
              "728130515"
            ]
          },
          "728130515": {
            "id": "728130515",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "You know her?",
            "nextDialogs": [
              "728130516"
            ]
          },
          "728130516": {
            "id": "728130516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, you could say that...",
            "nextDialogs": [
              "728130517"
            ]
          },
          "728130517": {
            "id": "728130517",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Does \"graduating\" really drive researchers from Sumeru this far up the wall...",
            "nextDialogs": [
              "728130518"
            ]
          },
          "728130518": {
            "id": "728130518",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "But given what you've said, you're only acquaintances at best.",
            "nextDialogs": [
              "728130519"
            ]
          },
          "728130519": {
            "id": "728130519",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "And as for her status as a \"researcher from Sumeru,\" that's something you only heard from her, isn't it?",
            "nextDialogs": [
              "728130520"
            ]
          },
          "728130520": {
            "id": "728130520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's correct.",
            "nextDialogs": [
              "728130521"
            ]
          },
          "728130521": {
            "id": "728130521",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Hmm... I'm afraid that none of the evidence here is conclusive.",
            "nextDialogs": [
              "728130522"
            ]
          },
          "728130522": {
            "id": "728130522",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "But if she's got your guarantee, I'd wager that she isn't a bad person...",
            "nextDialogs": [
              "728130523"
            ]
          },
          "728130523": {
            "id": "728130523",
            "speakerId": 1003,
            "speakerName": "Ookubo Daisuke",
            "text": "General, if I may make a suggestion?",
            "nextDialogs": [
              "728130524"
            ]
          },
          "728130524": {
            "id": "728130524",
            "speakerId": 1003,
            "speakerName": "Ookubo Daisuke",
            "text": "Do you remember Kaushik? That researcher who's been studying our island's culture and history?",
            "nextDialogs": [
              "728130525"
            ]
          },
          "728130525": {
            "id": "728130525",
            "speakerId": 1003,
            "speakerName": "Ookubo Daisuke",
            "text": "He's been here all this while, and his credentials are quite solid... Why don't we ask him to tell if this... fertilizer saleswoman is actually a researcher or not?",
            "nextDialogs": [
              "728130526"
            ]
          },
          "728130526": {
            "id": "728130526",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "That actually sounds like a decent plan. Traveler, could we trouble you to bring Kaushik here?",
            "nextDialogs": [
              "728130527"
            ]
          },
          "728130527": {
            "id": "728130527",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Just in case of any incidents, I'll stay here and guard this... fertilizer saleswoman.",
            "nextDialogs": [
              "728130528"
            ]
          },
          "728130528": {
            "id": "728130528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright.",
            "nextDialogs": [
              "728130529"
            ]
          },
          "728130529": {
            "id": "728130529",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "It's up to you then. Come back as quickly as possible."
          }
        }
      }
    },
    {
      "subId": "7281307",
      "subQuestName": "Find Kaushik",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130701"
        ],
        "dialogs": {
          "728130701": {
            "id": "728130701",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "The meaning of this totem... Hmm? Traveler? Did you have some business with me?",
            "nextDialogs": [
              "728130702"
            ]
          },
          "728130702": {
            "id": "728130702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is about Alrani...",
            "nextDialogs": [
              "728130703"
            ]
          },
          "728130703": {
            "id": "728130703",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "Alrani's here? On Watatsumi Island? That's... odd. What's that girl doing here? Shouldn't she be in Liyue?",
            "nextDialogs": [
              "728130704"
            ]
          },
          "728130704": {
            "id": "728130704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She was arrested by some soldiers...",
            "nextDialogs": [
              "728130705"
            ]
          },
          "728130705": {
            "id": "728130705",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "What? *sigh* Of course. Coming to Watatsumi Island under the present circumstances... Of course they would suspect her.",
            "nextDialogs": [
              "728130706"
            ]
          },
          "728130706": {
            "id": "728130706",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "Never mind that for now. Let's head over and help that reckless girl out..."
          }
        }
      }
    },
    {
      "subId": "7281308",
      "subQuestName": "Talk to Kaushik",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7281309",
      "subQuestName": "Take Kaushik and report back to Gorou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130801"
        ],
        "dialogs": {
          "728130801": {
            "id": "728130801",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "Alrani! It really is you! B—But why are you here in Inazuma? Weren't you supposed to be in Liyue?",
            "nextDialogs": [
              "728130802"
            ]
          },
          "728130802": {
            "id": "728130802",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "This... Oh, this is going to be long story, isn't it...",
            "nextDialogs": [
              "728130803"
            ]
          },
          "728130803": {
            "id": "728130803",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Mr. Kaushik, you know Alrani?",
            "nextDialogs": [
              "728130804"
            ]
          },
          "728130804": {
            "id": "728130804",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "Oh, you... you're General Gorou, aren't you?",
            "nextDialogs": [
              "728130805"
            ]
          },
          "728130805": {
            "id": "728130805",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "You surmise correctly. Alrani and I are both researchers from the Akademiya.",
            "nextDialogs": [
              "728130806"
            ]
          },
          "728130806": {
            "id": "728130806",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "After that, we left the Akademiya to conduct fieldwork for our own areas of research. I didn't think that I'd meet her here...",
            "nextDialogs": [
              "728130807"
            ]
          },
          "728130807": {
            "id": "728130807",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "But... Um, can you researchers just freely leave the Akademiya?",
            "nextDialogs": [
              "728130808"
            ]
          },
          "728130808": {
            "id": "728130808",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "I wouldn't call it \"leaving freely.\" Alrani and I are both Driyosh.",
            "nextDialogs": [
              "728130809"
            ]
          },
          "728130809": {
            "id": "728130809",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "To us, wandering and learning are part of our research process, and as such, we are permitted to leave the Akademiya.",
            "nextDialogs": [
              "728130810"
            ]
          },
          "728130810": {
            "id": "728130810",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "General Gorou, I can guarantee that Alrani is telling the truth...",
            "nextDialogs": [
              "728130811"
            ]
          },
          "728130811": {
            "id": "728130811",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Alright, then there's no problem.",
            "nextDialogs": [
              "728130812"
            ]
          },
          "728130812": {
            "id": "728130812",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Phew... I'm saved... Thank you so much...",
            "nextDialogs": [
              "728130813"
            ]
          },
          "728130813": {
            "id": "728130813",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Hiroyuki, Ookubo, this matter is settled. Go attend to your own duties.",
            "nextDialogs": [
              "728130814"
            ]
          },
          "728130814": {
            "id": "728130814",
            "speakerId": 1004,
            "speakerName": "Hiroyuki",
            "text": "Yes, sir.",
            "nextDialogs": [
              "728130815"
            ]
          },
          "728130815": {
            "id": "728130815",
            "speakerId": 1003,
            "speakerName": "Ookubo Daisuke",
            "text": "Yes, sir.",
            "nextDialogs": [
              "728130816"
            ]
          },
          "728130816": {
            "id": "728130816",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "I'm sorry, Miss Alrani. We mistook you for someone suspicious.",
            "nextDialogs": [
              "728130817"
            ]
          },
          "728130817": {
            "id": "728130817",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "That said, while we have cleared your name, your barging into Watatsumi Island like this has made no shortage of trouble for us.",
            "nextDialogs": [
              "728130818"
            ]
          },
          "728130818": {
            "id": "728130818",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Eh? Are... Are you going to fine me? I—I don't have very much Mora on me...",
            "nextDialogs": [
              "728130819"
            ]
          },
          "728130819": {
            "id": "728130819",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Well, since you did claim to be a fertilizer salesperson earlier, and you're a researcher to boot...",
            "nextDialogs": [
              "728130820"
            ]
          },
          "728130820": {
            "id": "728130820",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "Well, there is something you can do for us. We have a man named Iwata living here who's researching fertilizer. Miss Alrani, please lend him a hand.",
            "nextDialogs": [
              "728130821"
            ]
          },
          "728130821": {
            "id": "728130821",
            "speakerId": 1001,
            "speakerName": "Gorou",
            "text": "If you can help him produce some fertilizer that isn't also a public disturbance, then you're free to do research here, just like Mr. Kaushik.",
            "nextDialogs": [
              "728130822"
            ]
          },
          "728130822": {
            "id": "728130822",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "F—Fertilizer? Wait, I... I'm just...",
            "nextDialogs": [
              "728130825"
            ]
          },
          "728130825": {
            "id": "728130825",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "Alrani, this is a good opportunity to collect research material. Since you're here in Inazuma, that must mean that your thesis is still...",
            "nextDialogs": [
              "728130826"
            ]
          },
          "728130826": {
            "id": "728130826",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Uh... Ugh...",
            "nextDialogs": [
              "728130827"
            ]
          },
          "728130827": {
            "id": "728130827",
            "speakerId": 1006,
            "speakerName": "Kaushik",
            "text": "You know what the standards for graduation are at the Akademiya. If you can't graduate several years in a row...",
            "nextDialogs": [
              "728130828"
            ]
          },
          "728130828": {
            "id": "728130828",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "I—I'll do it! I'll do it, alright?",
            "nextDialogs": [
              "728130829"
            ]
          },
          "728130829": {
            "id": "728130829",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "I—I've learned about the fertilizer at Mr. Vahid's... I'll get this done in one go, just you all watch!"
          }
        }
      }
    },
    {
      "subId": "7281310",
      "subQuestName": "Go with Alrani to look for Iwata",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130901"
        ],
        "dialogs": {
          "728130901": {
            "id": "728130901",
            "speakerId": 1000,
            "speakerName": "Iwata",
            "text": "Traveler, you're back. I've disposed of that pile of fertilizer.",
            "nextDialogs": [
              "728130902"
            ]
          },
          "728130902": {
            "id": "728130902",
            "speakerId": 1000,
            "speakerName": "Iwata",
            "text": "*sigh* I suppose I'll have to find another place to conduct my experiments...",
            "nextDialogs": [
              "728130903"
            ]
          },
          "728130903": {
            "id": "728130903",
            "speakerId": 1000,
            "speakerName": "Iwata",
            "text": "Hmm? This person is...",
            "nextDialogs": [
              "728130905",
              "728130907"
            ]
          },
          "728130905": {
            "id": "728130905",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Hello, I'm Alrani...",
            "nextDialogs": [
              "728130909"
            ]
          },
          "728130909": {
            "id": "728130909",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Well, either way... The general they called Gorou requested that I assist you with your fertilizer research.",
            "nextDialogs": [
              "728130910"
            ]
          },
          "728130910": {
            "id": "728130910",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "It's a pleasure to be working with you from now on.",
            "nextDialogs": [
              "728130911"
            ]
          },
          "728130911": {
            "id": "728130911",
            "speakerId": 1000,
            "speakerName": "Iwata",
            "text": "Is that so... That's great! If we succeed, then we'll be able to plant more crops here on Watatsumi Island!",
            "nextDialogs": [
              "728130912"
            ]
          },
          "728130912": {
            "id": "728130912",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do remember to pile the fertilizer further away.",
            "nextDialogs": [
              "728130913"
            ]
          },
          "728130913": {
            "id": "728130913",
            "speakerId": 1000,
            "speakerName": "Iwata",
            "text": "Eh? Oh! Oh, I get it.",
            "nextDialogs": [
              "728130914"
            ]
          },
          "728130914": {
            "id": "728130914",
            "speakerId": 1000,
            "speakerName": "Iwata",
            "text": "Yes, the pleasure is all mine, Miss Alrani!",
            "nextDialogs": [
              "728130915"
            ]
          },
          "728130915": {
            "id": "728130915",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Yeah, I'll do my best.",
            "nextDialogs": [
              "728130916"
            ]
          },
          "728130916": {
            "id": "728130916",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "I'll do my best. This is for my thesis..."
          },
          "728130907": {
            "id": "728130907",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "Hello there, I'm Alrani... Wait a moment. A fertilizer specialist?",
            "nextDialogs": [
              "728130908"
            ]
          },
          "728130908": {
            "id": "728130908",
            "speakerId": 1005,
            "speakerName": "Alrani",
            "text": "I... I just learned a little about them."
          }
        }
      }
    },
    {

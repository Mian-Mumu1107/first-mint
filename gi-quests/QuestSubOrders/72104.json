    {
      "subId": "7210423",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721043801"
        ],
        "dialogs": {
          "721043801": {
            "id": "721043801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ms. Gendou, you seem to be in a good mood today.",
            "nextDialogs": [
              "721043802"
            ]
          },
          "721043802": {
            "id": "721043802",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Hmm? What is it?",
            "nextDialogs": [
              "721043803"
            ]
          },
          "721043803": {
            "id": "721043803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You don't seem like your usual self...",
            "nextDialogs": [
              "721043804"
            ]
          },
          "721043804": {
            "id": "721043804",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Oh? You think so? I'll take note of it.",
            "nextDialogs": [
              "721043805"
            ]
          },
          "721043805": {
            "id": "721043805",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Maybe I'm just in a great mood today... I mean, I just drew a \"Great Fortune\" slip and all! Just wanted to pay it forward, you know?",
            "nextDialogs": [
              "721043806"
            ]
          },
          "721043806": {
            "id": "721043806",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Still, what some call \"Great Fortune\" might be \"Great Misfortune\" for others.",
            "nextDialogs": [
              "721043807"
            ]
          },
          "721043807": {
            "id": "721043807",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "For those who receive \"great misfortune\"... I wonder, what awaits them at the Fortune Slip Hanger?",
            "nextDialogs": [
              "721043808"
            ]
          },
          "721043808": {
            "id": "721043808",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, fortunes are so very interesting! See you later."
          }
        }
      }
    },

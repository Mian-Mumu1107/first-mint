        ],
        "dialogs": {
          "762009901": {
            "id": "762009901",
            "speakerId": 1005,
            "speakerName": "Faint Voice",
            "text": "Meow...",
            "nextDialogs": [
              "762009902"
            ]
          },
          "762009902": {
            "id": "762009902",
            "speakerId": 1000,
            "speakerName": "Linnea",
            "text": "(Hmm? Looks like there's something over there...)",
            "nextDialogs": [
              "762009903"
            ]
          },
          "762009903": {
            "id": "762009903",
            "speakerId": 1003,
            "speakerName": "Marja",
            "text": "Silly cat!",
            "nextDialogs": [
              "762009904"
            ]
          },
          "762009904": {
            "id": "762009904",
            "speakerId": 1003,
            "speakerName": "Marja",
            "text": "You hear me!?"
          }
        }
      }
    }

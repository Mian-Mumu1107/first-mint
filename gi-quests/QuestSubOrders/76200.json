          }
        }
      }
    },
    {
      "subId": "7620009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762000901"
        ],
        "dialogs": {
          "762000901": {
            "id": "762000901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(There seems to be something nearby worth examining. <color=#FFCC33FF>Linnea</color>, with her deep knowledge of the local ecology, might find something useful...)"
          }
        }
      }
    },
    {
      "subId": "7620013",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762001301"
        ],
        "dialogs": {
          "762001301": {
            "id": "762001301",
            "speakerId": 1003,
            "speakerName": "Marja",
            "text": "Hey! You silly cat! Can you hear me!? If you can, come out right now!",
            "nextDialogs": [
              "762001302"
            ]
          },
          "762001302": {
            "id": "762001302",
            "speakerId": 1003,
            "speakerName": "Marja",
            "text": "If you don't, we're leaving without you!"
          }
        }
      }
    },
    {
      "subId": "7620014",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

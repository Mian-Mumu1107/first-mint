            "speakerId": 1003,
            "speakerName": "Marja",
            "text": "You silly cat... where did you wander off to...?",
            "nextDialogs": [
              "762000402"
            ]
          },
          "762000402": {
            "id": "762000402",
            "speakerId": 1001,
            "speakerName": "Jukka",
            "text": "Let's keep looking around."

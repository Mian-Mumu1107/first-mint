  "subQuests": [
    {
      "subId": "35301",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3532801"
        ],
        "dialogs": {
          "3532801": {
            "id": "3532801",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ooh! Did you just feel the elements of the world?",
            "nextDialogs": [
              "3532802"
            ]
          },
          "3532802": {
            "id": "3532802",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Seems all you had to do was just touch the statue and you got the power of Anemo!",
            "nextDialogs": [
              "3532803"
            ]
          },
          "3532803": {
            "id": "3532803",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "As much as they may want it, people in this world can never get a hold of powers as easily as you...",
            "nextDialogs": [
              "3532805",
              "3532808"
            ]
          },
          "3532805": {
            "id": "3532805",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah-ha, it's because you're not from this world to begin with.",
            "nextDialogs": [
              "3532809"
            ]
          },
          "3532809": {
            "id": "3532809",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If we keep heading west from here, we'll eventually reach Mondstadt, the City of Freedom.",
            "nextDialogs": [
              "3532817"
            ]
          },
          "3532817": {
            "id": "3532817",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Mondstadt is the city of wind, because they worship the God of Anemo.",
            "nextDialogs": [
              "3532810"
            ]
          },
          "3532810": {
            "id": "3532810",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So perhaps, because you got power from the God of Anemo, you can find some clues there.",
            "nextDialogs": [
              "3532811"
            ]
          },
          "3532811": {
            "id": "3532811",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#There are also lots of bards there, so perhaps one of them has heard news of your {M#sister}{F#brother}.",
            "nextDialogs": [
              "3532812"
            ]
          },
          "3532812": {
            "id": "3532812",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's move then!",
            "nextDialogs": [
              "3532813"
            ]
          },
          "3532813": {
            "id": "3532813",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The elements in this world responded to your prayers and Paimon thinks that's a lovely sign."
          },
          "3532808": {
            "id": "3532808",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's a bit rude to say that about the power the gods just gave you!"
          }
        }
      }
    },

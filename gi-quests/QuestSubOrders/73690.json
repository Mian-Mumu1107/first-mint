  "subQuests": [
    {
      "subId": "7369001",
      "subQuestName": "Talk to Daya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736900101"
        ],
        "dialogs": {
          "736900101": {
            "id": "736900101",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Hello there! I'm Daya from Kshahrewar. Are you here to take part in the Wisdom Gala too?",
            "nextDialogs": [
              "736900102"
            ]
          },
          "736900102": {
            "id": "736900102",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "This is the new game that our Darshan has put forth: \"Project Connectivity\"!",
            "nextDialogs": [
              "736900103"
            ]
          },
          "736900103": {
            "id": "736900103",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Would you like to have a go at it?",
            "nextDialogs": [
              "736900104"
            ]
          },
          "736900104": {
            "id": "736900104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If I recall, Kshahrewar's specialty is...",
            "nextDialogs": [
              "736900105"
            ]
          },
          "736900105": {
            "id": "736900105",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "We study mechanics and architecture, yes.",
            "nextDialogs": [
              "736900107"
            ]
          },
          "736900107": {
            "id": "736900107",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Uh, seems like I've gone off-topic. So, to take part in this Gala, many of our students put their heads together...",
            "nextDialogs": [
              "736900108"
            ]
          },
          "736900108": {
            "id": "736900108",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "...And the result was \"Project Connectivity!\"",
            "nextDialogs": [
              "736900109"
            ]
          },
          "736900109": {
            "id": "736900109",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Basically, players will need to use the various objects that we have prepared to... well, create a pathway.",
            "nextDialogs": [
              "736900110"
            ]
          },
          "736900110": {
            "id": "736900110",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Laying down bridges, setting up stairs... The eventual goal is to create a path for people to travel on that can reach its destination.",
            "nextDialogs": [
              "736900111"
            ]
          },
          "736900111": {
            "id": "736900111",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Once you have finished constructing that road, we will conduct a final verification, just like how we would test completed buildings.",
            "nextDialogs": [
              "736900112"
            ]
          },
          "736900112": {
            "id": "736900112",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Essentially, you just need to set up a safe road to attain success.",
            "nextDialogs": [
              "736900115"
            ]
          },
          "736900115": {
            "id": "736900115",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Don't worry, don't worry! You're not being asked to construct anything in real life.",
            "nextDialogs": [
              "736900116"
            ]
          },
          "736900116": {
            "id": "736900116",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "If something goes wrong and the road collapses, we'll just have to rebuild it. We're not putting limits on the number of tries you have either.",
            "nextDialogs": [
              "736900117"
            ]
          },
          "736900117": {
            "id": "736900117",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "Just let your imagination run free and build as beautiful as a road can be!"
          }
        }
      }
    },
    {
      "subId": "7369099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736909901"
        ],
        "dialogs": {
          "736909901": {
            "id": "736909901",
            "speakerId": 1000,
            "speakerName": "Daya",
            "text": "(If only building something in real life was this easy. *sigh*)"
          }
        }
      }
    }
  ]
}
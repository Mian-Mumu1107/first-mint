    {
      "subId": "2006116",
      "subQuestName": "Report back to Draff",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610901"
        ],
        "dialogs": {
          "200610901": {
            "id": "200610901",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Regarding these pigeons...",
            "nextDialogs": [
              "200610902"
            ]
          },
          "200610902": {
            "id": "200610902",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "The hilichurls have an insatiable appetite for avian messengers? Are you serious...",
            "nextDialogs": [
              "200610903"
            ]
          },
          "200610903": {
            "id": "200610903",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Well, I suppose they are getting plump, and would probably make a great pairing with a glass of jagerschnapps...",
            "nextDialogs": [
              "200610904"
            ]
          },
          "200610904": {
            "id": "200610904",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "...I mean, uh... Oh drats, now I have to raise a whole new flock of pigeons."
          }
        }
      }
    }
  ]
}
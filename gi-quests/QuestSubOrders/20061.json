  "subQuests": [
    {
      "subId": "2006101",
      "subQuestName": "Talk to Draff",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610101"
        ],
        "dialogs": {
          "200610101": {
            "id": "200610101",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Regarding these pigeons...",
            "nextDialogs": [
              "200610102"
            ]
          },
          "200610102": {
            "id": "200610102",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "They'd be more use to me roasted with a few wild mushrooms...",
            "nextDialogs": [
              "200610103"
            ]
          },
          "200610103": {
            "id": "200610103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "200610104"
            ]
          },
          "200610104": {
            "id": "200610104",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "I raised them as carrier pigeons, to deliver messages.",
            "nextDialogs": [
              "200610105"
            ]
          },
          "200610105": {
            "id": "200610105",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "But for some reason they are getting less and less reliable.",
            "nextDialogs": [
              "200610106"
            ]
          },
          "200610106": {
            "id": "200610106",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Either they lose the message or they glide around for hours but never actually deliver it. Or, they sit around the whole time just waiting for someone to chase them off.",
            "nextDialogs": [
              "200610111"
            ]
          },
          "200610111": {
            "id": "200610111",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "If you have time, maybe you could hurry along the pigeons I just released.",
            "nextDialogs": [
              "200610108",
              "200610110"
            ]
          },
          "200610108": {
            "id": "200610108",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Great. So if you see any of them slacking off, chase them away for me."
          },
          "200610110": {
            "id": "200610110",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Don't worry, it's not like pigeons to hold a grudge. Their memory is much too short for that.",
            "nextDialogs": [
              "200610112"
            ]
          },
          "200610112": {
            "id": "200610112",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "I never had you down as such a pigeon lover..."
          }
        }
      }
    },
    {
      "subId": "2006102",
      "subQuestName": "Look for pigeons in the woods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610201"
        ],
        "dialogs": {
          "200610201": {
            "id": "200610201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "These pigeons are such lazy slackers. Hurry them along, they need to learn to be good little pigeons and deliver those messages!"
          }
        }
      }
    },
    {
      "subId": "2006103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610301"
        ],
        "dialogs": {
          "200610301": {
            "id": "200610301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There! I doubt they'll be planning on slacking off again anytime soon..."
          }
        }
      }
    },
    {
      "subId": "2006104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610401"
        ],
        "dialogs": {
          "200610401": {
            "id": "200610401",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "Regarding these pigeons...",
            "nextDialogs": [
              "200610402"
            ]
          },
          "200610402": {
            "id": "200610402",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "Maybe now they'll deliver their messages without a fuss in future...",
            "nextDialogs": [
              "200610403"
            ]
          },
          "200610403": {
            "id": "200610403",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "But I can't exactly follow them and check... Anyway, that'll do for now.",
            "nextDialogs": [
              "200610404"
            ]
          },
          "200610404": {
            "id": "200610404",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "For your trouble, please take this. And if you ever need to send a message, just come and find me."
          }
        }
      }
    },
    {
      "subId": "2006105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610501"
        ],
        "dialogs": {
          "200610501": {
            "id": "200610501",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "Regarding these pigeons...",
            "nextDialogs": [
              "200610502"
            ]
          },
          "200610502": {
            "id": "200610502",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "You did WHAT? How could you!? They were my carrier pigeons!",
            "nextDialogs": [
              "200610503"
            ]
          },
          "200610503": {
            "id": "200610503",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "You churlish imbecile... hilichurlish, even! What am I going to do about all these letters!?",
            "nextDialogs": [
              "200610505",
              "200610507"
            ]
          },
          "200610505": {
            "id": "200610505",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "Is that the best you can do? A Knight of Flaming Favonius and the best you can offer is a half-hearted apology!?",
            "nextDialogs": [
              "200610508"
            ]
          },
          "200610508": {
            "id": "200610508",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "You've really fluffed up here, and now you have to make it right. Since you're so bird-brained anyway, I trust you will have no problem being my new carrier pigeon!"
          },
          "200610507": {
            "id": "200610507",
            "speakerId": 10035,
            "speakerName": "Draff",
            "text": "It helps if you don't chase them off with a flaming meat cleaver!"
          }
        }
      }
    },
    {
      "subId": "2006106",
      "subQuestName": "Scare off the pigeons",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610601"
        ],
        "dialogs": {
          "200610601": {
            "id": "200610601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Dun-dun-dun! The pigeons are gone! Paimon swears they were here just a second ago..."
          }
        }
      }
    },
    {
      "subId": "2006107",
      "subQuestName": "Scare off the pigeons",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610701"
        ],
        "dialogs": {
          "200610701": {
            "id": "200610701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look at those hilichurls, they're gathered round a cooking pot and there's a bit pile of meat by the side..."
          }
        }
      }
    },
    {
      "subId": "2006108",
      "subQuestName": "Scare off the pigeons",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200610801"
        ],
        "dialogs": {
          "200610801": {
            "id": "200610801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh, what's this? ...A message?",
            "nextDialogs": [
              "200610802"
            ]
          },
          "200610802": {
            "id": "200610802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Shoot, one of the pigeons must have dropped it on the way...",
            "nextDialogs": [
              "200610803"
            ]
          },
          "200610803": {
            "id": "200610803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, see who the sender is. Maybe we can sort this out."
          }
        }
      }
    },

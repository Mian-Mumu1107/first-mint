    {
      "subId": "2006118",
      "subQuestName": "Give the letter to Sara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200611201"
        ],
        "dialogs": {
          "200611201": {
            "id": "200611201",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Chirp chirp, I have a letter for you.",
            "nextDialogs": [
              "200611202"
            ]
          },
          "200611202": {
            "id": "200611202",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Oh! I never expected you to be the one delivering this!",
            "nextDialogs": [
              "200611203"
            ]
          },
          "200611203": {
            "id": "200611203",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "I thought it would be a carrier pigeon, like usual.",
            "nextDialogs": [
              "200611204"
            ]
          },
          "200611204": {
            "id": "200611204",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "But as long as it's delivered I'm happy. Thanks!"
          }
        }
      }
    },
    {
      "subId": "2006119",
      "subQuestName": "Report back to Draff",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200611301"
        ],
        "dialogs": {
          "200611301": {
            "id": "200611301",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Regarding these pigeons...",
            "nextDialogs": [
              "200611302"
            ]
          },
          "200611302": {
            "id": "200611302",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Goodness... The devil makes work for idle hands, eh.",
            "nextDialogs": [
              "200611303"
            ]
          },
          "200611303": {
            "id": "200611303",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Alright, well never mind. I'll let you off this once. Off you go now."
          }
        }
      }
    },
    {
      "subId": "2006110",
      "subQuestName": "Scare off the pigeons",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200611001"
        ],
        "dialogs": {
          "200611001": {
            "id": "200611001",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Regarding these pigeons...",
            "nextDialogs": [
              "200611002"
            ]
          },
          "200611002": {
            "id": "200611002",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "The hilichurls have an insatiable appetite for avian messengers? Are you serious...",
            "nextDialogs": [
              "200611003"
            ]
          },
          "200611003": {
            "id": "200611003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is this letter yours?",
            "nextDialogs": [
              "200611004"
            ]
          },
          "200611004": {
            "id": "200611004",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "A letter? Ah yes, I sent this! It was supposed to go to Sister Grace, in the city.",
            "nextDialogs": [
              "200611005"
            ]
          },
          "200611005": {
            "id": "200611005",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "You didn't read it, did you? Not that it matters anyway, it's all stuff that happened years ago.",
            "nextDialogs": [
              "200611006"
            ]
          },
          "200611006": {
            "id": "200611006",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "With some things, you can't leave them in the dark forever...",
            "nextDialogs": [
              "200611007"
            ]
          },
          "200611007": {
            "id": "200611007",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Thank you for bringing it all this way, I'll run it down to the city myself some time. Here's a small reward for finding it...",
            "nextDialogs": [
              "200611008"
            ]
          },
          "200611008": {
            "id": "200611008",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "Timmie, hey Timmie..."
          }
        }
      }
    },
    {
      "subId": "2006111",
      "subQuestName": "Investigate what's happening up ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200611101"
        ],
        "dialogs": {
          "200611101": {
            "id": "200611101",
            "speakerId": 1537,
            "speakerName": "Draff",
            "text": "These pigeons are getting plumper by the day... What is Allan feeding them?"
          }
        }
      }
    },

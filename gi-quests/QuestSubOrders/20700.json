    {
      "subId": "2070025",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207002501"
        ],
        "dialogs": {
          "207002501": {
            "id": "207002501",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "So. Have you done as I asked?"
          }
        }
      }
    },
    {
      "subId": "2070001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000101"
        ],
        "dialogs": {
          "207000101": {
            "id": "207000101",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "What awful luck. These Knights of Favonius are really...",
            "nextDialogs": [
              "207000102"
            ]
          },
          "207000102": {
            "id": "207000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is something wrong?",
            "nextDialogs": [
              "207000103"
            ]
          },
          "207000103": {
            "id": "207000103",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Hmph! These Knights of Favonius have no sense of efficiency at all. They said that there were monsters ahead, and wouldn't let me pass.",
            "nextDialogs": [
              "207000104"
            ]
          },
          "207000104": {
            "id": "207000104",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "But even now, I still haven't received anything more concrete from them. What an unreliable lot...",
            "nextDialogs": [
              "207000105"
            ]
          },
          "207000105": {
            "id": "207000105",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "I still have so many matters to attend to. Do they have any idea how much money they're costing me?",
            "nextDialogs": [
              "207000106"
            ]
          },
          "207000106": {
            "id": "207000106",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Still... Well, you look like an adventurer, don't you? How about this — would you be willing to do a little something for me? I'll pay you.",
            "nextDialogs": [
              "207000108",
              "207000110"
            ]
          },
          "207000108": {
            "id": "207000108",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Wonderful. I love straightforward people. You will be well rewarded once the deed is done, I guarantee it.",
            "nextDialogs": [
              "207000111"
            ]
          },
          "207000111": {
            "id": "207000111",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Perhaps my eyes deceive me, but the hilichurls around Mondstadt seem to have grown more numerous. Who knows what these so-called Knights are doing all day?",
            "nextDialogs": [
              "207000112"
            ]
          },
          "207000112": {
            "id": "207000112",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Since you've agreed to aid me, then you can help to drive them off for me. Yet, you are only one person. Hmm...",
            "nextDialogs": [
              "207000113"
            ]
          },
          "207000113": {
            "id": "207000113",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Forget it. Pick one of these areas to clean out yourself: the peak, side or foot of the mountain.",
            "nextDialogs": [
              "207000114"
            ]
          },
          "207000114": {
            "id": "207000114",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "It's all hilichurls no matter where you go, so there's no difference. Now go, and don't waste my time."
          },
          "207000110": {
            "id": "207000110",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Hah, that will depend on the manner of your deeds. If you do well, I will see to it that you are well rewarded."
          }
        }
      }
    },
    {
      "subId": "2070006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000602"
        ],
        "dialogs": {
          "207000602": {
            "id": "207000602",
            "speakerId": 1654,
            "speakerName": "Tsarevich",

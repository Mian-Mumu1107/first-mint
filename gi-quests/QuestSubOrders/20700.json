{
  "lineCounts": {
    "Grace": 1,
    "Paimon": 6,
    "Player": 13,
    "Tsarevich": 58
  },
  "subQuests": [
    {
      "subId": "2070001",
      "subQuestName": "Talk to Tsarevich",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207002101"
        ],
        "dialogs": {
          "207002101": {
            "id": "207002101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll take the foot of the mountains.",
            "nextDialogs": [
              "207002102"
            ]
          },
          "207002102": {
            "id": "207002102",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "The foot, is it? There's not much down there, just a bunch of hilichurls. They're not much of a threat, but they are an eyesore.",
            "nextDialogs": [
              "207002103"
            ]
          },
          "207002103": {
            "id": "207002103",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Go and take care of them all. For such a simple task, I'll give you... one minute. That should be enough."
          }
        }
      }
    },
    {
      "subId": "2070002",
      "subQuestName": "Defeat the Hilichurls as requested by Tsarevich",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000201"
        ],
        "dialogs": {
          "207000201": {
            "id": "207000201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Done and dusted.",
            "nextDialogs": [
              "207000202"
            ]
          },
          "207000202": {
            "id": "207000202",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "So soon? In less than a minute, even! You're quite good. Quite good indeed, hahaha!",
            "nextDialogs": [
              "207000203"
            ]
          },
          "207000203": {
            "id": "207000203",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Good, good. 5,000 Mora, and not one Mora less. Take it.",
            "nextDialogs": [
              "207000204"
            ]
          },
          "207000204": {
            "id": "207000204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Quite good,\" and all we get is 5,000 Mora...",
            "nextDialogs": [
              "207000205"
            ]
          },
          "207000205": {
            "id": "207000205",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Don't you get picky, now. I calculated this remuneration very carefully, and it is commensurate with the work.",
            "nextDialogs": [
              "207000206"
            ]
          },
          "207000206": {
            "id": "207000206",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "One must do great things to earn great rewards. If we have the chance to meet again, you can try your luck then."
          }
        }
      }
    },
    {
      "subId": "2070005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000501"
        ],
        "dialogs": {
          "207000501": {
            "id": "207000501",
            "speakerId": 1429,
            "speakerName": "Grace",
            "text": "I, the Wicked Capitalist"
          }
        }
      }
    },
    {
      "subId": "2070004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000304"
        ],
        "dialogs": {
          "207000304": {
            "id": "207000304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's a wrap.",
            "nextDialogs": [
              "207000305"
            ]
          },
          "207000305": {
            "id": "207000305",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Dragging your feet, just like the Knights of Favonius. I gave you a minute! Did you forget, or did you not listen in the first place?",
            "nextDialogs": [
              "207000306"
            ]
          },
          "207000306": {
            "id": "207000306",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "No attention paid, even to such simple details... 1,000 Mora it is. Do with it what you will.",
            "nextDialogs": [
              "207000307"
            ]
          },
          "207000307": {
            "id": "207000307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "1,000 Mora? So little!?",
            "nextDialogs": [
              "207000308"
            ]
          },
          "207000308": {
            "id": "207000308",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "How much do you expect for a job done like that? This is the pay you deserve — now take it!"
          }
        }
      }
    },
    {
      "subId": "2070006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207003301"
        ],
        "dialogs": {
          "207003301": {
            "id": "207003301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's done.",
            "nextDialogs": [
              "207003302"
            ]
          },
          "207003302": {
            "id": "207003302",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Did you mishear me, or are you hoping that I'll let this slide? Huh?",
            "nextDialogs": [
              "207003303"
            ]
          },
          "207003303": {
            "id": "207003303",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "I told you not to break those boxes, and you broke this many? Can they even be sold at this point?",
            "nextDialogs": [
              "207003304"
            ]
          },
          "207003304": {
            "id": "207003304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I didn't see any goods...",
            "nextDialogs": [
              "207003305"
            ]
          },
          "207003305": {
            "id": "207003305",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "It was those boxes! Those were my goods! Why do you think I would stack them up outside anyway otherwise?",
            "nextDialogs": [
              "207003306"
            ]
          },
          "207003306": {
            "id": "207003306",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Forget it. Forget it! I have nothing to say to attention-deficient louts like you. Here's 1,000 Mora — take it and be off!",
            "nextDialogs": [
              "207003307"
            ]
          },
          "207003307": {
            "id": "207003307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "1,000 Mora? That's way too little!",
            "nextDialogs": [
              "207003308"
            ]
          },
          "207003308": {
            "id": "207003308",
            "speakerId": 1654,
            "speakerName": "Tsarevich",
            "text": "Too little? You can't even do a simple job right, and you want more money? This is the amount you deserve!"
          }
        }
      }
    },
    {
